// Writes src/routes.generated.ts: the endpoints the Cloudflare API Worker serves.
//
// The source of truth is the API registry (`remix/app/docs/apiDocs.ts`): an
// endpoint runs on Cloudflare only when its doc has a `cloudflare` entry. Each
// handler module path comes from Nitro's route map
// (`remix/server/routes/api/[...].ts`), so both runtimes import the same file.
//
//   cd remix && npx tsx ../cloudflare/api/scripts/generate-routes.mts [--check]
//
// --check exits 1 when the committed file is out of date (used by tests/CI).

import { existsSync, readFileSync, writeFileSync } from 'node:fs';
import { dirname, join, relative, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';

import { apiEndpointDocs } from '../../../remix/app/docs/apiDocs';

const here = dirname(fileURLToPath(import.meta.url));
const apiDir = resolve(here, '..');
const repo = resolve(apiDir, '../..');
const outFile = join(apiDir, 'src/routes.generated.ts');
const nitroRoutes = readFileSync(join(repo, 'remix/server/routes/api/[...].ts'), 'utf8');

const modulePathFor = (key: string) => {
	const escaped = key.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
	const match = nitroRoutes.match(new RegExp(`'${escaped}':\\s*\\(\\)\\s*=>\\s*import\\('\\.\\./\\.\\./\\.\\./(app/routes/[^']+)'\\)`));
	if (!match) throw new Error(`No Nitro route module for ${key}; add it to remix/server/routes/api/[...].ts first.`);
	const absolute = join(repo, 'remix', match[1]);
	if (!['.tsx', '.ts'].some((ext) => existsSync(absolute + ext))) throw new Error(`Route module missing on disk: ${match[1]}`);
	return relative(join(apiDir, 'src'), absolute);
};

const routes = apiEndpointDocs
	.filter((doc) => doc.cloudflare)
	.map((doc) => {
		const key = doc.endpoint.replace(/^\/api\//, '');
		const methods = doc.cloudflare!.methods.filter((method) => doc.methods.includes(method));
		if (!methods.length) throw new Error(`${doc.id}: cloudflare.methods must be a subset of methods`);
		return { key, feature: `api.${doc.id}`, version: doc.cloudflare!.featureVersion, methods, module: modulePathFor(key) };
	})
	.sort((a, b) => a.key.localeCompare(b.key));

const body = `// Generated by scripts/generate-routes.mts from remix/app/docs/apiDocs.ts. Do not edit.
// An endpoint is listed here when its API doc has a \`cloudflare\` entry.

import type { ApiRouteModule } from '../../../remix/app/api/utils/http/routeExecution';

export type CloudflareRoute = { feature: string; version: string; methods: readonly string[]; load: () => Promise<ApiRouteModule> };

export const cloudflareRoutes: Record<string, CloudflareRoute> = {
${routes.map((route) => `\t'${route.key}': { feature: '${route.feature}', version: '${route.version}', methods: ${JSON.stringify(route.methods)}, load: () => import('${route.module.replace(/\.tsx?$/, '')}') }`).join(',\n')}
};
`;

if (process.argv.includes('--check')) {
	const current = existsSync(outFile) ? readFileSync(outFile, 'utf8') : '';
	if (current !== body) {
		console.error('cloudflare/api/src/routes.generated.ts is out of date; run the generator.');
		process.exit(1);
	}
	console.log(`routes.generated.ts is current (${routes.length} endpoints)`);
} else {
	writeFileSync(outFile, body);
	console.log(`wrote ${relative(repo, outFile)} (${routes.length} endpoints): ${routes.map((route) => route.key).join(', ')}`);
}
