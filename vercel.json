{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": null,
	"installCommand": "corepack pnpm --dir remix install --frozen-lockfile",
	"buildCommand": "node scripts/vercel-build.mjs",
	"outputDirectory": null,
	"ignoreCommand": "node scripts/vercel-ignore-build.mjs",
	"git": {
		"deploymentEnabled": {
			"*": false,
			"main": true,
			"develop": true
		}
	},
	"regions": ["syd1"],
	"fluid": true,
	"crons": [
		{
			"path": "/api/v1/attachments/cleanup",
			"schedule": "17 * * * *"
		},
		{
			"path": "/api/v1/moderation/sweep",
			"schedule": "29 * * * *"
		},
		{
			"path": "/api/v1/notifications/email/weekly-summary",
			"schedule": "37 21 * * 0"
		}
	]
}
