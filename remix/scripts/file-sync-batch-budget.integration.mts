/** Actual Mongo driver/atomicity proof. No accounts, storage transport or app env. */
import assert from 'node:assert/strict';
import { createHash, randomUUID } from 'node:crypto';
import { realpath, stat } from 'node:fs/promises';
import { basename, dirname } from 'node:path';
import { tmpdir } from 'node:os';
const directory=process.env.THINGTIME_FILE_SYNC_BATCH_BUDGET_TEST_DIRECTORY;
assert.ok(directory&&/^mongodb:\/\/127\.0\.0\.1:28163\/thingtime\?replicaSet=file-sync-batch-budget$/.test(process.env.MONGODB_CONNECTION_STRING||''));
const actual=await realpath(directory!);assert.equal(dirname(actual),await realpath(tmpdir()));assert.ok(basename(actual).startsWith('thingtime-file-sync-batch-budget-'));assert.equal((await stat(actual)).mode&0o077,0);
const {createBatchBudget,BATCH_BUDGET}=await import('../app/api/utils/files/batchAdmission');
const {getRateLimitsCollection,ensureIndexes}=await import('../app/api/utils/mongodb/collections');
await ensureIndexes();const coll=await getRateLimitsCollection();
let now=Date.now(), owner='fixture-'+randomUUID();
const charge=createBatchBudget(getRateLimitsCollection,async()=>{},()=>now);
const key=()=>createHash('sha256').update(`file-sync-bulk:v1:${owner}:${Math.floor(now/60000)*60000}`).digest('hex');
const started=performance.now();
const initial=await Promise.all(Array.from({length:130},()=>charge(owner,'prepare',256,0)));
assert.equal(initial.filter(Boolean).length,128);
const row:any=await coll.findOne({key:key()});assert.equal(row.units,BATCH_BUDGET.units);assert.equal(row.bytes,0);
const ttl=+row.expiresAt;
const denied=await Promise.all(Array.from({length:32},()=>charge(owner,'prepare',1,1)));assert.ok(denied.every(v=>!v));
const after:any=await coll.findOne({key:key()});assert.equal(after.units,row.units);assert.equal(after.bytes,0);assert.equal(+after.expiresAt,ttl);
const other=owner+'-other';assert.equal(await charge(other,'prepare',1,1),true);
now+=60000;assert.equal(await charge(owner,'verify',1,0),true);
const rolled:any=await coll.findOne({key:key()});assert.equal(rolled.units,6);assert.equal(rolled.bytes,0);assert.equal(await coll.countDocuments({key:row.key}),1);
owner='bytes-'+randomUUID();const bytes=await Promise.all(Array.from({length:18},()=>charge(owner,'prepare',1,32*1024*1024)));
assert.equal(bytes.filter(Boolean).length,16);const byteRow:any=await coll.findOne({key:key()});assert.equal(byteRow.bytes,BATCH_BUDGET.bytes);assert.equal(byteRow.units,32);
assert.equal(await charge(owner,'probe',256,0),true);assert.equal((await coll.findOne({key:key()}))!.units,41);
const {getHomeThingsCollection}=await import('../app/api/utils/mongodb/collections');
const {createBatchObserveService}=await import('../app/api/utils/files/batchObserve');
const things=await getHomeThingsCollection(), observedOwner='observe-'+randomUUID(), root='root-'+randomUUID(), parent='parent-'+randomUUID(), date=new Date();
await things.insertMany([{shareId:root,ownerId:observedOwner,thingtime:['folder'],folderId:null,acl:['tt:user'],updatedAt:date,crystal:{name:'Root'}},{shareId:parent,ownerId:observedOwner,thingtime:['folder'],folderId:root,acl:['tt:user'],updatedAt:date,crystal:{name:'Parent'}}] as any);
let rootReads=0,siblingCursors=0;
const bounded=new Proxy(things,{get(target,key){if(key==='findOne')return (...args:any[])=>{rootReads++;return (target.findOne as any)(...args);};if(key==='find')return (...args:any[])=>{siblingCursors++;return (target.find as any)(...args);};const value=(target as any)[key];return typeof value==='function'?value.bind(target):value;}});
const observe=createBatchObserveService({collection:async()=>bounded});const observeStarted=performance.now();
const observation:any=await observe(observedOwner,root,Array.from({length:256},(_,i)=>'Parent/f'+i),new AbortController().signal);
assert.equal(observation.ok,true);assert.equal(observation.observations.length,256);assert.ok(observation.observations.every((r:any)=>r.node===null&&r.parent.id===parent));assert.equal(rootReads,1);assert.equal(siblingCursors,2);
const observeElapsedMs=Math.round(performance.now()-observeStarted);
console.log(JSON.stringify({fileSyncBatchBudgetProof:true,driverConditionalAdmission:true,concurrentFirstUpsert:130,admittedAtExactUnitCap:128,nearCapDenials:32,deniedTtlUnchanged:true,ownerIsolation:true,rollover:true,atomicByteAndUnitCharge:true,elapsedMs:Math.round(performance.now()-started),observedPaths:256,observeRootReads:rootReads,observeSiblingCursors:siblingCursors,observeElapsedMs}));
process.exit(0);
