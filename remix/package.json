{
  "private": true,
  "sideEffects": false,
  "version": "1.0.0",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "build": "node scripts/ensure-dependencies.js && npm run ensure-bcrypt && ./scripts/pre-dev.sh && npm run build:client && npm run sync:nitro-template && NITRO_PRESET=vercel npm run build:server && npm run patch:vercel-output && npm run verify:vercel-output",
    "build:client": "node scripts/ensure-dependencies.js && vite build",
    "build:server": "node scripts/ensure-dependencies.js && nitro build",
    "ensure-bcrypt": "node scripts/ensure-bcrypt-binding.js",
    "ensure-deps": "node scripts/ensure-dependencies.js",
    "postinstall": "node scripts/ensure-bcrypt-binding.js",
    "pre-dev": "./scripts/pre-dev.sh",
    "dev": "node scripts/dev.mjs",
    "dev:nitro": "node scripts/ensure-dependencies.js --quiet && node scripts/dev-nitro.cjs",
    "dev:vite": "node scripts/ensure-dependencies.js --quiet && vite --host 127.0.0.1",
    "lint": "node scripts/ensure-dependencies.js && eslint --ext .js,.ts,.jsx,.tsx .",
    "lint:files": "node scripts/ensure-dependencies.js && eslint",
    "test": "npm run test:unit && npm run test:api",
    "test:api": "tsx scripts/run-api-tests.mts",
    "test:unit": "npm run test:acl && npm run test:autosave && npm run test:client-errors && npm run test:collections && npm run test:editorjs && npm run test:migrations && npm run test:quota && npm run test:schemas && npm run test:sensitive-reveal && npm run test:settings && npm run test:storage && npm run test:storage-recovery",
    "typecheck": "tsc --noEmit",
    "typecheck:ratchet": "node scripts/typecheck-ratchet.mjs",
    "lint-fix": "node scripts/ensure-dependencies.js && eslint --ext .js,.ts,.jsx,.tsx . --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "patch:vercel-output": "node scripts/patch-vercel-output.mjs",
    "preview": "node .output/server/index.mjs",
    "sync:nitro-template": "node scripts/sync-nitro-template.mjs",
    "test:acl": "node --import tsx --test app/api/utils/things/aclChainCore.test.ts",
    "test:app-origins": "node --import tsx --test app/api/utils/apps/appOriginsCore.test.ts",
    "test:app-storage": "node --import tsx --test app/api/utils/apps/appStorageCore.test.ts",
    "verify:app-storage": "node scripts/verify-app-storage.mjs",
    "test:autosave": "node --import tsx --test app/Providers/*.test.ts",
    "test:collections": "node --import tsx --test app/api/utils/mongodb/*.test.ts",
    "test:client-errors": "node --import tsx --test app/hooks/apiFailure.test.ts app/components/Lopu/lopuMessage.test.ts app/components/Feed/reactionFailure.test.ts app/components/Things/sensitiveRevealError.test.ts app/api/utils/errors/adminDiagnostic.test.ts app/api/utils/migrations/migrationFailure.test.ts app/api/utils/migrations/migrationDiagnostics.test.ts",
    "test:hooks": "node --import tsx --test app/hooks/*.test.ts",
    "test:editorjs": "node --import tsx --test app/components/Editor/*.test.ts app/components/Kinds/*.test.ts",
    "test:migrations": "node --import tsx --test app/api/utils/migrations/*.test.ts",
    "test:sensitive-reveal": "node --import tsx --test app/api/utils/auth/passwordConfirmation.test.ts app/api/utils/things/sensitiveReveal.test.ts app/routes/api/v1/things/reveal/reveal.test.ts",
    "test:quota": "node --import tsx --test app/api/utils/things/quotaCore.test.ts",
    "test:schemas": "node --import tsx --test app/schemas/*.test.ts",
    "test:settings": "node --import tsx --test app/api/utils/settings/*.test.ts",
    "test:storage": "node --import tsx --test app/api/utils/storage/*.test.ts",
    "test:storage-recovery": "node --import tsx --test app/api/utils/apps/namespaceStorageRecovery.test.ts",
    "test:subscriptions": "node --import tsx --test app/api/utils/subscriptions/tierCatalog.test.ts",
    "verify:vercel-output": "node scripts/verify-vercel-output.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@aws-sdk/client-sesv2": "^3.1080.0",
    "@chakra-ui/react": "^2.7.1",
    "@chakra-ui/react-types": "^2.0.6",
    "@editorjs/checklist": "^1.6.0",
    "@editorjs/code": "^2.9.4",
    "@editorjs/delimiter": "^1.4.2",
    "@editorjs/editorjs": "^2.27.2",
    "@editorjs/embed": "^2.8.0",
    "@editorjs/header": "^2.8.9",
    "@editorjs/inline-code": "^1.5.2",
    "@editorjs/list": "^2.0.9",
    "@editorjs/marker": "^1.4.0",
    "@editorjs/quote": "^2.7.6",
    "@editorjs/simple-image": "^1.6.0",
    "@editorjs/table": "^2.4.5",
    "@editorjs/underline": "^1.2.1",
    "@editorjs/warning": "^1.4.1",
    "@emotion/cache": "^11.11.0",
    "@emotion/react": "^11.11.4",
    "@emotion/server": "^11.11.0",
    "@fortawesome/fontawesome-svg-core": "^6.4.0",
    "@fortawesome/free-regular-svg-icons": "^6.4.0",
    "@fortawesome/free-solid-svg-icons": "^6.4.0",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@monaco-editor/react": "^4.6.0",
    "@vercel/analytics": "^2.0.1",
    "axios": "^1.6.8",
    "bcrypt": "^5.1.1",
    "draft-js": "^0.11.7",
    "emojis-list": "^3.0.0",
    "emotion": "^11.0.0",
    "flatted": "^3.3.3",
    "fuse.js": "^6.6.2",
    "gradient-path": "^2.3.0",
    "hex-to-rgba": "^2.0.1",
    "isbot": "latest",
    "jose": "^5.9.6",
    "localforage": "^1.10.0",
    "lodash-es": "^4.17.21",
    "lucide-react": "^1.21.0",
    "mongodb": "^6.5.0",
    "nitro": "^3.0.260610-beta",
    "openai": "^6.44.0",
    "prismjs": "^1.29.0",
    "react": "^19.2.7",
    "react-click-away-listener": "^2.2.3",
    "react-contenteditable": "^3.3.7",
    "react-dom": "^19.2.7",
    "react-icons": "^4.10.1",
    "react-router": "^8.1.0",
    "react-simple-code-editor": "^0.14.1",
    "react-sticky": "^6.0.3",
    "react-sticky-el": "^2.1.0",
    "react-visibility-sensor": "^5.1.1",
    "rxjs": "^7.8.1",
    "sshpk": "^1.18.0",
    "tldts": "^7.4.10",
    "tinygradient": "^1.1.5",
    "unicode-emoji-json": "^0.9.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@emotion/styled": "^11.13.0",
    "@remix-run/eslint-config": "2.17.5",
    "@shopify/eslint-plugin": "^42.1.0",
    "@types/eslint": "^8.40.2",
    "@types/node": "^20.14.12",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/parser": "^5.60.1",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^8.43.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-loader": "^4.0.2",
    "eslint-plugin-chakra-ui": "^0.8.0",
    "eslint-plugin-hydrogen": "^0.12.3",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "eslint-plugin-unused-imports": "^2.0.0",
    "framer-motion": "^11.3.12",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^5.5.4",
    "vite": "^8.1.2"
  },
  "engines": {
    "node": "24.x"
  }
}
