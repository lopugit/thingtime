# MongoDB
# Production / hosted MongoDB example:
# Get this from MongoDB Atlas > Database > Connect > Drivers.
# Replace <db_user>, <db_password>, <cluster-host>, and <app-name>.
# URL-encode the password if it contains special characters.
MONGODB_CONNECTION_STRING="mongodb+srv://<db_user>:<db_password>@<cluster-host>/?retryWrites=true&w=majority&appName=<app-name>"

# Local development MongoDB:
# MONGODB_CONNECTION_STRING="mongodb://localhost:27017/"

# Optional: only keep this if existing scripts still read MONGO_PASS separately.
MONGO_PASS="<mongodb-password>"


# Vercel
# Create at: Vercel Account Settings > Tokens
VERCEL_API_TOKEN="<vercel-api-token>"


# Email provider
THINGTIME_EMAIL_PROVIDER="ses"

# AWS SES
# Region should match the verified SES identity/domain.
AWS_SES_REGION="ap-southeast-2"

# Use an IAM access key with only the SES permissions this app needs.
AWS_SES_ACCESS_KEY_ID="<aws-access-key-id>"
AWS_SES_SECRET_ACCESS_KEY="<aws-secret-access-key>"

THINGTIME_EMAIL_TRANSACTIONAL_FROM="Thingtime <no-reply@example.com>"
THINGTIME_EMAIL_NEWSLETTER_FROM="Thingtime Updates <community@example.com>"
THINGTIME_EMAIL_REPLY_TO="support@example.com"

# Optional SES configuration set name.
AWS_SES_CONFIGURATION_SET="<ses-configuration-set-name>"

# Set to "true" if email failures should block the calling workflow.
THINGTIME_EMAIL_FAIL_CLOSED="false"

# Use 1 while AWS SES is still in sandbox mode; set to 0 after production access.
SES_SANDBOX=1


##### Automatic .env vars; see pre-dev.sh #####
# Usually generated by pre-dev.sh. Set manually only when overriding.
THINGTIME_BRANCH_NAME="<branch-name>"
##### Automatic .env vars; see pre-dev.sh #####