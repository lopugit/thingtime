# Copy to .env for local/TestFlight uploads. Keep .env untracked.
THINGTIME_WEB_URL="https://<vercel-branch-preview-host>"
ASC_KEY_ID="<app-store-connect-api-key-id>"
ASC_ISSUER_ID="<app-store-connect-issuer-id>"
ASC_KEY_CONTENT="<base64-encoded-p8-content>"
DEVELOPMENT_TEAM="<apple-developer-team-id>"
PRODUCT_BUNDLE_IDENTIFIER=com.thingtime.appletime
# Optional: set when Xcode automatic export cannot create/find a profile.
PROVISIONING_PROFILE_SPECIFIER="<app-store-provisioning-profile-name>"
# Optional: skip Fastlane-managed signing asset sync only when already installed.
SKIP_CERT_SYNC=0
SKIP_PROFILE_SYNC=0
