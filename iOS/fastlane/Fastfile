require "base64"
require "fileutils"
require "plist"
require "shellwords"
require "tempfile"

ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] ||= "60"

default_platform(:ios)

SCHEME = "Thingtime"
OUTPUT_DIRECTORY = "build"
OUTPUT_NAME = "Thingtime.ipa"

def api_key_xcargs
  @asc_p8 ||= begin
    f = Tempfile.new(["AuthKey_#{ENV.fetch('ASC_KEY_ID')}", ".p8"])
    f.binmode
    f.write(Base64.decode64(ENV.fetch("ASC_KEY_CONTENT")))
    f.flush
    f
  end

  args = [
    "-allowProvisioningUpdates",
    "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')}",
    "-authenticationKeyPath #{@asc_p8.path}"
  ]
  issuer_id = asc_issuer_id
  args << "-authenticationKeyIssuerID #{issuer_id}" if issuer_id
  args.join(" ")
end

def asc_issuer_id
  issuer_id = ENV["ASC_ISSUER_ID"].to_s.strip
  issuer_id.empty? ? nil : issuer_id
end

def thingtime_web_url_xcarg
  "THINGTIME_WEB_URL=#{Shellwords.escape(ENV.fetch('THINGTIME_WEB_URL', 'https://thingtime.com'))}"
end

def manual_profile_signing?
  !ENV["PROVISIONING_PROFILE_SPECIFIER"].to_s.empty? ||
    !ENV["WATCH_PROVISIONING_PROFILE_SPECIFIER"].to_s.empty?
end

def distribution_profile_suffix
  certificate_id = ENV["IOS_DISTRIBUTION_CERTIFICATE_ID"].to_s.strip
  certificate_id.empty? ? "" : " #{certificate_id}"
end

def ios_provisioning_profile_name
  ENV.fetch(
    "PROVISIONING_PROFILE_SPECIFIER",
    "Thingtime App Store #{ENV.fetch('PRODUCT_BUNDLE_IDENTIFIER')}#{distribution_profile_suffix}"
  )
end

def watch_provisioning_profile_name
  ENV.fetch(
    "WATCH_PROVISIONING_PROFILE_SPECIFIER",
    "Thingtime Watch App Store #{ENV.fetch('WATCH_BUNDLE_IDENTIFIER')}#{distribution_profile_suffix}"
  )
end

def xcodebuild_xcargs
  args = []
  if manual_profile_signing?
    args << "CODE_SIGN_STYLE=Manual"
    args << "CODE_SIGN_IDENTITY=#{Shellwords.escape('Apple Distribution')}"
    args << "THINGTIME_IOS_PROVISIONING_PROFILE_SPECIFIER=#{Shellwords.escape(ios_provisioning_profile_name)}"
    args << "THINGTIME_WATCH_PROVISIONING_PROFILE_SPECIFIER=#{Shellwords.escape(watch_provisioning_profile_name)}"
  else
    args << api_key_xcargs
  end
  args << "DEVELOPMENT_TEAM=#{ENV.fetch('DEVELOPMENT_TEAM')}"
  args << thingtime_web_url_xcarg
  args.join(" ")
end

def export_options
  options = {
    method: "app-store-connect",
    signingStyle: "automatic",
    uploadSymbols: false
  }

  return options unless manual_profile_signing?

  options.merge(
    signingStyle: "manual",
    teamID: ENV.fetch("DEVELOPMENT_TEAM"),
    provisioningProfiles: {
      ENV.fetch("PRODUCT_BUNDLE_IDENTIFIER") => ios_provisioning_profile_name,
      ENV.fetch("WATCH_BUNDLE_IDENTIFIER") => watch_provisioning_profile_name
    }
  )
end

platform :ios do
  desc "Generate the Xcode project from project.yml"
  lane :generate do
    sh("which xcodegen > /dev/null || (echo 'Installing xcodegen...' && brew install xcodegen)")
    sh("cd .. && xcodegen generate")
  end

  desc "Build a signed Release archive (.ipa)"
  lane :build do
    generate
    setup_ci if ENV["CI"]
    keychain_path = if lane_context[SharedValues::KEYCHAIN_PATH]
                      FastlaneCore::Helper.keychain_path(
                        ENV.fetch("MATCH_KEYCHAIN_NAME", "fastlane_tmp_keychain")
                      )
                    end

    if ENV["IOS_DISTRIBUTION_CERTIFICATE_PATH"]
      UI.user_error!("Fastlane CI keychain was not created") unless keychain_path
      import_certificate(
        certificate_path: ENV.fetch("IOS_DISTRIBUTION_CERTIFICATE_PATH"),
        certificate_password: ENV.fetch("IOS_DISTRIBUTION_CERT_P12_PASSWORD"),
        keychain_name: ENV.fetch("MATCH_KEYCHAIN_NAME", "fastlane_tmp_keychain"),
        keychain_path: keychain_path,
        keychain_password: ENV.fetch("MATCH_KEYCHAIN_PASSWORD", "")
      )
    end

    unless ENV["SKIP_CERT_SYNC"] == "1"
      get_certificates(
        api_key: app_store_api_key,
        team_id: ENV.fetch("DEVELOPMENT_TEAM"),
        development: false,
        output_path: OUTPUT_DIRECTORY,
        keychain_path: keychain_path,
        keychain_password: ENV["MATCH_KEYCHAIN_PASSWORD"]
      )

      expected_certificate_id = ENV["IOS_DISTRIBUTION_CERTIFICATE_ID"]
      actual_certificate_id = lane_context[SharedValues::CERT_CERTIFICATE_ID]
      if expected_certificate_id && actual_certificate_id != expected_certificate_id
        UI.user_error!("Expected distribution certificate #{expected_certificate_id}, got #{actual_certificate_id}")
      end
    end

    unless ENV["SKIP_PROFILE_SYNC"] == "1"
      get_provisioning_profile(
        api_key: app_store_api_key,
        team_id: ENV.fetch("DEVELOPMENT_TEAM"),
        app_identifier: ENV.fetch("PRODUCT_BUNDLE_IDENTIFIER"),
        provisioning_name: ios_provisioning_profile_name,
        cert_id: lane_context[SharedValues::CERT_CERTIFICATE_ID],
        force: false,
        output_path: OUTPUT_DIRECTORY
      )
      ENV["PROVISIONING_PROFILE_SPECIFIER"] = lane_context[SharedValues::SIGH_NAME]

      get_provisioning_profile(
        api_key: app_store_api_key,
        team_id: ENV.fetch("DEVELOPMENT_TEAM"),
        app_identifier: ENV.fetch("WATCH_BUNDLE_IDENTIFIER"),
        provisioning_name: watch_provisioning_profile_name,
        cert_id: lane_context[SharedValues::CERT_CERTIFICATE_ID],
        force: false,
        output_path: OUTPUT_DIRECTORY
      )
      ENV["WATCH_PROVISIONING_PROFILE_SPECIFIER"] = lane_context[SharedValues::SIGH_NAME]
    end

    archive_path = File.expand_path(File.join(OUTPUT_DIRECTORY, "Thingtime.xcarchive"))
    FileUtils.mkdir_p(OUTPUT_DIRECTORY)
    build_app(
      scheme: SCHEME,
      configuration: "Release",
      archive_path: archive_path,
      output_directory: OUTPUT_DIRECTORY,
      output_name: OUTPUT_NAME,
      include_symbols: false,
      xcargs: xcodebuild_xcargs,
      skip_package_ipa: true
    )

    Tempfile.create(["ThingtimeExportOptions", ".plist"]) do |export_options_file|
      export_options_file.write(export_options.to_plist)
      export_options_file.flush
      sh(
        "xcodebuild",
        "-exportArchive",
        "-archivePath", archive_path,
        "-exportPath", File.expand_path(OUTPUT_DIRECTORY),
        "-exportOptionsPlist", export_options_file.path
      )
    end

    UI.user_error!("Xcode did not export #{OUTPUT_NAME}") unless File.exist?(File.join(OUTPUT_DIRECTORY, OUTPUT_NAME))
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    build
    upload_to_testflight(
      api_key: app_store_api_key,
      ipa: File.join(OUTPUT_DIRECTORY, OUTPUT_NAME),
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end

  desc "Upload an already-built IPA to TestFlight (IPA_PATH overrides the default build output)"
  lane :upload do
    upload_to_testflight(
      api_key: app_store_api_key,
      ipa: ENV["IPA_PATH"] || File.join(OUTPUT_DIRECTORY, OUTPUT_NAME),
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end

  private_lane :app_store_api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: asc_issuer_id,
      key_content: ENV.fetch("ASC_KEY_CONTENT"),
      is_key_content_base64: true,
      in_house: false
    )
  end
end
