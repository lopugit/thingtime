// Shared build settings for the native Thingtime iOS app.
// Keep secrets out of this file; inject signing values via Xcode or CI env.

THINGTIME_IOS_BUNDLE_IDENTIFIER = com.thingtime.appletime
THINGTIME_WATCH_BUNDLE_IDENTIFIER = com.thingtime.appletime.watchkitapp
PRODUCT_BUNDLE_IDENTIFIER = $(THINGTIME_IOS_BUNDLE_IDENTIFIER)
DEVELOPMENT_TEAM =
IPHONEOS_DEPLOYMENT_TARGET = 17.0
WATCHOS_DEPLOYMENT_TARGET = 10.0
THINGTIME_WEB_URL = https:/$()/thingtime.com
