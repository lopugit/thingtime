# Comma-separated absolute directories the MCP may read exports from.
THINGTIME_MCP_ALLOWED_ROOTS=/Users/you/Downloads/ai-exports

# Local private staging area. Never put this inside the git checkout.
THINGTIME_MCP_STATE_DIR=/Users/you/.thingtime/mcp

# Reserved for a later opt-in Thingtime API sync. Do not commit the token.
THINGTIME_API_URL=https://thingtime.com
THINGTIME_API_TOKEN=
