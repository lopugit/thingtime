{
	"name": "@thingtime/mcp",
	"version": "0.1.0",
	"private": true,
	"description": "Consent-first MCP bridge for importing AI desktop conversations into Thingtime.",
	"type": "module",
	"bin": {
		"thingtime-mcp": "dist/index.js"
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"build:desktop": "esbuild src/desktop.ts src/nodeRuntime.ts --bundle --platform=node --format=esm --target=node22 --outdir=dist-desktop --entry-names=[name] --out-extension:.js=.mjs",
		"dev": "tsx src/index.ts",
		"inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
		"start": "node dist/index.js",
		"test": "node --import tsx --test test/**/*.test.ts",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"engines": {
		"node": ">=20"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.29.0",
		"fflate": "^0.8.2",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"esbuild": "^0.25.10",
		"tsx": "^4.20.0",
		"typescript": "^5.9.0"
	}
}
