#!/usr/bin/env bash
set -euo pipefail

if [[ "${THINGTIME_ENV_AUTO_POST_COMMIT:-}" == "1" ]]; then
  exit 0
fi

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "$repo_root" ]]; then
  exit 0
fi

cd "$repo_root"

target="remix/.env.auto"
if [[ ! -e "$target" ]]; then
  exit 0
fi

if git diff --quiet -- "$target" && git diff --cached --quiet -- "$target"; then
  exit 0
fi

git add -- "$target"

if git diff --cached --quiet -- "$target"; then
  exit 0
fi

THINGTIME_ENV_AUTO_POST_COMMIT=1 git commit --no-verify -m "Commit generated remix env auto"
