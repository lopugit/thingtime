{
  "name": "thingtime",
  "version": "0.0.11",
  "packageManager": "pnpm@10.12.1",
  "description": "Thing Time",
  "main": "none",
  "scripts": {
    "thingtime-stack": "npm run web-pms ; npm run webserver",
    "webserver": "pm2 restart webserver &> /dev/null",
    "web": "npm run dev --prefix remix",
    "web-pms": "node remix/scripts/dev-pm2.cjs start",
    "web-pms-stop": "node remix/scripts/dev-pm2.cjs stop",
    "web-ports": "node remix/scripts/worktree-ports.cjs",
    "web-ports:all": "node remix/scripts/dev-pm2.cjs list",
    "worktree-setup": "node remix/scripts/ensure-dependencies.js --tool=eslint --tool=prettier",
    "build-web": "npm run build --prefix remix",
    "build:vercel": "node scripts/vercel-build.mjs",
    "test:vercel-root": "node --test scripts/vercel-root-flow.test.mjs",
    "graphify": "scripts/graphify",
    "graphify:ensure": "scripts/graphify ensure",
    "graphify:prune": "scripts/graphify prune",
    "test:graphify-cas": "node --test scripts/graphify-cas.test.mjs",
    "electron": "pnpm --dir electron dev",
    "build-electron": "pnpm --dir electron build",
    "dist-electron": "pnpm --dir electron dist",
    "install-electron": "pnpm --dir electron install:local",
    "remix": "npm run web",
    "remix-pms": "npm run web-pms",
    "build-remix": "npm run build-web",
    "next": "npm run dev --prefix next",
    "api": "npm run dev --prefix api",
    "postinstall": "pnpm i --prefix next ; pnpm i --prefix remix ; pnpm i --prefix raycast ; pnpm i --prefix api ; pnpm i --prefix electron",
    "install-git-hooks": "git config core.hooksPath .githooks"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lopugit/thingtime.git"
  },
  "author": "lopu",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/lopugit/thingtime/issues"
  },
  "homepage": "https://github.com/lopugit/thingtime#readme",
  "dependencies": {
    "smarts": "2.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^4.9.5"
  }
}
