{"nodes": [{"id": "prs_710_vault_verified_reveal_verified_vault_credentials_document", "label": "PR #710 verified vault credentials", "file_type": "document", "source_file": "PRs/710-vault-verified-reveal-verified-vault-credentials.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prs_710_vault_verified_reveal_verified_vault_credentials_security_contract", "label": "Per-entry vault reveal security contract", "file_type": "rationale", "source_file": "PRs/710-vault-verified-reveal-verified-vault-credentials.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "POST /api/v1/vault/reveal requires current full-account authentication, same-origin JSON, fixed fail-closed attempt limits and fresh password or user-verified passkey proof before decryption. CI/admin roles are rechecked and personal lookups remain owner-bound."}, {"id": "prs_710_vault_verified_reveal_verified_vault_credentials_passkey_tickets", "label": "Vault passkey verification tickets", "file_type": "rationale", "source_file": "PRs/710-vault-verified-reveal-verified-vault-credentials.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two-minute single-use tickets bind account, session, origin, relying party and item, reusing existing challenge indexes/TTL without a database migration."}, {"id": "prs_710_vault_verified_reveal_verified_vault_credentials_same_origin_fallback_boundary", "label": "Same-origin verification fallback boundary", "file_type": "rationale", "source_file": "PRs/710-vault-verified-reveal-verified-vault-credentials.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Vite and Nitro must not forward verification material to another origin through local or secretless-preview fallback. A real local fallback request returned private HTTP 503 without consuming or forwarding proof."}, {"id": "prs_710_vault_verified_reveal_verified_vault_credentials_automated_validation", "label": "Vault reveal automated validation evidence", "file_type": "rationale", "source_file": "PRs/710-vault-verified-reveal-verified-vault-credentials.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recorded passing suites: sensitive-reveal 18 tests, passkeys 17, capabilities 23 and fallback 3, plus existing admin-integration, CI-control and Lopu suites."}, {"id": "prs_710_vault_verified_reveal_verified_vault_credentials_build_validation", "label": "Vault reveal build validation evidence", "file_type": "rationale", "source_file": "PRs/710-vault-verified-reveal-verified-vault-credentials.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Full Vercel build/output verification and touched-code ESLint passed against main 54498f166e12ac78a6ef94590343ac7b8bfdfb1f; typecheck retained the existing 108-error baseline, not a clean full typecheck."}, {"id": "prs_710_vault_verified_reveal_verified_vault_credentials_synthetic_ui_validation", "label": "Synthetic vault modal browser evidence", "file_type": "rationale", "source_file": "PRs/710-vault-verified-reveal-verified-vault-credentials.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "At 1280x900 and 390x844, synthetic-only credentials verified wrapping, denial, Hide, late-response suppression, account switching and observed 30-second expiry; temporary fixtures were removed."}, {"id": "prs_710_vault_verified_reveal_verified_vault_credentials_production_acceptance", "label": "Production password and passkey acceptance", "file_type": "rationale", "source_file": "PRs/710-vault-verified-reveal-verified-vault-credentials.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Production password/passkey acceptance remains a user-assisted release check and is not established by synthetic tests."}, {"id": "prs_710_vault_verified_reveal_verified_vault_credentials_production_to_dev_copy", "label": "Production-to-development Claude credential copy", "file_type": "rationale", "source_file": "PRs/710-vault-verified-reveal-verified-vault-credentials.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Copying the two production Claude OAuth entries to development is a separate operational action not completed by these code changes. Never copy ciphertext across distinct environment keys; credentials must stay out of logs, screenshots, git and chat."}], "edges": [{"source": "prs_710_vault_verified_reveal_verified_vault_credentials_document", "target": "prs_710_vault_verified_reveal_verified_vault_credentials_security_contract", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "PRs/710-vault-verified-reveal-verified-vault-credentials.md", "source_location": null, "weight": 1}, {"source": "prs_710_vault_verified_reveal_verified_vault_credentials_document", "target": "prs_710_vault_verified_reveal_verified_vault_credentials_passkey_tickets", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "PRs/710-vault-verified-reveal-verified-vault-credentials.md", "source_location": null, "weight": 1}, {"source": "prs_710_vault_verified_reveal_verified_vault_credentials_document", "target": "prs_710_vault_verified_reveal_verified_vault_credentials_same_origin_fallback_boundary", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "PRs/710-vault-verified-reveal-verified-vault-credentials.md", "source_location": null, "weight": 1}, {"source": "prs_710_vault_verified_reveal_verified_vault_credentials_doc