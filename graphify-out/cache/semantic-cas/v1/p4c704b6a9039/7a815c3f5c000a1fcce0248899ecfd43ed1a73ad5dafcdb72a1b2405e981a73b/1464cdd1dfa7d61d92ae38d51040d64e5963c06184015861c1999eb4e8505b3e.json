{"nodes": [{"id": "docs_ios_automatic_testflight", "label": "Automatic iOS TestFlight Releases", "file_type": "document", "source_file": "docs/ios-automatic-testflight.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "docs_ios_automatic_testflight_release_triggers", "label": "Release Triggers and Build Workflow", "file_type": "concept", "source_file": "docs/ios-automatic-testflight.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Native changes under iOS, shared Apple FileSync/widgets/passwords, and the TestFlight workflow trigger releases on pushes to main; web-only changes do not rebuild the native shell.", "_origin": "semantic"}, {"id": "docs_ios_automatic_testflight_build_verification", "label": "Build Allocation and Archive Verification", "file_type": "concept", "source_file": "docs/ios-automatic-testflight.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Builds use a larger integer allocated from App Store Connect history, stamp only the disposable runner, and verify archive, IPA, executables, identifiers, signatures, versions, and App Group entitlements before upload.", "_origin": "semantic"}, {"id": "docs_ios_automatic_testflight_status", "label": "Read-Only Delivery Status", "file_type": "concept", "source_file": "docs/ios-automatic-testflight.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Status inspects a specific delivery and checks exact iOS Build Uploads records when the build is absent from Builds; a processing timeout requires inspection before rerunning.", "_origin": "semantic"}, {"id": "docs_ios_automatic_testflight_share_extension", "label": "Share Extension and App Group Requirements", "file_type": "concept", "source_file": "docs/ios-automatic-testflight.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The Share extension must retain its own App ID and distribution profile while sharing the containing app's widget group; the release must fail closed if the signed group or extension is missing.", "_origin": "semantic"}, {"id": "docs_ios_automatic_testflight_credentials_migration", "label": "Existing GitHub Secrets and Vault Migration", "file_type": "concept", "source_file": "docs/ios-automatic-testflight.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GitHub remains the default credential source until a real vault-backed upload and tester-availability check succeeds; vault mode has no fallback, and retired GitHub secrets are removed only afterward.", "_origin": "semantic"}, {"id": "docs_ios_automatic_testflight_migration_steps", "label": "Credential Migration Procedure", "file_type": "concept", "source_file": "docs/ios-automatic-testflight.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Migration deploys and verifies the API capability, configures a repository policy, migrates existing secrets through the workflow, switches to vault mode, validates a real upload and tester availability, and then removes old copies.", "_origin": "semantic"}, {"id": "docs_ios_automatic_testflight_credential_rotation", "label": "Credential Rotation and Delivery Controls", "file_type": "concept", "source_file": "docs/ios-automatic-testflight.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rotation pauses releases, replaces the labeled bundle, and fails closed during the gap; delivery can be disabled by removing credentials or disabling policy, and decrypted material is not cached or published.", "_origin": "semantic"}, {"id": "docs_ios_automatic_testflight_trust", "label": "GitHub OIDC Trust and Delivery Policy", "file_type": "concept", "source_file": "docs/ios-automatic-testflight.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The release API accepts narrowly constrained GitHub OIDC tokens, consumes each token once, gates migrations with explicit policy, serves delivery only from production, and records run metadata without secrets.", "_origin": "semantic"}, {"id": "docs_ios_automatic_testflight_validation", "label": "Release Validation and Acceptance", "file_type": "concept", "source_file": "docs/ios-automatic-testflight.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Automated tests cover token, policy, signing, build, and entitlement failure cases, while synthetic tests do not establish real Apple provisioning or a successful TestFlight upload.", "_origin": "semantic"}], "edges": [{"source": "docs_ios_automatic_testflight", "target": "docs_ios_automatic_testflight_release_triggers", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ios-automatic-testflight.md", "source_location": null, "weight": 1.0, "_origin": "semantic"}, {"source": "docs_ios_automatic_testflight", "target": "docs_ios_automatic_testflight_build_verification", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ios-automatic-testflight.md", "source_location": null, "weight": 1.0, "_origin": "semantic"}, {"source": "docs_ios_automatic_testflight", "target": "docs_ios_automatic_testflight_status", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ios-automatic-testflight.md", "source_location": null, "weight": 1.0, "_origin": "semantic"}, {"source": "docs_ios_automatic_testflight", "target": "docs_ios_automatic_testfli