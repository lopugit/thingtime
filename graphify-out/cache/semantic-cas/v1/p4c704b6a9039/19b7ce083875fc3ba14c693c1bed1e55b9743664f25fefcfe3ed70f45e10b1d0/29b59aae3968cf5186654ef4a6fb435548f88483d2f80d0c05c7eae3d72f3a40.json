{"nodes": [{"id": "docs_graphify_content_addressed_snapshots", "label": "Content-addressed Graphify snapshots", "file_type": "document", "source_file": "docs/graphify-content-addressed-snapshots.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stores Graphify output as immutable, content-addressed snapshots so independent branches do not edit shared generated paths; snapshot variants coexist without merge conflicts, and a deterministic router selects a valid variant.", "_origin": "semantic"}, {"id": "docs_graphify_content_addressed_snapshots_why", "label": "Why content-addressed snapshots", "file_type": "concept", "source_file": "docs/graphify-content-addressed-snapshots.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GitHub cannot run repository-provided local merge drivers; Git's union driver can reorder atomic JSON and combine manifests that mark discarded graph data as analyzed.", "_origin": "semantic"}, {"id": "docs_graphify_content_addressed_snapshots_layout", "label": "Snapshot and cache layout", "file_type": "concept", "source_file": "docs/graphify-content-addressed-snapshots.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Separates immutable portable snapshots and semantic cache variants from private mutable hydration and ignored compatibility aliases.", "_origin": "semantic"}, {"id": "docs_graphify_content_addressed_snapshots_source_fingerprint", "label": "Source fingerprint", "file_type": "concept", "source_file": "docs/graphify-content-addressed-snapshots.md", "rationale": "Hashes a temporary Git tree of tracked and non-ignored worktree content while excluding graphify-out, remaining stable before and after generated output is committed.", "_origin": "semantic"}, {"id": "docs_graphify_content_addressed_snapshots_artifact_hash", "label": "Artifact hash", "file_type": "concept", "source_file": "docs/graphify-content-addressed-snapshots.md", "rationale": "Addresses Graphify version and all portable output bytes, allowing identical outputs to converge while distinct valid variants coexist.", "_origin": "semantic"}, {"id": "docs_graphify_content_addressed_snapshots_compression", "label": "Oversized graph compression and activation", "file_type": "concept", "source_file": "docs/graphify-content-addressed-snapshots.md", "rationale": "Stores graphs over GitHub's 100 MiB file limit as deterministic gzip archives and validates archive and decoded graph hashes before atomic hydration.", "_origin": "semantic"}, {"id": "docs_graphify_content_addressed_snapshots_semantic_cas", "label": "Immutable semantic cache", "file_type": "concept", "source_file": "docs/graphify-content-addressed-snapshots.md", "rationale": "Preserves each semantic result by upstream input key and exact response bytes because later model responses can replace bytes at the same upstream cache filename; failed extraction cannot alter committed cache state.", "_origin": "semantic"}, {"id": "docs_graphify_content_addressed_snapshots_commands", "label": "Graphify wrapper commands", "file_type": "concept", "source_file": "docs/graphify-content-addressed-snapshots.md", "rationale": "The wrapper coordinates output override, cache hydration, graph and manifest validation, report and HTML generation, immutable snapshot finalization, and alias refresh.", "_origin": "semantic"}, {"id": "docs_graphify_content_addressed_snapshots_scoped_semantic_refresh", "label": "Scoped semantic refresh", "file_type": "concept", "source_file": "docs/graphify-content-addressed-snapshots.md", "rationale": "Limits semantic dispatch to changed documents while the normal incremental scan still handles structural changes, deletions, and the live corpus.", "_origin": "semantic"}, {"id": "docs_graphify_content_addressed_snapshots_slice_coverage", "label": "Semantic slice coverage validation", "file_type": "concept", "source_file": "docs/graphify-content-addressed-snapshots.md", "rationale": "Rejects failed, incomplete, or unstamped semantic work before publishing; every dispatched slice must return source nodes and pass before per-file cache finalization.", "_origin": "semantic"}, {"id": "docs_graphify_content_addressed_snapshots_retention", "label": "Bounded snapshot retention", "file_type": "concept", "source_file": "docs/graphify-content-addressed-snapshots.md", "rationale": "Keeps a bounded number of active portable snapshots, preserving untracked, staged, locally modified, or not-yet-committed content and deleting superseded snapshots only when portable files match committed Git content.", "_origin": "semantic"}, {"id": "docs_graphify_content_addressed_snapshots_merge_behavior", "label": "Snapshot merge behavior", "file_type": "concept", "source_file": "docs/graphify-content-addressed-snapshots.md", "rationale": "Uses additive hash-addressed paths and a fail-closed -merge hash-invariant check; after source merges the trusted router publishes a snapshot for the merged tree.", "_origin": "semantic"}, {"id": "docs_graphify_content_addressed_snapshots_locking", "label": "Atomic lock ownership and query coordination", "file_type": "concept", "source_file": "docs/graphify-content-addressed-snapshots.md", "rationale": "Publishes lock ownership by atomic directory rename and removes only the attempt's owner record; queries hold the lock through child execution so concurrent operations cannot rebuild or prune the selected snapshot.", "_origin": "semantic"}, {"id": "docs_graphify_content_addressed_snapshots_legacy_recovery", "label": "Legacy lock recovery", "file_type": "concept", "source_file": "docs/graphify-content-addressed-snapshots.md", "rationale": "The new router waits for live legacy owners, recovers exited owners, and refuses to guess for malformed owner records.", "_origin": "semantic"}, {"id": "docs_graphify_content_addressed_snapshots_cas_retention", "label": "Semantic CAS retention", "file_type": "concept", "source_file": "docs/graphify-content-addressed-snapshots.md", "rationale": "The semantic CAS is retained independently because it supports LLM-free fresh-clone rebuilds and may be shared across source fingerprints; safe collection requires reachability proof.", "_origin": "semantic"}, {"id": "docs_graphify_content_addressed_snapshots_graphify", "label": "Graphify", "file_type": "concept", "source_file": "docs/graphify-content-addressed-snapshots.md", "_origin": "semantic"}, {"id": "docs_graphify_content_addressed_snapshots_git", "label": "Git and GitHub", "file_type": "concept", "source_file": "docs/graphify-content-addressed-snapshots.md", "_origin": "semantic"}, {"id": "docs_graphify_content_addressed_snapshots_bazel", "label": "Bazel remote caching", "file_type": "concept", "source_file": "docs/graphify-content-addressed-snapshots.md", "_origin": "semantic"}, {"id": "docs_graphify_content_addressed_snapshots_semantic_cache", "label": "Graphify upstream semantic cache", "file_type": "concept", "source_file": "docs/graphify-content-addressed-snapshots.md", "_origin": "semantic"}, {"id": "docs_graphify_content_addressed_snapshots_graph_json", "label": "graph.json", "file_type": "concept", "source_file": "docs/graphify-content-addressed-snapshots.md", "_origin": "semantic"}, {"id": "docs_graphify_content_addressed_snapshots_manifest", "label": "manifest.json", "file_type": "concept", "source_file": "docs/graphify-content-addressed-snapshots.md", "_origin": "semantic"}, {"id": "docs_graphify_content_addressed_snapshots_report", "label": "GRAPH_REPORT.md", "file_type": "concept", "source_file": "docs/graphify-content-addressed-snapshots.md", "_origin": "semantic"}, {"id": "docs_graphify_content_addressed_snapshots_snapshot_json", "label": "snapshot.json", "file_type": "concept", "source_file": "docs/graphify-content-addressed-snapshots.md", "_origin": "semantic"}, {"id": "docs_graphify_con