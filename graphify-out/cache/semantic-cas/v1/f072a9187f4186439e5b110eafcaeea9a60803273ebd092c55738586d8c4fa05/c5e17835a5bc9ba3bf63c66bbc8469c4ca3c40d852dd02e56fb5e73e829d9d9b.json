{"nodes": [{"id": "testing_document", "label": "Thingtime per-area manual test checklists", "file_type": "document", "source_file": "TESTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "testing_verified_vault_reveal", "label": "Verified vault reveal regression", "file_type": "rationale", "source_file": "TESTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exercise Show in CI, integrations and personal settings at desktop and 390px, including wrong passwords, passkey cancellation, selected-item scope and default metadata-only reads."}, {"id": "testing_transient_reveal_cleanup", "label": "Transient reveal cleanup regression", "file_type": "rationale", "source_file": "TESTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Clear values on Hide, close, account switch, navigation, blur, hidden tabs and timeout; late responses must not reopen closed dialogs and only one Show may remain open."}, {"id": "testing_vault_reveal_security_boundaries", "label": "Vault reveal security boundary regression", "file_type": "rationale", "source_file": "TESTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reject cross-origin, anonymous, unauthorized, other-owner, replayed, expired and wrong-session verification before decryption; enforce attempt limits and private/no-store responses."}, {"id": "testing_vault_reveal_responsive_layout", "label": "Vault reveal responsive layout regression", "file_type": "rationale", "source_file": "TESTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Long labels and values wrap, modal buttons remain reachable and mobile has no horizontal overflow."}, {"id": "testing_speed_test_regression", "label": "Commander speed-test regression", "file_type": "rationale", "source_file": "TESTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Preserve account quotas, origin credentials, existing readings and manifest compatibility before payload transfer."}, {"id": "testing_mcp_connector_regression", "label": "MCP OAuth and review regression", "file_type": "rationale", "source_file": "TESTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exercise S256 PKCE, exact callbacks, scoped accounts, explicit write confirmation, conflict-aware preview/apply and encrypted receipts."}, {"id": "testing_integration_vault_regression", "label": "Admin integration vault and policy proxy regression", "file_type": "rationale", "source_file": "TESTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Metadata-only ordinary reads, no secret logging and create-only endpoint behavior protect integration credentials."}, {"id": "testing_voice_vault_regression", "label": "Lopu voice and Secure Vault regression", "file_type": "rationale", "source_file": "TESTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Check metadata-only reads, provider selection, direct voice, transcription, SSRF rejection and native background audio."}, {"id": "testing_desktop_permission_recovery", "label": "Desktop permission recovery regression", "file_type": "rationale", "source_file": "TESTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verify current shortcut targets after updates, bundled Node precedence, one restart prompt per explicit flow, no repeated prompt after Later, preserved pairing, one Node process, visible failure and a real protected operation after user-approved grant changes."}, {"id": "testing_permission_settings_app_locations", "label": "Permission settings App Locations regression", "file_type": "rationale", "source_file": "TESTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Opening Accessibility or Screen Recording settings must open the combined App Locations folder alongside the correct privacy pane, rather than Contents/Helpers."}, {"id": "testing_notification_retention_delivery_separation", "label": "Notification retention and delivery separation regression", "file_type": "rationale", "source_file": "TESTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "With delivery masters and action-run notifications disabled, messages and component runs must remain in history=1 while the muted bell stays empty; preferences mute delivery rather than erase history."}, {"id": "testing_notification_history_pagination", "label": "Stable notification history pagination regression", "file_type": "rationale", "source_file": "TESTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Load older must append without duplicates or skipped rows with equal timestamps; unfiltered history paints from the account cache and refetches, filtered rows remain visible while loading."}, {"id": "testing_login_success_history", "label": "Successful sign-in history regression", "file_type": "rationale", "source_file": "TESTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Password/OTP, passkey and redeemed SSO sign-ins should record login-success; invalid credentials and incomplete OTP flows must never record success."}, {"id": "testing_action_run_history", "label": "Action run history regression", "file_type": "rationale", "source_file": "TESTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "API/detail-page action outcomes and successful delegated component runs should persist action-run rows, with quiet delivery for delegated component success."}, {"id": "testing_lopu_message_history", "label": "Lopu message history regression", "file_type": "rationale", "source_file": "TESTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One-shot messages and completed, cancelled or failed streams should persist system-message for the signed-in viewer, retain bounded full text across reload and redact credential-like content and link query keys."}, {"id": "testing_notification_event_id_deduplication", "label": "Account-fenced notification retry deduplication regression", "file_type": "rationale", "source_file": "TESTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Retries using the same eventId must preserve one row and existing readAt; equal text under a new eventId remains a new event. Other-account access and client-supplied actor/type/owner/timestamps must be rejected."}, {"id": "testing_notification_history_capabilities", "label": "Notification history capability contract regression", "file_type": "rationale", "source_file": "TESTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The manifest should advertise api.notifications-list 1.4.0, api.notifications-settings 1.3.0 and api.notifications-record 1.0.0; unknown filters match nothing and unreadCount ignores filters."}, {"id": "testing_notification_history_responsive_filters", "label": "Notification history filters and responsive UI regression", "file_type": "rationale", "source_file": "TESTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Category/type/unread/search/day filters round-trip through the URL, optimistic read controls update the bell cache with rollback on failure, and 375px rows and controls wrap without clipping."}, {"id": "testing_notification_history_acceptance_checklist", "label": "Notification history acceptance checklist", "file_type": "rationale", "source_file": "TESTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "These unchecked manual checklist items specify required behavior and do not assert that their live acceptance paths have already passed."}], "edges": [{"source": "testing_document", "target": "testing_verified_vault_reveal", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "TESTING.md", "source_location": null, "weight": 1}, {"source": "testing_verified_vault_reveal", "target": "readme_verified_vault_viewing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "TESTING.md", "source_location": null, "weight": 1}, {"source": "testing_document", "target": "testing_transient_reveal_cleanup", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "TESTING.md", "source_location": null, "weight": 1}, {"source": "testing_transient_reveal_cleanup", "target": "readme_transient_vault_display", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "TESTING.md", "source_location": null, "weight": 1}, {"source": "testing_document", "target": "testing_vault_reveal_security_boundaries", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "TESTING.md", "source_location": null, "weight": 1}, {"source": "testing_vault_reveal_security_boundaries", "target": "readme_vault_reveal_scope", "relation": "references", "confidence": "EXTRACTED", "confidence