{"nodes": [{"id": "readme_document", "label": "Thingtime setup and product guide", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_thingtime", "label": "Thingtime information platform", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "People and machines can create, store and share arbitrary data structures."}, {"id": "readme_account_speed_test_allowances", "label": "Account speed-test allowances", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Protected subscription quotas are shared across sessions, devices and IP addresses; authenticated traffic does not spend guest quota."}, {"id": "readme_embed_sdk", "label": "Thingtime Embed SDK", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One minified browser file provides shared state, Shadow DOM mounts and a first-party secure editor/save window."}, {"id": "readme_canonical_ai_instructions", "label": "Canonical AI_ALL.md instructions", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AGENTS.md and CLAUDE.md are relative symlinks so compatible AI tools share one instruction source."}, {"id": "readme_mcp_conversation_normalizers", "label": "Thingtime MCP conversation normalizers", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Consent-first chat handoff and local staging preserve privacy boundaries."}, {"id": "readme_desktop_ai_history_connector", "label": "Desktop AI history connector", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Read-only discovery imports visible projects, chats and messages through the authenticated Messenger API."}, {"id": "readme_lopu_voice", "label": "Lopu continuous voice", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every final utterance becomes a normal Lopu chat turn with tools."}, {"id": "readme_transcribe_mode", "label": "Transcribe mode", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Final utterances become numbered timestamped owner-private Things."}, {"id": "readme_direct_voice", "label": "Direct voice", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Microphone audio streams to a chat-selected realtime provider using a five-minute ephemeral credential; stored provider tokens remain server-side."}, {"id": "readme_personal_secure_vault", "label": "Personal Secure Vault", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Owner-bound and record-bound AES-256-GCM authenticated encryption protects password/key-value records and provider connections."}, {"id": "readme_provider_connections", "label": "Secure Vault provider connections", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Built-in provider templates supply model catalogs; custom public HTTPS hosts need an explicit allowlist and model."}, {"id": "readme_provider_ssrf_guards", "label": "Provider destination validation", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Server requests recheck DNS, reject redirects and reject destinations outside the public HTTPS allowlist."}, {"id": "readme_graphify_snapshots", "label": "Content-addressed Graphify snapshots", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Immutable portable snapshots avoid generated JSON line-merge conflicts between branches."}, {"id": "readme_graphify_wrapper", "label": "scripts/graphify wrapper", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Serializes writers, holds reader snapshots, validates atomic outputs and deduplicates artifacts."}, {"id": "readme_graphify_retention", "label": "Graphify bounded snapshot retention", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One current portable snapshot is kept by default so merged branch artifacts cannot grow develop without bound."}, {"id": "readme_github_actions_control_plane", "label": "GitHub Actions control plane", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Executable CI behavior lives on the protected github-actions branch; product branches contain thin listeners."}, {"id": "readme_thin_workflow_listeners", "label": "Thin workflow listeners", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Native events call reusable workflows pinned to github-actions."}, {"id": "readme_codeql_coverage", "label": "CodeQL all-branch and PR-target coverage", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Separate metadata handoff closes the arbitrary-target gap while preserving ordinary PR check contexts."}, {"id": "readme_codeql_metadata_handoff", "label": "CodeQL metadata-only handoff", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Privileged pull_request_target dispatches only PR number and immutable head SHA without checking out code or receiving AI credentials."}, {"id": "readme_ci_control", "label": "Admin CI Control", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Signed GitHub and Vercel webhooks project delivery state and audited operations into protected Things."}, {"id": "readme_feature_stacks", "label": "Feature Stacks", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ordered same-repository PR heads are integrated per target with verified merge parents and clean-merge bytes."}, {"id": "readme_claude_credential_waterfall", "label": "Claude credential waterfall", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Up to eight enabled named accounts are encrypted and fetched just in time; only classified capacity or credential errors advance the waterfall."}, {"id": "readme_ci_telemetry_satellite", "label": "CI Control telemetry satellite", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ci-* records use a dedicated TTL-managed collection; durable repository and policy projections never expire."}, {"id": "readme_vercel_sandbox_compute", "label": "Vercel Sandbox CI compute", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GitHub remains the event/workflow control plane while an ephemeral registered runner supplies Vercel compute, with GitHub fallback."}, {"id": "readme_api_documentation", "label": "API self-documentation", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every registered endpoint exposes GET/POST -docs discovery and generated client examples."}, {"id": "readme_password_reset", "label": "Password reset", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single-use one-hour tokens are consumed atomically, password hashes replaced and live sessions revoked; uniform responses resist account enumeration."}, {"id": "readme_email_two_factor", "label": "Email two-factor authentication", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verified-email accounts can require a hashed, attempt-capped six-digit code before session creation."}, {"id": "readme_admin_integration_vault", "label": "Admin integration vault", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A distinct server-only AES key protects external credentials and the Lopu credential collection."}, {"id": "readme_policy_proxy", "label": "Admin endpoint policy proxy", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Saved endpoint IDs enforce HTTPS origins, path prefixes, bounded bytes, no redirects and selected read/create-only/write permissions."}, {"id": "readme_passkey_environment_identity", "label": "Passkey account-environment identity", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A shared relying-party domain does not replicate accounts or credentials between databases."}, {"id": "readme_passkey_ceremonies", "label": "Passkey challenge lifecycle", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Independent signed origin-bound httpOnly challenges expire after ten minutes and are spent atomically in authOtps."}, {"id": "readme_apple_passkey_association", "label": "Apple passkey app association", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Associated Domains entitlements and HTTPS apple-app-site-association metadata bind signed native apps to the RP domain."}, {"id": "readme_verified_vault_viewing", "label": "Verified vault viewing", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An explicit Show operation requires current password or fresh user-verified passkey per selected entry while ordinary reads remain redacted."}, {"id": "readme_vault_reveal_scope", "label": "Vault reveal authorization scope", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Admin and CI records require a current admin role; personal records remain owner-only."}, {"id": "readme_transient_vault_display", "label": "Transient vault display", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Displayed values hide after 30 seconds, dialog closure or leaving the tab."}, {"id": "readme_vault_reveal_deployment", "label": "Verified vault reveal fork setup", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keep unique per-environment vault keys stable; configured personal keys fall back to the admin root through the existing vault design."}, {"id": "readme_vault_reveal_challenge", "label": "Single-use vault passkey challenge", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two-minute verification is bound to session, origin and item using existing authentication keys and TTL storage; no new migration or index is required."}, {"id": "readme_vault_reveal_capability", "label": "api.vault-reveal 1.0.0", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The same-origin capability is negotiated before use and fixed security attempt limits apply to every subscription tier."}, {"id": "readme_vault_validation_stack", "label": "Vault reveal local validation stack", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Canonical PM2 uses Vite 17340, HMR 17341 and Nitro 17342; public Funnel was unavailable because its installed launcher target was missing."}, {"id": "readme_desktop_privacy_status", "label": "Desktop live privacy status", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Queries the running Node helper; visible setup refreshes every five seconds and on return from System Settings, Check access retries immediately, and failed checks preserve labelled last-known results."}, {"id": "readme_desktop_permission_recovery", "label": "Desktop permission recovery", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Open App Locations helps owners manually re-add intended apps to macOS privacy permissions. No grant is changed automatically; restart affected apps after permission changes."}, {"id": "readme_app_locations", "label": "Open App Locations", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A private folder contains shortcuts to the running Desktop, bundled Node and installed Recovery, Commander, ThingDisk and ThingDock apps; duplicate old installations are omitted."}, {"id": "readme_node_recovery_restart", "label": "Node recovery restart choice", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returning from an explicit recovery flow offers Later or Restart Node Now. macOS independently controls its Quit 