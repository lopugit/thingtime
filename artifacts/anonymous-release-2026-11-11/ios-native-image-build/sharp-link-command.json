  "-lgmodule-2.0",
  "-lgobject-2.0",
  "-lglib-2.0",
  "-lintl",
  "-liconv",
  "-lm",
  "-L<CACHE>/recipe/build/staging/pcre2/ios-sim-arm64/lib",
  "-lpcre2-8",
