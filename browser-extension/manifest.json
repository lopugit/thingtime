{
  "manifest_version": 3,
  "name": "Thingtime",
  "description": "Opt in to use your Thingtime vault for website passkeys.",
  "version": "0.2.1",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "alarms"
  ],
  "host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Thingtime",
    "default_icon": {
      "16": "thingtime-icon-16.png",
      "32": "thingtime-icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "thingtime-icon-16.png",
    "32": "thingtime-icon-32.png",
    "48": "thingtime-icon-48.png",
    "128": "thingtime-icon-128.png"
  }
}
