build/*
public/build/*
api/index.js
api/index.js.map
remix/.vercel/
remix/dist/
remix/server/assets/*
!remix/server/assets/.gitignore
electron/dist/
electron/release/
electron/node_modules/

tmp/*

# Xcode / XcodeGen local outputs
iOS/*.xcodeproj/
iOS/*.xcworkspace/
iOS/DerivedData/
iOS/build/
iOS/*.xcarchive
iOS/*.ipa
iOS/*.dSYM
iOS/.env
iOS/.env.*
!iOS/.env.example
iOS/fastlane/report.xml
iOS/fastlane/Preview.html
iOS/fastlane/screenshots/
iOS/fastlane/test_output/
iOS/xcuserdata/
iOS/**/xcuserdata/
iOS/Thingtime/Resources/Info.plist

# graphify - immutable portable snapshots + untracked compatibility aliases
graphify-out/.graphify_*
graphify-out/.vocab.txt
graphify-out/graph.json
graphify-out/manifest.json
graphify-out/GRAPH_REPORT.md
graphify-out/cost.json
graphify-out/.work/
graphify-out/.locks/
# cache: semantic/ is tracked (content-addressed extractions -> merge-safe, makes
# full rebuilds in fresh clones LLM-free); ast/ + stat-index.json stay local
# (stat-index is keyed by absolute paths)
graphify-out/cache/*
!graphify-out/cache/semantic/
# derived 27MB viz - regenerate with `graphify export html`
graphify-out/graph.html
graphify-out/snapshots/**/graph.html
graphify-out/snapshots/**/.graphify_*
graphify-out/snapshots/**/.staging-*
# dated curated-graph backups created by `graphify update`
graphify-out/[0-9]*/

# Keep test branch workspace directories out of git, but keep the folder itself.
/.test-branches/*
!/.test-branches/.keep

# design-sync (claude.ai/design) — staged scripts, build output, machine state.
# Durable inputs under .design-sync/ (config.json, NOTES.md, conventions.md,
# previews/, overrides/) are committed; everything below is regenerated.
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
