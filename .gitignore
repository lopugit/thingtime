tmp/*

# Xcode / XcodeGen local outputs
iOS/*.xcodeproj/
iOS/*.xcworkspace/
iOS/DerivedData/
iOS/build/
iOS/*.xcarchive
iOS/*.ipa
iOS/*.dSYM
iOS/.env
iOS/.env.*
!iOS/.env.example
iOS/fastlane/report.xml
iOS/fastlane/Preview.html
iOS/fastlane/screenshots/
iOS/fastlane/test_output/
iOS/xcuserdata/
