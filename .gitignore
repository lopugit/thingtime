iOS/Thingtime/Resources/Info.plist

# graphify - one active immutable portable snapshot + untracked aliases
graphify-out/.graphify_*
graphify-out/.rebuild.lock
graphify-out/.vocab.txt
# Mutable root files are symlinks created by scripts/graphify for compatibility
# with ordinary `graphify query`; the wrapper prunes superseded snapshots.
graphify-out/graph.json
graphify-out/manifest.json
graphify-out/GRAPH_REPORT.md
graphify-out/cost.json
graphify-out/.work/
graphify-out/.locks/
# cache: Graphify's mutable semantic/ names are input keys and can be rewritten
# with different valid bytes. Only immutable semantic-cas variants are tracked;
# ast/ + stat-index.json stay local (stat-index uses absolute paths).
graphify-out/cache/*
!graphify-out/cache/semantic-cas/
!graphify-out/cache/semantic-cas/**
# derived 27MB viz - regenerate with `graphify export html`
graphify-out/graph.html
graphify-out/snapshots/**/graph.html
graphify-out/snapshots/**/.graphify_*
graphify-out/snapshots/**/.staging-*
# dated curated-graph backups created by `graphify update`
graphify-out/[0-9]*/

# Keep test branch workspace directories out of git, but keep the folder itself.
/.test-branches/*
!/.test-branches/.keep

# design-sync (claude.ai/design) — staged scripts, build output, machine state.
# Durable inputs under .design-sync/ (config.json, NOTES.md, conventions.md,
# previews/, overrides/) are committed; everything below is regenerated.
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
