{
	"slug": "antd-onboarding-tour-step",
	"name": "Tour Step Popover",
	"library": "antd",
	"category": "onboarding",
	"description": "Feature-tour popover step in the Ant Design style — mono step counter, title and body copy, dot progress (solid tone active dot over faint done dots) with back/next actions.",
	"tags": [
		"onboarding",
		"tour",
		"popover",
		"walkthrough"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Pin your favorites",
			"label": "Title",
			"maxLength": 48
		},
		{
			"name": "body",
			"type": "text",
			"default": "Drag any item onto the sidebar to keep it one click away, on every device.",
			"label": "Body",
			"maxLength": 160
		},
		{
			"name": "step",
			"type": "number",
			"default": 2,
			"label": "Step",
			"min": 1,
			"max": 8
		},
		{
			"name": "total",
			"type": "number",
			"default": 4,
			"label": "Total steps",
			"min": 1,
			"max": 8
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
				"background": "#ffffff",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "#d9d9d9",
				"borderRadius": "8px",
				"boxShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.03), 0 1px 6px -1px rgba(0, 0, 0, 0.02)",
				"boxSizing": "border-box",
				"width": "272px",
				"gap": "8px",
				"padding": "16px"
			}
		},
		"children": [
			{
				"tag": "span",
				"props": {
					"style": {
						"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
						"fontSize": "12px",
						"color": "rgba(0, 0, 0, 0.45)",
						"letterSpacing": "0.05em",
						"textTransform": "uppercase"
					}
				},
				"children": [
					"Step {step} of {total}"
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "16px",
						"fontWeight": 600,
						"color": "rgba(0, 0, 0, 0.88)"
					}
				},
				"children": [
					"{title}"
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "13px",
						"color": "rgba(0, 0, 0, 0.45)",
						"lineHeight": 1.5
					}
				},
				"children": [
					"{body}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "space-between",
						"gap": "12px",
						"marginTop": "6px"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"position": "relative",
								"gap": "6px",
								"flexShrink": 0
							}
						},
						"children": [
							{
								"ttRepeat": {
									"arg": "total",
									"max": 8,
									"node": {
										"tag": "span",
										"props": {
											"style": {
												"width": "8px",
												"height": "8px",
												"borderRadius": "999px",
												"background": "#f0f0f0"
											}
										}
									}
								}
							},
							{
								"tag": "div",
								"props": {
									"style": {
										"position": "absolute",
										"top": 0,
										"left": 0,
										"display": "flex",
										"gap": "6px"
									}
								},
								"children": [
									{
										"ttRepeat": {
											"arg": "step",
											"max": 8,
											"node": {
												"tag": "span",
												"props": {
													"style": {
														"width": "8px",
														"height": "8px",
														"borderRadius": "999px",
														"background": "rgba(0, 0, 0, 0.25)"
													}
												}
											}
										}
									}
								]
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"position": "absolute",
										"top": 0,
										"left": "calc(({step} - 1) * 14px)",
										"width": "8px",
										"height": "8px",
										"borderRadius": "999px",
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#1677ff",
													"success": "#52c41a",
													"warning": "#faad14",
													"danger": "#ff4d4f",
													"info": "#1677ff",
													"neutral": "rgba(0, 0, 0, 0.88)"
												},
												"default": "#1677ff"
											}
										}
									}
								}
							}
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"gap": "8px"
							}
						},
						"children": [
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"display": "inline-flex",
										"alignItems": "center",
										"justifyContent": "center",
										"gap": "6px",
										"border": "none",
										"borderRadius": "6px",
										"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
										"fontWeight": 400,
										"cursor": "pointer",
										"background": "transparent",
										"color": "rgba(0, 0, 0, 0.45)",
										"height": "24px",
										"padding": "0 10px",
										"fontSize": "13px"
									}
								},
								"children": [
									"Back"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"display": "inline-flex",
										"alignItems": "center",
										"justifyContent": "center",
										"gap": "6px",
										"border": "none",
										"borderRadius": "6px",
										"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
										"fontWeight": 400,
										"cursor": "pointer",
										"height": "24px",
										"padding": "0 12px",
										"fontSize": "13px",
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#1677ff",
													"success": "#52c41a",
													"warning": "#faad14",
													"danger": "#ff4d4f",
													"info": "#1677ff",
													"neutral": "rgba(0, 0, 0, 0.88)"
												},
												"default": "#1677ff"
											}
										},
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#ffffff",
													"success": "#ffffff",
													"warning": "#ffffff",
													"danger": "#ffffff",
													"info": "#ffffff",
													"neutral": "#ffffff"
												},
												"default": "#ffffff"
											}
										}
									}
								},
								"children": [
									"Next",
									{
										"tag": "svg",
										"props": {
											"width": 14,
											"height": 14,
											"viewBox": "0 0 24 24",
											"fill": "none",
											"stroke": "currentColor",
											"strokeWidth": 2,
											"strokeLinecap": "round",
											"strokeLinejoin": "round",
											"xmlns": "http://www.w3.org/2000/svg"
										},
										"children": [
											{
												"tag": "line",
												"props": {
													"x1": 5,
													"y1": 12,
													"x2": 19,
													"y2": 12
												}
											},
											{
												"tag": "polyline",
												"props": {
													"points": "12 5 19 12 12 19"
												}
											}
										]
									}
								]
							}
						]
					}
				]
			}
		]
	},
	"previewBg": "#f5f5f5",
	"version": 1,
	"familyKey": "onboarding-tour-step",
	"source": {
		"kind": "archetype",
		"archetype": "onboarding",
		"variant": "tour-step",
		"tranche": 2
	}
}
