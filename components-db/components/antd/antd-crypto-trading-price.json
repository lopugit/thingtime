			"label": "Symbol",
			"maxLength": 8
		},
		{
			"name": "name",
			"type": "string",
			"default": "Bitcoin",
			"label": "Name",
			"maxLength": 20
		},
		{
			"name": "price",
			"type": "string",
			"default": "$67,412.80",
			"label": "Price",
			"maxLength": 16
		},
		{
			"name": "change",
