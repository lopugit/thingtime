{
	"slug": "antd-empty-states-onboarding",
	"name": "Onboarding CTA",
	"library": "antd",
	"category": "feedback",
	"description": "Onboarding call-to-action panel in the Ant Design style — welcome heading, numbered step dots hinting at the setup flow, and a solid tone start button.",
	"tags": [
		"onboarding",
		"empty-state",
		"steps",
		"cta"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Welcome to your workspace",
			"label": "Title",
			"maxLength": 50
		},
		{
			"name": "body",
			"type": "text",
			"default": "A few quick steps and you’re up and running.",
			"label": "Body"
		},
		{
			"name": "ctaLabel",
			"type": "string",
			"default": "Start setup",
			"label": "CTA label",
			"maxLength": 32
		},
		{
			"name": "steps",
			"type": "number",
			"default": 3,
			"label": "Steps",
			"min": 2,
			"max": 6
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"alignItems": "center",
				"justifyContent": "center",
				"textAlign": "center",
				"gap": "6px",
				"width": "360px",
				"padding": "40px 28px",
				"background": "#ffffff",
				"borderRadius": "8px",
				"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
				"color": "rgba(0, 0, 0, 0.88)",
				"border": "1px solid #d9d9d9",
				"boxShadow": "0 9px 28px 8px rgba(0, 0, 0, 0.05), 0 6px 16px 0 rgba(0, 0, 0, 0.08)"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"width": "46px",
						"height": "46px",
						"borderRadius": "999px",
						"background": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#e6f4ff",
									"success": "#f6ffed",
									"warning": "#fffbe6",
									"danger": "#fff2f0",
									"info": "#e6f4ff",
									"neutral": "#fafafa"
								},
								"default": "#e6f4ff"
							}
						},
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#0958d9",
									"success": "#389e0d",
									"warning": "#d48806",
									"danger": "#cf1322",
									"info": "#0958d9",
									"neutral": "rgba(0, 0, 0, 0.65)"
								},
								"default": "#0958d9"
							}
						},
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "center",
						"marginBottom": "4px"
					}
				},
				"children": [
					{
						"tag": "svg",
						"props": {
							"width": 20,
							"height": 20,
							"viewBox": "0 0 24 24",
							"fill": "none",
							"stroke": "currentColor",
							"strokeWidth": 2,
							"strokeLinecap": "round",
							"strokeLinejoin": "round",
							"xmlns": "http://www.w3.org/2000/svg"
						},
						"children": [
							{
								"tag": "polygon",
								"props": {
									"points": "13 2 3 14 12 14 11 22 21 10 12 10 13 2"
								}
							}
						]
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontWeight": 600,
						"fontSize": "20px"
					}
				},
				"children": [
					"{title}"
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "13px",
						"color": "rgba(0, 0, 0, 0.45)",
						"lineHeight": 1.5,
						"maxWidth": "270px"
					}
				},
				"children": [
					"{body}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "8px",
						"marginTop": "10px",
						"justifyContent": "center"
					}
				},
				"children": [
					{
						"ttRepeat": {
							"arg": "steps",
							"max": 6,
							"node": {
								"tag": "div",
								"props": {
									"style": {
										"width": "24px",
										"height": "24px",
										"borderRadius": "999px",
										"display": "flex",
										"alignItems": "center",
										"justifyContent": "center",
										"fontSize": "12px",
										"fontWeight": 600,
										"background": {
											"ttIf": {
												"arg": "n",
												"equals": 1,
												"then": {
													"ttMap": {
														"arg": "tone",
														"values": {
															"primary": "#1677ff",
															"success": "#52c41a",
															"warning": "#faad14",
															"danger": "#ff4d4f",
															"info": "#1677ff",
															"neutral": "rgba(0, 0, 0, 0.88)"
														},
														"default": "#1677ff"
													}
												},
												"else": "#fafafa"
											}
										},
										"color": {
											"ttIf": {
												"arg": "n",
												"equals": 1,
												"then": {
													"ttMap": {
														"arg": "tone",
														"values": {
															"primary": "#ffffff",
															"success": "#ffffff",
															"warning": "#ffffff",
															"danger": "#ffffff",
															"info": "#ffffff",
															"neutral": "#ffffff"
														},
														"default": "#ffffff"
													}
												},
												"else": "rgba(0, 0, 0, 0.45)"
											}
										}
									}
								},
								"children": [
									"{n}"
								]
							}
						}
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "12px",
						"color": "rgba(0, 0, 0, 0.25)"
					}
				},
				"children": [
					"Step 1 of {steps}"
				]
			},
			{
				"tag": "button",
				"props": {
					"type": "button",
					"style": {
						"display": "inline-flex",
						"alignItems": "center",
						"justifyContent": "center",
						"height": "32px",
						"padding": "0 18px",
						"border": "none",
						"borderRadius": "6px",
						"background": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#1677ff",
									"success": "#52c41a",
									"warning": "#faad14",
									"danger": "#ff4d4f",
									"info": "#1677ff",
									"neutral": "rgba(0, 0, 0, 0.88)"
								},
								"default": "#1677ff"
							}
						},
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#ffffff",
									"success": "#ffffff",
									"warning": "#ffffff",
									"danger": "#ffffff",
									"info": "#ffffff",
									"neutral": "#ffffff"
								},
								"default": "#ffffff"
							}
						},
						"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
						"fontSize": "13px",
						"fontWeight": 400,
						"boxShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.03), 0 1px 6px -1px rgba(0, 0, 0, 0.02)",
						"cursor": "pointer",
						"marginTop": "8px"
					}
				},
				"children": [
					"{ctaLabel}"
				]
			}
		]
	},
	"previewBg": "#f5f5f5",
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "empty-states",
		"variant": "onboarding",
		"tranche": 1
	}
}
