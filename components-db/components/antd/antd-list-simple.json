{
	"slug": "antd-list-simple",
	"name": "Simple List",
	"library": "antd",
	"category": "data-display",
	"description": "Plain text list rows in the Ant Design style — hairline separators, library-native type, with toggleable dividers and outer border.",
	"tags": [
		"list",
		"rows",
		"text",
		"data"
	],
	"args": [
		{
			"name": "item",
			"type": "string",
			"default": "List item",
			"label": "Item label",
			"maxLength": 40
		},
		{
			"name": "count",
			"type": "number",
			"default": 4,
			"label": "Rows",
			"min": 1,
			"max": 8
		},
		{
			"name": "divided",
			"type": "boolean",
			"default": true,
			"label": "Dividers"
		},
		{
			"name": "bordered",
			"type": "boolean",
			"default": true,
			"label": "Border"
		}
	],
	"render": {
		"tag": "ul",
		"props": {
			"style": {
				"ttMerge": [
					{
						"listStyle": "none",
						"margin": 0,
						"padding": 0,
						"width": "280px",
						"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
						"color": "rgba(0, 0, 0, 0.88)",
						"background": "#ffffff",
						"borderRadius": "6px",
						"overflow": "hidden"
					},
					{
						"ttIf": {
							"arg": "bordered",
							"then": {
								"border": "1px solid #d9d9d9",
								"boxShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.03), 0 1px 6px -1px rgba(0, 0, 0, 0.02)"
							},
							"else": {}
						}
					}
				]
			}
		},
		"children": [
			{
				"ttRepeat": {
					"arg": "count",
					"max": 8,
					"node": {
						"tag": "li",
						"props": {
							"style": {
								"ttMerge": [
									{
										"display": "flex",
										"alignItems": "center",
										"gap": "12px",
										"padding": "10px 14px",
										"fontSize": "14px"
									},
									{
										"ttIf": {
											"arg": "divided",
											"then": {
												"ttIf": {
													"arg": "n",
													"equals": 1,
													"then": {},
													"else": {
														"borderTop": "1px solid #f0f0f0"
													}
												}
											},
											"else": {}
										}
									}
								]
							}
						},
						"children": [
							"{item} {n}"
						]
					}
				}
			}
		]
	},
	"version": 1,
	"familyKey": "list-simple",
	"source": {
		"kind": "archetype",
		"archetype": "list",
		"variant": "simple",
		"tranche": 1
	}
}
