{
	"slug": "antd-chip-closable",
	"name": "Closable Chip",
	"library": "antd",
	"category": "data-display",
	"description": "Removable tag chip in the Ant Design style — a soft tone chip with a trailing x glyph, dimming when disabled.",
	"tags": [
		"chip",
		"tag",
		"closable",
		"removable"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Filter: recent",
			"label": "Label",
			"maxLength": 24
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "disabled",
			"type": "boolean",
			"default": false,
			"label": "Disabled"
		}
	],
	"render": {
		"tag": "span",
		"props": {
			"style": {
				"ttMerge": [
					{
						"display": "inline-flex",
						"alignItems": "center",
						"gap": "6px",
						"height": "24px",
						"padding": "0 12px",
						"borderRadius": "4px",
						"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
						"fontWeight": 500,
						"fontSize": "13px"
					},
					{
						"background": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#e6f4ff",
									"success": "#f6ffed",
									"warning": "#fffbe6",
									"danger": "#fff2f0",
									"info": "#e6f4ff",
									"neutral": "#fafafa"
								},
								"default": "#e6f4ff"
							}
						},
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#0958d9",
									"success": "#389e0d",
									"warning": "#d48806",
									"danger": "#cf1322",
									"info": "#0958d9",
									"neutral": "rgba(0, 0, 0, 0.65)"
								},
								"default": "#0958d9"
							}
						},
						"borderWidth": "1px",
						"borderStyle": "solid",
						"borderColor": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#91caff",
									"success": "#b7eb8f",
									"warning": "#ffe58f",
									"danger": "#ffccc7",
									"info": "#91caff",
									"neutral": "#d9d9d9"
								},
								"default": "#91caff"
							}
						}
					},
					{
						"cursor": "pointer"
					},
					{
						"ttIf": {
							"arg": "disabled",
							"then": {
								"opacity": 0.5,
								"cursor": "not-allowed"
							},
							"else": {}
						}
					}
				]
			}
		},
		"children": [
			"{label}",
			{
				"tag": "svg",
				"props": {
					"width": 12,
					"height": 12,
					"viewBox": "0 0 24 24",
					"fill": "none",
					"stroke": "currentColor",
					"strokeWidth": 2,
					"strokeLinecap": "round",
					"strokeLinejoin": "round",
					"xmlns": "http://www.w3.org/2000/svg"
				},
				"children": [
					{
						"tag": "line",
						"props": {
							"x1": 18,
							"y1": 6,
							"x2": 6,
							"y2": 18
						}
					},
					{
						"tag": "line",
						"props": {
							"x1": 6,
							"y1": 6,
							"x2": 18,
							"y2": 18
						}
					}
				]
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "chip",
		"variant": "closable",
		"tranche": 1
	}
}
