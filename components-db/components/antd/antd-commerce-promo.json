{
	"slug": "antd-commerce-promo",
	"name": "Promo Code Row",
	"library": "antd",
	"category": "commerce",
	"description": "Promo code row in the Ant Design style — dashed voucher field showing the code as an applied chip, an apply button, and a success caption that appears once the code is accepted.",
	"tags": [
		"commerce",
		"promo",
		"coupon",
		"discount"
	],
	"args": [
		{
			"name": "code",
			"type": "string",
			"default": "SAVE20",
			"label": "Code",
			"maxLength": 16
		},
		{
			"name": "applied",
			"type": "boolean",
			"default": true,
			"label": "Applied"
		},
		{
			"name": "discount",
			"type": "string",
			"default": "20% off",
			"label": "Discount",
			"maxLength": 16
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"gap": "6px",
				"width": "320px",
				"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "8px"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"flex": "1 1 auto",
								"height": "32px",
								"padding": "0 10px",
								"border": "1px dashed #d9d9d9",
								"borderRadius": "6px",
								"background": "#fafafa",
								"boxSizing": "border-box"
							}
						},
						"children": [
							{
								"ttIf": {
									"arg": "applied",
									"then": {
										"tag": "span",
										"props": {
											"style": {
												"display": "inline-flex",
												"alignItems": "center",
												"gap": "6px",
												"padding": "2px 10px",
												"borderRadius": "4px",
												"background": "#f6ffed",
												"color": "#389e0d",
												"fontSize": "12px",
												"fontWeight": 700,
												"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
											}
										},
										"children": [
											{
												"tag": "svg",
												"props": {
													"width": 11,
													"height": 11,
													"viewBox": "0 0 24 24",
													"fill": "none",
													"stroke": "currentColor",
													"strokeWidth": 2,
													"strokeLinecap": "round",
													"strokeLinejoin": "round",
													"xmlns": "http://www.w3.org/2000/svg"
												},
												"children": [
													{
														"tag": "polyline",
														"props": {
															"points": "20 6 9 17 4 12"
														}
													}
												]
											},
											"{code}"
										]
									},
									"else": {
										"tag": "span",
										"props": {
											"style": {
												"fontSize": "13px",
												"color": "rgba(0, 0, 0, 0.25)",
												"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
											}
										},
										"children": [
											"{code}"
										]
									}
								}
							}
						]
					},
					{
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"display": "inline-flex",
								"alignItems": "center",
								"justifyContent": "center",
								"gap": "6px",
								"border": "none",
								"borderRadius": "6px",
								"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
								"fontWeight": 400,
								"cursor": "pointer",
								"height": "32px",
								"padding": "0 16px",
								"fontSize": "13px",
								"background": "#1677ff",
								"color": "#ffffff",
								"flexShrink": 0
							}
						},
						"children": [
							"Apply"
						]
					}
				]
			},
			{
				"ttIf": {
					"arg": "applied",
					"then": {
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"gap": "5px"
							}
						},
						"children": [
							{
								"tag": "svg",
								"props": {
									"width": 12,
									"height": 12,
									"viewBox": "0 0 24 24",
									"fill": "none",
									"stroke": "#52c41a",
									"strokeWidth": 2,
									"strokeLinecap": "round",
									"strokeLinejoin": "round",
									"xmlns": "http://www.w3.org/2000/svg"
								},
								"children": [
									{
										"tag": "polyline",
										"props": {
											"points": "20 6 9 17 4 12"
										}
									}
								]
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "12px",
										"color": "#389e0d"
									}
								},
								"children": [
									"{discount} applied to your order"
								]
							}
						]
					}
				}
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "commerce",
		"variant": "promo",
		"tranche": 2
	}
}
