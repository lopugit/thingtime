{
	"slug": "antd-flow-node",
	"name": "Flow Node",
	"library": "antd",
	"category": "flow",
	"description": "Graph node card in the Ant Design style — title, mono sublabel, tone status dot, and top/bottom connection handles with an accent ring when selected.",
	"tags": [
		"flow",
		"node",
		"graph",
		"handle"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Transform",
			"label": "Label",
			"maxLength": 30
		},
		{
			"name": "sublabel",
			"type": "string",
			"default": "normalize()",
			"label": "Sublabel",
			"maxLength": 30
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "success",
			"label": "Tone"
		},
		{
			"name": "selected",
			"type": "boolean",
			"default": false,
			"label": "Selected"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"padding": "10px 4px",
				"display": "inline-block"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"ttMerge": [
							{
								"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
								"background": "#ffffff",
								"borderWidth": "1px",
								"borderStyle": "solid",
								"borderColor": "#d9d9d9",
								"borderRadius": "6px",
								"boxShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.03), 0 1px 6px -1px rgba(0, 0, 0, 0.02)",
								"boxSizing": "border-box",
								"position": "relative",
								"width": "180px",
								"padding": "10px 12px"
							},
							{
								"ttIf": {
									"arg": "selected",
									"then": {
										"borderColor": "#1677ff",
										"boxShadow": "0 0 0 1px #1677ff"
									},
									"else": {}
								}
							}
						]
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"position": "absolute",
								"width": "10px",
								"height": "10px",
								"borderRadius": "999px",
								"background": "#1677ff",
								"borderWidth": "2px",
								"borderStyle": "solid",
								"borderColor": "#ffffff",
								"boxSizing": "border-box",
								"top": "-6px",
								"left": "50%",
								"marginLeft": "-5px"
							}
						}
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"gap": "8px"
							}
						},
						"children": [
							{
								"tag": "span",
								"props": {
									"style": {
										"width": "8px",
										"height": "8px",
										"borderRadius": "999px",
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#1677ff",
													"success": "#52c41a",
													"warning": "#faad14",
													"danger": "#ff4d4f",
													"info": "#1677ff",
													"neutral": "rgba(0, 0, 0, 0.88)"
												},
												"default": "#52c41a"
											}
										},
										"flexShrink": 0
									}
								}
							},
							{
								"tag": "div",
								"props": {
									"style": {
										"display": "flex",
										"flexDirection": "column",
										"gap": "2px",
										"minWidth": "0"
									}
								},
								"children": [
									{
										"tag": "span",
										"props": {
											"style": {
												"fontSize": "13px",
												"fontWeight": 600,
												"color": "rgba(0, 0, 0, 0.88)"
											}
										},
										"children": [
											"{label}"
										]
									},
									{
										"tag": "span",
										"props": {
											"style": {
												"fontSize": "12px",
												"color": "rgba(0, 0, 0, 0.45)",
												"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
											}
										},
										"children": [
											"{sublabel}"
										]
									}
								]
							}
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"position": "absolute",
								"width": "10px",
								"height": "10px",
								"borderRadius": "999px",
								"background": "#1677ff",
								"borderWidth": "2px",
								"borderStyle": "solid",
								"borderColor": "#ffffff",
								"boxSizing": "border-box",
								"bottom": "-6px",
								"left": "50%",
								"marginLeft": "-5px"
							}
						}
					}
				]
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "flow",
		"variant": "node",
		"tranche": 1
	}
}
