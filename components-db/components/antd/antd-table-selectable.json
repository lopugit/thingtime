			"values": [
				"1",
				"2",
				"3",
				"none"
			],
			"default": "2",
			"label": "Selected row"
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
