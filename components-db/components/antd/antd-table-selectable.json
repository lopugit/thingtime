{
	"slug": "antd-table-selectable",
	"name": "Selectable Table",
	"library": "antd",
	"category": "data-display",
	"description": "Selectable table in the Ant Design style — header checkbox, per-row checkboxes, and a tone-tinted highlight on the selected row.",
	"tags": [
		"table",
		"selectable",
		"checkbox",
		"data"
	],
	"args": [
		{
			"name": "col1",
			"type": "string",
			"default": "Member",
			"label": "Column 1",
			"maxLength": 24
