{
	"slug": "antd-support-help-ticket",
	"name": "Support Ticket Row",
	"library": "antd",
	"category": "support",
	"description": "Support ticket queue row in the Ant Design style — mono id chip, subject with requester caption, priority and status chips, and the assignee avatar on library-native corners.",
	"tags": [
		"support",
		"ticket",
		"queue",
		"row",
		"status"
	],
	"args": [
		{
			"name": "id",
			"type": "string",
			"default": "4821",
			"label": "Ticket #",
			"maxLength": 8
		},
		{
			"name": "subject",
			"type": "string",
			"default": "Cannot connect my calendar",
			"label": "Subject",
			"maxLength": 60
		},
		{
			"name": "requester",
			"type": "string",
			"default": "Dana P.",
			"label": "Requester",
			"maxLength": 24
		},
		{
			"name": "updated",
			"type": "string",
			"default": "2h ago",
			"label": "Updated",
			"maxLength": 16
		},
		{
			"name": "priority",
			"type": "enum",
			"values": [
				"low",
				"medium",
				"high",
				"urgent"
			],
			"default": "high",
			"label": "Priority"
		},
		{
			"name": "status",
			"type": "enum",
			"values": [
				"open",
				"waiting"
			],
			"default": "open",
			"label": "Status"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"ttMerge": [
					{
						"background": "#ffffff",
						"borderWidth": "1px",
						"borderStyle": "solid",
						"borderColor": "#d9d9d9",
						"borderRadius": "8px",
						"boxShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.03), 0 1px 6px -1px rgba(0, 0, 0, 0.02)",
						"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
						"color": "rgba(0, 0, 0, 0.88)",
						"boxSizing": "border-box"
					},
					{
						"display": "flex",
						"alignItems": "center",
						"gap": "12px",
						"width": "430px",
						"padding": "10px 14px",
						"borderRadius": "6px"
					}
				]
			}
		},
		"children": [
			{
				"tag": "span",
				"props": {
					"style": {
						"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
						"fontSize": "12px",
						"color": "rgba(0, 0, 0, 0.45)",
						"background": "#fafafa",
						"padding": "2px 6px",
						"borderRadius": "4px",
						"borderWidth": "1px",
						"borderStyle": "solid",
						"borderColor": "#f0f0f0",
						"flexShrink": 0
					}
				},
				"children": [
					"#{id}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"gap": "2px",
						"flex": "1 1 auto",
						"minWidth": 0
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "13px",
								"fontWeight": 600,
								"color": "rgba(0, 0, 0, 0.88)",
								"whiteSpace": "nowrap",
								"overflow": "hidden",
								"textOverflow": "ellipsis"
							}
						},
						"children": [
							"{subject}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "12px",
								"color": "rgba(0, 0, 0, 0.45)"
							}
						},
						"children": [
							"{requester} · Updated {updated}"
						]
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"ttMerge": [
							{
								"display": "inline-flex",
								"alignItems": "center",
								"gap": "6px",
								"padding": "2px 8px",
								"fontSize": "12px",
								"fontWeight": 600,
								"lineHeight": 1.4,
								"borderRadius": "4px",
								"textTransform": "capitalize",
								"whiteSpace": "nowrap",
								"flexShrink": 0
							},
							{
								"background": {
									"ttMap": {
										"arg": "priority",
										"values": {
											"low": "#fafafa",
											"medium": "#e6f4ff",
											"high": "#fffbe6",
											"urgent": "#fff2f0"
										},
										"default": "#fafafa"
									}
								},
								"color": {
									"ttMap": {
										"arg": "priority",
										"values": {
											"low": "rgba(0, 0, 0, 0.65)",
											"medium": "#0958d9",
											"high": "#d48806",
											"urgent": "#cf1322"
										},
										"default": "rgba(0, 0, 0, 0.65)"
									}
								}
							},
							{
								"borderWidth": "1px",
								"borderStyle": "solid",
								"borderColor": {
									"ttMap": {
										"arg": "priority",
										"values": {
											"low": "#d9d9d9",
											"medium": "#91caff",
											"high": "#ffe58f",
											"urgent": "#ffccc7"
										},
										"default": "#d9d9d9"
									}
								}
							}
						]
					}
				},
				"children": [
					"{priority}"
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"ttMerge": [
							{
								"display": "inline-flex",
								"alignItems": "center",
								"gap": "6px",
								"padding": "2px 8px",
								"fontSize": "12px",
								"fontWeight": 600,
								"lineHeight": 1.4,
								"borderRadius": "4px",
								"textTransform": "capitalize",
								"whiteSpace": "nowrap",
								"flexShrink": 0
							},
							{
								"ttIf": {
									"arg": "status",
									"equals": "open",
									"then": {
										"background": "#e6f4ff",
										"color": "#0958d9"
									},
									"else": {
										"background": "#fafafa",
										"color": "rgba(0, 0, 0, 0.45)"
									}
								}
							}
						]
					}
				},
				"children": [
					"{status}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"width": "26px",
						"height": "26px",
						"borderRadius": "999px",
						"background": "#1677ff",
						"color": "#ffffff",
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "center",
						"fontWeight": 600,
						"fontSize": "12px",
						"flexShrink": 0
					}
				},
				"children": [
					"AK"
				]
			}
		]
	},
	"version": 1,
	"familyKey": "support-help-ticket",
	"source": {
		"kind": "archetype",
		"archetype": "support-help",
		"variant": "ticket",
		"tranche": 2
	}
}
