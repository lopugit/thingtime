{
	"slug": "antd-choice-controls-toggle-group",
	"name": "Toggle Group",
	"library": "antd",
	"category": "forms",
	"description": "Segmented toggle-button group in the Ant Design style — joined outlined buttons where the active index fills with the tone color.",
	"tags": [
		"form",
		"toggle",
		"segmented",
		"group"
	],
	"args": [
		{
			"name": "labelA",
			"type": "string",
			"default": "Day",
			"label": "Segment A",
			"maxLength": 20
		},
		{
			"name": "labelB",
			"type": "string",
			"default": "Week",
			"label": "Segment B",
			"maxLength": 20
		},
		{
			"name": "labelC",
			"type": "string",
			"default": "Month",
			"label": "Segment C",
			"maxLength": 20
		},
		{
			"name": "active",
			"type": "enum",
			"values": [
				"1",
				"2",
				"3"
			],
			"default": "2",
			"label": "Active segment"
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "inline-flex",
				"borderRadius": "6px",
				"overflow": "hidden",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "#d9d9d9"
			}
		},
		"children": [
			{
				"tag": "button",
				"props": {
					"type": "button",
					"style": {
						"ttMerge": [
							{
								"height": "32px",
								"padding": "0 14px",
								"display": "inline-flex",
								"alignItems": "center",
								"justifyContent": "center",
								"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
								"fontSize": "13px",
								"fontWeight": 400,
								"border": "none",
								"cursor": "pointer",
								"borderRadius": "0"
							},
							{
								"ttIf": {
									"arg": "active",
									"equals": "1",
									"then": {
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#1677ff",
													"success": "#52c41a",
													"warning": "#faad14",
													"danger": "#ff4d4f",
													"info": "#1677ff",
													"neutral": "rgba(0, 0, 0, 0.88)"
												},
												"default": "#1677ff"
											}
										},
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#ffffff",
													"success": "#ffffff",
													"warning": "#ffffff",
													"danger": "#ffffff",
													"info": "#ffffff",
													"neutral": "#ffffff"
												},
												"default": "#ffffff"
											}
										}
									},
									"else": {
										"background": "#ffffff",
										"color": "rgba(0, 0, 0, 0.88)"
									}
								}
							}
						]
					}
				},
				"children": [
					"{labelA}"
				]
			},
			{
				"tag": "button",
				"props": {
					"type": "button",
					"style": {
						"ttMerge": [
							{
								"height": "32px",
								"padding": "0 14px",
								"display": "inline-flex",
								"alignItems": "center",
								"justifyContent": "center",
								"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
								"fontSize": "13px",
								"fontWeight": 400,
								"border": "none",
								"cursor": "pointer",
								"borderRadius": "0",
								"borderLeftWidth": "1px",
								"borderLeftStyle": "solid",
								"borderLeftColor": "#d9d9d9"
							},
							{
								"ttIf": {
									"arg": "active",
									"equals": "2",
									"then": {
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#1677ff",
													"success": "#52c41a",
													"warning": "#faad14",
													"danger": "#ff4d4f",
													"info": "#1677ff",
													"neutral": "rgba(0, 0, 0, 0.88)"
												},
												"default": "#1677ff"
											}
										},
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#ffffff",
													"success": "#ffffff",
													"warning": "#ffffff",
													"danger": "#ffffff",
													"info": "#ffffff",
													"neutral": "#ffffff"
												},
												"default": "#ffffff"
											}
										}
									},
									"else": {
										"background": "#ffffff",
										"color": "rgba(0, 0, 0, 0.88)"
									}
								}
							}
						]
					}
				},
				"children": [
					"{labelB}"
				]
			},
			{
				"tag": "button",
				"props": {
					"type": "button",
					"style": {
						"ttMerge": [
							{
								"height": "32px",
								"padding": "0 14px",
								"display": "inline-flex",
								"alignItems": "center",
								"justifyContent": "center",
								"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
								"fontSize": "13px",
								"fontWeight": 400,
								"border": "none",
								"cursor": "pointer",
								"borderRadius": "0",
								"borderLeftWidth": "1px",
								"borderLeftStyle": "solid",
								"borderLeftColor": "#d9d9d9"
							},
							{
								"ttIf": {
									"arg": "active",
									"equals": "3",
									"then": {
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#1677ff",
													"success": "#52c41a",
													"warning": "#faad14",
													"danger": "#ff4d4f",
													"info": "#1677ff",
													"neutral": "rgba(0, 0, 0, 0.88)"
												},
												"default": "#1677ff"
											}
										},
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#ffffff",
													"success": "#ffffff",
													"warning": "#ffffff",
													"danger": "#ffffff",
													"info": "#ffffff",
													"neutral": "#ffffff"
												},
												"default": "#ffffff"
											}
										}
									},
									"else": {
										"background": "#ffffff",
										"color": "rgba(0, 0, 0, 0.88)"
									}
								}
							}
						]
					}
				},
				"children": [
					"{labelC}"
				]
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "choice-controls",
