{
	"slug": "antd-loading-loading-button",
	"name": "Loading Button",
	"library": "antd",
	"category": "feedback",
	"description": "Busy-state button in the Ant Design style — an inline arc spinner beside the label, in solid or quiet tinted form.",
	"tags": [
		"loading",
		"button",
		"spinner",
		"busy"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Saving…",
			"label": "Label",
			"maxLength": 40
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "size",
			"type": "enum",
			"values": [
				"sm",
				"md",
				"lg"
			],
			"default": "md",
			"label": "Size"
		},
		{
			"name": "quiet",
			"type": "boolean",
			"default": false,
			"label": "Quiet (tinted)"
		}
	],
	"render": {
		"tag": "button",
		"props": {
			"type": "button",
			"style": {
				"ttMerge": [
					{
						"display": "inline-flex",
						"alignItems": "center",
						"justifyContent": "center",
						"gap": "8px",
						"border": "none",
						"borderRadius": "6px",
						"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
						"fontWeight": 400,
						"cursor": "wait",
						"opacity": 0.9
					},
					{
						"ttMap": {
							"arg": "size",
							"values": {
								"sm": {
									"height": "24px",
									"padding": "0 12px",
									"fontSize": "13px"
								},
								"md": {
									"height": "32px",
									"padding": "0 16px",
									"fontSize": "14px"
								},
								"lg": {
									"height": "40px",
									"padding": "0 20px",
									"fontSize": "16px"
								}
							},
							"default": {
								"height": "32px",
								"padding": "0 16px",
								"fontSize": "14px"
							}
						}
					},
					{
						"background": {
							"ttIf": {
								"arg": "quiet",
								"then": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#e6f4ff",
											"success": "#f6ffed",
											"warning": "#fffbe6",
											"danger": "#fff2f0",
											"info": "#e6f4ff",
											"neutral": "#fafafa"
										},
										"default": "#e6f4ff"
									}
								},
								"else": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#1677ff",
											"success": "#52c41a",
											"warning": "#faad14",
											"danger": "#ff4d4f",
											"info": "#1677ff",
											"neutral": "rgba(0, 0, 0, 0.88)"
										},
										"default": "#1677ff"
									}
								}
							}
						},
						"color": {
							"ttIf": {
								"arg": "quiet",
								"then": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#0958d9",
											"success": "#389e0d",
											"warning": "#d48806",
											"danger": "#cf1322",
											"info": "#0958d9",
											"neutral": "rgba(0, 0, 0, 0.65)"
										},
										"default": "#0958d9"
									}
								},
								"else": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#ffffff",
											"success": "#ffffff",
											"warning": "#ffffff",
											"danger": "#ffffff",
											"info": "#ffffff",
											"neutral": "#ffffff"
										},
										"default": "#ffffff"
									}
								}
							}
						},
						"boxShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.03), 0 1px 6px -1px rgba(0, 0, 0, 0.02)"
					}
				]
			}
		},
		"children": [
			{
				"tag": "svg",
				"props": {
					"width": 16,
					"height": 16,
					"viewBox": "0 0 24 24",
					"fill": "none",
					"xmlns": "http://www.w3.org/2000/svg"
				},
				"children": [
					{
						"tag": "circle",
						"props": {
							"cx": 12,
							"cy": 12,
							"r": 10,
							"stroke": "currentColor",
							"strokeWidth": 3,
							"style": {
								"opacity": 0.3
							}
						}
					},
					{
						"tag": "path",
						"props": {
							"d": "M12 2a10 10 0 1 1-10 10",
							"stroke": "currentColor",
							"strokeWidth": 3,
							"strokeLinecap": "round"
						}
					}
				]
			},
			"{label}"
		]
	},
	"version": 1,
	"familyKey": "loading-loading-button",
	"source": {
		"kind": "archetype",
		"archetype": "loading",
		"variant": "loading-button",
		"tranche": 1
	}
}
