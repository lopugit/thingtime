							"style": {
								"flex": 1,
								"height": "6px",
								"borderRadius": "999px",
								"background": {
									"ttMap": {
										"arg": "strength",
										"values": {
											"weak": "#f0f0f0",
											"fair": "#f0f0f0",
											"good": "#f0f0f0",
											"strong": "#52c41a"
										},
										"default": "#f0f0f0"
									}
								}
							}
						}
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "12px",
						"fontWeight": 500,
						"color": {
							"ttMap": {
								"arg": "strength",
								"values": {
									"weak": "#cf1322",
									"fair": "#d48806",
									"good": "#0958d9",
									"strong": "#389e0d"
								},
								"default": "rgba(0, 0, 0, 0.45)"
