{
	"slug": "antd-forms-advanced-password",
	"name": "Password Strength Field",
	"library": "antd",
	"category": "forms",
	"description": "Password field in the Ant Design style — masked dot glyphs inside the field plus a four-segment strength meter sweeping from danger to success with a matching caption.",
	"tags": [
		"form",
		"password",
		"strength",
		"security"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Password",
			"label": "Label",
			"maxLength": 30
		},
		{
			"name": "dots",
			"type": "number",
			"default": 8,
			"label": "Characters",
			"min": 1,
			"max": 12
		},
		{
			"name": "strength",
			"type": "enum",
			"values": [
				"weak",
				"fair",
				"good",
				"strong"
			],
			"default": "fair",
			"label": "Strength"
		},
		{
			"name": "focused",
			"type": "boolean",
			"default": false,
			"label": "Focused"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"gap": "6px",
				"width": "260px",
				"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
			}
		},
		"children": [
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "13px",
						"fontWeight": 600,
						"color": "rgba(0, 0, 0, 0.88)"
					}
				},
				"children": [
					"{label}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"boxSizing": "border-box",
						"height": "32px",
						"padding": "0 12px",
						"background": "#ffffff",
						"borderWidth": "1px",
						"borderStyle": "solid",
						"borderColor": {
							"ttIf": {
								"arg": "focused",
								"then": "#1677ff",
								"else": "#d9d9d9"
							}
						},
						"borderRadius": "6px",
						"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
						"fontSize": "14px",
						"color": "rgba(0, 0, 0, 0.88)",
						"gap": "4px",
						"boxShadow": {
							"ttIf": {
								"arg": "focused",
								"then": "0 0 0 2px rgba(5, 145, 255, 0.1)",
								"else": "none"
							}
						}
					}
				},
				"children": [
					{
						"ttRepeat": {
							"arg": "dots",
							"max": 12,
							"node": {
								"tag": "span",
								"props": {
									"style": {
										"width": "6px",
										"height": "6px",
										"borderRadius": "999px",
										"background": "rgba(0, 0, 0, 0.88)",
										"flexShrink": 0
									}
								}
							}
						}
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "4px"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"flex": 1,
								"height": "6px",
								"borderRadius": "999px",
								"background": {
									"ttMap": {
										"arg": "strength",
										"values": {
											"weak": "#ff4d4f",
											"fair": "#faad14",
											"good": "#1677ff",
											"strong": "#52c41a"
										},
										"default": "#f0f0f0"
									}
								}
							}
						}
					},
					{
