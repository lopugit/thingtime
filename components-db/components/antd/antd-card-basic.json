{
	"slug": "antd-card-basic",
	"name": "Basic Card",
	"library": "antd",
	"category": "layout",
	"description": "Simple padded content card in the Ant Design style — tone-colored eyebrow, heading and muted body on one bordered library surface.",
	"tags": [
		"card",
		"surface",
		"content"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Card title",
			"label": "Title",
			"maxLength": 60
		},
		{
			"name": "body",
			"type": "text",
			"default": "Cards group related content and actions onto one calm surface.",
			"label": "Body"
		},
		{
			"name": "eyebrow",
			"type": "string",
			"default": "Overview",
			"label": "Eyebrow",
			"maxLength": 30
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"width": "300px",
				"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
				"background": "#ffffff",
				"color": "rgba(0, 0, 0, 0.88)",
				"border": "1px solid #d9d9d9",
				"borderRadius": "6px",
				"boxShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.03), 0 1px 6px -1px rgba(0, 0, 0, 0.02)",
				"overflow": "hidden",
				"boxSizing": "border-box",
				"padding": "16px",
				"gap": "8px"
			}
		},
		"children": [
			{
				"ttIf": {
					"arg": "eyebrow",
					"then": {
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "12px",
								"fontWeight": 600,
								"textTransform": "uppercase",
								"letterSpacing": "0.06em",
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#1677ff",
											"success": "#52c41a",
											"warning": "#faad14",
											"danger": "#ff4d4f",
											"info": "#1677ff",
											"neutral": "rgba(0, 0, 0, 0.88)"
										},
										"default": "#1677ff"
									}
								}
							}
						},
						"children": [
							"{eyebrow}"
						]
					}
				}
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "16px",
						"fontWeight": 600,
						"color": "rgba(0, 0, 0, 0.88)"
					}
				},
				"children": [
					"{title}"
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "13px",
						"color": "rgba(0, 0, 0, 0.45)",
						"lineHeight": 1.5
					}
				},
				"children": [
					"{body}"
				]
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "card",
		"variant": "basic",
		"tranche": 1
	}
}
