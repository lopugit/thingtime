{
	"slug": "antd-badge-soft",
	"name": "Soft Badge",
	"library": "antd",
	"category": "data-display",
	"description": "Tinted status badge in the Ant Design style — soft tone wash with the deeper tone for the label, plus the classic Ant Design tag border.",
	"tags": [
		"badge",
		"status",
		"soft",
		"tinted"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "In review",
			"label": "Label",
			"maxLength": 24
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "size",
			"type": "enum",
			"values": [
				"sm",
				"md"
			],
			"default": "sm",
			"label": "Size"
		}
	],
	"render": {
		"tag": "span",
		"props": {
			"style": {
				"ttMerge": [
					{
						"display": "inline-flex",
						"alignItems": "center",
						"gap": "6px",
						"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
						"fontWeight": 600,
						"lineHeight": 1.4,
						"borderRadius": "4px"
					},
					{
						"ttMap": {
							"arg": "size",
							"values": {
								"sm": {
									"fontSize": "12px",
									"padding": "2px 8px"
								},
								"md": {
									"fontSize": "13px",
									"padding": "4px 10px"
								}
							},
							"default": {
								"fontSize": "12px",
								"padding": "2px 8px"
							}
						}
					},
					{
						"background": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#e6f4ff",
									"success": "#f6ffed",
									"warning": "#fffbe6",
									"danger": "#fff2f0",
									"info": "#e6f4ff",
									"neutral": "#fafafa"
								},
								"default": "#e6f4ff"
							}
						},
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#0958d9",
									"success": "#389e0d",
									"warning": "#d48806",
									"danger": "#cf1322",
									"info": "#0958d9",
									"neutral": "rgba(0, 0, 0, 0.65)"
								},
								"default": "#0958d9"
							}
						},
						"borderWidth": "1px",
						"borderStyle": "solid",
						"borderColor": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#91caff",
									"success": "#b7eb8f",
									"warning": "#ffe58f",
									"danger": "#ffccc7",
									"info": "#91caff",
									"neutral": "#d9d9d9"
								},
								"default": "#91caff"
							}
						}
					}
				]
			}
		},
		"children": [
			"{label}"
		]
	},
	"version": 1,
	"familyKey": "badge-soft",
	"source": {
		"kind": "archetype",
		"archetype": "badge",
		"variant": "soft",
		"tranche": 1
	}
}
