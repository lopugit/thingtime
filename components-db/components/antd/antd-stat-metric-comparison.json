{
	"slug": "antd-stat-metric-comparison",
	"name": "Comparison Stat",
	"library": "antd",
	"category": "data-display",
	"description": "Two-value comparison card in the Ant Design style — current figure in the tone color beside the previous figure, split by a vertical divider.",
	"tags": [
		"stat",
		"comparison",
		"versus",
		"card"
	],
	"args": [
		{
			"name": "leftLabel",
			"type": "string",
			"default": "This week",
			"label": "Left label",
			"maxLength": 24
		},
		{
			"name": "leftValue",
			"type": "string",
			"default": "1,284",
			"label": "Left value",
			"maxLength": 16
		},
		{
			"name": "rightLabel",
			"type": "string",
			"default": "Last week",
			"label": "Right label",
			"maxLength": 24
		},
		{
			"name": "rightValue",
			"type": "string",
			"default": "1,102",
			"label": "Right value",
			"maxLength": 16
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "inline-flex",
				"alignItems": "stretch",
				"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
				"background": "#ffffff",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "#d9d9d9",
				"borderRadius": "8px",
				"boxShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.03), 0 1px 6px -1px rgba(0, 0, 0, 0.02)",
				"boxSizing": "border-box",
				"padding": "16px 20px",
				"gap": "18px"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"gap": "4px",
						"flex": "1 1 0",
						"minWidth": "90px"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "12px",
								"fontWeight": 400,
								"color": "rgba(0, 0, 0, 0.45)"
							}
						},
						"children": [
							"{leftLabel}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "20px",
								"fontWeight": 600,
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#1677ff",
											"success": "#52c41a",
											"warning": "#faad14",
											"danger": "#ff4d4f",
											"info": "#1677ff",
											"neutral": "rgba(0, 0, 0, 0.88)"
										},
										"default": "#1677ff"
									}
								},
								"lineHeight": 1.15,
								"fontVariantNumeric": "tabular-nums"
							}
						},
						"children": [
							"{leftValue}"
						]
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"width": "2px",
						"alignSelf": "stretch",
						"borderRadius": "999px",
						"background": "#f0f0f0",
						"flexShrink": 0
					}
				}
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"gap": "4px",
						"flex": "1 1 0",
						"minWidth": "90px"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "12px",
								"fontWeight": 400,
								"color": "rgba(0, 0, 0, 0.45)"
							}
						},
						"children": [
							"{rightLabel}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "20px",
								"fontWeight": 600,
								"color": "rgba(0, 0, 0, 0.88)",
								"lineHeight": 1.15,
								"fontVariantNumeric": "tabular-nums"
							}
						},
						"children": [
							"{rightValue}"
						]
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "stat-metric-comparison",
	"source": {
		"kind": "archetype",
		"archetype": "stat-metric",
		"variant": "comparison",
		"tranche": 1
	}
}
