{
	"slug": "antd-avatar-group",
	"name": "Avatar Group",
	"library": "antd",
	"category": "data-display",
	"description": "Overlapping avatar stack in the Ant Design style — a repeat-driven row of tone-filled initials discs separated by surface-colored rims.",
	"tags": [
		"avatar",
		"group",
		"stack",
		"team"
	],
	"args": [
		{
			"name": "count",
			"type": "number",
			"default": 4,
			"label": "Avatars",
			"min": 1,
			"max": 8
		},
		{
			"name": "prefix",
			"type": "string",
			"default": "U",
			"label": "Initials prefix",
			"maxLength": 2
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "size",
			"type": "enum",
			"values": [
				"sm",
				"md",
				"lg"
			],
			"default": "md",
			"label": "Size"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"alignItems": "center",
				"paddingLeft": "10px",
				"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
			}
		},
		"children": [
			{
				"ttRepeat": {
					"arg": "count",
					"max": 8,
					"node": {
						"tag": "div",
						"props": {
							"style": {
								"ttMerge": [
									{
										"display": "flex",
										"alignItems": "center",
										"justifyContent": "center",
										"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
										"fontWeight": 600,
										"borderRadius": "999px",
										"flexShrink": 0,
										"userSelect": "none"
									},
									{
										"ttMap": {
											"arg": "size",
											"values": {
												"sm": {
													"width": "28px",
													"height": "28px",
													"fontSize": "12px"
												},
												"md": {
													"width": "40px",
													"height": "40px",
													"fontSize": "13px"
												},
												"lg": {
													"width": "56px",
													"height": "56px",
													"fontSize": "16px"
												}
											},
											"default": {
												"width": "40px",
												"height": "40px",
												"fontSize": "13px"
											}
										}
									},
									{
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#1677ff",
													"success": "#52c41a",
													"warning": "#faad14",
													"danger": "#ff4d4f",
													"info": "#1677ff",
													"neutral": "rgba(0, 0, 0, 0.88)"
												},
												"default": "#1677ff"
											}
										},
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#ffffff",
													"success": "#ffffff",
													"warning": "#ffffff",
													"danger": "#ffffff",
													"info": "#ffffff",
													"neutral": "#ffffff"
												},
												"default": "#ffffff"
											}
										}
									},
									{
										"border": "2px solid #ffffff",
										"marginLeft": "-10px"
									}
								]
							}
						},
						"children": [
							"{prefix}{n}"
						]
					}
				}
			}
		]
	},
	"version": 1,
	"familyKey": "avatar-group",
	"source": {
		"kind": "archetype",
		"archetype": "avatar",
		"variant": "group",
		"tranche": 1
	}
}
