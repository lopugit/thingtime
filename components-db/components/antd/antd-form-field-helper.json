{
	"slug": "antd-form-field-helper",
	"name": "Field + Helper Text",
	"library": "antd",
	"category": "forms",
	"description": "Labeled input with guidance text underneath in the Ant Design style — the error toggle turns the border and helper line to the library's danger tone.",
	"tags": [
		"form",
		"field",
		"helper",
		"validation"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Workspace name",
			"label": "Label",
			"maxLength": 40
		},
		{
			"name": "placeholder",
			"type": "string",
			"default": "Acme Inc.",
			"label": "Placeholder",
			"maxLength": 60
		},
		{
			"name": "helper",
			"type": "string",
			"default": "This appears on your public profile.",
			"label": "Helper text",
			"maxLength": 80
		},
		{
			"name": "error",
			"type": "boolean",
			"default": false,
			"label": "Error state"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"gap": "6px",
				"width": "280px"
			}
		},
		"children": [
			{
				"tag": "span",
				"props": {
					"style": {
						"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
						"fontSize": "13px",
						"fontWeight": 600,
						"color": "rgba(0, 0, 0, 0.88)"
					}
				},
				"children": [
					"{label}"
				]
			},
			{
				"tag": "input",
				"props": {
					"type": "text",
					"placeholder": "{placeholder}",
					"style": {
						"ttMerge": [
							{
								"height": "32px",
								"padding": "0 12px",
								"borderRadius": "6px",
								"borderWidth": "1px",
								"borderStyle": "solid",
								"borderColor": "#d9d9d9",
								"background": "#ffffff",
								"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
								"fontSize": "14px",
								"color": "rgba(0, 0, 0, 0.88)",
								"outline": "none",
								"width": "100%",
								"boxSizing": "border-box",
								"boxShadow": "none"
							},
							{
								"borderColor": {
									"ttIf": {
										"arg": "error",
										"then": "#ff4d4f",
										"else": "#d9d9d9"
									}
								}
							}
						]
					}
				}
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
						"fontSize": "13px",
						"color": {
							"ttIf": {
								"arg": "error",
								"then": "#ff4d4f",
								"else": "rgba(0, 0, 0, 0.45)"
							}
						}
					}
				},
				"children": [
					"{helper}"
				]
			}
		]
	},
	"version": 1,
	"familyKey": "form-field-helper",
	"source": {
		"kind": "archetype",
		"archetype": "form-field",
		"variant": "helper",
		"tranche": 1
	}
}
