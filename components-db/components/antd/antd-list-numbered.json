{
	"slug": "antd-list-numbered",
	"name": "Numbered List",
	"library": "antd",
	"category": "data-display",
	"description": "Ordered list in the Ant Design style — hand-styled number markers (pill chips) on a tone tint beside each row.",
	"tags": [
		"list",
		"numbered",
		"ordered",
		"steps"
	],
	"args": [
		{
			"name": "item",
			"type": "string",
			"default": "Step",
			"label": "Item label",
			"maxLength": 40
		},
		{
			"name": "count",
			"type": "number",
			"default": 4,
			"label": "Rows",
			"min": 1,
			"max": 8
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "divided",
			"type": "boolean",
			"default": true,
			"label": "Dividers"
		}
	],
	"render": {
		"tag": "ol",
		"props": {
			"style": {
				"ttMerge": [
					{
						"listStyle": "none",
						"margin": 0,
						"padding": 0,
						"width": "280px",
						"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
						"color": "rgba(0, 0, 0, 0.88)",
						"background": "#ffffff",
						"borderRadius": "6px",
						"overflow": "hidden"
					},
					{
						"border": "1px solid #d9d9d9",
						"boxShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.03), 0 1px 6px -1px rgba(0, 0, 0, 0.02)"
					}
				]
			}
		},
		"children": [
			{
				"ttRepeat": {
					"arg": "count",
					"max": 8,
					"node": {
						"tag": "li",
						"props": {
							"style": {
								"ttMerge": [
									{
										"display": "flex",
										"alignItems": "center",
										"gap": "12px",
										"padding": "10px 14px",
										"fontSize": "14px"
									},
									{
										"ttIf": {
											"arg": "divided",
											"then": {
												"ttIf": {
													"arg": "n",
													"equals": 1,
													"then": {},
													"else": {
														"borderTop": "1px solid #f0f0f0"
													}
												}
											},
											"else": {}
										}
									}
								]
							}
						},
						"children": [
							{
								"tag": "div",
								"props": {
									"style": {
										"width": "24px",
										"height": "24px",
										"borderRadius": "999px",
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#e6f4ff",
													"success": "#f6ffed",
													"warning": "#fffbe6",
													"danger": "#fff2f0",
													"info": "#e6f4ff",
													"neutral": "#fafafa"
												},
												"default": "#e6f4ff"
											}
										},
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#0958d9",
													"success": "#389e0d",
													"warning": "#d48806",
													"danger": "#cf1322",
													"info": "#0958d9",
													"neutral": "rgba(0, 0, 0, 0.65)"
												},
												"default": "#0958d9"
											}
										},
										"display": "flex",
										"alignItems": "center",
										"justifyContent": "center",
										"fontSize": "12px",
										"fontWeight": 700,
										"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
										"flexShrink": 0
									}
								},
								"children": [
									"{n}"
								]
							},
							"{item} {n}"
						]
					}
				}
			}
		]
	},
	"version": 1,
	"familyKey": "list-numbered",
	"source": {
		"kind": "archetype",
		"archetype": "list",
		"variant": "numbered",
		"tranche": 1
	}
}
