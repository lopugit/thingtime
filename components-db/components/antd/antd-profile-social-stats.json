{
	"slug": "antd-profile-social-stats",
	"name": "Profile Stats Band",
	"library": "antd",
	"category": "social",
	"description": "Profile stats band in the Ant Design style — posts, followers and following counts as big numbers over quiet captions, divider-separated, with one block highlighted by an accent top border.",
	"tags": [
		"profile",
		"stats",
		"metrics",
		"counters",
		"social"
	],
	"args": [
		{
			"name": "posts",
			"type": "string",
			"default": "128",
			"label": "Posts",
			"maxLength": 10
		},
		{
			"name": "followers",
			"type": "string",
			"default": "2,304",
			"label": "Followers",
			"maxLength": 10
		},
		{
			"name": "following",
			"type": "string",
			"default": "180",
			"label": "Following",
			"maxLength": 10
		},
		{
			"name": "highlight",
			"type": "enum",
			"values": [
				"posts",
				"followers",
				"following",
				"none"
			],
			"default": "followers",
			"label": "Highlight"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"background": "#ffffff",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "#d9d9d9",
				"borderRadius": "8px",
				"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
				"boxShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.03), 0 1px 6px -1px rgba(0, 0, 0, 0.02)",
				"width": "320px",
				"display": "flex",
				"alignItems": "stretch",
				"overflow": "hidden"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"ttMerge": [
							{
								"flex": 1,
								"display": "flex",
								"flexDirection": "column",
								"alignItems": "center",
								"gap": "2px",
								"padding": "14px 10px",
								"borderTopWidth": "2px",
								"borderTopStyle": "solid"
							},
							{
								"ttIf": {
									"arg": "highlight",
									"equals": "posts",
									"then": {
										"borderTopColor": "#1677ff"
									},
									"else": {
										"borderTopColor": "transparent"
									}
								}
							}
						]
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "20px",
								"fontWeight": 600,
								"color": "rgba(0, 0, 0, 0.88)"
							}
						},
						"children": [
