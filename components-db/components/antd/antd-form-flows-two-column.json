{
	"slug": "antd-form-flows-two-column",
	"name": "Two-Column Form Section",
	"library": "antd",
	"category": "forms",
	"description": "Two-column form section in the Ant Design style — heading and caption over a name pair with a full-width email row, required asterisks, and library-native field chrome.",
	"tags": [
		"form",
		"layout",
		"two-column",
		"grid"
	],
	"args": [
		{
			"name": "heading",
			"type": "string",
			"default": "Personal information",
			"label": "Heading",
			"maxLength": 40
		},
		{
			"name": "caption",
			"type": "string",
			"default": "Use your legal name as it appears on your ID.",
			"label": "Caption",
			"maxLength": 80
		},
		{
			"name": "required",
			"type": "boolean",
			"default": true,
			"label": "Show required"
		},
		{
			"name": "dense",
			"type": "boolean",
			"default": false,
			"label": "Dense fields"
		}
