{
	"slug": "antd-timeline-changelog",
	"name": "Changelog Timeline",
	"library": "antd",
	"category": "data-display",
	"description": "Changelog timeline in the Ant Design style — mono version chips on a tone tint head each entry, with a date mark and a muted release summary.",
	"tags": [
		"timeline",
		"changelog",
		"releases",
		"versions"
	],
	"args": [
		{
			"name": "version",
			"type": "string",
			"default": "2.4",
			"label": "Version",
			"maxLength": 12
		},
		{
			"name": "summary",
			"type": "string",
			"default": "Performance improvements and bug fixes",
			"label": "Summary",
			"maxLength": 80
		},
		{
			"name": "count",
			"type": "number",
			"default": 3,
			"label": "Entries",
			"min": 1,
			"max": 5
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "ul",
		"props": {
			"style": {
				"listStyle": "none",
				"margin": 0,
				"padding": 0,
				"width": "280px",
				"display": "flex",
				"flexDirection": "column",
				"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
				"color": "rgba(0, 0, 0, 0.88)"
			}
		},
		"children": [
			{
				"ttRepeat": {
					"arg": "count",
					"max": 5,
					"node": {
						"tag": "li",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "stretch",
								"gap": "14px"
							}
						},
						"children": [
							{
								"tag": "div",
								"props": {
									"style": {
										"display": "flex",
										"flexDirection": "column",
										"alignItems": "center",
										"width": "12px",
										"flexShrink": 0
									}
								},
								"children": [
									{
										"tag": "div",
										"props": {
											"style": {
												"width": "12px",
												"height": "12px",
												"borderRadius": "999px",
												"background": "rgba(0, 0, 0, 0.25)",
												"marginTop": "5px",
												"flexShrink": 0
											}
										}
									},
									{
										"tag": "div",
										"props": {
											"style": {
												"width": "2px",
												"flexGrow": 1,
												"minHeight": "14px",
												"marginTop": "4px",
												"borderRadius": "999px",
												"background": "#f0f0f0"
											}
										}
									}
								]
							},
							{
								"tag": "div",
								"props": {
									"style": {
										"display": "flex",
										"flexDirection": "column",
										"gap": "2px",
										"paddingBottom": "18px",
										"minWidth": 0
									}
								},
								"children": [
									{
										"tag": "div",
										"props": {
											"style": {
												"display": "flex",
												"alignItems": "center",
												"gap": "8px"
											}
										},
										"children": [
											{
												"tag": "span",
												"props": {
													"style": {
														"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
														"fontSize": "12px",
														"fontWeight": 600,
														"padding": "2px 8px",
														"borderRadius": "999px",
														"background": {
															"ttMap": {
																"arg": "tone",
																"values": {
																	"primary": "#e6f4ff",
																	"success": "#f6ffed",
																	"warning": "#fffbe6",
																	"danger": "#fff2f0",
																	"info": "#e6f4ff",
																	"neutral": "#fafafa"
																},
																"default": "#e6f4ff"
															}
														},
														"color": {
															"ttMap": {
																"arg": "tone",
																"values": {
																	"primary": "#0958d9",
																	"success": "#389e0d",
																	"warning": "#d48806",
																	"danger": "#cf1322",
																	"info": "#0958d9",
																	"neutral": "rgba(0, 0, 0, 0.65)"
																},
																"default": "#0958d9"
															}
														},
														"borderWidth": "1px",
														"borderStyle": "solid",
														"borderColor": {
															"ttMap": {
																"arg": "tone",
																"values": {
																	"primary": "#91caff",
																	"success": "#b7eb8f",
																	"warning": "#ffe58f",
																	"danger": "#ffccc7",
																	"info": "#91caff",
																	"neutral": "#d9d9d9"
																},
																"default": "#91caff"
															}
														}
													}
												},
												"children": [
													"v{version}.{n}"
												]
											},
											{
												"tag": "span",
												"props": {
													"style": {
														"color": "rgba(0, 0, 0, 0.25)",
														"fontSize": "12px"
													}
												},
												"children": [
													"Aug {n}"
												]
											}
										]
									},
									{
										"tag": "span",
										"props": {
											"style": {
												"color": "rgba(0, 0, 0, 0.45)",
												"fontSize": "13px",
												"marginTop": "2px"
											}
										},
										"children": [
											"{summary}"
										]
									}
								]
							}
						]
					}
				}
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "timeline",
		"variant": "changelog",
		"tranche": 1
	}
}
