{
	"slug": "antd-mail-thread",
	"name": "Email Thread",
	"library": "antd",
	"category": "communication",
	"description": "Open email thread in the Ant Design style — avatar sender header with a 'to me' caption and time, a collapsed earlier-messages bar, body paragraphs, and reply/forward ghost buttons.",
	"tags": [
		"mail",
		"thread",
		"message",
		"email",
		"conversation"
	],
	"args": [
		{
			"name": "sender",
			"type": "string",
			"default": "Ada Lovelace",
			"label": "Sender",
			"maxLength": 32
		},
		{
			"name": "initials",
			"type": "string",
			"default": "AL",
			"label": "Initials",
			"maxLength": 3
		},
		{
			"name": "time",
			"type": "string",
			"default": "Mon 9:41 AM",
			"label": "Time",
			"maxLength": 16
		},
		{
			"name": "body",
			"type": "text",
			"default": "Thanks for the notes — the revised forecast is looking much stronger this quarter.",
			"label": "Body",
			"maxLength": 240
		},
		{
			"name": "earlier",
			"type": "number",
			"default": 2,
			"label": "Earlier messages",
			"min": 1,
			"max": 99
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"gap": "12px",
				"maxWidth": "440px",
				"boxSizing": "border-box",
				"padding": "16px",
				"background": "#ffffff",
				"border": "1px solid #d9d9d9",
				"borderRadius": "8px",
				"boxShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.03), 0 1px 6px -1px rgba(0, 0, 0, 0.02)",
				"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "10px"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"width": "36px",
								"height": "36px",
								"borderRadius": "999px",
								"background": "#e6f4ff",
								"color": "#0958d9",
								"display": "flex",
								"alignItems": "center",
								"justifyContent": "center",
								"fontWeight": 600,
								"fontSize": "13px",
								"flexShrink": 0
							}
						},
						"children": [
							"{initials}"
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"flexDirection": "column",
								"gap": "2px",
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "14px",
										"fontWeight": 600,
										"color": "rgba(0, 0, 0, 0.88)"
									}
								},
								"children": [
									"{sender}"
								]
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"display": "inline-flex",
										"alignItems": "center",
										"gap": "4px",
										"fontSize": "12px",
										"color": "rgba(0, 0, 0, 0.45)"
									}
								},
								"children": [
									"to me",
									{
										"tag": "svg",
										"props": {
											"width": 12,
											"height": 12,
											"viewBox": "0 0 24 24",
											"fill": "none",
											"stroke": "rgba(0, 0, 0, 0.25)",
											"strokeWidth": 2,
											"strokeLinecap": "round",
											"strokeLinejoin": "round",
											"xmlns": "http://www.w3.org/2000/svg"
										},
										"children": [
											{
												"tag": "polyline",
												"props": {
													"points": "6 9 12 15 18 9"
												}
											}
										]
									}
								]
							}
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"marginLeft": "auto",
								"fontSize": "12px",
								"color": "rgba(0, 0, 0, 0.45)",
								"flexShrink": 0
							}
						},
						"children": [
							"{time}"
						]
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "center",
						"padding": "6px 12px",
						"background": "#fafafa",
						"border": "1px solid #f0f0f0",
						"borderRadius": "4px",
						"fontSize": "12px",
						"color": "rgba(0, 0, 0, 0.45)",
						"cursor": "pointer"
					}
				},
				"children": [
					"••• {earlier} earlier messages"
				]
			},
			{
				"tag": "p",
				"props": {
					"style": {
						"margin": 0,
						"fontSize": "13px",
						"lineHeight": 1.6,
						"color": "rgba(0, 0, 0, 0.88)"
					}
				},
				"children": [
					"{body}"
				]
			},
			{
				"tag": "p",
				"props": {
					"style": {
						"margin": 0,
						"fontSize": "13px",
						"lineHeight": 1.6,
						"color": "rgba(0, 0, 0, 0.88)"
					}
				},
				"children": [
					"Happy to walk through the details whenever suits — the numbers are in the attached deck."
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "8px",
						"paddingTop": "4px"
					}
				},
				"children": [
					{
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"display": "inline-flex",
								"alignItems": "center",
								"justifyContent": "center",
								"gap": "6px",
								"height": "24px",
								"padding": "0 10px",
								"border": "none",
								"background": "transparent",
								"borderRadius": "4px",
								"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
								"fontWeight": 400,
								"fontSize": "13px",
								"color": "#1677ff",
								"cursor": "pointer"
							}
						},
						"children": [
							"Reply"
						]
					},
					{
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"display": "inline-flex",
								"alignItems": "center",
								"justifyContent": "center",
								"gap": "6px",
								"height": "24px",
								"padding": "0 10px",
								"border": "none",
								"background": "transparent",
								"borderRadius": "4px",
								"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
								"fontWeight": 400,
								"fontSize": "13px",
								"color": "rgba(0, 0, 0, 0.45)",
								"cursor": "pointer"
							}
						},
						"children": [
							"Forward",
							{
								"tag": "svg",
								"props": {
									"width": 14,
									"height": 14,
									"viewBox": "0 0 24 24",
									"fill": "none",
									"stroke": "currentColor",
									"strokeWidth": 2,
									"strokeLinecap": "round",
									"strokeLinejoin": "round",
									"xmlns": "http://www.w3.org/2000/svg"
								},
								"children": [
									{
										"tag": "line",
										"props": {
											"x1": 5,
											"y1": 12,
											"x2": 19,
											"y2": 12
										}
									},
									{
										"tag": "polyline",
										"props": {
											"points": "12 5 19 12 12 19"
										}
									}
								]
							}
						]
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "mail-thread",
	"source": {
		"kind": "archetype",
		"archetype": "mail",
		"variant": "thread",
		"tranche": 2
	}
}
