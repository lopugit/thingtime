{
	"slug": "antd-avatar-squared",
	"name": "Squared Avatar",
	"library": "antd",
	"category": "data-display",
	"description": "Rounded-square initials avatar in the Ant Design style — the library's own corner radius on a tone-filled tile, with an optional soft tint.",
	"tags": [
		"avatar",
		"squared",
		"initials",
		"tile"
	],
	"args": [
		{
			"name": "initials",
			"type": "string",
			"default": "TT",
			"label": "Initials",
			"maxLength": 3
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "size",
			"type": "enum",
			"values": [
				"sm",
				"md",
				"lg"
			],
			"default": "md",
			"label": "Size"
		},
		{
			"name": "soft",
			"type": "boolean",
			"default": false,
			"label": "Soft tint"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"ttMerge": [
					{
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "center",
						"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
						"fontWeight": 600,
						"borderRadius": "6px",
						"flexShrink": 0,
						"userSelect": "none"
					},
					{
						"ttMap": {
							"arg": "size",
							"values": {
								"sm": {
									"width": "28px",
									"height": "28px",
									"fontSize": "12px"
								},
								"md": {
									"width": "40px",
									"height": "40px",
									"fontSize": "13px"
								},
								"lg": {
									"width": "56px",
									"height": "56px",
									"fontSize": "16px"
								}
							},
							"default": {
								"width": "40px",
								"height": "40px",
								"fontSize": "13px"
							}
						}
					},
					{
						"ttIf": {
							"arg": "soft",
							"then": {
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#e6f4ff",
											"success": "#f6ffed",
											"warning": "#fffbe6",
											"danger": "#fff2f0",
											"info": "#e6f4ff",
											"neutral": "#fafafa"
										},
										"default": "#e6f4ff"
									}
								},
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#0958d9",
											"success": "#389e0d",
											"warning": "#d48806",
											"danger": "#cf1322",
											"info": "#0958d9",
											"neutral": "rgba(0, 0, 0, 0.65)"
										},
										"default": "#0958d9"
									}
								},
								"border": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "1px solid #91caff",
											"success": "1px solid #b7eb8f",
											"warning": "1px solid #ffe58f",
											"danger": "1px solid #ffccc7",
											"info": "1px solid #91caff",
											"neutral": "1px solid #d9d9d9"
										},
										"default": "1px solid #91caff"
									}
								}
							},
							"else": {
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#1677ff",
											"success": "#52c41a",
											"warning": "#faad14",
											"danger": "#ff4d4f",
											"info": "#1677ff",
											"neutral": "rgba(0, 0, 0, 0.88)"
										},
										"default": "#1677ff"
									}
								},
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#ffffff",
											"success": "#ffffff",
											"warning": "#ffffff",
											"danger": "#ffffff",
											"info": "#ffffff",
											"neutral": "#ffffff"
										},
										"default": "#ffffff"
									}
								}
							}
						}
					}
				]
			}
		},
		"children": [
			"{initials}"
		]
	},
	"version": 1,
	"familyKey": "avatar-squared",
	"source": {
		"kind": "archetype",
		"archetype": "avatar",
		"variant": "squared",
		"tranche": 1
	}
}
