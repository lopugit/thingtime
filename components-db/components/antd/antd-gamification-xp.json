{
	"slug": "antd-gamification-xp",
	"name": "XP Progress",
	"library": "antd",
	"category": "engagement",
	"description": "XP progress card in the Ant Design style — a Level chip, a tone-colored bar with a marker dot riding the fill edge, and an XP-to-next-level caption.",
	"tags": [
		"gamification",
		"xp",
		"progress",
		"level"
	],
	"args": [
		{
			"name": "level",
			"type": "number",
			"default": 7,
			"label": "Level",
			"min": 1
		},
		{
			"name": "percent",
			"type": "number",
			"default": 68,
			"label": "Progress (0–100)",
			"min": 0,
			"max": 100
		},
		{
			"name": "xp",
			"type": "string",
			"default": "1,250",
			"label": "XP remaining",
			"maxLength": 10
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"width": "260px",
				"padding": "16px",
				"boxSizing": "border-box",
				"background": "#ffffff",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "#d9d9d9",
				"borderRadius": "8px",
				"boxShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.03), 0 1px 6px -1px rgba(0, 0, 0, 0.02)",
				"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
				"gap": "12px"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "space-between",
						"gap": "12px"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"display": "inline-flex",
								"alignItems": "center",
								"padding": "2px 10px",
								"borderRadius": "4px",
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#e6f4ff",
											"success": "#f6ffed",
											"warning": "#fffbe6",
											"danger": "#fff2f0",
											"info": "#e6f4ff",
											"neutral": "#fafafa"
										},
										"default": "#e6f4ff"
									}
								},
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#0958d9",
											"success": "#389e0d",
											"warning": "#d48806",
											"danger": "#cf1322",
											"info": "#0958d9",
											"neutral": "rgba(0, 0, 0, 0.65)"
										},
										"default": "#0958d9"
									}
								},
								"fontSize": "12px",
								"fontWeight": 700
							}
						},
						"children": [
							"Level {level}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "13px",
								"fontWeight": 600,
								"color": "rgba(0, 0, 0, 0.45)",
								"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
							}
						},
						"children": [
							"{percent}%"
						]
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"position": "relative",
						"height": "10px",
						"borderRadius": "999px",
						"background": "#f0f0f0"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"width": "{percent}%",
								"maxWidth": "100%",
								"height": "100%",
								"borderRadius": "999px",
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#1677ff",
											"success": "#52c41a",
											"warning": "#faad14",
											"danger": "#ff4d4f",
											"info": "#1677ff",
											"neutral": "rgba(0, 0, 0, 0.88)"
										},
										"default": "#1677ff"
									}
								}
							}
						}
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"position": "absolute",
								"top": "-3px",
								"left": "calc({percent}% - 8px)",
								"width": "16px",
								"height": "16px",
								"boxSizing": "border-box",
								"borderRadius": "999px",
								"background": "#ffffff",
								"borderWidth": "2px",
								"borderStyle": "solid",
								"borderColor": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#1677ff",
											"success": "#52c41a",
											"warning": "#faad14",
											"danger": "#ff4d4f",
											"info": "#1677ff",
											"neutral": "rgba(0, 0, 0, 0.88)"
										},
										"default": "#1677ff"
									}
								},
								"boxShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.03), 0 1px 6px -1px rgba(0, 0, 0, 0.02)"
							}
						}
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "12px",
						"color": "rgba(0, 0, 0, 0.45)"
					}
				},
				"children": [
					"{xp} XP to next level"
				]
			}
		]
	},
	"version": 1,
	"familyKey": "gamification-xp",
	"source": {
		"kind": "archetype",
		"archetype": "gamification",
		"variant": "xp",
		"tranche": 2
	}
}
