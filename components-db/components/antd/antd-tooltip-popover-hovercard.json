{
	"slug": "antd-tooltip-popover-hovercard",
	"name": "Hovercard",
	"library": "antd",
	"category": "overlays",
	"description": "Profile hovercard in the Ant Design style — dotted-underline handle trigger above a card with an initials avatar, name, bio, follower stats, and a tone follow button.",
	"tags": [
		"hovercard",
		"profile",
		"overlay",
		"card"
