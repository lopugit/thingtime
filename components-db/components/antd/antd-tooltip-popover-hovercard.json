			"default": "Ada Lovelace",
			"label": "Name",
			"maxLength": 40
		},
		{
			"name": "handle",
			"type": "string",
			"default": "ada",
			"label": "Handle",
			"maxLength": 24
		},
		{
			"name": "initials",
			"type": "string",
			"default": "AL",
