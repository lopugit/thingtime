{
	"slug": "antd-settings-row",
	"name": "Settings Row",
	"library": "antd",
	"category": "settings",
	"description": "Single preference row in the Ant Design style — title and helper caption on the left, a tone-tracked switch on the right, hairline dividers above and below.",
	"tags": [
		"settings",
		"row",
		"switch",
		"preference"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Email notifications",
			"label": "Title",
			"maxLength": 40
		},
		{
			"name": "caption",
			"type": "string",
			"default": "Get a digest of workspace activity",
			"label": "Caption",
			"maxLength": 80
		},
		{
			"name": "enabled",
			"type": "boolean",
			"default": true,
			"label": "Enabled"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"alignItems": "center",
				"width": "320px",
				"boxSizing": "border-box",
				"justifyContent": "space-between",
				"gap": "16px",
				"padding": "12px 4px",
				"background": "#ffffff",
				"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
				"borderTopWidth": "1px",
				"borderTopStyle": "solid",
				"borderTopColor": "#f0f0f0",
				"borderBottomWidth": "1px",
				"borderBottomStyle": "solid",
				"borderBottomColor": "#f0f0f0"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"gap": "2px",
						"minWidth": 0
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "13px",
								"fontWeight": 600,
								"color": "rgba(0, 0, 0, 0.88)"
							}
						},
						"children": [
							"{title}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "12px",
								"color": "rgba(0, 0, 0, 0.45)"
							}
						},
						"children": [
							"{caption}"
						]
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"width": "36px",
						"height": "20px",
						"padding": "3px",
						"boxSizing": "border-box",
						"borderRadius": "999px",
						"background": {
							"ttIf": {
								"arg": "enabled",
								"then": "#1677ff",
								"else": "rgba(0, 0, 0, 0.25)"
							}
						},
						"display": "flex",
						"alignItems": "center",
						"justifyContent": {
							"ttIf": {
								"arg": "enabled",
								"then": "flex-end",
								"else": "flex-start"
							}
						},
						"flexShrink": 0
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"width": "14px",
								"height": "14px",
								"borderRadius": "999px",
								"background": "#ffffff",
								"boxShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.03), 0 1px 6px -1px rgba(0, 0, 0, 0.02)"
							}
						}
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "settings-row",
	"source": {
		"kind": "archetype",
		"archetype": "settings",
		"variant": "row",
		"tranche": 2
	}
}
