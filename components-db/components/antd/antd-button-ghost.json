{
	"slug": "antd-button-ghost",
	"name": "Ghost Button",
	"library": "antd",
	"category": "buttons",
	"description": "Borderless quiet button in the Ant Design style — label only, tone-colored text on a transparent body.",
	"tags": [
		"button",
		"action",
		"ghost"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Dismiss",
			"label": "Label",
			"maxLength": 40
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "size",
			"type": "enum",
			"values": [
				"sm",
				"md",
				"lg"
			],
			"default": "md",
			"label": "Size"
		},
		{
			"name": "disabled",
			"type": "boolean",
			"default": false,
			"label": "Disabled"
		}
	],
	"render": {
		"tag": "button",
		"props": {
			"type": "button",
			"style": {
				"ttMerge": [
					{
						"display": "inline-flex",
						"alignItems": "center",
						"justifyContent": "center",
						"gap": "8px",
						"border": "none",
						"borderRadius": "6px",
						"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
						"fontWeight": 400,
						"cursor": "pointer"
					},
					{
						"ttMap": {
							"arg": "size",
							"values": {
								"sm": {
									"height": "24px",
									"padding": "0 12px",
									"fontSize": "13px"
								},
								"md": {
									"height": "32px",
									"padding": "0 16px",
									"fontSize": "14px"
								},
								"lg": {
									"height": "40px",
									"padding": "0 20px",
									"fontSize": "16px"
								}
							},
							"default": {
								"height": "32px",
								"padding": "0 16px",
								"fontSize": "14px"
							}
						}
					},
					{
						"background": "transparent",
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#1677ff",
									"success": "#52c41a",
									"warning": "#faad14",
									"danger": "#ff4d4f",
									"info": "#1677ff",
									"neutral": "rgba(0, 0, 0, 0.88)"
								},
								"default": "#1677ff"
							}
						}
					},
					{
						"ttIf": {
							"arg": "disabled",
							"then": {
								"opacity": 0.5,
								"cursor": "not-allowed"
							},
							"else": {}
						}
					}
				]
			}
		},
		"children": [
			"{label}"
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "button",
		"variant": "ghost",
		"tranche": 1
	}
}
