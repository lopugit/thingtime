{
	"slug": "antd-empty-states-success",
	"name": "Success State",
	"library": "antd",
	"category": "feedback",
	"description": "Success / complete panel in the Ant Design style — check circle in a soft tone bubble, congratulatory title and message, and an optional continue button.",
	"tags": [
		"success",
		"complete",
		"empty-state",
		"feedback"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "You’re all set",
			"label": "Title",
			"maxLength": 50
		},
		{
			"name": "message",
			"type": "text",
			"default": "Your workspace is ready. Invite your team or jump straight in.",
			"label": "Message"
		},
		{
			"name": "ctaLabel",
			"type": "string",
			"default": "Go to dashboard",
			"label": "CTA label",
			"maxLength": 32
		},
		{
			"name": "showCta",
			"type": "boolean",
			"default": true,
			"label": "Show CTA"
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"success",
				"primary",
				"info"
			],
			"default": "success",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"alignItems": "center",
				"justifyContent": "center",
				"textAlign": "center",
				"gap": "6px",
				"width": "340px",
				"padding": "36px 24px",
				"background": "#ffffff",
				"borderRadius": "8px",
				"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
				"color": "rgba(0, 0, 0, 0.88)",
				"border": "1px solid #d9d9d9",
				"boxShadow": "0 6px 16px 0 rgba(0, 0, 0, 0.08), 0 3px 6px -4px rgba(0, 0, 0, 0.12)"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"width": "46px",
						"height": "46px",
						"borderRadius": "999px",
						"background": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#e6f4ff",
									"success": "#f6ffed",
									"warning": "#fffbe6",
									"danger": "#fff2f0",
									"info": "#e6f4ff",
									"neutral": "#fafafa"
								},
								"default": "#e6f4ff"
							}
						},
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#1677ff",
									"success": "#52c41a",
									"warning": "#faad14",
									"danger": "#ff4d4f",
									"info": "#1677ff",
									"neutral": "rgba(0, 0, 0, 0.88)"
								},
								"default": "#1677ff"
							}
						},
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "center",
						"marginBottom": "4px"
					}
				},
				"children": [
					{
						"tag": "svg",
						"props": {
							"width": 22,
							"height": 22,
							"viewBox": "0 0 24 24",
							"fill": "none",
							"stroke": "currentColor",
							"strokeWidth": 2,
							"strokeLinecap": "round",
							"strokeLinejoin": "round",
							"xmlns": "http://www.w3.org/2000/svg"
						},
						"children": [
							{
								"tag": "polyline",
								"props": {
									"points": "20 6 9 17 4 12"
								}
							}
						]
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontWeight": 600,
						"fontSize": "16px"
					}
				},
				"children": [
					"{title}"
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "13px",
						"color": "rgba(0, 0, 0, 0.45)",
						"lineHeight": 1.5,
						"maxWidth": "250px"
					}
				},
				"children": [
					"{message}"
				]
			},
			{
				"ttIf": {
					"arg": "showCta",
					"then": {
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"display": "inline-flex",
								"alignItems": "center",
								"justifyContent": "center",
								"height": "32px",
								"padding": "0 18px",
								"border": "none",
								"borderRadius": "6px",
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#1677ff",
											"success": "#52c41a",
											"warning": "#faad14",
											"danger": "#ff4d4f",
											"info": "#1677ff",
											"neutral": "rgba(0, 0, 0, 0.88)"
										},
										"default": "#1677ff"
									}
								},
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#ffffff",
											"success": "#ffffff",
											"warning": "#ffffff",
											"danger": "#ffffff",
											"info": "#ffffff",
											"neutral": "#ffffff"
										},
										"default": "#ffffff"
									}
								},
								"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
								"fontSize": "13px",
								"fontWeight": 400,
								"boxShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.03), 0 1px 6px -1px rgba(0, 0, 0, 0.02)",
								"cursor": "pointer",
								"marginTop": "10px"
							}
						},
						"children": [
							"{ctaLabel}"
						]
					}
				}
			}
		]
	},
	"previewBg": "#f5f5f5",
	"version": 1,
	"familyKey": "empty-states-success",
	"source": {
		"kind": "archetype",
		"archetype": "empty-states",
		"variant": "success",
		"tranche": 1
	}
}
