{
	"slug": "antd-ai-assistant-agent-status",
	"name": "AI Agent Status",
	"library": "antd",
	"category": "ai",
	"description": "Agent status card in the Ant Design style — a pulsing ring-and-core dot tinted by a running/waiting/done/error state, task title with step caption, a mono elapsed chip, a mono tool-call log line, and a cancel ghost.",
	"tags": [
		"ai",
		"agent",
		"status",
		"task"
	],
	"args": [
		{
			"name": "task",
			"type": "string",
			"default": "Researching competitors",
			"label": "Task",
			"maxLength": 48
		},
		{
			"name": "state",
			"type": "enum",
			"values": [
				"running",
				"waiting",
				"done",
				"error"
			],
			"default": "running",
			"label": "State"
		},
		{
			"name": "step",
			"type": "number",
			"default": 3,
			"label": "Step",
			"min": 1
		},
		{
			"name": "total",
			"type": "number",
			"default": 5,
			"label": "Total steps",
			"min": 1
		},
		{
			"name": "elapsed",
			"type": "string",
			"default": "02:14",
			"label": "Elapsed",
			"maxLength": 10
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
				"background": "#ffffff",
				"borderRadius": "6px",
				"boxSizing": "border-box",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "#d9d9d9",
				"gap": "10px",
				"width": "320px",
				"padding": "14px"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "10px"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"width": "18px",
								"height": "18px",
								"borderRadius": "999px",
								"background": {
									"ttMap": {
										"arg": "state",
										"values": {
											"running": "#e6f4ff",
											"waiting": "#fffbe6",
											"done": "#f6ffed",
											"error": "#fff2f0"
										}
									}
								},
								"display": "flex",
								"alignItems": "center",
								"justifyContent": "center",
								"flexShrink": 0
							}
						},
						"children": [
							{
								"tag": "div",
								"props": {
									"style": {
										"width": "8px",
										"height": "8px",
										"borderRadius": "999px",
										"background": {
											"ttMap": {
												"arg": "state",
												"values": {
													"running": "#1677ff",
													"waiting": "#faad14",
													"done": "#52c41a",
													"error": "#ff4d4f"
												}
											}
										}
									}
								}
							}
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"flexDirection": "column",
								"gap": "2px",
								"flex": 1
							}
						},
						"children": [
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "13px",
										"fontWeight": 600,
										"color": "rgba(0, 0, 0, 0.88)"
									}
								},
								"children": [
									"{task}"
								]
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "12px",
										"color": "rgba(0, 0, 0, 0.45)"
									}
								},
								"children": [
									"Step {step} of {total}"
								]
							}
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "12px",
								"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
								"color": "rgba(0, 0, 0, 0.45)",
								"background": "#fafafa",
								"borderRadius": "4px",
								"padding": "2px 8px",
								"flexShrink": 0
							}
						},
						"children": [
							"{elapsed}"
						]
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"fontSize": "12px",
						"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
						"color": "rgba(0, 0, 0, 0.45)",
						"background": "#fafafa",
						"borderRadius": "6px",
						"padding": "6px 8px",
						"borderLeftWidth": "2px",
						"borderLeftStyle": "solid",
						"borderLeftColor": {
							"ttMap": {
								"arg": "state",
								"values": {
									"running": "#1677ff",
									"waiting": "#faad14",
									"done": "#52c41a",
									"error": "#ff4d4f"
								}
							}
						},
						"whiteSpace": "nowrap",
						"overflow": "hidden"
					}
				},
				"children": [
					"→ web.search(\"competitor pricing\")"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "8px"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"flex": 1
							}
						}
					},
					{
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"border": "none",
								"background": "transparent",
								"padding": 0,
								"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
								"fontSize": "13px",
								"fontWeight": 400,
								"color": "#ff4d4f",
								"cursor": "pointer"
							}
						},
						"children": [
							"Cancel"
						]
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "ai-assistant-agent-status",
	"source": {
		"kind": "archetype",
		"archetype": "ai-assistant",
		"variant": "agent-status",
		"tranche": 2
	}
