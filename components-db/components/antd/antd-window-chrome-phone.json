{
	"slug": "antd-window-chrome-phone",
	"name": "Phone Frame",
	"library": "antd",
	"category": "mockups",
	"description": "Phone frame mockup in the Ant Design style — thick bezel, notch or punch-hole cutout, a status bar with time, signal and battery, tone hero block, placeholder lines and a home indicator.",
	"tags": [
		"mockup",
		"phone",
		"mobile",
		"frame"
	],
	"args": [
		{
			"name": "time",
			"type": "string",
			"default": "9:41",
			"label": "Status time",
			"maxLength": 8
		},
		{
			"name": "cutout",
			"type": "enum",
			"values": [
				"notch",
				"punch"
			],
			"default": "notch",
			"label": "Cutout"
		},
		{
			"name": "blocks",
			"type": "number",
			"default": 3,
			"label": "Content lines"
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"width": "190px",
				"borderWidth": "5px",
				"borderStyle": "solid",
				"borderColor": "rgba(0, 0, 0, 0.88)",
				"borderRadius": "30px",
				"background": "#ffffff",
				"overflow": "hidden",
				"boxShadow": "0 6px 16px 0 rgba(0, 0, 0, 0.08), 0 3px 6px -4px rgba(0, 0, 0, 0.12)",
				"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "flex-start",
						"justifyContent": "center",
						"height": "16px"
					}
				},
				"children": [
					{
						"ttIf": {
							"arg": "cutout",
							"equals": "notch",
							"then": {
								"tag": "div",
								"props": {
									"style": {
										"width": "74px",
										"height": "13px",
										"borderRadius": "0 0 10px 10px",
										"background": "rgba(0, 0, 0, 0.88)"
									}
								}
							},
							"else": {
								"tag": "div",
								"props": {
									"style": {
										"width": "10px",
										"height": "10px",
										"borderRadius": "999px",
										"background": "rgba(0, 0, 0, 0.88)",
										"marginTop": "3px"
									}
								}
							}
						}
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "space-between",
						"padding": "2px 14px",
						"fontSize": "12px",
						"fontWeight": 600,
						"color": "rgba(0, 0, 0, 0.88)"
					}
				},
				"children": [
					"{time}",
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"gap": "5px"
							}
						},
						"children": [
							{
								"tag": "svg",
								"props": {
									"width": 12,
									"height": 10,
									"viewBox": "0 0 12 10",
									"fill": "rgba(0, 0, 0, 0.88)",
									"xmlns": "http://www.w3.org/2000/svg"
								},
								"children": [
									{
										"tag": "rect",
										"props": {
											"x": 0,
											"y": 6,
											"width": 2.5,
											"height": 4,
											"rx": 0.8
										}
									},
									{
										"tag": "rect",
										"props": {
											"x": 4.5,
											"y": 3.5,
											"width": 2.5,
											"height": 6.5,
											"rx": 0.8
										}
									},
									{
										"tag": "rect",
										"props": {
											"x": 9,
											"y": 0.5,
											"width": 2.5,
											"height": 9.5,
											"rx": 0.8
										}
									}
								]
							},
							{
								"tag": "svg",
								"props": {
									"width": 18,
									"height": 10,
									"viewBox": "0 0 18 10",
									"fill": "none",
									"stroke": "rgba(0, 0, 0, 0.88)",
									"strokeWidth": 1,
									"xmlns": "http://www.w3.org/2000/svg"
								},
								"children": [
									{
										"tag": "rect",
										"props": {
											"x": 0.5,
											"y": 1,
											"width": 13,
											"height": 8,
											"rx": 2
										}
									},
									{
										"tag": "rect",
										"props": {
											"x": 2.5,
											"y": 3,
											"width": 7,
											"height": 4,
											"rx": 1,
											"fill": "rgba(0, 0, 0, 0.88)",
											"stroke": "none"
										}
									},
									{
										"tag": "line",
										"props": {
											"x1": 15.5,
											"y1": 3.5,
											"x2": 15.5,
											"y2": 6.5
										}
									}
								]
							}
						]
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"gap": "8px",
						"padding": "12px"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"height": "58px",
								"borderRadius": "6px",
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#e6f4ff",
											"success": "#f6ffed",
											"warning": "#fffbe6",
											"danger": "#fff2f0",
											"info": "#e6f4ff",
											"neutral": "#fafafa"
										},
										"default": "#e6f4ff"
									}
								}
							}
						}
					},
					{
						"ttRepeat": {
							"arg": "blocks",
							"max": 6,
							"node": {
								"tag": "div",
								"props": {
									"style": {
										"height": "10px",
										"borderRadius": "4px",
										"background": "#f0f0f0",
										"width": "calc(100% - {index} * 12%)"
									}
								}
							}
						}
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "center",
						"padding": "2px 0 7px"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"width": "54px",
								"height": "4px",
								"borderRadius": "999px",
								"background": "rgba(0, 0, 0, 0.88)"
							}
						}
					}
				]
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "window-chrome",
		"variant": "phone",
		"tranche": 2
	}
}
