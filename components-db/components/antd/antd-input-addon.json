{
	"slug": "antd-input-addon",
	"name": "Addon Input",
	"library": "antd",
	"category": "forms",
	"description": "Text field with a prefix addon segment in the Ant Design style — a tinted https:// block divided from the input by the library border.",
	"tags": [
		"input",
		"addon",
		"prefix",
		"url",
		"form"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Website",
			"label": "Label",
			"maxLength": 40
		},
		{
			"name": "addon",
			"type": "string",
			"default": "https://",
			"label": "Addon",
			"maxLength": 20
		},
		{
			"name": "placeholder",
			"type": "string",
			"default": "example.com",
			"label": "Placeholder",
			"maxLength": 60
		},
		{
			"name": "size",
			"type": "enum",
			"values": [
				"sm",
				"md",
				"lg"
			],
			"default": "md",
			"label": "Size"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"gap": "6px",
				"width": "280px",
				"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
			}
		},
		"children": [
			{
				"tag": "label",
				"props": {
					"style": {
						"fontSize": "13px",
						"fontWeight": 500,
						"color": "rgba(0, 0, 0, 0.88)",
						"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
					}
				},
				"children": [
					"{label}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"ttMerge": [
							{
								"display": "flex",
								"alignItems": "stretch",
								"border": "1px solid #d9d9d9",
								"borderRadius": "6px",
								"background": "#ffffff",
								"overflow": "hidden",
								"boxSizing": "border-box"
							},
							{
								"ttMap": {
									"arg": "size",
									"values": {
										"sm": {
											"height": "24px",
											"fontSize": "13px"
										},
										"md": {
											"height": "32px",
											"fontSize": "14px"
										},
										"lg": {
											"height": "40px",
											"fontSize": "16px"
										}
									},
									"default": {
										"height": "32px",
										"fontSize": "14px"
									}
								}
							}
						]
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"padding": "0 12px",
								"background": "#fafafa",
								"borderRight": "1px solid #d9d9d9",
								"color": "rgba(0, 0, 0, 0.45)",
								"flexShrink": 0
							}
						},
						"children": [
							"{addon}"
						]
					},
					{
						"tag": "input",
						"props": {
							"type": "text",
							"placeholder": "{placeholder}",
							"style": {
								"flex": 1,
								"minWidth": 0,
								"border": "none",
								"outline": "none",
								"background": "transparent",
								"padding": "0 12px",
								"color": "rgba(0, 0, 0, 0.88)",
								"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
								"fontSize": "inherit"
							}
						}
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "input-addon",
	"source": {
		"kind": "archetype",
		"archetype": "input",
		"variant": "addon",
		"tranche": 1
	}
}
