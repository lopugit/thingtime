														"fill": "none",
														"stroke": "currentColor",
														"strokeWidth": 2,
														"strokeLinecap": "round",
														"strokeLinejoin": "round",
														"xmlns": "http://www.w3.org/2000/svg"
													},
													"children": [
														{
															"tag": "polyline",
															"props": {
																"points": "3 6 5 6 21 6"
															}
														},
														{
															"tag": "path",
															"props": {
																"d": "M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"
															}
