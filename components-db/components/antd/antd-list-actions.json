{
	"slug": "antd-list-actions",
	"name": "Actions List",
	"library": "antd",
	"category": "data-display",
	"description": "List rows with a trailing action button in the Ant Design style — pick the row glyph (edit, trash, or overflow dots) and the tint it sits on.",
	"tags": [
		"list",
		"actions",
		"buttons",
		"data"
	],
	"args": [
		{
			"name": "item",
			"type": "string",
			"default": "Quarterly report",
			"label": "Item label",
			"maxLength": 40
		},
		{
			"name": "count",
			"type": "number",
			"default": 3,
			"label": "Rows",
			"min": 1,
			"max": 6
		},
		{
			"name": "action",
			"type": "enum",
			"values": [
				"edit",
				"trash",
				"dots"
			],
			"default": "edit",
			"label": "Action"
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "ul",
		"props": {
			"style": {
				"ttMerge": [
					{
						"listStyle": "none",
						"margin": 0,
						"padding": 0,
						"width": "280px",
						"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
						"color": "rgba(0, 0, 0, 0.88)",
						"background": "#ffffff",
						"borderRadius": "6px",
						"overflow": "hidden"
					},
					{
						"border": "1px solid #d9d9d9",
						"boxShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.03), 0 1px 6px -1px rgba(0, 0, 0, 0.02)"
					}
				]
			}
		},
		"children": [
			{
				"ttRepeat": {
					"arg": "count",
					"max": 6,
					"node": {
						"tag": "li",
						"props": {
							"style": {
								"ttMerge": [
									{
										"display": "flex",
										"alignItems": "center",
										"gap": "12px",
										"padding": "10px 14px",
										"fontSize": "14px"
									},
									{
										"ttIf": {
											"arg": "n",
											"equals": 1,
											"then": {},
											"else": {
												"borderTop": "1px solid #f0f0f0"
											}
										}
									}
								]
							}
						},
						"children": [
							{
								"tag": "span",
								"props": {
									"style": {
										"flexGrow": 1,
										"minWidth": 0
									}
								},
								"children": [
									"{item} {n}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"width": "24px",
										"height": "24px",
										"padding": 0,
										"display": "inline-flex",
										"alignItems": "center",
										"justifyContent": "center",
										"border": "none",
										"borderRadius": "6px",
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#e6f4ff",
													"success": "#f6ffed",
													"warning": "#fffbe6",
													"danger": "#fff2f0",
													"info": "#e6f4ff",
													"neutral": "#fafafa"
												},
												"default": "#e6f4ff"
											}
										},
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#0958d9",
													"success": "#389e0d",
													"warning": "#d48806",
													"danger": "#cf1322",
													"info": "#0958d9",
													"neutral": "rgba(0, 0, 0, 0.65)"
												},
												"default": "#0958d9"
											}
										},
										"cursor": "pointer",
										"flexShrink": 0
									}
								},
								"children": [
									{
										"ttMap": {
											"arg": "action",
											"values": {
												"edit": {
													"tag": "svg",
													"props": {
