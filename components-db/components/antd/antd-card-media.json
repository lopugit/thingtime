{
	"slug": "antd-card-media",
	"name": "Media Card",
	"library": "antd",
	"category": "layout",
	"description": "Card with a media block in the Ant Design style — a tone-gradient placeholder banner over a badge, title and body.",
	"tags": [
		"card",
		"media",
		"image",
		"banner"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Golden hour",
			"label": "Title",
			"maxLength": 60
		},
		{
			"name": "body",
			"type": "text",
			"default": "A placeholder media block stands in for imagery — no external assets needed.",
			"label": "Body"
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "mediaHeight",
			"type": "enum",
			"values": [
				"sm",
				"md",
				"lg"
			],
			"default": "md",
			"label": "Media height"
		},
		{
			"name": "badge",
			"type": "string",
			"default": "New",
			"label": "Badge",
			"maxLength": 20
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"width": "300px",
				"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
				"background": "#ffffff",
				"color": "rgba(0, 0, 0, 0.88)",
				"border": "1px solid #d9d9d9",
				"borderRadius": "6px",
				"boxShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.03), 0 1px 6px -1px rgba(0, 0, 0, 0.02)",
				"overflow": "hidden",
				"boxSizing": "border-box"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"ttMerge": [
							{
								"display": "flex",
								"alignItems": "center",
								"justifyContent": "center",
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "linear-gradient(135deg, #e6f4ff 0%, #91caff 60%, #1677ff 140%)",
											"success": "linear-gradient(135deg, #f6ffed 0%, #b7eb8f 60%, #52c41a 140%)",
											"warning": "linear-gradient(135deg, #fffbe6 0%, #ffe58f 60%, #faad14 140%)",
											"danger": "linear-gradient(135deg, #fff2f0 0%, #ffccc7 60%, #ff4d4f 140%)",
											"info": "linear-gradient(135deg, #e6f4ff 0%, #91caff 60%, #1677ff 140%)",
											"neutral": "linear-gradient(135deg, #fafafa 0%, #d9d9d9 60%, rgba(0, 0, 0, 0.88) 140%)"
										},
										"default": "linear-gradient(135deg, #e6f4ff 0%, #91caff 60%, #1677ff 140%)"
									}
								}
							},
							{
								"ttMap": {
									"arg": "mediaHeight",
									"values": {
										"sm": {
											"height": "72px"
										},
										"md": {
											"height": "112px"
										},
										"lg": {
											"height": "152px"
										}
									},
									"default": {
										"height": "112px"
									}
								}
							}
						]
					}
				},
				"children": [
					{
						"tag": "svg",
						"props": {
							"width": 28,
							"height": 28,
							"viewBox": "0 0 24 24",
							"fill": "none",
							"stroke": {
								"ttMap": {
									"arg": "tone",
									"values": {
										"primary": "#0958d9",
										"success": "#389e0d",
										"warning": "#d48806",
										"danger": "#cf1322",
										"info": "#0958d9",
										"neutral": "rgba(0, 0, 0, 0.65)"
									},
									"default": "#0958d9"
								}
							},
							"strokeWidth": 2,
							"strokeLinecap": "round",
							"strokeLinejoin": "round",
							"xmlns": "http://www.w3.org/2000/svg"
						},
						"children": [
							{
								"tag": "rect",
								"props": {
									"x": 3,
									"y": 3,
									"width": 18,
									"height": 18,
									"rx": 2
								}
							},
							{
								"tag": "circle",
								"props": {
									"cx": 8.5,
									"cy": 8.5,
									"r": 1.5
								}
							},
							{
								"tag": "polyline",
								"props": {
									"points": "21 15 16 10 5 21"
								}
							}
						]
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"padding": "16px",
						"gap": "8px"
					}
				},
				"children": [
					{
						"ttIf": {
							"arg": "badge",
							"then": {
								"tag": "span",
								"props": {
									"style": {
										"alignSelf": "flex-start",
										"padding": "2px 8px",
										"borderRadius": "999px",
										"fontSize": "12px",
										"fontWeight": 600,
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#e6f4ff",
													"success": "#f6ffed",
													"warning": "#fffbe6",
													"danger": "#fff2f0",
													"info": "#e6f4ff",
													"neutral": "#fafafa"
												},
												"default": "#e6f4ff"
											}
										},
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#0958d9",
													"success": "#389e0d",
													"warning": "#d48806",
													"danger": "#cf1322",
													"info": "#0958d9",
													"neutral": "rgba(0, 0, 0, 0.65)"
												},
												"default": "#0958d9"
											}
										},
										"border": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "1px solid #91caff",
													"success": "1px solid #b7eb8f",
													"warning": "1px solid #ffe58f",
													"danger": "1px solid #ffccc7",
													"info": "1px solid #91caff",
													"neutral": "1px solid #d9d9d9"
												},
												"default": "1px solid #91caff"
											}
										}
									}
								},
								"children": [
									"{badge}"
								]
							}
						}
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "16px",
								"fontWeight": 600,
								"color": "rgba(0, 0, 0, 0.88)"
							}
						},
						"children": [
							"{title}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "13px",
								"color": "rgba(0, 0, 0, 0.45)",
								"lineHeight": 1.5
							}
						},
						"children": [
							"{body}"
						]
					}
				]
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "card",
		"variant": "media",
		"tranche": 1
	}
}
