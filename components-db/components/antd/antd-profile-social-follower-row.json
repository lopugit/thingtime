	"name": "Follower Row",
	"library": "antd",
	"category": "social",
	"description": "Follower list row in the Ant Design style — initials avatar wearing a presence dot, name with a mutuals caption, and a small tone-tinted follow chip on the right.",
	"tags": [
		"profile",
		"list",
		"follower",
		"presence",
		"social"
