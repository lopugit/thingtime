								"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
							}
						},
						"children": [
							{
								"ttIf": {
									"arg": "current",
									"equals": "1",
									"then": {
										"tag": "svg",
										"props": {
											"width": 14,
											"height": 14,
											"viewBox": "0 0 24 24",
											"fill": "#1677ff",
											"xmlns": "http://www.w3.org/2000/svg"
										},
										"children": [
											{
												"tag": "rect",
												"props": {
													"x": 5,
													"y": 10,
													"width": 3,
													"height": 9,
													"rx": 1
												}
											},
											{
												"tag": "rect",
												"props": {
													"x": 10.5,
													"y": 5,
													"width": 3,
													"height": 14,
													"rx": 1
												}
											},
