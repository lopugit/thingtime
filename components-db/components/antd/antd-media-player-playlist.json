{
	"slug": "antd-media-player-playlist",
	"name": "Playlist",
	"library": "antd",
	"category": "media",
	"description": "Playlist card in the Ant Design style — four track rows with index numbers and monospaced durations; the current track swaps its number for accent EQ bars and the hovered row gets a soft wash.",
	"tags": [
		"media",
		"playlist",
		"tracks",
		"queue"
	],
	"args": [
		{
			"name": "heading",
			"type": "string",
			"default": "Up next",
			"label": "Heading",
			"maxLength": 24
		},
		{
			"name": "current",
			"type": "enum",
			"values": [
				"1",
				"2",
				"3",
				"4"
			],
			"default": "2",
			"label": "Current track"
		},
		{
			"name": "hovered",
			"type": "enum",
			"values": [
				"none",
				"1",
				"2",
				"3",
				"4"
			],
			"default": "3",
			"label": "Hovered row"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"background": "#ffffff",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "#d9d9d9",
				"borderRadius": "8px",
				"boxShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.03), 0 1px 6px -1px rgba(0, 0, 0, 0.02)",
				"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
				"boxSizing": "border-box",
				"display": "flex",
				"flexDirection": "column",
				"gap": "2px",
				"width": "280px",
				"padding": "10px"
			}
		},
		"children": [
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "12px",
						"fontWeight": 600,
						"color": "rgba(0, 0, 0, 0.45)",
						"textTransform": "uppercase",
						"letterSpacing": "0.05em",
						"padding": "2px 10px 6px"
					}
				},
				"children": [
					"{heading}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "10px",
						"padding": "7px 10px",
						"borderRadius": "6px",
						"background": {
							"ttIf": {
								"arg": "hovered",
								"equals": "1",
								"then": "#fafafa",
								"else": "transparent"
							}
						}
					}
				},
