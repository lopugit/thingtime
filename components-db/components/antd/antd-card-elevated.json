{
	"slug": "antd-card-elevated",
	"name": "Elevated Card",
	"library": "antd",
	"category": "layout",
	"description": "Floating borderless card in the Ant Design style — the library's deeper shadow tiers lift it off the page, led by a tone-tinted icon chip.",
	"tags": [
		"card",
		"elevated",
		"shadow",
		"floating"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Quick insight",
			"label": "Title",
			"maxLength": 60
		},
		{
			"name": "body",
			"type": "text",
			"default": "Elevation carries the hierarchy here — the card floats free of any border.",
			"label": "Body"
		},
		{
			"name": "elevation",
			"type": "enum",
			"values": [
				"raised",
				"floating"
			],
			"default": "floating",
			"label": "Elevation"
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"width": "300px",
				"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
				"background": "#ffffff",
				"color": "rgba(0, 0, 0, 0.88)",
				"border": "none",
				"borderRadius": "6px",
				"boxShadow": {
					"ttMap": {
						"arg": "elevation",
						"values": {
							"raised": "0 6px 16px 0 rgba(0, 0, 0, 0.08), 0 3px 6px -4px rgba(0, 0, 0, 0.12)",
							"floating": "0 9px 28px 8px rgba(0, 0, 0, 0.05), 0 6px 16px 0 rgba(0, 0, 0, 0.08)"
						},
						"default": "0 9px 28px 8px rgba(0, 0, 0, 0.05), 0 6px 16px 0 rgba(0, 0, 0, 0.08)"
					}
				},
				"overflow": "hidden",
				"boxSizing": "border-box",
				"padding": "16px",
				"gap": "10px"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "10px"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"width": "32px",
								"height": "32px",
								"borderRadius": "6px",
								"display": "flex",
								"alignItems": "center",
								"justifyContent": "center",
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#e6f4ff",
											"success": "#f6ffed",
											"warning": "#fffbe6",
											"danger": "#fff2f0",
											"info": "#e6f4ff",
											"neutral": "#fafafa"
										},
										"default": "#e6f4ff"
									}
								},
								"flexShrink": 0
							}
						},
						"children": [
							{
								"tag": "svg",
								"props": {
									"width": 16,
									"height": 16,
									"viewBox": "0 0 24 24",
									"fill": "none",
									"stroke": {
										"ttMap": {
											"arg": "tone",
											"values": {
												"primary": "#0958d9",
												"success": "#389e0d",
												"warning": "#d48806",
												"danger": "#cf1322",
												"info": "#0958d9",
												"neutral": "rgba(0, 0, 0, 0.65)"
											},
											"default": "#0958d9"
										}
									},
									"strokeWidth": 2,
									"strokeLinecap": "round",
									"strokeLinejoin": "round",
									"xmlns": "http://www.w3.org/2000/svg"
								},
								"children": [
									{
										"tag": "polygon",
										"props": {
											"points": "13 2 3 14 12 14 11 22 21 10 12 10 13 2"
										}
									}
								]
							}
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "16px",
								"fontWeight": 600,
								"color": "rgba(0, 0, 0, 0.88)"
							}
						},
						"children": [
							"{title}"
						]
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "13px",
						"color": "rgba(0, 0, 0, 0.45)",
						"lineHeight": 1.5
					}
				},
				"children": [
					"{body}"
				]
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "card",
		"variant": "elevated",
		"tranche": 1
	}
}
