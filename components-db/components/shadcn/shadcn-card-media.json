{
	"slug": "shadcn-card-media",
	"name": "Media Card",
	"library": "shadcn",
	"category": "layout",
	"description": "Card with a media block in the shadcn/ui style — a tone-gradient placeholder banner over a badge, title and body.",
	"tags": [
		"card",
		"media",
		"image",
		"banner"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Golden hour",
			"label": "Title",
			"maxLength": 60
		},
		{
			"name": "body",
			"type": "text",
			"default": "A placeholder media block stands in for imagery — no external assets needed.",
			"label": "Body"
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "mediaHeight",
			"type": "enum",
			"values": [
				"sm",
				"md",
				"lg"
			],
			"default": "md",
			"label": "Media height"
		},
		{
			"name": "badge",
			"type": "string",
			"default": "New",
			"label": "Badge",
			"maxLength": 20
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"width": "300px",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"background": "#ffffff",
				"color": "#09090b",
				"border": "1px solid #e4e4e7",
				"borderRadius": "8px",
				"boxShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
				"overflow": "hidden",
				"boxSizing": "border-box"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"ttMerge": [
							{
								"display": "flex",
								"alignItems": "center",
								"justifyContent": "center",
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "linear-gradient(135deg, #f4f4f5 0%, #e4e4e7 60%, #18181b 140%)",
											"success": "linear-gradient(135deg, #f0fdf4 0%, #bbf7d0 60%, #16a34a 140%)",
											"warning": "linear-gradient(135deg, #fffbeb 0%, #fde68a 60%, #f59e0b 140%)",
											"danger": "linear-gradient(135deg, #fef2f2 0%, #fecaca 60%, #ef4444 140%)",
											"info": "linear-gradient(135deg, #eff6ff 0%, #bfdbfe 60%, #3b82f6 140%)",
											"neutral": "linear-gradient(135deg, #f4f4f5 0%, #e4e4e7 60%, #71717a 140%)"
										},
										"default": "linear-gradient(135deg, #f4f4f5 0%, #e4e4e7 60%, #18181b 140%)"
									}
								}
							},
							{
								"ttMap": {
									"arg": "mediaHeight",
									"values": {
										"sm": {
											"height": "72px"
										},
										"md": {
											"height": "112px"
										},
										"lg": {
											"height": "152px"
										}
									},
									"default": {
										"height": "112px"
									}
								}
							}
						]
					}
				},
				"children": [
					{
						"tag": "svg",
						"props": {
							"width": 28,
							"height": 28,
							"viewBox": "0 0 24 24",
							"fill": "none",
							"stroke": {
								"ttMap": {
									"arg": "tone",
									"values": {
										"primary": "#18181b",
										"success": "#15803d",
										"warning": "#b45309",
										"danger": "#b91c1c",
										"info": "#1d4ed8",
										"neutral": "#3f3f46"
									},
									"default": "#18181b"
								}
							},
							"strokeWidth": 2,
							"strokeLinecap": "round",
							"strokeLinejoin": "round",
							"xmlns": "http://www.w3.org/2000/svg"
						},
						"children": [
							{
								"tag": "rect",
								"props": {
									"x": 3,
									"y": 3,
									"width": 18,
									"height": 18,
									"rx": 2
								}
							},
							{
								"tag": "circle",
								"props": {
									"cx": 8.5,
									"cy": 8.5,
									"r": 1.5
								}
							},
							{
								"tag": "polyline",
								"props": {
									"points": "21 15 16 10 5 21"
								}
							}
						]
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"padding": "16px",
						"gap": "8px"
					}
				},
				"children": [
					{
						"ttIf": {
							"arg": "badge",
							"then": {
								"tag": "span",
								"props": {
									"style": {
										"alignSelf": "flex-start",
										"padding": "2px 8px",
										"borderRadius": "999px",
										"fontSize": "12px",
										"fontWeight": 600,
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#f4f4f5",
													"success": "#f0fdf4",
													"warning": "#fffbeb",
													"danger": "#fef2f2",
													"info": "#eff6ff",
													"neutral": "#f4f4f5"
												},
												"default": "#f4f4f5"
											}
										},
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#18181b",
													"success": "#15803d",
													"warning": "#b45309",
													"danger": "#b91c1c",
													"info": "#1d4ed8",
													"neutral": "#3f3f46"
												},
												"default": "#18181b"
											}
										},
										"border": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "1px solid #e4e4e7",
													"success": "1px solid #bbf7d0",
													"warning": "1px solid #fde68a",
													"danger": "1px solid #fecaca",
													"info": "1px solid #bfdbfe",
													"neutral": "1px solid #e4e4e7"
												},
												"default": "1px solid #e4e4e7"
											}
										}
									}
								},
								"children": [
									"{badge}"
								]
							}
						}
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "16px",
								"fontWeight": 600,
								"color": "#09090b"
							}
						},
						"children": [
							"{title}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "13px",
								"color": "#71717a",
								"lineHeight": 1.5
							}
						},
						"children": [
							"{body}"
						]
					}
				]
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "card",
		"variant": "media",
		"tranche": 1
	}
}
