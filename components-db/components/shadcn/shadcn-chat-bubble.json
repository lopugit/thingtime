{
	"slug": "shadcn-chat-bubble",
	"name": "Message Bubble Pair",
	"library": "shadcn",
	"category": "messaging",
	"description": "Incoming and outgoing chat bubbles in the shadcn/ui style — quiet surface on the left, tone-solid reply on the right, library-native corners with a sharp tail edge and a timestamp.",
	"tags": [
		"chat",
		"message",
		"bubble",
		"conversation"
	],
	"args": [
		{
			"name": "incoming",
			"type": "string",
			"default": "Hey! Did you see the launch?",
			"label": "Incoming message",
			"maxLength": 120
		},
		{
			"name": "outgoing",
			"type": "string",
			"default": "Just saw it — looks great!",
			"label": "Outgoing message",
			"maxLength": 120
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "time",
			"type": "string",
			"default": "9:41 AM",
			"label": "Timestamp",
			"maxLength": 12
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"gap": "6px",
				"width": "280px",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"padding": "8px 12px",
						"maxWidth": "220px",
						"fontSize": "14px",
						"lineHeight": 1.45,
						"background": "#f4f4f5",
						"color": "#09090b",
						"borderRadius": "8px 8px 8px 6px",
						"alignSelf": "flex-start"
					}
				},
				"children": [
					"{incoming}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"padding": "8px 12px",
						"maxWidth": "220px",
						"fontSize": "14px",
						"lineHeight": 1.45,
						"background": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#18181b",
									"success": "#16a34a",
									"warning": "#f59e0b",
									"danger": "#ef4444",
									"info": "#3b82f6",
									"neutral": "#71717a"
								},
								"default": "#18181b"
							}
						},
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#fafafa",
									"success": "#ffffff",
									"warning": "#ffffff",
									"danger": "#fafafa",
									"info": "#ffffff",
									"neutral": "#ffffff"
								},
								"default": "#fafafa"
							}
						},
						"borderRadius": "8px 8px 6px 8px",
						"alignSelf": "flex-end"
					}
				},
				"children": [
					"{outgoing}"
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"alignSelf": "flex-end",
						"fontSize": "12px",
						"color": "#71717a"
					}
				},
				"children": [
					"{time}"
				]
			}
		]
	},
	"version": 1,
	"familyKey": "chat-bubble",
	"source": {
		"kind": "archetype",
		"archetype": "chat",
		"variant": "bubble",
		"tranche": 2
	}
}
