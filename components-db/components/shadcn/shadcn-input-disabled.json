{
	"slug": "shadcn-input-disabled",
	"name": "Disabled Input",
	"library": "shadcn",
	"category": "forms",
	"description": "Disabled text field in the shadcn/ui style — muted label over a filled, non-interactive control with a not-allowed cursor and a faint hint.",
	"tags": [
		"input",
		"disabled",
		"readonly",
		"form"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "API key",
			"label": "Label",
			"maxLength": 40
		},
		{
			"name": "value",
			"type": "string",
			"default": "Managed by your admin",
			"label": "Value",
			"maxLength": 60
		},
		{
			"name": "hint",
			"type": "string",
			"default": "Contact an admin to change this.",
			"label": "Hint",
			"maxLength": 80
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"gap": "6px",
				"width": "260px",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
			}
		},
		"children": [
			{
				"tag": "label",
				"props": {
					"style": {
						"fontSize": "13px",
						"fontWeight": 500,
						"color": "#71717a",
						"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
					}
				},
				"children": [
					"{label}"
				]
			},
			{
				"tag": "input",
				"props": {
					"type": "text",
					"value": "{value}",
					"disabled": true,
					"style": {
						"ttMerge": [
							{
								"width": "100%",
								"padding": "0 12px",
								"border": "1px solid #e4e4e7",
								"borderRadius": "8px",
								"background": "#ffffff",
								"color": "#09090b",
								"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
								"outline": "none",
								"boxSizing": "border-box"
							},
							{
								"height": "36px",
								"fontSize": "14px",
								"background": "#f4f4f5",
								"color": "#71717a",
								"border": "1px solid #f4f4f5",
								"cursor": "not-allowed",
								"boxShadow": "none"
							}
						]
					}
				}
			},
			{
				"ttIf": {
					"arg": "hint",
					"then": {
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "12px",
								"color": "#a1a1aa"
							}
						},
						"children": [
							"{hint}"
						]
					}
				}
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "input",
		"variant": "disabled",
		"tranche": 1
	}
}
