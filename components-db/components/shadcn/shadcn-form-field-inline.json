{
	"slug": "shadcn-form-field-inline",
	"name": "Inline Label Field",
	"library": "shadcn",
	"category": "forms",
	"description": "Horizontal form row in the shadcn/ui style — fixed-width label beside a flexible input, in three control sizes.",
	"tags": [
		"form",
		"field",
		"inline",
		"horizontal"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Full name",
			"label": "Label",
			"maxLength": 30
		},
		{
			"name": "placeholder",
			"type": "string",
			"default": "Jane Doe",
			"label": "Placeholder",
			"maxLength": 60
		},
		{
			"name": "size",
			"type": "enum",
			"values": [
				"sm",
				"md",
				"lg"
			],
			"default": "md",
			"label": "Size"
		},
		{
			"name": "disabled",
			"type": "boolean",
			"default": false,
			"label": "Disabled"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"alignItems": "center",
				"gap": "12px",
				"width": "340px"
			}
		},
		"children": [
			{
				"tag": "span",
				"props": {
					"style": {
						"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
						"fontSize": "13px",
						"fontWeight": 600,
						"color": "#09090b",
						"width": "104px",
						"flexShrink": 0,
						"textAlign": "left"
					}
				},
				"children": [
					"{label}"
				]
			},
			{
				"tag": "input",
				"props": {
					"type": "text",
					"placeholder": "{placeholder}",
					"style": {
						"ttMerge": [
							{
								"height": "36px",
								"padding": "0 12px",
								"borderRadius": "8px",
								"borderWidth": "1px",
								"borderStyle": "solid",
								"borderColor": "#e4e4e7",
								"background": "#ffffff",
								"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
								"fontSize": "14px",
								"color": "#09090b",
								"outline": "none",
								"width": "100%",
								"boxSizing": "border-box",
								"boxShadow": "none"
							},
							{
								"ttMap": {
									"arg": "size",
									"values": {
										"sm": {
											"height": "32px",
											"fontSize": "13px"
										},
										"md": {
											"height": "36px",
											"fontSize": "14px"
										},
										"lg": {
											"height": "40px",
											"fontSize": "16px"
										}
									},
									"default": {
										"height": "36px",
										"fontSize": "14px"
									}
								}
							},
							{
								"width": "auto",
								"flex": "1 1 auto"
							},
							{
								"ttIf": {
									"arg": "disabled",
									"then": {
										"background": "#f4f4f5",
										"color": "#a1a1aa",
										"cursor": "not-allowed",
										"opacity": 0.75
									},
									"else": {}
								}
							}
						]
					}
				}
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "form-field",
		"variant": "inline",
		"tranche": 1
	}
}
