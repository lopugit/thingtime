{
	"slug": "shadcn-chip-basic",
	"name": "Basic Chip",
	"library": "shadcn",
	"category": "data-display",
	"description": "Plain tag chip in the shadcn/ui style — a soft tone wash by default with a filled toggle, on the library's native chip corners.",
	"tags": [
		"chip",
		"tag",
		"label"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Design",
			"label": "Label",
			"maxLength": 24
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "filled",
			"type": "boolean",
			"default": false,
			"label": "Filled"
		}
	],
	"render": {
		"tag": "span",
		"props": {
			"style": {
				"ttMerge": [
					{
						"display": "inline-flex",
						"alignItems": "center",
						"gap": "6px",
						"height": "32px",
						"padding": "0 12px",
						"borderRadius": "999px",
						"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
						"fontWeight": 500,
						"fontSize": "13px"
					},
					{
						"ttIf": {
							"arg": "filled",
							"then": {
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#18181b",
											"success": "#16a34a",
											"warning": "#f59e0b",
											"danger": "#ef4444",
											"info": "#3b82f6",
											"neutral": "#71717a"
										},
										"default": "#18181b"
									}
								},
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#fafafa",
											"success": "#ffffff",
											"warning": "#ffffff",
											"danger": "#fafafa",
											"info": "#ffffff",
											"neutral": "#ffffff"
										},
										"default": "#fafafa"
									}
								}
							},
							"else": {
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#f4f4f5",
											"success": "#f0fdf4",
											"warning": "#fffbeb",
											"danger": "#fef2f2",
											"info": "#eff6ff",
											"neutral": "#f4f4f5"
										},
										"default": "#f4f4f5"
									}
								},
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#18181b",
											"success": "#15803d",
											"warning": "#b45309",
											"danger": "#b91c1c",
											"info": "#1d4ed8",
											"neutral": "#3f3f46"
										},
										"default": "#18181b"
									}
								}
							}
						}
					}
				]
			}
		},
		"children": [
			"{label}"
		]
	},
	"version": 1,
	"familyKey": "chip-basic",
	"source": {
		"kind": "archetype",
		"archetype": "chip",
		"variant": "basic",
		"tranche": 1
	}
}
