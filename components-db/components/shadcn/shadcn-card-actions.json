{
	"slug": "shadcn-card-actions",
	"name": "Actions Card",
	"library": "shadcn",
	"category": "layout",
	"description": "Card with footer action buttons in the shadcn/ui style — solid confirm beside an outlined cancel, right-aligned above the border.",
	"tags": [
		"card",
		"actions",
		"buttons",
		"footer"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Delete project?",
			"label": "Title",
			"maxLength": 60
		},
		{
			"name": "body",
			"type": "text",
			"default": "This removes the project and its history. Collaborators lose access immediately.",
			"label": "Body"
		},
		{
			"name": "primaryLabel",
			"type": "string",
			"default": "Confirm",
			"label": "Primary label",
			"maxLength": 30
		},
		{
			"name": "secondaryLabel",
			"type": "string",
			"default": "Cancel",
			"label": "Secondary label",
			"maxLength": 30
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "danger",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"width": "300px",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"background": "#ffffff",
				"color": "#09090b",
				"border": "1px solid #e4e4e7",
				"borderRadius": "8px",
				"boxShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
				"overflow": "hidden",
				"boxSizing": "border-box"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"padding": "16px",
						"gap": "8px"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "16px",
								"fontWeight": 600,
								"color": "#09090b"
							}
						},
						"children": [
							"{title}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "13px",
								"color": "#71717a",
								"lineHeight": 1.5
							}
						},
						"children": [
							"{body}"
						]
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "flex-end",
						"gap": "8px",
						"padding": "12px 16px",
						"borderTop": "1px solid #f4f4f5"
					}
				},
				"children": [
					{
						"ttIf": {
							"arg": "secondaryLabel",
							"then": {
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"display": "inline-flex",
										"alignItems": "center",
										"justifyContent": "center",
										"height": "32px",
										"padding": "0 14px",
										"border": "1px solid #e4e4e7",
										"borderRadius": "8px",
										"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
										"fontWeight": 500,
										"fontSize": "13px",
										"cursor": "pointer",
										"background": "transparent",
										"color": "#09090b"
									}
								},
								"children": [
									"{secondaryLabel}"
								]
							}
						}
					},
					{
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"ttMerge": [
									{
										"display": "inline-flex",
										"alignItems": "center",
										"justifyContent": "center",
										"height": "32px",
										"padding": "0 14px",
										"border": "none",
										"borderRadius": "8px",
										"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
										"fontWeight": 500,
										"fontSize": "13px",
										"cursor": "pointer"
									},
									{
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#18181b",
													"success": "#16a34a",
													"warning": "#f59e0b",
													"danger": "#ef4444",
													"info": "#3b82f6",
													"neutral": "#71717a"
												},
												"default": "#18181b"
											}
										},
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#fafafa",
													"success": "#ffffff",
													"warning": "#ffffff",
													"danger": "#fafafa",
													"info": "#ffffff",
													"neutral": "#ffffff"
												},
												"default": "#fafafa"
											}
										}
									}
								]
							}
						},
						"children": [
							"{primaryLabel}"
						]
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "card-actions",
	"source": {
		"kind": "archetype",
		"archetype": "card",
		"variant": "actions",
		"tranche": 1
	}
}
