{
	"slug": "shadcn-dev-tools-diff-stat",
	"name": "Commit Diff Stat",
	"library": "shadcn",
	"category": "developer",
	"description": "Commit row in the shadcn/ui style — monospace short-hash chip, subject line with author and time caption, +/− diff counters in the library's success and danger inks, and a five-square churn strip.",
	"tags": [
		"developer",
		"commit",
		"diff",
		"git",
		"changelog"
	],
	"args": [
		{
			"name": "hash",
			"type": "string",
			"default": "f3a92c1",
			"label": "Short hash",
			"maxLength": 12
		},
		{
			"name": "message",
			"type": "string",
			"default": "Fix flaky pipeline retry logic",
			"label": "Commit message",
			"maxLength": 60
		},
		{
			"name": "author",
			"type": "string",
			"default": "nikolaj",
			"label": "Author",
			"maxLength": 24
		},
		{
			"name": "time",
			"type": "string",
			"default": "2h ago",
			"label": "Time",
			"maxLength": 16
		},
		{
			"name": "added",
			"type": "string",
			"default": "128",
			"label": "Lines added",
			"maxLength": 6
		},
		{
			"name": "removed",
			"type": "string",
			"default": "41",
			"label": "Lines removed",
			"maxLength": 6
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"background": "#ffffff",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "#e4e4e7",
				"borderRadius": "8px",
				"boxShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"display": "flex",
				"alignItems": "center",
				"gap": "12px",
				"padding": "12px 16px",
				"minWidth": "360px"
			}
		},
		"children": [
			{
				"tag": "span",
				"props": {
					"style": {
						"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
						"fontSize": "12px",
						"color": "#09090b",
						"background": "#f4f4f5",
						"padding": "2px 8px",
						"borderRadius": "6px",
						"borderWidth": "1px",
						"borderStyle": "solid",
						"borderColor": "#f4f4f5",
						"flexShrink": 0
					}
				},
				"children": [
					"{hash}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"gap": "2px",
						"flex": 1,
						"minWidth": 0
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "13px",
								"fontWeight": 600,
								"color": "#09090b",
								"whiteSpace": "nowrap",
								"overflow": "hidden",
								"textOverflow": "ellipsis"
							}
						},
						"children": [
							"{message}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "12px",
								"color": "#71717a"
							}
						},
						"children": [
							"{author} · {time}"
						]
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
						"fontSize": "12px",
						"fontWeight": 700,
						"color": "#15803d"
					}
				},
				"children": [
					"+{added}"
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
						"fontSize": "12px",
						"fontWeight": 700,
						"color": "#b91c1c"
					}
				},
				"children": [
					"−{removed}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "2px",
						"flexShrink": 0
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"width": "8px",
								"height": "8px",
								"borderRadius": "2px",
								"background": "#16a34a"
							}
						}
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"width": "8px",
								"height": "8px",
								"borderRadius": "2px",
								"background": "#16a34a"
							}
						}
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"width": "8px",
								"height": "8px",
								"borderRadius": "2px",
								"background": "#16a34a"
							}
						}
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"width": "8px",
								"height": "8px",
								"borderRadius": "2px",
								"background": "#ef4444"
							}
						}
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"width": "8px",
								"height": "8px",
								"borderRadius": "2px",
								"background": "#f4f4f5"
							}
						}
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "dev-tools-diff-stat",
	"source": {
		"kind": "archetype",
		"archetype": "dev-tools",
		"variant": "diff-stat",
		"tranche": 2
	}
}
