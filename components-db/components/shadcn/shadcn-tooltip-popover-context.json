{
	"slug": "shadcn-tooltip-popover-context",
	"name": "Context Menu",
	"library": "shadcn",
	"category": "overlays",
	"description": "Right-click context menu in the shadcn/ui style — edit commands with kbd-style shortcut chips, a separator, and a danger row, all on one elevated panel.",
	"tags": [
		"context-menu",
		"menu",
		"overlay",
		"shortcuts"
	],
	"args": [
		{
			"name": "showShortcuts",
			"type": "boolean",
			"default": true,
			"label": "Show shortcuts"
		},
		{
			"name": "dangerLabel",
			"type": "string",
			"default": "Move to Trash",
			"label": "Danger label",
			"maxLength": 32
		},
		{
			"name": "showDanger",
			"type": "boolean",
			"default": true,
			"label": "Show danger row"
		},
		{
			"name": "dense",
			"type": "boolean",
			"default": false,
			"label": "Dense rows"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "inline-flex",
				"flexDirection": "column",
				"width": "230px",
				"padding": "5px",
				"gap": "1px",
				"background": "#ffffff",
				"border": "1px solid #e4e4e7",
				"borderRadius": "8px",
				"boxShadow": "0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1)",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"fontSize": "13px",
				"color": "#09090b"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "space-between",
						"gap": "24px",
						"padding": {
							"ttIf": {
								"arg": "dense",
								"then": "4px 10px",
								"else": "7px 10px"
							}
						},
						"borderRadius": "6px",
						"cursor": "pointer"
					}
				},
				"children": [
					{
						"tag": "span",
						"children": [
							"Cut"
						]
					},
					{
						"ttIf": {
							"arg": "showShortcuts",
							"then": {
								"tag": "span",
								"props": {
									"style": {
										"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
										"fontSize": "12px",
										"color": "#71717a",
										"background": "#f4f4f5",
										"border": "1px solid #f4f4f5",
										"borderRadius": "6px",
										"padding": "1px 5px"
									}
								},
								"children": [
									"⌘X"
								]
							}
						}
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "space-between",
						"gap": "24px",
						"padding": {
							"ttIf": {
								"arg": "dense",
								"then": "4px 10px",
