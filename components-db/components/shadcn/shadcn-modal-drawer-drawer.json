{
	"slug": "shadcn-modal-drawer-drawer",
	"name": "Side Drawer",
	"library": "shadcn",
	"category": "overlays",
	"description": "Right-side drawer panel over a dimmed backdrop in the shadcn/ui style — flush to the edge with rounded inner corners, a titled header, and a tone-highlighted menu.",
	"tags": [
		"drawer",
		"panel",
		"overlay",
		"navigation"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Workspace settings",
			"label": "Title",
			"maxLength": 40
		},
		{
			"name": "item",
			"type": "string",
			"default": "Menu item",
			"label": "Item label",
			"maxLength": 40
		},
		{
			"name": "items",
			"type": "number",
			"default": 4,
			"label": "Items",
			"min": 1,
			"max": 6
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"width": "340px",
				"minHeight": "300px",
				"boxSizing": "border-box",
				"background": "rgba(12, 12, 16, 0.45)",
				"borderRadius": "8px",
				"overflow": "hidden",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"justifyContent": "flex-end",
				"alignItems": "stretch"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"background": "#ffffff",
						"color": "#09090b",
						"borderRadius": "12px 0 0 12px",
						"boxShadow": "0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1)",
						"display": "flex",
						"flexDirection": "column",
						"overflow": "hidden",
						"width": "224px"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"justifyContent": "space-between",
								"gap": "8px",
								"padding": "16px 12px 12px 16px"
							}
						},
						"children": [
							{
								"tag": "h3",
								"props": {
									"style": {
										"margin": 0,
										"fontSize": "14px",
										"fontWeight": 600
									}
								},
								"children": [
									"{title}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "none",
										"background": "transparent",
										"color": "#a1a1aa",
										"cursor": "pointer",
										"padding": "4px",
										"display": "inline-flex",
										"alignItems": "center",
										"justifyContent": "center",
										"borderRadius": "8px",
										"flexShrink": 0
									}
								},
								"children": [
									{
										"tag": "svg",
										"props": {
											"width": 16,
											"height": 16,
											"viewBox": "0 0 24 24",
											"fill": "none",
											"stroke": "currentColor",
											"strokeWidth": 2,
											"strokeLinecap": "round",
											"strokeLinejoin": "round",
											"xmlns": "http://www.w3.org/2000/svg"
										},
										"children": [
											{
												"tag": "line",
												"props": {
													"x1": 18,
													"y1": 6,
													"x2": 6,
													"y2": 18
												}
											},
											{
												"tag": "line",
												"props": {
													"x1": 6,
													"y1": 6,
													"x2": 18,
													"y2": 18
												}
											}
										]
									}
								]
							}
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"height": "1px",
								"background": "#f4f4f5",
								"margin": "0 0 8px",
								"flexShrink": 0
							}
						}
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"flexDirection": "column",
								"gap": "2px",
								"padding": "0 8px"
							}
						},
						"children": [
							{
								"ttRepeat": {
									"arg": "items",
									"max": 6,
									"node": {
										"tag": "div",
										"props": {
											"style": {
												"ttMerge": [
													{
														"display": "flex",
														"alignItems": "center",
														"gap": "10px",
														"padding": "8px 10px",
														"borderRadius": "8px",
														"fontSize": "13px"
													},
													{
														"ttIf": {
															"arg": "n",
															"equals": 1,
															"then": {
																"background": {
																	"ttMap": {
																		"arg": "tone",
																		"values": {
																			"primary": "#f4f4f5",
																			"success": "#f0fdf4",
																			"warning": "#fffbeb",
																			"danger": "#fef2f2",
																			"info": "#eff6ff",
																			"neutral": "#f4f4f5"
																		},
																		"default": "#f4f4f5"
																	}
																},
																"color": {
																	"ttMap": {
																		"arg": "tone",
																		"values": {
																			"primary": "#18181b",
																			"success": "#15803d",
																			"warning": "#b45309",
																			"danger": "#b91c1c",
																			"info": "#1d4ed8",
																			"neutral": "#3f3f46"
																		},
																		"default": "#18181b"
																	}
																},
																"fontWeight": 600
															},
															"else": {
																"color": "#71717a"
															}
														}
													}
												]
											}
										},
										"children": [
											{
												"tag": "svg",
												"props": {
													"width": 15,
													"height": 15,
													"viewBox": "0 0 24 24",
													"fill": "none",
													"stroke": "currentColor",
													"strokeWidth": 2,
													"strokeLinecap": "round",
													"strokeLinejoin": "round",
													"xmlns": "http://www.w3.org/2000/svg"
												},
												"children": [
													{
														"tag": "path",
														"props": {
															"d": "M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"
														}
													}
												]
											},
											"{item} {n}"
										]
									}
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "modal-drawer",
		"variant": "drawer",
		"tranche": 1
	}
}
