{
	"slug": "shadcn-banking-balance",
	"name": "Balance Card",
	"library": "shadcn",
	"category": "finance",
	"description": "Account balance card in the shadcn/ui style — total-balance caption over a large figure, a trend chip that flips success/danger with direction, masked account line and ghost Send / Top up actions.",
	"tags": [
		"banking",
		"balance",
		"finance",
		"card"
	],
	"args": [
		{
			"name": "amount",
			"type": "string",
			"default": "$24,562.80",
			"label": "Amount",
			"maxLength": 16
		},
		{
			"name": "change",
			"type": "string",
			"default": "4.2",
			"label": "Change %",
			"maxLength": 8
		},
		{
			"name": "up",
			"type": "boolean",
			"default": true,
			"label": "Trending up"
		},
		{
			"name": "mask",
			"type": "string",
			"default": "4821",
			"label": "Account last 4",
			"maxLength": 6
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"boxSizing": "border-box",
				"width": "320px",
				"padding": "20px",
				"background": "#ffffff",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "#e4e4e7",
				"borderRadius": "12px",
				"boxShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"color": "#09090b",
				"gap": "8px"
			}
		},
		"children": [
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "12px",
						"fontWeight": 500,
						"color": "#71717a"
					}
				},
				"children": [
					"Total balance"
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "28px",
						"fontWeight": 600,
						"lineHeight": 1.1,
						"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
						"color": "#09090b"
					}
				},
				"children": [
					"{amount}"
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"ttMerge": [
							{
								"display": "inline-flex",
								"alignItems": "center",
								"alignSelf": "flex-start",
								"padding": "3px 10px",
								"borderRadius": "999px",
								"fontSize": "12px",
								"fontWeight": 600
							},
							{
								"ttIf": {
									"arg": "up",
									"then": {
										"background": "#f0fdf4",
										"color": "#15803d"
									},
									"else": {
										"background": "#fef2f2",
										"color": "#b91c1c"
									}
								}
							}
						]
					}
				},
				"children": [
					{
						"ttIf": {
							"arg": "up",
							"then": "+{change}% this month",
							"else": "-{change}% this month"
						}
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "13px",
						"color": "#71717a",
						"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
					}
				},
				"children": [
					"•••• {mask}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "8px",
						"marginTop": "6px"
					}
				},
				"children": [
					{
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"display": "inline-flex",
								"alignItems": "center",
								"justifyContent": "center",
								"flex": 1,
								"height": "32px",
								"padding": "0 12px",
								"border": "none",
								"background": "transparent",
								"borderRadius": "8px",
								"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
								"fontWeight": 500,
								"fontSize": "13px",
								"color": "#18181b",
								"cursor": "pointer"
							}
						},
						"children": [
							"Send"
						]
					},
					{
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"display": "inline-flex",
								"alignItems": "center",
								"justifyContent": "center",
								"flex": 1,
								"height": "32px",
								"padding": "0 12px",
								"border": "none",
								"background": "transparent",
								"borderRadius": "8px",
								"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
								"fontWeight": 500,
								"fontSize": "13px",
								"color": "#18181b",
								"cursor": "pointer"
							}
						},
						"children": [
							"Top up"
						]
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "banking-balance",
	"source": {
		"kind": "archetype",
		"archetype": "banking",
		"variant": "balance",
		"tranche": 2
	}
}
