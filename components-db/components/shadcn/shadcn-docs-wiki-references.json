{
	"slug": "shadcn-docs-wiki-references",
	"name": "Doc References",
	"library": "shadcn",
	"category": "documentation",
	"description": "Footnote reference block in the shadcn/ui style — mono REFERENCES kicker over numbered link-colored citations with source captions, closed by a back-to-article chip.",
	"tags": [
		"docs",
		"references",
		"footnote",
		"citation"
	],
	"args": [
		{
			"name": "refTitle",
			"type": "string",
			"default": "Structured docs at scale",
			"label": "First title",
			"maxLength": 60
		},
		{
			"name": "refSource",
			"type": "string",
			"default": "writethedocs.org",
			"label": "First source",
			"maxLength": 40
		},
		{
			"name": "count",
			"type": "number",
			"default": 3,
			"label": "References",
			"min": 2,
			"max": 3
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"background": "#ffffff",
				"border": "1px solid #f4f4f5",
				"borderRadius": "12px",
				"padding": "16px",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"gap": "10px",
				"minWidth": "300px",
				"maxWidth": "420px"
			}
		},
		"children": [
			{
				"tag": "span",
				"props": {
					"style": {
						"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
						"fontSize": "12px",
						"fontWeight": 600,
						"letterSpacing": "0.08em",
						"color": "#a1a1aa"
					}
				},
				"children": [
					"REFERENCES"
				]
			},
			{
				"ttRepeat": {
					"arg": "count",
					"max": 3,
					"node": {
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "flex-start",
								"gap": "10px"
							}
						},
						"children": [
							{
								"tag": "span",
								"props": {
									"style": {
										"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
										"fontSize": "12px",
										"color": "#a1a1aa",
										"paddingTop": "2px",
										"flexShrink": 0
									}
								},
								"children": [
									"[{n}]"
								]
							},
							{
								"tag": "div",
								"props": {
									"style": {
										"display": "flex",
										"flexDirection": "column",
										"gap": "2px"
									}
								},
								"children": [
									{
										"tag": "span",
										"props": {
											"style": {
												"fontSize": "13px",
												"fontWeight": 500,
												"color": "#3b82f6"
											}
										},
										"children": [
											{
												"ttMap": {
													"arg": "n",
													"values": {
														"1": "{refTitle}",
														"2": "HTTP caching primer",
														"3": "Semantic line breaks"
													},
													"default": "{refTitle}"
												}
											}
										]
									},
									{
										"tag": "span",
										"props": {
											"style": {
												"fontSize": "12px",
												"color": "#71717a"
											}
										},
										"children": [
											{
												"ttMap": {
													"arg": "n",
													"values": {
														"1": "{refSource}",
														"2": "developer.mozilla.org",
														"3": "sembr.org"
													},
													"default": "{refSource}"
												}
											}
										]
									}
								]
							}
						]
					}
				}
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"display": "inline-flex",
						"alignItems": "center",
						"gap": "6px",
						"alignSelf": "flex-start",
						"padding": "3px 10px",
						"borderRadius": "999px",
						"background": "#f4f4f5",
						"border": "1px solid #e4e4e7",
						"fontSize": "12px",
						"fontWeight": 500,
						"color": "#71717a",
						"boxShadow": "none"
					}
				},
				"children": [
					{
						"tag": "svg",
						"props": {
							"width": 12,
							"height": 12,
							"viewBox": "0 0 24 24",
							"fill": "none",
							"stroke": "currentColor",
							"strokeWidth": 2,
							"strokeLinecap": "round",
							"strokeLinejoin": "round",
							"xmlns": "http://www.w3.org/2000/svg"
						},
						"children": [
							{
								"tag": "line",
								"props": {
									"x1": 12,
									"y1": 19,
									"x2": 12,
									"y2": 5
								}
							},
							{
								"tag": "polyline",
								"props": {
									"points": "5 12 12 5 19 12"
								}
							}
						]
					},
					"Back to article"
				]
			}
		]
	},
	"version": 1,
	"familyKey": "docs-wiki-references",
	"source": {
		"kind": "archetype",
		"archetype": "docs-wiki",
		"variant": "references",
		"tranche": 2
	}
}
