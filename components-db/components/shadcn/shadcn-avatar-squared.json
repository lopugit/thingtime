{
	"slug": "shadcn-avatar-squared",
	"name": "Squared Avatar",
	"library": "shadcn",
	"category": "data-display",
	"description": "Rounded-square initials avatar in the shadcn/ui style — the library's own corner radius on a tone-filled tile, with an optional soft tint.",
	"tags": [
		"avatar",
		"squared",
		"initials",
		"tile"
	],
	"args": [
		{
			"name": "initials",
			"type": "string",
			"default": "TT",
			"label": "Initials",
			"maxLength": 3
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "size",
			"type": "enum",
			"values": [
				"sm",
				"md",
				"lg"
			],
			"default": "md",
			"label": "Size"
		},
		{
			"name": "soft",
			"type": "boolean",
			"default": false,
			"label": "Soft tint"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"ttMerge": [
					{
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "center",
						"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
						"fontWeight": 600,
						"borderRadius": "8px",
						"flexShrink": 0,
						"userSelect": "none"
					},
					{
						"ttMap": {
							"arg": "size",
							"values": {
								"sm": {
									"width": "28px",
									"height": "28px",
									"fontSize": "12px"
								},
								"md": {
									"width": "40px",
									"height": "40px",
									"fontSize": "13px"
								},
								"lg": {
									"width": "56px",
									"height": "56px",
									"fontSize": "16px"
								}
							},
							"default": {
								"width": "40px",
								"height": "40px",
								"fontSize": "13px"
							}
						}
					},
					{
						"ttIf": {
							"arg": "soft",
							"then": {
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#f4f4f5",
											"success": "#f0fdf4",
											"warning": "#fffbeb",
											"danger": "#fef2f2",
											"info": "#eff6ff",
											"neutral": "#f4f4f5"
										},
										"default": "#f4f4f5"
									}
								},
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#18181b",
											"success": "#15803d",
											"warning": "#b45309",
											"danger": "#b91c1c",
											"info": "#1d4ed8",
											"neutral": "#3f3f46"
										},
										"default": "#18181b"
									}
								},
								"border": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "1px solid #e4e4e7",
											"success": "1px solid #bbf7d0",
											"warning": "1px solid #fde68a",
											"danger": "1px solid #fecaca",
											"info": "1px solid #bfdbfe",
											"neutral": "1px solid #e4e4e7"
										},
										"default": "1px solid #e4e4e7"
									}
								}
							},
							"else": {
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#18181b",
											"success": "#16a34a",
											"warning": "#f59e0b",
											"danger": "#ef4444",
											"info": "#3b82f6",
											"neutral": "#71717a"
										},
										"default": "#18181b"
									}
								},
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#fafafa",
											"success": "#ffffff",
											"warning": "#ffffff",
											"danger": "#fafafa",
											"info": "#ffffff",
											"neutral": "#ffffff"
										},
										"default": "#fafafa"
									}
								}
							}
						}
					}
				]
			}
		},
		"children": [
			"{initials}"
		]
	},
	"version": 1,
	"familyKey": "avatar-squared",
	"source": {
		"kind": "archetype",
		"archetype": "avatar",
		"variant": "squared",
		"tranche": 1
	}
}
