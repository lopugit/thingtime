{
	"slug": "shadcn-button-solid",
	"name": "Solid Button",
	"library": "shadcn",
	"category": "buttons",
	"description": "Filled primary action button in the shadcn/ui style — solid tone background, library-native radius and type.",
	"tags": [
		"button",
		"action",
		"solid"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Get started",
			"label": "Label",
			"maxLength": 40
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "size",
			"type": "enum",
			"values": [
				"sm",
				"md",
				"lg"
			],
			"default": "md",
			"label": "Size"
		},
		{
			"name": "disabled",
			"type": "boolean",
			"default": false,
			"label": "Disabled"
		}
	],
	"render": {
		"tag": "button",
		"props": {
			"type": "button",
			"style": {
				"ttMerge": [
					{
						"display": "inline-flex",
						"alignItems": "center",
						"justifyContent": "center",
						"gap": "8px",
						"border": "none",
						"borderRadius": "8px",
						"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
						"fontWeight": 500,
						"cursor": "pointer"
					},
					{
						"ttMap": {
							"arg": "size",
							"values": {
								"sm": {
									"height": "32px",
									"padding": "0 12px",
									"fontSize": "13px"
								},
								"md": {
									"height": "36px",
									"padding": "0 16px",
									"fontSize": "14px"
								},
								"lg": {
									"height": "40px",
									"padding": "0 20px",
									"fontSize": "16px"
								}
							},
							"default": {
								"height": "36px",
								"padding": "0 16px",
								"fontSize": "14px"
							}
						}
					},
					{
						"background": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#18181b",
									"success": "#16a34a",
									"warning": "#f59e0b",
									"danger": "#ef4444",
									"info": "#3b82f6",
									"neutral": "#71717a"
								},
								"default": "#18181b"
							}
						},
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#fafafa",
									"success": "#ffffff",
									"warning": "#ffffff",
									"danger": "#fafafa",
									"info": "#ffffff",
									"neutral": "#ffffff"
								},
								"default": "#fafafa"
							}
						},
						"boxShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.05)"
					},
					{
						"ttIf": {
							"arg": "disabled",
							"then": {
								"opacity": 0.5,
								"cursor": "not-allowed"
							},
							"else": {}
						}
					}
				]
			}
		},
		"children": [
			"{label}"
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "button",
		"variant": "solid",
		"tranche": 1
	}
}
