{
	"slug": "shadcn-loading-skeleton-text",
	"name": "Skeleton Text",
	"library": "shadcn",
	"category": "feedback",
	"description": "Skeleton paragraph placeholder in the shadcn/ui style — grey bars of varying widths standing in for text lines while content loads.",
	"tags": [
		"loading",
		"skeleton",
		"placeholder",
		"text"
	],
	"args": [
		{
			"name": "lines",
			"type": "number",
			"default": 3,
			"label": "Lines",
			"min": 1,
			"max": 6
		},
		{
			"name": "size",
			"type": "enum",
			"values": [
				"sm",
				"md",
				"lg"
			],
			"default": "md",
			"label": "Line height"
		},
		{
			"name": "rounded",
			"type": "boolean",
			"default": true,
			"label": "Rounded"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"gap": "10px",
				"width": "240px"
			}
		},
		"children": [
			{
				"ttRepeat": {
					"arg": "lines",
					"max": 6,
					"node": {
						"tag": "div",
						"props": {
							"style": {
								"height": {
									"ttMap": {
										"arg": "size",
										"values": {
											"sm": "8px",
											"md": "10px",
											"lg": "14px"
										},
										"default": "10px"
									}
								},
								"borderRadius": {
									"ttIf": {
										"arg": "rounded",
										"then": "999px",
										"else": "6px"
									}
								},
								"background": "#f4f4f5",
								"width": {
									"ttMap": {
										"arg": "n",
										"values": {
											"1": "100%",
											"2": "92%",
											"3": "61%",
											"4": "87%",
											"5": "74%",
											"6": "48%"
										},
										"default": "80%"
									}
								}
							}
						}
					}
				}
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "loading",
		"variant": "skeleton-text",
		"tranche": 1
	}
}
