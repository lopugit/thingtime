{
	"slug": "shadcn-table-compact",
	"name": "Compact Table",
	"library": "shadcn",
	"category": "data-display",
	"description": "Dense compact table in the shadcn/ui style — tight paddings, small monospace ids, and an adjustable repeated row count.",
	"tags": [
		"table",
		"compact",
		"dense",
		"data"
	],
	"args": [
		{
			"name": "col1",
			"type": "string",
			"default": "ID",
			"label": "Column 1",
			"maxLength": 24
		},
		{
			"name": "col2",
			"type": "string",
			"default": "Description",
			"label": "Column 2",
			"maxLength": 24
		},
		{
			"name": "col3",
			"type": "string",
			"default": "Slot",
			"label": "Column 3",
			"maxLength": 24
		},
		{
			"name": "rows",
			"type": "number",
			"default": 6,
			"label": "Rows",
			"min": 1,
			"max": 10
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"width": "100%",
				"overflow": "hidden",
				"boxSizing": "border-box",
				"background": "#ffffff",
				"border": "1px solid #e4e4e7",
				"borderRadius": "8px",
				"boxShadow": "none",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
			}
		},
		"children": [
			{
				"tag": "table",
				"props": {
					"style": {
						"width": "100%",
						"borderCollapse": "collapse",
						"fontSize": "13px",
						"color": "#09090b"
					}
				},
				"children": [
					{
						"tag": "thead",
						"children": [
							{
								"tag": "tr",
								"children": [
									{
										"tag": "th",
										"props": {
											"style": {
												"textAlign": "left",
												"padding": "7px 10px",
												"fontSize": "12px",
												"fontWeight": 600,
												"color": "#71717a",
												"background": "transparent",
												"borderBottom": "1px solid #e4e4e7"
											}
										},
										"children": [
											"{col1}"
										]
									},
									{
										"tag": "th",
										"props": {
											"style": {
												"textAlign": "left",
												"padding": "7px 10px",
												"fontSize": "12px",
												"fontWeight": 600,
												"color": "#71717a",
												"background": "transparent",
												"borderBottom": "1px solid #e4e4e7"
											}
										},
										"children": [
											"{col2}"
										]
									},
									{
										"tag": "th",
										"props": {
											"style": {
												"textAlign": "left",
												"padding": "7px 10px",
												"fontSize": "12px",
												"fontWeight": 600,
												"color": "#71717a",
												"background": "transparent",
												"borderBottom": "1px solid #e4e4e7"
											}
										},
										"children": [
											"{col3}"
										]
									}
								]
							}
						]
					},
					{
						"tag": "tbody",
						"children": [
							{
								"ttRepeat": {
									"arg": "rows",
									"max": 10,
									"node": {
										"tag": "tr",
										"children": [
											{
												"tag": "td",
												"props": {
													"style": {
														"padding": "5px 10px",
														"borderBottom": "1px solid #f4f4f5",
														"color": "#71717a",
														"fontSize": "12px",
														"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
													}
												},
												"children": [
													"#10{n}"
												]
											},
											{
												"tag": "td",
												"props": {
													"style": {
														"padding": "5px 10px",
														"borderBottom": "1px solid #f4f4f5",
														"color": "#09090b",
														"fontSize": "13px"
													}
												},
												"children": [
													"Queued job {n}"
												]
											},
											{
												"tag": "td",
												"props": {
													"style": {
														"padding": "5px 10px",
														"borderBottom": "1px solid #f4f4f5",
														"color": "#71717a",
														"fontSize": "13px"
													}
												},
												"children": [
													"{n} of {rows}"
												]
											}
										]
									}
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "table-compact",
	"source": {
		"kind": "archetype",
		"archetype": "table",
		"variant": "compact",
		"tranche": 1
	}
}
