{
	"slug": "shadcn-card-elevated",
	"name": "Elevated Card",
	"library": "shadcn",
	"category": "layout",
	"description": "Floating borderless card in the shadcn/ui style — the library's deeper shadow tiers lift it off the page, led by a tone-tinted icon chip.",
	"tags": [
		"card",
		"elevated",
		"shadow",
		"floating"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Quick insight",
			"label": "Title",
			"maxLength": 60
		},
		{
			"name": "body",
			"type": "text",
			"default": "Elevation carries the hierarchy here — the card floats free of any border.",
			"label": "Body"
		},
		{
			"name": "elevation",
			"type": "enum",
			"values": [
				"raised",
				"floating"
			],
			"default": "floating",
			"label": "Elevation"
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"width": "300px",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"background": "#ffffff",
				"color": "#09090b",
				"border": "none",
				"borderRadius": "8px",
				"boxShadow": {
					"ttMap": {
						"arg": "elevation",
						"values": {
							"raised": "0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px -1px rgba(0, 0, 0, 0.1)",
							"floating": "0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1)"
						},
						"default": "0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1)"
					}
				},
				"overflow": "hidden",
				"boxSizing": "border-box",
				"padding": "16px",
				"gap": "10px"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "10px"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"width": "32px",
								"height": "32px",
								"borderRadius": "8px",
								"display": "flex",
								"alignItems": "center",
								"justifyContent": "center",
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#f4f4f5",
											"success": "#f0fdf4",
											"warning": "#fffbeb",
											"danger": "#fef2f2",
											"info": "#eff6ff",
											"neutral": "#f4f4f5"
										},
										"default": "#f4f4f5"
									}
								},
								"flexShrink": 0
							}
						},
						"children": [
							{
								"tag": "svg",
								"props": {
									"width": 16,
									"height": 16,
									"viewBox": "0 0 24 24",
									"fill": "none",
									"stroke": {
										"ttMap": {
											"arg": "tone",
											"values": {
												"primary": "#18181b",
												"success": "#15803d",
												"warning": "#b45309",
												"danger": "#b91c1c",
												"info": "#1d4ed8",
												"neutral": "#3f3f46"
											},
											"default": "#18181b"
										}
									},
									"strokeWidth": 2,
									"strokeLinecap": "round",
									"strokeLinejoin": "round",
									"xmlns": "http://www.w3.org/2000/svg"
								},
								"children": [
									{
										"tag": "polygon",
										"props": {
											"points": "13 2 3 14 12 14 11 22 21 10 12 10 13 2"
										}
									}
								]
							}
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "16px",
								"fontWeight": 600,
								"color": "#09090b"
							}
						},
						"children": [
							"{title}"
						]
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "13px",
						"color": "#71717a",
						"lineHeight": 1.5
					}
				},
				"children": [
					"{body}"
				]
			}
		]
	},
	"version": 1,
	"familyKey": "card-elevated",
	"source": {
		"kind": "archetype",
		"archetype": "card",
		"variant": "elevated",
		"tranche": 1
	}
}
