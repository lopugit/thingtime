{
	"slug": "shadcn-badge-pill-count",
	"name": "Count Badge",
	"library": "shadcn",
	"category": "data-display",
	"description": "Label with a count pill in the shadcn/ui style — a muted label beside a solid tone pill carrying the number, for inbox and tab counters.",
	"tags": [
		"badge",
		"count",
		"pill",
		"notification"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Inbox",
			"label": "Label",
			"maxLength": 24
		},
		{
			"name": "count",
			"type": "string",
			"default": "24",
			"label": "Count",
			"maxLength": 6
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "inline-flex",
				"alignItems": "center",
				"gap": "8px",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
			}
		},
		"children": [
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "13px",
						"fontWeight": 500,
						"color": "#09090b"
					}
				},
				"children": [
					"{label}"
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"display": "inline-flex",
						"alignItems": "center",
						"justifyContent": "center",
						"minWidth": "20px",
						"height": "20px",
						"padding": "0 6px",
						"boxSizing": "border-box",
						"borderRadius": "999px",
						"background": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#18181b",
									"success": "#16a34a",
									"warning": "#f59e0b",
									"danger": "#ef4444",
									"info": "#3b82f6",
									"neutral": "#71717a"
								},
								"default": "#18181b"
							}
						},
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#fafafa",
									"success": "#ffffff",
									"warning": "#ffffff",
									"danger": "#fafafa",
									"info": "#ffffff",
									"neutral": "#ffffff"
								},
								"default": "#fafafa"
							}
						},
						"fontSize": "12px",
						"fontWeight": 700
					}
				},
				"children": [
					"{count}"
				]
			}
		]
	},
	"version": 1,
	"familyKey": "badge-pill-count",
	"source": {
		"kind": "archetype",
		"archetype": "badge",
		"variant": "pill-count",
		"tranche": 1
	}
}
