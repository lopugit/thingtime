{
	"slug": "shadcn-choice-controls-switch",
	"name": "Switch",
	"library": "shadcn",
	"category": "forms",
	"description": "On/off switch with label in the shadcn/ui style — the boolean slides the knob across the pill track.",
	"tags": [
		"form",
		"switch",
		"toggle",
		"boolean"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Enable notifications",
			"label": "Label",
			"maxLength": 50
		},
		{
			"name": "on",
			"type": "boolean",
			"default": true,
			"label": "On"
		},
		{
			"name": "size",
			"type": "enum",
			"values": [
				"sm",
				"md"
			],
			"default": "md",
			"label": "Size"
		},
		{
			"name": "disabled",
			"type": "boolean",
			"default": false,
			"label": "Disabled"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"alignItems": "center",
				"gap": "10px",
				"cursor": "pointer",
				"opacity": {
					"ttIf": {
						"arg": "disabled",
						"then": 0.5,
						"else": 1
					}
				}
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"ttMerge": [
							{
								"ttMap": {
									"arg": "size",
									"values": {
										"sm": {
											"width": "34px",
											"height": "18px"
										},
										"md": {
											"width": "44px",
											"height": "24px"
										}
									},
									"default": {
										"width": "44px",
										"height": "24px"
									}
								}
							},
							{
								"borderRadius": "999px",
								"padding": "2px",
								"display": "flex",
								"alignItems": "center",
								"justifyContent": {
									"ttIf": {
										"arg": "on",
										"then": "flex-end",
										"else": "flex-start"
									}
								},
								"background": {
									"ttIf": {
										"arg": "on",
										"then": "#18181b",
										"else": "#a1a1aa"
									}
								},
								"flexShrink": 0,
								"boxSizing": "border-box"
							}
						]
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"ttMerge": [
									{
										"ttMap": {
											"arg": "size",
											"values": {
												"sm": {
													"width": "14px",
													"height": "14px"
												},
												"md": {
													"width": "20px",
													"height": "20px"
												}
											},
											"default": {
												"width": "20px",
												"height": "20px"
											}
										}
									},
									{
										"borderRadius": "999px",
										"background": "#ffffff",
										"boxShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.05)"
									}
								]
							}
						}
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
						"fontSize": "14px",
						"color": "#09090b"
					}
				},
				"children": [
					"{label}"
				]
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "choice-controls",
		"variant": "switch",
		"tranche": 1
	}
}
