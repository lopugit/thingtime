{
	"slug": "shadcn-kanban-column",
	"name": "Kanban Column",
	"library": "shadcn",
	"category": "project",
	"description": "Board column in the shadcn/ui style — header with a tone count pill and kebab menu, stacked mini cards, and a dashed add-card footer row.",
	"tags": [
		"kanban",
		"column",
		"board",
		"project"
	],
	"args": [
		{
			"name": "name",
			"type": "string",
			"default": "In progress",
			"label": "Column name",
			"maxLength": 24
		},
		{
			"name": "cards",
			"type": "number",
			"default": 3,
			"label": "Cards",
			"min": 1,
			"max": 4
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
