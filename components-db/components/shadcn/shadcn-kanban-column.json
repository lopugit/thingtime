											"danger": "#fef2f2",
											"info": "#eff6ff",
											"neutral": "#f4f4f5"
										},
										"default": "#f4f4f5"
									}
								},
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#18181b",
											"success": "#15803d",
											"warning": "#b45309",
											"danger": "#b91c1c",
