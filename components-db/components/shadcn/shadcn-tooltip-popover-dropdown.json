{
	"slug": "shadcn-tooltip-popover-dropdown",
	"name": "Dropdown Menu",
	"library": "shadcn",
	"category": "overlays",
	"description": "Dropdown menu in the shadcn/ui style — chevron trigger over an elevated panel of rows with optional leading icons, a separator, and a danger row at the bottom.",
	"tags": [
		"dropdown",
		"menu",
		"overlay",
		"actions"
	],
	"args": [
		{
			"name": "triggerLabel",
			"type": "string",
			"default": "Options",
			"label": "Trigger label",
			"maxLength": 24
		},
		{
			"name": "items",
			"type": "number",
			"default": 3,
			"label": "Menu items",
			"min": 1,
			"max": 6
		},
		{
			"name": "dangerLabel",
			"type": "string",
			"default": "Delete project",
			"label": "Danger label",
			"maxLength": 32
		},
		{
			"name": "showIcons",
			"type": "boolean",
			"default": true,
			"label": "Show icons"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "inline-flex",
				"flexDirection": "column",
				"alignItems": "flex-start",
				"gap": "4px",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
			}
		},
		"children": [
			{
				"tag": "button",
				"props": {
					"type": "button",
					"style": {
						"display": "inline-flex",
						"alignItems": "center",
						"justifyContent": "center",
						"gap": "6px",
						"height": "36px",
						"padding": "0 14px",
						"background": "#ffffff",
						"color": "#09090b",
						"border": "1px solid #e4e4e7",
						"borderRadius": "8px",
						"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
						"fontSize": "13px",
						"fontWeight": 500,
						"boxShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
						"cursor": "pointer"
					}
				},
				"children": [
					"{triggerLabel}",
					{
						"tag": "svg",
						"props": {
							"width": 14,
							"height": 14,
							"viewBox": "0 0 24 24",
							"fill": "none",
							"stroke": "currentColor",
							"strokeWidth": 2,
							"strokeLinecap": "round",
							"strokeLinejoin": "round",
							"xmlns": "http://www.w3.org/2000/svg"
						},
						"children": [
							{
								"tag": "polyline",
								"props": {
									"points": "6 9 12 15 18 9"
								}
							}
						]
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"width": "210px",
						"padding": "5px",
						"gap": "1px",
						"background": "#ffffff",
						"border": "1px solid #e4e4e7",
						"borderRadius": "8px",
						"boxShadow": "0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1)",
						"fontSize": "13px",
						"color": "#09090b"
					}
				},
				"children": [
					{
						"ttRepeat": {
							"arg": "items",
							"max": 6,
							"node": {
								"tag": "div",
								"props": {
									"style": {
										"display": "flex",
										"alignItems": "center",
										"gap": "8px",
										"padding": "7px 10px",
										"borderRadius": "6px",
										"background": {
											"ttIf": {
												"arg": "index",
												"equals": 0,
												"then": "#f4f4f5",
												"else": "transparent"
											}
										},
										"cursor": "pointer"
									}
								},
								"children": [
									{
										"ttIf": {
											"arg": "showIcons",
											"then": {
												"tag": "span",
												"props": {
													"style": {
														"display": "inline-flex",
														"color": "#71717a"
													}
												},
												"children": [
													{
														"tag": "svg",
														"props": {
															"width": 14,
															"height": 14,
															"viewBox": "0 0 24 24",
															"fill": "none",
															"stroke": "currentColor",
															"strokeWidth": 2,
															"strokeLinecap": "round",
															"strokeLinejoin": "round",
															"xmlns": "http://www.w3.org/2000/svg"
														},
														"children": [
															{
																"tag": "path",
																"props": {
																	"d": "M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"
																}
															},
															{
																"tag": "polyline",
																"props": {
																	"points": "13 2 13 9 20 9"
																}
															}
														]
													}
												]
											}
										}
									},
									"Menu item {n}"
								]
							}
						}
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"borderTop": "1px solid #f4f4f5",
								"margin": "4px 2px"
							}
						}
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"gap": "8px",
								"padding": "7px 10px",
								"borderRadius": "6px",
								"color": "#ef4444",
								"cursor": "pointer"
							}
						},
						"children": [
							{
								"ttIf": {
									"arg": "showIcons",
									"then": {
										"tag": "span",
										"props": {
											"style": {
												"display": "inline-flex"
											}
										},
										"children": [
											{
												"tag": "svg",
												"props": {
													"width": 14,
													"height": 14,
													"viewBox": "0 0 24 24",
													"fill": "none",
													"stroke": "currentColor",
													"strokeWidth": 2,
													"strokeLinecap": "round",
													"strokeLinejoin": "round",
													"xmlns": "http://www.w3.org/2000/svg"
												},
												"children": [
													{
														"tag": "polyline",
														"props": {
															"points": "3 6 5 6 21 6"
														}
													},
													{
														"tag": "path",
														"props": {
															"d": "M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"
														}
													}
												]
											}
										]
									}
								}
							},
							"{dangerLabel}"
						]
					}
				]
			}
		]
	},
	"previewBg": "#fafafa",
	"version": 1,
	"familyKey": "tooltip-popover-dropdown",
	"source": {
		"kind": "archetype",
		"archetype": "tooltip-popover",
		"variant": "dropdown",
		"tranche": 1
	}
}
