{
	"slug": "shadcn-mail-inbox-row",
	"name": "Inbox Row",
	"library": "shadcn",
	"category": "communication",
	"description": "Mail list row in the shadcn/ui style — unread dot and bold sender on a fresh message, subject with muted snippet on one ellipsized line, time and star on the right.",
	"tags": [
		"mail",
		"inbox",
		"list",
		"row",
		"email"
	],
	"args": [
		{
			"name": "unread",
			"type": "boolean",
			"default": true,
			"label": "Unread"
		},
		{
			"name": "sender",
			"type": "string",
			"default": "Ada Lovelace",
			"label": "Sender",
			"maxLength": 32
		},
		{
			"name": "subject",
			"type": "string",
			"default": "Q3 forecast review",
			"label": "Subject",
			"maxLength": 48
		},
		{
			"name": "snippet",
			"type": "string",
			"default": "Sharing the updated numbers ahead of tomorrow",
			"label": "Snippet",
			"maxLength": 80
		},
		{
			"name": "time",
			"type": "string",
			"default": "9:41 AM",
			"label": "Time",
			"maxLength": 12
		},
		{
			"name": "starred",
			"type": "boolean",
			"default": false,
			"label": "Starred"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"alignItems": "center",
				"gap": "10px",
				"width": "100%",
				"maxWidth": "560px",
				"boxSizing": "border-box",
				"padding": "10px 14px",
				"background": {
					"ttIf": {
						"arg": "unread",
						"then": "#ffffff",
						"else": "#f4f4f5"
					}
				},
				"borderBottom": "1px solid #f4f4f5",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
			}
		},
		"children": [
			{
				"tag": "span",
				"props": {
					"style": {
						"width": "8px",
						"height": "8px",
						"borderRadius": "999px",
						"background": {
							"ttIf": {
								"arg": "unread",
								"then": "#18181b",
								"else": "transparent"
							}
						},
						"flexShrink": 0
					}
				}
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"width": "104px",
						"flexShrink": 0,
						"fontSize": "13px",
						"fontWeight": {
							"ttIf": {
								"arg": "unread",
								"then": 700,
								"else": 500
							}
						},
						"color": {
							"ttIf": {
								"arg": "unread",
								"then": "#09090b",
								"else": "#71717a"
							}
						},
						"whiteSpace": "nowrap",
						"overflow": "hidden",
						"textOverflow": "ellipsis"
					}
				},
				"children": [
					"{sender}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"flex": 1,
						"minWidth": 0,
						"whiteSpace": "nowrap",
						"overflow": "hidden",
						"textOverflow": "ellipsis",
						"fontSize": "13px"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontWeight": {
									"ttIf": {
										"arg": "unread",
										"then": 600,
										"else": 400
									}
								},
								"color": "#09090b"
							}
						},
						"children": [
							"{subject}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"color": "#71717a"
							}
						},
						"children": [
							" — {snippet}"
						]
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"flexShrink": 0,
						"fontSize": "12px",
						"fontWeight": {
							"ttIf": {
								"arg": "unread",
								"then": 600,
								"else": 400
							}
						},
						"color": {
							"ttIf": {
								"arg": "unread",
								"then": "#18181b",
								"else": "#71717a"
							}
						}
					}
				},
				"children": [
					"{time}"
				]
			},
			{
				"ttIf": {
					"arg": "starred",
					"then": {
						"tag": "svg",
						"props": {
							"width": 16,
							"height": 16,
							"viewBox": "0 0 24 24",
							"fill": "#f59e0b",
							"stroke": "#f59e0b",
							"strokeWidth": 2,
							"strokeLinejoin": "round",
							"xmlns": "http://www.w3.org/2000/svg"
						},
						"children": [
							{
								"tag": "polygon",
								"props": {
									"points": "12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26"
								}
							}
						]
					},
					"else": {
						"tag": "svg",
						"props": {
							"width": 16,
							"height": 16,
							"viewBox": "0 0 24 24",
							"fill": "none",
							"stroke": "#a1a1aa",
							"strokeWidth": 2,
							"strokeLinejoin": "round",
							"xmlns": "http://www.w3.org/2000/svg"
						},
						"children": [
							{
								"tag": "polygon",
								"props": {
									"points": "12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26"
								}
							}
						]
					}
				}
			}
		]
	},
	"version": 1,
	"familyKey": "mail-inbox-row",
	"source": {
		"kind": "archetype",
		"archetype": "mail",
		"variant": "inbox-row",
		"tranche": 2
	}
}
