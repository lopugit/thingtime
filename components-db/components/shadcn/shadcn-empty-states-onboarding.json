{
	"slug": "shadcn-empty-states-onboarding",
	"name": "Onboarding CTA",
	"library": "shadcn",
	"category": "feedback",
	"description": "Onboarding call-to-action panel in the shadcn/ui style — welcome heading, numbered step dots hinting at the setup flow, and a solid tone start button.",
	"tags": [
		"onboarding",
		"empty-state",
		"steps",
		"cta"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Welcome to your workspace",
			"label": "Title",
			"maxLength": 50
		},
		{
			"name": "body",
			"type": "text",
			"default": "A few quick steps and you’re up and running.",
			"label": "Body"
		},
		{
			"name": "ctaLabel",
			"type": "string",
			"default": "Start setup",
			"label": "CTA label",
			"maxLength": 32
		},
		{
			"name": "steps",
			"type": "number",
			"default": 3,
			"label": "Steps",
			"min": 2,
			"max": 6
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"alignItems": "center",
				"justifyContent": "center",
				"textAlign": "center",
				"gap": "6px",
				"width": "360px",
				"padding": "40px 28px",
				"background": "#ffffff",
				"borderRadius": "12px",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"color": "#09090b",
				"border": "1px solid #e4e4e7",
				"boxShadow": "0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1)"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"width": "46px",
						"height": "46px",
						"borderRadius": "999px",
						"background": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#f4f4f5",
									"success": "#f0fdf4",
									"warning": "#fffbeb",
									"danger": "#fef2f2",
									"info": "#eff6ff",
									"neutral": "#f4f4f5"
								},
								"default": "#f4f4f5"
							}
						},
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#18181b",
									"success": "#15803d",
									"warning": "#b45309",
									"danger": "#b91c1c",
									"info": "#1d4ed8",
									"neutral": "#3f3f46"
								},
								"default": "#18181b"
							}
						},
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "center",
						"marginBottom": "4px"
					}
				},
				"children": [
					{
						"tag": "svg",
						"props": {
							"width": 20,
							"height": 20,
							"viewBox": "0 0 24 24",
							"fill": "none",
							"stroke": "currentColor",
							"strokeWidth": 2,
							"strokeLinecap": "round",
							"strokeLinejoin": "round",
							"xmlns": "http://www.w3.org/2000/svg"
						},
						"children": [
							{
								"tag": "polygon",
								"props": {
									"points": "13 2 3 14 12 14 11 22 21 10 12 10 13 2"
								}
							}
						]
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontWeight": 600,
						"fontSize": "18px"
					}
				},
				"children": [
					"{title}"
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "13px",
						"color": "#71717a",
						"lineHeight": 1.5,
						"maxWidth": "270px"
					}
				},
				"children": [
					"{body}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "8px",
						"marginTop": "10px",
						"justifyContent": "center"
					}
				},
				"children": [
					{
						"ttRepeat": {
							"arg": "steps",
							"max": 6,
							"node": {
								"tag": "div",
								"props": {
									"style": {
										"width": "24px",
										"height": "24px",
										"borderRadius": "999px",
										"display": "flex",
										"alignItems": "center",
										"justifyContent": "center",
										"fontSize": "12px",
										"fontWeight": 600,
										"background": {
											"ttIf": {
												"arg": "n",
												"equals": 1,
												"then": {
													"ttMap": {
														"arg": "tone",
														"values": {
															"primary": "#18181b",
															"success": "#16a34a",
															"warning": "#f59e0b",
															"danger": "#ef4444",
															"info": "#3b82f6",
															"neutral": "#71717a"
														},
														"default": "#18181b"
													}
												},
												"else": "#f4f4f5"
											}
										},
										"color": {
											"ttIf": {
												"arg": "n",
												"equals": 1,
												"then": {
													"ttMap": {
														"arg": "tone",
														"values": {
															"primary": "#fafafa",
															"success": "#ffffff",
															"warning": "#ffffff",
															"danger": "#fafafa",
															"info": "#ffffff",
															"neutral": "#ffffff"
														},
														"default": "#fafafa"
													}
												},
												"else": "#71717a"
											}
										}
									}
								},
								"children": [
									"{n}"
								]
							}
						}
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "12px",
						"color": "#a1a1aa"
					}
				},
				"children": [
					"Step 1 of {steps}"
				]
			},
			{
				"tag": "button",
				"props": {
					"type": "button",
					"style": {
						"display": "inline-flex",
						"alignItems": "center",
						"justifyContent": "center",
						"height": "36px",
						"padding": "0 18px",
						"border": "none",
						"borderRadius": "8px",
						"background": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#18181b",
									"success": "#16a34a",
									"warning": "#f59e0b",
									"danger": "#ef4444",
									"info": "#3b82f6",
									"neutral": "#71717a"
								},
								"default": "#18181b"
							}
						},
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#fafafa",
									"success": "#ffffff",
									"warning": "#ffffff",
									"danger": "#fafafa",
									"info": "#ffffff",
									"neutral": "#ffffff"
								},
								"default": "#fafafa"
							}
						},
						"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
						"fontSize": "13px",
						"fontWeight": 500,
						"boxShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
						"cursor": "pointer",
						"marginTop": "8px"
					}
				},
				"children": [
					"{ctaLabel}"
				]
			}
		]
	},
	"previewBg": "#fafafa",
	"version": 1,
	"familyKey": "empty-states-onboarding",
	"source": {
		"kind": "archetype",
		"archetype": "empty-states",
		"variant": "onboarding",
		"tranche": 1
	}
}
