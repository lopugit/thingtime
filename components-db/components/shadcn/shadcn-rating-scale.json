{
	"slug": "shadcn-rating-scale",
	"name": "Score Scale",
	"library": "shadcn",
	"category": "data-display",
	"description": "Segmented 1–10 score bar in the shadcn/ui style — ten fixed cells with the active run tone-colored through a calc-clipped overlay, under a label and mono score readout.",
	"tags": [
		"rating",
		"scale",
		"score",
		"segments",
		"meter"
	],
	"args": [
		{
			"name": "score",
			"type": "number",
			"default": 7,
			"label": "Score (0–10)",
			"min": 0,
			"max": 10
		},
		{
			"name": "label",
			"type": "string",
			"default": "Performance",
			"label": "Label",
			"maxLength": 24
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "inline-flex",
				"flexDirection": "column",
				"gap": "8px",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "space-between",
						"gap": "12px"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "13px",
								"fontWeight": 600,
								"color": "#09090b"
							}
						},
						"children": [
							"{label}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "13px",
								"fontWeight": 600,
								"color": "#71717a",
								"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
							}
						},
						"children": [
							"{score}/10"
						]
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"position": "relative",
						"display": "inline-flex"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"gap": "2px"
							}
						},
						"children": [
							{
								"ttRepeat": {
									"count": 10,
									"max": 10,
									"node": {
										"tag": "div",
										"props": {
											"style": {
												"width": "20px",
												"height": "12px",
												"borderRadius": "6px",
												"background": "#f4f4f5",
												"flexShrink": 0
											}
										}
									}
								}
							}
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"position": "absolute",
								"top": "0px",
								"left": "0px",
								"height": "100%",
								"width": "calc({score} * 22px)",
								"overflow": "hidden",
								"whiteSpace": "nowrap"
							}
						},
						"children": [
							{
								"tag": "div",
								"props": {
									"style": {
										"display": "flex",
										"alignItems": "center",
										"gap": "2px",
										"width": "218px",
										"flexShrink": 0
									}
								},
								"children": [
									{
										"ttRepeat": {
											"count": 10,
											"max": 10,
											"node": {
												"tag": "div",
												"props": {
													"style": {
														"width": "20px",
														"height": "12px",
														"borderRadius": "6px",
														"background": {
															"ttMap": {
																"arg": "tone",
																"values": {
																	"primary": "#18181b",
																	"success": "#16a34a",
																	"warning": "#f59e0b",
																	"danger": "#ef4444",
																	"info": "#3b82f6",
																	"neutral": "#71717a"
																},
																"default": "#18181b"
															}
														},
														"flexShrink": 0
													}
												}
											}
										}
									}
								]
							}
						]
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "rating-scale",
	"source": {
		"kind": "archetype",
		"archetype": "rating",
		"variant": "scale",
		"tranche": 2
	}
}
