{
	"slug": "shadcn-docs-wiki-version",
	"name": "Docs Version Picker",
	"library": "shadcn",
	"category": "documentation",
	"description": "Docs version picker in the shadcn/ui style — mono version pill trigger over an open menu that tags the latest release with a tone chip, checks the active row and ends in a ghost changelog row.",
	"tags": [
		"docs",
		"version",
		"picker",
		"menu"
	],
	"args": [
		{
			"name": "version",
			"type": "string",
			"default": "2.4",
			"label": "Version",
			"maxLength": 12
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "success",
			"label": "Tone"
		},
		{
			"name": "open",
			"type": "boolean",
			"default": true,
			"label": "Menu open"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"gap": "8px",
				"alignItems": "flex-start",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
			}
		},
		"children": [
			{
				"tag": "button",
				"props": {
					"type": "button",
					"style": {
						"display": "inline-flex",
						"alignItems": "center",
						"gap": "6px",
						"height": "32px",
						"padding": "0 12px",
						"borderRadius": "999px",
						"border": "1px solid #e4e4e7",
						"background": "#ffffff",
						"color": "#09090b",
						"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
						"fontSize": "13px",
						"fontWeight": 600,
						"cursor": "pointer",
						"boxShadow": "none"
					}
				},
				"children": [
					"v{version}",
					{
						"tag": "svg",
						"props": {
							"width": 14,
							"height": 14,
							"viewBox": "0 0 24 24",
							"fill": "none",
							"stroke": "currentColor",
							"strokeWidth": 2,
							"strokeLinecap": "round",
							"strokeLinejoin": "round",
							"xmlns": "http://www.w3.org/2000/svg"
						},
						"children": [
							{
								"tag": "polyline",
								"props": {
									"points": "6 9 12 15 18 9"
								}
							}
						]
					}
				]
			},
			{
				"ttIf": {
					"arg": "open",
					"then": {
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"flexDirection": "column",
								"gap": "2px",
								"width": "220px",
								"padding": "6px",
								"background": "#ffffff",
								"borderRadius": "8px",
								"border": "1px solid #f4f4f5",
								"boxShadow": "0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1)"
							}
						},
						"children": [
							{
								"tag": "div",
								"props": {
									"style": {
										"display": "flex",
										"alignItems": "center",
										"justifyContent": "space-between",
										"padding": "6px 10px",
										"borderRadius": "8px",
										"background": "#f4f4f5"
									}
								},
								"children": [
									{
										"tag": "div",
										"props": {
											"style": {
												"display": "flex",
												"alignItems": "center",
												"gap": "8px"
											}
										},
										"children": [
											{
												"tag": "span",
												"props": {
													"style": {
														"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
														"fontSize": "13px",
														"fontWeight": 600,
														"color": "#09090b"
													}
												},
												"children": [
													"v{version}"
												]
											},
											{
												"tag": "span",
												"props": {
													"style": {
														"display": "inline-flex",
														"alignItems": "center",
														"padding": "1px 7px",
														"borderRadius": "999px",
														"background": {
															"ttMap": {
																"arg": "tone",
																"values": {
																	"primary": "#f4f4f5",
																	"success": "#f0fdf4",
																	"warning": "#fffbeb",
																	"danger": "#fef2f2",
																	"info": "#eff6ff",
																	"neutral": "#f4f4f5"
																},
																"default": "#f4f4f5"
															}
														},
														"color": {
															"ttMap": {
																"arg": "tone",
																"values": {
																	"primary": "#18181b",
																	"success": "#15803d",
																	"warning": "#b45309",
																	"danger": "#b91c1c",
																	"info": "#1d4ed8",
																	"neutral": "#3f3f46"
																},
																"default": "#18181b"
															}
														},
														"fontSize": "12px",
														"fontWeight": 700
													}
												},
												"children": [
													"latest"
												]
											}
										]
									},
									{
										"tag": "svg",
										"props": {
											"width": 14,
											"height": 14,
											"viewBox": "0 0 24 24",
											"fill": "none",
											"stroke": {
												"ttMap": {
													"arg": "tone",
													"values": {
														"primary": "#18181b",
														"success": "#16a34a",
														"warning": "#f59e0b",
														"danger": "#ef4444",
														"info": "#3b82f6",
														"neutral": "#71717a"
													},
													"default": "#18181b"
												}
											},
											"strokeWidth": 2,
											"strokeLinecap": "round",
											"strokeLinejoin": "round",
											"xmlns": "http://www.w3.org/2000/svg"
										},
										"children": [
											{
												"tag": "polyline",
												"props": {
													"points": "20 6 9 17 4 12"
												}
											}
										]
									}
								]
							},
							{
								"tag": "div",
								"props": {
									"style": {
										"padding": "6px 10px",
										"borderRadius": "8px",
										"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
										"fontSize": "13px",
										"color": "#71717a"
									}
								},
								"children": [
									"v2.3"
								]
							},
							{
								"tag": "div",
								"props": {
									"style": {
										"padding": "6px 10px",
										"borderRadius": "8px",
										"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
										"fontSize": "13px",
										"color": "#71717a"
									}
								},
								"children": [
									"v1.9"
								]
							},
							{
								"tag": "div",
								"props": {
									"style": {
										"height": "1px",
										"background": "#f4f4f5",
										"margin": "4px 2px"
									}
								}
							},
							{
								"tag": "div",
								"props": {
									"style": {
										"display": "flex",
										"alignItems": "center",
										"gap": "6px",
										"padding": "6px 10px",
										"fontSize": "13px",
										"fontWeight": 500,
										"color": "#71717a",
										"cursor": "pointer"
									}
								},
								"children": [
									"View changelog",
									{
										"tag": "svg",
										"props": {
											"width": 12,
											"height": 12,
											"viewBox": "0 0 24 24",
											"fill": "none",
											"stroke": "currentColor",
											"strokeWidth": 2,
											"strokeLinecap": "round",
											"strokeLinejoin": "round",
											"xmlns": "http://www.w3.org/2000/svg"
										},
										"children": [
											{
												"tag": "line",
												"props": {
													"x1": 5,
													"y1": 12,
													"x2": 19,
													"y2": 12
												}
											},
											{
												"tag": "polyline",
												"props": {
													"points": "12 5 19 12 12 19"
												}
											}
										]
									}
								]
							}
						]
					}
				}
			}
		]
	},
	"version": 1,
	"familyKey": "docs-wiki-version",
	"source": {
		"kind": "archetype",
		"archetype": "docs-wiki",
		"variant": "version",
		"tranche": 2
	}
}
