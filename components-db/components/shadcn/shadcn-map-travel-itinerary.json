{
	"slug": "shadcn-map-travel-itinerary",
	"name": "Itinerary Card",
	"library": "shadcn",
	"category": "travel",
	"description": "Trip summary card in the shadcn/ui style — trip title with a date-range chip, numbered day rows down a dashed dot rail, and a totals footer caption.",
	"tags": [
		"travel",
		"itinerary",
		"trip",
		"planner",
		"card"
	],
	"args": [
		{
			"name": "trip",
			"type": "string",
			"default": "Tokyo long weekend",
			"label": "Trip",
			"maxLength": 40
		},
		{
			"name": "dates",
			"type": "string",
			"default": "Mar 4-9",
			"label": "Dates",
			"maxLength": 16
		},
		{
			"name": "days",
			"type": "number",
			"default": 3,
			"label": "Days (1-6)",
			"min": 1,
			"max": 6
		},
		{
			"name": "stops",
			"type": "string",
			"default": "Shibuya walk · 3 stops",
			"label": "Day caption",
			"maxLength": 40
		},
		{
			"name": "total",
			"type": "string",
			"default": "9 stops · 3 days",
			"label": "Total",
			"maxLength": 30
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"background": "#ffffff",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "#e4e4e7",
				"borderRadius": "12px",
				"boxShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
				"overflow": "hidden",
				"boxSizing": "border-box",
				"width": "250px"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"padding": "14px",
						"gap": "10px"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"justifyContent": "space-between",
								"gap": "8px"
							}
						},
						"children": [
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "16px",
										"fontWeight": 600,
										"color": "#09090b"
									}
								},
								"children": [
									"{trip}"
								]
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"display": "inline-flex",
										"alignItems": "center",
										"padding": "2px 8px",
										"borderRadius": "999px",
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#f4f4f5",
													"success": "#f0fdf4",
													"warning": "#fffbeb",
													"danger": "#fef2f2",
													"info": "#eff6ff",
													"neutral": "#f4f4f5"
												},
												"default": "#f4f4f5"
											}
										},
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#18181b",
													"success": "#15803d",
													"warning": "#b45309",
													"danger": "#b91c1c",
													"info": "#1d4ed8",
													"neutral": "#3f3f46"
												},
												"default": "#18181b"
											}
										},
										"fontSize": "12px",
										"fontWeight": 600,
										"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
										"whiteSpace": "nowrap"
									}
								},
								"children": [
									"{dates}"
								]
							}
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"flexDirection": "column",
								"gap": "0px"
							}
						},
						"children": [
							{
								"ttRepeat": {
									"arg": "days",
									"max": 6,
									"node": {
										"tag": "div",
										"props": {
											"style": {
												"display": "flex",
												"alignItems": "stretch",
												"gap": "10px"
											}
										},
										"children": [
											{
												"tag": "div",
												"props": {
													"style": {
														"display": "flex",
														"flexDirection": "column",
														"alignItems": "center",
														"width": "10px",
														"paddingTop": "4px"
													}
												},
												"children": [
													{
														"tag": "div",
														"props": {
															"style": {
																"width": "8px",
																"height": "8px",
																"borderRadius": "999px",
																"background": {
																	"ttMap": {
																		"arg": "tone",
																		"values": {
																			"primary": "#18181b",
																			"success": "#16a34a",
																			"warning": "#f59e0b",
																			"danger": "#ef4444",
																			"info": "#3b82f6",
																			"neutral": "#71717a"
																		},
																		"default": "#18181b"
																	}
																},
																"flexShrink": 0
															}
														}
													},
													{
														"tag": "div",
														"props": {
															"style": {
																"flexGrow": 1,
																"width": "0px",
																"borderLeftWidth": "2px",
																"borderLeftStyle": "dashed",
																"borderLeftColor": "#a1a1aa",
																"margin": "3px 0 1px"
															}
														}
													}
												]
											},
											{
												"tag": "div",
												"props": {
													"style": {
														"display": "flex",
														"flexDirection": "column",
														"gap": "1px",
														"paddingBottom": "12px",
														"flexGrow": 1
													}
												},
												"children": [
													{
														"tag": "span",
														"props": {
															"style": {
																"fontSize": "13px",
																"fontWeight": 600,
																"color": "#09090b"
															}
														},
														"children": [
															"Day {n}"
														]
													},
													{
														"tag": "span",
														"props": {
															"style": {
																"fontSize": "12px",
																"color": "#71717a"
															}
														},
														"children": [
															"{stops}"
														]
													}
												]
											}
										]
									}
								}
							}
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"borderTopWidth": "1px",
								"borderTopStyle": "solid",
								"borderTopColor": "#f4f4f5",
								"paddingTop": "8px",
								"justifyContent": "space-between",
								"gap": "8px"
							}
						},
						"children": [
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "12px",
										"color": "#a1a1aa",
										"fontWeight": 600
									}
								},
								"children": [
									"Total"
								]
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "12px",
										"color": "#71717a",
										"fontWeight": 600
									}
								},
								"children": [
									"{total}"
								]
							}
						]
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "map-travel-itinerary",
	"source": {
		"kind": "archetype",
		"archetype": "map-travel",
		"variant": "itinerary",
		"tranche": 2
	}
}
