					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"gap": "6px",
								"height": "36px",
								"padding": "0 12px",
								"fontSize": "13px",
								"color": "#09090b"
							}
						},
						"children": [
							{
								"tag": "svg",
								"props": {
									"width": 14,
									"height": 14,
									"viewBox": "0 0 24 24",
									"fill": "none",
									"stroke": "#71717a",
									"strokeWidth": 2,
