										"props": {
											"x": 3,
											"y": 4,
											"width": 18,
											"height": 18,
											"rx": 2
										}
									},
									{
										"tag": "line",
										"props": {
											"x1": 16,
											"y1": 2,
											"x2": 16,
											"y2": 6
										}
									},
									{
										"tag": "line",
										"props": {
											"x1": 8,
											"y1": 2,
											"x2": 8,
											"y2": 6
										}
									},
