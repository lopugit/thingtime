						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"ttMerge": [
									{
										"padding": "4px 12px",
										"borderRadius": "999px",
										"borderWidth": "1px",
										"borderStyle": "solid",
										"fontSize": "12px",
										"fontWeight": 600,
										"cursor": "pointer"
									},
									{
										"ttIf": {
											"arg": "preset",
											"equals": "30d",
											"then": {
												"background": "#18181b",
												"borderColor": "#18181b",
												"color": "#fafafa"
											},
											"else": {
												"background": "#ffffff",
												"borderColor": "#e4e4e7",
												"color": "#71717a"
