{
	"slug": "shadcn-date-time-range",
	"name": "Date Range Picker",
	"library": "shadcn",
	"category": "forms",
	"description": "Date range control in the shadcn/ui style — two joined date fields bridged by an arrow, under a row of quick preset chips with one active.",
	"tags": [
		"date",
		"range",
		"picker",
		"preset"
	],
	"args": [
		{
			"name": "start",
			"type": "string",
			"default": "01 Aug 2026",
			"label": "Start date",
			"maxLength": 24
		},
		{
			"name": "end",
			"type": "string",
			"default": "30 Aug 2026",
			"label": "End date",
			"maxLength": 24
		},
		{
			"name": "preset",
			"type": "enum",
			"values": [
				"Today",
				"7d",
				"30d"
			],
			"default": "30d",
			"label": "Active preset"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"gap": "10px",
				"width": "fit-content",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "inline-flex",
						"alignItems": "center",
						"background": "#ffffff",
						"borderWidth": "1px",
						"borderStyle": "solid",
						"borderColor": "#e4e4e7",
						"borderRadius": "8px",
						"boxShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
