							{
								"tag": "svg",
								"props": {
									"width": 14,
									"height": 14,
									"viewBox": "0 0 24 24",
									"fill": "none",
									"stroke": "#71717a",
									"strokeWidth": 2,
									"strokeLinecap": "round",
									"strokeLinejoin": "round",
									"xmlns": "http://www.w3.org/2000/svg"
								},
								"children": [
									{
										"tag": "line",
										"props": {
											"x1": 5,
											"y1": 12,
											"x2": 19,
											"y2": 12
