				"background": "#ffffff",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "#e4e4e7",
				"borderRadius": "8px",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"boxShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
				"width": "300px",
				"display": "flex",
				"alignItems": "center",
				"gap": "12px",
				"padding": "10px 12px",
				"boxSizing": "border-box"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"position": "relative",
						"flexShrink": 0
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"width": 40,
								"height": 40,
								"borderRadius": "999px",
								"background": "#f4f4f5",
								"color": "#3f3f46",
								"display": "flex",
								"alignItems": "center",
								"justifyContent": "center",
								"fontWeight": 600,
								"fontSize": "13px",
								"flexShrink": 0
							}
						},
						"children": [
							"{initials}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"position": "absolute",
								"right": "-1px",
