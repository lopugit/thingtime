								"height": "10px",
								"borderRadius": "999px",
								"borderWidth": "2px",
								"borderStyle": "solid",
								"borderColor": "#ffffff",
								"background": {
									"ttMap": {
										"arg": "presence",
										"values": {
											"online": "#16a34a",
											"away": "#f59e0b",
											"offline": "#a1a1aa"
										},
										"default": "#16a34a"
									}
								}
							}
						}
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"flex": 1,
						"minWidth": 0
