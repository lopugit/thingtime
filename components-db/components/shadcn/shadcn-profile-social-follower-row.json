					"style": {
						"padding": "4px 12px",
						"borderRadius": "999px",
						"background": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#f4f4f5",
									"success": "#f0fdf4",
									"warning": "#fffbeb",
									"danger": "#fef2f2",
									"info": "#eff6ff",
									"neutral": "#f4f4f5"
								},
								"default": "#f4f4f5"
							}
						},
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#18181b",
									"success": "#15803d",
									"warning": "#b45309",
									"danger": "#b91c1c",
									"info": "#1d4ed8",
									"neutral": "#3f3f46"
								},
								"default": "#18181b"
							}
						},
						"fontSize": "12px",
						"fontWeight": 600,
						"flexShrink": 0
					}
				},
				"children": [
					"Follow"
				]
			}
		]
	},
	"version": 1,
	"familyKey": "profile-social-follower-row",
	"source": {
		"kind": "archetype",
		"archetype": "profile-social",
		"variant": "follower-row",
		"tranche": 2
	}
