{
	"slug": "shadcn-profile-social-user-card",
	"name": "User Card",
	"library": "shadcn",
	"category": "social",
	"description": "Compact vertical user card in the shadcn/ui style — initials avatar, name and role caption over follower mini-stats, with a tone follow button that flips to a 'Following' outline.",
	"tags": [
		"profile",
		"card",
		"avatar",
		"follow",
		"social"
	],
	"args": [
		{
			"name": "initials",
			"type": "string",
			"default": "AK",
			"label": "Initials",
			"maxLength": 3
		},
		{
			"name": "name",
			"type": "string",
			"default": "Avery Kim",
			"label": "Name",
			"maxLength": 40
		},
		{
			"name": "role",
			"type": "string",
			"default": "Product Designer",
			"label": "Role",
			"maxLength": 32
		},
		{
			"name": "followers",
			"type": "string",
			"default": "1,024",
			"label": "Followers",
			"maxLength": 10
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "isFollowing",
			"type": "boolean",
			"default": false,
			"label": "Following"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"background": "#ffffff",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "#e4e4e7",
				"borderRadius": "12px",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"boxShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
				"width": "220px",
				"display": "flex",
				"flexDirection": "column",
				"alignItems": "center",
				"textAlign": "center",
				"padding": "20px 16px",
				"boxSizing": "border-box"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"width": 56,
						"height": 56,
						"borderRadius": "999px",
						"background": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#18181b",
									"success": "#16a34a",
									"warning": "#f59e0b",
									"danger": "#ef4444",
									"info": "#3b82f6",
									"neutral": "#71717a"
								},
								"default": "#18181b"
							}
						},
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#fafafa",
									"success": "#ffffff",
									"warning": "#ffffff",
									"danger": "#fafafa",
									"info": "#ffffff",
									"neutral": "#ffffff"
								},
								"default": "#fafafa"
							}
						},
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "center",
						"fontWeight": 600,
						"fontSize": "16px",
						"flexShrink": 0
					}
				},
				"children": [
					"{initials}"
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"marginTop": "10px",
						"fontSize": "14px",
						"fontWeight": 600,
						"color": "#09090b"
					}
				},
				"children": [
					"{name}"
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"marginTop": "2px",
						"fontSize": "12px",
						"color": "#71717a"
					}
				},
				"children": [
					"{role}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"marginTop": "12px",
						"gap": "18px",
						"justifyContent": "center"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"flexDirection": "column",
								"alignItems": "center"
							}
						},
						"children": [
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "13px",
										"fontWeight": 700,
										"color": "#09090b"
									}
								},
								"children": [
									"{followers}"
								]
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "12px",
										"color": "#71717a"
									}
								},
								"children": [
									"Followers"
								]
							}
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"flexDirection": "column",
								"alignItems": "center"
							}
						},
						"children": [
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "13px",
										"fontWeight": 700,
										"color": "#09090b"
									}
								},
								"children": [
									"412"
								]
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "12px",
										"color": "#71717a"
									}
								},
								"children": [
									"Following"
								]
							}
						]
					}
				]
			},
			{
				"tag": "button",
				"props": {
					"type": "button",
					"style": {
						"ttMerge": [
							{
								"display": "inline-flex",
								"alignItems": "center",
								"justifyContent": "center",
								"borderRadius": "8px",
								"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
								"fontSize": "13px",
								"fontWeight": 500,
								"cursor": "pointer"
							},
							{
								"marginTop": "14px",
								"width": "100%",
								"height": "32px",
								"padding": "0 12px",
								"borderWidth": "1px",
								"borderStyle": "solid",
								"boxSizing": "border-box"
							},
							{
								"ttIf": {
									"arg": "isFollowing",
									"then": {
										"background": "transparent",
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#18181b",
													"success": "#16a34a",
													"warning": "#f59e0b",
													"danger": "#ef4444",
													"info": "#3b82f6",
													"neutral": "#71717a"
												},
												"default": "#18181b"
											}
										},
										"borderColor": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#18181b",
													"success": "#16a34a",
													"warning": "#f59e0b",
													"danger": "#ef4444",
													"info": "#3b82f6",
													"neutral": "#71717a"
												},
												"default": "#18181b"
											}
										}
									},
									"else": {
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#18181b",
													"success": "#16a34a",
													"warning": "#f59e0b",
													"danger": "#ef4444",
													"info": "#3b82f6",
													"neutral": "#71717a"
												},
												"default": "#18181b"
											}
										},
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#fafafa",
													"success": "#ffffff",
													"warning": "#ffffff",
													"danger": "#fafafa",
													"info": "#ffffff",
													"neutral": "#ffffff"
												},
												"default": "#fafafa"
											}
										},
										"borderColor": "transparent"
									}
								}
							}
						]
					}
				},
				"children": [
					{
						"ttIf": {
							"arg": "isFollowing",
							"then": "Following",
							"else": "Follow"
						}
					}
				]
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "profile-social",
		"variant": "user-card",
		"tranche": 2
	}
}
