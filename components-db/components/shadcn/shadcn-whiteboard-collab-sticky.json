{
	"slug": "shadcn-whiteboard-collab-sticky",
	"name": "Sticky Note",
	"library": "shadcn",
	"category": "collaboration",
	"description": "Whiteboard sticky note in the shadcn/ui style — a tinted square wash with handwritten-feel text, an author chip, a folded corner, and a tilt you can dial in degrees.",
	"tags": [
		"whiteboard",
		"sticky-note",
		"collaboration",
		"annotation"
	],
	"args": [
		{
			"name": "text",
			"type": "text",
			"default": "Ship the collab demo",
			"label": "Note",
			"maxLength": 80
		},
		{
			"name": "color",
			"type": "enum",
			"values": [
				"yellow",
				"pink",
				"blue",
				"green"
			],
			"default": "yellow",
			"label": "Color"
		},
		{
			"name": "author",
			"type": "string",
			"default": "Ava",
			"label": "Author",
			"maxLength": 16
		},
		{
			"name": "tilt",
			"type": "number",
			"default": -2,
			"label": "Tilt (deg)",
			"min": -8,
			"max": 8
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"ttMerge": [
					{
						"position": "relative",
						"width": "168px",
						"height": "168px",
						"boxSizing": "border-box",
						"padding": "14px",
						"display": "flex",
						"flexDirection": "column",
						"gap": "8px",
						"overflow": "hidden",
						"borderRadius": "8px",
						"boxShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
						"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
						"transform": "rotate(calc({tilt} * 1deg))"
					},
					{
						"ttMap": {
							"arg": "color",
							"values": {
								"yellow": {
									"background": "#fef9c3",
									"color": "#854d0e"
								},
								"pink": {
									"background": "#fce7f3",
									"color": "#9d174d"
								},
								"blue": {
									"background": "#dbeafe",
									"color": "#1e40af"
								},
								"green": {
									"background": "#dcfce7",
									"color": "#166534"
								}
							},
							"default": {
								"background": "#fef9c3",
								"color": "#854d0e"
							}
						}
					}
				]
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"flex": "1",
						"fontSize": "16px",
						"lineHeight": 1.35,
						"fontWeight": 500,
						"fontStyle": "italic",
						"fontFamily": "'Segoe Print', 'Bradley Hand', 'Comic Sans MS', cursive"
					}
				},
				"children": [
					"{text}"
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"alignSelf": "flex-start",
						"padding": "2px 8px",
						"borderRadius": "999px",
						"background": "rgba(255, 255, 255, 0.6)",
						"fontSize": "12px",
						"fontWeight": 600
					}
				},
				"children": [
					"{author}"
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"position": "absolute",
						"right": 0,
						"bottom": 0,
						"width": 0,
						"height": 0,
						"borderStyle": "solid",
						"borderWidth": "0 0 20px 20px",
						"borderColor": {
							"ttMap": {
								"arg": "color",
								"values": {
									"yellow": "transparent transparent #fde047 transparent",
									"pink": "transparent transparent #f9a8d4 transparent",
									"blue": "transparent transparent #93c5fd transparent",
									"green": "transparent transparent #86efac transparent"
								},
								"default": "transparent transparent #fde047 transparent"
							}
						}
					}
				}
			}
		]
	},
	"version": 1,
	"familyKey": "whiteboard-collab-sticky",
	"source": {
		"kind": "archetype",
		"archetype": "whiteboard-collab",
		"variant": "sticky",
		"tranche": 2
	}
}
