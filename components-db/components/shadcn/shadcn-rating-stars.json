{
	"slug": "shadcn-rating-stars",
	"name": "Star Rating",
	"library": "shadcn",
	"category": "data-display",
	"description": "Five-star rating row in the shadcn/ui style — the filled count is arg-driven through a calc-clipped overlay, so fractional scores like 3.5 fill half a star in the tone color.",
	"tags": [
		"rating",
		"stars",
		"score",
		"review"
	],
	"args": [
		{
			"name": "stars",
			"type": "number",
			"default": 4,
			"label": "Stars (0–5)",
			"min": 0,
			"max": 5
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "warning",
			"label": "Tone"
		},
		{
			"name": "showValue",
			"type": "boolean",
			"default": false,
			"label": "Show value"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "inline-flex",
				"alignItems": "center",
				"gap": "10px",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"position": "relative",
						"display": "inline-flex"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"gap": "0px"
							}
						},
						"children": [
							{
								"ttRepeat": {
									"count": 5,
									"max": 5,
									"node": {
										"tag": "svg",
										"props": {
											"width": 20,
											"height": 20,
											"viewBox": "0 0 24 24",
											"fill": "none",
											"stroke": "#a1a1aa",
											"strokeWidth": 2,
											"strokeLinejoin": "round",
											"xmlns": "http://www.w3.org/2000/svg"
										},
										"children": [
											{
												"tag": "polygon",
												"props": {
													"points": "12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26"
												}
											}
										]
									}
								}
							}
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"position": "absolute",
								"top": "0px",
								"left": "0px",
								"height": "100%",
								"width": "calc({stars} * 20px)",
								"overflow": "hidden",
								"whiteSpace": "nowrap"
							}
						},
						"children": [
							{
								"tag": "div",
								"props": {
									"style": {
										"display": "flex",
										"alignItems": "center",
										"gap": "0px",
										"width": "100px",
										"flexShrink": 0
									}
								},
								"children": [
									{
										"ttRepeat": {
											"count": 5,
											"max": 5,
											"node": {
												"tag": "svg",
												"props": {
													"width": 20,
													"height": 20,
													"viewBox": "0 0 24 24",
													"fill": {
														"ttMap": {
															"arg": "tone",
															"values": {
																"primary": "#18181b",
																"success": "#16a34a",
																"warning": "#f59e0b",
																"danger": "#ef4444",
																"info": "#3b82f6",
																"neutral": "#71717a"
															},
															"default": "#f59e0b"
														}
													},
													"stroke": {
														"ttMap": {
															"arg": "tone",
															"values": {
																"primary": "#18181b",
																"success": "#16a34a",
																"warning": "#f59e0b",
																"danger": "#ef4444",
																"info": "#3b82f6",
																"neutral": "#71717a"
															},
															"default": "#f59e0b"
														}
													},
													"strokeWidth": 2,
													"strokeLinejoin": "round",
													"xmlns": "http://www.w3.org/2000/svg"
												},
												"children": [
													{
														"tag": "polygon",
														"props": {
															"points": "12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26"
														}
													}
												]
											}
										}
									}
								]
							}
						]
					}
				]
			},
			{
				"ttIf": {
					"arg": "showValue",
					"then": {
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "13px",
								"fontWeight": 600,
								"color": "#71717a"
							}
						},
						"children": [
							"{stars}/5"
						]
					}
				}
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "rating",
		"variant": "stars",
		"tranche": 2
	}
}
