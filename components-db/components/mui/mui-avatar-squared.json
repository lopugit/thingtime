{
	"slug": "mui-avatar-squared",
	"name": "Squared Avatar",
	"library": "mui",
	"category": "data-display",
	"description": "Rounded-square initials avatar in the Material UI style — the library's own corner radius on a tone-filled tile, with an optional soft tint.",
	"tags": [
		"avatar",
		"squared",
		"initials",
		"tile"
	],
	"args": [
		{
			"name": "initials",
			"type": "string",
			"default": "TT",
			"label": "Initials",
			"maxLength": 3
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "size",
			"type": "enum",
			"values": [
				"sm",
				"md",
				"lg"
			],
			"default": "md",
			"label": "Size"
		},
		{
			"name": "soft",
			"type": "boolean",
			"default": false,
			"label": "Soft tint"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"ttMerge": [
					{
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "center",
						"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif",
						"fontWeight": 500,
						"borderRadius": "4px",
						"flexShrink": 0,
						"userSelect": "none"
					},
					{
						"ttMap": {
							"arg": "size",
							"values": {
								"sm": {
									"width": "28px",
									"height": "28px",
									"fontSize": "12px"
								},
								"md": {
									"width": "40px",
									"height": "40px",
									"fontSize": "13px"
								},
								"lg": {
									"width": "56px",
									"height": "56px",
									"fontSize": "16px"
								}
							},
							"default": {
								"width": "40px",
								"height": "40px",
								"fontSize": "13px"
							}
						}
					},
					{
						"ttIf": {
							"arg": "soft",
							"then": {
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#e3f2fd",
											"success": "#edf7ed",
											"warning": "#fff4e5",
											"danger": "#fdeded",
											"info": "#e5f6fd",
											"neutral": "#eeeeee"
										},
										"default": "#e3f2fd"
									}
								},
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#1565c0",
											"success": "#1e4620",
											"warning": "#663c00",
											"danger": "#5f2120",
											"info": "#014361",
											"neutral": "#424242"
										},
										"default": "#1565c0"
									}
								},
								"border": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "1px solid #90caf9",
											"success": "1px solid #a5d6a7",
											"warning": "1px solid #ffb74d",
											"danger": "1px solid #ef9a9a",
											"info": "1px solid #81d4fa",
											"neutral": "1px solid #bdbdbd"
										},
										"default": "1px solid #90caf9"
									}
								}
							},
							"else": {
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#1976d2",
											"success": "#2e7d32",
											"warning": "#ed6c02",
											"danger": "#d32f2f",
											"info": "#0288d1",
											"neutral": "#616161"
										},
										"default": "#1976d2"
									}
								},
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#ffffff",
											"success": "#ffffff",
											"warning": "#ffffff",
											"danger": "#ffffff",
											"info": "#ffffff",
											"neutral": "#ffffff"
										},
										"default": "#ffffff"
									}
								}
							}
						}
					}
				]
			}
		},
		"children": [
			"{initials}"
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "avatar",
		"variant": "squared",
		"tranche": 1
	}
}
