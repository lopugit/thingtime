{
	"slug": "mui-list-avatar",
	"name": "Avatar List",
	"library": "mui",
	"category": "data-display",
	"description": "Avatar-and-name list rows in the Material UI style — tone-tinted initials circles beside names, a faint recency mark trailing each row.",
	"tags": [
		"list",
		"avatar",
		"people",
		"data"
	],
	"args": [
		{
			"name": "name",
			"type": "string",
			"default": "Alex Rivers",
			"label": "Name",
			"maxLength": 40
		},
		{
			"name": "initials",
			"type": "string",
			"default": "AR",
			"label": "Initials",
			"maxLength": 3
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "count",
			"type": "number",
			"default": 3,
			"label": "Rows",
			"min": 1,
			"max": 6
		}
	],
	"render": {
		"tag": "ul",
		"props": {
			"style": {
				"ttMerge": [
					{
						"listStyle": "none",
						"margin": 0,
						"padding": 0,
						"width": "280px",
						"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif",
						"color": "rgba(0, 0, 0, 0.87)",
						"background": "#ffffff",
						"borderRadius": "4px",
						"overflow": "hidden"
					},
					{
						"border": "1px solid rgba(0, 0, 0, 0.12)",
						"boxShadow": "0px 2px 1px -1px rgba(0,0,0,0.2), 0px 1px 1px 0px rgba(0,0,0,0.14), 0px 1px 3px 0px rgba(0,0,0,0.12)"
					}
				]
			}
		},
		"children": [
			{
				"ttRepeat": {
					"arg": "count",
					"max": 6,
					"node": {
						"tag": "li",
						"props": {
							"style": {
								"ttMerge": [
									{
										"display": "flex",
										"alignItems": "center",
										"gap": "12px",
										"padding": "10px 14px",
										"fontSize": "14px"
									},
									{
										"ttIf": {
											"arg": "n",
											"equals": 1,
											"then": {},
											"else": {
												"borderTop": "1px solid rgba(0, 0, 0, 0.08)"
											}
										}
									}
								]
							}
						},
						"children": [
							{
								"tag": "div",
								"props": {
									"style": {
										"width": "32px",
										"height": "32px",
										"borderRadius": "999px",
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#e3f2fd",
													"success": "#edf7ed",
													"warning": "#fff4e5",
													"danger": "#fdeded",
													"info": "#e5f6fd",
													"neutral": "#eeeeee"
												},
												"default": "#e3f2fd"
											}
										},
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#1565c0",
													"success": "#1e4620",
													"warning": "#663c00",
													"danger": "#5f2120",
													"info": "#014361",
													"neutral": "#424242"
												},
												"default": "#1565c0"
											}
										},
										"display": "flex",
										"alignItems": "center",
										"justifyContent": "center",
										"fontWeight": 600,
										"fontSize": "12px",
										"flexShrink": 0
									}
								},
								"children": [
									"{initials}"
								]
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"fontWeight": 500,
										"flexGrow": 1
									}
								},
								"children": [
									"{name}"
								]
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"color": "rgba(0, 0, 0, 0.38)",
										"fontSize": "12px"
									}
								},
								"children": [
									"{n}h"
								]
							}
						]
					}
				}
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "list",
		"variant": "avatar",
		"tranche": 1
	}
}
