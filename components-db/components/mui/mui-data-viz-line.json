{
	"slug": "mui-data-viz-line",
	"name": "Line Chart",
	"library": "mui",
	"category": "data-display",
	"description": "Mini line chart in the Material UI style — a tone-colored svg trend polyline with an optional translucent area fill, end-point dot, and min/max captions under the plot.",
	"tags": [
		"chart",
		"line",
		"trend",
		"area"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Active users",
			"label": "Title",
			"maxLength": 32
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "area",
			"type": "boolean",
			"default": true,
			"label": "Area fill"
		},
		{
			"name": "min",
			"type": "string",
			"default": "Low 14",
			"label": "Min caption",
			"maxLength": 16
		},
		{
			"name": "max",
			"type": "string",
			"default": "High 86",
			"label": "Max caption",
			"maxLength": 16
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"width": "232px",
				"boxSizing": "border-box",
				"padding": "14px 16px",
				"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif",
				"background": "#ffffff",
				"border": "1px solid rgba(0, 0, 0, 0.12)",
				"borderRadius": "4px",
				"boxShadow": "0px 3px 1px -2px rgba(0,0,0,0.2), 0px 2px 2px 0px rgba(0,0,0,0.14), 0px 1px 5px 0px rgba(0,0,0,0.12)"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"marginBottom": "10px"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "12px",
								"fontWeight": 500,
								"color": "rgba(0, 0, 0, 0.87)",
								"textTransform": "uppercase",
								"letterSpacing": "0.06em"
							}
						},
						"children": [
							"{title}"
						]
					}
				]
			},
			{
				"tag": "svg",
				"props": {
					"width": 200,
					"height": 80,
					"viewBox": "0 0 160 64",
					"xmlns": "http://www.w3.org/2000/svg"
				},
				"children": [
					{
						"ttIf": {
							"arg": "area",
							"then": {
								"tag": "polygon",
								"props": {
									"points": "4,48 28,36 52,42 76,26 100,32 124,14 152,20 152,60 4,60",
									"fill": {
										"ttMap": {
											"arg": "tone",
											"values": {
												"primary": "rgba(25, 118, 210, 0.18)",
												"success": "rgba(46, 125, 50, 0.18)",
												"warning": "rgba(237, 108, 2, 0.18)",
												"danger": "rgba(211, 47, 47, 0.18)",
												"info": "rgba(2, 136, 209, 0.18)",
												"neutral": "rgba(97, 97, 97, 0.18)"
											},
											"default": "rgba(25, 118, 210, 0.18)"
										}
									}
								}
							}
						}
					},
					{
						"tag": "line",
						"props": {
							"x1": 4,
							"y1": 60,
							"x2": 156,
							"y2": 60,
							"stroke": "rgba(0, 0, 0, 0.08)",
							"strokeWidth": 1
						}
					},
					{
						"tag": "polyline",
						"props": {
							"points": "4,48 28,36 52,42 76,26 100,32 124,14 152,20",
							"fill": "none",
							"stroke": {
								"ttMap": {
									"arg": "tone",
									"values": {
										"primary": "#1976d2",
										"success": "#2e7d32",
										"warning": "#ed6c02",
										"danger": "#d32f2f",
										"info": "#0288d1",
										"neutral": "#616161"
									},
									"default": "#1976d2"
								}
							},
							"strokeWidth": 2.5,
							"strokeLinecap": "round",
							"strokeLinejoin": "round"
						}
					},
					{
						"tag": "circle",
						"props": {
							"cx": 152,
							"cy": 20,
							"r": 3.5,
							"fill": {
								"ttMap": {
									"arg": "tone",
									"values": {
										"primary": "#1976d2",
										"success": "#2e7d32",
										"warning": "#ed6c02",
										"danger": "#d32f2f",
										"info": "#0288d1",
										"neutral": "#616161"
									},
									"default": "#1976d2"
								}
							},
							"stroke": "#ffffff",
							"strokeWidth": 1.5
						}
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"justifyContent": "space-between",
						"marginTop": "4px",
						"fontSize": "12px",
						"color": "rgba(0, 0, 0, 0.6)"
					}
				},
				"children": [
					{
						"tag": "span",
						"children": [
							"{min}"
						]
					},
					{
						"tag": "span",
						"children": [
							"{max}"
						]
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "data-viz-line",
	"source": {
		"kind": "archetype",
		"archetype": "data-viz",
		"variant": "line",
		"tranche": 2
	}
}
