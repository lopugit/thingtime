{
	"slug": "mui-stat-metric-comparison",
	"name": "Comparison Stat",
	"library": "mui",
	"category": "data-display",
	"description": "Two-value comparison card in the Material UI style — current figure in the tone color beside the previous figure, split by a vertical divider.",
	"tags": [
		"stat",
		"comparison",
		"versus",
		"card"
	],
	"args": [
		{
			"name": "leftLabel",
			"type": "string",
			"default": "This week",
			"label": "Left label",
			"maxLength": 24
		},
		{
			"name": "leftValue",
			"type": "string",
			"default": "1,284",
			"label": "Left value",
			"maxLength": 16
		},
		{
			"name": "rightLabel",
			"type": "string",
			"default": "Last week",
			"label": "Right label",
			"maxLength": 24
		},
		{
			"name": "rightValue",
			"type": "string",
			"default": "1,102",
			"label": "Right value",
			"maxLength": 16
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "inline-flex",
				"alignItems": "stretch",
				"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif",
				"background": "#ffffff",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "rgba(0, 0, 0, 0.12)",
				"borderRadius": "8px",
				"boxShadow": "0px 3px 1px -2px rgba(0,0,0,0.2), 0px 2px 2px 0px rgba(0,0,0,0.14), 0px 1px 5px 0px rgba(0,0,0,0.12)",
				"boxSizing": "border-box",
				"padding": "16px 20px",
				"gap": "18px"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"gap": "4px",
						"flex": "1 1 0",
						"minWidth": "90px"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "12px",
								"fontWeight": 400,
								"color": "rgba(0, 0, 0, 0.6)",
								"textTransform": "uppercase",
								"letterSpacing": "0.08em"
							}
						},
						"children": [
							"{leftLabel}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "20px",
								"fontWeight": 500,
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#1976d2",
											"success": "#2e7d32",
											"warning": "#ed6c02",
											"danger": "#d32f2f",
											"info": "#0288d1",
											"neutral": "#616161"
										},
										"default": "#1976d2"
									}
								},
								"lineHeight": 1.15,
								"fontVariantNumeric": "tabular-nums"
							}
						},
						"children": [
							"{leftValue}"
						]
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"width": "2px",
						"alignSelf": "stretch",
						"borderRadius": "999px",
						"background": "rgba(0, 0, 0, 0.08)",
						"flexShrink": 0
					}
				}
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"gap": "4px",
						"flex": "1 1 0",
						"minWidth": "90px"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "12px",
								"fontWeight": 400,
								"color": "rgba(0, 0, 0, 0.6)",
								"textTransform": "uppercase",
								"letterSpacing": "0.08em"
							}
						},
						"children": [
							"{rightLabel}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "20px",
								"fontWeight": 500,
								"color": "rgba(0, 0, 0, 0.87)",
								"lineHeight": 1.15,
								"fontVariantNumeric": "tabular-nums"
							}
						},
						"children": [
							"{rightValue}"
						]
					}
				]
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "stat-metric",
		"variant": "comparison",
		"tranche": 1
	}
}
