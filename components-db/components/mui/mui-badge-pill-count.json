{
	"slug": "mui-badge-pill-count",
	"name": "Count Badge",
	"library": "mui",
	"category": "data-display",
	"description": "Label with a count pill in the Material UI style — a muted label beside a solid tone pill carrying the number, for inbox and tab counters.",
	"tags": [
		"badge",
		"count",
		"pill",
		"notification"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Inbox",
			"label": "Label",
			"maxLength": 24
		},
		{
			"name": "count",
			"type": "string",
			"default": "24",
			"label": "Count",
			"maxLength": 6
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "inline-flex",
				"alignItems": "center",
				"gap": "8px",
				"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif"
			}
		},
		"children": [
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "13px",
						"fontWeight": 500,
						"color": "rgba(0, 0, 0, 0.87)"
					}
				},
				"children": [
					"{label}"
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"display": "inline-flex",
						"alignItems": "center",
						"justifyContent": "center",
						"minWidth": "20px",
						"height": "20px",
						"padding": "0 6px",
						"boxSizing": "border-box",
						"borderRadius": "999px",
						"background": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#1976d2",
									"success": "#2e7d32",
									"warning": "#ed6c02",
									"danger": "#d32f2f",
									"info": "#0288d1",
									"neutral": "#616161"
								},
								"default": "#1976d2"
							}
						},
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#ffffff",
									"success": "#ffffff",
									"warning": "#ffffff",
									"danger": "#ffffff",
									"info": "#ffffff",
									"neutral": "#ffffff"
								},
								"default": "#ffffff"
							}
						},
						"fontSize": "12px",
						"fontWeight": 700
					}
				},
				"children": [
					"{count}"
				]
			}
		]
	},
	"version": 1,
	"familyKey": "badge-pill-count",
	"source": {
		"kind": "archetype",
		"archetype": "badge",
		"variant": "pill-count",
		"tranche": 1
	}
}
