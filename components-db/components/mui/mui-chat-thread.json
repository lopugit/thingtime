{
	"slug": "mui-chat-thread",
	"name": "Chat Thread",
	"library": "mui",
	"category": "messaging",
	"description": "Short alternating conversation in the Material UI style — a date divider chip, incoming bubbles with an initials avatar, and tone-solid replies aligned to the right.",
	"tags": [
		"chat",
		"thread",
		"conversation",
		"messages"
	],
	"args": [
		{
			"name": "divider",
			"type": "string",
			"default": "Today",
			"label": "Date divider",
			"maxLength": 20
		},
		{
			"name": "initials",
			"type": "string",
			"default": "AL",
			"label": "Avatar initials",
			"maxLength": 3
		},
		{
			"name": "incoming",
			"type": "string",
			"default": "Are we still on for tonight?",
			"label": "First message",
			"maxLength": 120
		},
		{
			"name": "outgoing",
			"type": "string",
			"default": "Yes! See you at six.",
			"label": "Reply",
			"maxLength": 120
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"gap": "8px",
				"width": "300px",
				"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "center"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"background": "#fafafa",
								"color": "rgba(0, 0, 0, 0.6)",
								"fontSize": "12px",
								"fontWeight": 600,
								"padding": "2px 10px",
								"borderRadius": "999px"
							}
						},
						"children": [
							"{divider}"
						]
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "flex-end",
						"gap": "8px",
						"alignSelf": "flex-start"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"width": "28px",
								"height": "28px",
								"borderRadius": "999px",
								"background": "#eeeeee",
								"color": "#424242",
								"display": "flex",
								"alignItems": "center",
								"justifyContent": "center",
								"fontWeight": 600,
								"fontSize": "12px",
								"flexShrink": 0
							}
						},
						"children": [
							"{initials}"
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"padding": "8px 12px",
								"maxWidth": "220px",
								"fontSize": "14px",
								"lineHeight": 1.45,
								"background": "#fafafa",
								"color": "rgba(0, 0, 0, 0.87)",
								"borderRadius": "4px 4px 4px 4px"
							}
						},
						"children": [
							"{incoming}"
						]
					}
				]
			},
			{
				"tag": "div",
