{
	"slug": "mui-slider-progress-slider",
	"name": "Slider",
	"library": "mui",
	"category": "forms",
	"description": "Single-thumb slider in the Material UI style — filled track up to the percent value, a surface thumb with a tone-colored border, optional value bubble.",
	"tags": [
		"slider",
		"input",
		"range",
		"percent"
	],
	"args": [
		{
			"name": "percent",
			"type": "number",
			"default": 40,
			"label": "Value",
			"min": 0,
			"max": 100
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "showValue",
			"type": "boolean",
			"default": true,
			"label": "Show value bubble"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"ttMerge": [
					{
						"width": "240px",
						"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif",
						"paddingBottom": "8px"
					},
					{
						"ttIf": {
							"arg": "showValue",
							"then": {
								"paddingTop": "36px"
							},
							"else": {
								"paddingTop": "8px"
							}
						}
					}
				]
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"position": "relative",
						"height": "6px",
						"background": "rgba(0, 0, 0, 0.08)",
						"borderRadius": "999px"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"width": "{percent}%",
								"height": "100%",
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#1976d2",
											"success": "#2e7d32",
											"warning": "#ed6c02",
											"danger": "#d32f2f",
											"info": "#0288d1",
											"neutral": "#616161"
										},
										"default": "#1976d2"
									}
								},
								"borderRadius": "999px"
							}
						}
					},
					{
						"ttIf": {
							"arg": "showValue",
							"then": {
								"tag": "div",
								"props": {
									"style": {
										"position": "absolute",
										"left": "{percent}%",
										"top": "-32px",
										"transform": "translateX(-50%)",
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#1976d2",
													"success": "#2e7d32",
													"warning": "#ed6c02",
													"danger": "#d32f2f",
													"info": "#0288d1",
													"neutral": "#616161"
												},
												"default": "#1976d2"
											}
										},
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#ffffff",
													"success": "#ffffff",
													"warning": "#ffffff",
													"danger": "#ffffff",
													"info": "#ffffff",
													"neutral": "#ffffff"
												},
												"default": "#ffffff"
											}
										},
										"padding": "2px 8px",
										"borderRadius": "4px",
										"fontSize": "12px",
										"fontWeight": 500
									}
								},
								"children": [
									"{percent}"
								]
							}
						}
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"position": "absolute",
								"left": "{percent}%",
								"top": "50%",
								"transform": "translate(-50%, -50%)",
								"width": "16px",
								"height": "16px",
								"borderRadius": "999px",
								"background": "#ffffff",
								"borderWidth": "2px",
								"borderStyle": "solid",
								"borderColor": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#1976d2",
											"success": "#2e7d32",
											"warning": "#ed6c02",
											"danger": "#d32f2f",
											"info": "#0288d1",
											"neutral": "#616161"
										},
										"default": "#1976d2"
									}
								},
								"boxShadow": "0px 2px 1px -1px rgba(0,0,0,0.2), 0px 1px 1px 0px rgba(0,0,0,0.14), 0px 1px 3px 0px rgba(0,0,0,0.12)"
							}
						}
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "slider-progress-slider",
	"source": {
		"kind": "archetype",
		"archetype": "slider-progress",
		"variant": "slider",
		"tranche": 1
	}
}
