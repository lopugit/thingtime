{
	"slug": "mui-settings-danger",
	"name": "Danger Zone",
	"library": "mui",
	"category": "settings",
	"description": "Danger-zone settings card in the Material UI style — danger-tinted border and header, warning copy, a confirm-phrase field mock, and an outline-danger delete button beside a ghost cancel, with Material uppercase button labels.",
	"tags": [
		"settings",
		"danger",
		"delete",
		"confirm"
	],
	"args": [
		{
			"name": "heading",
			"type": "string",
			"default": "Danger zone",
			"label": "Heading",
			"maxLength": 30
		},
		{
			"name": "warning",
			"type": "text",
			"default": "Deleting this workspace removes every project, member, and file. This cannot be undone.",
			"label": "Warning copy",
			"maxLength": 160
		},
		{
			"name": "phrase",
			"type": "string",
			"default": "acme/workspace",
			"label": "Confirm phrase",
			"maxLength": 40
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"width": "320px",
				"boxSizing": "border-box",
				"background": "#ffffff",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "#ef9a9a",
				"borderRadius": "4px",
				"boxShadow": "0px 3px 1px -2px rgba(0,0,0,0.2), 0px 2px 2px 0px rgba(0,0,0,0.14), 0px 1px 5px 0px rgba(0,0,0,0.12)",
				"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif",
				"overflow": "hidden"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"padding": "10px 14px",
						"background": "#fdeded"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "13px",
								"fontWeight": 500,
								"color": "#5f2120"
							}
						},
						"children": [
							"{heading}"
						]
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"padding": "12px 14px",
						"gap": "10px"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "12px",
								"color": "rgba(0, 0, 0, 0.6)",
								"lineHeight": 1.5
							}
						},
						"children": [
							"{warning}"
						]
					},
					{
						"tag": "input",
						"props": {
							"type": "text",
							"placeholder": "Type {phrase} to confirm",
							"style": {
								"height": "30px",
								"boxSizing": "border-box",
								"width": "100%",
								"padding": "0 10px",
								"borderWidth": "1px",
								"borderStyle": "solid",
								"borderColor": "rgba(0, 0, 0, 0.12)",
								"borderRadius": "4px",
								"background": "#ffffff",
								"color": "rgba(0, 0, 0, 0.87)",
								"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif",
								"fontSize": "13px",
								"outline": "none"
							}
						}
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"gap": "8px"
							}
						},
						"children": [
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"display": "inline-flex",
										"alignItems": "center",
										"justifyContent": "center",
										"height": "30px",
										"padding": "0 12px",
										"borderRadius": "4px",
										"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif",
										"fontSize": "13px",
										"fontWeight": 500,
										"cursor": "pointer",
										"textTransform": "uppercase",
										"letterSpacing": "0.02857em",
										"background": "transparent",
										"borderWidth": "1px",
										"borderStyle": "solid",
										"borderColor": "#d32f2f",
										"color": "#d32f2f"
									}
								},
								"children": [
									"Delete workspace"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"display": "inline-flex",
										"alignItems": "center",
										"justifyContent": "center",
										"height": "30px",
										"padding": "0 12px",
										"borderRadius": "4px",
										"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif",
										"fontSize": "13px",
										"fontWeight": 500,
										"cursor": "pointer",
										"textTransform": "uppercase",
										"letterSpacing": "0.02857em",
										"background": "transparent",
										"border": "none",
										"color": "rgba(0, 0, 0, 0.6)"
									}
								},
								"children": [
									"Cancel"
								]
							}
						]
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "settings-danger",
	"source": {
		"kind": "archetype",
		"archetype": "settings",
		"variant": "danger",
		"tranche": 2
	}
}
