{
	"slug": "mui-stat-metric-sparkline",
	"name": "Sparkline Stat",
	"library": "mui",
	"category": "data-display",
	"description": "Stat card with an inline svg polyline sparkline in the Material UI style — tone-colored stroke with an optional soft area fill under the line.",
	"tags": [
		"stat",
		"sparkline",
		"chart",
		"svg"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Weekly sessions",
			"label": "Label",
			"maxLength": 40
		},
		{
			"name": "value",
			"type": "string",
			"default": "4,732",
			"label": "Value",
			"maxLength": 20
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "filled",
			"type": "boolean",
			"default": true,
			"label": "Area fill"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "inline-flex",
				"flexDirection": "column",
				"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif",
				"background": "#ffffff",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "rgba(0, 0, 0, 0.12)",
				"borderRadius": "8px",
				"boxShadow": "0px 3px 1px -2px rgba(0,0,0,0.2), 0px 2px 2px 0px rgba(0,0,0,0.14), 0px 1px 5px 0px rgba(0,0,0,0.12)",
				"boxSizing": "border-box",
				"padding": "16px 20px",
				"gap": "10px",
				"minWidth": "200px"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"gap": "4px"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "12px",
								"fontWeight": 400,
								"color": "rgba(0, 0, 0, 0.6)",
								"textTransform": "uppercase",
								"letterSpacing": "0.08em"
							}
						},
						"children": [
							"{label}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "24px",
								"fontWeight": 500,
								"color": "rgba(0, 0, 0, 0.87)",
								"lineHeight": 1.15,
								"fontVariantNumeric": "tabular-nums"
							}
						},
						"children": [
							"{value}"
						]
					}
				]
			},
			{
				"tag": "svg",
				"props": {
					"width": 128,
					"height": 32,
					"viewBox": "0 0 128 32",
					"fill": "none",
					"xmlns": "http://www.w3.org/2000/svg"
				},
				"children": [
					{
						"ttIf": {
							"arg": "filled",
							"then": {
								"tag": "polygon",
								"props": {
									"points": "0 26 16 20 32 24 48 12 64 17 80 8 96 14 112 4 128 10 128 32 0 32",
									"fill": {
										"ttMap": {
											"arg": "tone",
											"values": {
												"primary": "#e3f2fd",
												"success": "#edf7ed",
												"warning": "#fff4e5",
												"danger": "#fdeded",
												"info": "#e5f6fd",
												"neutral": "#eeeeee"
											},
											"default": "#e3f2fd"
										}
									}
								}
							}
						}
					},
					{
						"tag": "polyline",
						"props": {
							"points": "0 26 16 20 32 24 48 12 64 17 80 8 96 14 112 4 128 10",
							"stroke": {
								"ttMap": {
									"arg": "tone",
									"values": {
										"primary": "#1976d2",
										"success": "#2e7d32",
										"warning": "#ed6c02",
										"danger": "#d32f2f",
										"info": "#0288d1",
										"neutral": "#616161"
									},
									"default": "#1976d2"
								}
							},
							"strokeWidth": 2,
							"strokeLinecap": "round",
							"strokeLinejoin": "round"
						}
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "stat-metric-sparkline",
	"source": {
		"kind": "archetype",
		"archetype": "stat-metric",
		"variant": "sparkline",
		"tranche": 1
	}
}
