{
	"slug": "mui-tabs-steps-pills",
	"name": "Pill Tabs",
	"library": "mui",
	"category": "navigation",
	"description": "Pill-shaped tab row in the Material UI style — the active tab fills with the tone color while inactive tabs stay quiet text.",
	"tags": [
		"tabs",
		"navigation",
		"pills"
	],
	"args": [
		{
			"name": "tab1",
			"type": "string",
			"default": "Overview",
			"label": "Tab 1",
			"maxLength": 24
		},
		{
			"name": "tab2",
			"type": "string",
			"default": "Activity",
			"label": "Tab 2",
			"maxLength": 24
		},
		{
			"name": "tab3",
			"type": "string",
			"default": "Settings",
			"label": "Tab 3",
			"maxLength": 24
		},
		{
			"name": "active",
			"type": "enum",
			"values": [
				"1",
				"2",
				"3"
			],
			"default": "1",
			"label": "Active tab"
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"alignItems": "center",
				"gap": "6px",
				"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif"
			}
		},
		"children": [
			{
				"tag": "button",
				"props": {
					"type": "button",
					"style": {
						"border": "none",
						"background": {
							"ttIf": {
								"arg": "active",
								"equals": "1",
								"then": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#1976d2",
											"success": "#2e7d32",
											"warning": "#ed6c02",
											"danger": "#d32f2f",
											"info": "#0288d1",
											"neutral": "#616161"
										},
										"default": "#1976d2"
									}
								},
								"else": "transparent"
							}
						},
						"cursor": "pointer",
						"padding": "0 14px",
						"margin": 0,
						"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif",
						"fontWeight": 500,
						"textTransform": "uppercase",
						"letterSpacing": "0.02857em",
						"display": "inline-flex",
						"alignItems": "center",
						"justifyContent": "center",
						"height": "30px",
						"fontSize": "13px",
						"borderRadius": "999px",
						"color": {
							"ttIf": {
								"arg": "active",
								"equals": "1",
								"then": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#ffffff",
											"success": "#ffffff",
											"warning": "#ffffff",
											"danger": "#ffffff",
											"info": "#ffffff",
											"neutral": "#ffffff"
										},
										"default": "#ffffff"
									}
								},
								"else": "rgba(0, 0, 0, 0.6)"
							}
						},
						"boxShadow": {
							"ttIf": {
								"arg": "active",
								"equals": "1",
								"then": "0px 2px 1px -1px rgba(0,0,0,0.2), 0px 1px 1px 0px rgba(0,0,0,0.14), 0px 1px 3px 0px rgba(0,0,0,0.12)",
								"else": "none"
							}
						}
					}
				},
				"children": [
					"{tab1}"
				]
			},
			{
				"tag": "button",
				"props": {
					"type": "button",
					"style": {
						"border": "none",
						"background": {
							"ttIf": {
								"arg": "active",
