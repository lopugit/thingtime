						"borderRadius": "999px",
						"color": {
							"ttIf": {
								"arg": "active",
								"equals": "3",
								"then": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#ffffff",
											"success": "#ffffff",
											"warning": "#ffffff",
											"danger": "#ffffff",
											"info": "#ffffff",
											"neutral": "#ffffff"
										},
										"default": "#ffffff"
									}
								},
								"else": "rgba(0, 0, 0, 0.6)"
							}
						},
						"boxShadow": {
