						"color": {
							"ttIf": {
								"arg": "active",
								"equals": "2",
								"then": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#ffffff",
											"success": "#ffffff",
											"warning": "#ffffff",
											"danger": "#ffffff",
											"info": "#ffffff",
											"neutral": "#ffffff"
										},
										"default": "#ffffff"
									}
								},
								"else": "rgba(0, 0, 0, 0.6)"
							}
						},
						"boxShadow": {
							"ttIf": {
								"arg": "active",
								"equals": "2",
								"then": "0px 2px 1px -1px rgba(0,0,0,0.2), 0px 1px 1px 0px rgba(0,0,0,0.14), 0px 1px 3px 0px rgba(0,0,0,0.12)",
								"else": "none"
							}
						}
					}
				},
				"children": [
					"{tab2}"
				]
			},
			{
				"tag": "button",
				"props": {
					"type": "button",
					"style": {
						"border": "none",
						"background": {
							"ttIf": {
								"arg": "active",
								"equals": "3",
								"then": {
									"ttMap": {
										"arg": "tone",
										"values": {
