{
	"slug": "mui-marketing-cta",
	"name": "CTA Band",
	"library": "mui",
	"category": "marketing",
	"description": "Call-to-action band in the Material UI style — gradient or solid tone background with heading, subtext, and an inverted surface button.",
	"tags": [
		"marketing",
		"cta",
		"banner",
		"conversion"
	],
	"args": [
		{
			"name": "heading",
			"type": "string",
			"default": "Ready to dive in?",
			"label": "Heading",
			"maxLength": 60
		},
		{
			"name": "subtext",
			"type": "text",
			"default": "Free 14-day trial — no credit card required.",
			"label": "Subtext",
			"maxLength": 120
		},
		{
			"name": "buttonLabel",
			"type": "string",
			"default": "Create your account",
			"label": "Button label",
			"maxLength": 30
		},
		{
			"name": "gradient",
			"type": "boolean",
			"default": true,
			"label": "Gradient"
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"alignItems": "center",
				"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif",
				"padding": "24px 28px",
				"borderRadius": "8px",
				"background": {
					"ttIf": {
						"arg": "gradient",
						"then": "linear-gradient(135deg, #1976d2 0%, #0288d1 100%)",
						"else": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#1976d2",
									"success": "#2e7d32",
									"warning": "#ed6c02",
									"danger": "#d32f2f",
									"info": "#0288d1",
									"neutral": "#616161"
								},
								"default": "#1976d2"
							}
						}
					}
				},
				"color": {
					"ttIf": {
						"arg": "gradient",
						"then": "#ffffff",
						"else": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#ffffff",
									"success": "#ffffff",
									"warning": "#ffffff",
									"danger": "#ffffff",
									"info": "#ffffff",
									"neutral": "#ffffff"
								},
								"default": "#ffffff"
							}
						}
					}
				},
				"gap": "18px",
				"justifyContent": "space-between",
				"flexWrap": "wrap",
				"maxWidth": "560px",
				"boxShadow": "0px 3px 1px -2px rgba(0,0,0,0.2), 0px 2px 2px 0px rgba(0,0,0,0.14), 0px 1px 5px 0px rgba(0,0,0,0.12)",
				"boxSizing": "border-box"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"gap": "4px",
						"flex": "1 1 220px",
						"minWidth": "200px"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "20px",
								"fontWeight": 500
							}
						},
						"children": [
							"{heading}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "13px",
								"opacity": 0.85
							}
						},
						"children": [
							"{subtext}"
						]
					}
				]
			},
			{
				"tag": "button",
				"props": {
					"type": "button",
					"style": {
						"display": "inline-flex",
						"alignItems": "center",
						"justifyContent": "center",
						"gap": "8px",
						"border": "none",
						"height": "36px",
						"padding": "0 18px",
						"borderRadius": "4px",
						"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif",
						"fontWeight": 500,
						"fontSize": "14px",
						"cursor": "pointer",
						"textTransform": "uppercase",
						"letterSpacing": "0.02857em",
						"background": "#ffffff",
						"color": "rgba(0, 0, 0, 0.87)",
						"boxShadow": "0px 2px 1px -1px rgba(0,0,0,0.2), 0px 1px 1px 0px rgba(0,0,0,0.14), 0px 1px 3px 0px rgba(0,0,0,0.12)",
						"flexShrink": 0
					}
				},
				"children": [
					"{buttonLabel}"
				]
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "marketing",
		"variant": "cta",
		"tranche": 1
	}
}
