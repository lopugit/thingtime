{
	"slug": "mui-support-help-ticket",
	"name": "Support Ticket Row",
	"library": "mui",
	"category": "support",
	"description": "Support ticket queue row in the Material UI style — mono id chip, subject with requester caption, priority and status chips, and the assignee avatar on library-native corners.",
	"tags": [
		"support",
		"ticket",
		"queue",
		"row",
		"status"
	],
	"args": [
		{
			"name": "id",
			"type": "string",
			"default": "4821",
			"label": "Ticket #",
			"maxLength": 8
		},
		{
			"name": "subject",
			"type": "string",
			"default": "Cannot connect my calendar",
			"label": "Subject",
			"maxLength": 60
		},
		{
			"name": "requester",
			"type": "string",
			"default": "Dana P.",
			"label": "Requester",
			"maxLength": 24
		},
		{
			"name": "updated",
			"type": "string",
			"default": "2h ago",
			"label": "Updated",
			"maxLength": 16
		},
		{
			"name": "priority",
			"type": "enum",
			"values": [
				"low",
				"medium",
				"high",
				"urgent"
			],
			"default": "high",
			"label": "Priority"
		},
		{
			"name": "status",
			"type": "enum",
			"values": [
				"open",
				"waiting"
			],
			"default": "open",
			"label": "Status"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"ttMerge": [
					{
						"background": "#ffffff",
						"borderWidth": "1px",
						"borderStyle": "solid",
						"borderColor": "rgba(0, 0, 0, 0.12)",
						"borderRadius": "8px",
						"boxShadow": "0px 3px 1px -2px rgba(0,0,0,0.2), 0px 2px 2px 0px rgba(0,0,0,0.14), 0px 1px 5px 0px rgba(0,0,0,0.12)",
						"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif",
						"color": "rgba(0, 0, 0, 0.87)",
						"boxSizing": "border-box"
					},
					{
						"display": "flex",
						"alignItems": "center",
						"gap": "12px",
						"width": "430px",
						"padding": "10px 14px",
						"borderRadius": "4px"
					}
				]
			}
		},
		"children": [
			{
				"tag": "span",
				"props": {
					"style": {
						"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
						"fontSize": "12px",
						"color": "rgba(0, 0, 0, 0.6)",
						"background": "#fafafa",
						"padding": "2px 6px",
						"borderRadius": "4px",
						"borderWidth": "1px",
						"borderStyle": "solid",
						"borderColor": "rgba(0, 0, 0, 0.08)",
						"flexShrink": 0
					}
				},
				"children": [
					"#{id}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"gap": "2px",
						"flex": "1 1 auto",
						"minWidth": 0
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "13px",
								"fontWeight": 600,
								"color": "rgba(0, 0, 0, 0.87)",
								"whiteSpace": "nowrap",
								"overflow": "hidden",
								"textOverflow": "ellipsis"
							}
						},
						"children": [
							"{subject}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "12px",
								"color": "rgba(0, 0, 0, 0.6)"
							}
						},
						"children": [
							"{requester} · Updated {updated}"
						]
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"ttMerge": [
							{
								"display": "inline-flex",
								"alignItems": "center",
								"gap": "6px",
								"padding": "2px 8px",
								"fontSize": "12px",
								"fontWeight": 600,
								"lineHeight": 1.4,
								"borderRadius": "999px",
								"textTransform": "capitalize",
								"whiteSpace": "nowrap",
								"flexShrink": 0
							},
							{
								"background": {
									"ttMap": {
										"arg": "priority",
										"values": {
											"low": "#eeeeee",
											"medium": "#e5f6fd",
											"high": "#fff4e5",
											"urgent": "#fdeded"
										},
										"default": "#eeeeee"
									}
								},
								"color": {
									"ttMap": {
										"arg": "priority",
										"values": {
											"low": "#424242",
											"medium": "#014361",
											"high": "#663c00",
											"urgent": "#5f2120"
										},
										"default": "#424242"
									}
								}
							},
							{}
						]
					}
				},
				"children": [
					"{priority}"
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"ttMerge": [
							{
								"display": "inline-flex",
								"alignItems": "center",
								"gap": "6px",
								"padding": "2px 8px",
								"fontSize": "12px",
								"fontWeight": 600,
								"lineHeight": 1.4,
								"borderRadius": "999px",
								"textTransform": "capitalize",
								"whiteSpace": "nowrap",
								"flexShrink": 0
							},
							{
								"ttIf": {
									"arg": "status",
									"equals": "open",
									"then": {
										"background": "#e3f2fd",
										"color": "#1565c0"
									},
									"else": {
										"background": "#fafafa",
										"color": "rgba(0, 0, 0, 0.6)"
									}
								}
							}
						]
					}
				},
				"children": [
					"{status}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"width": "26px",
						"height": "26px",
						"borderRadius": "999px",
						"background": "#1976d2",
						"color": "#ffffff",
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "center",
						"fontWeight": 600,
						"fontSize": "12px",
						"flexShrink": 0
					}
				},
				"children": [
					"AK"
				]
			}
		]
	},
	"version": 1,
	"familyKey": "support-help-ticket",
	"source": {
		"kind": "archetype",
		"archetype": "support-help",
		"variant": "ticket",
		"tranche": 2
	}
}
