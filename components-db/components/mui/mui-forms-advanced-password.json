							"style": {
								"flex": 1,
								"height": "6px",
								"borderRadius": "999px",
								"background": {
									"ttMap": {
										"arg": "strength",
										"values": {
											"weak": "rgba(0, 0, 0, 0.08)",
											"fair": "rgba(0, 0, 0, 0.08)",
											"good": "#0288d1",
											"strong": "#2e7d32"
										},
										"default": "rgba(0, 0, 0, 0.08)"
									}
								}
							}
						}
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"flex": 1,
								"height": "6px",
								"borderRadius": "999px",
								"background": {
									"ttMap": {
										"arg": "strength",
										"values": {
											"weak": "rgba(0, 0, 0, 0.08)",
											"fair": "rgba(0, 0, 0, 0.08)",
											"good": "rgba(0, 0, 0, 0.08)",
											"strong": "#2e7d32"
										},
										"default": "rgba(0, 0, 0, 0.08)"
									}
								}
							}
						}
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "12px",
						"fontWeight": 500,
						"color": {
							"ttMap": {
								"arg": "strength",
								"values": {
									"weak": "#5f2120",
									"fair": "#663c00",
									"good": "#014361",
									"strong": "#1e4620"
								},
								"default": "rgba(0, 0, 0, 0.6)"
							}
						}
					}
				},
				"children": [
					{
						"ttMap": {
							"arg": "strength",
							"values": {
								"weak": "Too weak",
								"fair": "Could be stronger",
								"good": "Good password",
								"strong": "Strong password"
							},
