{
	"slug": "mui-forms-advanced-password",
	"name": "Password Strength Field",
	"library": "mui",
	"category": "forms",
	"description": "Password field in the Material UI style — masked dot glyphs inside the field plus a four-segment strength meter sweeping from danger to success with a matching caption.",
	"tags": [
		"form",
		"password",
		"strength",
		"security"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Password",
			"label": "Label",
			"maxLength": 30
		},
		{
			"name": "dots",
			"type": "number",
			"default": 8,
			"label": "Characters",
			"min": 1,
			"max": 12
		},
		{
			"name": "strength",
			"type": "enum",
			"values": [
				"weak",
				"fair",
				"good",
				"strong"
			],
			"default": "fair",
			"label": "Strength"
		},
		{
			"name": "focused",
			"type": "boolean",
			"default": false,
			"label": "Focused"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"gap": "6px",
				"width": "260px",
				"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif"
			}
		},
		"children": [
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "12px",
						"fontWeight": 600,
						"color": "rgba(0, 0, 0, 0.87)",
						"textTransform": "uppercase",
						"letterSpacing": "0.02857em"
					}
				},
				"children": [
					"{label}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"boxSizing": "border-box",
						"height": "36px",
						"padding": "0 12px",
						"background": "#fafafa",
						"borderWidth": "1px",
						"borderStyle": "solid",
						"borderColor": {
							"ttIf": {
								"arg": "focused",
								"then": "#1976d2",
								"else": "rgba(0, 0, 0, 0.12)"
							}
						},
						"borderRadius": "4px",
						"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif",
						"fontSize": "14px",
						"color": "rgba(0, 0, 0, 0.87)",
						"gap": "4px",
						"boxShadow": {
							"ttIf": {
								"arg": "focused",
								"then": "0 0 0 3px rgba(25, 118, 210, 0.18)",
								"else": "none"
							}
						}
					}
				},
				"children": [
					{
						"ttRepeat": {
							"arg": "dots",
							"max": 12,
							"node": {
								"tag": "span",
								"props": {
									"style": {
										"width": "6px",
										"height": "6px",
										"borderRadius": "999px",
										"background": "rgba(0, 0, 0, 0.87)",
										"flexShrink": 0
									}
								}
							}
						}
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "4px"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"flex": 1,
								"height": "6px",
								"borderRadius": "999px",
								"background": {
									"ttMap": {
										"arg": "strength",
										"values": {
											"weak": "#d32f2f",
											"fair": "#ed6c02",
											"good": "#0288d1",
											"strong": "#2e7d32"
										},
										"default": "rgba(0, 0, 0, 0.08)"
									}
								}
							}
						}
					},
					{
						"tag": "div",
						"props": {
							"style": {
