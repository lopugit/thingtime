{
	"slug": "mui-code-block-diff",
	"name": "Diff Viewer",
	"library": "mui",
	"category": "data-display",
	"description": "Diff viewer in the Material UI style — hunk header plus removed and added lines washed in the library's danger and success tints, with +/− counters in the file bar.",
	"tags": [
		"code",
		"diff",
		"review",
		"changes"
	],
	"args": [
		{
			"name": "filename",
			"type": "string",
			"default": "src/utils/total.ts",
			"label": "Filename",
			"maxLength": 60
		},
		{
			"name": "removed",
			"type": "string",
			"default": "var total = items.length",
			"label": "Removed line",
			"maxLength": 60
		},
		{
			"name": "added",
			"type": "string",
			"default": "const total = items.reduce(sum, 0)",
			"label": "Added line",
			"maxLength": 60
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "rgba(0, 0, 0, 0.12)",
				"borderRadius": "4px",
				"overflow": "hidden",
				"background": "#ffffff",
				"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
				"fontSize": "13px"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"padding": "8px 12px",
						"gap": "8px",
						"background": "#fafafa",
						"borderBottomWidth": "1px",
						"borderBottomStyle": "solid",
						"borderBottomColor": "rgba(0, 0, 0, 0.08)",
						"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "13px",
								"fontWeight": 600,
								"color": "rgba(0, 0, 0, 0.87)"
							}
						},
						"children": [
							"{filename}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"flex": 1
							}
						}
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "12px",
								"fontWeight": 700,
								"color": "#1e4620"
							}
						},
						"children": [
							"+2"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "12px",
								"fontWeight": 700,
								"color": "#5f2120"
							}
						},
						"children": [
							"−2"
						]
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"whiteSpace": "pre",
						"lineHeight": 1.7,
						"padding": "6px 0",
						"overflowX": "auto"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"padding": "2px 12px",
								"background": "#e5f6fd",
								"color": "#014361"
							}
						},
						"children": [
							"@@ -18,5 +18,5 @@"
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"padding": "2px 12px",
								"background": "#fdeded",
								"color": "#5f2120"
							}
						},
						"children": [
							"- {removed}"
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"padding": "2px 12px",
								"background": "#fdeded",
								"color": "#5f2120"
							}
						},
						"children": [
							"- console.log('total', total)"
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"padding": "2px 12px",
								"background": "#edf7ed",
								"color": "#1e4620"
							}
						},
						"children": [
							"+ {added}"
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"padding": "2px 12px",
								"background": "#edf7ed",
								"color": "#1e4620"
							}
						},
						"children": [
							"+ logger.debug(total)"
						]
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "code-block-diff",
	"source": {
		"kind": "archetype",
		"archetype": "code-block",
		"variant": "diff",
		"tranche": 2
	}
}
