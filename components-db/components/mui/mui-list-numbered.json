{
	"slug": "mui-list-numbered",
	"name": "Numbered List",
	"library": "mui",
	"category": "data-display",
	"description": "Ordered list in the Material UI style — hand-styled number markers (pill chips) on a tone tint beside each row.",
	"tags": [
		"list",
		"numbered",
		"ordered",
		"steps"
	],
	"args": [
		{
			"name": "item",
			"type": "string",
			"default": "Step",
			"label": "Item label",
			"maxLength": 40
		},
		{
			"name": "count",
			"type": "number",
			"default": 4,
			"label": "Rows",
			"min": 1,
			"max": 8
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "divided",
			"type": "boolean",
			"default": true,
			"label": "Dividers"
		}
	],
	"render": {
		"tag": "ol",
		"props": {
			"style": {
				"ttMerge": [
					{
						"listStyle": "none",
						"margin": 0,
						"padding": 0,
						"width": "280px",
						"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif",
						"color": "rgba(0, 0, 0, 0.87)",
						"background": "#ffffff",
						"borderRadius": "4px",
						"overflow": "hidden"
					},
					{
						"border": "1px solid rgba(0, 0, 0, 0.12)",
						"boxShadow": "0px 2px 1px -1px rgba(0,0,0,0.2), 0px 1px 1px 0px rgba(0,0,0,0.14), 0px 1px 3px 0px rgba(0,0,0,0.12)"
					}
				]
			}
		},
		"children": [
			{
				"ttRepeat": {
					"arg": "count",
					"max": 8,
					"node": {
						"tag": "li",
						"props": {
							"style": {
								"ttMerge": [
									{
										"display": "flex",
										"alignItems": "center",
										"gap": "12px",
										"padding": "10px 14px",
										"fontSize": "14px"
									},
									{
										"ttIf": {
											"arg": "divided",
											"then": {
												"ttIf": {
													"arg": "n",
													"equals": 1,
													"then": {},
													"else": {
														"borderTop": "1px solid rgba(0, 0, 0, 0.08)"
													}
												}
											},
											"else": {}
										}
									}
								]
							}
						},
						"children": [
							{
								"tag": "div",
								"props": {
									"style": {
										"width": "24px",
										"height": "24px",
										"borderRadius": "999px",
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#e3f2fd",
													"success": "#edf7ed",
													"warning": "#fff4e5",
													"danger": "#fdeded",
													"info": "#e5f6fd",
													"neutral": "#eeeeee"
												},
												"default": "#e3f2fd"
											}
										},
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#1565c0",
													"success": "#1e4620",
													"warning": "#663c00",
													"danger": "#5f2120",
													"info": "#014361",
													"neutral": "#424242"
												},
												"default": "#1565c0"
											}
										},
										"display": "flex",
										"alignItems": "center",
										"justifyContent": "center",
										"fontSize": "12px",
										"fontWeight": 700,
										"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif",
										"flexShrink": 0
									}
								},
								"children": [
									"{n}"
								]
							},
							"{item} {n}"
						]
					}
				}
			}
		]
	},
	"version": 1,
	"familyKey": "list-numbered",
	"source": {
		"kind": "archetype",
		"archetype": "list",
		"variant": "numbered",
		"tranche": 1
	}
}
