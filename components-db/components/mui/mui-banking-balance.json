{
	"slug": "mui-banking-balance",
	"name": "Balance Card",
	"library": "mui",
	"category": "finance",
	"description": "Account balance card in the Material UI style — total-balance caption over a large figure, a trend chip that flips success/danger with direction, masked account line and ghost Send / Top up actions.",
	"tags": [
		"banking",
		"balance",
		"finance",
		"card"
	],
	"args": [
		{
			"name": "amount",
			"type": "string",
			"default": "$24,562.80",
			"label": "Amount",
			"maxLength": 16
		},
		{
			"name": "change",
			"type": "string",
			"default": "4.2",
			"label": "Change %",
			"maxLength": 8
		},
		{
			"name": "up",
			"type": "boolean",
			"default": true,
			"label": "Trending up"
		},
		{
			"name": "mask",
			"type": "string",
			"default": "4821",
			"label": "Account last 4",
			"maxLength": 6
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"boxSizing": "border-box",
				"width": "320px",
				"padding": "20px",
				"background": "#ffffff",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "rgba(0, 0, 0, 0.12)",
				"borderRadius": "8px",
				"boxShadow": "0px 3px 1px -2px rgba(0,0,0,0.2), 0px 2px 2px 0px rgba(0,0,0,0.14), 0px 1px 5px 0px rgba(0,0,0,0.12)",
				"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif",
				"color": "rgba(0, 0, 0, 0.87)",
				"gap": "8px"
			}
		},
		"children": [
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "12px",
						"fontWeight": 500,
						"color": "rgba(0, 0, 0, 0.6)",
						"textTransform": "uppercase",
						"letterSpacing": "0.06em"
					}
				},
				"children": [
					"Total balance"
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "28px",
						"fontWeight": 500,
						"lineHeight": 1.1,
						"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif",
						"color": "rgba(0, 0, 0, 0.87)"
					}
				},
				"children": [
					"{amount}"
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"ttMerge": [
							{
								"display": "inline-flex",
								"alignItems": "center",
								"alignSelf": "flex-start",
								"padding": "3px 10px",
								"borderRadius": "999px",
								"fontSize": "12px",
								"fontWeight": 600
							},
							{
								"ttIf": {
									"arg": "up",
									"then": {
										"background": "#edf7ed",
										"color": "#1e4620"
									},
									"else": {
										"background": "#fdeded",
										"color": "#5f2120"
									}
								}
							}
						]
					}
				},
				"children": [
					{
						"ttIf": {
							"arg": "up",
							"then": "+{change}% this month",
							"else": "-{change}% this month"
						}
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "13px",
						"color": "rgba(0, 0, 0, 0.6)",
						"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
					}
				},
				"children": [
					"•••• {mask}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "8px",
						"marginTop": "6px"
					}
				},
				"children": [
					{
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"display": "inline-flex",
								"alignItems": "center",
								"justifyContent": "center",
								"flex": 1,
								"height": "30px",
								"padding": "0 12px",
								"border": "none",
								"background": "transparent",
								"borderRadius": "4px",
								"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif",
								"fontWeight": 500,
								"fontSize": "13px",
								"color": "#1976d2",
								"cursor": "pointer",
								"textTransform": "uppercase",
								"letterSpacing": "0.02857em"
							}
						},
						"children": [
							"Send"
						]
					},
					{
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"display": "inline-flex",
								"alignItems": "center",
								"justifyContent": "center",
								"flex": 1,
								"height": "30px",
								"padding": "0 12px",
								"border": "none",
								"background": "transparent",
								"borderRadius": "4px",
								"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif",
								"fontWeight": 500,
								"fontSize": "13px",
								"color": "#1976d2",
								"cursor": "pointer",
								"textTransform": "uppercase",
								"letterSpacing": "0.02857em"
							}
						},
						"children": [
							"Top up"
						]
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "banking-balance",
	"source": {
		"kind": "archetype",
		"archetype": "banking",
		"variant": "balance",
		"tranche": 2
	}
}
