{
	"slug": "mui-card-media",
	"name": "Media Card",
	"library": "mui",
	"category": "layout",
	"description": "Card with a media block in the Material UI style — a tone-gradient placeholder banner over a badge, title and body.",
	"tags": [
		"card",
		"media",
		"image",
		"banner"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Golden hour",
			"label": "Title",
			"maxLength": 60
		},
		{
			"name": "body",
			"type": "text",
			"default": "A placeholder media block stands in for imagery — no external assets needed.",
			"label": "Body"
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "mediaHeight",
			"type": "enum",
			"values": [
				"sm",
				"md",
				"lg"
			],
			"default": "md",
			"label": "Media height"
		},
		{
			"name": "badge",
			"type": "string",
			"default": "New",
			"label": "Badge",
			"maxLength": 20
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"width": "300px",
				"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif",
				"background": "#ffffff",
				"color": "rgba(0, 0, 0, 0.87)",
				"border": "1px solid rgba(0, 0, 0, 0.12)",
				"borderRadius": "4px",
				"boxShadow": "0px 2px 1px -1px rgba(0,0,0,0.2), 0px 1px 1px 0px rgba(0,0,0,0.14), 0px 1px 3px 0px rgba(0,0,0,0.12)",
				"overflow": "hidden",
				"boxSizing": "border-box"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"ttMerge": [
							{
								"display": "flex",
								"alignItems": "center",
								"justifyContent": "center",
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "linear-gradient(135deg, #e3f2fd 0%, #90caf9 60%, #1976d2 140%)",
											"success": "linear-gradient(135deg, #edf7ed 0%, #a5d6a7 60%, #2e7d32 140%)",
											"warning": "linear-gradient(135deg, #fff4e5 0%, #ffb74d 60%, #ed6c02 140%)",
											"danger": "linear-gradient(135deg, #fdeded 0%, #ef9a9a 60%, #d32f2f 140%)",
											"info": "linear-gradient(135deg, #e5f6fd 0%, #81d4fa 60%, #0288d1 140%)",
											"neutral": "linear-gradient(135deg, #eeeeee 0%, #bdbdbd 60%, #616161 140%)"
										},
										"default": "linear-gradient(135deg, #e3f2fd 0%, #90caf9 60%, #1976d2 140%)"
									}
								}
							},
							{
								"ttMap": {
									"arg": "mediaHeight",
									"values": {
										"sm": {
											"height": "72px"
										},
										"md": {
											"height": "112px"
										},
										"lg": {
											"height": "152px"
										}
									},
									"default": {
										"height": "112px"
									}
								}
							}
						]
					}
				},
				"children": [
					{
						"tag": "svg",
						"props": {
							"width": 28,
							"height": 28,
							"viewBox": "0 0 24 24",
							"fill": "none",
							"stroke": {
								"ttMap": {
									"arg": "tone",
									"values": {
										"primary": "#1565c0",
										"success": "#1e4620",
										"warning": "#663c00",
										"danger": "#5f2120",
										"info": "#014361",
										"neutral": "#424242"
									},
									"default": "#1565c0"
								}
							},
							"strokeWidth": 2,
							"strokeLinecap": "round",
							"strokeLinejoin": "round",
							"xmlns": "http://www.w3.org/2000/svg"
						},
						"children": [
							{
								"tag": "rect",
								"props": {
									"x": 3,
									"y": 3,
									"width": 18,
									"height": 18,
									"rx": 2
								}
							},
							{
								"tag": "circle",
								"props": {
									"cx": 8.5,
									"cy": 8.5,
									"r": 1.5
								}
							},
							{
								"tag": "polyline",
								"props": {
									"points": "21 15 16 10 5 21"
								}
							}
						]
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"padding": "16px",
						"gap": "8px"
					}
				},
				"children": [
					{
						"ttIf": {
							"arg": "badge",
							"then": {
								"tag": "span",
								"props": {
									"style": {
										"alignSelf": "flex-start",
										"padding": "2px 8px",
										"borderRadius": "999px",
										"fontSize": "12px",
										"fontWeight": 600,
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#e3f2fd",
													"success": "#edf7ed",
													"warning": "#fff4e5",
													"danger": "#fdeded",
													"info": "#e5f6fd",
													"neutral": "#eeeeee"
												},
												"default": "#e3f2fd"
											}
										},
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#1565c0",
													"success": "#1e4620",
													"warning": "#663c00",
													"danger": "#5f2120",
													"info": "#014361",
													"neutral": "#424242"
												},
												"default": "#1565c0"
											}
										},
										"border": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "1px solid #90caf9",
													"success": "1px solid #a5d6a7",
													"warning": "1px solid #ffb74d",
													"danger": "1px solid #ef9a9a",
													"info": "1px solid #81d4fa",
													"neutral": "1px solid #bdbdbd"
												},
												"default": "1px solid #90caf9"
											}
										}
									}
								},
								"children": [
									"{badge}"
								]
							}
						}
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "16px",
								"fontWeight": 500,
								"color": "rgba(0, 0, 0, 0.87)"
							}
						},
						"children": [
							"{title}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "13px",
								"color": "rgba(0, 0, 0, 0.6)",
								"lineHeight": 1.5
							}
						},
						"children": [
							"{body}"
						]
					}
				]
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "card",
		"variant": "media",
		"tranche": 1
	}
}
