{
	"slug": "mui-chat-bubble",
	"name": "Message Bubble Pair",
	"library": "mui",
	"category": "messaging",
	"description": "Incoming and outgoing chat bubbles in the Material UI style — quiet surface on the left, tone-solid reply on the right, library-native corners with a sharp tail edge and a timestamp.",
	"tags": [
		"chat",
		"message",
		"bubble",
		"conversation"
	],
	"args": [
		{
			"name": "incoming",
			"type": "string",
			"default": "Hey! Did you see the launch?",
			"label": "Incoming message",
			"maxLength": 120
		},
		{
			"name": "outgoing",
			"type": "string",
			"default": "Just saw it — looks great!",
			"label": "Outgoing message",
			"maxLength": 120
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "time",
			"type": "string",
			"default": "9:41 AM",
			"label": "Timestamp",
			"maxLength": 12
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"gap": "6px",
				"width": "280px",
				"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"padding": "8px 12px",
						"maxWidth": "220px",
						"fontSize": "14px",
						"lineHeight": 1.45,
						"background": "#fafafa",
						"color": "rgba(0, 0, 0, 0.87)",
						"borderRadius": "4px 4px 4px 4px",
						"alignSelf": "flex-start"
					}
				},
				"children": [
					"{incoming}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"padding": "8px 12px",
						"maxWidth": "220px",
						"fontSize": "14px",
						"lineHeight": 1.45,
						"background": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#1976d2",
									"success": "#2e7d32",
									"warning": "#ed6c02",
									"danger": "#d32f2f",
									"info": "#0288d1",
									"neutral": "#616161"
								},
								"default": "#1976d2"
							}
						},
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#ffffff",
									"success": "#ffffff",
									"warning": "#ffffff",
									"danger": "#ffffff",
									"info": "#ffffff",
									"neutral": "#ffffff"
								},
								"default": "#ffffff"
							}
						},
						"borderRadius": "4px 4px 4px 4px",
						"boxShadow": "0px 2px 1px -1px rgba(0,0,0,0.2), 0px 1px 1px 0px rgba(0,0,0,0.14), 0px 1px 3px 0px rgba(0,0,0,0.12)",
						"alignSelf": "flex-end"
					}
				},
				"children": [
					"{outgoing}"
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"alignSelf": "flex-end",
						"fontSize": "12px",
						"color": "rgba(0, 0, 0, 0.6)"
					}
				},
				"children": [
					"{time}"
				]
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "chat",
		"variant": "bubble",
		"tranche": 2
	}
}
