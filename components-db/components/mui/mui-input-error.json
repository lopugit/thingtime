{
	"slug": "mui-input-error",
	"name": "Error Input",
	"library": "mui",
	"category": "forms",
	"description": "Invalid text field in the Material UI style — danger border with an optional soft error glow, and an alert icon beside the message.",
	"tags": [
		"input",
		"error",
		"invalid",
		"validation",
		"form"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Email",
			"label": "Label",
			"maxLength": 40
		},
		{
			"name": "value",
			"type": "string",
			"default": "not-an-email",
			"label": "Value",
			"maxLength": 60
		},
		{
			"name": "message",
			"type": "string",
			"default": "Enter a valid email address.",
			"label": "Message",
			"maxLength": 80
		},
		{
			"name": "ring",
			"type": "boolean",
			"default": true,
			"label": "Error ring"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"gap": "6px",
				"width": "260px",
				"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif"
			}
		},
		"children": [
			{
				"tag": "label",
				"props": {
					"style": {
						"fontSize": "13px",
						"fontWeight": 500,
						"color": "rgba(0, 0, 0, 0.87)",
						"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif"
					}
				},
				"children": [
					"{label}"
				]
			},
			{
				"tag": "input",
				"props": {
					"type": "text",
					"value": "{value}",
					"style": {
						"ttMerge": [
							{
								"width": "100%",
								"padding": "0 12px",
								"border": "1px solid rgba(0, 0, 0, 0.12)",
								"borderRadius": "4px",
								"background": "#ffffff",
								"color": "rgba(0, 0, 0, 0.87)",
								"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif",
								"outline": "none",
								"boxSizing": "border-box"
							},
							{
								"height": "36px",
								"fontSize": "14px",
								"border": "1px solid #d32f2f"
							},
							{
								"ttIf": {
									"arg": "ring",
									"then": {
										"boxShadow": "0 0 0 3px #fdeded"
									},
									"else": {}
								}
							}
						]
					}
				}
			},
			{
				"ttIf": {
					"arg": "message",
					"then": {
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"gap": "6px"
							}
						},
						"children": [
							{
								"tag": "svg",
								"props": {
									"width": 13,
									"height": 13,
									"viewBox": "0 0 24 24",
									"fill": "none",
									"stroke": "#d32f2f",
									"strokeWidth": 2,
									"strokeLinecap": "round",
									"strokeLinejoin": "round",
									"xmlns": "http://www.w3.org/2000/svg"
								},
								"children": [
									{
										"tag": "path",
										"props": {
											"d": "M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"
										}
									},
									{
										"tag": "line",
										"props": {
											"x1": 12,
											"y1": 9,
											"x2": 12,
											"y2": 13
										}
									},
									{
										"tag": "line",
										"props": {
											"x1": 12,
											"y1": 17,
											"x2": 12.01,
											"y2": 17
										}
									}
								]
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "12px",
										"color": "#d32f2f"
									}
								},
								"children": [
									"{message}"
								]
							}
						]
					}
				}
			}
		]
	},
	"version": 1,
	"familyKey": "input-error",
	"source": {
		"kind": "archetype",
		"archetype": "input",
		"variant": "error",
		"tranche": 1
	}
}
