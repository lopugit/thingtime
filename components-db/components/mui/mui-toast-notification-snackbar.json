{
	"slug": "mui-toast-notification-snackbar",
	"name": "Snackbar",
	"library": "mui",
	"category": "feedback",
	"description": "Dark snackbar bar in the Material UI style — inverse ink surface with the message on the left and a tone-tinted action link (uppercase, Material-style) on the right.",
	"tags": [
		"snackbar",
		"toast",
		"feedback",
		"action"
	],
	"args": [
		{
			"name": "message",
			"type": "string",
			"default": "Conversation archived",
			"label": "Message",
			"maxLength": 60
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Undo",
			"label": "Action label",
			"maxLength": 24
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "showClose",
			"type": "boolean",
			"default": false,
			"label": "Show close"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"alignItems": "center",
				"gap": "16px",
				"justifyContent": "space-between",
				"minWidth": "300px",
				"padding": "10px 16px",
				"background": "rgba(0, 0, 0, 0.87)",
				"color": "#ffffff",
				"borderRadius": "4px",
				"boxShadow": "0px 3px 5px -1px rgba(0,0,0,0.2), 0px 6px 10px 0px rgba(0,0,0,0.14), 0px 1px 18px 0px rgba(0,0,0,0.12)",
				"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif",
				"fontSize": "13px"
			}
		},
		"children": [
			{
				"tag": "span",
				"props": {
					"style": {
						"fontWeight": 400
					}
				},
				"children": [
					"{message}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "12px"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#90caf9",
											"success": "#a5d6a7",
											"warning": "#ffb74d",
											"danger": "#ef9a9a",
											"info": "#81d4fa",
											"neutral": "#bdbdbd"
										},
										"default": "#90caf9"
									}
								},
								"fontWeight": 600,
								"cursor": "pointer",
								"textTransform": "uppercase",
								"letterSpacing": "0.02857em"
							}
						},
						"children": [
							"{actionLabel}"
						]
					},
					{
						"ttIf": {
							"arg": "showClose",
							"then": {
								"tag": "span",
								"props": {
									"style": {
										"display": "inline-flex",
										"color": "rgba(0, 0, 0, 0.12)",
										"cursor": "pointer"
									}
								},
								"children": [
									{
										"tag": "svg",
										"props": {
											"width": 14,
											"height": 14,
											"viewBox": "0 0 24 24",
											"fill": "none",
											"stroke": "currentColor",
											"strokeWidth": 2,
											"strokeLinecap": "round",
											"strokeLinejoin": "round",
											"xmlns": "http://www.w3.org/2000/svg"
										},
										"children": [
											{
												"tag": "line",
												"props": {
													"x1": 18,
													"y1": 6,
													"x2": 6,
													"y2": 18
												}
											},
											{
												"tag": "line",
												"props": {
													"x1": 6,
													"y1": 6,
													"x2": 18,
													"y2": 18
												}
											}
										]
									}
								]
							}
						}
					}
				]
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "toast-notification",
		"variant": "snackbar",
		"tranche": 1
	}
}
