{
	"slug": "mui-tooltip-popover-popover",
	"name": "Popover",
	"library": "mui",
	"category": "overlays",
	"description": "Titled popover in the Material UI style — elevated surface card anchored below its trigger with an arrow caret, heading, body copy, and an optional tone action button.",
	"tags": [
		"popover",
		"overlay",
		"card",
		"anchored"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Share this view",
			"label": "Title",
			"maxLength": 50
		},
		{
			"name": "body",
			"type": "text",
			"default": "Anyone with the link can see live updates. Manage access anytime from settings.",
			"label": "Body"
		},
		{
			"name": "triggerLabel",
			"type": "string",
			"default": "Share",
			"label": "Trigger label",
			"maxLength": 24
		},
		{
			"name": "showAction",
			"type": "boolean",
			"default": true,
			"label": "Show action"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Copy link",
			"label": "Action label",
			"maxLength": 24
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "inline-flex",
				"flexDirection": "column",
				"alignItems": "flex-start",
				"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif"
			}
		},
		"children": [
			{
				"tag": "button",
				"props": {
					"type": "button",
					"style": {
						"display": "inline-flex",
						"alignItems": "center",
						"justifyContent": "center",
						"gap": "6px",
						"height": "36px",
						"padding": "0 14px",
						"background": "#ffffff",
						"color": "rgba(0, 0, 0, 0.87)",
						"border": "1px solid rgba(0, 0, 0, 0.12)",
						"borderRadius": "4px",
						"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif",
						"fontSize": "13px",
						"fontWeight": 500,
						"boxShadow": "0px 2px 1px -1px rgba(0,0,0,0.2), 0px 1px 1px 0px rgba(0,0,0,0.14), 0px 1px 3px 0px rgba(0,0,0,0.12)",
						"cursor": "pointer",
						"textTransform": "uppercase",
						"letterSpacing": "0.02857em"
					}
				},
				"children": [
					"{triggerLabel}",
					{
						"tag": "svg",
						"props": {
							"width": 14,
							"height": 14,
							"viewBox": "0 0 24 24",
							"fill": "none",
							"stroke": "currentColor",
							"strokeWidth": 2,
							"strokeLinecap": "round",
							"strokeLinejoin": "round",
							"xmlns": "http://www.w3.org/2000/svg"
						},
						"children": [
							{
								"tag": "polyline",
								"props": {
									"points": "6 9 12 15 18 9"
								}
							}
						]
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"alignItems": "flex-start",
						"marginTop": "3px"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"marginLeft": "18px"
							}
						},
						"children": [
							{
								"tag": "div",
								"props": {
									"style": {
										"width": 0,
										"height": 0,
										"borderLeft": "6px solid transparent",
										"borderRight": "6px solid transparent",
										"borderBottom": "6px solid rgba(0, 0, 0, 0.12)"
									}
								}
							}
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"flexDirection": "column",
								"gap": "8px",
								"width": "270px",
								"padding": "14px 16px",
								"background": "#ffffff",
								"border": "1px solid rgba(0, 0, 0, 0.12)",
								"borderRadius": "8px",
								"boxShadow": "0px 3px 5px -1px rgba(0,0,0,0.2), 0px 6px 10px 0px rgba(0,0,0,0.14), 0px 1px 18px 0px rgba(0,0,0,0.12)",
								"color": "rgba(0, 0, 0, 0.87)"
							}
						},
						"children": [
							{
								"tag": "span",
								"props": {
									"style": {
										"fontWeight": 500,
										"fontSize": "14px"
									}
								},
								"children": [
									"{title}"
								]
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "13px",
										"color": "rgba(0, 0, 0, 0.6)",
										"lineHeight": 1.5
									}
								},
								"children": [
									"{body}"
								]
							},
							{
								"ttIf": {
									"arg": "showAction",
									"then": {
										"tag": "button",
										"props": {
											"type": "button",
											"style": {
												"alignSelf": "flex-start",
												"display": "inline-flex",
												"alignItems": "center",
												"justifyContent": "center",
												"height": "30px",
												"padding": "0 12px",
												"border": "none",
												"borderRadius": "4px",
												"background": {
													"ttMap": {
														"arg": "tone",
														"values": {
															"primary": "#1976d2",
															"success": "#2e7d32",
															"warning": "#ed6c02",
															"danger": "#d32f2f",
															"info": "#0288d1",
															"neutral": "#616161"
														},
														"default": "#1976d2"
													}
												},
												"color": {
													"ttMap": {
														"arg": "tone",
														"values": {
															"primary": "#ffffff",
															"success": "#ffffff",
															"warning": "#ffffff",
															"danger": "#ffffff",
															"info": "#ffffff",
															"neutral": "#ffffff"
														},
														"default": "#ffffff"
													}
												},
												"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif",
												"fontSize": "13px",
												"fontWeight": 500,
												"cursor": "pointer",
												"marginTop": "2px",
												"textTransform": "uppercase",
												"letterSpacing": "0.02857em"
											}
										},
										"children": [
											"{actionLabel}"
										]
									}
								}
							}
						]
					}
				]
			}
		]
	},
	"previewBg": "#f5f5f5",
	"version": 1,
	"familyKey": "tooltip-popover-popover",
	"source": {
		"kind": "archetype",
		"archetype": "tooltip-popover",
		"variant": "popover",
		"tranche": 1
	}
}
