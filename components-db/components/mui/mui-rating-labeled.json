{
	"slug": "mui-rating-labeled",
	"name": "Labeled Rating",
	"library": "mui",
	"category": "data-display",
	"description": "Star rating with a score readout in the Material UI style — calc-clipped tone stars beside an “out of 5” figure and a muted review count, for product cards and listings.",
	"tags": [
		"rating",
		"stars",
		"reviews",
		"score"
	],
	"args": [
		{
			"name": "score",
			"type": "number",
			"default": 4.3,
			"label": "Score (0–5)",
			"min": 0,
			"max": 5
		},
		{
			"name": "reviews",
			"type": "string",
			"default": "1,284",
			"label": "Review count",
			"maxLength": 12
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "warning",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "inline-flex",
				"alignItems": "center",
				"gap": "10px",
				"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"position": "relative",
						"display": "inline-flex"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"gap": "0px"
							}
						},
						"children": [
							{
								"ttRepeat": {
									"count": 5,
									"max": 5,
									"node": {
										"tag": "svg",
										"props": {
											"width": 20,
											"height": 20,
											"viewBox": "0 0 24 24",
											"fill": "none",
											"stroke": "rgba(0, 0, 0, 0.38)",
											"strokeWidth": 2,
											"strokeLinejoin": "round",
											"xmlns": "http://www.w3.org/2000/svg"
										},
										"children": [
											{
												"tag": "polygon",
												"props": {
													"points": "12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26"
												}
											}
										]
									}
								}
							}
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"position": "absolute",
								"top": "0px",
								"left": "0px",
								"height": "100%",
								"width": "calc({score} * 20px)",
								"overflow": "hidden",
								"whiteSpace": "nowrap"
							}
						},
						"children": [
							{
								"tag": "div",
								"props": {
									"style": {
										"display": "flex",
										"alignItems": "center",
										"gap": "0px",
										"width": "100px",
										"flexShrink": 0
									}
								},
								"children": [
									{
										"ttRepeat": {
											"count": 5,
											"max": 5,
											"node": {
												"tag": "svg",
												"props": {
													"width": 20,
													"height": 20,
													"viewBox": "0 0 24 24",
													"fill": {
														"ttMap": {
															"arg": "tone",
															"values": {
																"primary": "#1976d2",
																"success": "#2e7d32",
																"warning": "#ed6c02",
																"danger": "#d32f2f",
																"info": "#0288d1",
																"neutral": "#616161"
															},
															"default": "#ed6c02"
														}
													},
													"stroke": {
														"ttMap": {
															"arg": "tone",
															"values": {
																"primary": "#1976d2",
																"success": "#2e7d32",
																"warning": "#ed6c02",
																"danger": "#d32f2f",
																"info": "#0288d1",
																"neutral": "#616161"
															},
															"default": "#ed6c02"
														}
													},
													"strokeWidth": 2,
													"strokeLinejoin": "round",
													"xmlns": "http://www.w3.org/2000/svg"
												},
												"children": [
													{
														"tag": "polygon",
														"props": {
															"points": "12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26"
														}
													}
												]
											}
										}
									}
								]
							}
						]
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "14px",
						"fontWeight": 600,
						"color": "rgba(0, 0, 0, 0.87)"
					}
				},
				"children": [
					"{score} out of 5"
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "13px",
						"color": "rgba(0, 0, 0, 0.6)"
					}
				},
				"children": [
					"({reviews} reviews)"
				]
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "rating",
		"variant": "labeled",
		"tranche": 2
	}
}
