{
	"slug": "mui-card-basic",
	"name": "Basic Card",
	"library": "mui",
	"category": "layout",
	"description": "Simple padded content card in the Material UI style — tone-colored eyebrow, heading and muted body on one bordered library surface.",
	"tags": [
		"card",
		"surface",
		"content"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Card title",
			"label": "Title",
			"maxLength": 60
		},
		{
			"name": "body",
			"type": "text",
			"default": "Cards group related content and actions onto one calm surface.",
			"label": "Body"
		},
		{
			"name": "eyebrow",
			"type": "string",
			"default": "Overview",
			"label": "Eyebrow",
			"maxLength": 30
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"width": "300px",
				"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif",
				"background": "#ffffff",
				"color": "rgba(0, 0, 0, 0.87)",
				"border": "1px solid rgba(0, 0, 0, 0.12)",
				"borderRadius": "4px",
				"boxShadow": "0px 2px 1px -1px rgba(0,0,0,0.2), 0px 1px 1px 0px rgba(0,0,0,0.14), 0px 1px 3px 0px rgba(0,0,0,0.12)",
				"overflow": "hidden",
				"boxSizing": "border-box",
				"padding": "16px",
				"gap": "8px"
			}
		},
		"children": [
			{
				"ttIf": {
					"arg": "eyebrow",
					"then": {
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "12px",
								"fontWeight": 600,
								"textTransform": "uppercase",
								"letterSpacing": "0.06em",
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#1976d2",
											"success": "#2e7d32",
											"warning": "#ed6c02",
											"danger": "#d32f2f",
											"info": "#0288d1",
											"neutral": "#616161"
										},
										"default": "#1976d2"
									}
								}
							}
						},
						"children": [
							"{eyebrow}"
						]
					}
				}
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "16px",
						"fontWeight": 500,
						"color": "rgba(0, 0, 0, 0.87)"
					}
				},
				"children": [
					"{title}"
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "13px",
						"color": "rgba(0, 0, 0, 0.6)",
						"lineHeight": 1.5
					}
				},
				"children": [
					"{body}"
				]
			}
		]
	},
	"version": 1,
	"familyKey": "card-basic",
	"source": {
		"kind": "archetype",
		"archetype": "card",
		"variant": "basic",
		"tranche": 1
	}
}
