														"fontSize": "12px",
														"fontWeight": 700,
														"textTransform": "uppercase",
														"letterSpacing": "0.04em"
													}
												},
												"children": [
													"latest"
												]
											}
										]
									},
									{
										"tag": "svg",
										"props": {
											"width": 14,
											"height": 14,
											"viewBox": "0 0 24 24",
											"fill": "none",
											"stroke": {
												"ttMap": {
													"arg": "tone",
