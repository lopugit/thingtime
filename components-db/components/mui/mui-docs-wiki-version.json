													"style": {
														"display": "inline-flex",
														"alignItems": "center",
														"padding": "1px 7px",
														"borderRadius": "999px",
														"background": {
															"ttMap": {
																"arg": "tone",
																"values": {
																	"primary": "#e3f2fd",
																	"success": "#edf7ed",
																	"warning": "#fff4e5",
																	"danger": "#fdeded",
																	"info": "#e5f6fd",
																	"neutral": "#eeeeee"
