{
	"slug": "mui-docs-wiki-version",
	"name": "Docs Version Picker",
	"library": "mui",
	"category": "documentation",
	"description": "Docs version picker in the Material UI style — mono version pill trigger over an elevated menu that tags the latest release with a tone chip, checks the active row and ends in a ghost changelog row.",
	"tags": [
		"docs",
		"version",
		"picker",
		"menu"
	],
	"args": [
		{
			"name": "version",
			"type": "string",
			"default": "2.4",
			"label": "Version",
			"maxLength": 12
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "success",
			"label": "Tone"
		},
		{
			"name": "open",
			"type": "boolean",
			"default": true,
			"label": "Menu open"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"gap": "8px",
				"alignItems": "flex-start",
				"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif"
			}
		},
		"children": [
			{
				"tag": "button",
				"props": {
					"type": "button",
					"style": {
						"display": "inline-flex",
						"alignItems": "center",
						"gap": "6px",
						"height": "30px",
						"padding": "0 12px",
						"borderRadius": "999px",
						"border": "1px solid rgba(0, 0, 0, 0.12)",
						"background": "#ffffff",
						"color": "rgba(0, 0, 0, 0.87)",
						"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
						"fontSize": "13px",
						"fontWeight": 600,
						"cursor": "pointer",
						"boxShadow": "0px 2px 1px -1px rgba(0,0,0,0.2), 0px 1px 1px 0px rgba(0,0,0,0.14), 0px 1px 3px 0px rgba(0,0,0,0.12)"
					}
				},
				"children": [
					"v{version}",
					{
						"tag": "svg",
						"props": {
							"width": 14,
							"height": 14,
							"viewBox": "0 0 24 24",
							"fill": "none",
							"stroke": "currentColor",
							"strokeWidth": 2,
							"strokeLinecap": "round",
							"strokeLinejoin": "round",
							"xmlns": "http://www.w3.org/2000/svg"
						},
						"children": [
							{
								"tag": "polyline",
								"props": {
									"points": "6 9 12 15 18 9"
								}
							}
						]
					}
				]
			},
			{
				"ttIf": {
					"arg": "open",
					"then": {
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"flexDirection": "column",
								"gap": "2px",
								"width": "220px",
								"padding": "6px",
								"background": "#ffffff",
								"borderRadius": "4px",
								"border": "1px solid rgba(0, 0, 0, 0.08)",
								"boxShadow": "0px 3px 5px -1px rgba(0,0,0,0.2), 0px 6px 10px 0px rgba(0,0,0,0.14), 0px 1px 18px 0px rgba(0,0,0,0.12)"
							}
						},
						"children": [
							{
								"tag": "div",
								"props": {
									"style": {
										"display": "flex",
										"alignItems": "center",
