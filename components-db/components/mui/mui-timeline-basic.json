{
	"slug": "mui-timeline-basic",
	"name": "Basic Timeline",
	"library": "mui",
	"category": "data-display",
	"description": "Vertical dot-and-rail timeline in the Material UI style — tone-colored dots down a soft rail, titled entries with a muted note and timestamp.",
	"tags": [
		"timeline",
		"history",
		"events",
		"data"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Deploy finished",
			"label": "Title",
			"maxLength": 40
		},
		{
			"name": "note",
			"type": "string",
			"default": "Rolled out to production",
			"label": "Note",
			"maxLength": 60
		},
		{
			"name": "count",
			"type": "number",
			"default": 4,
			"label": "Entries",
			"min": 1,
			"max": 6
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "ul",
		"props": {
			"style": {
				"listStyle": "none",
				"margin": 0,
				"padding": 0,
				"width": "280px",
				"display": "flex",
				"flexDirection": "column",
				"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif",
				"color": "rgba(0, 0, 0, 0.87)"
			}
		},
		"children": [
			{
				"ttRepeat": {
					"arg": "count",
					"max": 6,
					"node": {
						"tag": "li",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "stretch",
								"gap": "14px"
							}
						},
						"children": [
							{
								"tag": "div",
								"props": {
									"style": {
										"display": "flex",
										"flexDirection": "column",
										"alignItems": "center",
										"width": "12px",
										"flexShrink": 0
									}
								},
								"children": [
									{
										"tag": "div",
										"props": {
											"style": {
												"width": "12px",
												"height": "12px",
												"borderRadius": "999px",
												"background": {
													"ttMap": {
														"arg": "tone",
														"values": {
															"primary": "#1976d2",
															"success": "#2e7d32",
															"warning": "#ed6c02",
															"danger": "#d32f2f",
															"info": "#0288d1",
															"neutral": "#616161"
														},
														"default": "#1976d2"
													}
												},
												"marginTop": "4px",
												"flexShrink": 0
											}
										}
									},
									{
										"tag": "div",
										"props": {
											"style": {
												"width": "2px",
												"flexGrow": 1,
												"minHeight": "14px",
												"marginTop": "4px",
												"borderRadius": "999px",
												"background": "rgba(0, 0, 0, 0.08)"
											}
										}
									}
								]
							},
							{
								"tag": "div",
								"props": {
									"style": {
										"display": "flex",
										"flexDirection": "column",
										"gap": "2px",
										"paddingBottom": "18px",
										"minWidth": 0
									}
								},
								"children": [
									{
										"tag": "span",
										"props": {
											"style": {
												"fontWeight": 500,
												"fontSize": "14px"
											}
										},
										"children": [
											"{title}"
										]
									},
									{
										"tag": "span",
										"props": {
											"style": {
												"color": "rgba(0, 0, 0, 0.6)",
												"fontSize": "13px"
											}
										},
										"children": [
											"{note}"
										]
									},
									{
										"tag": "span",
										"props": {
											"style": {
												"color": "rgba(0, 0, 0, 0.38)",
												"fontSize": "12px"
											}
										},
										"children": [
											"{n}h ago"
										]
									}
								]
							}
						]
					}
				}
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "timeline",
		"variant": "basic",
		"tranche": 1
	}
}
