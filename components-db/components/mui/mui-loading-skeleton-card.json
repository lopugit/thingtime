{
	"slug": "mui-loading-skeleton-card",
	"name": "Skeleton Card",
	"library": "mui",
	"category": "feedback",
	"description": "Skeleton card placeholder in the Material UI style — avatar circle beside heading bars, body-line bars below, and an optional media block.",
	"tags": [
		"loading",
		"skeleton",
		"placeholder",
		"card"
	],
	"args": [
		{
			"name": "showAvatar",
			"type": "boolean",
			"default": true,
			"label": "Show avatar"
		},
		{
			"name": "showMedia",
			"type": "boolean",
			"default": false,
			"label": "Show media block"
		},
		{
			"name": "lines",
			"type": "number",
			"default": 3,
			"label": "Body lines",
			"min": 1,
			"max": 5
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"width": "260px",
				"gap": "12px",
				"background": "#ffffff",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "rgba(0, 0, 0, 0.08)",
				"borderRadius": "8px",
				"padding": "16px",
				"boxShadow": "0px 2px 1px -1px rgba(0,0,0,0.2), 0px 1px 1px 0px rgba(0,0,0,0.14), 0px 1px 3px 0px rgba(0,0,0,0.12)"
			}
		},
		"children": [
			{
				"ttIf": {
					"arg": "showMedia",
					"then": {
						"tag": "div",
						"props": {
							"style": {
								"height": "96px",
								"borderRadius": "4px",
								"background": "rgba(0, 0, 0, 0.08)"
							}
						}
					}
				}
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "12px"
					}
				},
				"children": [
					{
						"ttIf": {
							"arg": "showAvatar",
							"then": {
								"tag": "div",
								"props": {
									"style": {
										"width": "40px",
										"height": "40px",
										"borderRadius": "999px",
										"background": "rgba(0, 0, 0, 0.08)",
										"flexShrink": 0
									}
								}
							}
						}
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"flexDirection": "column",
								"gap": "8px",
								"flex": 1
							}
						},
						"children": [
							{
								"tag": "div",
								"props": {
									"style": {
										"height": "10px",
										"width": "45%",
										"borderRadius": "4px",
										"background": "rgba(0, 0, 0, 0.08)"
									}
								}
							},
							{
								"tag": "div",
								"props": {
									"style": {
										"height": "10px",
										"width": "70%",
										"borderRadius": "4px",
										"background": "rgba(0, 0, 0, 0.08)"
									}
								}
							}
						]
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"gap": "8px"
					}
				},
				"children": [
					{
						"ttRepeat": {
							"arg": "lines",
							"max": 5,
							"node": {
								"tag": "div",
								"props": {
									"style": {
										"height": "10px",
										"borderRadius": "4px",
										"background": "rgba(0, 0, 0, 0.08)",
										"width": {
											"ttMap": {
												"arg": "n",
												"values": {
													"1": "100%",
													"2": "94%",
													"3": "82%",
													"4": "64%",
													"5": "52%"
												},
												"default": "75%"
											}
										}
									}
								}
							}
						}
					}
				]
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "loading",
		"variant": "skeleton-card",
		"tranche": 1
	}
}
