{
	"slug": "mui-file-manager-folder-grid",
	"name": "Folder Grid",
	"library": "mui",
	"category": "files",
	"description": "Folder tile grid in the Material UI style — tone-colored folder glyphs with name and item-count captions, the selected tile lifted by the library focus ring.",
	"tags": [
		"folder",
		"grid",
		"files",
		"tiles"
	],
