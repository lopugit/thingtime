{
	"slug": "mui-support-help-status",
	"name": "Incident Status Banner",
	"library": "mui",
	"category": "support",
	"description": "Incident status banner in the Material UI style — state dot and tint flip between operational, degraded, and outage, with subscribe and details actions plus a shimmer bar during incidents.",
	"tags": [
		"support",
		"status",
		"incident",
		"banner",
		"uptime"
	],
	"args": [
		{
			"name": "system",
			"type": "string",
			"default": "API",
			"label": "System",
			"maxLength": 24
		},
		{
			"name": "state",
			"type": "enum",
			"values": [
				"operational",
				"degraded",
				"outage"
			],
			"default": "degraded",
			"label": "State"
		},
		{
			"name": "ago",
			"type": "string",
			"default": "4 min ago",
			"label": "Updated",
			"maxLength": 16
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"gap": "6px",
				"width": "340px",
				"padding": "12px 14px",
				"boxSizing": "border-box",
				"background": {
					"ttMap": {
						"arg": "state",
						"values": {
							"operational": "#edf7ed",
							"degraded": "#fff4e5",
							"outage": "#fdeded"
						},
						"default": "#edf7ed"
					}
				},
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": {
					"ttMap": {
						"arg": "state",
						"values": {
							"operational": "#a5d6a7",
							"degraded": "#ffb74d",
							"outage": "#ef9a9a"
						},
						"default": "#a5d6a7"
					}
				},
				"borderRadius": "4px",
				"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "8px"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"width": "10px",
								"height": "10px",
								"borderRadius": "999px",
								"flexShrink": 0,
								"background": {
									"ttMap": {
										"arg": "state",
										"values": {
											"operational": "#2e7d32",
											"degraded": "#ed6c02",
											"outage": "#d32f2f"
										},
										"default": "#2e7d32"
									}
								}
							}
						}
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "14px",
								"fontWeight": 500,
								"textTransform": "capitalize",
								"color": {
									"ttMap": {
										"arg": "state",
										"values": {
											"operational": "#1e4620",
											"degraded": "#663c00",
											"outage": "#5f2120"
										},
										"default": "#1e4620"
									}
								}
							}
						},
						"children": [
							"{system} — {state}"
						]
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "12px",
						"color": "rgba(0, 0, 0, 0.6)",
						"paddingLeft": "18px"
					}
				},
				"children": [
					"Updated {ago}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "8px",
						"paddingLeft": "10px"
					}
				},
				"children": [
					{
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"background": "transparent",
								"border": "none",
								"cursor": "pointer",
								"padding": "4px 8px",
								"borderRadius": "4px",
								"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif",
								"fontSize": "12px",
								"fontWeight": 600,
								"color": {
									"ttMap": {
										"arg": "state",
										"values": {
											"operational": "#1e4620",
											"degraded": "#663c00",
											"outage": "#5f2120"
										},
										"default": "#1e4620"
									}
								},
								"textTransform": "uppercase",
								"letterSpacing": "0.02857em"
							}
						},
						"children": [
							"Subscribe"
						]
					},
					{
						"tag": "a",
						"props": {
							"href": "#",
							"style": {
								"fontSize": "12px",
								"fontWeight": 600,
								"textDecoration": "underline",
								"color": "rgba(0, 0, 0, 0.6)",
								"padding": "4px 0"
							}
						},
						"children": [
							"Details"
						]
					}
				]
			},
			{
				"ttIf": {
					"arg": "state",
					"equals": "operational",
					"then": "",
					"else": {
						"tag": "div",
						"props": {
							"style": {
								"height": "4px",
								"borderRadius": "999px",
								"background": "#ffffff",
								"overflow": "hidden",
								"marginTop": "2px"
							}
						},
						"children": [
							{
								"tag": "div",
								"props": {
									"style": {
										"height": "100%",
										"width": "45%",
										"borderRadius": "999px",
										"background": {
											"ttMap": {
												"arg": "state",
												"values": {
													"degraded": "#ed6c02",
													"outage": "#d32f2f"
												},
												"default": "#ed6c02"
											}
										}
									}
								}
							}
						]
					}
				}
			}
		]
	},
	"version": 1,
	"familyKey": "support-help-status",
	"source": {
		"kind": "archetype",
		"archetype": "support-help",
		"variant": "status",
		"tranche": 2
	}
}
