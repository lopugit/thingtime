{
	"slug": "mui-flow-node",
	"name": "Flow Node",
	"library": "mui",
	"category": "flow",
	"description": "Graph node card in the Material UI style — title, mono sublabel, tone status dot, and top/bottom connection handles with an accent ring when selected.",
	"tags": [
		"flow",
		"node",
		"graph",
		"handle"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Transform",
			"label": "Label",
			"maxLength": 30
		},
		{
			"name": "sublabel",
			"type": "string",
			"default": "normalize()",
			"label": "Sublabel",
			"maxLength": 30
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "success",
			"label": "Tone"
		},
		{
			"name": "selected",
			"type": "boolean",
			"default": false,
			"label": "Selected"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"padding": "10px 4px",
				"display": "inline-block"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"ttMerge": [
							{
								"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif",
								"background": "#ffffff",
								"borderWidth": "1px",
								"borderStyle": "solid",
								"borderColor": "rgba(0, 0, 0, 0.12)",
								"borderRadius": "4px",
								"boxShadow": "0px 2px 1px -1px rgba(0,0,0,0.2), 0px 1px 1px 0px rgba(0,0,0,0.14), 0px 1px 3px 0px rgba(0,0,0,0.12)",
								"boxSizing": "border-box",
								"position": "relative",
								"width": "180px",
								"padding": "10px 12px"
							},
							{
								"ttIf": {
									"arg": "selected",
									"then": {
										"borderColor": "#1976d2",
										"boxShadow": "0 0 0 1px #1976d2"
									},
									"else": {}
								}
							}
						]
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"position": "absolute",
								"width": "10px",
								"height": "10px",
								"borderRadius": "999px",
								"background": "#1976d2",
								"borderWidth": "2px",
								"borderStyle": "solid",
								"borderColor": "#ffffff",
								"boxSizing": "border-box",
								"top": "-6px",
								"left": "50%",
								"marginLeft": "-5px"
							}
						}
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"gap": "8px"
							}
						},
						"children": [
							{
								"tag": "span",
								"props": {
									"style": {
										"width": "8px",
										"height": "8px",
										"borderRadius": "999px",
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#1976d2",
													"success": "#2e7d32",
													"warning": "#ed6c02",
													"danger": "#d32f2f",
													"info": "#0288d1",
													"neutral": "#616161"
												},
												"default": "#2e7d32"
											}
										},
										"flexShrink": 0
									}
								}
							},
							{
								"tag": "div",
								"props": {
									"style": {
										"display": "flex",
										"flexDirection": "column",
										"gap": "2px",
										"minWidth": "0"
									}
								},
								"children": [
									{
										"tag": "span",
										"props": {
											"style": {
												"fontSize": "13px",
												"fontWeight": 500,
												"color": "rgba(0, 0, 0, 0.87)"
											}
										},
										"children": [
											"{label}"
										]
									},
									{
										"tag": "span",
										"props": {
											"style": {
												"fontSize": "12px",
												"color": "rgba(0, 0, 0, 0.6)",
												"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
											}
										},
										"children": [
											"{sublabel}"
										]
									}
								]
							}
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"position": "absolute",
								"width": "10px",
								"height": "10px",
								"borderRadius": "999px",
								"background": "#1976d2",
								"borderWidth": "2px",
								"borderStyle": "solid",
								"borderColor": "#ffffff",
								"boxSizing": "border-box",
								"bottom": "-6px",
								"left": "50%",
								"marginLeft": "-5px"
							}
						}
					}
				]
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "flow",
		"variant": "node",
		"tranche": 1
	}
}
