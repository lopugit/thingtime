{
	"slug": "mui-card-header-footer",
	"name": "Header & Footer Card",
	"library": "mui",
	"category": "layout",
	"description": "Three-part card in the Material UI style — bordered header and footer bands around a padded body, with an optional tinted footer.",
	"tags": [
		"card",
		"header",
		"footer",
		"sections"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Weekly report",
			"label": "Title",
			"maxLength": 60
		},
		{
			"name": "body",
			"type": "text",
			"default": "Everything shipped this week, grouped by team and sorted by impact.",
			"label": "Body"
		},
		{
			"name": "footer",
			"type": "string",
			"default": "Updated 2 days ago",
			"label": "Footer",
			"maxLength": 60
		},
		{
			"name": "tintedFooter",
			"type": "boolean",
			"default": true,
			"label": "Tinted footer"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"width": "300px",
				"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif",
				"background": "#ffffff",
				"color": "rgba(0, 0, 0, 0.87)",
				"border": "1px solid rgba(0, 0, 0, 0.12)",
				"borderRadius": "4px",
				"boxShadow": "0px 2px 1px -1px rgba(0,0,0,0.2), 0px 1px 1px 0px rgba(0,0,0,0.14), 0px 1px 3px 0px rgba(0,0,0,0.12)",
				"overflow": "hidden",
				"boxSizing": "border-box"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"padding": "12px 16px",
						"borderBottom": "1px solid rgba(0, 0, 0, 0.08)"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "16px",
								"fontWeight": 500,
								"color": "rgba(0, 0, 0, 0.87)"
							}
						},
						"children": [
							"{title}"
						]
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"padding": "16px"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "13px",
								"color": "rgba(0, 0, 0, 0.6)",
								"lineHeight": 1.5
							}
						},
						"children": [
							"{body}"
						]
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"ttMerge": [
							{
								"padding": "10px 16px",
								"borderTop": "1px solid rgba(0, 0, 0, 0.08)",
								"fontSize": "12px",
								"color": "rgba(0, 0, 0, 0.6)"
							},
							{
								"ttIf": {
									"arg": "tintedFooter",
									"then": {
										"background": "#fafafa"
									},
									"else": {}
								}
							}
						]
					}
				},
				"children": [
					"{footer}"
				]
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "card",
		"variant": "header-footer",
		"tranche": 1
	}
}
