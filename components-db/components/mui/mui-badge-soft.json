{
	"slug": "mui-badge-soft",
	"name": "Soft Badge",
	"library": "mui",
	"category": "data-display",
	"description": "Tinted status badge in the Material UI style — soft tone wash with the deeper tone for the label.",
	"tags": [
		"badge",
		"status",
		"soft",
		"tinted"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "In review",
			"label": "Label",
			"maxLength": 24
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "size",
			"type": "enum",
			"values": [
				"sm",
				"md"
			],
			"default": "sm",
			"label": "Size"
		}
	],
	"render": {
		"tag": "span",
		"props": {
			"style": {
				"ttMerge": [
					{
						"display": "inline-flex",
						"alignItems": "center",
						"gap": "6px",
						"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif",
						"fontWeight": 600,
						"lineHeight": 1.4,
						"borderRadius": "999px"
					},
					{
						"ttMap": {
							"arg": "size",
							"values": {
								"sm": {
									"fontSize": "12px",
									"padding": "2px 8px"
								},
								"md": {
									"fontSize": "13px",
									"padding": "4px 10px"
								}
							},
							"default": {
								"fontSize": "12px",
								"padding": "2px 8px"
							}
						}
					},
					{
						"background": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#e3f2fd",
									"success": "#edf7ed",
									"warning": "#fff4e5",
									"danger": "#fdeded",
									"info": "#e5f6fd",
									"neutral": "#eeeeee"
								},
								"default": "#e3f2fd"
							}
						},
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#1565c0",
									"success": "#1e4620",
									"warning": "#663c00",
									"danger": "#5f2120",
									"info": "#014361",
									"neutral": "#424242"
								},
								"default": "#1565c0"
							}
						}
					}
				]
			}
		},
		"children": [
			"{label}"
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "badge",
		"variant": "soft",
		"tranche": 1
	}
}
