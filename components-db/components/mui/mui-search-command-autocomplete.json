{
	"slug": "mui-search-command-autocomplete",
	"name": "Autocomplete Search",
	"library": "mui",
	"category": "forms",
	"description": "Autocomplete search in the Material UI style — a typed query field above an open suggestions panel where each of four rows bolds the matched query prefix in the active tone, with the first row hovered.",
	"tags": [
		"search",
		"autocomplete",
		"suggestions",
		"dropdown"
	],
	"args": [
		{
			"name": "query",
			"type": "string",
			"default": "da",
			"label": "Query",
			"maxLength": 20
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "open",
			"type": "boolean",
			"default": true,
			"label": "Panel open"
		}
	],
