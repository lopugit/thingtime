{
	"slug": "mui-empty-states-success",
	"name": "Success State",
	"library": "mui",
	"category": "feedback",
	"description": "Success / complete panel in the Material UI style — check circle in a soft tone bubble, congratulatory title and message, and an optional continue button.",
	"tags": [
		"success",
		"complete",
		"empty-state",
		"feedback"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "You’re all set",
			"label": "Title",
			"maxLength": 50
		},
		{
			"name": "message",
			"type": "text",
			"default": "Your workspace is ready. Invite your team or jump straight in.",
			"label": "Message"
		},
		{
			"name": "ctaLabel",
			"type": "string",
			"default": "Go to dashboard",
			"label": "CTA label",
			"maxLength": 32
		},
		{
			"name": "showCta",
			"type": "boolean",
			"default": true,
			"label": "Show CTA"
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"success",
				"primary",
				"info"
			],
			"default": "success",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"alignItems": "center",
				"justifyContent": "center",
				"textAlign": "center",
				"gap": "6px",
				"width": "340px",
				"padding": "36px 24px",
				"background": "#ffffff",
				"borderRadius": "8px",
				"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif",
				"color": "rgba(0, 0, 0, 0.87)",
				"border": "1px solid rgba(0, 0, 0, 0.12)",
				"boxShadow": "0px 3px 1px -2px rgba(0,0,0,0.2), 0px 2px 2px 0px rgba(0,0,0,0.14), 0px 1px 5px 0px rgba(0,0,0,0.12)"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"width": "46px",
						"height": "46px",
						"borderRadius": "999px",
						"background": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#e3f2fd",
									"success": "#edf7ed",
									"warning": "#fff4e5",
									"danger": "#fdeded",
									"info": "#e5f6fd",
									"neutral": "#eeeeee"
								},
								"default": "#e3f2fd"
							}
						},
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#1976d2",
									"success": "#2e7d32",
									"warning": "#ed6c02",
									"danger": "#d32f2f",
									"info": "#0288d1",
									"neutral": "#616161"
								},
								"default": "#1976d2"
							}
						},
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "center",
						"marginBottom": "4px"
					}
				},
				"children": [
					{
						"tag": "svg",
						"props": {
							"width": 22,
							"height": 22,
							"viewBox": "0 0 24 24",
							"fill": "none",
							"stroke": "currentColor",
							"strokeWidth": 2,
							"strokeLinecap": "round",
							"strokeLinejoin": "round",
							"xmlns": "http://www.w3.org/2000/svg"
						},
						"children": [
							{
								"tag": "polyline",
								"props": {
									"points": "20 6 9 17 4 12"
								}
							}
						]
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontWeight": 500,
						"fontSize": "16px"
					}
				},
				"children": [
					"{title}"
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "13px",
						"color": "rgba(0, 0, 0, 0.6)",
						"lineHeight": 1.5,
						"maxWidth": "250px"
					}
				},
				"children": [
					"{message}"
				]
			},
			{
				"ttIf": {
					"arg": "showCta",
					"then": {
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"display": "inline-flex",
								"alignItems": "center",
								"justifyContent": "center",
								"height": "36px",
								"padding": "0 18px",
								"border": "none",
								"borderRadius": "4px",
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#1976d2",
											"success": "#2e7d32",
											"warning": "#ed6c02",
											"danger": "#d32f2f",
											"info": "#0288d1",
											"neutral": "#616161"
										},
										"default": "#1976d2"
									}
								},
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#ffffff",
											"success": "#ffffff",
											"warning": "#ffffff",
											"danger": "#ffffff",
											"info": "#ffffff",
											"neutral": "#ffffff"
										},
										"default": "#ffffff"
									}
								},
								"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif",
								"fontSize": "13px",
								"fontWeight": 500,
								"boxShadow": "0px 2px 1px -1px rgba(0,0,0,0.2), 0px 1px 1px 0px rgba(0,0,0,0.14), 0px 1px 3px 0px rgba(0,0,0,0.12)",
								"cursor": "pointer",
								"textTransform": "uppercase",
								"letterSpacing": "0.02857em",
								"marginTop": "10px"
							}
						},
						"children": [
							"{ctaLabel}"
						]
					}
				}
			}
		]
	},
	"previewBg": "#f5f5f5",
	"version": 1,
	"familyKey": "empty-states-success",
	"source": {
		"kind": "archetype",
		"archetype": "empty-states",
		"variant": "success",
		"tranche": 1
	}
}
