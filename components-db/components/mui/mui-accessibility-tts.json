{
	"slug": "mui-accessibility-tts",
	"name": "Text-to-Speech Bar",
	"library": "mui",
	"category": "accessibility",
	"description": "Text-to-speech bar in the Material UI style — accent play/pause circle beside the current sentence with a highlighted spoken word, a mono speed chip, a voice select mock, and a progress hairline.",
	"tags": [
		"accessibility",
		"tts",
		"speech",
		"audio",
		"player"
	],
	"args": [
		{
			"name": "playing",
			"type": "boolean",
			"default": true,
			"label": "Playing"
		},
		{
			"name": "word",
			"type": "string",
			"default": "gently",
			"label": "Highlighted word",
			"maxLength": 16
		},
		{
			"name": "speed",
			"type": "number",
			"default": 1.5,
			"label": "Speed"
		},
		{
			"name": "voice",
			"type": "string",
			"default": "Samantha",
			"label": "Voice",
			"maxLength": 16
		},
		{
			"name": "progress",
			"type": "number",
			"default": 40,
			"label": "Progress %"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"background": "#ffffff",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "rgba(0, 0, 0, 0.08)",
				"borderRadius": "8px",
				"boxShadow": "0px 3px 5px -1px rgba(0,0,0,0.2), 0px 6px 10px 0px rgba(0,0,0,0.14), 0px 1px 18px 0px rgba(0,0,0,0.12)",
				"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif",
				"color": "rgba(0, 0, 0, 0.87)",
				"boxSizing": "border-box",
				"width": "290px",
				"padding": "12px",
				"gap": "10px"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "flex-start",
						"gap": "10px"
					}
				},
				"children": [
					{
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"width": "36px",
								"height": "36px",
								"borderRadius": "999px",
								"border": "none",
								"background": "#1976d2",
								"color": "#ffffff",
								"display": "flex",
								"alignItems": "center",
								"justifyContent": "center",
								"flexShrink": 0,
								"cursor": "pointer",
								"boxShadow": "0px 3px 1px -2px rgba(0,0,0,0.2), 0px 2px 2px 0px rgba(0,0,0,0.14), 0px 1px 5px 0px rgba(0,0,0,0.12)"
							}
						},
						"children": [
							{
								"ttIf": {
									"arg": "playing",
									"then": {
										"tag": "svg",
										"props": {
											"width": 14,
											"height": 14,
											"viewBox": "0 0 24 24",
											"fill": "currentColor",
											"xmlns": "http://www.w3.org/2000/svg"
										},
										"children": [
											{
												"tag": "rect",
												"props": {
													"x": 6,
													"y": 5,
													"width": 4,
													"height": 14,
													"rx": 1
												}
											},
											{
												"tag": "rect",
												"props": {
													"x": 14,
													"y": 5,
													"width": 4,
													"height": 14,
													"rx": 1
												}
											}
										]
									},
									"else": {
										"tag": "svg",
										"props": {
											"width": 14,
											"height": 14,
											"viewBox": "0 0 24 24",
											"fill": "currentColor",
											"xmlns": "http://www.w3.org/2000/svg"
										},
										"children": [
											{
												"tag": "polygon",
												"props": {
													"points": "8 5 19 12 8 19"
												}
											}
										]
									}
								}
							}
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"flexDirection": "column",
								"gap": "8px",
								"flexGrow": 1,
								"minWidth": 0
							}
						},
						"children": [
							{
								"tag": "div",
								"props": {
									"style": {
										"fontSize": "13px",
										"color": "rgba(0, 0, 0, 0.6)",
										"lineHeight": 1.5
									}
								},
								"children": [
									"Each word is spoken ",
									{
										"tag": "span",
										"props": {
											"style": {
												"background": "#e3f2fd",
												"color": "#1565c0",
												"borderRadius": "4px",
												"padding": "0 4px",
												"fontWeight": 600
											}
										},
										"children": [
											"{word}"
										]
									},
									" as the narration moves."
								]
							},
							{
								"tag": "div",
								"props": {
									"style": {
										"display": "flex",
										"alignItems": "center",
										"gap": "6px",
										"flexWrap": "wrap"
									}
								},
								"children": [
									{
										"tag": "span",
										"props": {
											"style": {
												"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
												"fontSize": "12px",
												"fontWeight": 600,
												"color": "rgba(0, 0, 0, 0.87)",
												"background": "#fafafa",
												"borderRadius": "999px",
												"padding": "2px 8px"
											}
										},
										"children": [
											"{speed}×"
										]
									},
									{
										"tag": "div",
										"props": {
											"style": {
												"display": "inline-flex",
												"alignItems": "center",
												"gap": "6px",
												"padding": "2px 8px",
												"background": "#ffffff",
												"borderWidth": "1px",
												"borderStyle": "solid",
												"borderColor": "rgba(0, 0, 0, 0.12)",
												"borderRadius": "4px",
												"fontSize": "12px",
												"color": "rgba(0, 0, 0, 0.87)"
											}
										},
										"children": [
											"{voice}",
											{
												"tag": "svg",
												"props": {
													"width": 12,
													"height": 12,
													"viewBox": "0 0 24 24",
													"fill": "none",
													"stroke": "rgba(0, 0, 0, 0.6)",
													"strokeWidth": 2,
													"strokeLinecap": "round",
													"strokeLinejoin": "round",
													"xmlns": "http://www.w3.org/2000/svg"
												},
												"children": [
													{
														"tag": "polyline",
														"props": {
															"points": "6 9 12 15 18 9"
														}
													}
												]
											}
										]
									}
								]
							}
						]
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"height": "3px",
						"borderRadius": "999px",
						"background": "rgba(0, 0, 0, 0.08)",
						"overflow": "hidden"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"height": "3px",
								"width": "{progress}%",
								"borderRadius": "999px",
								"background": "#1976d2"
							}
						}
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "accessibility-tts",
	"source": {
		"kind": "archetype",
		"archetype": "accessibility",
		"variant": "tts",
		"tranche": 2
	}
}
