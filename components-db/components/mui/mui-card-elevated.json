{
	"slug": "mui-card-elevated",
	"name": "Elevated Card",
	"library": "mui",
	"category": "layout",
	"description": "Floating borderless card in the Material UI style — the library's deeper shadow tiers lift it off the page, led by a tone-tinted icon chip.",
	"tags": [
		"card",
		"elevated",
		"shadow",
		"floating"
