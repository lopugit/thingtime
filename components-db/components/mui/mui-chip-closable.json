{
	"slug": "mui-chip-closable",
	"name": "Closable Chip",
	"library": "mui",
	"category": "data-display",
	"description": "Removable tag chip in the Material UI style — a soft tone chip with a trailing x glyph, dimming when disabled.",
	"tags": [
		"chip",
		"tag",
		"closable",
		"removable"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Filter: recent",
			"label": "Label",
			"maxLength": 24
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "disabled",
			"type": "boolean",
			"default": false,
			"label": "Disabled"
		}
	],
	"render": {
		"tag": "span",
		"props": {
			"style": {
				"ttMerge": [
					{
						"display": "inline-flex",
						"alignItems": "center",
						"gap": "6px",
						"height": "30px",
						"padding": "0 12px",
						"borderRadius": "999px",
						"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif",
						"fontWeight": 500,
						"fontSize": "13px"
					},
					{
						"background": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#e3f2fd",
									"success": "#edf7ed",
									"warning": "#fff4e5",
									"danger": "#fdeded",
									"info": "#e5f6fd",
									"neutral": "#eeeeee"
								},
								"default": "#e3f2fd"
							}
						},
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#1565c0",
									"success": "#1e4620",
									"warning": "#663c00",
									"danger": "#5f2120",
									"info": "#014361",
									"neutral": "#424242"
								},
								"default": "#1565c0"
							}
						}
					},
					{
						"cursor": "pointer"
					},
					{
						"ttIf": {
							"arg": "disabled",
							"then": {
								"opacity": 0.5,
								"cursor": "not-allowed"
							},
							"else": {}
						}
					}
				]
			}
		},
		"children": [
			"{label}",
			{
				"tag": "svg",
				"props": {
					"width": 12,
					"height": 12,
					"viewBox": "0 0 24 24",
					"fill": "none",
					"stroke": "currentColor",
					"strokeWidth": 2,
					"strokeLinecap": "round",
					"strokeLinejoin": "round",
					"xmlns": "http://www.w3.org/2000/svg"
				},
				"children": [
					{
						"tag": "line",
						"props": {
							"x1": 18,
							"y1": 6,
							"x2": 6,
							"y2": 18
						}
					},
					{
						"tag": "line",
						"props": {
							"x1": 6,
							"y1": 6,
							"x2": 18,
							"y2": 18
						}
					}
				]
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "chip",
		"variant": "closable",
		"tranche": 1
	}
}
