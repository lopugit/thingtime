{
	"slug": "mui-timeline-changelog",
	"name": "Changelog Timeline",
	"library": "mui",
	"category": "data-display",
	"description": "Changelog timeline in the Material UI style — mono version chips on a tone tint head each entry, with a date mark and a muted release summary.",
	"tags": [
		"timeline",
		"changelog",
		"releases",
		"versions"
	],
	"args": [
		{
			"name": "version",
			"type": "string",
			"default": "2.4",
			"label": "Version",
			"maxLength": 12
		},
		{
			"name": "summary",
			"type": "string",
			"default": "Performance improvements and bug fixes",
			"label": "Summary",
			"maxLength": 80
		},
		{
			"name": "count",
			"type": "number",
			"default": 3,
			"label": "Entries",
			"min": 1,
			"max": 5
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "ul",
		"props": {
			"style": {
				"listStyle": "none",
				"margin": 0,
				"padding": 0,
				"width": "280px",
				"display": "flex",
				"flexDirection": "column",
				"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif",
				"color": "rgba(0, 0, 0, 0.87)"
			}
		},
		"children": [
			{
				"ttRepeat": {
					"arg": "count",
					"max": 5,
					"node": {
						"tag": "li",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "stretch",
								"gap": "14px"
							}
						},
						"children": [
							{
								"tag": "div",
								"props": {
									"style": {
										"display": "flex",
										"flexDirection": "column",
										"alignItems": "center",
										"width": "12px",
										"flexShrink": 0
									}
								},
								"children": [
									{
										"tag": "div",
										"props": {
											"style": {
												"width": "12px",
												"height": "12px",
												"borderRadius": "999px",
												"background": "rgba(0, 0, 0, 0.38)",
												"marginTop": "5px",
												"flexShrink": 0
											}
										}
									},
									{
										"tag": "div",
										"props": {
											"style": {
												"width": "2px",
												"flexGrow": 1,
												"minHeight": "14px",
												"marginTop": "4px",
												"borderRadius": "999px",
												"background": "rgba(0, 0, 0, 0.08)"
											}
										}
									}
								]
							},
							{
								"tag": "div",
								"props": {
									"style": {
										"display": "flex",
										"flexDirection": "column",
										"gap": "2px",
										"paddingBottom": "18px",
										"minWidth": 0
									}
								},
								"children": [
									{
										"tag": "div",
										"props": {
											"style": {
												"display": "flex",
												"alignItems": "center",
												"gap": "8px"
											}
										},
										"children": [
											{
												"tag": "span",
												"props": {
													"style": {
														"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
														"fontSize": "12px",
														"fontWeight": 600,
														"padding": "2px 8px",
														"borderRadius": "999px",
														"background": {
															"ttMap": {
																"arg": "tone",
																"values": {
																	"primary": "#e3f2fd",
																	"success": "#edf7ed",
																	"warning": "#fff4e5",
																	"danger": "#fdeded",
																	"info": "#e5f6fd",
																	"neutral": "#eeeeee"
																},
																"default": "#e3f2fd"
															}
														},
														"color": {
															"ttMap": {
																"arg": "tone",
																"values": {
																	"primary": "#1565c0",
																	"success": "#1e4620",
																	"warning": "#663c00",
																	"danger": "#5f2120",
																	"info": "#014361",
																	"neutral": "#424242"
																},
																"default": "#1565c0"
															}
														},
														"borderWidth": "1px",
														"borderStyle": "solid",
														"borderColor": {
															"ttMap": {
																"arg": "tone",
																"values": {
																	"primary": "#90caf9",
																	"success": "#a5d6a7",
																	"warning": "#ffb74d",
																	"danger": "#ef9a9a",
																	"info": "#81d4fa",
																	"neutral": "#bdbdbd"
																},
																"default": "#90caf9"
															}
														}
													}
												},
												"children": [
													"v{version}.{n}"
												]
											},
											{
												"tag": "span",
												"props": {
													"style": {
														"color": "rgba(0, 0, 0, 0.38)",
														"fontSize": "12px"
													}
												},
												"children": [
													"Aug {n}"
												]
											}
										]
									},
									{
										"tag": "span",
										"props": {
											"style": {
												"color": "rgba(0, 0, 0, 0.6)",
												"fontSize": "13px",
												"marginTop": "2px"
											}
										},
										"children": [
											"{summary}"
										]
									}
								]
							}
						]
					}
				}
			}
		]
	},
	"version": 1,
	"familyKey": "timeline-changelog",
	"source": {
		"kind": "archetype",
		"archetype": "timeline",
		"variant": "changelog",
		"tranche": 1
	}
}
