{
	"slug": "mui-security-privacy-vault-row",
	"name": "Vault Password Row",
	"library": "mui",
	"category": "security",
	"description": "Password-manager vault row in the Material UI style — favicon initial tile, site and username captions, a strength dot, last-changed note, copy/reveal ghosts, and a reused-password warning chip.",
	"tags": [
		"security",
		"password",
		"vault",
		"row"
	],
	"args": [
		{
			"name": "site",
			"type": "string",
			"default": "github.com",
			"label": "Site",
			"maxLength": 40
		},
		{
			"name": "initial",
			"type": "string",
			"default": "G",
			"label": "Favicon initial",
			"maxLength": 2
		},
		{
			"name": "username",
			"type": "string",
			"default": "nikolaj@thingtime.com",
			"label": "Username",
			"maxLength": 60
		},
		{
			"name": "strength",
			"type": "enum",
			"values": [
				"weak",
				"fair",
				"strong"
			],
			"default": "strong",
			"label": "Strength"
		},
		{
			"name": "reused",
			"type": "boolean",
			"default": false,
			"label": "Reused password"
		},
		{
			"name": "changed",
			"type": "string",
			"default": "3 mo ago",
			"label": "Last changed",
			"maxLength": 20
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"alignItems": "center",
				"gap": "12px",
				"width": "400px",
				"boxSizing": "border-box",
				"padding": "10px 14px",
				"background": "#ffffff",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "rgba(0, 0, 0, 0.12)",
				"borderRadius": "4px",
				"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif",
				"boxShadow": "0px 3px 5px -1px rgba(0,0,0,0.2), 0px 6px 10px 0px rgba(0,0,0,0.14), 0px 1px 18px 0px rgba(0,0,0,0.12)"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"width": "36px",
						"height": "36px",
						"borderRadius": "4px",
						"background": "#e3f2fd",
						"color": "#1565c0",
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "center",
						"fontWeight": 600,
						"fontSize": "14px",
						"flexShrink": 0
					}
				},
				"children": [
					"{initial}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"gap": "2px",
						"minWidth": 0,
						"flex": 1
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"gap": "8px"
							}
						},
						"children": [
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "13px",
										"fontWeight": 600,
										"color": "rgba(0, 0, 0, 0.87)"
									}
								},
								"children": [
									"{site}"
								]
							},
							{
								"ttIf": {
									"arg": "reused",
									"then": {
										"tag": "span",
										"props": {
											"style": {
												"background": "#fff4e5",
												"color": "#663c00",
												"fontSize": "12px",
												"fontWeight": 600,
												"padding": "1px 8px",
												"borderRadius": "999px",
												"whiteSpace": "nowrap"
											}
										},
										"children": [
											"Reused"
										]
									}
								}
							}
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "12px",
								"color": "rgba(0, 0, 0, 0.6)"
							}
						},
						"children": [
							"{username}"
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"gap": "6px"
							}
						},
						"children": [
							{
								"tag": "span",
								"props": {
									"style": {
										"width": "7px",
										"height": "7px",
										"borderRadius": "999px",
										"background": {
											"ttMap": {
												"arg": "strength",
												"values": {
													"weak": "#d32f2f",
													"fair": "#ed6c02",
													"strong": "#2e7d32"
												},
												"default": "#2e7d32"
											}
										},
										"flexShrink": 0
									}
								}
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "12px",
										"fontWeight": 600,
										"color": {
											"ttMap": {
												"arg": "strength",
												"values": {
													"weak": "#d32f2f",
													"fair": "#ed6c02",
													"strong": "#2e7d32"
												},
												"default": "#2e7d32"
											}
										},
										"textTransform": "capitalize"
									}
								},
								"children": [
									"{strength}"
								]
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "12px",
										"color": "rgba(0, 0, 0, 0.38)"
									}
								},
								"children": [
									"· Updated {changed}"
								]
							}
						]
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "2px",
						"marginLeft": "auto",
						"flexShrink": 0
					}
				},
				"children": [
					{
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"background": "transparent",
								"border": "none",
								"color": "rgba(0, 0, 0, 0.6)",
								"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif",
								"fontSize": "12px",
								"fontWeight": 600,
								"cursor": "pointer",
								"padding": "4px 8px",
								"borderRadius": "4px",
								"whiteSpace": "nowrap",
								"textTransform": "uppercase",
								"letterSpacing": "0.02857em"
							}
						},
						"children": [
							"Copy"
						]
					},
					{
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"background": "transparent",
								"border": "none",
								"color": "#1976d2",
								"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif",
								"fontSize": "12px",
								"fontWeight": 600,
								"cursor": "pointer",
								"padding": "4px 8px",
								"borderRadius": "4px",
								"whiteSpace": "nowrap",
								"textTransform": "uppercase",
								"letterSpacing": "0.02857em"
							}
						},
						"children": [
							"Reveal"
						]
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "security-privacy-vault-row",
	"source": {
		"kind": "archetype",
		"archetype": "security-privacy",
		"variant": "vault-row",
		"tranche": 2
	}
}
