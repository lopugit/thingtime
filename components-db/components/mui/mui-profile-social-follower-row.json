{
	"slug": "mui-profile-social-follower-row",
	"name": "Follower Row",
	"library": "mui",
	"category": "social",
	"description": "Follower list row in the Material UI style — initials avatar wearing a presence dot, name with a mutuals caption, and a small tone-tinted follow chip on the right.",
	"tags": [
		"profile",
		"list",
		"follower",
		"presence",
		"social"
	],
	"args": [
		{
			"name": "initials",
			"type": "string",
			"default": "SM",
			"label": "Initials",
			"maxLength": 3
		},
		{
			"name": "name",
			"type": "string",
			"default": "Sam Mercer",
			"label": "Name",
			"maxLength": 40
		},
		{
			"name": "mutuals",
			"type": "string",
			"default": "12 mutual friends",
			"label": "Mutuals",
			"maxLength": 40
		},
		{
			"name": "presence",
			"type": "enum",
			"values": [
				"online",
				"away",
				"offline"
			],
			"default": "online",
			"label": "Presence"
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"background": "#ffffff",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "rgba(0, 0, 0, 0.12)",
				"borderRadius": "4px",
				"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif",
				"boxShadow": "0px 2px 1px -1px rgba(0,0,0,0.2), 0px 1px 1px 0px rgba(0,0,0,0.14), 0px 1px 3px 0px rgba(0,0,0,0.12)",
				"width": "300px",
				"display": "flex",
				"alignItems": "center",
				"gap": "12px",
				"padding": "10px 12px",
				"boxSizing": "border-box"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"position": "relative",
						"flexShrink": 0
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"width": 40,
								"height": 40,
								"borderRadius": "999px",
								"background": "#eeeeee",
								"color": "#424242",
								"display": "flex",
								"alignItems": "center",
								"justifyContent": "center",
								"fontWeight": 600,
								"fontSize": "13px",
								"flexShrink": 0
							}
						},
						"children": [
							"{initials}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"position": "absolute",
								"right": "-1px",
								"bottom": "-1px",
								"width": "10px",
								"height": "10px",
								"borderRadius": "999px",
								"borderWidth": "2px",
								"borderStyle": "solid",
								"borderColor": "#ffffff",
								"background": {
									"ttMap": {
										"arg": "presence",
										"values": {
											"online": "#2e7d32",
											"away": "#ed6c02",
											"offline": "rgba(0, 0, 0, 0.38)"
										},
										"default": "#2e7d32"
									}
								}
							}
						}
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"flex": 1,
						"minWidth": 0
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "13px",
								"fontWeight": 600,
								"color": "rgba(0, 0, 0, 0.87)"
							}
						},
						"children": [
							"{name}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "12px",
								"color": "rgba(0, 0, 0, 0.6)"
							}
						},
						"children": [
							"{mutuals}"
