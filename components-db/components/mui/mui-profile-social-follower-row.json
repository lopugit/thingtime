					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"padding": "4px 12px",
						"borderRadius": "999px",
						"background": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#e3f2fd",
									"success": "#edf7ed",
									"warning": "#fff4e5",
									"danger": "#fdeded",
									"info": "#e5f6fd",
									"neutral": "#eeeeee"
								},
								"default": "#e3f2fd"
							}
						},
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#1565c0",
									"success": "#1e4620",
									"warning": "#663c00",
									"danger": "#5f2120",
									"info": "#014361",
									"neutral": "#424242"
								},
								"default": "#1565c0"
							}
						},
						"fontSize": "12px",
						"fontWeight": 600,
						"flexShrink": 0
					}
				},
				"children": [
					"Follow"
				]
			}
		]
	},
	"version": 1,
	"familyKey": "profile-social-follower-row",
	"source": {
		"kind": "archetype",
		"archetype": "profile-social",
		"variant": "follower-row",
		"tranche": 2
	}
}
