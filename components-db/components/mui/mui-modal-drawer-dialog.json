{
	"slug": "mui-modal-drawer-dialog",
	"name": "Dialog Modal",
	"library": "mui",
	"category": "overlays",
	"description": "Centered dialog on a dimmed backdrop in the Material UI style — title with a close glyph, muted body copy, and cancel/confirm actions footed to the right.",
	"tags": [
		"modal",
		"dialog",
		"overlay",
		"actions"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Update available",
			"label": "Title",
			"maxLength": 40
		},
		{
			"name": "body",
			"type": "text",
			"default": "A new version of the workspace is ready to install. You can update now or do it later.",
			"label": "Body",
			"maxLength": 200
		},
		{
			"name": "confirmLabel",
			"type": "string",
			"default": "Update now",
			"label": "Confirm label",
			"maxLength": 24
		},
		{
			"name": "cancelLabel",
			"type": "string",
			"default": "Later",
			"label": "Cancel label",
			"maxLength": 24
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"width": "340px",
				"minHeight": "280px",
				"boxSizing": "border-box",
				"background": "rgba(12, 12, 16, 0.45)",
				"borderRadius": "4px",
				"overflow": "hidden",
				"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif",
				"alignItems": "center",
				"justifyContent": "center",
				"padding": "24px"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"background": "#ffffff",
						"color": "rgba(0, 0, 0, 0.87)",
						"borderRadius": "8px",
						"boxShadow": "0px 3px 5px -1px rgba(0,0,0,0.2), 0px 6px 10px 0px rgba(0,0,0,0.14), 0px 1px 18px 0px rgba(0,0,0,0.12)",
