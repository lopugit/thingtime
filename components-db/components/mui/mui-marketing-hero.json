{
	"slug": "mui-marketing-hero",
	"name": "Hero Section",
	"library": "mui",
	"category": "marketing",
	"description": "Centered landing hero in the Material UI style — display heading, supporting subtext, and a solid + outline button pair on Material UI tone, radius, and type tokens.",
	"tags": [
		"marketing",
		"hero",
		"landing",
		"section"
	],
	"args": [
		{
			"name": "heading",
			"type": "string",
			"default": "Ship your ideas faster",
			"label": "Heading",
			"maxLength": 60
		},
		{
			"name": "subtext",
			"type": "text",
			"default": "Everything you need to design, build, and launch — in one calm workspace.",
			"label": "Subtext",
			"maxLength": 160
		},
		{
			"name": "primaryLabel",
			"type": "string",
			"default": "Get started",
			"label": "Primary button",
			"maxLength": 30
		},
		{
			"name": "secondaryLabel",
			"type": "string",
			"default": "View demo",
			"label": "Secondary button",
			"maxLength": 30
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "section",
		"props": {
			"style": {
				"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif",
				"background": "#ffffff",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "rgba(0, 0, 0, 0.08)",
				"borderRadius": "8px",
				"boxShadow": "0px 3px 1px -2px rgba(0,0,0,0.2), 0px 2px 2px 0px rgba(0,0,0,0.14), 0px 1px 5px 0px rgba(0,0,0,0.12)",
				"padding": "44px 36px",
				"display": "flex",
				"flexDirection": "column",
				"alignItems": "center",
				"textAlign": "center",
				"gap": "12px",
				"maxWidth": "560px",
				"boxSizing": "border-box"
			}
		},
		"children": [
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "30px",
						"fontWeight": 500,
						"color": "rgba(0, 0, 0, 0.87)",
						"lineHeight": 1.15,
						"letterSpacing": "-0.02em"
					}
				},
				"children": [
					"{heading}"
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "16px",
						"color": "rgba(0, 0, 0, 0.6)",
						"lineHeight": 1.55,
						"maxWidth": "420px"
					}
				},
				"children": [
					"{subtext}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "10px",
						"marginTop": "8px",
						"justifyContent": "center",
						"flexWrap": "wrap"
					}
				},
				"children": [
					{
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"display": "inline-flex",
								"alignItems": "center",
								"justifyContent": "center",
								"gap": "8px",
								"border": "none",
								"height": "36px",
								"padding": "0 18px",
								"borderRadius": "4px",
								"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif",
								"fontWeight": 500,
								"fontSize": "14px",
								"cursor": "pointer",
								"textTransform": "uppercase",
								"letterSpacing": "0.02857em",
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#1976d2",
											"success": "#2e7d32",
											"warning": "#ed6c02",
											"danger": "#d32f2f",
											"info": "#0288d1",
											"neutral": "#616161"
										},
										"default": "#1976d2"
									}
								},
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#ffffff",
											"success": "#ffffff",
											"warning": "#ffffff",
											"danger": "#ffffff",
											"info": "#ffffff",
											"neutral": "#ffffff"
										},
										"default": "#ffffff"
									}
								},
								"boxShadow": "0px 2px 1px -1px rgba(0,0,0,0.2), 0px 1px 1px 0px rgba(0,0,0,0.14), 0px 1px 3px 0px rgba(0,0,0,0.12)"
							}
						},
						"children": [
							"{primaryLabel}"
						]
					},
					{
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"display": "inline-flex",
								"alignItems": "center",
								"justifyContent": "center",
								"gap": "8px",
								"border": "none",
								"height": "36px",
								"padding": "0 18px",
								"borderRadius": "4px",
								"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif",
								"fontWeight": 500,
								"fontSize": "14px",
								"cursor": "pointer",
								"textTransform": "uppercase",
								"letterSpacing": "0.02857em",
								"background": "transparent",
								"borderWidth": "1px",
								"borderStyle": "solid",
								"borderColor": "rgba(0, 0, 0, 0.12)",
								"color": "rgba(0, 0, 0, 0.87)"
							}
						},
						"children": [
							"{secondaryLabel}"
						]
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "marketing-hero",
	"source": {
		"kind": "archetype",
		"archetype": "marketing",
		"variant": "hero",
		"tranche": 1
	}
}
