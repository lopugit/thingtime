{
	"slug": "mui-modal-drawer-sheet",
	"name": "Bottom Sheet",
	"library": "mui",
	"category": "overlays",
	"description": "Bottom sheet rising over a dimmed backdrop in the Material UI style — a slim grab handle above the title, body copy, and a full-width tone action.",
	"tags": [
		"sheet",
		"mobile",
		"overlay",
		"bottom"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Share this page",
			"label": "Title",
			"maxLength": 40
		},
		{
			"name": "body",
			"type": "text",
			"default": "Send a link to your teammates or copy it to your clipboard.",
			"label": "Body",
			"maxLength": 200
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Copy link",
			"label": "Action label",
			"maxLength": 24
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"width": "340px",
				"minHeight": "280px",
				"boxSizing": "border-box",
				"background": "rgba(12, 12, 16, 0.45)",
				"borderRadius": "4px",
				"overflow": "hidden",
				"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif",
				"flexDirection": "column",
				"justifyContent": "flex-end",
				"alignItems": "stretch"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"background": "#ffffff",
						"color": "rgba(0, 0, 0, 0.87)",
						"borderRadius": "8px 8px 0 0",
						"boxShadow": "0px 3px 5px -1px rgba(0,0,0,0.2), 0px 6px 10px 0px rgba(0,0,0,0.14), 0px 1px 18px 0px rgba(0,0,0,0.12)",
						"display": "flex",
						"flexDirection": "column",
						"overflow": "hidden",
						"padding": "10px 20px 20px"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"width": "40px",
								"height": "4px",
								"borderRadius": "999px",
								"background": "rgba(0, 0, 0, 0.12)",
								"margin": "0 auto 14px",
								"flexShrink": 0
							}
						}
					},
					{
						"tag": "h3",
						"props": {
							"style": {
								"margin": "0 0 6px",
								"fontSize": "16px",
								"fontWeight": 500
							}
						},
						"children": [
							"{title}"
						]
					},
					{
						"tag": "p",
						"props": {
							"style": {
								"margin": "0 0 16px",
								"color": "rgba(0, 0, 0, 0.6)",
								"fontSize": "13px",
								"lineHeight": 1.6
							}
						},
						"children": [
							"{body}"
						]
					},
					{
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"display": "inline-flex",
								"alignItems": "center",
								"justifyContent": "center",
								"height": "36px",
								"padding": "0 14px",
								"borderRadius": "4px",
								"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif",
								"fontSize": "13px",
								"fontWeight": 500,
								"cursor": "pointer",
								"textTransform": "uppercase",
								"letterSpacing": "0.02857em",
								"border": "none",
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#1976d2",
											"success": "#2e7d32",
											"warning": "#ed6c02",
											"danger": "#d32f2f",
											"info": "#0288d1",
											"neutral": "#616161"
										},
										"default": "#1976d2"
									}
								},
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#ffffff",
											"success": "#ffffff",
											"warning": "#ffffff",
											"danger": "#ffffff",
											"info": "#ffffff",
											"neutral": "#ffffff"
										},
										"default": "#ffffff"
									}
								},
								"boxShadow": "0px 2px 1px -1px rgba(0,0,0,0.2), 0px 1px 1px 0px rgba(0,0,0,0.14), 0px 1px 3px 0px rgba(0,0,0,0.12)",
								"width": "100%"
							}
						},
						"children": [
							"{actionLabel}"
						]
					}
				]
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "modal-drawer",
		"variant": "sheet",
		"tranche": 1
	}
}
