{
	"slug": "mui-profile-social-achievement",
	"name": "Achievement Tile",
	"library": "mui",
	"category": "social",
	"description": "Achievement badge tile in the Material UI style — a star or zap emblem in a tone-soft circle with a tone border, title, and a progress bar with percent and 'x of y' captions.",
	"tags": [
		"profile",
		"achievement",
		"progress",
		"gamification",
		"social"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Streak Master",
			"label": "Title",
			"maxLength": 32
		},
		{
			"name": "icon",
			"type": "enum",
			"values": [
				"star",
				"zap"
			],
			"default": "star",
			"label": "Icon"
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "percent",
			"type": "number",
			"default": 60,
			"label": "Progress %",
			"min": 0,
			"max": 100
		},
		{
			"name": "done",
			"type": "number",
			"default": 3,
			"label": "Done",
			"min": 0
		},
		{
			"name": "total",
			"type": "number",
			"default": 5,
			"label": "Total",
			"min": 1
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"background": "#ffffff",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "rgba(0, 0, 0, 0.12)",
				"borderRadius": "8px",
				"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif",
				"boxShadow": "0px 2px 1px -1px rgba(0,0,0,0.2), 0px 1px 1px 0px rgba(0,0,0,0.14), 0px 1px 3px 0px rgba(0,0,0,0.12)",
				"width": "216px",
				"display": "flex",
				"flexDirection": "column",
				"alignItems": "center",
				"textAlign": "center",
				"padding": "18px 16px",
				"boxSizing": "border-box"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"width": "48px",
						"height": "48px",
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "center",
						"borderRadius": "999px",
						"background": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#e3f2fd",
									"success": "#edf7ed",
									"warning": "#fff4e5",
									"danger": "#fdeded",
									"info": "#e5f6fd",
									"neutral": "#eeeeee"
								},
								"default": "#e3f2fd"
							}
						},
						"borderWidth": "1px",
						"borderStyle": "solid",
						"borderColor": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#90caf9",
									"success": "#a5d6a7",
									"warning": "#ffb74d",
									"danger": "#ef9a9a",
									"info": "#81d4fa",
									"neutral": "#bdbdbd"
								},
								"default": "#90caf9"
							}
						},
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#1565c0",
									"success": "#1e4620",
									"warning": "#663c00",
									"danger": "#5f2120",
									"info": "#014361",
									"neutral": "#424242"
								},
								"default": "#1565c0"
							}
						}
					}
				},
				"children": [
					{
						"ttIf": {
							"arg": "icon",
							"equals": "zap",
							"then": {
								"tag": "svg",
								"props": {
									"width": 22,
									"height": 22,
									"viewBox": "0 0 24 24",
									"fill": "none",
									"stroke": "currentColor",
									"strokeWidth": 2,
									"strokeLinecap": "round",
									"strokeLinejoin": "round",
									"xmlns": "http://www.w3.org/2000/svg"
								},
								"children": [
									{
										"tag": "polygon",
										"props": {
											"points": "13 2 3 14 12 14 11 22 21 10 12 10 13 2"
										}
									}
								]
							},
							"else": {
								"tag": "svg",
								"props": {
									"width": 22,
									"height": 22,
									"viewBox": "0 0 24 24",
									"fill": "none",
									"stroke": "currentColor",
									"strokeWidth": 2,
									"strokeLinejoin": "round",
									"xmlns": "http://www.w3.org/2000/svg"
								},
								"children": [
									{
										"tag": "polygon",
										"props": {
											"points": "12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26"
										}
									}
								]
							}
						}
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"marginTop": "10px",
						"fontSize": "14px",
						"fontWeight": 500,
						"color": "rgba(0, 0, 0, 0.87)"
					}
				},
				"children": [
					"{title}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"marginTop": "12px",
						"width": "100%",
						"height": "6px",
						"borderRadius": "999px",
						"background": "rgba(0, 0, 0, 0.08)",
						"overflow": "hidden"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"width": "{percent}%",
								"height": "100%",
								"borderRadius": "999px",
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#1976d2",
											"success": "#2e7d32",
											"warning": "#ed6c02",
											"danger": "#d32f2f",
											"info": "#0288d1",
											"neutral": "#616161"
										},
										"default": "#1976d2"
									}
								}
							}
						}
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"marginTop": "8px",
						"width": "100%",
						"justifyContent": "space-between"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "12px",
								"color": "rgba(0, 0, 0, 0.6)"
							}
						},
						"children": [
							"{done} of {total}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "12px",
								"fontWeight": 600,
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#1565c0",
											"success": "#1e4620",
											"warning": "#663c00",
											"danger": "#5f2120",
											"info": "#014361",
											"neutral": "#424242"
										},
										"default": "#1565c0"
									}
								}
							}
						},
						"children": [
							"{percent}%"
						]
					}
				]
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "profile-social",
		"variant": "achievement",
		"tranche": 2
	}
}
