{
	"slug": "mui-data-viz-gauge",
	"name": "Gauge",
	"library": "mui",
	"category": "data-display",
	"description": "Semicircle gauge in the Material UI style — a soft svg arc track with a tone-colored needle rotated by CSS calc from the percent value, pivot dot, and a big value caption below.",
	"tags": [
		"chart",
		"gauge",
		"meter",
		"kpi"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "CPU load",
			"label": "Title",
			"maxLength": 32
		},
		{
			"name": "percent",
			"type": "number",
			"default": 64,
			"label": "Percent",
			"min": 0,
			"max": 100
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "suffix",
			"type": "string",
			"default": "%",
			"label": "Suffix",
			"maxLength": 6
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"width": "188px",
				"boxSizing": "border-box",
				"padding": "14px 16px",
				"fontFamily": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif",
				"background": "#ffffff",
				"border": "1px solid rgba(0, 0, 0, 0.12)",
				"borderRadius": "4px",
				"boxShadow": "0px 3px 1px -2px rgba(0,0,0,0.2), 0px 2px 2px 0px rgba(0,0,0,0.14), 0px 1px 5px 0px rgba(0,0,0,0.12)",
				"alignItems": "center"
			}
		},
		"children": [
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "12px",
						"fontWeight": 500,
						"color": "rgba(0, 0, 0, 0.6)",
						"textTransform": "uppercase",
						"letterSpacing": "0.05em"
					}
				},
				"children": [
					"{title}"
				]
			},
			{
				"tag": "svg",
				"props": {
					"width": 120,
					"height": 70,
					"viewBox": "0 0 100 58",
					"xmlns": "http://www.w3.org/2000/svg"
				},
				"children": [
					{
						"tag": "path",
						"props": {
							"d": "M 12 52 A 38 38 0 0 1 88 52",
							"fill": "none",
							"stroke": "rgba(0, 0, 0, 0.08)",
							"strokeWidth": 8,
							"strokeLinecap": "round"
						}
					},
					{
						"tag": "line",
						"props": {
							"x1": 50,
							"y1": 52,
							"x2": 50,
							"y2": 21,
							"stroke": {
								"ttMap": {
									"arg": "tone",
									"values": {
										"primary": "#1976d2",
										"success": "#2e7d32",
										"warning": "#ed6c02",
										"danger": "#d32f2f",
										"info": "#0288d1",
										"neutral": "#616161"
									},
									"default": "#1976d2"
								}
							},
							"strokeWidth": 3,
							"strokeLinecap": "round",
							"style": {
								"transform": "rotate(calc({percent} * 1.8deg - 90deg))",
								"transformOrigin": "50px 52px"
							}
						}
					},
					{
						"tag": "circle",
						"props": {
							"cx": 50,
							"cy": 52,
							"r": 4.5,
							"fill": {
								"ttMap": {
									"arg": "tone",
									"values": {
										"primary": "#1976d2",
										"success": "#2e7d32",
										"warning": "#ed6c02",
										"danger": "#d32f2f",
										"info": "#0288d1",
										"neutral": "#616161"
									},
									"default": "#1976d2"
								}
							}
						}
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"justifyContent": "space-between",
						"width": "120px",
						"fontSize": "12px",
						"color": "rgba(0, 0, 0, 0.38)"
					}
				},
				"children": [
					{
						"tag": "span",
						"children": [
							"0"
						]
					},
					{
						"tag": "span",
						"children": [
							"100"
						]
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"marginTop": "2px",
						"fontSize": "20px",
						"fontWeight": 500,
						"color": "rgba(0, 0, 0, 0.87)"
					}
				},
				"children": [
					"{percent}{suffix}"
				]
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "data-viz",
		"variant": "gauge",
		"tranche": 2
	}
}
