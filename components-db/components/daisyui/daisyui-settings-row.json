{
	"slug": "daisyui-settings-row",
	"name": "Settings Row",
	"library": "daisyui",
	"category": "settings",
	"description": "Single preference row in the daisyUI style — title and helper caption on the left, a chunky switch on the right, hairline dividers above and below.",
	"tags": [
		"settings",
		"row",
		"switch",
		"preference"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Email notifications",
			"label": "Title",
			"maxLength": 40
		},
		{
			"name": "caption",
			"type": "string",
			"default": "Get a digest of workspace activity",
			"label": "Caption",
			"maxLength": 80
		},
		{
			"name": "enabled",
			"type": "boolean",
			"default": true,
			"label": "Enabled"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"alignItems": "center",
				"width": "320px",
				"boxSizing": "border-box",
				"justifyContent": "space-between",
				"gap": "16px",
				"padding": "12px 4px",
				"background": "#ffffff",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"borderTopWidth": "1px",
				"borderTopStyle": "solid",
				"borderTopColor": "#f2f2f2",
				"borderBottomWidth": "1px",
				"borderBottomStyle": "solid",
				"borderBottomColor": "#f2f2f2"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"gap": "2px",
						"minWidth": 0
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "14px",
								"fontWeight": 700,
								"color": "#1f2937"
							}
						},
						"children": [
							"{title}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "12px",
								"color": "#6b7280"
							}
						},
						"children": [
							"{caption}"
						]
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"width": "44px",
						"height": "24px",
						"padding": "3px",
						"boxSizing": "border-box",
						"borderRadius": "999px",
						"background": {
							"ttIf": {
								"arg": "enabled",
								"then": "#570df8",
								"else": "#9ca3af"
							}
						},
						"display": "flex",
						"alignItems": "center",
						"justifyContent": {
							"ttIf": {
								"arg": "enabled",
								"then": "flex-end",
								"else": "flex-start"
							}
						},
						"flexShrink": 0
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"width": "18px",
								"height": "18px",
								"borderRadius": "999px",
								"background": "#ffffff",
								"boxShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.05)"
							}
						}
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "settings-row",
	"source": {
		"kind": "archetype",
		"archetype": "settings",
		"variant": "row",
		"tranche": 2
	}
}
