								"arg": "active",
								"equals": "2",
								"then": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
								"else": "none"
							}
						}
					}
				},
				"children": [
					"{tab2}"
				]
			},
			{
				"tag": "button",
				"props": {
					"type": "button",
					"style": {
						"border": "none",
						"background": {
							"ttIf": {
								"arg": "active",
								"equals": "3",
								"then": "#ffffff",
								"else": "transparent"
							}
