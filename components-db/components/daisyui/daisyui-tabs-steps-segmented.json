{
	"slug": "daisyui-tabs-steps-segmented",
	"name": "Segmented Tabs",
	"library": "daisyui",
	"category": "navigation",
	"description": "Segmented control in the daisyUI style — tabs sit in a tinted track and the active segment lifts onto a raised surface chip.",
	"tags": [
		"tabs",
		"segmented",
		"control",
		"navigation"
	],
	"args": [
		{
			"name": "tab1",
			"type": "string",
			"default": "Overview",
			"label": "Tab 1",
			"maxLength": 24
		},
		{
			"name": "tab2",
			"type": "string",
			"default": "Activity",
			"label": "Tab 2",
			"maxLength": 24
		},
		{
			"name": "tab3",
			"type": "string",
			"default": "Settings",
			"label": "Tab 3",
			"maxLength": 24
		},
		{
			"name": "active",
			"type": "enum",
			"values": [
				"1",
				"2",
				"3"
			],
			"default": "1",
			"label": "Active tab"
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "inline-flex",
				"alignItems": "center",
				"padding": "3px",
				"gap": "2px",
				"background": "#f2f2f2",
				"border": "1px solid #f2f2f2",
				"borderRadius": "999px",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
			}
		},
		"children": [
			{
				"tag": "button",
				"props": {
					"type": "button",
					"style": {
						"border": "none",
						"background": {
							"ttIf": {
								"arg": "active",
								"equals": "1",
								"then": "#ffffff",
								"else": "transparent"
							}
						},
						"cursor": "pointer",
						"padding": "0 14px",
						"margin": 0,
						"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
						"fontWeight": 600,
						"display": "inline-flex",
						"alignItems": "center",
						"justifyContent": "center",
						"height": "32px",
						"fontSize": "14px",
						"borderRadius": "999px",
						"color": {
							"ttIf": {
								"arg": "active",
								"equals": "1",
								"then": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#570df8",
											"success": "#00a96e",
											"warning": "#ffbe00",
											"danger": "#ff5861",
											"info": "#00b6ff",
											"neutral": "#2a323c"
										},
										"default": "#570df8"
									}
								},
								"else": "#6b7280"
							}
						},
						"boxShadow": {
							"ttIf": {
								"arg": "active",
								"equals": "1",
								"then": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
								"else": "none"
							}
						}
					}
				},
				"children": [
					"{tab1}"
				]
			},
			{
				"tag": "button",
				"props": {
					"type": "button",
					"style": {
						"border": "none",
						"background": {
							"ttIf": {
								"arg": "active",
