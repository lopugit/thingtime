						"fontWeight": 600,
						"display": "inline-flex",
						"alignItems": "center",
						"justifyContent": "center",
						"height": "32px",
						"fontSize": "14px",
						"borderRadius": "999px",
						"color": {
							"ttIf": {
								"arg": "active",
								"equals": "3",
								"then": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#570df8",
											"success": "#00a96e",
