{
	"slug": "daisyui-docs-wiki-version",
	"name": "Docs Version Picker",
	"library": "daisyui",
	"category": "documentation",
	"description": "Docs version picker in the daisyUI style — mono version pill trigger over an open menu that tags the latest release with a tone chip, checks the active row and ends in a ghost changelog row.",
	"tags": [
		"docs",
		"version",
		"picker",
		"menu"
	],
	"args": [
		{
			"name": "version",
			"type": "string",
			"default": "2.4",
			"label": "Version",
			"maxLength": 12
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "success",
			"label": "Tone"
		},
		{
			"name": "open",
			"type": "boolean",
			"default": true,
			"label": "Menu open"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"gap": "8px",
				"alignItems": "flex-start",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
			}
		},
		"children": [
			{
				"tag": "button",
				"props": {
					"type": "button",
					"style": {
						"display": "inline-flex",
						"alignItems": "center",
						"gap": "6px",
						"height": "32px",
						"padding": "0 12px",
						"borderRadius": "999px",
						"border": "1px solid #e5e6e6",
						"background": "#ffffff",
						"color": "#1f2937",
						"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
						"fontSize": "14px",
						"fontWeight": 600,
						"cursor": "pointer",
						"boxShadow": "none"
					}
				},
				"children": [
					"v{version}",
					{
						"tag": "svg",
						"props": {
							"width": 14,
							"height": 14,
							"viewBox": "0 0 24 24",
							"fill": "none",
							"stroke": "currentColor",
							"strokeWidth": 2,
							"strokeLinecap": "round",
							"strokeLinejoin": "round",
							"xmlns": "http://www.w3.org/2000/svg"
						},
						"children": [
							{
								"tag": "polyline",
								"props": {
									"points": "6 9 12 15 18 9"
								}
							}
						]
					}
				]
			},
			{
				"ttIf": {
					"arg": "open",
					"then": {
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"flexDirection": "column",
								"gap": "2px",
								"width": "220px",
								"padding": "6px",
								"background": "#ffffff",
								"borderRadius": "16px",
								"border": "1px solid #f2f2f2",
								"boxShadow": "0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1)"
							}
						},
						"children": [
							{
								"tag": "div",
								"props": {
									"style": {
										"display": "flex",
										"alignItems": "center",
										"justifyContent": "space-between",
										"padding": "6px 10px",
										"borderRadius": "8px",
										"background": "#f2f2f2"
									}
								},
								"children": [
									{
										"tag": "div",
										"props": {
											"style": {
												"display": "flex",
												"alignItems": "center",
												"gap": "8px"
											}
										},
										"children": [
											{
												"tag": "span",
												"props": {
													"style": {
														"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
														"fontSize": "14px",
														"fontWeight": 600,
														"color": "#1f2937"
													}
												},
												"children": [
													"v{version}"
												]
											},
											{
												"tag": "span",
												"props": {
													"style": {
														"display": "inline-flex",
														"alignItems": "center",
														"padding": "1px 7px",
														"borderRadius": "999px",
														"background": {
															"ttMap": {
																"arg": "tone",
																"values": {
																	"primary": "#eee6ff",
																	"success": "#dcfce7",
																	"warning": "#fef9c3",
																	"danger": "#ffe4e6",
																	"info": "#e0f2fe",
																	"neutral": "#f2f2f2"
																},
																"default": "#eee6ff"
															}
														},
														"color": {
															"ttMap": {
																"arg": "tone",
																"values": {
																	"primary": "#4506cb",
																	"success": "#00753d",
																	"warning": "#854d0e",
																	"danger": "#be123c",
																	"info": "#0369a1",
																	"neutral": "#2a323c"
																},
																"default": "#4506cb"
															}
														},
														"fontSize": "12px",
														"fontWeight": 700
													}
												},
												"children": [
													"latest"
												]
											}
										]
									},
									{
										"tag": "svg",
										"props": {
											"width": 14,
											"height": 14,
											"viewBox": "0 0 24 24",
											"fill": "none",
											"stroke": {
												"ttMap": {
													"arg": "tone",
													"values": {
														"primary": "#570df8",
														"success": "#00a96e",
														"warning": "#ffbe00",
														"danger": "#ff5861",
														"info": "#00b6ff",
														"neutral": "#2a323c"
													},
													"default": "#570df8"
												}
											},
											"strokeWidth": 2,
											"strokeLinecap": "round",
											"strokeLinejoin": "round",
											"xmlns": "http://www.w3.org/2000/svg"
										},
										"children": [
											{
												"tag": "polyline",
												"props": {
													"points": "20 6 9 17 4 12"
												}
											}
										]
									}
								]
							},
							{
								"tag": "div",
								"props": {
									"style": {
										"padding": "6px 10px",
										"borderRadius": "8px",
										"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
										"fontSize": "14px",
										"color": "#6b7280"
									}
								},
								"children": [
									"v2.3"
								]
							},
							{
								"tag": "div",
								"props": {
									"style": {
										"padding": "6px 10px",
										"borderRadius": "8px",
										"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
										"fontSize": "14px",
										"color": "#6b7280"
									}
								},
								"children": [
									"v1.9"
								]
							},
							{
								"tag": "div",
								"props": {
									"style": {
										"height": "1px",
										"background": "#f2f2f2",
										"margin": "4px 2px"
									}
								}
							},
							{
								"tag": "div",
								"props": {
									"style": {
										"display": "flex",
										"alignItems": "center",
										"gap": "6px",
										"padding": "6px 10px",
										"fontSize": "14px",
										"fontWeight": 500,
										"color": "#6b7280",
										"cursor": "pointer"
									}
								},
								"children": [
									"View changelog",
									{
										"tag": "svg",
										"props": {
											"width": 12,
											"height": 12,
											"viewBox": "0 0 24 24",
											"fill": "none",
											"stroke": "currentColor",
											"strokeWidth": 2,
											"strokeLinecap": "round",
											"strokeLinejoin": "round",
											"xmlns": "http://www.w3.org/2000/svg"
										},
										"children": [
											{
												"tag": "line",
												"props": {
													"x1": 5,
													"y1": 12,
													"x2": 19,
													"y2": 12
												}
											},
											{
												"tag": "polyline",
												"props": {
													"points": "12 5 19 12 12 19"
												}
											}
										]
									}
								]
							}
						]
					}
				}
			}
		]
	},
	"version": 1,
	"familyKey": "docs-wiki-version",
	"source": {
		"kind": "archetype",
		"archetype": "docs-wiki",
		"variant": "version",
		"tranche": 2
	}
}
