{
	"slug": "daisyui-button-icon",
	"name": "Icon Button",
	"library": "daisyui",
	"category": "buttons",
	"description": "Button with a leading icon in the daisyUI style — a plus glyph beside the label, optional icon-only square mode.",
	"tags": [
		"button",
		"action",
		"icon"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "New item",
			"label": "Label",
			"maxLength": 40
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "iconOnly",
			"type": "boolean",
			"default": false,
			"label": "Icon only"
		},
		{
			"name": "disabled",
			"type": "boolean",
			"default": false,
			"label": "Disabled"
		}
	],
	"render": {
		"tag": "button",
		"props": {
			"type": "button",
			"style": {
				"ttMerge": [
					{
						"display": "inline-flex",
						"alignItems": "center",
						"justifyContent": "center",
						"gap": "8px",
						"border": "none",
						"borderRadius": "12px",
						"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
						"fontWeight": 600,
						"cursor": "pointer"
					},
					{
						"height": "48px",
						"fontSize": "14px",
						"padding": {
							"ttIf": {
								"arg": "iconOnly",
								"then": "0",
								"else": "0 16px"
							}
						},
						"width": {
							"ttIf": {
								"arg": "iconOnly",
								"then": "48px",
								"else": "auto"
							}
						},
						"background": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#570df8",
									"success": "#00a96e",
									"warning": "#ffbe00",
									"danger": "#ff5861",
									"info": "#00b6ff",
									"neutral": "#2a323c"
								},
								"default": "#570df8"
							}
						},
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#ffffff",
									"success": "#ffffff",
									"warning": "#382800",
									"danger": "#ffffff",
									"info": "#ffffff",
									"neutral": "#ffffff"
								},
								"default": "#ffffff"
							}
						},
						"boxShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.05)"
					},
					{
						"ttIf": {
							"arg": "disabled",
							"then": {
								"opacity": 0.5,
								"cursor": "not-allowed"
							},
							"else": {}
						}
					}
				]
			}
		},
		"children": [
			{
				"tag": "svg",
				"props": {
					"width": 16,
					"height": 16,
					"viewBox": "0 0 24 24",
					"fill": "none",
					"stroke": "currentColor",
					"strokeWidth": 2,
					"strokeLinecap": "round",
					"strokeLinejoin": "round",
					"xmlns": "http://www.w3.org/2000/svg"
				},
				"children": [
					{
						"tag": "line",
						"props": {
							"x1": 12,
							"y1": 5,
							"x2": 12,
							"y2": 19
						}
					},
					{
						"tag": "line",
						"props": {
							"x1": 5,
							"y1": 12,
							"x2": 19,
							"y2": 12
						}
					}
				]
			},
			{
				"ttIf": {
					"arg": "iconOnly",
					"then": "",
					"else": "{label}"
				}
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "button",
		"variant": "icon",
		"tranche": 1
	}
}
