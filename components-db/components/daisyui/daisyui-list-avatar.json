{
	"slug": "daisyui-list-avatar",
	"name": "Avatar List",
	"library": "daisyui",
	"category": "data-display",
	"description": "Avatar-and-name list rows in the daisyUI style — tone-tinted initials circles beside names, a faint recency mark trailing each row.",
	"tags": [
		"list",
		"avatar",
		"people",
		"data"
	],
	"args": [
		{
			"name": "name",
			"type": "string",
			"default": "Alex Rivers",
			"label": "Name",
			"maxLength": 40
		},
		{
			"name": "initials",
			"type": "string",
			"default": "AR",
			"label": "Initials",
			"maxLength": 3
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "count",
			"type": "number",
			"default": 3,
			"label": "Rows",
			"min": 1,
			"max": 6
		}
	],
	"render": {
		"tag": "ul",
		"props": {
			"style": {
				"ttMerge": [
					{
						"listStyle": "none",
						"margin": 0,
						"padding": 0,
						"width": "280px",
						"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
						"color": "#1f2937",
						"background": "#ffffff",
						"borderRadius": "12px",
						"overflow": "hidden"
					},
					{
						"border": "1px solid #e5e6e6",
						"boxShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.05)"
					}
				]
			}
		},
		"children": [
			{
				"ttRepeat": {
					"arg": "count",
					"max": 6,
					"node": {
						"tag": "li",
						"props": {
							"style": {
								"ttMerge": [
									{
										"display": "flex",
										"alignItems": "center",
										"gap": "12px",
										"padding": "10px 14px",
										"fontSize": "14px"
									},
									{
										"ttIf": {
											"arg": "n",
											"equals": 1,
											"then": {},
											"else": {
												"borderTop": "1px solid #f2f2f2"
											}
										}
									}
								]
							}
						},
						"children": [
							{
								"tag": "div",
								"props": {
									"style": {
										"width": "32px",
										"height": "32px",
										"borderRadius": "999px",
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#eee6ff",
													"success": "#dcfce7",
													"warning": "#fef9c3",
													"danger": "#ffe4e6",
													"info": "#e0f2fe",
													"neutral": "#f2f2f2"
												},
												"default": "#eee6ff"
											}
										},
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#4506cb",
													"success": "#00753d",
													"warning": "#854d0e",
													"danger": "#be123c",
													"info": "#0369a1",
													"neutral": "#2a323c"
												},
												"default": "#4506cb"
											}
										},
										"display": "flex",
										"alignItems": "center",
										"justifyContent": "center",
										"fontWeight": 600,
										"fontSize": "12px",
										"flexShrink": 0
									}
								},
								"children": [
									"{initials}"
								]
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"fontWeight": 500,
										"flexGrow": 1
									}
								},
								"children": [
									"{name}"
								]
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"color": "#9ca3af",
										"fontSize": "12px"
									}
								},
								"children": [
									"{n}h"
								]
							}
						]
					}
				}
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "list",
		"variant": "avatar",
		"tranche": 1
	}
}
