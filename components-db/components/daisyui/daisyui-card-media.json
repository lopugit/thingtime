{
	"slug": "daisyui-card-media",
	"name": "Media Card",
	"library": "daisyui",
	"category": "layout",
	"description": "Card with a media block in the daisyUI style — a tone-gradient placeholder banner over a badge, title and body.",
	"tags": [
		"card",
		"media",
		"image",
		"banner"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Golden hour",
			"label": "Title",
			"maxLength": 60
		},
		{
			"name": "body",
			"type": "text",
			"default": "A placeholder media block stands in for imagery — no external assets needed.",
			"label": "Body"
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "mediaHeight",
			"type": "enum",
			"values": [
				"sm",
				"md",
				"lg"
			],
			"default": "md",
			"label": "Media height"
		},
		{
			"name": "badge",
			"type": "string",
			"default": "New",
			"label": "Badge",
			"maxLength": 20
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"width": "300px",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"background": "#ffffff",
				"color": "#1f2937",
				"border": "1px solid #e5e6e6",
				"borderRadius": "16px",
				"boxShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
				"overflow": "hidden",
				"boxSizing": "border-box"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"ttMerge": [
							{
								"display": "flex",
								"alignItems": "center",
								"justifyContent": "center",
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "linear-gradient(135deg, #eee6ff 0%, #d6c4fd 60%, #570df8 140%)",
											"success": "linear-gradient(135deg, #dcfce7 0%, #86efac 60%, #00a96e 140%)",
											"warning": "linear-gradient(135deg, #fef9c3 0%, #fde047 60%, #ffbe00 140%)",
											"danger": "linear-gradient(135deg, #ffe4e6 0%, #fda4af 60%, #ff5861 140%)",
											"info": "linear-gradient(135deg, #e0f2fe 0%, #7dd3fc 60%, #00b6ff 140%)",
											"neutral": "linear-gradient(135deg, #f2f2f2 0%, #d1d5db 60%, #2a323c 140%)"
										},
										"default": "linear-gradient(135deg, #eee6ff 0%, #d6c4fd 60%, #570df8 140%)"
									}
								}
							},
							{
								"ttMap": {
									"arg": "mediaHeight",
									"values": {
										"sm": {
											"height": "72px"
										},
										"md": {
											"height": "112px"
										},
										"lg": {
											"height": "152px"
										}
									},
									"default": {
										"height": "112px"
									}
								}
							}
						]
					}
				},
				"children": [
					{
						"tag": "svg",
						"props": {
							"width": 28,
							"height": 28,
							"viewBox": "0 0 24 24",
							"fill": "none",
							"stroke": {
								"ttMap": {
									"arg": "tone",
									"values": {
										"primary": "#4506cb",
										"success": "#00753d",
										"warning": "#854d0e",
										"danger": "#be123c",
										"info": "#0369a1",
										"neutral": "#2a323c"
									},
									"default": "#4506cb"
								}
							},
							"strokeWidth": 2,
							"strokeLinecap": "round",
							"strokeLinejoin": "round",
							"xmlns": "http://www.w3.org/2000/svg"
						},
						"children": [
							{
								"tag": "rect",
								"props": {
									"x": 3,
									"y": 3,
									"width": 18,
									"height": 18,
									"rx": 2
								}
							},
							{
								"tag": "circle",
								"props": {
									"cx": 8.5,
									"cy": 8.5,
									"r": 1.5
								}
							},
							{
								"tag": "polyline",
								"props": {
									"points": "21 15 16 10 5 21"
								}
							}
						]
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"padding": "16px",
						"gap": "8px"
					}
				},
				"children": [
					{
						"ttIf": {
							"arg": "badge",
							"then": {
								"tag": "span",
								"props": {
									"style": {
										"alignSelf": "flex-start",
										"padding": "2px 8px",
										"borderRadius": "999px",
										"fontSize": "12px",
										"fontWeight": 600,
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#eee6ff",
													"success": "#dcfce7",
													"warning": "#fef9c3",
													"danger": "#ffe4e6",
													"info": "#e0f2fe",
													"neutral": "#f2f2f2"
												},
												"default": "#eee6ff"
											}
										},
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#4506cb",
													"success": "#00753d",
													"warning": "#854d0e",
													"danger": "#be123c",
													"info": "#0369a1",
													"neutral": "#2a323c"
												},
												"default": "#4506cb"
											}
										},
										"border": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "1px solid #d6c4fd",
													"success": "1px solid #86efac",
													"warning": "1px solid #fde047",
													"danger": "1px solid #fda4af",
													"info": "1px solid #7dd3fc",
													"neutral": "1px solid #d1d5db"
												},
												"default": "1px solid #d6c4fd"
											}
										}
									}
								},
								"children": [
									"{badge}"
								]
							}
						}
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "18px",
								"fontWeight": 700,
								"color": "#1f2937"
							}
						},
						"children": [
							"{title}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "14px",
								"color": "#6b7280",
								"lineHeight": 1.5
							}
						},
						"children": [
							"{body}"
						]
					}
				]
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "card",
		"variant": "media",
		"tranche": 1
	}
}
