{
	"slug": "daisyui-modal-drawer-drawer",
	"name": "Side Drawer",
	"library": "daisyui",
	"category": "overlays",
	"description": "Right-side drawer panel over a dimmed backdrop in the daisyUI style — flush to the edge with rounded inner corners, a titled header, and a tone-highlighted menu.",
	"tags": [
		"drawer",
		"panel",
		"overlay",
		"navigation"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Workspace settings",
			"label": "Title",
			"maxLength": 40
		},
		{
			"name": "item",
			"type": "string",
			"default": "Menu item",
			"label": "Item label",
			"maxLength": 40
		},
		{
			"name": "items",
			"type": "number",
			"default": 4,
			"label": "Items",
			"min": 1,
			"max": 6
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"width": "340px",
				"minHeight": "300px",
				"boxSizing": "border-box",
				"background": "rgba(12, 12, 16, 0.45)",
				"borderRadius": "12px",
				"overflow": "hidden",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"justifyContent": "flex-end",
				"alignItems": "stretch"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"background": "#ffffff",
						"color": "#1f2937",
						"borderRadius": "16px 0 0 16px",
						"boxShadow": "0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1)",
						"display": "flex",
						"flexDirection": "column",
						"overflow": "hidden",
						"width": "224px"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"justifyContent": "space-between",
								"gap": "8px",
								"padding": "16px 12px 12px 16px"
							}
						},
						"children": [
							{
								"tag": "h3",
								"props": {
									"style": {
										"margin": 0,
										"fontSize": "14px",
										"fontWeight": 700
									}
								},
								"children": [
									"{title}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "none",
										"background": "transparent",
										"color": "#9ca3af",
										"cursor": "pointer",
										"padding": "4px",
										"display": "inline-flex",
										"alignItems": "center",
										"justifyContent": "center",
										"borderRadius": "8px",
										"flexShrink": 0
									}
								},
								"children": [
									{
										"tag": "svg",
										"props": {
											"width": 16,
											"height": 16,
											"viewBox": "0 0 24 24",
											"fill": "none",
											"stroke": "currentColor",
											"strokeWidth": 2,
											"strokeLinecap": "round",
											"strokeLinejoin": "round",
											"xmlns": "http://www.w3.org/2000/svg"
										},
										"children": [
											{
												"tag": "line",
												"props": {
													"x1": 18,
													"y1": 6,
													"x2": 6,
													"y2": 18
												}
											},
											{
												"tag": "line",
												"props": {
													"x1": 6,
													"y1": 6,
													"x2": 18,
													"y2": 18
												}
											}
										]
									}
								]
							}
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"height": "1px",
								"background": "#f2f2f2",
								"margin": "0 0 8px",
								"flexShrink": 0
							}
						}
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"flexDirection": "column",
								"gap": "2px",
								"padding": "0 8px"
							}
						},
						"children": [
							{
								"ttRepeat": {
									"arg": "items",
									"max": 6,
									"node": {
										"tag": "div",
										"props": {
											"style": {
												"ttMerge": [
													{
														"display": "flex",
														"alignItems": "center",
														"gap": "10px",
														"padding": "8px 10px",
														"borderRadius": "12px",
														"fontSize": "14px"
													},
													{
														"ttIf": {
															"arg": "n",
															"equals": 1,
															"then": {
																"background": {
																	"ttMap": {
																		"arg": "tone",
																		"values": {
																			"primary": "#eee6ff",
																			"success": "#dcfce7",
																			"warning": "#fef9c3",
																			"danger": "#ffe4e6",
																			"info": "#e0f2fe",
																			"neutral": "#f2f2f2"
																		},
																		"default": "#eee6ff"
																	}
																},
																"color": {
																	"ttMap": {
																		"arg": "tone",
																		"values": {
																			"primary": "#4506cb",
																			"success": "#00753d",
																			"warning": "#854d0e",
																			"danger": "#be123c",
																			"info": "#0369a1",
																			"neutral": "#2a323c"
																		},
																		"default": "#4506cb"
																	}
																},
																"fontWeight": 600
															},
															"else": {
																"color": "#6b7280"
															}
														}
													}
												]
											}
										},
										"children": [
											{
												"tag": "svg",
												"props": {
													"width": 15,
													"height": 15,
													"viewBox": "0 0 24 24",
													"fill": "none",
													"stroke": "currentColor",
													"strokeWidth": 2,
													"strokeLinecap": "round",
													"strokeLinejoin": "round",
													"xmlns": "http://www.w3.org/2000/svg"
												},
												"children": [
													{
														"tag": "path",
														"props": {
															"d": "M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"
														}
													}
												]
											},
											"{item} {n}"
										]
									}
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "modal-drawer-drawer",
	"source": {
		"kind": "archetype",
		"archetype": "modal-drawer",
		"variant": "drawer",
		"tranche": 1
	}
}
