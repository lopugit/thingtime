{
	"slug": "daisyui-code-block-block",
	"name": "Code Block",
	"library": "daisyui",
	"category": "data-display",
	"description": "Highlighted code block in the daisyUI style — filename header bar with a copy glyph, line-number gutter, and fake syntax colors drawn from the library palette.",
	"tags": [
		"code",
		"block",
		"syntax",
		"snippet"
	],
	"args": [
		{
			"name": "filename",
			"type": "string",
			"default": "app.ts",
			"label": "Filename",
			"maxLength": 40
		},
		{
			"name": "copyLabel",
			"type": "string",
			"default": "Copy",
			"label": "Copy label",
			"maxLength": 16
		},
		{
			"name": "lineNumbers",
			"type": "boolean",
			"default": true,
			"label": "Line numbers"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "#e5e6e6",
				"borderRadius": "12px",
				"overflow": "hidden",
				"background": "#ffffff",
				"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
				"fontSize": "14px"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"padding": "8px 12px",
						"gap": "8px",
						"background": "#f2f2f2",
						"borderBottomWidth": "1px",
						"borderBottomStyle": "solid",
						"borderBottomColor": "#f2f2f2"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "12px",
								"fontWeight": 600,
								"color": "#1f2937"
							}
						},
						"children": [
							"{filename}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"flex": 1
							}
						}
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"gap": "5px",
								"color": "#6b7280",
								"fontSize": "12px",
								"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
							}
						},
						"children": [
							{
								"tag": "svg",
								"props": {
									"width": 12,
									"height": 12,
									"viewBox": "0 0 24 24",
									"fill": "none",
									"stroke": "currentColor",
									"strokeWidth": 2,
									"strokeLinecap": "round",
									"strokeLinejoin": "round",
									"xmlns": "http://www.w3.org/2000/svg"
								},
								"children": [
									{
										"tag": "rect",
										"props": {
											"x": 9,
											"y": 9,
											"width": 13,
											"height": 13,
											"rx": 2
										}
									},
									{
										"tag": "path",
										"props": {
											"d": "M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
										}
									}
								]
							},
							"{copyLabel}"
						]
					}
				]
			},
			{
				"tag": "pre",
				"props": {
					"style": {
						"margin": 0,
						"padding": "12px 14px",
						"display": "flex",
						"gap": "14px",
						"overflowX": "auto",
						"lineHeight": 1.7
					}
				},
				"children": [
					{
						"ttIf": {
							"arg": "lineNumbers",
							"then": {
								"tag": "div",
								"props": {
									"style": {
										"display": "flex",
										"flexDirection": "column",
										"color": "#9ca3af",
										"textAlign": "right",
										"flexShrink": 0
									}
								},
								"children": [
									{
										"tag": "span",
										"children": [
											"1"
										]
									},
									{
										"tag": "span",
										"children": [
											"2"
										]
									},
									{
										"tag": "span",
										"children": [
											"3"
										]
									},
									{
										"tag": "span",
										"children": [
											"4"
										]
									},
									{
										"tag": "span",
										"children": [
											"5"
										]
									}
								]
							}
						}
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"flexDirection": "column",
								"color": "#1f2937"
							}
						},
						"children": [
							{
								"tag": "div",
								"children": [
									{
										"tag": "span",
										"props": {
											"style": {
												"color": "#00b6ff"
											}
										},
										"children": [
											"import"
										]
									},
									" { api } ",
									{
										"tag": "span",
										"props": {
											"style": {
												"color": "#00b6ff"
											}
										},
										"children": [
											"from"
										]
									},
									{
										"tag": "span",
										"props": {
											"style": {
												"color": "#00753d"
											}
										},
										"children": [
											" './client'"
										]
									}
								]
							},
							{
								"tag": "div",
								"children": [
									{
										"tag": "span",
										"props": {
											"style": {
												"color": "#6b7280",
												"fontStyle": "italic"
											}
										},
										"children": [
											"// fetch the latest things"
										]
									}
								]
							},
							{
								"tag": "div",
								"children": [
									{
										"tag": "span",
										"props": {
											"style": {
												"color": "#00b6ff"
											}
										},
										"children": [
											"const"
										]
									},
									" res = ",
									{
										"tag": "span",
										"props": {
											"style": {
												"color": "#00b6ff"
											}
										},
										"children": [
											"await"
										]
									},
									" api.get(",
									{
										"tag": "span",
										"props": {
											"style": {
												"color": "#00753d"
											}
										},
										"children": [
											"'/things'"
										]
									},
									")"
								]
							},
							{
								"tag": "div",
								"children": [
									{
										"tag": "span",
										"props": {
											"style": {
												"color": "#00b6ff"
											}
										},
										"children": [
											"const"
										]
									},
									" names = res.map((t) => t.name)"
								]
							},
							{
								"tag": "div",
								"children": [
									{
										"tag": "span",
										"props": {
											"style": {
												"color": "#00b6ff"
											}
										},
										"children": [
											"export"
										]
									},
									" ",
									{
										"tag": "span",
										"props": {
											"style": {
												"color": "#00b6ff"
											}
										},
										"children": [
											"default"
										]
									},
									" names"
								]
							}
						]
					}
				]
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "code-block",
		"variant": "block",
		"tranche": 2
	}
}
