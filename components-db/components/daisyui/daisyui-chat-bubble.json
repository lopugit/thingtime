{
	"slug": "daisyui-chat-bubble",
	"name": "Message Bubble Pair",
	"library": "daisyui",
	"category": "messaging",
	"description": "Incoming and outgoing chat bubbles in the daisyUI style — quiet surface on the left, tone-solid reply on the right, extra-round corners with a sharp tail edge and a timestamp.",
	"tags": [
		"chat",
		"message",
		"bubble",
		"conversation"
	],
	"args": [
		{
			"name": "incoming",
			"type": "string",
			"default": "Hey! Did you see the launch?",
			"label": "Incoming message",
			"maxLength": 120
		},
		{
			"name": "outgoing",
			"type": "string",
			"default": "Just saw it — looks great!",
			"label": "Outgoing message",
			"maxLength": 120
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "time",
			"type": "string",
			"default": "9:41 AM",
			"label": "Timestamp",
			"maxLength": 12
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"gap": "6px",
				"width": "280px",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"padding": "8px 12px",
						"maxWidth": "220px",
						"fontSize": "14px",
						"lineHeight": 1.45,
						"background": "#f2f2f2",
						"color": "#1f2937",
						"borderRadius": "16px 16px 16px 8px",
						"alignSelf": "flex-start"
					}
				},
				"children": [
					"{incoming}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"padding": "8px 12px",
						"maxWidth": "220px",
						"fontSize": "14px",
						"lineHeight": 1.45,
						"background": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#570df8",
									"success": "#00a96e",
									"warning": "#ffbe00",
									"danger": "#ff5861",
									"info": "#00b6ff",
									"neutral": "#2a323c"
								},
								"default": "#570df8"
							}
						},
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#ffffff",
									"success": "#ffffff",
									"warning": "#382800",
									"danger": "#ffffff",
									"info": "#ffffff",
									"neutral": "#ffffff"
								},
								"default": "#ffffff"
							}
						},
						"borderRadius": "16px 16px 8px 16px",
						"alignSelf": "flex-end"
					}
				},
				"children": [
					"{outgoing}"
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"alignSelf": "flex-end",
						"fontSize": "12px",
						"color": "#6b7280"
					}
				},
				"children": [
					"{time}"
				]
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "chat",
		"variant": "bubble",
		"tranche": 2
	}
}
