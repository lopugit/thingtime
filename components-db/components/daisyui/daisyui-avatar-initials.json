{
	"slug": "daisyui-avatar-initials",
	"name": "Initials Avatar",
	"library": "daisyui",
	"category": "data-display",
	"description": "Circular initials avatar in the daisyUI style — tone-filled disc with library type, optional soft tint and a surface-offset ring.",
	"tags": [
		"avatar",
		"initials",
		"profile"
	],
	"args": [
		{
			"name": "initials",
			"type": "string",
			"default": "NF",
			"label": "Initials",
			"maxLength": 3
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "size",
			"type": "enum",
			"values": [
				"sm",
				"md",
				"lg"
			],
			"default": "md",
			"label": "Size"
		},
		{
			"name": "soft",
			"type": "boolean",
			"default": false,
			"label": "Soft tint"
		},
		{
			"name": "ring",
			"type": "boolean",
			"default": false,
			"label": "Ring"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"ttMerge": [
					{
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "center",
						"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
						"fontWeight": 700,
						"borderRadius": "999px",
						"flexShrink": 0,
						"userSelect": "none"
					},
					{
						"ttMap": {
							"arg": "size",
							"values": {
								"sm": {
									"width": "28px",
									"height": "28px",
									"fontSize": "12px"
								},
								"md": {
									"width": "40px",
									"height": "40px",
									"fontSize": "14px"
								},
								"lg": {
									"width": "56px",
									"height": "56px",
									"fontSize": "18px"
								}
							},
							"default": {
								"width": "40px",
								"height": "40px",
								"fontSize": "14px"
							}
						}
					},
					{
						"ttIf": {
							"arg": "soft",
							"then": {
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#eee6ff",
											"success": "#dcfce7",
											"warning": "#fef9c3",
											"danger": "#ffe4e6",
											"info": "#e0f2fe",
											"neutral": "#f2f2f2"
										},
										"default": "#eee6ff"
									}
								},
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#4506cb",
											"success": "#00753d",
											"warning": "#854d0e",
											"danger": "#be123c",
											"info": "#0369a1",
											"neutral": "#2a323c"
										},
										"default": "#4506cb"
									}
								},
								"border": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "1px solid #d6c4fd",
											"success": "1px solid #86efac",
											"warning": "1px solid #fde047",
											"danger": "1px solid #fda4af",
											"info": "1px solid #7dd3fc",
											"neutral": "1px solid #d1d5db"
										},
										"default": "1px solid #d6c4fd"
									}
								}
							},
							"else": {
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#570df8",
											"success": "#00a96e",
											"warning": "#ffbe00",
											"danger": "#ff5861",
											"info": "#00b6ff",
											"neutral": "#2a323c"
										},
										"default": "#570df8"
									}
								},
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#ffffff",
											"success": "#ffffff",
											"warning": "#382800",
											"danger": "#ffffff",
											"info": "#ffffff",
											"neutral": "#ffffff"
										},
										"default": "#ffffff"
									}
								}
							}
						}
					},
					{
						"ttIf": {
							"arg": "ring",
							"then": {
								"boxShadow": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "0 0 0 2px #ffffff, 0 0 0 4px #d6c4fd",
											"success": "0 0 0 2px #ffffff, 0 0 0 4px #86efac",
											"warning": "0 0 0 2px #ffffff, 0 0 0 4px #fde047",
											"danger": "0 0 0 2px #ffffff, 0 0 0 4px #fda4af",
											"info": "0 0 0 2px #ffffff, 0 0 0 4px #7dd3fc",
											"neutral": "0 0 0 2px #ffffff, 0 0 0 4px #d1d5db"
										},
										"default": "0 0 0 2px #ffffff, 0 0 0 4px #d6c4fd"
									}
								}
							},
							"else": {}
						}
					}
				]
			}
		},
		"children": [
			"{initials}"
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "avatar",
		"variant": "initials",
		"tranche": 1
	}
}
