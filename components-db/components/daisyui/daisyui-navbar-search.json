{
	"slug": "daisyui-navbar-search",
	"name": "Search Navbar",
	"library": "daisyui",
	"category": "navigation",
	"description": "Navigation bar with a centered search field in the daisyUI style — brand on the left, keyboard-shortcut hint in the input, utility icons on the right.",
