{
	"slug": "daisyui-slider-progress-slider",
	"name": "Slider",
	"library": "daisyui",
	"category": "forms",
	"description": "Single-thumb slider in the daisyUI style — filled track up to the percent value, a surface thumb with a tone-colored border, optional value bubble.",
	"tags": [
		"slider",
		"input",
		"range",
		"percent"
	],
	"args": [
		{
			"name": "percent",
			"type": "number",
			"default": 40,
			"label": "Value",
			"min": 0,
			"max": 100
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "showValue",
			"type": "boolean",
			"default": true,
			"label": "Show value bubble"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"ttMerge": [
					{
						"width": "240px",
						"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
						"paddingBottom": "8px"
					},
					{
						"ttIf": {
							"arg": "showValue",
							"then": {
								"paddingTop": "36px"
							},
							"else": {
								"paddingTop": "8px"
							}
						}
					}
				]
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"position": "relative",
						"height": "8px",
						"background": "#f2f2f2",
						"borderRadius": "999px"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"width": "{percent}%",
								"height": "100%",
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#570df8",
											"success": "#00a96e",
											"warning": "#ffbe00",
											"danger": "#ff5861",
											"info": "#00b6ff",
											"neutral": "#2a323c"
										},
										"default": "#570df8"
									}
								},
								"borderRadius": "999px"
							}
						}
					},
					{
						"ttIf": {
							"arg": "showValue",
							"then": {
								"tag": "div",
								"props": {
									"style": {
										"position": "absolute",
										"left": "{percent}%",
										"top": "-32px",
										"transform": "translateX(-50%)",
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#570df8",
													"success": "#00a96e",
													"warning": "#ffbe00",
													"danger": "#ff5861",
													"info": "#00b6ff",
													"neutral": "#2a323c"
												},
												"default": "#570df8"
											}
										},
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#ffffff",
													"success": "#ffffff",
													"warning": "#382800",
													"danger": "#ffffff",
													"info": "#ffffff",
													"neutral": "#ffffff"
												},
												"default": "#ffffff"
											}
										},
										"padding": "2px 8px",
										"borderRadius": "8px",
										"fontSize": "12px",
										"fontWeight": 700
									}
								},
								"children": [
									"{percent}"
								]
							}
						}
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"position": "absolute",
								"left": "{percent}%",
								"top": "50%",
								"transform": "translate(-50%, -50%)",
								"width": "20px",
								"height": "20px",
								"borderRadius": "999px",
								"background": "#ffffff",
								"borderWidth": "2px",
								"borderStyle": "solid",
								"borderColor": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#570df8",
											"success": "#00a96e",
											"warning": "#ffbe00",
											"danger": "#ff5861",
											"info": "#00b6ff",
											"neutral": "#2a323c"
										},
										"default": "#570df8"
									}
								},
								"boxShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.05)"
							}
						}
					}
				]
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "slider-progress",
		"variant": "slider",
		"tranche": 1
	}
}
