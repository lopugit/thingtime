{
	"slug": "daisyui-support-help-ticket",
	"name": "Support Ticket Row",
	"library": "daisyui",
	"category": "support",
	"description": "Support ticket queue row in the daisyUI style — mono id chip, subject with requester caption, priority and status chips, and the assignee avatar on library-native corners.",
	"tags": [
		"support",
		"ticket",
		"queue",
		"row",
		"status"
	],
	"args": [
		{
			"name": "id",
			"type": "string",
			"default": "4821",
			"label": "Ticket #",
			"maxLength": 8
		},
		{
			"name": "subject",
			"type": "string",
			"default": "Cannot connect my calendar",
			"label": "Subject",
			"maxLength": 60
		},
		{
			"name": "requester",
			"type": "string",
			"default": "Dana P.",
			"label": "Requester",
			"maxLength": 24
		},
		{
			"name": "updated",
			"type": "string",
			"default": "2h ago",
			"label": "Updated",
			"maxLength": 16
		},
		{
			"name": "priority",
			"type": "enum",
			"values": [
				"low",
				"medium",
				"high",
				"urgent"
			],
			"default": "high",
			"label": "Priority"
		},
		{
			"name": "status",
			"type": "enum",
			"values": [
				"open",
				"waiting"
			],
			"default": "open",
			"label": "Status"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"ttMerge": [
					{
						"background": "#ffffff",
						"borderWidth": "1px",
						"borderStyle": "solid",
						"borderColor": "#e5e6e6",
						"borderRadius": "16px",
						"boxShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
						"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
						"color": "#1f2937",
						"boxSizing": "border-box"
					},
					{
						"display": "flex",
						"alignItems": "center",
						"gap": "12px",
						"width": "430px",
						"padding": "10px 14px",
						"borderRadius": "12px"
					}
				]
			}
		},
		"children": [
			{
				"tag": "span",
				"props": {
					"style": {
						"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
						"fontSize": "12px",
						"color": "#6b7280",
						"background": "#f2f2f2",
						"padding": "2px 6px",
						"borderRadius": "8px",
						"borderWidth": "1px",
						"borderStyle": "solid",
						"borderColor": "#f2f2f2",
						"flexShrink": 0
					}
				},
				"children": [
					"#{id}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"gap": "2px",
						"flex": "1 1 auto",
						"minWidth": 0
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "14px",
								"fontWeight": 600,
								"color": "#1f2937",
								"whiteSpace": "nowrap",
								"overflow": "hidden",
								"textOverflow": "ellipsis"
							}
						},
						"children": [
							"{subject}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "12px",
								"color": "#6b7280"
							}
						},
						"children": [
							"{requester} · Updated {updated}"
						]
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"ttMerge": [
							{
								"display": "inline-flex",
								"alignItems": "center",
								"gap": "6px",
								"padding": "2px 8px",
								"fontSize": "12px",
								"fontWeight": 600,
								"lineHeight": 1.4,
								"borderRadius": "999px",
								"textTransform": "capitalize",
								"whiteSpace": "nowrap",
								"flexShrink": 0
							},
							{
								"background": {
									"ttMap": {
										"arg": "priority",
										"values": {
											"low": "#f2f2f2",
											"medium": "#e0f2fe",
											"high": "#fef9c3",
											"urgent": "#ffe4e6"
										},
										"default": "#f2f2f2"
									}
								},
								"color": {
									"ttMap": {
										"arg": "priority",
										"values": {
											"low": "#2a323c",
											"medium": "#0369a1",
											"high": "#854d0e",
											"urgent": "#be123c"
										},
										"default": "#2a323c"
									}
								}
							},
							{}
						]
					}
				},
				"children": [
					"{priority}"
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"ttMerge": [
							{
								"display": "inline-flex",
								"alignItems": "center",
								"gap": "6px",
								"padding": "2px 8px",
								"fontSize": "12px",
								"fontWeight": 600,
								"lineHeight": 1.4,
								"borderRadius": "999px",
								"textTransform": "capitalize",
								"whiteSpace": "nowrap",
								"flexShrink": 0
							},
							{
								"ttIf": {
									"arg": "status",
									"equals": "open",
									"then": {
										"background": "#eee6ff",
										"color": "#4506cb"
									},
									"else": {
										"background": "#f2f2f2",
										"color": "#6b7280"
									}
								}
							}
						]
					}
				},
				"children": [
					"{status}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"width": "26px",
						"height": "26px",
						"borderRadius": "999px",
						"background": "#570df8",
						"color": "#ffffff",
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "center",
						"fontWeight": 600,
						"fontSize": "12px",
						"flexShrink": 0
					}
				},
				"children": [
					"AK"
				]
			}
		]
	},
	"version": 1,
	"familyKey": "support-help-ticket",
	"source": {
		"kind": "archetype",
		"archetype": "support-help",
		"variant": "ticket",
		"tranche": 2
	}
}
