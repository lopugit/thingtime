{
	"slug": "daisyui-search-command-search-bar",
	"name": "Search Bar",
	"library": "daisyui",
	"category": "forms",
	"description": "Search bar in the daisyUI style — bordered input with a leading magnifier glyph and editable placeholder beside a solid tone search button.",
	"tags": [
		"search",
		"input",
		"form",
		"bar"
	],
	"args": [
		{
			"name": "placeholder",
			"type": "string",
			"default": "Search anything…",
			"label": "Placeholder",
			"maxLength": 40
		},
		{
			"name": "buttonLabel",
			"type": "string",
			"default": "Search",
			"label": "Button label",
			"maxLength": 20
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"alignItems": "center",
				"gap": "8px",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "8px",
						"height": "48px",
						"padding": "0 12px",
						"boxSizing": "border-box",
						"background": "#ffffff",
						"borderWidth": "1px",
						"borderStyle": "solid",
						"borderColor": "#e5e6e6",
						"borderRadius": "12px",
						"boxShadow": "none"
					}
				},
				"children": [
					{
						"tag": "svg",
						"props": {
							"width": 16,
							"height": 16,
							"viewBox": "0 0 24 24",
							"fill": "none",
							"stroke": "#6b7280",
							"strokeWidth": 2,
							"strokeLinecap": "round",
							"strokeLinejoin": "round",
							"xmlns": "http://www.w3.org/2000/svg"
						},
						"children": [
							{
								"tag": "circle",
								"props": {
									"cx": 11,
									"cy": 11,
									"r": 7
								}
							},
							{
								"tag": "line",
								"props": {
									"x1": 21,
									"y1": 21,
									"x2": 16.65,
									"y2": 16.65
								}
							}
						]
					},
					{
						"tag": "input",
						"props": {
							"type": "text",
							"placeholder": "{placeholder}",
							"style": {
								"border": "none",
								"outline": "none",
								"background": "transparent",
								"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
								"fontSize": "14px",
								"color": "#1f2937",
								"width": "140px"
							}
						}
					}
				]
			},
			{
				"tag": "button",
				"props": {
					"type": "button",
					"style": {
						"ttMerge": [
							{
								"display": "inline-flex",
								"alignItems": "center",
								"justifyContent": "center",
								"height": "48px",
								"padding": "0 16px",
								"border": "none",
								"borderRadius": "12px",
								"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
								"fontSize": "14px",
								"fontWeight": 600,
								"cursor": "pointer",
								"boxShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.05)"
							},
							{
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#570df8",
											"success": "#00a96e",
											"warning": "#ffbe00",
											"danger": "#ff5861",
											"info": "#00b6ff",
											"neutral": "#2a323c"
										},
										"default": "#570df8"
									}
								},
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#ffffff",
											"success": "#ffffff",
											"warning": "#382800",
											"danger": "#ffffff",
											"info": "#ffffff",
											"neutral": "#ffffff"
										},
										"default": "#ffffff"
									}
								}
							}
						]
					}
				},
				"children": [
					"{buttonLabel}"
				]
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "search-command",
		"variant": "search-bar",
		"tranche": 2
	}
}
