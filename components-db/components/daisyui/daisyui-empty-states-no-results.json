{
	"slug": "daisyui-empty-states-no-results",
	"name": "No Results",
	"library": "daisyui",
	"category": "feedback",
	"description": "No-search-results panel in the daisyUI style — magnifier icon, the searched query echoed in the title, a helper hint, and an optional clear-search button.",
	"tags": [
		"empty-state",
		"search",
		"no-results",
		"feedback"
	],
	"args": [
		{
			"name": "query",
			"type": "string",
			"default": "quarterly report",
			"label": "Search query",
			"maxLength": 40
		},
		{
			"name": "hint",
			"type": "text",
			"default": "Check the spelling or try a broader search term.",
			"label": "Hint"
		},
		{
			"name": "clearLabel",
			"type": "string",
			"default": "Clear search",
			"label": "Clear label",
			"maxLength": 24
		},
		{
			"name": "showClear",
			"type": "boolean",
			"default": true,
			"label": "Show clear button"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"alignItems": "center",
				"justifyContent": "center",
				"textAlign": "center",
				"gap": "6px",
				"width": "340px",
				"padding": "36px 24px",
				"background": "#ffffff",
				"borderRadius": "16px",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"color": "#1f2937",
				"border": "1px solid #e5e6e6",
				"boxShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.05)"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"width": "46px",
						"height": "46px",
						"borderRadius": "999px",
						"background": "#f2f2f2",
						"color": "#6b7280",
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "center",
						"marginBottom": "4px"
					}
				},
				"children": [
					{
						"tag": "svg",
						"props": {
							"width": 20,
							"height": 20,
							"viewBox": "0 0 24 24",
							"fill": "none",
							"stroke": "currentColor",
							"strokeWidth": 2,
							"strokeLinecap": "round",
							"strokeLinejoin": "round",
							"xmlns": "http://www.w3.org/2000/svg"
						},
						"children": [
							{
								"tag": "circle",
								"props": {
									"cx": 11,
									"cy": 11,
									"r": 7
								}
							},
							{
								"tag": "line",
								"props": {
									"x1": 21,
									"y1": 21,
									"x2": 16.65,
									"y2": 16.65
								}
							}
						]
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontWeight": 700,
						"fontSize": "18px"
					}
				},
				"children": [
					"No results for “{query}”"
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "14px",
						"color": "#6b7280",
						"lineHeight": 1.5,
						"maxWidth": "250px"
					}
				},
				"children": [
					"{hint}"
				]
			},
			{
				"ttIf": {
					"arg": "showClear",
					"then": {
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"display": "inline-flex",
								"alignItems": "center",
								"justifyContent": "center",
								"height": "32px",
								"padding": "0 14px",
								"background": "transparent",
								"color": "#1f2937",
								"border": "1px solid #e5e6e6",
								"borderRadius": "8px",
								"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
								"fontSize": "14px",
								"fontWeight": 600,
								"cursor": "pointer",
								"marginTop": "10px"
							}
						},
						"children": [
							"{clearLabel}"
						]
					}
				}
			}
		]
	},
	"previewBg": "#f2f2f2",
	"version": 1,
	"familyKey": "empty-states-no-results",
	"source": {
		"kind": "archetype",
		"archetype": "empty-states",
		"variant": "no-results",
		"tranche": 1
	}
}
