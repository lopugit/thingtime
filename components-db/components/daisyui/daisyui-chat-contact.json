{
	"slug": "daisyui-chat-contact",
	"name": "Chat List Row",
	"library": "daisyui",
	"category": "messaging",
	"description": "Chat list contact row in the daisyUI style — initials avatar with a presence dot, name and one-line preview, timestamp, and an unread pill that hides at zero.",
	"tags": [
		"chat",
		"contact",
		"list",
		"presence",
		"unread"
	],
	"args": [
		{
			"name": "name",
			"type": "string",
			"default": "Sam Rivera",
			"label": "Name",
			"maxLength": 40
		},
		{
			"name": "initials",
			"type": "string",
			"default": "SR",
			"label": "Initials",
			"maxLength": 3
		},
		{
			"name": "preview",
			"type": "string",
			"default": "Sounds good — see you there!",
			"label": "Last message",
			"maxLength": 80
		},
		{
			"name": "time",
			"type": "string",
			"default": "12:47",
			"label": "Time",
			"maxLength": 12
		},
		{
			"name": "presence",
			"type": "enum",
			"values": [
				"online",
				"away",
				"busy"
			],
			"default": "online",
			"label": "Presence"
		},
		{
			"name": "count",
			"type": "string",
			"default": "3",
			"label": "Unread count",
			"maxLength": 4
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"alignItems": "center",
				"gap": "10px",
				"padding": "10px 12px",
				"width": "300px",
				"boxSizing": "border-box",
				"background": "#ffffff",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "#f2f2f2",
				"borderRadius": "12px",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"boxShadow": "none"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"position": "relative",
						"flexShrink": 0
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"width": "40px",
								"height": "40px",
								"borderRadius": "999px",
								"background": "#f2f2f2",
								"color": "#2a323c",
								"display": "flex",
								"alignItems": "center",
								"justifyContent": "center",
								"fontWeight": 600,
								"fontSize": "14px",
								"flexShrink": 0
							}
						},
						"children": [
							"{initials}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"position": "absolute",
								"right": "0",
								"bottom": "0",
								"width": "10px",
								"height": "10px",
								"borderRadius": "999px",
								"background": {
									"ttMap": {
										"arg": "presence",
										"values": {
											"online": "#00a96e",
											"away": "#ffbe00",
											"busy": "#ff5861"
										},
										"default": "#00a96e"
									}
								},
								"boxShadow": "0 0 0 2px #ffffff"
							}
						}
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"flex": 1,
						"minWidth": 0,
						"gap": "2px"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"justifyContent": "space-between",
								"gap": "8px"
							}
						},
						"children": [
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "14px",
										"fontWeight": 700,
										"color": "#1f2937",
										"whiteSpace": "nowrap",
										"overflow": "hidden",
										"textOverflow": "ellipsis"
									}
								},
								"children": [
									"{name}"
								]
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "12px",
										"color": "#6b7280",
										"flexShrink": 0
									}
								},
								"children": [
									"{time}"
								]
							}
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"justifyContent": "space-between",
								"gap": "8px"
							}
						},
						"children": [
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "14px",
										"color": "#6b7280",
										"whiteSpace": "nowrap",
										"overflow": "hidden",
										"textOverflow": "ellipsis",
										"minWidth": 0
									}
								},
								"children": [
									"{preview}"
								]
							},
							{
								"ttIf": {
									"arg": "count",
									"then": {
										"tag": "span",
										"props": {
											"style": {
												"display": "inline-flex",
												"alignItems": "center",
												"justifyContent": "center",
												"minWidth": "18px",
												"height": "18px",
												"padding": "0 5px",
												"boxSizing": "border-box",
												"borderRadius": "999px",
												"background": "#570df8",
												"color": "#ffffff",
												"fontSize": "12px",
												"fontWeight": 700,
												"flexShrink": 0
											}
										},
										"children": [
											"{count}"
										]
									}
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "chat",
		"variant": "contact",
		"tranche": 2
	}
}
