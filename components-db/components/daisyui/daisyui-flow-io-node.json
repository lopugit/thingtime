{
	"slug": "daisyui-flow-io-node",
	"name": "Input/Output Node",
	"library": "daisyui",
	"category": "flow",
	"description": "Input-to-output graph node in the daisyUI style — side connection handles plus mono type chips for the inbound and outbound ports.",
	"tags": [
		"flow",
		"node",
		"io",
		"ports",
		"types"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Map fields",
			"label": "Label",
			"maxLength": 30
		},
		{
			"name": "inType",
			"type": "string",
			"default": "string",
			"label": "Input type",
			"maxLength": 16
		},
		{
			"name": "outType",
			"type": "string",
			"default": "number",
			"label": "Output type",
			"maxLength": 16
		},
		{
			"name": "selected",
			"type": "boolean",
			"default": false,
			"label": "Selected"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"padding": "4px 10px",
				"display": "inline-block"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"ttMerge": [
							{
								"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
								"background": "#ffffff",
								"borderWidth": "1px",
								"borderStyle": "solid",
								"borderColor": "#e5e6e6",
								"borderRadius": "12px",
								"boxShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
								"boxSizing": "border-box",
								"position": "relative",
								"width": "208px",
								"padding": "10px 14px"
							},
							{
								"ttIf": {
									"arg": "selected",
									"then": {
										"borderColor": "#570df8",
										"boxShadow": "0 0 0 1px #570df8"
									},
									"else": {}
								}
							}
						]
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"position": "absolute",
								"width": "10px",
								"height": "10px",
								"borderRadius": "999px",
								"background": "#570df8",
								"borderWidth": "2px",
								"borderStyle": "solid",
								"borderColor": "#ffffff",
								"boxSizing": "border-box",
								"left": "-6px",
								"top": "50%",
								"marginTop": "-5px"
							}
						}
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"position": "absolute",
								"width": "10px",
								"height": "10px",
								"borderRadius": "999px",
								"background": "#570df8",
								"borderWidth": "2px",
								"borderStyle": "solid",
								"borderColor": "#ffffff",
								"boxSizing": "border-box",
								"right": "-6px",
								"top": "50%",
								"marginTop": "-5px"
							}
						}
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"flexDirection": "column",
								"gap": "8px"
							}
						},
						"children": [
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "14px",
										"fontWeight": 700,
										"color": "#1f2937"
									}
								},
								"children": [
									"{label}"
								]
							},
							{
								"tag": "div",
								"props": {
									"style": {
										"display": "flex",
										"alignItems": "center",
										"gap": "6px",
										"justifyContent": "space-between"
									}
								},
								"children": [
									{
										"tag": "span",
										"props": {
											"style": {
												"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
												"fontSize": "12px",
												"padding": "2px 8px",
												"borderRadius": "999px",
												"background": "#e0f2fe",
												"color": "#0369a1",
												"borderWidth": "1px",
												"borderStyle": "solid",
												"borderColor": "#7dd3fc",
												"whiteSpace": "nowrap"
											}
										},
										"children": [
											"in: {inType}"
										]
									},
									{
										"tag": "span",
										"props": {
											"style": {
												"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
												"fontSize": "12px",
												"padding": "2px 8px",
												"borderRadius": "999px",
												"background": "#dcfce7",
												"color": "#00753d",
												"borderWidth": "1px",
												"borderStyle": "solid",
												"borderColor": "#86efac",
												"whiteSpace": "nowrap"
											}
										},
										"children": [
											"out: {outType}"
										]
									}
								]
							}
						]
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "flow-io-node",
	"source": {
		"kind": "archetype",
		"archetype": "flow",
		"variant": "io-node",
		"tranche": 1
	}
}
