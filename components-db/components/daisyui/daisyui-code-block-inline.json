{
	"slug": "daisyui-code-block-inline",
	"name": "Inline Code",
	"library": "daisyui",
	"category": "data-display",
	"description": "Sentence with an inline code chip in the daisyUI style — monospace snippet on the library's surface wash with its tightest corner radius.",
	"tags": [
		"code",
		"inline",
		"snippet",
		"monospace"
	],
	"args": [
		{
			"name": "before",
			"type": "string",
			"default": "Run",
			"label": "Text before",
			"maxLength": 60
		},
		{
			"name": "code",
			"type": "string",
			"default": "npm run dev",
			"label": "Code",
			"maxLength": 40
		},
		{
			"name": "after",
			"type": "string",
			"default": "to start the local server.",
			"label": "Text after",
			"maxLength": 60
		},
		{
			"name": "bordered",
			"type": "boolean",
			"default": true,
			"label": "Bordered chip"
		}
	],
	"render": {
		"tag": "span",
		"props": {
			"style": {
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"fontSize": "14px",
				"color": "#1f2937",
				"lineHeight": 1.7
			}
		},
		"children": [
			"{before} ",
			{
				"tag": "code",
				"props": {
					"style": {
						"ttMerge": [
							{
								"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
								"fontSize": "14px",
								"color": "#1f2937",
								"background": "#f2f2f2",
								"padding": "2px 6px",
								"borderRadius": "8px"
							},
							{
								"ttIf": {
									"arg": "bordered",
									"then": {
										"borderWidth": "1px",
										"borderStyle": "solid",
										"borderColor": "#e5e6e6"
									},
									"else": {}
								}
							}
						]
					}
				},
				"children": [
					"{code}"
				]
			},
			" {after}"
		]
	},
	"version": 1,
	"familyKey": "code-block-inline",
	"source": {
		"kind": "archetype",
		"archetype": "code-block",
		"variant": "inline",
		"tranche": 2
	}
}
