{
	"slug": "daisyui-data-viz-line",
	"name": "Line Chart",
	"library": "daisyui",
	"category": "data-display",
	"description": "Mini line chart in the daisyUI style — a tone-colored svg trend polyline with an optional translucent area fill, end-point dot, and min/max captions under the plot.",
	"tags": [
		"chart",
		"line",
		"trend",
		"area"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Active users",
			"label": "Title",
			"maxLength": 32
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "area",
			"type": "boolean",
			"default": true,
			"label": "Area fill"
		},
		{
			"name": "min",
			"type": "string",
			"default": "Low 14",
			"label": "Min caption",
			"maxLength": 16
		},
		{
			"name": "max",
			"type": "string",
			"default": "High 86",
			"label": "Max caption",
			"maxLength": 16
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"width": "232px",
				"boxSizing": "border-box",
				"padding": "14px 16px",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"background": "#ffffff",
				"border": "1px solid #e5e6e6",
				"borderRadius": "12px",
				"boxShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.05)"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"marginBottom": "10px"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "14px",
								"fontWeight": 700,
								"color": "#1f2937"
							}
						},
						"children": [
							"{title}"
						]
					}
				]
			},
			{
				"tag": "svg",
				"props": {
					"width": 200,
					"height": 80,
					"viewBox": "0 0 160 64",
					"xmlns": "http://www.w3.org/2000/svg"
				},
				"children": [
					{
						"ttIf": {
							"arg": "area",
							"then": {
								"tag": "polygon",
								"props": {
									"points": "4,48 28,36 52,42 76,26 100,32 124,14 152,20 152,60 4,60",
									"fill": {
										"ttMap": {
											"arg": "tone",
											"values": {
												"primary": "rgba(87, 13, 248, 0.18)",
												"success": "rgba(0, 169, 110, 0.18)",
												"warning": "rgba(255, 190, 0, 0.18)",
												"danger": "rgba(255, 88, 97, 0.18)",
												"info": "rgba(0, 182, 255, 0.18)",
												"neutral": "rgba(42, 50, 60, 0.18)"
											},
											"default": "rgba(87, 13, 248, 0.18)"
										}
									}
								}
							}
						}
					},
					{
						"tag": "line",
						"props": {
							"x1": 4,
							"y1": 60,
							"x2": 156,
							"y2": 60,
							"stroke": "#f2f2f2",
							"strokeWidth": 1
						}
					},
					{
						"tag": "polyline",
						"props": {
							"points": "4,48 28,36 52,42 76,26 100,32 124,14 152,20",
							"fill": "none",
							"stroke": {
								"ttMap": {
									"arg": "tone",
									"values": {
										"primary": "#570df8",
										"success": "#00a96e",
										"warning": "#ffbe00",
										"danger": "#ff5861",
										"info": "#00b6ff",
										"neutral": "#2a323c"
									},
									"default": "#570df8"
								}
							},
							"strokeWidth": 2.5,
							"strokeLinecap": "round",
							"strokeLinejoin": "round"
						}
					},
					{
						"tag": "circle",
						"props": {
							"cx": 152,
							"cy": 20,
							"r": 3.5,
							"fill": {
								"ttMap": {
									"arg": "tone",
									"values": {
										"primary": "#570df8",
										"success": "#00a96e",
										"warning": "#ffbe00",
										"danger": "#ff5861",
										"info": "#00b6ff",
										"neutral": "#2a323c"
									},
									"default": "#570df8"
								}
							},
							"stroke": "#ffffff",
							"strokeWidth": 1.5
						}
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"justifyContent": "space-between",
						"marginTop": "4px",
						"fontSize": "12px",
						"color": "#6b7280"
					}
				},
				"children": [
					{
						"tag": "span",
						"children": [
							"{min}"
						]
					},
					{
						"tag": "span",
						"children": [
							"{max}"
						]
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "data-viz-line",
	"source": {
		"kind": "archetype",
		"archetype": "data-viz",
		"variant": "line",
		"tranche": 2
	}
}
