{
	"slug": "daisyui-onboarding-progress",
	"name": "Onboarding Progress Banner",
	"library": "daisyui",
	"category": "onboarding",
	"description": "Slim finish-setup banner in the daisyUI style — label, inline tone progress bar with a mono percent readout, a resume button and a quiet dismiss cross.",
	"tags": [
		"onboarding",
		"progress",
		"banner",
		"resume"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Finish setting up",
			"label": "Label",
			"maxLength": 32
		},
		{
			"name": "percent",
			"type": "number",
			"default": 60,
			"label": "Percent",
			"min": 0,
			"max": 100
		},
		{
			"name": "resumeLabel",
			"type": "string",
			"default": "Resume",
			"label": "Button label",
			"maxLength": 20
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"alignItems": "center",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"background": "#ffffff",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "#e5e6e6",
				"borderRadius": "12px",
				"boxShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
				"boxSizing": "border-box",
				"width": "360px",
				"gap": "10px",
				"padding": "10px 12px"
			}
		},
		"children": [
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "14px",
						"fontWeight": 600,
						"color": "#1f2937",
						"whiteSpace": "nowrap",
						"flexShrink": 0
					}
				},
				"children": [
					"{label}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"flex": 1,
						"minWidth": "40px",
						"height": "6px",
						"borderRadius": "999px",
						"background": "#f2f2f2",
						"overflow": "hidden"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"width": "{percent}%",
								"height": "100%",
								"borderRadius": "999px",
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#570df8",
											"success": "#00a96e",
											"warning": "#ffbe00",
											"danger": "#ff5861",
											"info": "#00b6ff",
											"neutral": "#2a323c"
										},
										"default": "#570df8"
									}
								}
							}
						}
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
						"fontSize": "12px",
						"color": "#6b7280",
						"flexShrink": 0
					}
				},
				"children": [
					"{percent}%"
				]
			},
			{
				"tag": "button",
				"props": {
					"type": "button",
					"style": {
						"display": "inline-flex",
						"alignItems": "center",
						"justifyContent": "center",
						"gap": "6px",
						"border": "none",
						"borderRadius": "12px",
						"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
						"fontWeight": 600,
						"cursor": "pointer",
						"height": "32px",
						"padding": "0 10px",
						"fontSize": "12px",
						"background": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#570df8",
									"success": "#00a96e",
									"warning": "#ffbe00",
									"danger": "#ff5861",
									"info": "#00b6ff",
									"neutral": "#2a323c"
								},
								"default": "#570df8"
							}
						},
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#ffffff",
									"success": "#ffffff",
									"warning": "#382800",
									"danger": "#ffffff",
									"info": "#ffffff",
									"neutral": "#ffffff"
								},
								"default": "#ffffff"
							}
						},
						"flexShrink": 0
					}
				},
				"children": [
					"{resumeLabel}"
				]
			},
			{
				"tag": "button",
				"props": {
					"type": "button",
					"style": {
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "center",
						"width": "22px",
						"height": "22px",
						"padding": 0,
						"border": "none",
						"borderRadius": "8px",
						"background": "transparent",
						"color": "#6b7280",
						"cursor": "pointer",
						"flexShrink": 0
					}
				},
				"children": [
					{
						"tag": "svg",
						"props": {
							"width": 14,
							"height": 14,
							"viewBox": "0 0 24 24",
							"fill": "none",
							"stroke": "currentColor",
							"strokeWidth": 2,
							"strokeLinecap": "round",
							"strokeLinejoin": "round",
							"xmlns": "http://www.w3.org/2000/svg"
						},
						"children": [
							{
								"tag": "line",
								"props": {
									"x1": 18,
									"y1": 6,
									"x2": 6,
									"y2": 18
								}
							},
							{
								"tag": "line",
								"props": {
									"x1": 6,
									"y1": 6,
									"x2": 18,
									"y2": 18
								}
							}
						]
					}
				]
			}
		]
	},
	"previewBg": "#f2f2f2",
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "onboarding",
		"variant": "progress",
		"tranche": 2
	}
}
