{
	"slug": "daisyui-stat-metric-trend",
	"name": "Trend Stat",
	"library": "daisyui",
	"category": "data-display",
	"description": "Trend stat card in the daisyUI style — large value with an up or down arrow whose glyph and color flip on the direction enum (green rise, red fall).",
	"tags": [
		"stat",
		"trend",
		"delta",
		"arrow"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Active users",
			"label": "Label",
			"maxLength": 40
		},
		{
			"name": "value",
			"type": "string",
			"default": "12,480",
			"label": "Value",
			"maxLength": 20
		},
		{
			"name": "change",
			"type": "string",
			"default": "8.2%",
			"label": "Change",
			"maxLength": 12
		},
		{
			"name": "direction",
			"type": "enum",
			"values": [
				"up",
				"down"
			],
			"default": "up",
			"label": "Direction"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "inline-flex",
				"flexDirection": "column",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"background": "#ffffff",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "#e5e6e6",
				"borderRadius": "16px",
				"boxShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
				"boxSizing": "border-box",
				"padding": "16px 20px",
				"gap": "8px",
				"minWidth": "200px"
			}
		},
		"children": [
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "12px",
						"fontWeight": 400,
						"color": "#6b7280"
					}
				},
				"children": [
					"{label}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "10px"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "24px",
								"fontWeight": 700,
								"color": "#1f2937",
								"lineHeight": 1.15,
								"fontVariantNumeric": "tabular-nums"
							}
						},
						"children": [
							"{value}"
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"gap": "4px"
							}
						},
						"children": [
							{
								"ttIf": {
									"arg": "direction",
									"equals": "up",
									"then": {
										"tag": "svg",
										"props": {
											"width": 14,
											"height": 14,
											"viewBox": "0 0 24 24",
											"fill": "none",
											"stroke": "#00a96e",
											"strokeWidth": 2,
											"strokeLinecap": "round",
											"strokeLinejoin": "round",
											"xmlns": "http://www.w3.org/2000/svg"
										},
										"children": [
											{
												"tag": "line",
												"props": {
													"x1": 12,
													"y1": 19,
													"x2": 12,
													"y2": 5
												}
											},
											{
												"tag": "polyline",
												"props": {
													"points": "5 12 12 5 19 12"
												}
											}
										]
									},
									"else": {
										"tag": "svg",
										"props": {
											"width": 14,
											"height": 14,
											"viewBox": "0 0 24 24",
											"fill": "none",
											"stroke": "#ff5861",
											"strokeWidth": 2,
											"strokeLinecap": "round",
											"strokeLinejoin": "round",
											"xmlns": "http://www.w3.org/2000/svg"
										},
										"children": [
											{
												"tag": "line",
												"props": {
													"x1": 12,
													"y1": 5,
													"x2": 12,
													"y2": 19
												}
											},
											{
												"tag": "polyline",
												"props": {
													"points": "19 12 12 19 5 12"
												}
											}
										]
									}
								}
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "14px",
										"fontWeight": 600,
										"color": {
											"ttIf": {
												"arg": "direction",
												"equals": "up",
												"then": "#00753d",
												"else": "#be123c"
											}
										}
									}
								},
								"children": [
									"{change}"
								]
							}
						]
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "stat-metric-trend",
	"source": {
		"kind": "archetype",
		"archetype": "stat-metric",
		"variant": "trend",
		"tranche": 1
	}
}
