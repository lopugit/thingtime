{
	"slug": "daisyui-tooltip-popover-hovercard",
	"name": "Hovercard",
	"library": "daisyui",
	"category": "overlays",
	"description": "Profile hovercard in the daisyUI style — dotted-underline handle trigger above a card with an initials avatar, name, bio, follower stats, and a tone follow button.",
	"tags": [
		"hovercard",
		"profile",
		"overlay",
		"card"
	],
	"args": [
		{
			"name": "name",
			"type": "string",
			"default": "Ada Lovelace",
			"label": "Name",
			"maxLength": 40
		},
		{
			"name": "handle",
			"type": "string",
			"default": "ada",
			"label": "Handle",
			"maxLength": 24
		},
		{
			"name": "initials",
			"type": "string",
			"default": "AL",
			"label": "Initials",
			"maxLength": 2
		},
		{
			"name": "bio",
			"type": "text",
			"default": "Writing about analytical engines, poetry, and the software in between.",
			"label": "Bio"
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
