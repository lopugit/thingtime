{
	"slug": "daisyui-marketing-hero",
	"name": "Hero Section",
	"library": "daisyui",
	"category": "marketing",
	"description": "Centered landing hero in the daisyUI style — display heading, supporting subtext, and a solid + outline button pair on daisyUI tone, radius, and type tokens.",
	"tags": [
		"marketing",
		"hero",
		"landing",
		"section"
	],
	"args": [
		{
			"name": "heading",
			"type": "string",
			"default": "Ship your ideas faster",
			"label": "Heading",
			"maxLength": 60
		},
		{
			"name": "subtext",
			"type": "text",
			"default": "Everything you need to design, build, and launch — in one calm workspace.",
			"label": "Subtext",
			"maxLength": 160
		},
		{
			"name": "primaryLabel",
			"type": "string",
			"default": "Get started",
			"label": "Primary button",
			"maxLength": 30
		},
		{
			"name": "secondaryLabel",
			"type": "string",
			"default": "View demo",
			"label": "Secondary button",
			"maxLength": 30
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "section",
		"props": {
			"style": {
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"background": "#ffffff",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "#f2f2f2",
				"borderRadius": "16px",
				"boxShadow": "0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1)",
				"padding": "44px 36px",
				"display": "flex",
				"flexDirection": "column",
				"alignItems": "center",
				"textAlign": "center",
				"gap": "12px",
				"maxWidth": "560px",
				"boxSizing": "border-box"
			}
		},
		"children": [
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "30px",
						"fontWeight": 700,
						"color": "#1f2937",
						"lineHeight": 1.15,
						"letterSpacing": "-0.02em"
					}
				},
				"children": [
					"{heading}"
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "18px",
						"color": "#6b7280",
						"lineHeight": 1.55,
						"maxWidth": "420px"
					}
				},
				"children": [
					"{subtext}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "10px",
						"marginTop": "8px",
						"justifyContent": "center",
						"flexWrap": "wrap"
					}
				},
				"children": [
					{
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"display": "inline-flex",
								"alignItems": "center",
								"justifyContent": "center",
								"gap": "8px",
								"border": "none",
								"height": "48px",
								"padding": "0 18px",
								"borderRadius": "12px",
								"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
								"fontWeight": 600,
								"fontSize": "14px",
								"cursor": "pointer",
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#570df8",
											"success": "#00a96e",
											"warning": "#ffbe00",
											"danger": "#ff5861",
											"info": "#00b6ff",
											"neutral": "#2a323c"
										},
										"default": "#570df8"
									}
								},
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#ffffff",
											"success": "#ffffff",
											"warning": "#382800",
											"danger": "#ffffff",
											"info": "#ffffff",
											"neutral": "#ffffff"
										},
										"default": "#ffffff"
									}
								},
								"boxShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.05)"
							}
						},
						"children": [
							"{primaryLabel}"
						]
					},
					{
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"display": "inline-flex",
								"alignItems": "center",
								"justifyContent": "center",
								"gap": "8px",
								"border": "none",
								"height": "48px",
								"padding": "0 18px",
								"borderRadius": "12px",
								"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
								"fontWeight": 600,
								"fontSize": "14px",
								"cursor": "pointer",
								"background": "transparent",
								"borderWidth": "1px",
								"borderStyle": "solid",
								"borderColor": "#e5e6e6",
								"color": "#1f2937"
							}
						},
						"children": [
							"{secondaryLabel}"
						]
					}
				]
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "marketing",
		"variant": "hero",
		"tranche": 1
	}
}
