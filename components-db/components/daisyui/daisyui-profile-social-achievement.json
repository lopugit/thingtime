{
	"slug": "daisyui-profile-social-achievement",
	"name": "Achievement Tile",
	"library": "daisyui",
	"category": "social",
	"description": "Achievement badge tile in the daisyUI style — a star or zap emblem in a tone-soft circle with a tone border, title, and a progress bar with percent and 'x of y' captions.",
	"tags": [
		"profile",
		"achievement",
		"progress",
		"gamification",
		"social"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Streak Master",
			"label": "Title",
			"maxLength": 32
		},
		{
			"name": "icon",
			"type": "enum",
			"values": [
				"star",
				"zap"
			],
			"default": "star",
			"label": "Icon"
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "percent",
			"type": "number",
			"default": 60,
			"label": "Progress %",
			"min": 0,
			"max": 100
		},
		{
			"name": "done",
			"type": "number",
			"default": 3,
			"label": "Done",
			"min": 0
		},
		{
			"name": "total",
			"type": "number",
			"default": 5,
			"label": "Total",
			"min": 1
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"background": "#ffffff",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "#e5e6e6",
				"borderRadius": "16px",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"boxShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
				"width": "216px",
				"display": "flex",
				"flexDirection": "column",
				"alignItems": "center",
				"textAlign": "center",
				"padding": "18px 16px",
				"boxSizing": "border-box"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"width": "48px",
						"height": "48px",
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "center",
						"borderRadius": "999px",
						"background": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#eee6ff",
									"success": "#dcfce7",
									"warning": "#fef9c3",
									"danger": "#ffe4e6",
									"info": "#e0f2fe",
									"neutral": "#f2f2f2"
								},
								"default": "#eee6ff"
							}
						},
						"borderWidth": "1px",
						"borderStyle": "solid",
						"borderColor": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#d6c4fd",
									"success": "#86efac",
									"warning": "#fde047",
									"danger": "#fda4af",
									"info": "#7dd3fc",
									"neutral": "#d1d5db"
								},
								"default": "#d6c4fd"
							}
						},
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#4506cb",
									"success": "#00753d",
									"warning": "#854d0e",
									"danger": "#be123c",
									"info": "#0369a1",
									"neutral": "#2a323c"
								},
								"default": "#4506cb"
							}
						}
					}
				},
				"children": [
					{
						"ttIf": {
							"arg": "icon",
							"equals": "zap",
							"then": {
								"tag": "svg",
								"props": {
									"width": 22,
									"height": 22,
									"viewBox": "0 0 24 24",
									"fill": "none",
									"stroke": "currentColor",
									"strokeWidth": 2,
									"strokeLinecap": "round",
									"strokeLinejoin": "round",
									"xmlns": "http://www.w3.org/2000/svg"
								},
								"children": [
									{
										"tag": "polygon",
										"props": {
											"points": "13 2 3 14 12 14 11 22 21 10 12 10 13 2"
										}
									}
								]
							},
							"else": {
								"tag": "svg",
								"props": {
									"width": 22,
									"height": 22,
									"viewBox": "0 0 24 24",
									"fill": "none",
									"stroke": "currentColor",
									"strokeWidth": 2,
									"strokeLinejoin": "round",
									"xmlns": "http://www.w3.org/2000/svg"
								},
								"children": [
									{
										"tag": "polygon",
										"props": {
											"points": "12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26"
										}
									}
								]
							}
						}
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"marginTop": "10px",
						"fontSize": "14px",
						"fontWeight": 700,
						"color": "#1f2937"
					}
				},
				"children": [
					"{title}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"marginTop": "12px",
						"width": "100%",
						"height": "6px",
						"borderRadius": "999px",
						"background": "#f2f2f2",
						"overflow": "hidden"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"width": "{percent}%",
								"height": "100%",
								"borderRadius": "999px",
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#570df8",
											"success": "#00a96e",
											"warning": "#ffbe00",
											"danger": "#ff5861",
											"info": "#00b6ff",
											"neutral": "#2a323c"
										},
										"default": "#570df8"
									}
								}
							}
						}
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"marginTop": "8px",
						"width": "100%",
						"justifyContent": "space-between"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "12px",
								"color": "#6b7280"
							}
						},
						"children": [
							"{done} of {total}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "12px",
								"fontWeight": 600,
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#4506cb",
											"success": "#00753d",
											"warning": "#854d0e",
											"danger": "#be123c",
											"info": "#0369a1",
											"neutral": "#2a323c"
										},
										"default": "#4506cb"
									}
								}
							}
						},
						"children": [
							"{percent}%"
						]
					}
				]
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "profile-social",
		"variant": "achievement",
		"tranche": 2
	}
}
