{
	"slug": "daisyui-button-soft",
	"name": "Soft Button",
	"library": "daisyui",
	"category": "buttons",
	"description": "Tinted button in the daisyUI style — soft tone wash background with the deeper tone for the label.",
	"tags": [
		"button",
		"action",
		"soft",
		"tinted"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Preview",
			"label": "Label",
			"maxLength": 40
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "size",
			"type": "enum",
			"values": [
				"sm",
				"md",
				"lg"
			],
			"default": "md",
			"label": "Size"
		},
		{
			"name": "disabled",
			"type": "boolean",
			"default": false,
			"label": "Disabled"
		}
	],
	"render": {
		"tag": "button",
		"props": {
			"type": "button",
			"style": {
				"ttMerge": [
					{
						"display": "inline-flex",
						"alignItems": "center",
						"justifyContent": "center",
						"gap": "8px",
						"border": "none",
						"borderRadius": "12px",
						"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
						"fontWeight": 600,
						"cursor": "pointer"
					},
					{
						"ttMap": {
							"arg": "size",
							"values": {
								"sm": {
									"height": "32px",
									"padding": "0 12px",
									"fontSize": "14px"
								},
								"md": {
									"height": "48px",
									"padding": "0 16px",
									"fontSize": "14px"
								},
								"lg": {
									"height": "56px",
									"padding": "0 20px",
									"fontSize": "18px"
								}
							},
							"default": {
								"height": "48px",
								"padding": "0 16px",
								"fontSize": "14px"
							}
						}
					},
					{
						"background": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#eee6ff",
									"success": "#dcfce7",
									"warning": "#fef9c3",
									"danger": "#ffe4e6",
									"info": "#e0f2fe",
									"neutral": "#f2f2f2"
								},
								"default": "#eee6ff"
							}
						},
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#4506cb",
									"success": "#00753d",
									"warning": "#854d0e",
									"danger": "#be123c",
									"info": "#0369a1",
									"neutral": "#2a323c"
								},
								"default": "#4506cb"
							}
						}
					},
					{
						"ttIf": {
							"arg": "disabled",
							"then": {
								"opacity": 0.5,
								"cursor": "not-allowed"
							},
							"else": {}
						}
					}
				]
			}
		},
		"children": [
			"{label}"
		]
	},
	"version": 1,
	"familyKey": "button-soft",
	"source": {
		"kind": "archetype",
		"archetype": "button",
		"variant": "soft",
		"tranche": 1
	}
}
