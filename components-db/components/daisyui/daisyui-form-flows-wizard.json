{
	"slug": "daisyui-form-flows-wizard",
	"name": "Wizard Form Shell",
	"library": "daisyui",
	"category": "forms",
	"description": "Multi-step form shell in the daisyUI style — back chevron, step counter and progress bar over the current step's fields, with Back/Continue footer.",
	"tags": [
		"form",
		"wizard",
		"steps",
		"progress"
	],
	"args": [
		{
			"name": "step",
			"type": "number",
			"default": 2,
			"label": "Step",
			"min": 1,
			"max": 4
		},
		{
			"name": "total",
			"type": "number",
			"default": 4,
			"label": "Total steps",
			"min": 1,
			"max": 4
		},
		{
			"name": "stepTitle",
			"type": "string",
			"default": "Contact details",
			"label": "Step title",
			"maxLength": 40
		},
		{
			"name": "draftSaved",
			"type": "boolean",
			"default": true,
			"label": "Draft saved"
		}
	],
