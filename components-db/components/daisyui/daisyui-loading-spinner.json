{
	"slug": "daisyui-loading-spinner",
	"name": "Spinner",
	"library": "daisyui",
	"category": "feedback",
	"description": "Circular spinner in the daisyUI style — a faint svg track ring with a tone-colored three-quarter arc, plus an optional caption.",
	"tags": [
		"loading",
		"spinner",
		"progress",
		"feedback"
	],
	"args": [
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "size",
			"type": "enum",
			"values": [
				"sm",
				"md",
				"lg"
			],
			"default": "md",
			"label": "Size"
		},
		{
			"name": "label",
			"type": "string",
			"default": "Loading…",
			"label": "Label",
			"maxLength": 40
		},
		{
			"name": "showLabel",
			"type": "boolean",
			"default": true,
			"label": "Show label"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"alignItems": "center",
				"gap": "10px",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
			}
		},
		"children": [
			{
				"tag": "svg",
				"props": {
					"width": {
						"ttMap": {
							"arg": "size",
							"values": {
								"sm": 16,
								"md": 24,
								"lg": 32
							},
							"default": 24
						}
					},
					"height": {
						"ttMap": {
							"arg": "size",
							"values": {
								"sm": 16,
								"md": 24,
								"lg": 32
							},
							"default": 24
						}
					},
					"viewBox": "0 0 24 24",
					"fill": "none",
					"xmlns": "http://www.w3.org/2000/svg"
				},
				"children": [
					{
						"tag": "circle",
						"props": {
							"cx": 12,
							"cy": 12,
							"r": 10,
							"stroke": "#f2f2f2",
							"strokeWidth": 3
						}
					},
					{
						"tag": "path",
						"props": {
							"d": "M12 2a10 10 0 1 1-10 10",
							"stroke": {
								"ttMap": {
									"arg": "tone",
									"values": {
										"primary": "#570df8",
										"success": "#00a96e",
										"warning": "#ffbe00",
										"danger": "#ff5861",
										"info": "#00b6ff",
										"neutral": "#2a323c"
									},
									"default": "#570df8"
								}
							},
							"strokeWidth": 3,
							"strokeLinecap": "round"
						}
					}
				]
			},
			{
				"ttIf": {
					"arg": "showLabel",
					"then": {
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "14px",
								"color": "#6b7280"
							}
						},
						"children": [
							"{label}"
						]
					}
				}
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "loading",
		"variant": "spinner",
		"tranche": 1
	}
}
