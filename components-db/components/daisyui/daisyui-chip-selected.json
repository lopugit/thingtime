{
	"slug": "daisyui-chip-selected",
	"name": "Selected Chip",
	"library": "daisyui",
	"category": "data-display",
	"description": "Selectable filter chip in the daisyUI style — checked state fills with the tone and gains a check glyph; unchecked stays a quiet outline.",
	"tags": [
		"chip",
		"filter",
		"selected",
		"toggle"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Popular",
			"label": "Label",
			"maxLength": 24
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "selected",
			"type": "boolean",
			"default": true,
			"label": "Selected"
		}
	],
	"render": {
		"tag": "span",
		"props": {
			"style": {
				"ttMerge": [
					{
						"display": "inline-flex",
						"alignItems": "center",
						"gap": "6px",
						"height": "32px",
						"padding": "0 12px",
						"borderRadius": "999px",
						"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
						"fontWeight": 500,
						"fontSize": "14px"
					},
					{
						"borderWidth": "1px",
						"borderStyle": "solid",
						"cursor": "pointer"
					},
					{
						"ttIf": {
							"arg": "selected",
							"then": {
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#570df8",
											"success": "#00a96e",
											"warning": "#ffbe00",
											"danger": "#ff5861",
											"info": "#00b6ff",
											"neutral": "#2a323c"
										},
										"default": "#570df8"
									}
								},
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#ffffff",
											"success": "#ffffff",
											"warning": "#382800",
											"danger": "#ffffff",
											"info": "#ffffff",
											"neutral": "#ffffff"
										},
										"default": "#ffffff"
									}
								},
								"borderColor": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#570df8",
											"success": "#00a96e",
											"warning": "#ffbe00",
											"danger": "#ff5861",
											"info": "#00b6ff",
											"neutral": "#2a323c"
										},
										"default": "#570df8"
									}
								}
							},
							"else": {
								"background": "#ffffff",
								"color": "#1f2937",
								"borderColor": "#e5e6e6"
							}
						}
					}
				]
			}
		},
		"children": [
			{
				"ttIf": {
					"arg": "selected",
					"then": {
						"tag": "svg",
						"props": {
							"width": 12,
							"height": 12,
							"viewBox": "0 0 24 24",
							"fill": "none",
							"stroke": "currentColor",
							"strokeWidth": 2,
							"strokeLinecap": "round",
							"strokeLinejoin": "round",
							"xmlns": "http://www.w3.org/2000/svg"
						},
						"children": [
							{
								"tag": "polyline",
								"props": {
									"points": "20 6 9 17 4 12"
								}
							}
						]
					}
				}
			},
			"{label}"
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "chip",
		"variant": "selected",
		"tranche": 1
	}
}
