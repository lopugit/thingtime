{
	"slug": "daisyui-card-basic",
	"name": "Basic Card",
	"library": "daisyui",
	"category": "layout",
	"description": "Simple padded content card in the daisyUI style — tone-colored eyebrow, heading and muted body on one bordered library surface.",
	"tags": [
		"card",
		"surface",
		"content"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Card title",
			"label": "Title",
			"maxLength": 60
		},
		{
			"name": "body",
			"type": "text",
			"default": "Cards group related content and actions onto one calm surface.",
			"label": "Body"
		},
		{
			"name": "eyebrow",
			"type": "string",
			"default": "Overview",
			"label": "Eyebrow",
			"maxLength": 30
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"width": "300px",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"background": "#ffffff",
				"color": "#1f2937",
				"border": "1px solid #e5e6e6",
				"borderRadius": "16px",
				"boxShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
				"overflow": "hidden",
				"boxSizing": "border-box",
				"padding": "16px",
				"gap": "8px"
			}
		},
		"children": [
			{
				"ttIf": {
					"arg": "eyebrow",
					"then": {
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "12px",
								"fontWeight": 600,
								"textTransform": "uppercase",
								"letterSpacing": "0.06em",
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#570df8",
											"success": "#00a96e",
											"warning": "#ffbe00",
											"danger": "#ff5861",
											"info": "#00b6ff",
											"neutral": "#2a323c"
										},
										"default": "#570df8"
									}
								}
							}
						},
						"children": [
							"{eyebrow}"
						]
					}
				}
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "18px",
						"fontWeight": 700,
						"color": "#1f2937"
					}
				},
				"children": [
					"{title}"
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "14px",
						"color": "#6b7280",
						"lineHeight": 1.5
					}
				},
				"children": [
					"{body}"
				]
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "card",
		"variant": "basic",
		"tranche": 1
	}
}
