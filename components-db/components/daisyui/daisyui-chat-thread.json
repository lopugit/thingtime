{
	"slug": "daisyui-chat-thread",
	"name": "Chat Thread",
	"library": "daisyui",
	"category": "messaging",
	"description": "Short alternating conversation in the daisyUI style — a date divider chip, incoming bubbles with an initials avatar, and tone-solid replies aligned to the right.",
	"tags": [
		"chat",
		"thread",
		"conversation",
		"messages"
	],
	"args": [
		{
			"name": "divider",
			"type": "string",
			"default": "Today",
			"label": "Date divider",
			"maxLength": 20
		},
		{
			"name": "initials",
			"type": "string",
			"default": "AL",
			"label": "Avatar initials",
			"maxLength": 3
		},
		{
			"name": "incoming",
			"type": "string",
			"default": "Are we still on for tonight?",
			"label": "First message",
			"maxLength": 120
		},
		{
			"name": "outgoing",
			"type": "string",
			"default": "Yes! See you at six.",
			"label": "Reply",
			"maxLength": 120
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"gap": "8px",
				"width": "300px",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "center"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"background": "#f2f2f2",
								"color": "#6b7280",
								"fontSize": "12px",
								"fontWeight": 600,
								"padding": "2px 10px",
								"borderRadius": "999px"
							}
						},
						"children": [
							"{divider}"
						]
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "flex-end",
						"gap": "8px",
						"alignSelf": "flex-start"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"width": "28px",
								"height": "28px",
								"borderRadius": "999px",
								"background": "#f2f2f2",
								"color": "#2a323c",
								"display": "flex",
								"alignItems": "center",
								"justifyContent": "center",
								"fontWeight": 600,
								"fontSize": "12px",
								"flexShrink": 0
							}
						},
						"children": [
							"{initials}"
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"padding": "8px 12px",
								"maxWidth": "220px",
								"fontSize": "14px",
								"lineHeight": 1.45,
								"background": "#f2f2f2",
								"color": "#1f2937",
								"borderRadius": "16px 16px 16px 8px"
							}
						},
						"children": [
							"{incoming}"
						]
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"padding": "8px 12px",
						"maxWidth": "220px",
						"fontSize": "14px",
						"lineHeight": 1.45,
						"background": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#570df8",
									"success": "#00a96e",
									"warning": "#ffbe00",
									"danger": "#ff5861",
									"info": "#00b6ff",
									"neutral": "#2a323c"
								},
								"default": "#570df8"
							}
						},
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#ffffff",
									"success": "#ffffff",
									"warning": "#382800",
									"danger": "#ffffff",
									"info": "#ffffff",
									"neutral": "#ffffff"
								},
								"default": "#ffffff"
							}
						},
						"borderRadius": "16px 16px 8px 16px",
						"alignSelf": "flex-end"
					}
				},
				"children": [
					"{outgoing}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "flex-end",
						"gap": "8px",
						"alignSelf": "flex-start"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"width": "28px",
								"height": "28px",
								"borderRadius": "999px",
								"background": "#f2f2f2",
								"color": "#2a323c",
								"display": "flex",
								"alignItems": "center",
								"justifyContent": "center",
								"fontWeight": 600,
								"fontSize": "12px",
								"flexShrink": 0
							}
						},
						"children": [
							"{initials}"
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"padding": "8px 12px",
								"maxWidth": "220px",
								"fontSize": "14px",
								"lineHeight": 1.45,
								"background": "#f2f2f2",
								"color": "#1f2937",
								"borderRadius": "16px 16px 16px 8px"
							}
						},
						"children": [
							"Perfect — bringing snacks."
						]
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"padding": "8px 12px",
						"maxWidth": "220px",
						"fontSize": "14px",
						"lineHeight": 1.45,
						"background": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#570df8",
									"success": "#00a96e",
									"warning": "#ffbe00",
									"danger": "#ff5861",
									"info": "#00b6ff",
									"neutral": "#2a323c"
								},
								"default": "#570df8"
							}
						},
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#ffffff",
									"success": "#ffffff",
									"warning": "#382800",
									"danger": "#ffffff",
									"info": "#ffffff",
									"neutral": "#ffffff"
								},
								"default": "#ffffff"
							}
						},
						"borderRadius": "16px 16px 8px 16px",
						"alignSelf": "flex-end"
					}
				},
				"children": [
					"Legend."
				]
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "chat",
		"variant": "thread",
		"tranche": 2
	}
}
