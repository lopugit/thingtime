{
	"slug": "daisyui-loading-loading-button",
	"name": "Loading Button",
	"library": "daisyui",
	"category": "feedback",
	"description": "Busy-state button in the daisyUI style — an inline arc spinner beside the label, in solid or quiet tinted form.",
	"tags": [
		"loading",
		"button",
		"spinner",
		"busy"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Saving…",
			"label": "Label",
			"maxLength": 40
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "size",
			"type": "enum",
			"values": [
				"sm",
				"md",
				"lg"
			],
			"default": "md",
			"label": "Size"
		},
		{
			"name": "quiet",
			"type": "boolean",
			"default": false,
			"label": "Quiet (tinted)"
		}
	],
	"render": {
		"tag": "button",
		"props": {
			"type": "button",
			"style": {
				"ttMerge": [
					{
						"display": "inline-flex",
						"alignItems": "center",
						"justifyContent": "center",
						"gap": "8px",
						"border": "none",
						"borderRadius": "12px",
						"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
						"fontWeight": 600,
						"cursor": "wait",
						"opacity": 0.9
					},
					{
						"ttMap": {
							"arg": "size",
							"values": {
								"sm": {
									"height": "32px",
									"padding": "0 12px",
									"fontSize": "14px"
								},
								"md": {
									"height": "48px",
									"padding": "0 16px",
									"fontSize": "14px"
								},
								"lg": {
									"height": "56px",
									"padding": "0 20px",
									"fontSize": "18px"
								}
							},
							"default": {
								"height": "48px",
								"padding": "0 16px",
								"fontSize": "14px"
							}
						}
					},
					{
						"background": {
							"ttIf": {
								"arg": "quiet",
								"then": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#eee6ff",
											"success": "#dcfce7",
											"warning": "#fef9c3",
											"danger": "#ffe4e6",
											"info": "#e0f2fe",
											"neutral": "#f2f2f2"
										},
										"default": "#eee6ff"
									}
								},
								"else": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#570df8",
											"success": "#00a96e",
											"warning": "#ffbe00",
											"danger": "#ff5861",
											"info": "#00b6ff",
											"neutral": "#2a323c"
										},
										"default": "#570df8"
									}
								}
							}
						},
						"color": {
							"ttIf": {
								"arg": "quiet",
								"then": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#4506cb",
											"success": "#00753d",
											"warning": "#854d0e",
											"danger": "#be123c",
											"info": "#0369a1",
											"neutral": "#2a323c"
										},
										"default": "#4506cb"
									}
								},
								"else": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#ffffff",
											"success": "#ffffff",
											"warning": "#382800",
											"danger": "#ffffff",
											"info": "#ffffff",
											"neutral": "#ffffff"
										},
										"default": "#ffffff"
									}
								}
							}
						},
						"boxShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.05)"
					}
				]
			}
		},
		"children": [
			{
				"tag": "svg",
				"props": {
					"width": 16,
					"height": 16,
					"viewBox": "0 0 24 24",
					"fill": "none",
					"xmlns": "http://www.w3.org/2000/svg"
				},
				"children": [
					{
						"tag": "circle",
						"props": {
							"cx": 12,
							"cy": 12,
							"r": 10,
							"stroke": "currentColor",
							"strokeWidth": 3,
							"style": {
								"opacity": 0.3
							}
						}
					},
					{
						"tag": "path",
						"props": {
							"d": "M12 2a10 10 0 1 1-10 10",
							"stroke": "currentColor",
							"strokeWidth": 3,
							"strokeLinecap": "round"
						}
					}
				]
			},
			"{label}"
		]
	},
	"version": 1,
	"familyKey": "loading-loading-button",
	"source": {
		"kind": "archetype",
		"archetype": "loading",
		"variant": "loading-button",
		"tranche": 1
	}
}
