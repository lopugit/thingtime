{
	"slug": "daisyui-card-actions",
	"name": "Actions Card",
	"library": "daisyui",
	"category": "layout",
	"description": "Card with footer action buttons in the daisyUI style — solid confirm beside an outlined cancel, right-aligned above the border.",
	"tags": [
		"card",
		"actions",
		"buttons",
		"footer"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Delete project?",
			"label": "Title",
			"maxLength": 60
		},
		{
			"name": "body",
			"type": "text",
			"default": "This removes the project and its history. Collaborators lose access immediately.",
			"label": "Body"
		},
		{
			"name": "primaryLabel",
			"type": "string",
			"default": "Confirm",
			"label": "Primary label",
			"maxLength": 30
		},
		{
			"name": "secondaryLabel",
			"type": "string",
			"default": "Cancel",
			"label": "Secondary label",
			"maxLength": 30
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "danger",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"width": "300px",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"background": "#ffffff",
				"color": "#1f2937",
				"border": "1px solid #e5e6e6",
				"borderRadius": "16px",
				"boxShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
				"overflow": "hidden",
				"boxSizing": "border-box"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"padding": "16px",
						"gap": "8px"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "18px",
								"fontWeight": 700,
								"color": "#1f2937"
							}
						},
						"children": [
							"{title}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "14px",
								"color": "#6b7280",
								"lineHeight": 1.5
							}
						},
						"children": [
							"{body}"
						]
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "flex-end",
						"gap": "8px",
						"padding": "12px 16px",
						"borderTop": "1px solid #f2f2f2"
					}
				},
				"children": [
					{
						"ttIf": {
							"arg": "secondaryLabel",
							"then": {
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"display": "inline-flex",
										"alignItems": "center",
										"justifyContent": "center",
										"height": "32px",
										"padding": "0 14px",
										"border": "1px solid #e5e6e6",
										"borderRadius": "8px",
										"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
										"fontWeight": 600,
										"fontSize": "14px",
										"cursor": "pointer",
										"background": "transparent",
										"color": "#1f2937"
									}
								},
								"children": [
									"{secondaryLabel}"
								]
							}
						}
					},
					{
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"ttMerge": [
									{
										"display": "inline-flex",
										"alignItems": "center",
										"justifyContent": "center",
										"height": "32px",
										"padding": "0 14px",
										"border": "none",
										"borderRadius": "8px",
										"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
										"fontWeight": 600,
										"fontSize": "14px",
										"cursor": "pointer"
									},
									{
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#570df8",
													"success": "#00a96e",
													"warning": "#ffbe00",
													"danger": "#ff5861",
													"info": "#00b6ff",
													"neutral": "#2a323c"
												},
												"default": "#570df8"
											}
										},
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#ffffff",
													"success": "#ffffff",
													"warning": "#382800",
													"danger": "#ffffff",
													"info": "#ffffff",
													"neutral": "#ffffff"
												},
												"default": "#ffffff"
											}
										}
									}
								]
							}
						},
						"children": [
							"{primaryLabel}"
						]
					}
				]
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "card",
		"variant": "actions",
		"tranche": 1
	}
}
