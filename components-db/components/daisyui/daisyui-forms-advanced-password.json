{
	"slug": "daisyui-forms-advanced-password",
	"name": "Password Strength Field",
	"library": "daisyui",
	"category": "forms",
	"description": "Password field in the daisyUI style — masked dot glyphs inside the field plus a four-segment strength meter sweeping from danger to success with a matching caption.",
	"tags": [
		"form",
		"password",
		"strength",
		"security"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Password",
			"label": "Label",
			"maxLength": 30
		},
		{
			"name": "dots",
			"type": "number",
			"default": 8,
			"label": "Characters",
			"min": 1,
			"max": 12
		},
		{
			"name": "strength",
			"type": "enum",
			"values": [
				"weak",
				"fair",
				"good",
				"strong"
			],
			"default": "fair",
			"label": "Strength"
		},
		{
			"name": "focused",
			"type": "boolean",
			"default": false,
			"label": "Focused"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"gap": "6px",
				"width": "260px",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
			}
		},
		"children": [
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "14px",
						"fontWeight": 600,
						"color": "#1f2937"
					}
				},
				"children": [
					"{label}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"boxSizing": "border-box",
						"height": "48px",
						"padding": "0 12px",
						"background": "#ffffff",
						"borderWidth": "2px",
						"borderStyle": "solid",
						"borderColor": {
							"ttIf": {
								"arg": "focused",
								"then": "#570df8",
								"else": "#e5e6e6"
							}
						},
						"borderRadius": "8px",
						"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
						"fontSize": "14px",
						"color": "#1f2937",
						"gap": "4px",
						"boxShadow": {
							"ttIf": {
								"arg": "focused",
								"then": "0 0 0 2px #ffffff, 0 0 0 4px #570df8",
								"else": "none"
							}
						}
					}
				},
				"children": [
					{
						"ttRepeat": {
							"arg": "dots",
							"max": 12,
							"node": {
								"tag": "span",
								"props": {
									"style": {
										"width": "6px",
										"height": "6px",
										"borderRadius": "999px",
										"background": "#1f2937",
										"flexShrink": 0
									}
								}
							}
						}
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "4px"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"flex": 1,
								"height": "8px",
								"borderRadius": "999px",
								"background": {
									"ttMap": {
										"arg": "strength",
										"values": {
											"weak": "#ff5861",
											"fair": "#ffbe00",
											"good": "#00b6ff",
											"strong": "#00a96e"
										},
										"default": "#f2f2f2"
									}
								}
							}
						}
					},
					{
