											"strong": "#00a96e"
										},
										"default": "#f2f2f2"
									}
								}
							}
						}
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"flex": 1,
								"height": "8px",
								"borderRadius": "999px",
								"background": {
									"ttMap": {
										"arg": "strength",
										"values": {
											"weak": "#f2f2f2",
											"fair": "#f2f2f2",
											"good": "#f2f2f2",
											"strong": "#00a96e"
										},
										"default": "#f2f2f2"
									}
								}
							}
						}
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "12px",
						"fontWeight": 500,
						"color": {
							"ttMap": {
								"arg": "strength",
								"values": {
									"weak": "#be123c",
									"fair": "#854d0e",
									"good": "#0369a1",
									"strong": "#00753d"
								},
								"default": "#6b7280"
							}
						}
					}
				},
				"children": [
					{
						"ttMap": {
							"arg": "strength",
							"values": {
								"weak": "Too weak",
								"fair": "Could be stronger",
								"good": "Good password",
								"strong": "Strong password"
							},
							"default": "Could be stronger"
						}
					}
				]
			}
		]
	},
	"version": 1,
