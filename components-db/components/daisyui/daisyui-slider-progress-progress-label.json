{
	"slug": "daisyui-slider-progress-progress-label",
	"name": "Labeled Progress",
	"library": "daisyui",
	"category": "forms",
	"description": "Progress bar with a caption row in the daisyUI style — task label on the left, live percent readout on the right, tone-colored fill below.",
	"tags": [
		"progress",
		"label",
		"percent",
		"status"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Uploading assets",
			"label": "Label",
			"maxLength": 40
		},
		{
			"name": "percent",
			"type": "number",
			"default": 68,
			"label": "Percent",
			"min": 0,
			"max": 100
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "showPercent",
			"type": "boolean",
			"default": true,
			"label": "Show percent"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"gap": "6px",
				"width": "240px",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "space-between"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "14px",
								"fontWeight": 700,
								"color": "#1f2937"
							}
						},
						"children": [
							"{label}"
						]
					},
					{
						"ttIf": {
							"arg": "showPercent",
							"then": {
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "14px",
										"color": "#6b7280"
									}
								},
								"children": [
									"{percent}%"
								]
							}
						}
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"height": "12px",
						"background": "#f2f2f2",
						"borderRadius": "999px",
						"overflow": "hidden"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"width": "{percent}%",
								"height": "100%",
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#570df8",
											"success": "#00a96e",
											"warning": "#ffbe00",
											"danger": "#ff5861",
											"info": "#00b6ff",
											"neutral": "#2a323c"
										},
										"default": "#570df8"
									}
								},
								"borderRadius": "999px"
							}
						}
					}
				]
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "slider-progress",
		"variant": "progress-label",
		"tranche": 1
	}
}
