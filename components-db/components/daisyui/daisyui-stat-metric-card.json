{
	"slug": "daisyui-stat-metric-card",
	"name": "Stat Card",
	"library": "daisyui",
	"category": "data-display",
	"description": "Single-metric stat card in the daisyUI style — quiet label, large tabular value, and a tinted delta pill on daisyUI surface, border, and radius tokens.",
	"tags": [
		"stat",
		"metric",
		"card",
		"kpi"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Monthly revenue",
			"label": "Label",
			"maxLength": 40
		},
		{
			"name": "value",
			"type": "string",
			"default": "$48,210",
			"label": "Value",
			"maxLength": 20
		},
		{
			"name": "delta",
			"type": "string",
			"default": "+12.4%",
			"label": "Delta",
			"maxLength": 12
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "success",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "inline-flex",
				"flexDirection": "column",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"background": "#ffffff",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "#e5e6e6",
				"borderRadius": "16px",
				"boxShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
				"boxSizing": "border-box",
				"padding": "16px 20px",
				"gap": "6px",
				"minWidth": "200px"
			}
		},
		"children": [
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "12px",
						"fontWeight": 400,
						"color": "#6b7280"
					}
				},
				"children": [
					"{label}"
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "24px",
						"fontWeight": 700,
						"color": "#1f2937",
						"lineHeight": 1.15,
						"fontVariantNumeric": "tabular-nums"
					}
				},
				"children": [
					"{value}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "8px",
						"marginTop": "2px"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"display": "inline-flex",
								"alignItems": "center",
								"padding": "2px 8px",
								"borderRadius": "999px",
								"fontSize": "12px",
								"fontWeight": 600,
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#eee6ff",
											"success": "#dcfce7",
											"warning": "#fef9c3",
											"danger": "#ffe4e6",
											"info": "#e0f2fe",
											"neutral": "#f2f2f2"
										},
										"default": "#dcfce7"
									}
								},
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#4506cb",
											"success": "#00753d",
											"warning": "#854d0e",
											"danger": "#be123c",
											"info": "#0369a1",
											"neutral": "#2a323c"
										},
										"default": "#00753d"
									}
								}
							}
						},
						"children": [
							"{delta}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "12px",
								"color": "#9ca3af"
							}
						},
						"children": [
							"vs last month"
						]
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "stat-metric-card",
	"source": {
		"kind": "archetype",
		"archetype": "stat-metric",
		"variant": "card",
		"tranche": 1
	}
}
