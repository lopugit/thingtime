{
	"slug": "daisyui-badge-dot",
	"name": "Dot Badge",
	"library": "daisyui",
	"category": "data-display",
	"description": "Dot-indicator badge in the daisyUI style — a small tone-colored dot beside a quiet label, optionally wrapped in a bordered chip.",
	"tags": [
		"badge",
		"status",
		"dot",
		"indicator"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Online",
			"label": "Label",
			"maxLength": 24
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "success",
			"label": "Tone"
		},
		{
			"name": "size",
			"type": "enum",
			"values": [
				"sm",
				"md"
			],
			"default": "sm",
			"label": "Size"
		},
		{
			"name": "bordered",
			"type": "boolean",
			"default": true,
			"label": "Bordered"
		}
	],
	"render": {
		"tag": "span",
		"props": {
			"style": {
				"ttMerge": [
					{
						"display": "inline-flex",
						"alignItems": "center",
						"gap": "6px",
						"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
						"fontWeight": 600,
						"lineHeight": 1.4,
						"borderRadius": "999px"
					},
					{
						"ttMap": {
							"arg": "size",
							"values": {
								"sm": {
									"fontSize": "12px",
									"padding": "2px 8px"
								},
								"md": {
									"fontSize": "14px",
									"padding": "4px 10px"
								}
							},
							"default": {
								"fontSize": "12px",
								"padding": "2px 8px"
							}
						}
					},
					{
						"color": "#1f2937",
						"fontWeight": 500
					},
					{
						"ttIf": {
							"arg": "bordered",
							"then": {
								"background": "#ffffff",
								"borderWidth": "1px",
								"borderStyle": "solid",
								"borderColor": "#e5e6e6",
								"boxShadow": "none"
							},
							"else": {}
						}
					}
				]
			}
		},
		"children": [
			{
				"tag": "span",
				"props": {
					"style": {
						"width": "8px",
						"height": "8px",
						"borderRadius": "999px",
						"background": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#570df8",
									"success": "#00a96e",
									"warning": "#ffbe00",
									"danger": "#ff5861",
									"info": "#00b6ff",
									"neutral": "#2a323c"
								},
								"default": "#570df8"
							}
						},
						"flexShrink": 0
					}
				}
			},
			"{label}"
		]
	},
	"version": 1,
	"familyKey": "badge-dot",
	"source": {
		"kind": "archetype",
		"archetype": "badge",
		"variant": "dot",
		"tranche": 1
	}
}
