{
	"slug": "untitled-code-block-diff",
	"name": "Diff Viewer",
	"library": "untitled",
	"category": "data-display",
	"description": "Diff viewer in the Untitled UI style — hunk header plus removed and added lines washed in the library's danger and success tints, with +/− counters in the file bar.",
	"tags": [
		"code",
		"diff",
		"review",
		"changes"
	],
	"args": [
		{
			"name": "filename",
			"type": "string",
			"default": "src/utils/total.ts",
			"label": "Filename",
			"maxLength": 60
		},
		{
			"name": "removed",
			"type": "string",
			"default": "var total = items.length",
			"label": "Removed line",
			"maxLength": 60
		},
		{
			"name": "added",
			"type": "string",
			"default": "const total = items.reduce(sum, 0)",
			"label": "Added line",
			"maxLength": 60
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "#eaecf0",
				"borderRadius": "8px",
				"overflow": "hidden",
				"background": "#ffffff",
				"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
				"fontSize": "14px",
				"boxShadow": "0 1px 2px rgba(16, 24, 40, 0.05)"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"padding": "8px 12px",
						"gap": "8px",
						"background": "#f9fafb",
						"borderBottomWidth": "1px",
						"borderBottomStyle": "solid",
						"borderBottomColor": "#f2f4f7",
						"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "14px",
								"fontWeight": 600,
								"color": "#101828"
							}
						},
						"children": [
							"{filename}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"flex": 1
							}
						}
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "12px",
								"fontWeight": 700,
								"color": "#027a48"
							}
						},
						"children": [
							"+2"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "12px",
								"fontWeight": 700,
								"color": "#b42318"
							}
						},
						"children": [
							"−2"
						]
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"whiteSpace": "pre",
						"lineHeight": 1.7,
						"padding": "6px 0",
						"overflowX": "auto"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"padding": "2px 12px",
								"background": "#eff8ff",
								"color": "#175cd3"
							}
						},
						"children": [
							"@@ -18,5 +18,5 @@"
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"padding": "2px 12px",
								"background": "#fef3f2",
								"color": "#b42318"
							}
						},
						"children": [
							"- {removed}"
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"padding": "2px 12px",
								"background": "#fef3f2",
								"color": "#b42318"
							}
						},
						"children": [
							"- console.log('total', total)"
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"padding": "2px 12px",
								"background": "#ecfdf3",
								"color": "#027a48"
							}
						},
						"children": [
							"+ {added}"
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"padding": "2px 12px",
								"background": "#ecfdf3",
								"color": "#027a48"
							}
						},
						"children": [
							"+ logger.debug(total)"
						]
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "code-block-diff",
	"source": {
		"kind": "archetype",
		"archetype": "code-block",
		"variant": "diff",
		"tranche": 2
	}
}
