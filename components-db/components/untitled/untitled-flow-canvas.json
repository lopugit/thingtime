{
	"slug": "untitled-flow-canvas",
	"name": "Flow Canvas",
	"library": "untitled",
	"category": "flow",
	"description": "Dotted-grid graph canvas in the Untitled UI style — repeating radial-gradient dot field holding positioned nodes joined by svg bezier connectors, with a toggleable third node.",
	"tags": [
		"flow",
		"canvas",
		"grid",
		"graph",
		"svg"
