{
	"slug": "untitled-stat-metric-comparison",
	"name": "Comparison Stat",
	"library": "untitled",
	"category": "data-display",
	"description": "Two-value comparison card in the Untitled UI style — current figure in the tone color beside the previous figure, split by a vertical divider.",
	"tags": [
		"stat",
		"comparison",
		"versus",
		"card"
	],
	"args": [
		{
			"name": "leftLabel",
			"type": "string",
			"default": "This week",
			"label": "Left label",
			"maxLength": 24
		},
		{
			"name": "leftValue",
			"type": "string",
			"default": "1,284",
			"label": "Left value",
			"maxLength": 16
		},
		{
			"name": "rightLabel",
			"type": "string",
			"default": "Last week",
			"label": "Right label",
			"maxLength": 24
		},
		{
			"name": "rightValue",
			"type": "string",
			"default": "1,102",
			"label": "Right value",
			"maxLength": 16
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "inline-flex",
				"alignItems": "stretch",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"background": "#ffffff",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "#eaecf0",
				"borderRadius": "12px",
				"boxShadow": "0 1px 2px rgba(16, 24, 40, 0.05)",
				"boxSizing": "border-box",
				"padding": "16px 20px",
				"gap": "18px"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"gap": "4px",
						"flex": "1 1 0",
						"minWidth": "90px"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "12px",
								"fontWeight": 500,
								"color": "#475467"
							}
						},
						"children": [
							"{leftLabel}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "18px",
								"fontWeight": 600,
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#7f56d9",
											"success": "#12b76a",
											"warning": "#f79009",
											"danger": "#f04438",
											"info": "#2e90fa",
											"neutral": "#344054"
										},
										"default": "#7f56d9"
									}
								},
								"lineHeight": 1.15,
								"fontVariantNumeric": "tabular-nums"
							}
						},
						"children": [
							"{leftValue}"
						]
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"width": "2px",
						"alignSelf": "stretch",
						"borderRadius": "999px",
						"background": "#f2f4f7",
						"flexShrink": 0
					}
				}
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"gap": "4px",
						"flex": "1 1 0",
						"minWidth": "90px"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "12px",
								"fontWeight": 500,
								"color": "#475467"
							}
						},
						"children": [
							"{rightLabel}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "18px",
								"fontWeight": 600,
								"color": "#101828",
								"lineHeight": 1.15,
								"fontVariantNumeric": "tabular-nums"
							}
						},
						"children": [
							"{rightValue}"
						]
					}
				]
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "stat-metric",
		"variant": "comparison",
		"tranche": 1
	}
}
