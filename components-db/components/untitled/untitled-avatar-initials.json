{
	"slug": "untitled-avatar-initials",
	"name": "Initials Avatar",
	"library": "untitled",
	"category": "data-display",
	"description": "Circular initials avatar in the Untitled UI style — tone-filled disc with library type, optional soft tint and a surface-offset ring.",
	"tags": [
		"avatar",
		"initials",
		"profile"
	],
	"args": [
		{
			"name": "initials",
			"type": "string",
			"default": "NF",
			"label": "Initials",
			"maxLength": 3
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "size",
			"type": "enum",
			"values": [
				"sm",
				"md",
				"lg"
			],
			"default": "md",
			"label": "Size"
		},
		{
			"name": "soft",
			"type": "boolean",
			"default": false,
			"label": "Soft tint"
		},
		{
			"name": "ring",
			"type": "boolean",
			"default": false,
			"label": "Ring"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"ttMerge": [
					{
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "center",
						"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
						"fontWeight": 600,
						"borderRadius": "999px",
						"flexShrink": 0,
						"userSelect": "none"
					},
					{
						"ttMap": {
							"arg": "size",
							"values": {
								"sm": {
									"width": "28px",
									"height": "28px",
									"fontSize": "12px"
								},
								"md": {
									"width": "40px",
									"height": "40px",
									"fontSize": "14px"
								},
								"lg": {
									"width": "56px",
									"height": "56px",
									"fontSize": "16px"
								}
							},
							"default": {
								"width": "40px",
								"height": "40px",
								"fontSize": "14px"
							}
						}
					},
					{
						"ttIf": {
							"arg": "soft",
							"then": {
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#f9f5ff",
											"success": "#ecfdf3",
											"warning": "#fffaeb",
											"danger": "#fef3f2",
											"info": "#eff8ff",
											"neutral": "#f2f4f7"
										},
										"default": "#f9f5ff"
									}
								},
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#6941c6",
											"success": "#027a48",
											"warning": "#b54708",
											"danger": "#b42318",
											"info": "#175cd3",
											"neutral": "#344054"
										},
										"default": "#6941c6"
									}
								},
								"border": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "1px solid #e9d7fe",
											"success": "1px solid #a6f4c5",
											"warning": "1px solid #fedf89",
											"danger": "1px solid #fecdca",
											"info": "1px solid #b2ddff",
											"neutral": "1px solid #d0d5dd"
										},
										"default": "1px solid #e9d7fe"
									}
								}
							},
							"else": {
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#7f56d9",
											"success": "#12b76a",
											"warning": "#f79009",
											"danger": "#f04438",
											"info": "#2e90fa",
											"neutral": "#344054"
										},
										"default": "#7f56d9"
									}
								},
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#ffffff",
											"success": "#ffffff",
											"warning": "#ffffff",
											"danger": "#ffffff",
											"info": "#ffffff",
											"neutral": "#ffffff"
										},
										"default": "#ffffff"
									}
								}
							}
						}
					},
					{
						"ttIf": {
							"arg": "ring",
							"then": {
								"boxShadow": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "0 0 0 2px #ffffff, 0 0 0 4px #e9d7fe",
											"success": "0 0 0 2px #ffffff, 0 0 0 4px #a6f4c5",
											"warning": "0 0 0 2px #ffffff, 0 0 0 4px #fedf89",
											"danger": "0 0 0 2px #ffffff, 0 0 0 4px #fecdca",
											"info": "0 0 0 2px #ffffff, 0 0 0 4px #b2ddff",
											"neutral": "0 0 0 2px #ffffff, 0 0 0 4px #d0d5dd"
										},
										"default": "0 0 0 2px #ffffff, 0 0 0 4px #e9d7fe"
									}
								}
							},
							"else": {}
						}
					}
				]
			}
		},
		"children": [
			"{initials}"
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "avatar",
		"variant": "initials",
		"tranche": 1
	}
}
