{
	"slug": "untitled-chip-closable",
	"name": "Closable Chip",
	"library": "untitled",
	"category": "data-display",
	"description": "Removable tag chip in the Untitled UI style — a soft tone chip with a trailing x glyph, dimming when disabled.",
	"tags": [
		"chip",
		"tag",
		"closable",
		"removable"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Filter: recent",
			"label": "Label",
			"maxLength": 24
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "disabled",
			"type": "boolean",
			"default": false,
			"label": "Disabled"
		}
	],
	"render": {
		"tag": "span",
		"props": {
			"style": {
				"ttMerge": [
					{
						"display": "inline-flex",
						"alignItems": "center",
						"gap": "6px",
						"height": "36px",
						"padding": "0 12px",
						"borderRadius": "999px",
						"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
						"fontWeight": 500,
						"fontSize": "14px"
					},
					{
						"background": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#f9f5ff",
									"success": "#ecfdf3",
									"warning": "#fffaeb",
									"danger": "#fef3f2",
									"info": "#eff8ff",
									"neutral": "#f2f4f7"
								},
								"default": "#f9f5ff"
							}
						},
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#6941c6",
									"success": "#027a48",
									"warning": "#b54708",
									"danger": "#b42318",
									"info": "#175cd3",
									"neutral": "#344054"
								},
								"default": "#6941c6"
							}
						}
					},
					{
						"cursor": "pointer"
					},
					{
						"ttIf": {
							"arg": "disabled",
							"then": {
								"opacity": 0.5,
								"cursor": "not-allowed"
							},
							"else": {}
						}
					}
				]
			}
		},
		"children": [
			"{label}",
			{
				"tag": "svg",
				"props": {
					"width": 12,
					"height": 12,
					"viewBox": "0 0 24 24",
					"fill": "none",
					"stroke": "currentColor",
					"strokeWidth": 2,
					"strokeLinecap": "round",
					"strokeLinejoin": "round",
					"xmlns": "http://www.w3.org/2000/svg"
				},
				"children": [
					{
						"tag": "line",
						"props": {
							"x1": 18,
							"y1": 6,
							"x2": 6,
							"y2": 18
						}
					},
					{
						"tag": "line",
						"props": {
							"x1": 6,
							"y1": 6,
							"x2": 18,
							"y2": 18
						}
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "chip-closable",
	"source": {
		"kind": "archetype",
		"archetype": "chip",
		"variant": "closable",
		"tranche": 1
	}
}
