{
	"slug": "untitled-tooltip-popover-popover",
	"name": "Popover",
	"library": "untitled",
	"category": "overlays",
	"description": "Titled popover in the Untitled UI style — elevated surface card anchored below its trigger with an arrow caret, heading, body copy, and an optional tone action button.",
	"tags": [
		"popover",
		"overlay",
		"card",
		"anchored"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Share this view",
			"label": "Title",
			"maxLength": 50
		},
		{
			"name": "body",
			"type": "text",
			"default": "Anyone with the link can see live updates. Manage access anytime from settings.",
			"label": "Body"
		},
		{
			"name": "triggerLabel",
			"type": "string",
			"default": "Share",
			"label": "Trigger label",
			"maxLength": 24
		},
		{
			"name": "showAction",
			"type": "boolean",
			"default": true,
			"label": "Show action"
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Copy link",
			"label": "Action label",
			"maxLength": 24
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "inline-flex",
				"flexDirection": "column",
				"alignItems": "flex-start",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
			}
		},
		"children": [
			{
				"tag": "button",
				"props": {
					"type": "button",
					"style": {
						"display": "inline-flex",
						"alignItems": "center",
						"justifyContent": "center",
						"gap": "6px",
						"height": "40px",
						"padding": "0 14px",
						"background": "#ffffff",
						"color": "#101828",
						"border": "1px solid #eaecf0",
						"borderRadius": "8px",
						"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
						"fontSize": "14px",
						"fontWeight": 600,
						"boxShadow": "0 1px 2px rgba(16, 24, 40, 0.05)",
						"cursor": "pointer"
					}
				},
				"children": [
					"{triggerLabel}",
					{
						"tag": "svg",
						"props": {
							"width": 14,
							"height": 14,
							"viewBox": "0 0 24 24",
							"fill": "none",
							"stroke": "currentColor",
							"strokeWidth": 2,
							"strokeLinecap": "round",
							"strokeLinejoin": "round",
							"xmlns": "http://www.w3.org/2000/svg"
						},
						"children": [
							{
								"tag": "polyline",
								"props": {
									"points": "6 9 12 15 18 9"
								}
							}
						]
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"alignItems": "flex-start",
						"marginTop": "3px"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"marginLeft": "18px"
							}
						},
						"children": [
							{
								"tag": "div",
								"props": {
									"style": {
										"width": 0,
										"height": 0,
										"borderLeft": "6px solid transparent",
										"borderRight": "6px solid transparent",
										"borderBottom": "6px solid #eaecf0"
									}
								}
							}
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"flexDirection": "column",
								"gap": "8px",
								"width": "270px",
								"padding": "14px 16px",
								"background": "#ffffff",
								"border": "1px solid #eaecf0",
								"borderRadius": "12px",
								"boxShadow": "0 12px 16px -4px rgba(16, 24, 40, 0.08), 0 4px 6px -2px rgba(16, 24, 40, 0.03)",
								"color": "#101828"
							}
						},
						"children": [
							{
								"tag": "span",
								"props": {
									"style": {
										"fontWeight": 600,
										"fontSize": "14px"
									}
								},
								"children": [
									"{title}"
								]
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "14px",
										"color": "#475467",
										"lineHeight": 1.5
									}
								},
								"children": [
									"{body}"
								]
							},
							{
								"ttIf": {
									"arg": "showAction",
									"then": {
										"tag": "button",
										"props": {
											"type": "button",
											"style": {
												"alignSelf": "flex-start",
												"display": "inline-flex",
												"alignItems": "center",
												"justifyContent": "center",
												"height": "36px",
												"padding": "0 12px",
												"border": "none",
												"borderRadius": "8px",
												"background": {
													"ttMap": {
														"arg": "tone",
														"values": {
															"primary": "#7f56d9",
															"success": "#12b76a",
															"warning": "#f79009",
															"danger": "#f04438",
															"info": "#2e90fa",
															"neutral": "#344054"
														},
														"default": "#7f56d9"
													}
												},
												"color": {
													"ttMap": {
														"arg": "tone",
														"values": {
															"primary": "#ffffff",
															"success": "#ffffff",
															"warning": "#ffffff",
															"danger": "#ffffff",
															"info": "#ffffff",
															"neutral": "#ffffff"
														},
														"default": "#ffffff"
													}
												},
												"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
												"fontSize": "14px",
												"fontWeight": 600,
												"cursor": "pointer",
												"marginTop": "2px"
											}
										},
										"children": [
											"{actionLabel}"
										]
									}
								}
							}
						]
					}
				]
			}
		]
	},
	"previewBg": "#f9fafb",
	"version": 1,
	"familyKey": "tooltip-popover-popover",
	"source": {
		"kind": "archetype",
		"archetype": "tooltip-popover",
		"variant": "popover",
		"tranche": 1
	}
}
