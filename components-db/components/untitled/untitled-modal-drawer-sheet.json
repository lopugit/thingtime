{
	"slug": "untitled-modal-drawer-sheet",
	"name": "Bottom Sheet",
	"library": "untitled",
	"category": "overlays",
	"description": "Bottom sheet rising over a dimmed backdrop in the Untitled UI style — a slim grab handle above the title, body copy, and a full-width tone action.",
	"tags": [
		"sheet",
		"mobile",
		"overlay",
		"bottom"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Share this page",
			"label": "Title",
			"maxLength": 40
		},
		{
			"name": "body",
			"type": "text",
			"default": "Send a link to your teammates or copy it to your clipboard.",
			"label": "Body",
			"maxLength": 200
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Copy link",
			"label": "Action label",
			"maxLength": 24
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"width": "340px",
				"minHeight": "280px",
				"boxSizing": "border-box",
				"background": "rgba(12, 12, 16, 0.45)",
				"borderRadius": "8px",
				"overflow": "hidden",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"flexDirection": "column",
				"justifyContent": "flex-end",
				"alignItems": "stretch"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"background": "#ffffff",
						"color": "#101828",
						"borderRadius": "12px 12px 0 0",
						"boxShadow": "0 12px 16px -4px rgba(16, 24, 40, 0.08), 0 4px 6px -2px rgba(16, 24, 40, 0.03)",
						"display": "flex",
						"flexDirection": "column",
						"overflow": "hidden",
						"padding": "10px 20px 20px"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"width": "40px",
								"height": "4px",
								"borderRadius": "999px",
								"background": "#eaecf0",
								"margin": "0 auto 14px",
								"flexShrink": 0
							}
						}
					},
					{
						"tag": "h3",
						"props": {
							"style": {
								"margin": "0 0 6px",
								"fontSize": "16px",
								"fontWeight": 600
							}
						},
						"children": [
							"{title}"
						]
					},
					{
						"tag": "p",
						"props": {
							"style": {
								"margin": "0 0 16px",
								"color": "#475467",
								"fontSize": "14px",
								"lineHeight": 1.6
							}
						},
						"children": [
							"{body}"
						]
					},
					{
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"display": "inline-flex",
								"alignItems": "center",
								"justifyContent": "center",
								"height": "40px",
								"padding": "0 14px",
								"borderRadius": "8px",
								"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
								"fontSize": "14px",
								"fontWeight": 600,
								"cursor": "pointer",
								"border": "none",
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#7f56d9",
											"success": "#12b76a",
											"warning": "#f79009",
											"danger": "#f04438",
											"info": "#2e90fa",
											"neutral": "#344054"
										},
										"default": "#7f56d9"
									}
								},
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#ffffff",
											"success": "#ffffff",
											"warning": "#ffffff",
											"danger": "#ffffff",
											"info": "#ffffff",
											"neutral": "#ffffff"
										},
										"default": "#ffffff"
									}
								},
								"boxShadow": "0 1px 2px rgba(16, 24, 40, 0.05)",
								"width": "100%"
							}
						},
						"children": [
							"{actionLabel}"
						]
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "modal-drawer-sheet",
	"source": {
		"kind": "archetype",
		"archetype": "modal-drawer",
		"variant": "sheet",
		"tranche": 1
	}
}
