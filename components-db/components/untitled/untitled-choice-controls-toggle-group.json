{
	"slug": "untitled-choice-controls-toggle-group",
	"name": "Toggle Group",
	"library": "untitled",
	"category": "forms",
	"description": "Segmented toggle-button group in the Untitled UI style — a padded rail where the active index lifts onto a shadowed surface chip.",
	"tags": [
		"form",
		"toggle",
		"segmented",
		"group"
	],
	"args": [
		{
			"name": "labelA",
			"type": "string",
			"default": "Day",
			"label": "Segment A",
			"maxLength": 20
		},
		{
			"name": "labelB",
			"type": "string",
			"default": "Week",
			"label": "Segment B",
			"maxLength": 20
		},
		{
			"name": "labelC",
			"type": "string",
			"default": "Month",
			"label": "Segment C",
			"maxLength": 20
		},
		{
			"name": "active",
			"type": "enum",
			"values": [
				"1",
				"2",
				"3"
			],
			"default": "2",
			"label": "Active segment"
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "inline-flex",
				"background": "#f9fafb",
				"padding": "4px",
				"gap": "2px",
				"borderRadius": "8px"
			}
		},
		"children": [
			{
				"tag": "button",
				"props": {
					"type": "button",
					"style": {
						"ttMerge": [
							{
								"height": "36px",
								"padding": "0 14px",
								"display": "inline-flex",
								"alignItems": "center",
								"justifyContent": "center",
								"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
								"fontSize": "14px",
								"fontWeight": 600,
								"border": "none",
								"cursor": "pointer",
								"borderRadius": "6px"
							},
							{
								"ttIf": {
									"arg": "active",
									"equals": "1",
									"then": {
										"background": "#ffffff",
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#6941c6",
													"success": "#027a48",
													"warning": "#b54708",
													"danger": "#b42318",
													"info": "#175cd3",
													"neutral": "#344054"
												},
												"default": "#6941c6"
											}
										},
										"boxShadow": "0 1px 2px rgba(16, 24, 40, 0.05)"
									},
									"else": {
										"background": "transparent",
										"color": "#475467"
									}
								}
							}
						]
					}
				},
				"children": [
					"{labelA}"
				]
			},
			{
				"tag": "button",
				"props": {
					"type": "button",
					"style": {
						"ttMerge": [
							{
								"height": "36px",
								"padding": "0 14px",
								"display": "inline-flex",
								"alignItems": "center",
								"justifyContent": "center",
								"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
								"fontSize": "14px",
								"fontWeight": 600,
								"border": "none",
								"cursor": "pointer",
								"borderRadius": "6px"
							},
							{
								"ttIf": {
									"arg": "active",
									"equals": "2",
									"then": {
										"background": "#ffffff",
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#6941c6",
													"success": "#027a48",
													"warning": "#b54708",
													"danger": "#b42318",
													"info": "#175cd3",
													"neutral": "#344054"
												},
												"default": "#6941c6"
											}
										},
										"boxShadow": "0 1px 2px rgba(16, 24, 40, 0.05)"
									},
									"else": {
										"background": "transparent",
										"color": "#475467"
									}
								}
							}
						]
					}
				},
				"children": [
					"{labelB}"
				]
			},
			{
				"tag": "button",
				"props": {
					"type": "button",
					"style": {
						"ttMerge": [
							{
								"height": "36px",
								"padding": "0 14px",
								"display": "inline-flex",
								"alignItems": "center",
								"justifyContent": "center",
								"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
								"fontSize": "14px",
								"fontWeight": 600,
								"border": "none",
								"cursor": "pointer",
								"borderRadius": "6px"
							},
							{
								"ttIf": {
									"arg": "active",
									"equals": "3",
									"then": {
										"background": "#ffffff",
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#6941c6",
													"success": "#027a48",
													"warning": "#b54708",
													"danger": "#b42318",
													"info": "#175cd3",
													"neutral": "#344054"
												},
												"default": "#6941c6"
											}
										},
										"boxShadow": "0 1px 2px rgba(16, 24, 40, 0.05)"
									},
									"else": {
										"background": "transparent",
										"color": "#475467"
									}
								}
							}
						]
					}
				},
				"children": [
					"{labelC}"
				]
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "choice-controls",
		"variant": "toggle-group",
		"tranche": 1
	}
}
