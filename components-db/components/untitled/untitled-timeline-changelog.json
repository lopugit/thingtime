{
	"slug": "untitled-timeline-changelog",
	"name": "Changelog Timeline",
	"library": "untitled",
	"category": "data-display",
	"description": "Changelog timeline in the Untitled UI style — mono version chips on a tone tint head each entry, with a date mark and a muted release summary.",
	"tags": [
		"timeline",
		"changelog",
		"releases",
		"versions"
	],
	"args": [
		{
			"name": "version",
			"type": "string",
			"default": "2.4",
			"label": "Version",
			"maxLength": 12
		},
		{
			"name": "summary",
			"type": "string",
			"default": "Performance improvements and bug fixes",
			"label": "Summary",
			"maxLength": 80
		},
		{
			"name": "count",
			"type": "number",
			"default": 3,
			"label": "Entries",
			"min": 1,
			"max": 5
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "ul",
		"props": {
			"style": {
				"listStyle": "none",
				"margin": 0,
				"padding": 0,
				"width": "280px",
				"display": "flex",
				"flexDirection": "column",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"color": "#101828"
			}
		},
		"children": [
			{
				"ttRepeat": {
					"arg": "count",
					"max": 5,
					"node": {
						"tag": "li",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "stretch",
								"gap": "14px"
							}
						},
						"children": [
							{
								"tag": "div",
								"props": {
									"style": {
										"display": "flex",
										"flexDirection": "column",
										"alignItems": "center",
										"width": "12px",
										"flexShrink": 0
									}
								},
								"children": [
									{
										"tag": "div",
										"props": {
											"style": {
												"width": "12px",
												"height": "12px",
												"borderRadius": "999px",
												"background": "#98a2b3",
												"marginTop": "5px",
												"flexShrink": 0
											}
										}
									},
									{
										"tag": "div",
										"props": {
											"style": {
												"width": "2px",
												"flexGrow": 1,
												"minHeight": "14px",
												"marginTop": "4px",
												"borderRadius": "999px",
												"background": "#f2f4f7"
											}
										}
									}
								]
							},
							{
								"tag": "div",
								"props": {
									"style": {
										"display": "flex",
										"flexDirection": "column",
										"gap": "2px",
										"paddingBottom": "18px",
										"minWidth": 0
									}
								},
								"children": [
									{
										"tag": "div",
										"props": {
											"style": {
												"display": "flex",
												"alignItems": "center",
												"gap": "8px"
											}
										},
										"children": [
											{
												"tag": "span",
												"props": {
													"style": {
														"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
														"fontSize": "12px",
														"fontWeight": 600,
														"padding": "2px 8px",
														"borderRadius": "999px",
														"background": {
															"ttMap": {
																"arg": "tone",
																"values": {
																	"primary": "#f9f5ff",
																	"success": "#ecfdf3",
																	"warning": "#fffaeb",
																	"danger": "#fef3f2",
																	"info": "#eff8ff",
																	"neutral": "#f2f4f7"
																},
																"default": "#f9f5ff"
															}
														},
														"color": {
															"ttMap": {
																"arg": "tone",
																"values": {
																	"primary": "#6941c6",
																	"success": "#027a48",
																	"warning": "#b54708",
																	"danger": "#b42318",
																	"info": "#175cd3",
																	"neutral": "#344054"
																},
																"default": "#6941c6"
															}
														},
														"borderWidth": "1px",
														"borderStyle": "solid",
														"borderColor": {
															"ttMap": {
																"arg": "tone",
																"values": {
																	"primary": "#e9d7fe",
																	"success": "#a6f4c5",
																	"warning": "#fedf89",
																	"danger": "#fecdca",
																	"info": "#b2ddff",
																	"neutral": "#d0d5dd"
																},
																"default": "#e9d7fe"
															}
														}
													}
												},
												"children": [
													"v{version}.{n}"
												]
											},
											{
												"tag": "span",
												"props": {
													"style": {
														"color": "#98a2b3",
														"fontSize": "12px"
													}
												},
												"children": [
													"Aug {n}"
												]
											}
										]
									},
									{
										"tag": "span",
										"props": {
											"style": {
												"color": "#475467",
												"fontSize": "14px",
												"marginTop": "2px"
											}
										},
										"children": [
											"{summary}"
										]
									}
								]
							}
						]
					}
				}
			}
		]
	},
	"version": 1,
	"familyKey": "timeline-changelog",
	"source": {
		"kind": "archetype",
		"archetype": "timeline",
		"variant": "changelog",
		"tranche": 1
	}
}
