{
	"slug": "untitled-timeline-activity",
	"name": "Activity Feed Timeline",
	"library": "untitled",
	"category": "data-display",
	"description": "Activity feed timeline in the Untitled UI style — initials avatars as markers, a bold actor name before each action, faint timestamps below.",
	"tags": [
		"timeline",
		"activity",
		"feed",
		"avatar"
	],
	"args": [
		{
			"name": "name",
			"type": "string",
			"default": "Alex Rivers",
			"label": "Name",
			"maxLength": 40
		},
		{
			"name": "initials",
			"type": "string",
			"default": "AR",
			"label": "Initials",
			"maxLength": 3
		},
		{
			"name": "action",
			"type": "string",
			"default": "commented on your post",
			"label": "Action",
			"maxLength": 60
		},
		{
			"name": "count",
			"type": "number",
			"default": 3,
			"label": "Entries",
			"min": 1,
			"max": 6
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "ul",
		"props": {
			"style": {
				"listStyle": "none",
				"margin": 0,
				"padding": 0,
				"width": "280px",
				"display": "flex",
				"flexDirection": "column",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"color": "#101828"
			}
		},
		"children": [
			{
				"ttRepeat": {
					"arg": "count",
					"max": 6,
					"node": {
						"tag": "li",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "stretch",
								"gap": "14px"
							}
						},
						"children": [
							{
								"tag": "div",
								"props": {
									"style": {
										"display": "flex",
										"flexDirection": "column",
										"alignItems": "center",
										"width": "30px",
										"flexShrink": 0
									}
								},
								"children": [
									{
										"tag": "div",
										"props": {
											"style": {
												"width": "30px",
												"height": "30px",
												"borderRadius": "999px",
												"background": {
													"ttMap": {
														"arg": "tone",
														"values": {
															"primary": "#f9f5ff",
															"success": "#ecfdf3",
															"warning": "#fffaeb",
															"danger": "#fef3f2",
															"info": "#eff8ff",
															"neutral": "#f2f4f7"
														},
														"default": "#f9f5ff"
													}
												},
												"color": {
													"ttMap": {
														"arg": "tone",
														"values": {
															"primary": "#6941c6",
															"success": "#027a48",
															"warning": "#b54708",
															"danger": "#b42318",
															"info": "#175cd3",
															"neutral": "#344054"
														},
														"default": "#6941c6"
													}
												},
												"display": "flex",
												"alignItems": "center",
												"justifyContent": "center",
												"fontWeight": 600,
												"fontSize": "12px",
												"flexShrink": 0
											}
										},
										"children": [
											"{initials}"
										]
									},
									{
										"tag": "div",
										"props": {
											"style": {
												"width": "2px",
												"flexGrow": 1,
												"minHeight": "14px",
												"marginTop": "4px",
												"borderRadius": "999px",
												"background": "#f2f4f7"
											}
										}
									}
								]
							},
							{
								"tag": "div",
								"props": {
									"style": {
										"display": "flex",
										"flexDirection": "column",
										"gap": "2px",
										"paddingBottom": "18px",
										"minWidth": 0
									}
								},
								"children": [
									{
										"tag": "span",
										"props": {
											"style": {
												"fontSize": "14px",
												"lineHeight": 1.5,
												"marginTop": "5px"
											}
										},
										"children": [
											{
												"tag": "strong",
												"props": {
													"style": {
														"fontWeight": 600
													}
												},
												"children": [
													"{name}"
												]
											},
											" {action}"
										]
									},
									{
										"tag": "span",
										"props": {
											"style": {
												"color": "#98a2b3",
												"fontSize": "12px"
											}
										},
										"children": [
											"{n}h ago"
										]
									}
								]
							}
						]
					}
				}
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "timeline",
		"variant": "activity",
		"tranche": 1
	}
}
