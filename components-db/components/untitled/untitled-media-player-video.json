	"library": "untitled",
	"category": "media",
	"description": "Dark 16:9 video frame in the Untitled UI style — centered translucent play button, bottom scrubber with faint buffered and tone-colored played layers, plus a monospaced time chip.",
	"tags": [
		"media",
		"video",
		"player",
		"scrubber"
