											"height": 11,
											"viewBox": "0 0 24 24",
											"fill": "none",
											"stroke": "currentColor",
											"strokeWidth": 2,
											"strokeLinecap": "round",
											"strokeLinejoin": "round",
											"xmlns": "http://www.w3.org/2000/svg"
										},
										"children": [
											{
												"tag": "line",
												"props": {
													"x1": 12,
													"y1": 19,
													"x2": 12,
													"y2": 5
												}
											},
											{
												"tag": "polyline",
												"props": {
													"points": "5 12 12 5 19 12"
												}
											}
										]
									},
									"else": {
										"tag": "svg",
										"props": {
											"width": 11,
											"height": 11,
											"viewBox": "0 0 24 24",
											"fill": "none",
											"stroke": "currentColor",
											"strokeWidth": 2,
											"strokeLinecap": "round",
											"strokeLinejoin": "round",
											"xmlns": "http://www.w3.org/2000/svg"
										},
										"children": [
											{
												"tag": "line",
												"props": {
													"x1": 12,
													"y1": 5,
													"x2": 12,
													"y2": 19
												}
											},
											{
												"tag": "polyline",
												"props": {
													"points": "19 12 12 19 5 12"
												}
											}
										]
									}
								}
							},
							"8% vs last week"
						]
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "flex-end",
						"gap": "6px",
						"height": "52px"
					}
				},
				"children": [
					{
						"ttRepeat": {
							"count": 6,
							"max": 6,
							"node": {
								"tag": "div",
								"props": {
									"style": {
										"flex": "1",
										"borderRadius": "6px",
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#f9f5ff",
													"success": "#ecfdf3",
													"warning": "#fffaeb",
													"danger": "#fef3f2",
													"info": "#eff8ff",
													"neutral": "#f2f4f7"
												},
												"default": "#f9f5ff"
											}
										},
										"height": {
											"ttMap": {
												"arg": "index",
												"values": {
													"0": "18px",
													"1": "30px",
													"2": "24px",
													"3": "40px",
													"4": "28px",
													"5": "34px"
												},
												"default": "24px"
											}
										}
									}
								}
							}
						}
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"flex": "1",
								"borderRadius": "6px",
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#7f56d9",
											"success": "#12b76a",
											"warning": "#f79009",
											"danger": "#f04438",
											"info": "#2e90fa",
											"neutral": "#344054"
										},
										"default": "#7f56d9"
									}
								},
								"height": "46px"
							}
						}
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "smart-home-energy",
	"source": {
		"kind": "archetype",
		"archetype": "smart-home",
		"variant": "energy",
		"tranche": 2
	}
