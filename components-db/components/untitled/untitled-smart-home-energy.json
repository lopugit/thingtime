{
	"slug": "untitled-smart-home-energy",
	"name": "Energy Usage Card",
	"library": "untitled",
	"category": "iot",
	"description": "Home energy card in the Untitled UI style — today's kWh and cost beside a week of mini bars with today rendered solid, and a vs-last-week trend chip that flips tone with direction.",
	"tags": [
		"smart-home",
		"iot",
		"energy",
		"usage",
		"chart"
	],
	"args": [
		{
			"name": "kwh",
			"type": "string",
			"default": "12.4",
			"label": "kWh today",
			"maxLength": 8
		},
		{
			"name": "cost",
			"type": "string",
			"default": "$3.86",
			"label": "Cost",
			"maxLength": 10
		},
		{
			"name": "up",
			"type": "boolean",
			"default": false,
			"label": "Usage up"
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"boxSizing": "border-box",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"background": "#ffffff",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "#eaecf0",
				"borderRadius": "12px",
				"boxShadow": "0 1px 2px rgba(16, 24, 40, 0.05)",
				"width": "270px",
				"padding": "16px",
				"gap": "12px"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "flex-start",
						"justifyContent": "space-between",
						"gap": "10px"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"flexDirection": "column",
								"gap": "2px"
							}
						},
						"children": [
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "18px",
										"fontWeight": 600,
										"color": "#101828"
									}
								},
								"children": [
									"{kwh} kWh"
								]
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "12px",
										"color": "#475467"
									}
								},
								"children": [
									"{cost} today"
								]
							}
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"display": "inline-flex",
								"alignItems": "center",
								"gap": "4px",
								"padding": "3px 8px",
								"borderRadius": "999px",
								"fontSize": "12px",
								"fontWeight": 600,
								"whiteSpace": "nowrap",
								"background": {
									"ttIf": {
										"arg": "up",
										"then": "#fef3f2",
										"else": "#ecfdf3"
									}
								},
								"color": {
									"ttIf": {
										"arg": "up",
										"then": "#b42318",
										"else": "#027a48"
									}
								}
							}
						},
						"children": [
							{
								"ttIf": {
									"arg": "up",
