{
	"slug": "untitled-empty-states-onboarding",
	"name": "Onboarding CTA",
	"library": "untitled",
	"category": "feedback",
	"description": "Onboarding call-to-action panel in the Untitled UI style — welcome heading, numbered step dots hinting at the setup flow, and a solid tone start button.",
	"tags": [
		"onboarding",
		"empty-state",
		"steps",
		"cta"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Welcome to your workspace",
			"label": "Title",
			"maxLength": 50
		},
		{
			"name": "body",
			"type": "text",
			"default": "A few quick steps and you’re up and running.",
			"label": "Body"
		},
		{
			"name": "ctaLabel",
			"type": "string",
			"default": "Start setup",
			"label": "CTA label",
			"maxLength": 32
		},
		{
			"name": "steps",
			"type": "number",
			"default": 3,
			"label": "Steps",
			"min": 2,
			"max": 6
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"alignItems": "center",
				"justifyContent": "center",
				"textAlign": "center",
				"gap": "6px",
				"width": "360px",
				"padding": "40px 28px",
				"background": "#ffffff",
				"borderRadius": "12px",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"color": "#101828",
				"border": "1px solid #eaecf0",
				"boxShadow": "0 12px 16px -4px rgba(16, 24, 40, 0.08), 0 4px 6px -2px rgba(16, 24, 40, 0.03)"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"width": "46px",
						"height": "46px",
						"borderRadius": "999px",
						"background": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#f9f5ff",
									"success": "#ecfdf3",
									"warning": "#fffaeb",
									"danger": "#fef3f2",
									"info": "#eff8ff",
									"neutral": "#f2f4f7"
								},
								"default": "#f9f5ff"
							}
						},
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#6941c6",
									"success": "#027a48",
									"warning": "#b54708",
									"danger": "#b42318",
									"info": "#175cd3",
									"neutral": "#344054"
								},
								"default": "#6941c6"
							}
						},
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "center",
						"marginBottom": "4px"
					}
				},
				"children": [
					{
						"tag": "svg",
						"props": {
							"width": 20,
							"height": 20,
							"viewBox": "0 0 24 24",
							"fill": "none",
							"stroke": "currentColor",
							"strokeWidth": 2,
							"strokeLinecap": "round",
							"strokeLinejoin": "round",
							"xmlns": "http://www.w3.org/2000/svg"
						},
						"children": [
							{
								"tag": "polygon",
								"props": {
									"points": "13 2 3 14 12 14 11 22 21 10 12 10 13 2"
								}
							}
						]
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontWeight": 600,
						"fontSize": "18px"
					}
				},
				"children": [
					"{title}"
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "14px",
						"color": "#475467",
						"lineHeight": 1.5,
						"maxWidth": "270px"
					}
				},
				"children": [
					"{body}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "8px",
						"marginTop": "10px",
						"justifyContent": "center"
					}
				},
				"children": [
					{
						"ttRepeat": {
							"arg": "steps",
							"max": 6,
							"node": {
								"tag": "div",
								"props": {
									"style": {
										"width": "24px",
										"height": "24px",
										"borderRadius": "999px",
										"display": "flex",
										"alignItems": "center",
										"justifyContent": "center",
										"fontSize": "12px",
										"fontWeight": 600,
										"background": {
											"ttIf": {
												"arg": "n",
												"equals": 1,
												"then": {
													"ttMap": {
														"arg": "tone",
														"values": {
															"primary": "#7f56d9",
															"success": "#12b76a",
															"warning": "#f79009",
															"danger": "#f04438",
															"info": "#2e90fa",
															"neutral": "#344054"
														},
														"default": "#7f56d9"
													}
												},
												"else": "#f9fafb"
											}
										},
										"color": {
											"ttIf": {
												"arg": "n",
												"equals": 1,
												"then": {
													"ttMap": {
														"arg": "tone",
														"values": {
															"primary": "#ffffff",
															"success": "#ffffff",
															"warning": "#ffffff",
															"danger": "#ffffff",
															"info": "#ffffff",
															"neutral": "#ffffff"
														},
														"default": "#ffffff"
													}
												},
												"else": "#475467"
											}
										}
									}
								},
								"children": [
									"{n}"
								]
							}
						}
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "12px",
						"color": "#98a2b3"
					}
				},
				"children": [
					"Step 1 of {steps}"
				]
			},
			{
				"tag": "button",
				"props": {
					"type": "button",
					"style": {
						"display": "inline-flex",
						"alignItems": "center",
						"justifyContent": "center",
						"height": "40px",
						"padding": "0 18px",
						"border": "none",
						"borderRadius": "8px",
						"background": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#7f56d9",
									"success": "#12b76a",
									"warning": "#f79009",
									"danger": "#f04438",
									"info": "#2e90fa",
									"neutral": "#344054"
								},
								"default": "#7f56d9"
							}
						},
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#ffffff",
									"success": "#ffffff",
									"warning": "#ffffff",
									"danger": "#ffffff",
									"info": "#ffffff",
									"neutral": "#ffffff"
								},
								"default": "#ffffff"
							}
						},
						"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
						"fontSize": "14px",
						"fontWeight": 600,
						"boxShadow": "0 1px 2px rgba(16, 24, 40, 0.05)",
						"cursor": "pointer",
						"marginTop": "8px"
					}
				},
				"children": [
					"{ctaLabel}"
				]
			}
		]
	},
	"previewBg": "#f9fafb",
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "empty-states",
		"variant": "onboarding",
		"tranche": 1
	}
}
