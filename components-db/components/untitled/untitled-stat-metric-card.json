{
	"slug": "untitled-stat-metric-card",
	"name": "Stat Card",
	"library": "untitled",
	"category": "data-display",
	"description": "Single-metric stat card in the Untitled UI style — quiet label, large tabular value, and a tinted delta pill on Untitled UI surface, border, and radius tokens.",
	"tags": [
		"stat",
		"metric",
		"card",
		"kpi"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Monthly revenue",
			"label": "Label",
			"maxLength": 40
		},
		{
			"name": "value",
			"type": "string",
			"default": "$48,210",
			"label": "Value",
			"maxLength": 20
		},
		{
			"name": "delta",
			"type": "string",
			"default": "+12.4%",
			"label": "Delta",
			"maxLength": 12
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "success",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "inline-flex",
				"flexDirection": "column",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"background": "#ffffff",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "#eaecf0",
				"borderRadius": "12px",
				"boxShadow": "0 1px 2px rgba(16, 24, 40, 0.05)",
				"boxSizing": "border-box",
				"padding": "16px 20px",
				"gap": "6px",
				"minWidth": "200px"
			}
		},
		"children": [
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "12px",
						"fontWeight": 500,
						"color": "#475467"
					}
				},
				"children": [
					"{label}"
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "24px",
						"fontWeight": 600,
						"color": "#101828",
						"lineHeight": 1.15,
						"fontVariantNumeric": "tabular-nums"
					}
				},
				"children": [
					"{value}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "8px",
						"marginTop": "2px"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"display": "inline-flex",
								"alignItems": "center",
								"padding": "2px 8px",
								"borderRadius": "999px",
								"fontSize": "12px",
								"fontWeight": 600,
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#f9f5ff",
											"success": "#ecfdf3",
											"warning": "#fffaeb",
											"danger": "#fef3f2",
											"info": "#eff8ff",
											"neutral": "#f2f4f7"
										},
										"default": "#ecfdf3"
									}
								},
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#6941c6",
											"success": "#027a48",
											"warning": "#b54708",
											"danger": "#b42318",
											"info": "#175cd3",
											"neutral": "#344054"
										},
										"default": "#027a48"
									}
								},
								"borderWidth": "1px",
								"borderStyle": "solid",
								"borderColor": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#e9d7fe",
											"success": "#a6f4c5",
											"warning": "#fedf89",
											"danger": "#fecdca",
											"info": "#b2ddff",
											"neutral": "#d0d5dd"
										},
										"default": "#a6f4c5"
									}
								}
							}
						},
						"children": [
							"{delta}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "12px",
								"color": "#98a2b3"
							}
						},
						"children": [
							"vs last month"
						]
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "stat-metric-card",
	"source": {
		"kind": "archetype",
		"archetype": "stat-metric",
		"variant": "card",
		"tranche": 1
	}
}
