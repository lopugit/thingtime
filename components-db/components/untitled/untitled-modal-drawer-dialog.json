{
	"slug": "untitled-modal-drawer-dialog",
	"name": "Dialog Modal",
	"library": "untitled",
	"category": "overlays",
	"description": "Centered dialog on a dimmed backdrop in the Untitled UI style — title with a close glyph, muted body copy, and cancel/confirm actions footed to the right.",
	"tags": [
		"modal",
		"dialog",
		"overlay",
		"actions"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Update available",
			"label": "Title",
			"maxLength": 40
		},
		{
			"name": "body",
			"type": "text",
			"default": "A new version of the workspace is ready to install. You can update now or do it later.",
			"label": "Body",
			"maxLength": 200
		},
		{
			"name": "confirmLabel",
			"type": "string",
			"default": "Update now",
			"label": "Confirm label",
			"maxLength": 24
		},
		{
			"name": "cancelLabel",
			"type": "string",
			"default": "Later",
			"label": "Cancel label",
			"maxLength": 24
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
