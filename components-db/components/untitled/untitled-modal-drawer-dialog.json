							"style": {
								"display": "flex",
								"alignItems": "center",
								"justifyContent": "flex-end",
								"gap": "8px",
								"padding": "0 16px 16px"
							}
						},
						"children": [
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"display": "inline-flex",
										"alignItems": "center",
										"justifyContent": "center",
										"height": "36px",
										"padding": "0 14px",
										"borderRadius": "8px",
										"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
										"fontSize": "14px",
										"fontWeight": 600,
										"cursor": "pointer",
										"borderWidth": "1px",
										"borderStyle": "solid",
										"borderColor": "#eaecf0",
										"background": "#ffffff",
										"color": "#101828"
									}
								},
								"children": [
									"{cancelLabel}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"display": "inline-flex",
										"alignItems": "center",
										"justifyContent": "center",
										"height": "36px",
										"padding": "0 14px",
										"borderRadius": "8px",
										"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
										"fontSize": "14px",
										"fontWeight": 600,
										"cursor": "pointer",
										"border": "none",
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#7f56d9",
													"success": "#12b76a",
													"warning": "#f79009",
													"danger": "#f04438",
													"info": "#2e90fa",
													"neutral": "#344054"
												},
												"default": "#7f56d9"
											}
										},
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#ffffff",
													"success": "#ffffff",
													"warning": "#ffffff",
													"danger": "#ffffff",
													"info": "#ffffff",
													"neutral": "#ffffff"
												},
												"default": "#ffffff"
											}
										},
										"boxShadow": "0 1px 2px rgba(16, 24, 40, 0.05)"
									}
								},
								"children": [
