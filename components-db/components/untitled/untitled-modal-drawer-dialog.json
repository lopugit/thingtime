		"props": {
			"style": {
				"display": "flex",
				"width": "340px",
				"minHeight": "280px",
				"boxSizing": "border-box",
				"background": "rgba(12, 12, 16, 0.45)",
				"borderRadius": "8px",
				"overflow": "hidden",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"alignItems": "center",
				"justifyContent": "center",
				"padding": "24px"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"background": "#ffffff",
						"color": "#101828",
						"borderRadius": "12px",
						"boxShadow": "0 12px 16px -4px rgba(16, 24, 40, 0.08), 0 4px 6px -2px rgba(16, 24, 40, 0.03)",
