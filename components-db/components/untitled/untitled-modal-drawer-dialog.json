						},
						"children": [
							{
								"tag": "h3",
								"props": {
									"style": {
										"margin": 0,
										"fontSize": "16px",
										"fontWeight": 600
									}
								},
								"children": [
									"{title}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"border": "none",
										"background": "transparent",
										"color": "#98a2b3",
										"cursor": "pointer",
										"padding": "4px",
										"display": "inline-flex",
										"alignItems": "center",
										"justifyContent": "center",
										"borderRadius": "8px",
										"flexShrink": 0
