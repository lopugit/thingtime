{
	"slug": "untitled-security-privacy-vault-row",
	"name": "Vault Password Row",
	"library": "untitled",
	"category": "security",
	"description": "Password-manager vault row in the Untitled UI style — favicon initial tile, site and username captions, a strength dot, last-changed note, copy/reveal ghosts, and a reused-password warning chip.",
	"tags": [
		"security",
		"password",
		"vault",
		"row"
	],
	"args": [
		{
			"name": "site",
			"type": "string",
			"default": "github.com",
			"label": "Site",
			"maxLength": 40
		},
		{
			"name": "initial",
			"type": "string",
			"default": "G",
			"label": "Favicon initial",
			"maxLength": 2
		},
		{
			"name": "username",
			"type": "string",
			"default": "nikolaj@thingtime.com",
			"label": "Username",
			"maxLength": 60
		},
		{
			"name": "strength",
			"type": "enum",
			"values": [
				"weak",
				"fair",
				"strong"
			],
			"default": "strong",
			"label": "Strength"
		},
		{
			"name": "reused",
			"type": "boolean",
			"default": false,
			"label": "Reused password"
		},
		{
			"name": "changed",
			"type": "string",
			"default": "3 mo ago",
			"label": "Last changed",
			"maxLength": 20
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"alignItems": "center",
				"gap": "12px",
				"width": "400px",
				"boxSizing": "border-box",
				"padding": "10px 14px",
				"background": "#ffffff",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "#eaecf0",
				"borderRadius": "8px",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"boxShadow": "0 12px 16px -4px rgba(16, 24, 40, 0.08), 0 4px 6px -2px rgba(16, 24, 40, 0.03)"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"width": "36px",
						"height": "36px",
						"borderRadius": "8px",
						"background": "#f9f5ff",
						"color": "#6941c6",
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "center",
						"fontWeight": 600,
						"fontSize": "14px",
						"flexShrink": 0
					}
				},
				"children": [
					"{initial}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"gap": "2px",
						"minWidth": 0,
						"flex": 1
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"gap": "8px"
							}
						},
						"children": [
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "14px",
										"fontWeight": 600,
										"color": "#101828"
									}
								},
								"children": [
									"{site}"
								]
							},
							{
								"ttIf": {
									"arg": "reused",
									"then": {
										"tag": "span",
										"props": {
											"style": {
												"background": "#fffaeb",
												"color": "#b54708",
												"fontSize": "12px",
												"fontWeight": 600,
												"padding": "1px 8px",
												"borderRadius": "999px",
												"whiteSpace": "nowrap"
											}
										},
										"children": [
											"Reused"
										]
									}
								}
							}
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "12px",
								"color": "#475467"
							}
						},
						"children": [
							"{username}"
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"gap": "6px"
							}
						},
						"children": [
							{
								"tag": "span",
								"props": {
									"style": {
										"width": "7px",
										"height": "7px",
										"borderRadius": "999px",
										"background": {
											"ttMap": {
												"arg": "strength",
												"values": {
													"weak": "#f04438",
													"fair": "#f79009",
													"strong": "#12b76a"
												},
												"default": "#12b76a"
											}
										},
										"flexShrink": 0
									}
								}
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "12px",
										"fontWeight": 600,
										"color": {
											"ttMap": {
												"arg": "strength",
												"values": {
													"weak": "#f04438",
													"fair": "#f79009",
													"strong": "#12b76a"
												},
												"default": "#12b76a"
											}
										},
										"textTransform": "capitalize"
									}
								},
								"children": [
									"{strength}"
								]
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "12px",
										"color": "#98a2b3"
									}
								},
								"children": [
									"· Updated {changed}"
								]
							}
						]
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "2px",
						"marginLeft": "auto",
						"flexShrink": 0
					}
				},
				"children": [
					{
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"background": "transparent",
								"border": "none",
								"color": "#475467",
								"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
								"fontSize": "12px",
								"fontWeight": 600,
								"cursor": "pointer",
								"padding": "4px 8px",
								"borderRadius": "8px",
								"whiteSpace": "nowrap"
							}
						},
						"children": [
							"Copy"
						]
					},
					{
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"background": "transparent",
								"border": "none",
								"color": "#7f56d9",
								"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
								"fontSize": "12px",
								"fontWeight": 600,
								"cursor": "pointer",
								"padding": "4px 8px",
								"borderRadius": "8px",
								"whiteSpace": "nowrap"
							}
						},
						"children": [
							"Reveal"
						]
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "security-privacy-vault-row",
	"source": {
		"kind": "archetype",
		"archetype": "security-privacy",
		"variant": "vault-row",
		"tranche": 2
	}
}
