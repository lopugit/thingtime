								},
								"children": [
									{
										"ttRepeat": {
											"arg": "rating",
											"max": 5,
											"node": {
												"tag": "svg",
												"props": {
													"width": 14,
													"height": 14,
													"viewBox": "0 0 24 24",
													"fill": "#f79009",
													"stroke": "#f79009",
													"strokeWidth": 2,
													"strokeLinejoin": "round",
													"xmlns": "http://www.w3.org/2000/svg"
												},
												"children": [
													{
														"tag": "polygon",
														"props": {
															"points": "12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26"
														}
													}
												]
											}
										}
									}
								]
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "12px",
										"color": "#475467"
									}
								},
								"children": [
									"({reviews})"
								]
							}
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"justifyContent": "space-between",
								"marginTop": "4px"
							}
						},
						"children": [
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "16px",
										"fontWeight": 700,
										"color": "#101828"
									}
								},
								"children": [
									"{price}"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"display": "inline-flex",
										"alignItems": "center",
										"justifyContent": "center",
										"gap": "6px",
										"border": "none",
										"borderRadius": "8px",
										"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
										"fontWeight": 600,
										"cursor": "pointer",
										"height": "36px",
										"padding": "0 12px",
										"fontSize": "12px",
										"background": "#7f56d9",
										"color": "#ffffff"
