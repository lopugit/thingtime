{
	"slug": "untitled-commerce-product-card",
	"name": "Product Card",
	"library": "untitled",
	"category": "commerce",
	"description": "Product tile in the Untitled UI style — image placeholder with an optional sale pill, star rating with review count, price line and an add-to-cart action on library-native corners.",
	"tags": [
		"commerce",
		"product",
		"card",
		"shop"
	],
	"args": [
		{
			"name": "name",
			"type": "string",
			"default": "Aurora Headphones",
			"label": "Product name",
			"maxLength": 40
		},
		{
			"name": "price",
			"type": "string",
			"default": "$129",
			"label": "Price",
			"maxLength": 12
		},
		{
			"name": "onSale",
			"type": "boolean",
			"default": true,
			"label": "On sale"
		},
		{
			"name": "rating",
			"type": "number",
			"default": 4,
			"label": "Stars (0-5)"
		},
		{
			"name": "reviews",
			"type": "string",
			"default": "128",
			"label": "Review count",
			"maxLength": 8
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"width": "240px",
				"background": "#ffffff",
				"border": "1px solid #eaecf0",
				"borderRadius": "12px",
				"boxShadow": "0 1px 2px rgba(16, 24, 40, 0.05)",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"overflow": "hidden"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"position": "relative",
						"height": "132px",
						"background": "#f9fafb",
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "center"
					}
				},
				"children": [
					{
						"tag": "svg",
						"props": {
							"width": 30,
							"height": 30,
							"viewBox": "0 0 24 24",
							"fill": "none",
							"stroke": "#98a2b3",
							"strokeWidth": 2,
							"strokeLinecap": "round",
							"strokeLinejoin": "round",
							"xmlns": "http://www.w3.org/2000/svg"
						},
						"children": [
							{
								"tag": "rect",
								"props": {
									"x": 3,
									"y": 3,
									"width": 18,
									"height": 18,
									"rx": 2
								}
							},
							{
								"tag": "circle",
								"props": {
									"cx": 8.5,
									"cy": 8.5,
									"r": 1.5
								}
							},
							{
								"tag": "polyline",
								"props": {
									"points": "21 15 16 10 5 21"
								}
							}
						]
					},
					{
						"ttIf": {
							"arg": "onSale",
							"then": {
								"tag": "span",
								"props": {
									"style": {
										"position": "absolute",
										"top": "10px",
										"left": "10px",
										"padding": "2px 10px",
										"borderRadius": "999px",
										"background": "#f04438",
										"color": "#ffffff",
										"fontSize": "12px",
										"fontWeight": 700
									}
								},
								"children": [
									"Sale"
								]
							}
						}
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"padding": "14px",
						"gap": "8px"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "14px",
								"fontWeight": 600,
								"color": "#101828"
							}
						},
						"children": [
							"{name}"
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"gap": "6px"
							}
						},
						"children": [
							{
								"tag": "div",
