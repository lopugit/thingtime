								},
								"children": [
									{
										"tag": "svg",
										"props": {
											"width": 13,
											"height": 13,
											"viewBox": "0 0 24 24",
											"fill": "none",
											"stroke": "currentColor",
											"strokeWidth": 2,
											"strokeLinecap": "round",
											"strokeLinejoin": "round",
											"xmlns": "http://www.w3.org/2000/svg"
										},
										"children": [
											{
												"tag": "line",
												"props": {
													"x1": 12,
													"y1": 5,
													"x2": 12,
													"y2": 19
												}
											},
											{
												"tag": "line",
												"props": {
													"x1": 5,
													"y1": 12,
													"x2": 19,
													"y2": 12
												}
											}
										]
									},
									"Add"
								]
							}
						]
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "commerce-product-card",
	"source": {
		"kind": "archetype",
		"archetype": "commerce",
		"variant": "product-card",
		"tranche": 2
	}
}
