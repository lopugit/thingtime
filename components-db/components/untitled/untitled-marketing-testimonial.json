{
	"slug": "untitled-marketing-testimonial",
	"name": "Testimonial Card",
	"library": "untitled",
	"category": "marketing",
	"description": "Customer testimonial in the Untitled UI style — star rating, quoted praise, and an initials avatar with name and role.",
	"tags": [
		"marketing",
		"testimonial",
		"quote",
		"social-proof"
	],
	"args": [
		{
			"name": "quote",
			"type": "text",
			"default": "This replaced four tools on day one — easily the calmest software we use.",
			"label": "Quote",
			"maxLength": 200
		},
		{
			"name": "name",
			"type": "string",
			"default": "Maya Chen",
			"label": "Name",
			"maxLength": 40
		},
		{
			"name": "role",
			"type": "string",
			"default": "Head of Product, Northwind",
			"label": "Role",
			"maxLength": 60
		},
		{
			"name": "initials",
			"type": "string",
			"default": "MC",
			"label": "Initials",
			"maxLength": 3
		},
		{
			"name": "stars",
			"type": "number",
			"default": 5,
			"label": "Stars",
			"min": 0,
			"max": 5
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"background": "#ffffff",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "#eaecf0",
				"borderRadius": "12px",
				"boxShadow": "0 1px 2px rgba(16, 24, 40, 0.05)",
				"boxSizing": "border-box",
				"padding": "20px 22px",
				"gap": "12px",
				"maxWidth": "360px"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "3px"
					}
				},
				"children": [
					{
						"ttRepeat": {
							"arg": "stars",
							"max": 5,
							"node": {
								"tag": "svg",
								"props": {
									"width": 15,
									"height": 15,
									"viewBox": "0 0 24 24",
									"fill": "#f79009",
									"stroke": "#f79009",
									"strokeWidth": 2,
									"strokeLinejoin": "round",
									"xmlns": "http://www.w3.org/2000/svg"
								},
								"children": [
									{
										"tag": "polygon",
										"props": {
											"points": "12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26"
										}
									}
								]
							}
						}
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "16px",
						"color": "#101828",
						"lineHeight": 1.55
					}
				},
				"children": [
					"“{quote}”"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "10px",
						"marginTop": "2px"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"width": 38,
								"height": 38,
								"borderRadius": "999px",
								"background": "#f9f5ff",
								"color": "#6941c6",
								"display": "flex",
								"alignItems": "center",
								"justifyContent": "center",
								"fontWeight": 600,
								"fontSize": "14px",
								"flexShrink": 0
							}
						},
						"children": [
							"{initials}"
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"flexDirection": "column",
								"gap": "2px"
							}
						},
						"children": [
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "14px",
										"fontWeight": 600,
										"color": "#101828"
									}
								},
								"children": [
									"{name}"
								]
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "12px",
										"color": "#475467"
									}
								},
								"children": [
									"{role}"
								]
							}
						]
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "marketing-testimonial",
	"source": {
		"kind": "archetype",
		"archetype": "marketing",
		"variant": "testimonial",
		"tranche": 1
	}
}
