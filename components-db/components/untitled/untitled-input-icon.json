{
	"slug": "untitled-input-icon",
	"name": "Icon Input",
	"library": "untitled",
	"category": "forms",
	"description": "Search field with a leading icon in the Untitled UI style — muted magnifier inside the field chrome, plus an optional mono shortcut chip.",
	"tags": [
		"input",
		"icon",
		"search",
		"form"
	],
	"args": [
		{
			"name": "placeholder",
			"type": "string",
			"default": "Search…",
			"label": "Placeholder",
			"maxLength": 60
		},
		{
			"name": "size",
			"type": "enum",
			"values": [
				"sm",
				"md",
				"lg"
			],
			"default": "md",
			"label": "Size"
		},
		{
			"name": "shortcut",
			"type": "boolean",
			"default": true,
			"label": "Shortcut chip"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"ttMerge": [
					{
						"display": "flex",
						"alignItems": "center",
						"gap": "8px",
						"width": "260px",
						"padding": "0 10px",
						"border": "1px solid #eaecf0",
						"borderRadius": "8px",
						"background": "#ffffff",
						"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
						"boxSizing": "border-box",
						"boxShadow": "0 1px 2px rgba(16, 24, 40, 0.05)"
					},
					{
						"ttMap": {
							"arg": "size",
							"values": {
								"sm": {
									"height": "36px",
									"fontSize": "14px"
								},
								"md": {
									"height": "40px",
									"fontSize": "14px"
								},
								"lg": {
									"height": "44px",
									"fontSize": "16px"
								}
							},
							"default": {
								"height": "40px",
								"fontSize": "14px"
							}
						}
					}
				]
			}
		},
		"children": [
			{
				"tag": "svg",
				"props": {
					"width": 16,
					"height": 16,
					"viewBox": "0 0 24 24",
					"fill": "none",
					"stroke": "#475467",
					"strokeWidth": 2,
					"strokeLinecap": "round",
					"strokeLinejoin": "round",
					"xmlns": "http://www.w3.org/2000/svg"
				},
				"children": [
					{
						"tag": "circle",
						"props": {
							"cx": 11,
							"cy": 11,
							"r": 7
						}
					},
					{
						"tag": "line",
						"props": {
							"x1": 21,
							"y1": 21,
							"x2": 16.65,
							"y2": 16.65
						}
					}
				]
			},
			{
				"tag": "input",
				"props": {
					"type": "text",
					"placeholder": "{placeholder}",
					"style": {
						"flex": 1,
						"minWidth": 0,
						"border": "none",
						"outline": "none",
						"background": "transparent",
						"padding": 0,
						"color": "#101828",
						"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
						"fontSize": "inherit"
					}
				}
			},
			{
				"ttIf": {
					"arg": "shortcut",
					"then": {
						"tag": "span",
						"props": {
							"style": {
								"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
								"fontSize": "12px",
								"color": "#98a2b3",
								"border": "1px solid #f2f4f7",
								"borderRadius": "6px",
								"padding": "2px 5px",
								"flexShrink": 0
							}
						},
						"children": [
							"⌘K"
						]
					}
				}
			}
		]
	},
	"version": 1,
	"familyKey": "input-icon",
	"source": {
		"kind": "archetype",
		"archetype": "input",
		"variant": "icon",
		"tranche": 1
	}
}
