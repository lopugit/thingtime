{
	"slug": "untitled-card-media",
	"name": "Media Card",
	"library": "untitled",
	"category": "layout",
	"description": "Card with a media block in the Untitled UI style — a tone-gradient placeholder banner over a badge, title and body.",
	"tags": [
		"card",
		"media",
		"image",
		"banner"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Golden hour",
			"label": "Title",
			"maxLength": 60
		},
		{
			"name": "body",
			"type": "text",
			"default": "A placeholder media block stands in for imagery — no external assets needed.",
			"label": "Body"
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "mediaHeight",
			"type": "enum",
			"values": [
				"sm",
				"md",
				"lg"
			],
			"default": "md",
			"label": "Media height"
		},
		{
			"name": "badge",
			"type": "string",
			"default": "New",
			"label": "Badge",
			"maxLength": 20
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"width": "300px",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"background": "#ffffff",
				"color": "#101828",
				"border": "1px solid #eaecf0",
				"borderRadius": "8px",
				"boxShadow": "0 1px 2px rgba(16, 24, 40, 0.05)",
				"overflow": "hidden",
				"boxSizing": "border-box"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"ttMerge": [
							{
								"display": "flex",
								"alignItems": "center",
								"justifyContent": "center",
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "linear-gradient(135deg, #f9f5ff 0%, #e9d7fe 60%, #7f56d9 140%)",
											"success": "linear-gradient(135deg, #ecfdf3 0%, #a6f4c5 60%, #12b76a 140%)",
											"warning": "linear-gradient(135deg, #fffaeb 0%, #fedf89 60%, #f79009 140%)",
											"danger": "linear-gradient(135deg, #fef3f2 0%, #fecdca 60%, #f04438 140%)",
											"info": "linear-gradient(135deg, #eff8ff 0%, #b2ddff 60%, #2e90fa 140%)",
											"neutral": "linear-gradient(135deg, #f2f4f7 0%, #d0d5dd 60%, #344054 140%)"
										},
										"default": "linear-gradient(135deg, #f9f5ff 0%, #e9d7fe 60%, #7f56d9 140%)"
									}
								}
							},
							{
								"ttMap": {
									"arg": "mediaHeight",
									"values": {
										"sm": {
											"height": "72px"
										},
										"md": {
											"height": "112px"
										},
										"lg": {
											"height": "152px"
										}
									},
									"default": {
										"height": "112px"
									}
								}
							}
						]
					}
				},
				"children": [
					{
						"tag": "svg",
						"props": {
							"width": 28,
							"height": 28,
							"viewBox": "0 0 24 24",
							"fill": "none",
							"stroke": {
								"ttMap": {
									"arg": "tone",
									"values": {
										"primary": "#6941c6",
										"success": "#027a48",
										"warning": "#b54708",
										"danger": "#b42318",
										"info": "#175cd3",
										"neutral": "#344054"
									},
									"default": "#6941c6"
								}
							},
							"strokeWidth": 2,
							"strokeLinecap": "round",
							"strokeLinejoin": "round",
							"xmlns": "http://www.w3.org/2000/svg"
						},
						"children": [
							{
								"tag": "rect",
								"props": {
									"x": 3,
									"y": 3,
									"width": 18,
									"height": 18,
									"rx": 2
								}
							},
							{
								"tag": "circle",
								"props": {
									"cx": 8.5,
									"cy": 8.5,
									"r": 1.5
								}
							},
							{
								"tag": "polyline",
								"props": {
									"points": "21 15 16 10 5 21"
								}
							}
						]
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"padding": "16px",
						"gap": "8px"
					}
				},
				"children": [
					{
						"ttIf": {
							"arg": "badge",
							"then": {
								"tag": "span",
								"props": {
									"style": {
										"alignSelf": "flex-start",
										"padding": "2px 8px",
										"borderRadius": "999px",
										"fontSize": "12px",
										"fontWeight": 600,
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#f9f5ff",
													"success": "#ecfdf3",
													"warning": "#fffaeb",
													"danger": "#fef3f2",
													"info": "#eff8ff",
													"neutral": "#f2f4f7"
												},
												"default": "#f9f5ff"
											}
										},
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#6941c6",
													"success": "#027a48",
													"warning": "#b54708",
													"danger": "#b42318",
													"info": "#175cd3",
													"neutral": "#344054"
												},
												"default": "#6941c6"
											}
										},
										"border": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "1px solid #e9d7fe",
													"success": "1px solid #a6f4c5",
													"warning": "1px solid #fedf89",
													"danger": "1px solid #fecdca",
													"info": "1px solid #b2ddff",
													"neutral": "1px solid #d0d5dd"
												},
												"default": "1px solid #e9d7fe"
											}
										}
									}
								},
								"children": [
									"{badge}"
								]
							}
						}
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "16px",
								"fontWeight": 600,
								"color": "#101828"
							}
						},
						"children": [
							"{title}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "14px",
								"color": "#475467",
								"lineHeight": 1.5
							}
						},
						"children": [
							"{body}"
						]
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "card-media",
	"source": {
		"kind": "archetype",
		"archetype": "card",
		"variant": "media",
		"tranche": 1
	}
}
