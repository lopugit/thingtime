{
	"slug": "untitled-sports-scores-scoreboard",
	"name": "Live Scoreboard",
	"library": "untitled",
	"category": "sports",
	"description": "Live match scoreboard in the Untitled UI style — home/away rows with initials tiles and big mono scores, a LIVE chip with period clock, possession dot, and a thin momentum bar.",
	"tags": [
		"sports",
		"scoreboard",
		"live",
		"match"
	],
	"args": [
		{
			"name": "home",
			"type": "string",
			"default": "Falcons",
			"label": "Home team",
			"maxLength": 20
		},
		{
			"name": "away",
			"type": "string",
			"default": "Rovers",
			"label": "Away team",
			"maxLength": 20
		},
		{
			"name": "homeScore",
			"type": "string",
			"default": "2",
			"label": "Home score",
			"maxLength": 3
		},
		{
			"name": "awayScore",
			"type": "string",
			"default": "1",
			"label": "Away score",
			"maxLength": 3
		},
		{
			"name": "clock",
			"type": "string",
			"default": "2nd · 63:12",
			"label": "Period + clock",
			"maxLength": 20
		},
		{
			"name": "possession",
			"type": "enum",
			"values": [
				"home",
				"away"
			],
			"default": "home",
			"label": "Possession"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"boxSizing": "border-box",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"color": "#101828",
				"background": "#ffffff",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "#eaecf0",
				"borderRadius": "12px",
				"boxShadow": "0 1px 2px rgba(16, 24, 40, 0.05)",
				"width": "280px",
				"padding": "14px",
				"gap": "10px"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "space-between",
						"gap": "8px"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"gap": "6px",
								"padding": "2px 8px",
								"borderRadius": "999px",
								"background": "#fef3f2",
								"color": "#b42318",
								"fontSize": "12px",
								"fontWeight": 700,
								"letterSpacing": "0.06em"
							}
						},
						"children": [
							{
								"tag": "span",
								"props": {
									"style": {
										"width": "6px",
										"height": "6px",
										"borderRadius": "999px",
										"background": "#f04438"
									}
								}
							},
							"LIVE"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
								"fontSize": "12px",
								"color": "#475467"
							}
						},
						"children": [
							"{clock}"
						]
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "10px"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"width": "26px",
								"height": "26px",
								"borderRadius": "8px",
								"background": "#f9fafb",
								"color": "#475467",
								"display": "flex",
								"alignItems": "center",
								"justifyContent": "center",
								"fontSize": "12px",
								"fontWeight": 700,
								"flexShrink": 0
							}
						},
						"children": [
							"H"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"flex": 1,
								"fontSize": "14px",
								"fontWeight": 600,
								"minWidth": 0,
								"overflow": "hidden",
								"textOverflow": "ellipsis",
								"whiteSpace": "nowrap"
							}
						},
						"children": [
							"{home}"
						]
					},
					{
						"ttIf": {
							"arg": "possession",
							"equals": "home",
							"then": {
								"tag": "span",
								"props": {
									"style": {
										"width": "8px",
										"height": "8px",
										"borderRadius": "999px",
										"background": "#7f56d9",
										"flexShrink": 0
									}
								}
							}
						}
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
								"fontSize": "18px",
								"fontWeight": 700,
								"color": "#101828"
							}
						},
						"children": [
							"{homeScore}"
						]
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "10px"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"width": "26px",
								"height": "26px",
								"borderRadius": "8px",
								"background": "#f9fafb",
								"color": "#475467",
								"display": "flex",
								"alignItems": "center",
								"justifyContent": "center",
								"fontSize": "12px",
								"fontWeight": 700,
								"flexShrink": 0
							}
						},
						"children": [
							"A"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"flex": 1,
								"fontSize": "14px",
								"fontWeight": 600,
								"minWidth": 0,
								"overflow": "hidden",
								"textOverflow": "ellipsis",
								"whiteSpace": "nowrap"
							}
						},
						"children": [
							"{away}"
						]
					},
					{
						"ttIf": {
							"arg": "possession",
							"equals": "away",
							"then": {
								"tag": "span",
								"props": {
									"style": {
										"width": "8px",
										"height": "8px",
										"borderRadius": "999px",
										"background": "#7f56d9",
										"flexShrink": 0
									}
								}
							}
						}
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
								"fontSize": "18px",
								"fontWeight": 700,
								"color": "#101828"
							}
						},
						"children": [
							"{awayScore}"
						]
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"height": "4px",
						"borderRadius": "999px",
