{
	"slug": "untitled-profile-social-achievement",
	"name": "Achievement Tile",
	"library": "untitled",
	"category": "social",
	"description": "Achievement badge tile in the Untitled UI style — a star or zap emblem in a tone-soft circle with a tone border, title, and a progress bar with percent and 'x of y' captions.",
	"tags": [
		"profile",
		"achievement",
		"progress",
		"gamification",
		"social"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Streak Master",
			"label": "Title",
			"maxLength": 32
		},
		{
			"name": "icon",
			"type": "enum",
			"values": [
				"star",
				"zap"
			],
			"default": "star",
			"label": "Icon"
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "percent",
			"type": "number",
			"default": 60,
			"label": "Progress %",
			"min": 0,
			"max": 100
		},
		{
			"name": "done",
			"type": "number",
			"default": 3,
			"label": "Done",
			"min": 0
		},
		{
			"name": "total",
			"type": "number",
			"default": 5,
			"label": "Total",
			"min": 1
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"background": "#ffffff",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "#eaecf0",
				"borderRadius": "12px",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"boxShadow": "0 1px 2px rgba(16, 24, 40, 0.05)",
				"width": "216px",
				"display": "flex",
				"flexDirection": "column",
				"alignItems": "center",
				"textAlign": "center",
				"padding": "18px 16px",
				"boxSizing": "border-box"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"width": "48px",
						"height": "48px",
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "center",
						"borderRadius": "999px",
						"background": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#f9f5ff",
									"success": "#ecfdf3",
									"warning": "#fffaeb",
									"danger": "#fef3f2",
									"info": "#eff8ff",
									"neutral": "#f2f4f7"
								},
								"default": "#f9f5ff"
							}
						},
						"borderWidth": "1px",
						"borderStyle": "solid",
						"borderColor": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#e9d7fe",
									"success": "#a6f4c5",
									"warning": "#fedf89",
									"danger": "#fecdca",
									"info": "#b2ddff",
									"neutral": "#d0d5dd"
								},
								"default": "#e9d7fe"
							}
						},
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#6941c6",
									"success": "#027a48",
									"warning": "#b54708",
									"danger": "#b42318",
									"info": "#175cd3",
									"neutral": "#344054"
								},
								"default": "#6941c6"
							}
						}
					}
				},
				"children": [
					{
						"ttIf": {
							"arg": "icon",
							"equals": "zap",
							"then": {
								"tag": "svg",
								"props": {
									"width": 22,
									"height": 22,
									"viewBox": "0 0 24 24",
									"fill": "none",
									"stroke": "currentColor",
									"strokeWidth": 2,
									"strokeLinecap": "round",
									"strokeLinejoin": "round",
									"xmlns": "http://www.w3.org/2000/svg"
								},
								"children": [
									{
										"tag": "polygon",
										"props": {
											"points": "13 2 3 14 12 14 11 22 21 10 12 10 13 2"
										}
									}
								]
							},
							"else": {
								"tag": "svg",
								"props": {
									"width": 22,
									"height": 22,
									"viewBox": "0 0 24 24",
									"fill": "none",
									"stroke": "currentColor",
									"strokeWidth": 2,
									"strokeLinejoin": "round",
									"xmlns": "http://www.w3.org/2000/svg"
								},
								"children": [
									{
										"tag": "polygon",
										"props": {
											"points": "12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26"
										}
									}
								]
							}
						}
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"marginTop": "10px",
						"fontSize": "14px",
						"fontWeight": 600,
						"color": "#101828"
					}
				},
				"children": [
					"{title}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"marginTop": "12px",
						"width": "100%",
						"height": "6px",
						"borderRadius": "999px",
						"background": "#f2f4f7",
						"overflow": "hidden"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"width": "{percent}%",
								"height": "100%",
								"borderRadius": "999px",
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#7f56d9",
											"success": "#12b76a",
											"warning": "#f79009",
											"danger": "#f04438",
											"info": "#2e90fa",
											"neutral": "#344054"
										},
										"default": "#7f56d9"
									}
								}
							}
						}
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"marginTop": "8px",
						"width": "100%",
						"justifyContent": "space-between"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "12px",
								"color": "#475467"
							}
						},
						"children": [
							"{done} of {total}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "12px",
								"fontWeight": 600,
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#6941c6",
											"success": "#027a48",
											"warning": "#b54708",
											"danger": "#b42318",
											"info": "#175cd3",
											"neutral": "#344054"
										},
										"default": "#6941c6"
									}
								}
							}
						},
						"children": [
							"{percent}%"
						]
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "profile-social-achievement",
	"source": {
		"kind": "archetype",
		"archetype": "profile-social",
		"variant": "achievement",
		"tranche": 2
	}
}
