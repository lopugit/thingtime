								"position": "absolute",
								"top": "0px",
								"left": "0px",
								"height": "100%",
								"width": "calc({score} * 20px)",
								"overflow": "hidden",
								"whiteSpace": "nowrap"
							}
						},
						"children": [
							{
								"tag": "div",
								"props": {
									"style": {
										"display": "flex",
										"alignItems": "center",
