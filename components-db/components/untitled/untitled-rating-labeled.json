{
	"slug": "untitled-rating-labeled",
	"name": "Labeled Rating",
	"library": "untitled",
	"category": "data-display",
	"description": "Star rating with a score readout in the Untitled UI style — calc-clipped tone stars beside an “out of 5” figure and a muted review count, for product cards and listings.",
	"tags": [
		"rating",
		"stars",
		"reviews",
		"score"
	],
	"args": [
		{
			"name": "score",
			"type": "number",
			"default": 4.3,
			"label": "Score (0–5)",
			"min": 0,
			"max": 5
		},
		{
			"name": "reviews",
			"type": "string",
			"default": "1,284",
			"label": "Review count",
			"maxLength": 12
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "warning",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "inline-flex",
				"alignItems": "center",
				"gap": "10px",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"position": "relative",
						"display": "inline-flex"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"gap": "0px"
							}
						},
						"children": [
							{
								"ttRepeat": {
									"count": 5,
									"max": 5,
									"node": {
										"tag": "svg",
										"props": {
											"width": 20,
											"height": 20,
											"viewBox": "0 0 24 24",
											"fill": "none",
											"stroke": "#98a2b3",
											"strokeWidth": 2,
											"strokeLinejoin": "round",
											"xmlns": "http://www.w3.org/2000/svg"
										},
										"children": [
											{
												"tag": "polygon",
												"props": {
													"points": "12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26"
												}
											}
										]
									}
								}
							}
						]
					},
					{
