{
	"slug": "untitled-badge-solid",
	"name": "Solid Badge",
	"library": "untitled",
	"category": "data-display",
	"description": "Filled status badge in the Untitled UI style — solid tone background with contrast text on the library's native badge corners.",
	"tags": [
		"badge",
		"status",
		"solid"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Active",
			"label": "Label",
			"maxLength": 24
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "size",
			"type": "enum",
			"values": [
				"sm",
				"md"
			],
			"default": "sm",
			"label": "Size"
		}
	],
	"render": {
		"tag": "span",
		"props": {
			"style": {
				"ttMerge": [
					{
						"display": "inline-flex",
						"alignItems": "center",
						"gap": "6px",
						"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
						"fontWeight": 600,
						"lineHeight": 1.4,
						"borderRadius": "999px"
					},
					{
						"ttMap": {
							"arg": "size",
							"values": {
								"sm": {
									"fontSize": "12px",
									"padding": "2px 8px"
								},
								"md": {
									"fontSize": "14px",
									"padding": "4px 10px"
								}
							},
							"default": {
								"fontSize": "12px",
								"padding": "2px 8px"
							}
						}
					},
					{
						"background": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#7f56d9",
									"success": "#12b76a",
									"warning": "#f79009",
									"danger": "#f04438",
									"info": "#2e90fa",
									"neutral": "#344054"
								},
								"default": "#7f56d9"
							}
						},
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#ffffff",
									"success": "#ffffff",
									"warning": "#ffffff",
									"danger": "#ffffff",
									"info": "#ffffff",
									"neutral": "#ffffff"
								},
								"default": "#ffffff"
							}
						}
					}
				]
			}
		},
		"children": [
			"{label}"
		]
	},
	"version": 1,
	"familyKey": "badge-solid",
	"source": {
		"kind": "archetype",
		"archetype": "badge",
		"variant": "solid",
		"tranche": 1
	}
}
