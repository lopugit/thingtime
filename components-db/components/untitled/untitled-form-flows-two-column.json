{
	"slug": "untitled-form-flows-two-column",
	"name": "Two-Column Form Section",
	"library": "untitled",
	"category": "forms",
	"description": "Two-column form section in the Untitled UI style — heading and caption over a name pair with a full-width email row, required asterisks, and feather-shadowed field chrome.",
	"tags": [
		"form",
		"layout",
		"two-column",
		"grid"
	],
	"args": [
		{
			"name": "heading",
			"type": "string",
			"default": "Personal information",
			"label": "Heading",
			"maxLength": 40
