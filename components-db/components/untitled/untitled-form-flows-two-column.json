		{
			"name": "caption",
			"type": "string",
			"default": "Use your legal name as it appears on your ID.",
			"label": "Caption",
			"maxLength": 80
		},
		{
			"name": "required",
			"type": "boolean",
			"default": true,
			"label": "Show required"
