{
	"slug": "untitled-forms-advanced-password",
	"name": "Password Strength Field",
	"library": "untitled",
	"category": "forms",
	"description": "Password field in the Untitled UI style — masked dot glyphs inside the field plus a four-segment strength meter sweeping from danger to success with a matching caption.",
	"tags": [
		"form",
		"password",
		"strength",
		"security"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Password",
			"label": "Label",
			"maxLength": 30
		},
		{
			"name": "dots",
			"type": "number",
			"default": 8,
			"label": "Characters",
			"min": 1,
			"max": 12
		},
		{
			"name": "strength",
			"type": "enum",
			"values": [
				"weak",
				"fair",
				"good",
				"strong"
			],
			"default": "fair",
			"label": "Strength"
		},
		{
			"name": "focused",
			"type": "boolean",
			"default": false,
			"label": "Focused"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"gap": "6px",
				"width": "260px",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
			}
		},
		"children": [
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "14px",
						"fontWeight": 600,
						"color": "#101828"
					}
				},
				"children": [
					"{label}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"boxSizing": "border-box",
						"height": "40px",
						"padding": "0 12px",
						"background": "#ffffff",
						"borderWidth": "1px",
						"borderStyle": "solid",
						"borderColor": {
							"ttIf": {
								"arg": "focused",
								"then": "#7f56d9",
								"else": "#eaecf0"
							}
						},
						"borderRadius": "8px",
						"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
						"fontSize": "14px",
						"color": "#101828",
						"boxShadow": {
							"ttIf": {
								"arg": "focused",
								"then": "0 0 0 4px #f4ebff",
								"else": "0 1px 2px rgba(16, 24, 40, 0.05)"
							}
						},
						"gap": "4px"
					}
				},
				"children": [
					{
						"ttRepeat": {
							"arg": "dots",
							"max": 12,
							"node": {
								"tag": "span",
								"props": {
									"style": {
										"width": "6px",
										"height": "6px",
										"borderRadius": "999px",
										"background": "#101828",
										"flexShrink": 0
									}
								}
							}
						}
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "4px"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"flex": 1,
								"height": "6px",
								"borderRadius": "999px",
								"background": {
									"ttMap": {
										"arg": "strength",
