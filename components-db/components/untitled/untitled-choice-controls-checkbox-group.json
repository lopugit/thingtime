{
	"slug": "untitled-choice-controls-checkbox-group",
	"name": "Checkbox Group",
	"library": "untitled",
	"category": "forms",
	"description": "Vertical stack of three labeled checkboxes in the Untitled UI style — each row's label and checked state is its own arg, boxes fill with the primary color.",
	"tags": [
		"form",
		"checkbox",
		"group",
		"choice"
	],
	"args": [
		{
			"name": "labelA",
			"type": "string",
			"default": "Product updates",
			"label": "Option A",
			"maxLength": 40
		},
		{
			"name": "checkedA",
			"type": "boolean",
			"default": true,
			"label": "A checked"
		},
		{
			"name": "labelB",
			"type": "string",
			"default": "Weekly digest",
			"label": "Option B",
			"maxLength": 40
		},
		{
			"name": "checkedB",
			"type": "boolean",
			"default": true,
			"label": "B checked"
		},
		{
			"name": "labelC",
			"type": "string",
			"default": "Partner offers",
			"label": "Option C",
			"maxLength": 40
		},
		{
			"name": "checkedC",
			"type": "boolean",
			"default": false,
			"label": "C checked"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"gap": "10px"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "8px"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"ttMerge": [
									{
										"width": "18px",
										"height": "18px",
										"borderRadius": "6px",
										"borderWidth": "1px",
										"borderStyle": "solid",
										"display": "flex",
										"alignItems": "center",
										"justifyContent": "center",
										"flexShrink": 0,
										"boxSizing": "border-box"
									},
									{
										"ttIf": {
											"arg": "checkedA",
											"then": {
												"background": "#7f56d9",
												"borderColor": "#7f56d9"
											},
											"else": {
												"background": "#ffffff",
												"borderColor": "#eaecf0"
											}
										}
									}
								]
							}
						},
						"children": [
							{
								"ttIf": {
									"arg": "checkedA",
									"then": {
										"tag": "svg",
										"props": {
											"width": 12,
											"height": 12,
											"viewBox": "0 0 24 24",
											"fill": "none",
											"stroke": "#ffffff",
											"strokeWidth": 2,
											"strokeLinecap": "round",
											"strokeLinejoin": "round",
											"xmlns": "http://www.w3.org/2000/svg"
										},
										"children": [
											{
												"tag": "polyline",
												"props": {
													"points": "20 6 9 17 4 12"
												}
											}
										]
									}
								}
							}
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
								"fontSize": "14px",
								"color": "#101828"
