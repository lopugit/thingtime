{
	"slug": "untitled-forms-advanced-phone",
	"name": "Phone Input",
	"library": "untitled",
	"category": "forms",
	"description": "Phone number field in the Untitled UI style — a dial-prefix country mock with chevron on the left, muted placeholder digits, and a success check when the number validates.",
	"tags": [
		"form",
		"phone",
		"input",
		"validation"
	],
	"args": [
		{
			"name": "prefix",
			"type": "string",
			"default": "61",
			"label": "Dial prefix",
			"maxLength": 4
		},
		{
			"name": "number",
			"type": "string",
			"default": "412 345 678",
			"label": "Number",
			"maxLength": 20
		},
		{
			"name": "valid",
			"type": "boolean",
			"default": true,
			"label": "Valid"
		},
		{
			"name": "focused",
			"type": "boolean",
			"default": false,
			"label": "Focused"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"alignItems": "center",
				"boxSizing": "border-box",
				"height": "40px",
				"padding": "0 12px",
				"background": "#ffffff",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": {
					"ttIf": {
						"arg": "focused",
						"then": "#7f56d9",
						"else": "#eaecf0"
					}
				},
				"borderRadius": "8px",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"fontSize": "14px",
				"color": "#101828",
				"boxShadow": {
					"ttIf": {
						"arg": "focused",
						"then": "0 0 0 4px #f4ebff",
						"else": "0 1px 2px rgba(16, 24, 40, 0.05)"
					}
				},
				"gap": "10px",
				"width": "280px"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "4px",
						"paddingRight": "10px",
						"borderRightWidth": "1px",
						"borderRightStyle": "solid",
						"borderRightColor": "#f2f4f7",
						"fontWeight": 500,
						"flexShrink": 0
					}
				},
				"children": [
					"+{prefix}",
					{
						"tag": "svg",
						"props": {
							"width": 14,
							"height": 14,
							"viewBox": "0 0 24 24",
							"fill": "none",
							"stroke": "#475467",
							"strokeWidth": 2,
							"strokeLinecap": "round",
							"strokeLinejoin": "round",
							"xmlns": "http://www.w3.org/2000/svg"
						},
						"children": [
							{
								"tag": "polyline",
								"props": {
									"points": "6 9 12 15 18 9"
								}
							}
						]
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"flex": 1,
						"color": "#98a2b3"
					}
				},
				"children": [
					"{number}"
				]
			},
			{
				"ttIf": {
					"arg": "valid",
					"then": {
						"tag": "svg",
						"props": {
							"width": 16,
							"height": 16,
							"viewBox": "0 0 24 24",
							"fill": "none",
							"stroke": "#12b76a",
							"strokeWidth": 2,
							"strokeLinecap": "round",
							"strokeLinejoin": "round",
							"xmlns": "http://www.w3.org/2000/svg"
						},
						"children": [
							{
								"tag": "polyline",
								"props": {
									"points": "20 6 9 17 4 12"
								}
							}
						]
					}
				}
			}
		]
	},
	"version": 1,
	"familyKey": "forms-advanced-phone",
	"source": {
		"kind": "archetype",
		"archetype": "forms-advanced",
		"variant": "phone",
		"tranche": 2
	}
}
