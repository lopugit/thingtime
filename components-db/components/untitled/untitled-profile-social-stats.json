{
	"slug": "untitled-profile-social-stats",
	"name": "Profile Stats Band",
	"library": "untitled",
	"category": "social",
	"description": "Profile stats band in the Untitled UI style — posts, followers and following counts as big numbers over quiet captions, divider-separated, with one block highlighted by an accent top border.",
	"tags": [
		"profile",
		"stats",
		"metrics",
		"counters",
		"social"
	],
	"args": [
		{
			"name": "posts",
			"type": "string",
			"default": "128",
			"label": "Posts",
			"maxLength": 10
		},
		{
			"name": "followers",
			"type": "string",
			"default": "2,304",
			"label": "Followers",
			"maxLength": 10
		},
		{
			"name": "following",
			"type": "string",
			"default": "180",
			"label": "Following",
			"maxLength": 10
		},
		{
			"name": "highlight",
			"type": "enum",
			"values": [
				"posts",
				"followers",
				"following",
				"none"
			],
			"default": "followers",
			"label": "Highlight"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"background": "#ffffff",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "#eaecf0",
				"borderRadius": "12px",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"boxShadow": "0 1px 2px rgba(16, 24, 40, 0.05)",
				"width": "320px",
				"display": "flex",
				"alignItems": "stretch",
				"overflow": "hidden"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"ttMerge": [
							{
								"flex": 1,
								"display": "flex",
								"flexDirection": "column",
								"alignItems": "center",
								"gap": "2px",
								"padding": "14px 10px",
								"borderTopWidth": "2px",
								"borderTopStyle": "solid"
							},
							{
								"ttIf": {
									"arg": "highlight",
									"equals": "posts",
									"then": {
										"borderTopColor": "#7f56d9"
									},
									"else": {
										"borderTopColor": "transparent"
									}
								}
							}
						]
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "18px",
								"fontWeight": 600,
								"color": "#101828"
							}
						},
						"children": [
							"{posts}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "12px",
								"color": "#475467",
								"textTransform": "uppercase",
								"letterSpacing": "0.04em"
							}
						},
						"children": [
