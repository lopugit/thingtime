{
	"slug": "untitled-date-time-date-input",
	"name": "Date Input",
	"library": "untitled",
	"category": "forms",
	"description": "Labeled date field in the Untitled UI style — calendar glyph beside a formatted date, with the library's focus ring and accent border when focused.",
	"tags": [
		"date",
		"input",
		"field",
		"form"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Due date",
			"label": "Label",
			"maxLength": 32
		},
		{
			"name": "date",
			"type": "string",
			"default": "12 Aug 2026",
			"label": "Date",
			"maxLength": 24
		},
		{
			"name": "focused",
			"type": "boolean",
			"default": true,
			"label": "Focused"
		},
		{
			"name": "hint",
			"type": "string",
			"default": "DD MMM YYYY",
			"label": "Hint",
			"maxLength": 40
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"gap": "6px",
				"width": "232px",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
			}
		},
		"children": [
			{
				"tag": "label",
				"props": {
					"style": {
						"fontSize": "14px",
						"fontWeight": 500,
						"color": "#101828"
					}
				},
				"children": [
					"{label}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"ttMerge": [
							{
								"display": "flex",
								"alignItems": "center",
								"gap": "8px",
								"height": "40px",
								"padding": "0 12px",
								"boxSizing": "border-box",
								"background": "#ffffff",
								"borderWidth": "1px",
								"borderStyle": "solid",
								"borderRadius": "8px",
								"fontSize": "14px",
								"color": "#101828"
							},
							{
								"ttIf": {
									"arg": "focused",
									"then": {
										"borderColor": "#7f56d9",
										"boxShadow": "0 0 0 4px #f4ebff"
									},
									"else": {
										"borderColor": "#eaecf0",
										"boxShadow": "0 1px 2px rgba(16, 24, 40, 0.05)"
									}
								}
							}
						]
					}
				},
				"children": [
					{
						"tag": "svg",
						"props": {
							"width": 16,
							"height": 16,
							"viewBox": "0 0 24 24",
							"fill": "none",
							"stroke": "#475467",
							"strokeWidth": 2,
							"strokeLinecap": "round",
							"strokeLinejoin": "round",
							"xmlns": "http://www.w3.org/2000/svg"
						},
						"children": [
							{
								"tag": "rect",
								"props": {
									"x": 3,
									"y": 4,
									"width": 18,
									"height": 18,
									"rx": 2
								}
							},
							{
								"tag": "line",
								"props": {
									"x1": 16,
									"y1": 2,
									"x2": 16,
									"y2": 6
								}
							},
							{
								"tag": "line",
								"props": {
									"x1": 8,
									"y1": 2,
									"x2": 8,
									"y2": 6
								}
							},
							{
								"tag": "line",
								"props": {
									"x1": 3,
									"y1": 10,
									"x2": 21,
									"y2": 10
								}
							}
						]
					},
					"{date}"
				]
			},
			{
				"ttIf": {
					"arg": "hint",
					"then": {
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "12px",
								"color": "#475467"
							}
						},
						"children": [
							"{hint}"
						]
					}
				}
			}
		]
	},
	"version": 1,
	"familyKey": "date-time-date-input",
	"source": {
		"kind": "archetype",
		"archetype": "date-time",
		"variant": "date-input",
		"tranche": 2
	}
}
