{
	"slug": "untitled-gamification-xp",
	"name": "XP Progress",
	"library": "untitled",
	"category": "engagement",
	"description": "XP progress card in the Untitled UI style — a Level chip, a tone-colored bar with a marker dot riding the fill edge, and an XP-to-next-level caption.",
	"tags": [
		"gamification",
		"xp",
		"progress",
		"level"
	],
	"args": [
		{
			"name": "level",
			"type": "number",
			"default": 7,
			"label": "Level",
			"min": 1
		},
		{
			"name": "percent",
			"type": "number",
			"default": 68,
			"label": "Progress (0–100)",
			"min": 0,
			"max": 100
		},
		{
			"name": "xp",
			"type": "string",
			"default": "1,250",
			"label": "XP remaining",
			"maxLength": 10
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"width": "260px",
				"padding": "16px",
				"boxSizing": "border-box",
				"background": "#ffffff",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "#eaecf0",
				"borderRadius": "12px",
				"boxShadow": "0 12px 16px -4px rgba(16, 24, 40, 0.08), 0 4px 6px -2px rgba(16, 24, 40, 0.03)",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"gap": "12px"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "space-between",
						"gap": "12px"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"display": "inline-flex",
								"alignItems": "center",
								"padding": "2px 10px",
								"borderRadius": "999px",
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#f9f5ff",
											"success": "#ecfdf3",
											"warning": "#fffaeb",
											"danger": "#fef3f2",
											"info": "#eff8ff",
											"neutral": "#f2f4f7"
										},
										"default": "#f9f5ff"
									}
								},
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#6941c6",
											"success": "#027a48",
											"warning": "#b54708",
											"danger": "#b42318",
											"info": "#175cd3",
											"neutral": "#344054"
										},
										"default": "#6941c6"
									}
								},
								"fontSize": "12px",
								"fontWeight": 700
							}
						},
						"children": [
							"Level {level}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "14px",
								"fontWeight": 600,
								"color": "#475467",
								"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
							}
						},
						"children": [
							"{percent}%"
						]
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"position": "relative",
						"height": "10px",
						"borderRadius": "999px",
						"background": "#f2f4f7"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"width": "{percent}%",
								"maxWidth": "100%",
								"height": "100%",
								"borderRadius": "999px",
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#7f56d9",
											"success": "#12b76a",
											"warning": "#f79009",
											"danger": "#f04438",
											"info": "#2e90fa",
											"neutral": "#344054"
										},
										"default": "#7f56d9"
									}
								}
							}
						}
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"position": "absolute",
								"top": "-3px",
								"left": "calc({percent}% - 8px)",
								"width": "16px",
								"height": "16px",
								"boxSizing": "border-box",
								"borderRadius": "999px",
								"background": "#ffffff",
								"borderWidth": "2px",
								"borderStyle": "solid",
								"borderColor": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#7f56d9",
											"success": "#12b76a",
											"warning": "#f79009",
											"danger": "#f04438",
											"info": "#2e90fa",
											"neutral": "#344054"
										},
										"default": "#7f56d9"
									}
								},
								"boxShadow": "0 1px 2px rgba(16, 24, 40, 0.05)"
							}
						}
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "12px",
						"color": "#475467"
					}
				},
				"children": [
					"{xp} XP to next level"
				]
			}
		]
	},
	"version": 1,
	"familyKey": "gamification-xp",
	"source": {
		"kind": "archetype",
		"archetype": "gamification",
		"variant": "xp",
		"tranche": 2
	}
}
