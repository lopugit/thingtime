{
	"slug": "untitled-chip-basic",
	"name": "Basic Chip",
	"library": "untitled",
	"category": "data-display",
	"description": "Plain tag chip in the Untitled UI style — a soft tone wash by default with a filled toggle, on the library's native chip corners.",
	"tags": [
		"chip",
		"tag",
		"label"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Design",
			"label": "Label",
			"maxLength": 24
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "filled",
			"type": "boolean",
			"default": false,
			"label": "Filled"
		}
	],
	"render": {
		"tag": "span",
		"props": {
			"style": {
				"ttMerge": [
					{
						"display": "inline-flex",
						"alignItems": "center",
						"gap": "6px",
						"height": "36px",
						"padding": "0 12px",
						"borderRadius": "999px",
						"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
						"fontWeight": 500,
						"fontSize": "14px"
					},
					{
						"ttIf": {
							"arg": "filled",
							"then": {
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#7f56d9",
											"success": "#12b76a",
											"warning": "#f79009",
											"danger": "#f04438",
											"info": "#2e90fa",
											"neutral": "#344054"
										},
										"default": "#7f56d9"
									}
								},
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#ffffff",
											"success": "#ffffff",
											"warning": "#ffffff",
											"danger": "#ffffff",
											"info": "#ffffff",
											"neutral": "#ffffff"
										},
										"default": "#ffffff"
									}
								}
							},
							"else": {
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#f9f5ff",
											"success": "#ecfdf3",
											"warning": "#fffaeb",
											"danger": "#fef3f2",
											"info": "#eff8ff",
											"neutral": "#f2f4f7"
										},
										"default": "#f9f5ff"
									}
								},
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#6941c6",
											"success": "#027a48",
											"warning": "#b54708",
											"danger": "#b42318",
											"info": "#175cd3",
											"neutral": "#344054"
										},
										"default": "#6941c6"
									}
								}
							}
						}
					}
				]
			}
		},
		"children": [
			"{label}"
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "chip",
		"variant": "basic",
		"tranche": 1
	}
}
