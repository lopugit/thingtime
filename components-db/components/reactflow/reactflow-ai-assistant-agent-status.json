				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"fontSize": "10px",
						"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
						"color": "#6f6e77",
						"background": "#f4f4f5",
						"borderRadius": "3px",
						"padding": "6px 8px",
						"borderLeftWidth": "2px",
						"borderLeftStyle": "solid",
						"borderLeftColor": {
							"ttMap": {
								"arg": "state",
								"values": {
									"running": "#784be8",
									"waiting": "#eab308",
									"done": "#22c55e",
									"error": "#ff0072"
								}
							}
						},
						"whiteSpace": "nowrap",
						"overflow": "hidden"
					}
				},
				"children": [
					"→ web.search(\"competitor pricing\")"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "8px"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"flex": 1
							}
						}
					},
					{
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"border": "none",
								"background": "transparent",
								"padding": 0,
								"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
								"fontSize": "12px",
								"fontWeight": 500,
								"color": "#ff0072",
								"cursor": "pointer"
							}
						},
						"children": [
							"Cancel"
						]
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "ai-assistant-agent-status",
	"source": {
		"kind": "archetype",
		"archetype": "ai-assistant",
