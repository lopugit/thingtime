{
	"slug": "reactflow-ai-assistant-agent-status",
	"name": "AI Agent Status",
	"library": "reactflow",
	"category": "ai",
	"description": "Agent status card in the React Flow style — a pulsing ring-and-core dot tinted by a running/waiting/done/error state, task title with step caption, a mono elapsed chip, a mono tool-call log line, and a cancel ghost.",
	"tags": [
		"ai",
		"agent",
		"status",
		"task"
	],
	"args": [
		{
			"name": "task",
			"type": "string",
			"default": "Researching competitors",
			"label": "Task",
			"maxLength": 48
		},
		{
			"name": "state",
			"type": "enum",
			"values": [
				"running",
				"waiting",
				"done",
				"error"
			],
			"default": "running",
			"label": "State"
		},
		{
			"name": "step",
			"type": "number",
			"default": 3,
			"label": "Step",
			"min": 1
		},
		{
			"name": "total",
			"type": "number",
			"default": 5,
			"label": "Total steps",
			"min": 1
		},
		{
			"name": "elapsed",
			"type": "string",
			"default": "02:14",
			"label": "Elapsed",
			"maxLength": 10
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
				"background": "#ffffff",
				"borderRadius": "5px",
				"boxSizing": "border-box",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "#1a192b",
				"gap": "10px",
				"width": "320px",
				"padding": "14px"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "10px"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"width": "18px",
								"height": "18px",
								"borderRadius": "999px",
								"background": {
									"ttMap": {
										"arg": "state",
										"values": {
											"running": "#f1ecfd",
											"waiting": "#fefce8",
											"done": "#f0fdf4",
											"error": "#ffe4f1"
										}
									}
								},
								"display": "flex",
								"alignItems": "center",
								"justifyContent": "center",
								"flexShrink": 0
							}
						},
						"children": [
							{
								"tag": "div",
								"props": {
									"style": {
										"width": "8px",
										"height": "8px",
										"borderRadius": "999px",
										"background": {
											"ttMap": {
												"arg": "state",
												"values": {
													"running": "#784be8",
													"waiting": "#eab308",
													"done": "#22c55e",
													"error": "#ff0072"
												}
											}
										}
									}
								}
							}
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"flexDirection": "column",
								"gap": "2px",
								"flex": 1
							}
						},
						"children": [
							{
