							}
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "10px",
								"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
								"color": "#6f6e77",
								"background": "#f4f4f5",
								"borderRadius": "999px",
