{
	"slug": "reactflow-gamification-quest",
	"name": "Quest Card",
	"library": "reactflow",
	"category": "engagement",
	"description": "Quest card in the React Flow style — a star icon tile beside the quest title, a soft success reward chip, a percent-driven progress bar with a mono done/total readout, and a claim button that appears once the quest completes.",
	"tags": [
		"gamification",
		"quest",
		"reward",
		"progress"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Post 3 times this week",
			"label": "Quest title",
			"maxLength": 40
		},
		{
			"name": "xp",
			"type": "number",
			"default": 50,
			"label": "Reward XP",
			"min": 0
		},
		{
			"name": "done",
			"type": "number",
			"default": 2,
			"label": "Steps done",
			"min": 0
		},
		{
			"name": "total",
			"type": "number",
			"default": 3,
			"label": "Steps total",
			"min": 1
		},
		{
			"name": "percent",
			"type": "number",
			"default": 66,
			"label": "Progress (0–100)",
			"min": 0,
			"max": 100
		},
		{
			"name": "complete",
			"type": "boolean",
			"default": false,
			"label": "Complete"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "row",
				"width": "300px",
				"padding": "16px",
				"boxSizing": "border-box",
				"background": "#ffffff",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "#1a192b",
				"borderRadius": "8px",
				"boxShadow": "0 1px 2px rgba(26, 25, 43, 0.08)",
				"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
				"gap": "12px",
				"alignItems": "flex-start"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"width": "40px",
						"height": "40px",
						"borderRadius": "5px",
						"background": "#f4f4f5",
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "center",
						"flexShrink": 0
					}
				},
				"children": [
					{
						"tag": "svg",
						"props": {
							"width": 20,
							"height": 20,
							"viewBox": "0 0 24 24",
							"fill": "none",
							"stroke": "#1a192b",
							"strokeWidth": 2,
							"strokeLinejoin": "round",
							"xmlns": "http://www.w3.org/2000/svg"
						},
						"children": [
							{
								"tag": "polygon",
								"props": {
									"points": "12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26"
								}
							}
						]
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"flex": 1,
						"gap": "8px"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"justifyContent": "space-between",
								"gap": "8px"
							}
						},
						"children": [
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "12px",
										"fontWeight": 600,
										"color": "#1a192b"
									}
								},
								"children": [
									"{title}"
								]
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"display": "inline-flex",
										"alignItems": "center",
										"padding": "2px 8px",
										"borderRadius": "999px",
										"background": "#f0fdf4",
										"color": "#15803d",
										"fontSize": "10px",
										"fontWeight": 700,
										"whiteSpace": "nowrap",
										"flexShrink": 0
									}
								},
								"children": [
									"+{xp} XP"
								]
							}
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "10px",
								"color": "#6f6e77"
							}
						},
						"children": [
							"Keep the momentum going to bank the reward."
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"gap": "8px"
							}
						},
						"children": [
							{
								"tag": "div",
								"props": {
									"style": {
										"flex": 1,
										"height": "8px",
										"borderRadius": "999px",
										"background": "#e2e2e5",
										"overflow": "hidden"
									}
								},
								"children": [
									{
										"tag": "div",
										"props": {
											"style": {
												"width": "{percent}%",
												"maxWidth": "100%",
												"height": "100%",
												"borderRadius": "999px",
												"background": "#1a192b"
											}
										}
									}
								]
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "10px",
										"color": "#6f6e77",
										"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
									}
								},
								"children": [
									"{done}/{total}"
								]
							}
						]
					},
					{
						"ttIf": {
							"arg": "complete",
							"then": {
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"display": "inline-flex",
										"alignItems": "center",
										"justifyContent": "center",
										"alignSelf": "flex-start",
										"height": "24px",
										"padding": "0 14px",
										"border": "none",
										"borderRadius": "3px",
										"background": "#22c55e",
										"color": "#ffffff",
										"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
										"fontWeight": 500,
										"fontSize": "10px",
										"cursor": "pointer"
									}
								},
								"children": [
									"Claim reward"
								]
							}
						}
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "gamification-quest",
	"source": {
		"kind": "archetype",
		"archetype": "gamification",
		"variant": "quest",
		"tranche": 2
	}
}
