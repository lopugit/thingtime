{
	"slug": "reactflow-chat-bubble",
	"name": "Message Bubble Pair",
	"library": "reactflow",
	"category": "messaging",
	"description": "Incoming and outgoing chat bubbles in the React Flow style — quiet surface on the left, tone-solid reply on the right, crisp node-like corners with a sharp tail edge and a timestamp.",
	"tags": [
		"chat",
		"message",
		"bubble",
		"conversation"
	],
	"args": [
		{
			"name": "incoming",
			"type": "string",
			"default": "Hey! Did you see the launch?",
			"label": "Incoming message",
			"maxLength": 120
		},
		{
			"name": "outgoing",
			"type": "string",
			"default": "Just saw it — looks great!",
			"label": "Outgoing message",
			"maxLength": 120
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "time",
			"type": "string",
			"default": "9:41 AM",
			"label": "Timestamp",
			"maxLength": 12
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"gap": "6px",
				"width": "280px",
				"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"padding": "8px 12px",
						"maxWidth": "220px",
						"fontSize": "12px",
						"lineHeight": 1.45,
						"background": "#f4f4f5",
						"color": "#1a192b",
						"borderRadius": "3px 3px 3px 2px",
						"borderWidth": "1px",
						"borderStyle": "solid",
						"borderColor": "#1a192b",
						"alignSelf": "flex-start"
					}
				},
				"children": [
					"{incoming}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"padding": "8px 12px",
						"maxWidth": "220px",
						"fontSize": "12px",
						"lineHeight": 1.45,
						"background": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#1a192b",
									"success": "#22c55e",
									"warning": "#eab308",
									"danger": "#ff0072",
									"info": "#784be8",
									"neutral": "#6f6e77"
								},
								"default": "#1a192b"
							}
						},
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#ffffff",
									"success": "#ffffff",
									"warning": "#ffffff",
									"danger": "#ffffff",
									"info": "#ffffff",
									"neutral": "#ffffff"
								},
								"default": "#ffffff"
							}
						},
						"borderRadius": "3px 3px 2px 3px",
						"alignSelf": "flex-end"
					}
				},
				"children": [
					"{outgoing}"
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"alignSelf": "flex-end",
						"fontSize": "10px",
						"color": "#6f6e77"
					}
				},
				"children": [
					"{time}"
				]
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "chat",
		"variant": "bubble",
		"tranche": 2
	}
}
