{
	"slug": "reactflow-flow-minimap",
	"name": "Flow Minimap",
	"library": "reactflow",
	"category": "flow",
	"description": "Graph minimap panel in the React Flow style — a muted surface scattered with node blocks and a tone-colored viewport rectangle overlay.",
	"tags": [
		"flow",
		"minimap",
		"viewport",
		"panel"
	],
	"args": [
		{
			"name": "nodes",
			"type": "number",
			"default": 6,
			"label": "Nodes",
			"min": 0,
			"max": 12
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "label",
			"type": "string",
			"default": "Graph overview",
			"label": "Caption",
			"maxLength": 40
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
				"gap": "6px",
				"width": "180px"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"position": "relative",
						"width": "180px",
						"height": "112px",
						"background": "#f4f4f5",
						"borderWidth": "1px",
						"borderStyle": "solid",
						"borderColor": "#e2e2e5",
						"borderRadius": "5px",
						"boxShadow": "0 1px 2px rgba(26, 25, 43, 0.08)",
						"padding": "10px",
						"boxSizing": "border-box",
						"display": "flex",
						"flexWrap": "wrap",
						"gap": "9px",
						"alignContent": "flex-start",
						"overflow": "hidden"
					}
				},
				"children": [
					{
						"ttRepeat": {
							"arg": "nodes",
							"max": 12,
							"node": {
								"tag": "span",
								"props": {
									"style": {
										"width": "24px",
										"height": "13px",
										"borderRadius": "2px",
										"background": "#ffffff",
										"borderWidth": "1px",
										"borderStyle": "solid",
										"borderColor": "#91919a",
										"boxSizing": "border-box"
									}
								}
							}
						}
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"position": "absolute",
								"left": "28%",
								"top": "20%",
								"width": "46%",
								"height": "52%",
								"borderWidth": "2px",
								"borderStyle": "solid",
								"borderColor": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#1a192b",
											"success": "#22c55e",
											"warning": "#eab308",
											"danger": "#ff0072",
											"info": "#784be8",
											"neutral": "#6f6e77"
										},
										"default": "#1a192b"
									}
								},
								"borderRadius": "2px",
								"boxSizing": "border-box"
							}
						}
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "10px",
						"color": "#6f6e77"
					}
				},
				"children": [
					"{label}"
				]
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "flow",
		"variant": "minimap",
		"tranche": 1
	}
}
