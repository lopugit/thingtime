{
	"slug": "reactflow-slider-progress-progress",
	"name": "Progress Bar",
	"library": "reactflow",
	"category": "forms",
	"description": "Horizontal progress bar in the React Flow style — pill-rounded track with a tone-colored fill whose width tracks the percent value.",
	"tags": [
		"progress",
		"bar",
		"percent",
		"status"
	],
	"args": [
		{
			"name": "percent",
			"type": "number",
			"default": 64,
			"label": "Percent",
			"min": 0,
			"max": 100
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "size",
			"type": "enum",
			"values": [
				"sm",
				"md",
				"lg"
			],
			"default": "md",
			"label": "Size"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"width": "240px",
				"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"height": {
							"ttMap": {
								"arg": "size",
								"values": {
									"sm": "4px",
									"md": "8px",
									"lg": "12px"
								},
								"default": "8px"
							}
						},
						"background": "#e2e2e5",
						"borderRadius": "999px",
						"overflow": "hidden"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"width": "{percent}%",
								"height": "100%",
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#ff0072",
											"success": "#22c55e",
											"warning": "#eab308",
											"danger": "#ff0072",
											"info": "#784be8",
											"neutral": "#6f6e77"
										},
										"default": "#ff0072"
									}
								},
								"borderRadius": "999px"
							}
						}
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "slider-progress-progress",
	"source": {
		"kind": "archetype",
		"archetype": "slider-progress",
		"variant": "progress",
		"tranche": 1
	}
}
