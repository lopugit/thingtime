{
	"slug": "reactflow-badge-soft",
	"name": "Soft Badge",
	"library": "reactflow",
	"category": "data-display",
	"description": "Tinted status badge in the React Flow style — soft tone wash with the deeper tone for the label.",
	"tags": [
		"badge",
		"status",
		"soft",
		"tinted"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "In review",
			"label": "Label",
			"maxLength": 24
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "size",
			"type": "enum",
			"values": [
				"sm",
				"md"
			],
			"default": "sm",
			"label": "Size"
		}
	],
	"render": {
		"tag": "span",
		"props": {
			"style": {
				"ttMerge": [
					{
						"display": "inline-flex",
						"alignItems": "center",
						"gap": "6px",
						"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
						"fontWeight": 600,
						"lineHeight": 1.4,
						"borderRadius": "3px"
					},
					{
						"ttMap": {
							"arg": "size",
							"values": {
								"sm": {
									"fontSize": "10px",
									"padding": "2px 8px"
								},
								"md": {
									"fontSize": "12px",
									"padding": "4px 10px"
								}
							},
							"default": {
								"fontSize": "10px",
								"padding": "2px 8px"
							}
						}
					},
					{
						"background": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#f4f4f5",
									"success": "#f0fdf4",
									"warning": "#fefce8",
									"danger": "#ffe4f1",
									"info": "#f1ecfd",
									"neutral": "#f4f4f5"
								},
								"default": "#f4f4f5"
							}
						},
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#1a192b",
									"success": "#15803d",
									"warning": "#a16207",
									"danger": "#c00055",
									"info": "#5b21b6",
									"neutral": "#3f3e4a"
								},
								"default": "#1a192b"
							}
						}
					}
				]
			}
		},
		"children": [
			"{label}"
		]
	},
	"version": 1,
	"familyKey": "badge-soft",
	"source": {
		"kind": "archetype",
		"archetype": "badge",
		"variant": "soft",
		"tranche": 1
	}
}
