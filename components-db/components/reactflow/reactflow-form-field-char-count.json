{
	"slug": "reactflow-form-field-char-count",
	"name": "Character Count Field",
	"library": "reactflow",
	"category": "forms",
	"description": "Labeled field with a used/limit character counter aligned bottom-right in the React Flow style — the over-limit toggle flips border and counter to the danger tone.",
	"tags": [
		"form",
		"field",
		"counter",
		"limit"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Bio",
			"label": "Label",
			"maxLength": 40
		},
		{
			"name": "value",
			"type": "string",
			"default": "Designer, gardener, amateur botanist",
			"label": "Value",
			"maxLength": 80
		},
		{
			"name": "chars",
			"type": "number",
			"default": 36,
			"label": "Characters used",
			"min": 0,
			"max": 999
		},
		{
			"name": "maxChars",
			"type": "number",
			"default": 120,
			"label": "Character limit",
			"min": 1,
			"max": 999
		},
		{
			"name": "overLimit",
			"type": "boolean",
			"default": false,
			"label": "Over limit"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"gap": "6px",
				"width": "280px"
			}
		},
		"children": [
			{
				"tag": "span",
				"props": {
					"style": {
						"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
						"fontSize": "12px",
						"fontWeight": 600,
						"color": "#1a192b"
					}
				},
				"children": [
					"{label}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"ttMerge": [
							{
								"height": "30px",
								"padding": "0 12px",
								"borderRadius": "3px",
								"borderWidth": "1px",
								"borderStyle": "solid",
								"borderColor": "#1a192b",
								"background": "#ffffff",
								"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
								"fontSize": "12px",
								"color": "#1a192b",
								"outline": "none",
								"width": "100%",
								"boxSizing": "border-box",
								"boxShadow": "none"
							},
							{
								"display": "flex",
								"alignItems": "center",
								"overflow": "hidden",
								"whiteSpace": "nowrap",
								"borderColor": {
									"ttIf": {
										"arg": "overLimit",
										"then": "#ff0072",
										"else": "#1a192b"
									}
								}
							}
						]
					}
				},
				"children": [
					"{value}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "flex-end"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
								"fontSize": "10px",
								"color": {
									"ttIf": {
										"arg": "overLimit",
										"then": "#ff0072",
										"else": "#6f6e77"
									}
								}
							}
						},
						"children": [
							"{chars}/{maxChars}"
						]
					}
				]
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "form-field",
		"variant": "char-count",
		"tranche": 1
	}
}
