{
	"slug": "reactflow-automotive-battery",
	"name": "EV Battery Card",
	"library": "reactflow",
	"category": "automotive",
	"description": "EV charge card in the React Flow style — large percentage with range caption, a rounded battery bar with terminal nub that flips to danger when low, and a charging chip with time-to-full.",
	"tags": [
		"automotive",
		"ev",
		"battery",
		"charge"
	],
	"args": [
		{
			"name": "percent",
			"type": "number",
			"default": 72,
			"label": "Charge %",
			"min": 0,
			"max": 100
		},
		{
			"name": "range",
			"type": "string",
			"default": "318 km",
			"label": "Range",
			"maxLength": 12
		},
		{
			"name": "charging",
			"type": "boolean",
			"default": true,
			"label": "Charging"
		},
		{
			"name": "time",
			"type": "string",
			"default": "1h 20m",
			"label": "Time to full",
			"maxLength": 12
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"width": "270px",
				"background": "#ffffff",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "#1a192b",
				"borderRadius": "8px",
				"boxShadow": "0 1px 2px rgba(26, 25, 43, 0.08)",
				"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
				"color": "#1a192b",
				"overflow": "hidden",
				"boxSizing": "border-box",
				"padding": "16px",
				"gap": "10px"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "baseline",
						"gap": "8px"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "30px",
								"fontWeight": 600,
								"lineHeight": 1
							}
						},
						"children": [
							"{percent}%"
						]
					},
					{
						"ttIf": {
							"arg": "charging",
							"then": {
								"tag": "span",
								"props": {
									"style": {
										"display": "inline-flex",
										"alignItems": "center",
										"gap": "4px",
										"padding": "2px 8px",
										"borderRadius": "999px",
										"background": "#f0fdf4",
										"color": "#15803d",
										"fontSize": "10px",
										"fontWeight": 600
									}
								},
								"children": [
									{
										"tag": "svg",
										"props": {
											"width": 11,
											"height": 11,
											"viewBox": "0 0 24 24",
											"fill": "none",
											"stroke": "currentColor",
											"strokeWidth": 2,
											"strokeLinecap": "round",
											"strokeLinejoin": "round",
											"xmlns": "http://www.w3.org/2000/svg"
										},
										"children": [
											{
												"tag": "polygon",
												"props": {
													"points": "13 2 3 14 12 14 11 22 21 10 12 10 13 2"
												}
											}
										]
									},
									"Charging"
								]
							}
						}
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "10px",
						"color": "#6f6e77"
					}
				},
				"children": [
					"{range} of range"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "4px"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"flex": "1",
								"height": "12px",
								"borderRadius": "999px",
								"background": "#f4f4f5",
								"borderWidth": "1px",
								"borderStyle": "solid",
								"borderColor": "#e2e2e5",
								"overflow": "hidden",
								"boxSizing": "border-box"
							}
						},
						"children": [
							{
								"tag": "div",
								"props": {
									"style": {
										"width": "{percent}%",
										"height": "100%",
										"borderRadius": "999px",
										"background": {
											"ttMap": {
												"arg": "percent",
												"values": {
													"0": "#ff0072",
													"1": "#ff0072",
													"2": "#ff0072",
													"3": "#ff0072",
													"4": "#ff0072",
													"5": "#ff0072",
													"6": "#ff0072",
													"7": "#ff0072",
													"8": "#ff0072",
													"9": "#ff0072",
													"10": "#ff0072",
													"11": "#ff0072",
													"12": "#ff0072",
													"13": "#ff0072",
													"14": "#ff0072",
													"15": "#ff0072"
												},
												"default": "#22c55e"
											}
										}
									}
								}
							}
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"width": "4px",
								"height": "8px",
								"borderRadius": "2px",
								"background": "#1a192b",
								"flexShrink": 0
							}
						}
					}
				]
			},
			{
				"ttIf": {
					"arg": "charging",
					"then": {
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "10px",
								"color": "#6f6e77"
							}
						},
						"children": [
							"Time to full {time}"
						]
					}
				}
			}
		]
	},
	"version": 1,
	"familyKey": "automotive-battery",
	"source": {
		"kind": "archetype",
		"archetype": "automotive",
		"variant": "battery",
		"tranche": 2
	}
}
