{
	"slug": "reactflow-data-viz-line",
	"name": "Line Chart",
	"library": "reactflow",
	"category": "data-display",
	"description": "Mini line chart in the React Flow style — a tone-colored svg trend polyline with an optional translucent area fill, end-point dot, and min/max captions under the plot.",
	"tags": [
		"chart",
		"line",
		"trend",
		"area"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Active users",
			"label": "Title",
			"maxLength": 32
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "area",
			"type": "boolean",
			"default": true,
			"label": "Area fill"
		},
		{
			"name": "min",
			"type": "string",
			"default": "Low 14",
			"label": "Min caption",
			"maxLength": 16
		},
		{
			"name": "max",
			"type": "string",
			"default": "High 86",
			"label": "Max caption",
			"maxLength": 16
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"width": "232px",
				"boxSizing": "border-box",
				"padding": "14px 16px",
				"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
				"background": "#ffffff",
				"border": "1px solid #1a192b",
				"borderRadius": "5px",
				"boxShadow": "0 1px 2px rgba(26, 25, 43, 0.08)"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"marginBottom": "10px"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "12px",
								"fontWeight": 600,
								"color": "#1a192b"
							}
						},
						"children": [
							"{title}"
						]
					}
				]
			},
			{
				"tag": "svg",
				"props": {
					"width": 200,
					"height": 80,
					"viewBox": "0 0 160 64",
					"xmlns": "http://www.w3.org/2000/svg"
				},
				"children": [
					{
						"ttIf": {
							"arg": "area",
							"then": {
								"tag": "polygon",
								"props": {
									"points": "4,48 28,36 52,42 76,26 100,32 124,14 152,20 152,60 4,60",
									"fill": {
										"ttMap": {
											"arg": "tone",
											"values": {
												"primary": "rgba(26, 25, 43, 0.18)",
												"success": "rgba(34, 197, 94, 0.18)",
												"warning": "rgba(234, 179, 8, 0.18)",
												"danger": "rgba(255, 0, 114, 0.18)",
												"info": "rgba(120, 75, 232, 0.18)",
												"neutral": "rgba(111, 110, 119, 0.18)"
											},
											"default": "rgba(26, 25, 43, 0.18)"
										}
									}
								}
							}
						}
					},
					{
						"tag": "line",
						"props": {
							"x1": 4,
							"y1": 60,
							"x2": 156,
							"y2": 60,
							"stroke": "#e2e2e5",
							"strokeWidth": 1
						}
					},
					{
						"tag": "polyline",
						"props": {
							"points": "4,48 28,36 52,42 76,26 100,32 124,14 152,20",
							"fill": "none",
							"stroke": {
								"ttMap": {
									"arg": "tone",
									"values": {
										"primary": "#1a192b",
										"success": "#22c55e",
										"warning": "#eab308",
										"danger": "#ff0072",
										"info": "#784be8",
										"neutral": "#6f6e77"
									},
									"default": "#1a192b"
								}
							},
							"strokeWidth": 2.5,
							"strokeLinecap": "round",
							"strokeLinejoin": "round"
						}
					},
					{
						"tag": "circle",
						"props": {
							"cx": 152,
							"cy": 20,
							"r": 3.5,
							"fill": {
								"ttMap": {
									"arg": "tone",
									"values": {
										"primary": "#1a192b",
										"success": "#22c55e",
										"warning": "#eab308",
										"danger": "#ff0072",
										"info": "#784be8",
										"neutral": "#6f6e77"
									},
									"default": "#1a192b"
								}
							},
							"stroke": "#ffffff",
							"strokeWidth": 1.5
						}
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"justifyContent": "space-between",
						"marginTop": "4px",
						"fontSize": "10px",
						"color": "#6f6e77"
					}
				},
				"children": [
					{
						"tag": "span",
						"children": [
							"{min}"
						]
					},
					{
						"tag": "span",
						"children": [
							"{max}"
						]
					}
				]
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "data-viz",
		"variant": "line",
		"tranche": 2
	}
}
