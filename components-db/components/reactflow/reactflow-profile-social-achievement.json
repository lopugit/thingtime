{
	"slug": "reactflow-profile-social-achievement",
	"name": "Achievement Tile",
	"library": "reactflow",
	"category": "social",
	"description": "Achievement badge tile in the React Flow style — a star or zap emblem in a tone-soft circle with a tone border, title, and a progress bar with percent and 'x of y' captions.",
	"tags": [
		"profile",
		"achievement",
		"progress",
		"gamification",
		"social"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Streak Master",
			"label": "Title",
			"maxLength": 32
		},
		{
			"name": "icon",
			"type": "enum",
			"values": [
				"star",
				"zap"
			],
			"default": "star",
			"label": "Icon"
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "percent",
			"type": "number",
			"default": 60,
			"label": "Progress %",
			"min": 0,
			"max": 100
		},
		{
			"name": "done",
			"type": "number",
			"default": 3,
			"label": "Done",
			"min": 0
		},
		{
			"name": "total",
			"type": "number",
			"default": 5,
			"label": "Total",
			"min": 1
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"background": "#ffffff",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "#1a192b",
				"borderRadius": "8px",
				"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
				"boxShadow": "0 1px 2px rgba(26, 25, 43, 0.08)",
				"width": "216px",
				"display": "flex",
				"flexDirection": "column",
				"alignItems": "center",
				"textAlign": "center",
				"padding": "18px 16px",
				"boxSizing": "border-box"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"width": "48px",
						"height": "48px",
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "center",
						"borderRadius": "999px",
						"background": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#f4f4f5",
									"success": "#f0fdf4",
									"warning": "#fefce8",
									"danger": "#ffe4f1",
									"info": "#f1ecfd",
									"neutral": "#f4f4f5"
								},
								"default": "#f4f4f5"
							}
						},
						"borderWidth": "1px",
						"borderStyle": "solid",
						"borderColor": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#1a192b",
									"success": "#86efac",
									"warning": "#fde047",
									"danger": "#ff77b3",
									"info": "#c4b5fd",
									"neutral": "#b1b1b7"
								},
								"default": "#1a192b"
							}
						},
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#1a192b",
									"success": "#15803d",
									"warning": "#a16207",
									"danger": "#c00055",
									"info": "#5b21b6",
									"neutral": "#3f3e4a"
								},
								"default": "#1a192b"
							}
						}
					}
				},
				"children": [
					{
						"ttIf": {
							"arg": "icon",
							"equals": "zap",
							"then": {
								"tag": "svg",
								"props": {
									"width": 22,
									"height": 22,
									"viewBox": "0 0 24 24",
									"fill": "none",
									"stroke": "currentColor",
									"strokeWidth": 2,
									"strokeLinecap": "round",
									"strokeLinejoin": "round",
									"xmlns": "http://www.w3.org/2000/svg"
								},
								"children": [
									{
										"tag": "polygon",
										"props": {
											"points": "13 2 3 14 12 14 11 22 21 10 12 10 13 2"
										}
									}
								]
							},
							"else": {
								"tag": "svg",
								"props": {
									"width": 22,
									"height": 22,
									"viewBox": "0 0 24 24",
									"fill": "none",
									"stroke": "currentColor",
									"strokeWidth": 2,
									"strokeLinejoin": "round",
									"xmlns": "http://www.w3.org/2000/svg"
								},
								"children": [
									{
										"tag": "polygon",
										"props": {
											"points": "12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26"
										}
									}
								]
							}
						}
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"marginTop": "10px",
						"fontSize": "12px",
						"fontWeight": 600,
						"color": "#1a192b"
					}
				},
				"children": [
					"{title}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"marginTop": "12px",
						"width": "100%",
						"height": "6px",
						"borderRadius": "999px",
						"background": "#e2e2e5",
						"overflow": "hidden"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"width": "{percent}%",
								"height": "100%",
								"borderRadius": "999px",
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#1a192b",
											"success": "#22c55e",
											"warning": "#eab308",
											"danger": "#ff0072",
											"info": "#784be8",
											"neutral": "#6f6e77"
										},
										"default": "#1a192b"
									}
								}
							}
						}
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"marginTop": "8px",
						"width": "100%",
						"justifyContent": "space-between"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "10px",
								"color": "#6f6e77"
							}
						},
						"children": [
							"{done} of {total}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "10px",
								"fontWeight": 600,
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#1a192b",
											"success": "#15803d",
											"warning": "#a16207",
											"danger": "#c00055",
											"info": "#5b21b6",
											"neutral": "#3f3e4a"
										},
										"default": "#1a192b"
									}
								}
							}
						},
						"children": [
							"{percent}%"
						]
					}
				]
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "profile-social",
		"variant": "achievement",
		"tranche": 2
	}
}
