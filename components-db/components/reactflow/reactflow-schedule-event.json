{
	"slug": "reactflow-schedule-event",
	"name": "Calendar Event Card",
	"library": "reactflow",
	"category": "scheduling",
	"description": "Calendar event card in the React Flow style — tone-colored left rail beside the title and time range, a map-pin location caption, overlapping attendee avatars with a +N chip and an optional join button.",
	"tags": [
		"calendar",
		"event",
		"card",
		"meeting"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Design sync",
			"label": "Title",
			"maxLength": 40
		},
		{
			"name": "time",
			"type": "string",
			"default": "9:00 – 9:45 AM",
			"label": "Time range",
			"maxLength": 32
		},
		{
			"name": "location",
			"type": "string",
			"default": "Studio 4 · Level 2",
			"label": "Location",
			"maxLength": 40
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "extra",
			"type": "number",
			"default": 3,
			"label": "Extra attendees",
			"min": 0,
			"max": 99
		},
		{
			"name": "join",
			"type": "boolean",
			"default": true,
			"label": "Join button"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"width": "300px",
				"gap": "10px",
				"padding": "14px 16px",
				"boxSizing": "border-box",
				"background": "#ffffff",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "#1a192b",
				"borderLeftWidth": "4px",
				"borderLeftColor": {
					"ttMap": {
						"arg": "tone",
						"values": {
							"primary": "#1a192b",
							"success": "#22c55e",
							"warning": "#eab308",
							"danger": "#ff0072",
							"info": "#784be8",
							"neutral": "#6f6e77"
						},
						"default": "#1a192b"
					}
				},
				"borderRadius": "5px",
				"boxShadow": "0 1px 2px rgba(26, 25, 43, 0.08)",
				"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"gap": "2px"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "12px",
								"fontWeight": 600,
								"color": "#1a192b"
							}
						},
						"children": [
							"{title}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "12px",
								"color": "#6f6e77"
							}
						},
						"children": [
							"{time}"
						]
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "6px",
						"color": "#6f6e77",
						"fontSize": "12px"
					}
				},
				"children": [
					{
						"tag": "svg",
						"props": {
							"width": 14,
							"height": 14,
							"viewBox": "0 0 24 24",
							"fill": "none",
							"stroke": "#b1b1b7",
							"strokeWidth": 2,
							"strokeLinecap": "round",
							"strokeLinejoin": "round",
							"xmlns": "http://www.w3.org/2000/svg"
						},
						"children": [
							{
								"tag": "path",
								"props": {
									"d": "M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"
								}
							},
							{
								"tag": "circle",
								"props": {
									"cx": 12,
									"cy": 10,
									"r": 3
								}
							}
						]
					},
					"{location}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "8px"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"width": "26px",
								"height": "26px",
								"borderRadius": "999px",
								"background": "#f1ecfd",
								"color": "#5b21b6",
								"display": "flex",
								"alignItems": "center",
								"justifyContent": "center",
								"fontWeight": 600,
								"fontSize": "10px",
								"flexShrink": 0
							}
						},
						"children": [
							"AK"
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"width": "26px",
								"height": "26px",
								"borderRadius": "999px",
								"background": "#f0fdf4",
								"color": "#15803d",
								"display": "flex",
								"alignItems": "center",
								"justifyContent": "center",
								"fontWeight": 600,
								"fontSize": "10px",
								"flexShrink": 0,
								"marginLeft": "-8px",
								"boxShadow": "0 0 0 2px #ffffff"
							}
						},
						"children": [
							"JR"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"height": "26px",
								"minWidth": "26px",
								"padding": "0 6px",
								"boxSizing": "border-box",
								"marginLeft": "-8px",
								"boxShadow": "0 0 0 2px #ffffff",
								"borderRadius": "999px",
								"background": "#f4f4f5",
								"color": "#6f6e77",
								"display": "inline-flex",
								"alignItems": "center",
								"justifyContent": "center",
								"fontSize": "10px",
								"fontWeight": 600
							}
						},
						"children": [
							"+{extra}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"flex": 1
							}
						}
					},
					{
						"ttIf": {
							"arg": "join",
							"then": {
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"height": "24px",
										"padding": "0 12px",
										"border": "none",
										"borderRadius": "3px",
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#1a192b",
													"success": "#22c55e",
													"warning": "#eab308",
													"danger": "#ff0072",
													"info": "#784be8",
													"neutral": "#6f6e77"
												},
												"default": "#1a192b"
											}
										},
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#ffffff",
													"success": "#ffffff",
													"warning": "#ffffff",
													"danger": "#ffffff",
													"info": "#ffffff",
													"neutral": "#ffffff"
												},
												"default": "#ffffff"
											}
										},
										"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
										"fontSize": "12px",
										"fontWeight": 500,
										"cursor": "pointer"
									}
								},
								"children": [
									"Join"
								]
							}
						}
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "schedule-event",
	"source": {
		"kind": "archetype",
		"archetype": "schedule",
		"variant": "event",
		"tranche": 2
	}
}
