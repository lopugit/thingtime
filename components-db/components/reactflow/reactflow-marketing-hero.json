{
	"slug": "reactflow-marketing-hero",
	"name": "Hero Section",
	"library": "reactflow",
	"category": "marketing",
	"description": "Centered landing hero in the React Flow style — display heading, supporting subtext, and a solid + outline button pair on React Flow tone, radius, and type tokens.",
	"tags": [
		"marketing",
		"hero",
		"landing",
		"section"
	],
	"args": [
		{
			"name": "heading",
			"type": "string",
			"default": "Ship your ideas faster",
			"label": "Heading",
			"maxLength": 60
		},
		{
			"name": "subtext",
			"type": "text",
			"default": "Everything you need to design, build, and launch — in one calm workspace.",
			"label": "Subtext",
			"maxLength": 160
		},
		{
			"name": "primaryLabel",
			"type": "string",
			"default": "Get started",
			"label": "Primary button",
			"maxLength": 30
		},
		{
			"name": "secondaryLabel",
			"type": "string",
			"default": "View demo",
			"label": "Secondary button",
			"maxLength": 30
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "section",
		"props": {
			"style": {
				"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
				"background": "#ffffff",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "#e2e2e5",
				"borderRadius": "8px",
				"boxShadow": "0 2px 6px rgba(26, 25, 43, 0.12)",
				"padding": "44px 36px",
				"display": "flex",
				"flexDirection": "column",
				"alignItems": "center",
				"textAlign": "center",
				"gap": "12px",
				"maxWidth": "560px",
				"boxSizing": "border-box"
			}
		},
		"children": [
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "30px",
						"fontWeight": 600,
						"color": "#1a192b",
						"lineHeight": 1.15,
						"letterSpacing": "-0.02em"
					}
				},
				"children": [
					"{heading}"
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "14px",
						"color": "#6f6e77",
						"lineHeight": 1.55,
						"maxWidth": "420px"
					}
				},
				"children": [
					"{subtext}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "10px",
						"marginTop": "8px",
						"justifyContent": "center",
						"flexWrap": "wrap"
					}
				},
				"children": [
					{
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"display": "inline-flex",
								"alignItems": "center",
								"justifyContent": "center",
								"gap": "8px",
								"border": "none",
								"height": "30px",
								"padding": "0 18px",
								"borderRadius": "5px",
								"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
								"fontWeight": 500,
								"fontSize": "12px",
								"cursor": "pointer",
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#1a192b",
											"success": "#22c55e",
											"warning": "#eab308",
											"danger": "#ff0072",
											"info": "#784be8",
											"neutral": "#6f6e77"
										},
										"default": "#1a192b"
									}
								},
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#ffffff",
											"success": "#ffffff",
											"warning": "#ffffff",
											"danger": "#ffffff",
											"info": "#ffffff",
											"neutral": "#ffffff"
										},
										"default": "#ffffff"
									}
								},
								"boxShadow": "0 1px 2px rgba(26, 25, 43, 0.08)"
							}
						},
						"children": [
							"{primaryLabel}"
						]
					},
					{
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"display": "inline-flex",
								"alignItems": "center",
								"justifyContent": "center",
								"gap": "8px",
								"border": "none",
								"height": "30px",
								"padding": "0 18px",
								"borderRadius": "5px",
								"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
								"fontWeight": 500,
								"fontSize": "12px",
								"cursor": "pointer",
								"background": "transparent",
								"borderWidth": "1px",
								"borderStyle": "solid",
								"borderColor": "#1a192b",
								"color": "#1a192b"
							}
						},
						"children": [
							"{secondaryLabel}"
						]
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "marketing-hero",
	"source": {
		"kind": "archetype",
		"archetype": "marketing",
		"variant": "hero",
		"tranche": 1
	}
}
