{
	"slug": "reactflow-media-player-mini",
	"name": "Mini Player",
	"library": "reactflow",
	"category": "media",
	"description": "Compact now-playing bar in the React Flow style — tiny tinted artwork, ellipsized track title over a thin tone progress line, and a play/pause toggle button.",
	"tags": [
		"media",
		"audio",
		"mini",
		"now-playing"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Night Drive — Neon Waves",
			"label": "Title",
			"maxLength": 48
		},
		{
			"name": "percent",
			"type": "number",
			"default": 64,
			"label": "Progress %",
			"min": 0,
			"max": 100
		},
		{
			"name": "playing",
			"type": "boolean",
			"default": true,
			"label": "Playing"
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
