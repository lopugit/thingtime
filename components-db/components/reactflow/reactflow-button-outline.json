{
	"slug": "reactflow-button-outline",
	"name": "Outline Button",
	"library": "reactflow",
	"category": "buttons",
	"description": "Bordered secondary button in the React Flow style — transparent body, tone-colored border and label.",
	"tags": [
		"button",
		"action",
		"outline"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Learn more",
			"label": "Label",
			"maxLength": 40
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "size",
			"type": "enum",
			"values": [
				"sm",
				"md",
				"lg"
			],
			"default": "md",
			"label": "Size"
		},
		{
			"name": "disabled",
			"type": "boolean",
			"default": false,
			"label": "Disabled"
		}
	],
	"render": {
		"tag": "button",
		"props": {
			"type": "button",
			"style": {
				"ttMerge": [
					{
						"display": "inline-flex",
						"alignItems": "center",
						"justifyContent": "center",
						"gap": "8px",
						"border": "none",
						"borderRadius": "5px",
						"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
						"fontWeight": 500,
						"cursor": "pointer"
					},
					{
						"ttMap": {
							"arg": "size",
							"values": {
								"sm": {
									"height": "24px",
									"padding": "0 12px",
									"fontSize": "12px"
								},
								"md": {
									"height": "30px",
									"padding": "0 16px",
									"fontSize": "12px"
								},
								"lg": {
									"height": "38px",
									"padding": "0 20px",
									"fontSize": "14px"
								}
							},
							"default": {
								"height": "30px",
								"padding": "0 16px",
								"fontSize": "12px"
							}
						}
					},
					{
						"background": "transparent",
						"borderWidth": "1px",
						"borderStyle": "solid",
						"borderColor": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#1a192b",
									"success": "#22c55e",
									"warning": "#eab308",
									"danger": "#ff0072",
									"info": "#784be8",
									"neutral": "#6f6e77"
								},
								"default": "#1a192b"
							}
						},
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#1a192b",
									"success": "#22c55e",
									"warning": "#eab308",
									"danger": "#ff0072",
									"info": "#784be8",
									"neutral": "#6f6e77"
								},
								"default": "#1a192b"
							}
						}
					},
					{
						"ttIf": {
							"arg": "disabled",
							"then": {
								"opacity": 0.5,
								"cursor": "not-allowed"
							},
							"else": {}
						}
					}
				]
			}
		},
		"children": [
			"{label}"
		]
	},
	"version": 1,
	"familyKey": "button-outline",
	"source": {
		"kind": "archetype",
		"archetype": "button",
		"variant": "outline",
		"tranche": 1
	}
}
