{
	"slug": "reactflow-empty-states-onboarding",
	"name": "Onboarding CTA",
	"library": "reactflow",
	"category": "feedback",
	"description": "Onboarding call-to-action panel in the React Flow style — welcome heading, numbered step dots hinting at the setup flow, and a solid tone start button.",
	"tags": [
		"onboarding",
		"empty-state",
		"steps",
		"cta"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Welcome to your workspace",
			"label": "Title",
			"maxLength": 50
		},
		{
			"name": "body",
			"type": "text",
			"default": "A few quick steps and you’re up and running.",
			"label": "Body"
		},
		{
			"name": "ctaLabel",
			"type": "string",
			"default": "Start setup",
			"label": "CTA label",
			"maxLength": 32
		},
		{
			"name": "steps",
			"type": "number",
			"default": 3,
			"label": "Steps",
			"min": 2,
			"max": 6
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"alignItems": "center",
				"justifyContent": "center",
				"textAlign": "center",
				"gap": "6px",
				"width": "360px",
				"padding": "40px 28px",
				"background": "#ffffff",
				"borderRadius": "8px",
				"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
				"color": "#1a192b",
				"border": "1px solid #1a192b",
				"boxShadow": "0 0 0 0.5px #1a192b, 0 3px 10px rgba(26, 25, 43, 0.15)"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"width": "46px",
						"height": "46px",
						"borderRadius": "999px",
						"background": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#f4f4f5",
									"success": "#f0fdf4",
									"warning": "#fefce8",
									"danger": "#ffe4f1",
									"info": "#f1ecfd",
									"neutral": "#f4f4f5"
								},
								"default": "#f4f4f5"
							}
						},
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#1a192b",
									"success": "#15803d",
									"warning": "#a16207",
									"danger": "#c00055",
									"info": "#5b21b6",
									"neutral": "#3f3e4a"
								},
								"default": "#1a192b"
							}
						},
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "center",
						"marginBottom": "4px"
					}
				},
				"children": [
					{
						"tag": "svg",
						"props": {
							"width": 20,
							"height": 20,
							"viewBox": "0 0 24 24",
							"fill": "none",
							"stroke": "currentColor",
							"strokeWidth": 2,
							"strokeLinecap": "round",
							"strokeLinejoin": "round",
							"xmlns": "http://www.w3.org/2000/svg"
						},
						"children": [
							{
								"tag": "polygon",
								"props": {
									"points": "13 2 3 14 12 14 11 22 21 10 12 10 13 2"
								}
							}
						]
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontWeight": 600,
						"fontSize": "16px"
					}
				},
				"children": [
					"{title}"
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "12px",
						"color": "#6f6e77",
						"lineHeight": 1.5,
						"maxWidth": "270px"
					}
				},
				"children": [
					"{body}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "8px",
						"marginTop": "10px",
						"justifyContent": "center"
					}
				},
				"children": [
					{
						"ttRepeat": {
							"arg": "steps",
							"max": 6,
							"node": {
								"tag": "div",
								"props": {
									"style": {
										"width": "24px",
										"height": "24px",
										"borderRadius": "999px",
										"display": "flex",
										"alignItems": "center",
										"justifyContent": "center",
										"fontSize": "10px",
										"fontWeight": 600,
										"background": {
											"ttIf": {
												"arg": "n",
												"equals": 1,
												"then": {
													"ttMap": {
														"arg": "tone",
														"values": {
															"primary": "#1a192b",
															"success": "#22c55e",
															"warning": "#eab308",
															"danger": "#ff0072",
															"info": "#784be8",
															"neutral": "#6f6e77"
														},
														"default": "#1a192b"
													}
												},
												"else": "#f4f4f5"
											}
										},
										"color": {
											"ttIf": {
												"arg": "n",
												"equals": 1,
												"then": {
													"ttMap": {
														"arg": "tone",
														"values": {
															"primary": "#ffffff",
															"success": "#ffffff",
															"warning": "#ffffff",
															"danger": "#ffffff",
															"info": "#ffffff",
															"neutral": "#ffffff"
														},
														"default": "#ffffff"
													}
												},
												"else": "#6f6e77"
											}
										}
									}
								},
								"children": [
									"{n}"
								]
							}
						}
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "10px",
						"color": "#b1b1b7"
					}
				},
				"children": [
					"Step 1 of {steps}"
				]
			},
			{
				"tag": "button",
				"props": {
					"type": "button",
					"style": {
						"display": "inline-flex",
						"alignItems": "center",
						"justifyContent": "center",
						"height": "30px",
						"padding": "0 18px",
						"border": "none",
						"borderRadius": "3px",
						"background": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#1a192b",
									"success": "#22c55e",
									"warning": "#eab308",
									"danger": "#ff0072",
									"info": "#784be8",
									"neutral": "#6f6e77"
								},
								"default": "#1a192b"
							}
						},
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#ffffff",
									"success": "#ffffff",
									"warning": "#ffffff",
									"danger": "#ffffff",
									"info": "#ffffff",
									"neutral": "#ffffff"
								},
								"default": "#ffffff"
							}
						},
						"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
						"fontSize": "12px",
						"fontWeight": 500,
						"boxShadow": "0 1px 2px rgba(26, 25, 43, 0.08)",
						"cursor": "pointer",
						"marginTop": "8px"
					}
				},
				"children": [
					"{ctaLabel}"
				]
			}
		]
	},
	"previewBg": "#f8f8f8",
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "empty-states",
		"variant": "onboarding",
		"tranche": 1
	}
}
