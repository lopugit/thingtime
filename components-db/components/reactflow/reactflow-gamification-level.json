{
	"slug": "reactflow-gamification-level",
	"name": "Level Emblem",
	"library": "reactflow",
	"category": "engagement",
	"description": "Level emblem in the React Flow style — a hexagonal badge filled with the tone color, edged with the flow accent, and the level number overlaid, above a title caption and a next-level XP hint.",
	"tags": [
		"gamification",
		"level",
		"badge",
		"emblem"
	],
	"args": [
		{
			"name": "level",
			"type": "number",
			"default": 12,
			"label": "Level",
			"min": 1
		},
		{
			"name": "title",
			"type": "string",
			"default": "Gold Tier",
			"label": "Title",
			"maxLength": 24
		},
		{
			"name": "next",
			"type": "string",
			"default": "2,500",
			"label": "Next-level XP",
			"maxLength": 10
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "inline-flex",
				"flexDirection": "column",
				"alignItems": "center",
				"gap": "8px",
				"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"position": "relative",
						"width": "64px",
						"height": "72px"
					}
				},
				"children": [
					{
						"tag": "svg",
						"props": {
							"width": 64,
							"height": 72,
							"viewBox": "0 0 64 72",
							"fill": {
								"ttMap": {
									"arg": "tone",
									"values": {
										"primary": "#1a192b",
										"success": "#22c55e",
										"warning": "#eab308",
										"danger": "#ff0072",
										"info": "#784be8",
										"neutral": "#6f6e77"
									},
									"default": "#1a192b"
								}
							},
							"xmlns": "http://www.w3.org/2000/svg",
							"stroke": "#ff0072",
							"strokeWidth": 2
						},
						"children": [
							{
								"tag": "polygon",
								"props": {
									"points": "32 2 60 19 60 53 32 70 4 53 4 19"
								}
							}
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"position": "absolute",
								"top": "0px",
								"left": "0px",
								"width": "100%",
								"height": "100%",
								"display": "flex",
								"alignItems": "center",
								"justifyContent": "center",
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#ffffff",
											"success": "#ffffff",
											"warning": "#ffffff",
											"danger": "#ffffff",
											"info": "#ffffff",
											"neutral": "#ffffff"
										},
										"default": "#ffffff"
									}
								},
								"fontSize": "22px",
								"fontWeight": 600
							}
						},
						"children": [
							"{level}"
						]
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "12px",
						"fontWeight": 600,
						"color": "#1a192b"
					}
				},
				"children": [
					"{title}"
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "10px",
						"color": "#6f6e77"
					}
				},
				"children": [
					"Next level at {next} XP"
				]
			}
		]
	},
	"version": 1,
	"familyKey": "gamification-level",
	"source": {
		"kind": "archetype",
		"archetype": "gamification",
		"variant": "level",
		"tranche": 2
	}
}
