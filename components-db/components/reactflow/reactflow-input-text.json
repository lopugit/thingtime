{
	"slug": "reactflow-input-text",
	"name": "Text Input",
	"library": "reactflow",
	"category": "forms",
	"description": "Plain single-line text field in the React Flow style — label, placeholder and helper hint on the library's control height and radius.",
	"tags": [
		"input",
		"text",
		"field",
		"form"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Email",
			"label": "Label",
			"maxLength": 40
		},
		{
			"name": "placeholder",
			"type": "string",
			"default": "you@example.com",
			"label": "Placeholder",
			"maxLength": 60
		},
		{
			"name": "size",
			"type": "enum",
			"values": [
				"sm",
				"md",
				"lg"
			],
			"default": "md",
			"label": "Size"
		},
		{
			"name": "hint",
			"type": "string",
			"default": "We will never share it.",
			"label": "Hint",
			"maxLength": 80
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"gap": "6px",
				"width": "260px",
				"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
			}
		},
		"children": [
			{
				"tag": "label",
				"props": {
					"style": {
						"fontSize": "12px",
						"fontWeight": 500,
						"color": "#1a192b",
						"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
					}
				},
				"children": [
					"{label}"
				]
			},
			{
				"tag": "input",
				"props": {
					"type": "text",
					"placeholder": "{placeholder}",
					"style": {
						"ttMerge": [
							{
								"width": "100%",
								"padding": "0 12px",
								"border": "1px solid #e2e2e5",
								"borderRadius": "5px",
								"background": "#ffffff",
								"color": "#1a192b",
								"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
								"outline": "none",
								"boxSizing": "border-box"
							},
							{
								"ttMap": {
									"arg": "size",
									"values": {
										"sm": {
											"height": "24px",
											"fontSize": "12px"
										},
										"md": {
											"height": "30px",
											"fontSize": "12px"
										},
										"lg": {
											"height": "38px",
											"fontSize": "14px"
										}
									},
									"default": {
										"height": "30px",
										"fontSize": "12px"
									}
								}
							}
						]
					}
				}
			},
			{
				"ttIf": {
					"arg": "hint",
					"then": {
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "10px",
								"color": "#6f6e77"
							}
						},
						"children": [
							"{hint}"
						]
					}
				}
			}
		]
	},
	"version": 1,
	"familyKey": "input-text",
	"source": {
		"kind": "archetype",
		"archetype": "input",
		"variant": "text",
		"tranche": 1
	}
}
