{
	"slug": "reactflow-loading-loading-button",
	"name": "Loading Button",
	"library": "reactflow",
	"category": "feedback",
	"description": "Busy-state button in the React Flow style — an inline arc spinner beside the label, in solid or quiet tinted form.",
	"tags": [
		"loading",
		"button",
		"spinner",
		"busy"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Saving…",
			"label": "Label",
			"maxLength": 40
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "size",
			"type": "enum",
			"values": [
				"sm",
				"md",
				"lg"
			],
			"default": "md",
			"label": "Size"
		},
		{
			"name": "quiet",
			"type": "boolean",
			"default": false,
			"label": "Quiet (tinted)"
		}
	],
	"render": {
		"tag": "button",
		"props": {
			"type": "button",
			"style": {
				"ttMerge": [
					{
						"display": "inline-flex",
						"alignItems": "center",
						"justifyContent": "center",
						"gap": "8px",
						"border": "none",
						"borderRadius": "5px",
						"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
						"fontWeight": 500,
						"cursor": "wait",
						"opacity": 0.9
					},
					{
						"ttMap": {
							"arg": "size",
							"values": {
								"sm": {
									"height": "24px",
									"padding": "0 12px",
									"fontSize": "12px"
								},
								"md": {
									"height": "30px",
									"padding": "0 16px",
									"fontSize": "12px"
								},
								"lg": {
									"height": "38px",
									"padding": "0 20px",
									"fontSize": "14px"
								}
							},
							"default": {
								"height": "30px",
								"padding": "0 16px",
								"fontSize": "12px"
							}
						}
					},
					{
						"background": {
							"ttIf": {
								"arg": "quiet",
								"then": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#f4f4f5",
											"success": "#f0fdf4",
											"warning": "#fefce8",
											"danger": "#ffe4f1",
											"info": "#f1ecfd",
											"neutral": "#f4f4f5"
										},
										"default": "#f4f4f5"
									}
								},
								"else": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#1a192b",
											"success": "#22c55e",
											"warning": "#eab308",
											"danger": "#ff0072",
											"info": "#784be8",
											"neutral": "#6f6e77"
										},
										"default": "#1a192b"
									}
								}
							}
						},
						"color": {
							"ttIf": {
								"arg": "quiet",
								"then": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#1a192b",
											"success": "#15803d",
											"warning": "#a16207",
											"danger": "#c00055",
											"info": "#5b21b6",
											"neutral": "#3f3e4a"
										},
										"default": "#1a192b"
									}
								},
								"else": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#ffffff",
											"success": "#ffffff",
											"warning": "#ffffff",
											"danger": "#ffffff",
											"info": "#ffffff",
											"neutral": "#ffffff"
										},
										"default": "#ffffff"
									}
								}
							}
						},
						"boxShadow": "0 1px 2px rgba(26, 25, 43, 0.08)"
					}
				]
			}
		},
		"children": [
			{
				"tag": "svg",
				"props": {
					"width": 16,
					"height": 16,
					"viewBox": "0 0 24 24",
					"fill": "none",
					"xmlns": "http://www.w3.org/2000/svg"
				},
				"children": [
					{
						"tag": "circle",
						"props": {
							"cx": 12,
							"cy": 12,
							"r": 10,
							"stroke": "currentColor",
							"strokeWidth": 3,
							"style": {
								"opacity": 0.3
							}
						}
					},
					{
						"tag": "path",
						"props": {
							"d": "M12 2a10 10 0 1 1-10 10",
							"stroke": "currentColor",
							"strokeWidth": 3,
							"strokeLinecap": "round"
						}
					}
				]
			},
			"{label}"
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "loading",
		"variant": "loading-button",
		"tranche": 1
	}
}
