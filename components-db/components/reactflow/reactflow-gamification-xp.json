{
	"slug": "reactflow-gamification-xp",
	"name": "XP Progress",
	"library": "reactflow",
	"category": "engagement",
	"description": "XP progress card in the React Flow style — a Level chip, a tone-colored bar with a marker handle riding the fill edge, and an XP-to-next-level caption.",
	"tags": [
		"gamification",
		"xp",
		"progress",
		"level"
	],
	"args": [
		{
			"name": "level",
			"type": "number",
			"default": 7,
			"label": "Level",
			"min": 1
		},
		{
			"name": "percent",
			"type": "number",
			"default": 68,
			"label": "Progress (0–100)",
			"min": 0,
			"max": 100
		},
		{
			"name": "xp",
			"type": "string",
			"default": "1,250",
			"label": "XP remaining",
			"maxLength": 10
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"width": "260px",
				"padding": "16px",
				"boxSizing": "border-box",
				"background": "#ffffff",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "#1a192b",
				"borderRadius": "8px",
				"boxShadow": "0 1px 2px rgba(26, 25, 43, 0.08)",
				"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
				"gap": "12px"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "space-between",
						"gap": "12px"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"display": "inline-flex",
								"alignItems": "center",
								"padding": "2px 10px",
								"borderRadius": "999px",
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#f4f4f5",
											"success": "#f0fdf4",
											"warning": "#fefce8",
											"danger": "#ffe4f1",
											"info": "#f1ecfd",
											"neutral": "#f4f4f5"
										},
										"default": "#f4f4f5"
									}
								},
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#1a192b",
											"success": "#15803d",
											"warning": "#a16207",
											"danger": "#c00055",
											"info": "#5b21b6",
											"neutral": "#3f3e4a"
										},
										"default": "#1a192b"
									}
								},
								"fontSize": "10px",
								"fontWeight": 700
							}
						},
						"children": [
							"Level {level}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "12px",
								"fontWeight": 600,
								"color": "#6f6e77",
								"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
							}
						},
						"children": [
							"{percent}%"
						]
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"position": "relative",
						"height": "10px",
						"borderRadius": "999px",
						"background": "#e2e2e5"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"width": "{percent}%",
								"maxWidth": "100%",
								"height": "100%",
								"borderRadius": "999px",
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#1a192b",
											"success": "#22c55e",
											"warning": "#eab308",
											"danger": "#ff0072",
											"info": "#784be8",
											"neutral": "#6f6e77"
										},
										"default": "#1a192b"
									}
								}
							}
						}
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"position": "absolute",
								"top": "-3px",
								"left": "calc({percent}% - 8px)",
								"width": "16px",
								"height": "16px",
								"boxSizing": "border-box",
								"borderRadius": "2px",
								"background": "#ffffff",
								"borderWidth": "2px",
								"borderStyle": "solid",
								"borderColor": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#1a192b",
											"success": "#22c55e",
											"warning": "#eab308",
											"danger": "#ff0072",
											"info": "#784be8",
											"neutral": "#6f6e77"
										},
										"default": "#1a192b"
									}
								},
								"boxShadow": "0 1px 2px rgba(26, 25, 43, 0.08)"
							}
						}
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "10px",
						"color": "#6f6e77"
					}
				},
				"children": [
					"{xp} XP to next level"
				]
			}
		]
	},
	"version": 1,
	"familyKey": "gamification-xp",
	"source": {
		"kind": "archetype",
		"archetype": "gamification",
		"variant": "xp",
		"tranche": 2
	}
}
