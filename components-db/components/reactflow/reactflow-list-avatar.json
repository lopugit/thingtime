{
	"slug": "reactflow-list-avatar",
	"name": "Avatar List",
	"library": "reactflow",
	"category": "data-display",
	"description": "Avatar-and-name list rows in the React Flow style — tone-tinted initials circles beside names, a faint recency mark trailing each row.",
	"tags": [
		"list",
		"avatar",
		"people",
		"data"
	],
	"args": [
		{
			"name": "name",
			"type": "string",
			"default": "Alex Rivers",
			"label": "Name",
			"maxLength": 40
		},
		{
			"name": "initials",
			"type": "string",
			"default": "AR",
			"label": "Initials",
			"maxLength": 3
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "count",
			"type": "number",
			"default": 3,
			"label": "Rows",
			"min": 1,
			"max": 6
		}
	],
	"render": {
		"tag": "ul",
		"props": {
			"style": {
				"ttMerge": [
					{
						"listStyle": "none",
						"margin": 0,
						"padding": 0,
						"width": "280px",
						"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
						"color": "#1a192b",
						"background": "#ffffff",
						"borderRadius": "5px",
						"overflow": "hidden"
					},
					{
						"border": "1px solid #1a192b",
						"boxShadow": "0 1px 2px rgba(26, 25, 43, 0.08)"
					}
				]
			}
		},
		"children": [
			{
				"ttRepeat": {
					"arg": "count",
					"max": 6,
					"node": {
						"tag": "li",
						"props": {
							"style": {
								"ttMerge": [
									{
										"display": "flex",
										"alignItems": "center",
										"gap": "12px",
										"padding": "10px 14px",
										"fontSize": "12px"
									},
									{
										"ttIf": {
											"arg": "n",
											"equals": 1,
											"then": {},
											"else": {
												"borderTop": "1px dashed #e2e2e5"
											}
										}
									}
								]
							}
						},
						"children": [
							{
								"tag": "div",
								"props": {
									"style": {
										"width": "32px",
										"height": "32px",
										"borderRadius": "999px",
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#f4f4f5",
													"success": "#f0fdf4",
													"warning": "#fefce8",
													"danger": "#ffe4f1",
													"info": "#f1ecfd",
													"neutral": "#f4f4f5"
												},
												"default": "#f4f4f5"
											}
										},
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#1a192b",
													"success": "#15803d",
													"warning": "#a16207",
													"danger": "#c00055",
													"info": "#5b21b6",
													"neutral": "#3f3e4a"
												},
												"default": "#1a192b"
											}
										},
										"display": "flex",
										"alignItems": "center",
										"justifyContent": "center",
										"fontWeight": 600,
										"fontSize": "10px",
										"flexShrink": 0
									}
								},
								"children": [
									"{initials}"
								]
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"fontWeight": 500,
										"flexGrow": 1
									}
								},
								"children": [
									"{name}"
								]
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"color": "#b1b1b7",
										"fontSize": "10px"
									}
								},
								"children": [
									"{n}h"
								]
							}
						]
					}
				}
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "list",
		"variant": "avatar",
		"tranche": 1
	}
}
