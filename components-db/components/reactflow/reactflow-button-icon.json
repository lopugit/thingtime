{
	"slug": "reactflow-button-icon",
	"name": "Icon Button",
	"library": "reactflow",
	"category": "buttons",
	"description": "Button with a leading icon in the React Flow style — a plus glyph beside the label, optional icon-only square mode.",
	"tags": [
		"button",
		"action",
		"icon"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "New item",
			"label": "Label",
			"maxLength": 40
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "iconOnly",
			"type": "boolean",
			"default": false,
			"label": "Icon only"
		},
		{
			"name": "disabled",
			"type": "boolean",
			"default": false,
			"label": "Disabled"
		}
	],
	"render": {
		"tag": "button",
		"props": {
			"type": "button",
			"style": {
				"ttMerge": [
					{
						"display": "inline-flex",
						"alignItems": "center",
						"justifyContent": "center",
						"gap": "8px",
						"border": "none",
						"borderRadius": "5px",
						"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
						"fontWeight": 500,
						"cursor": "pointer"
					},
					{
						"height": "30px",
						"fontSize": "12px",
						"padding": {
							"ttIf": {
								"arg": "iconOnly",
								"then": "0",
								"else": "0 16px"
							}
						},
						"width": {
							"ttIf": {
								"arg": "iconOnly",
								"then": "30px",
								"else": "auto"
							}
						},
						"background": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#1a192b",
									"success": "#22c55e",
									"warning": "#eab308",
									"danger": "#ff0072",
									"info": "#784be8",
									"neutral": "#6f6e77"
								},
								"default": "#1a192b"
							}
						},
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#ffffff",
									"success": "#ffffff",
									"warning": "#ffffff",
									"danger": "#ffffff",
									"info": "#ffffff",
									"neutral": "#ffffff"
								},
								"default": "#ffffff"
							}
						},
						"boxShadow": "0 1px 2px rgba(26, 25, 43, 0.08)"
					},
					{
						"ttIf": {
							"arg": "disabled",
							"then": {
								"opacity": 0.5,
								"cursor": "not-allowed"
							},
							"else": {}
						}
					}
				]
			}
		},
		"children": [
			{
				"tag": "svg",
				"props": {
					"width": 16,
					"height": 16,
					"viewBox": "0 0 24 24",
					"fill": "none",
					"stroke": "currentColor",
					"strokeWidth": 2,
					"strokeLinecap": "round",
					"strokeLinejoin": "round",
					"xmlns": "http://www.w3.org/2000/svg"
				},
				"children": [
					{
						"tag": "line",
						"props": {
							"x1": 12,
							"y1": 5,
							"x2": 12,
							"y2": 19
						}
					},
					{
						"tag": "line",
						"props": {
							"x1": 5,
							"y1": 12,
							"x2": 19,
							"y2": 12
						}
					}
				]
			},
			{
				"ttIf": {
					"arg": "iconOnly",
					"then": "",
					"else": "{label}"
				}
			}
		]
	},
	"version": 1,
	"familyKey": "button-icon",
	"source": {
		"kind": "archetype",
		"archetype": "button",
		"variant": "icon",
		"tranche": 1
	}
}
