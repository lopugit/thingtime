{
	"slug": "reactflow-chat-typing",
	"name": "Typing Indicator",
	"library": "reactflow",
	"category": "messaging",
	"description": "Incoming typing indicator in the React Flow style — an initials avatar beside a quiet bubble holding three muted dots, with a name-is-typing caption underneath.",
	"tags": [
		"chat",
		"typing",
		"indicator",
		"presence"
	],
	"args": [
		{
			"name": "name",
			"type": "string",
			"default": "Alex",
			"label": "Name",
			"maxLength": 24
		},
		{
			"name": "initials",
			"type": "string",
			"default": "AX",
			"label": "Avatar initials",
			"maxLength": 3
		},
		{
			"name": "showAvatar",
			"type": "boolean",
			"default": true,
			"label": "Show avatar"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"alignItems": "flex-end",
				"gap": "8px",
				"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
			}
		},
		"children": [
			{
				"ttIf": {
					"arg": "showAvatar",
					"then": {
						"tag": "div",
						"props": {
							"style": {
								"width": "28px",
								"height": "28px",
								"borderRadius": "999px",
								"background": "#f4f4f5",
								"color": "#3f3e4a",
								"display": "flex",
								"alignItems": "center",
								"justifyContent": "center",
								"fontWeight": 600,
								"fontSize": "10px",
								"flexShrink": 0
							}
						},
						"children": [
							"{initials}"
						]
					}
				}
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"gap": "4px"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"padding": "11px 12px",
								"maxWidth": "220px",
								"fontSize": "12px",
								"lineHeight": 1.45,
								"background": "#f4f4f5",
								"color": "#1a192b",
								"borderRadius": "3px 3px 3px 2px",
								"borderWidth": "1px",
								"borderStyle": "solid",
								"borderColor": "#1a192b",
								"display": "inline-flex",
								"alignItems": "center",
								"gap": "4px",
								"width": "fit-content"
							}
						},
						"children": [
							{
								"ttRepeat": {
									"count": 3,
									"max": 3,
									"node": {
										"tag": "span",
										"props": {
											"style": {
												"width": "7px",
												"height": "7px",
												"borderRadius": "999px",
												"background": "#b1b1b7"
											}
										}
									}
								}
							}
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "10px",
								"color": "#6f6e77"
							}
						},
						"children": [
							"{name} is typing…"
						]
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "chat-typing",
	"source": {
		"kind": "archetype",
		"archetype": "chat",
		"variant": "typing",
		"tranche": 2
	}
}
