						"children": [
							{
								"tag": "svg",
								"props": {
									"width": 16,
									"height": 16,
									"viewBox": "0 0 24 24",
									"fill": "none",
									"stroke": "currentColor",
									"strokeWidth": 2,
									"strokeLinecap": "round",
									"strokeLinejoin": "round",
									"xmlns": "http://www.w3.org/2000/svg"
								},
								"children": [
									{
										"tag": "polyline",
