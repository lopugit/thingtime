{
	"slug": "reactflow-support-help-faq",
	"name": "FAQ Accordion",
	"library": "reactflow",
	"category": "support",
	"description": "Help-center FAQ accordion in the React Flow style — three question rows with chevrons, the first expandable into its answer with a \"was this helpful\" yes/no ghost pair.",
	"tags": [
		"support",
		"faq",
		"accordion",
		"help"
