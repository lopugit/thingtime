{
	"slug": "reactflow-stat-metric-sparkline",
	"name": "Sparkline Stat",
	"library": "reactflow",
	"category": "data-display",
	"description": "Stat card with an inline svg polyline sparkline in the React Flow style — tone-colored stroke with an optional soft area fill under the line.",
	"tags": [
		"stat",
		"sparkline",
		"chart",
		"svg"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Weekly sessions",
			"label": "Label",
			"maxLength": 40
		},
		{
			"name": "value",
			"type": "string",
			"default": "4,732",
			"label": "Value",
			"maxLength": 20
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "filled",
			"type": "boolean",
			"default": true,
			"label": "Area fill"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "inline-flex",
				"flexDirection": "column",
				"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
				"background": "#ffffff",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "#e2e2e5",
				"borderRadius": "8px",
				"boxShadow": "0 1px 2px rgba(26, 25, 43, 0.08)",
				"boxSizing": "border-box",
				"padding": "16px 20px",
				"gap": "10px",
				"minWidth": "200px"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"gap": "4px"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "10px",
								"fontWeight": 400,
								"color": "#6f6e77"
							}
						},
						"children": [
							"{label}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "24px",
								"fontWeight": 600,
								"color": "#1a192b",
								"lineHeight": 1.15,
								"fontVariantNumeric": "tabular-nums"
							}
						},
						"children": [
							"{value}"
						]
					}
				]
			},
			{
				"tag": "svg",
				"props": {
					"width": 128,
					"height": 32,
					"viewBox": "0 0 128 32",
					"fill": "none",
					"xmlns": "http://www.w3.org/2000/svg"
				},
				"children": [
					{
						"ttIf": {
							"arg": "filled",
							"then": {
								"tag": "polygon",
								"props": {
									"points": "0 26 16 20 32 24 48 12 64 17 80 8 96 14 112 4 128 10 128 32 0 32",
									"fill": {
										"ttMap": {
											"arg": "tone",
											"values": {
												"primary": "#f4f4f5",
												"success": "#f0fdf4",
												"warning": "#fefce8",
												"danger": "#ffe4f1",
												"info": "#f1ecfd",
												"neutral": "#f4f4f5"
											},
											"default": "#f4f4f5"
										}
									}
								}
							}
						}
					},
					{
						"tag": "polyline",
						"props": {
							"points": "0 26 16 20 32 24 48 12 64 17 80 8 96 14 112 4 128 10",
							"stroke": {
								"ttMap": {
									"arg": "tone",
									"values": {
										"primary": "#1a192b",
										"success": "#22c55e",
										"warning": "#eab308",
										"danger": "#ff0072",
										"info": "#784be8",
										"neutral": "#6f6e77"
									},
									"default": "#1a192b"
								}
							},
							"strokeWidth": 2,
							"strokeLinecap": "round",
							"strokeLinejoin": "round"
						}
					}
				]
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "stat-metric",
		"variant": "sparkline",
		"tranche": 1
	}
}
