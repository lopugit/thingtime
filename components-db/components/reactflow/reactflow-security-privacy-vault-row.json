{
	"slug": "reactflow-security-privacy-vault-row",
	"name": "Vault Password Row",
	"library": "reactflow",
	"category": "security",
	"description": "Password-manager vault row in the React Flow style — favicon initial tile, site and username captions, a strength dot, last-changed note, copy/reveal ghosts, and a reused-password warning chip.",
	"tags": [
		"security",
		"password",
		"vault",
		"row"
	],
	"args": [
		{
			"name": "site",
			"type": "string",
			"default": "github.com",
			"label": "Site",
			"maxLength": 40
		},
		{
			"name": "initial",
			"type": "string",
			"default": "G",
			"label": "Favicon initial",
			"maxLength": 2
		},
		{
			"name": "username",
			"type": "string",
			"default": "nikolaj@thingtime.com",
			"label": "Username",
			"maxLength": 60
		},
		{
			"name": "strength",
			"type": "enum",
			"values": [
				"weak",
				"fair",
				"strong"
			],
			"default": "strong",
			"label": "Strength"
		},
		{
			"name": "reused",
			"type": "boolean",
			"default": false,
			"label": "Reused password"
		},
		{
			"name": "changed",
			"type": "string",
			"default": "3 mo ago",
			"label": "Last changed",
			"maxLength": 20
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"alignItems": "center",
				"gap": "12px",
				"width": "400px",
				"boxSizing": "border-box",
				"padding": "10px 14px",
				"background": "#ffffff",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "#1a192b",
				"borderRadius": "5px",
				"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
				"boxShadow": "0 1px 2px rgba(26, 25, 43, 0.08)"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"width": "36px",
						"height": "36px",
						"borderRadius": "3px",
						"background": "#f4f4f5",
						"color": "#1a192b",
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "center",
						"fontWeight": 600,
						"fontSize": "12px",
						"flexShrink": 0
					}
				},
				"children": [
					"{initial}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"gap": "2px",
						"minWidth": 0,
						"flex": 1
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"gap": "8px"
							}
						},
						"children": [
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "12px",
										"fontWeight": 600,
										"color": "#1a192b"
									}
								},
								"children": [
									"{site}"
								]
							},
							{
								"ttIf": {
									"arg": "reused",
									"then": {
										"tag": "span",
										"props": {
											"style": {
												"background": "#fefce8",
												"color": "#a16207",
												"fontSize": "10px",
												"fontWeight": 600,
												"padding": "1px 8px",
												"borderRadius": "999px",
												"whiteSpace": "nowrap"
											}
										},
										"children": [
											"Reused"
										]
									}
								}
							}
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "10px",
								"color": "#6f6e77"
							}
						},
						"children": [
							"{username}"
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"gap": "6px"
							}
						},
						"children": [
							{
								"tag": "span",
								"props": {
									"style": {
										"width": "7px",
										"height": "7px",
										"borderRadius": "999px",
										"background": {
											"ttMap": {
												"arg": "strength",
												"values": {
													"weak": "#ff0072",
													"fair": "#eab308",
													"strong": "#22c55e"
												},
												"default": "#22c55e"
											}
										},
										"flexShrink": 0
									}
								}
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "10px",
										"fontWeight": 600,
										"color": {
											"ttMap": {
												"arg": "strength",
												"values": {
													"weak": "#ff0072",
													"fair": "#eab308",
													"strong": "#22c55e"
												},
												"default": "#22c55e"
											}
										},
										"textTransform": "capitalize"
									}
								},
								"children": [
									"{strength}"
								]
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "10px",
										"color": "#b1b1b7"
									}
								},
								"children": [
									"· Updated {changed}"
								]
							}
						]
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "2px",
						"marginLeft": "auto",
						"flexShrink": 0
					}
				},
				"children": [
					{
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"background": "transparent",
								"border": "none",
								"color": "#6f6e77",
								"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
								"fontSize": "10px",
								"fontWeight": 600,
								"cursor": "pointer",
								"padding": "4px 8px",
								"borderRadius": "3px",
								"whiteSpace": "nowrap"
							}
						},
						"children": [
							"Copy"
						]
					},
					{
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"background": "transparent",
								"border": "none",
								"color": "#ff0072",
								"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
								"fontSize": "10px",
								"fontWeight": 600,
								"cursor": "pointer",
								"padding": "4px 8px",
								"borderRadius": "3px",
								"whiteSpace": "nowrap"
							}
						},
						"children": [
							"Reveal"
						]
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "security-privacy-vault-row",
	"source": {
		"kind": "archetype",
		"archetype": "security-privacy",
		"variant": "vault-row",
		"tranche": 2
	}
}
