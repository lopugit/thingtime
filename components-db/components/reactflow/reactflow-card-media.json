{
	"slug": "reactflow-card-media",
	"name": "Media Card",
	"library": "reactflow",
	"category": "layout",
	"description": "Card with a media block in the React Flow style — a tone-gradient placeholder banner over a badge, title and body.",
	"tags": [
		"card",
		"media",
		"image",
		"banner"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Golden hour",
			"label": "Title",
			"maxLength": 60
		},
		{
			"name": "body",
			"type": "text",
			"default": "A placeholder media block stands in for imagery — no external assets needed.",
			"label": "Body"
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "mediaHeight",
			"type": "enum",
			"values": [
				"sm",
				"md",
				"lg"
			],
			"default": "md",
			"label": "Media height"
		},
		{
			"name": "badge",
			"type": "string",
			"default": "New",
			"label": "Badge",
			"maxLength": 20
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"width": "300px",
				"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
				"background": "#ffffff",
				"color": "#1a192b",
				"border": "1px solid #1a192b",
				"borderRadius": "5px",
				"boxShadow": "0 1px 2px rgba(26, 25, 43, 0.08)",
				"overflow": "hidden",
				"boxSizing": "border-box"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"ttMerge": [
							{
								"display": "flex",
								"alignItems": "center",
								"justifyContent": "center",
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "linear-gradient(135deg, #f4f4f5 0%, #1a192b 60%, #1a192b 140%)",
											"success": "linear-gradient(135deg, #f0fdf4 0%, #86efac 60%, #22c55e 140%)",
											"warning": "linear-gradient(135deg, #fefce8 0%, #fde047 60%, #eab308 140%)",
											"danger": "linear-gradient(135deg, #ffe4f1 0%, #ff77b3 60%, #ff0072 140%)",
											"info": "linear-gradient(135deg, #f1ecfd 0%, #c4b5fd 60%, #784be8 140%)",
											"neutral": "linear-gradient(135deg, #f4f4f5 0%, #b1b1b7 60%, #6f6e77 140%)"
										},
										"default": "linear-gradient(135deg, #f4f4f5 0%, #1a192b 60%, #1a192b 140%)"
									}
								}
							},
							{
								"ttMap": {
									"arg": "mediaHeight",
									"values": {
										"sm": {
											"height": "72px"
										},
										"md": {
											"height": "112px"
										},
										"lg": {
											"height": "152px"
										}
									},
									"default": {
										"height": "112px"
									}
								}
							}
						]
					}
				},
				"children": [
					{
						"tag": "svg",
						"props": {
							"width": 28,
							"height": 28,
							"viewBox": "0 0 24 24",
							"fill": "none",
							"stroke": {
								"ttMap": {
									"arg": "tone",
									"values": {
										"primary": "#1a192b",
										"success": "#15803d",
										"warning": "#a16207",
										"danger": "#c00055",
										"info": "#5b21b6",
										"neutral": "#3f3e4a"
									},
									"default": "#1a192b"
								}
							},
							"strokeWidth": 2,
							"strokeLinecap": "round",
							"strokeLinejoin": "round",
							"xmlns": "http://www.w3.org/2000/svg"
						},
						"children": [
							{
								"tag": "rect",
								"props": {
									"x": 3,
									"y": 3,
									"width": 18,
									"height": 18,
									"rx": 2
								}
							},
							{
								"tag": "circle",
								"props": {
									"cx": 8.5,
									"cy": 8.5,
									"r": 1.5
								}
							},
							{
								"tag": "polyline",
								"props": {
									"points": "21 15 16 10 5 21"
								}
							}
						]
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"padding": "16px",
						"gap": "8px"
					}
				},
				"children": [
					{
						"ttIf": {
							"arg": "badge",
							"then": {
								"tag": "span",
								"props": {
									"style": {
										"alignSelf": "flex-start",
										"padding": "2px 8px",
										"borderRadius": "999px",
										"fontSize": "10px",
										"fontWeight": 600,
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#f4f4f5",
													"success": "#f0fdf4",
													"warning": "#fefce8",
													"danger": "#ffe4f1",
													"info": "#f1ecfd",
													"neutral": "#f4f4f5"
												},
												"default": "#f4f4f5"
											}
										},
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#1a192b",
													"success": "#15803d",
													"warning": "#a16207",
													"danger": "#c00055",
													"info": "#5b21b6",
													"neutral": "#3f3e4a"
												},
												"default": "#1a192b"
											}
										},
										"border": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "1px solid #1a192b",
													"success": "1px solid #86efac",
													"warning": "1px solid #fde047",
													"danger": "1px solid #ff77b3",
													"info": "1px solid #c4b5fd",
													"neutral": "1px solid #b1b1b7"
												},
												"default": "1px solid #1a192b"
											}
										}
									}
								},
								"children": [
									"{badge}"
								]
							}
						}
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "14px",
								"fontWeight": 600,
								"color": "#1a192b"
							}
						},
						"children": [
							"{title}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "12px",
								"color": "#6f6e77",
								"lineHeight": 1.5
							}
						},
						"children": [
							"{body}"
						]
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "card-media",
	"source": {
		"kind": "archetype",
		"archetype": "card",
		"variant": "media",
		"tranche": 1
	}
}
