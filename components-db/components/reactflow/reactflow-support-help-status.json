{
	"slug": "reactflow-support-help-status",
	"name": "Incident Status Banner",
	"library": "reactflow",
	"category": "support",
	"description": "Incident status banner in the React Flow style — state dot and tint flip between operational, degraded, and outage, with subscribe and details actions plus a shimmer bar during incidents.",
	"tags": [
		"support",
		"status",
		"incident",
		"banner",
		"uptime"
	],
	"args": [
		{
			"name": "system",
			"type": "string",
			"default": "API",
			"label": "System",
			"maxLength": 24
		},
		{
			"name": "state",
			"type": "enum",
			"values": [
				"operational",
				"degraded",
				"outage"
			],
			"default": "degraded",
			"label": "State"
		},
		{
			"name": "ago",
			"type": "string",
			"default": "4 min ago",
			"label": "Updated",
			"maxLength": 16
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"gap": "6px",
				"width": "340px",
				"padding": "12px 14px",
				"boxSizing": "border-box",
				"background": {
					"ttMap": {
						"arg": "state",
						"values": {
							"operational": "#f0fdf4",
							"degraded": "#fefce8",
							"outage": "#ffe4f1"
						},
						"default": "#f0fdf4"
					}
				},
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": {
					"ttMap": {
						"arg": "state",
						"values": {
							"operational": "#86efac",
							"degraded": "#fde047",
							"outage": "#ff77b3"
						},
						"default": "#86efac"
					}
				},
				"borderRadius": "5px",
				"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "8px"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"width": "10px",
								"height": "10px",
								"borderRadius": "999px",
								"flexShrink": 0,
								"background": {
									"ttMap": {
										"arg": "state",
										"values": {
											"operational": "#22c55e",
											"degraded": "#eab308",
											"outage": "#ff0072"
										},
										"default": "#22c55e"
									}
								}
							}
						}
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "12px",
								"fontWeight": 600,
								"textTransform": "capitalize",
								"color": {
									"ttMap": {
										"arg": "state",
										"values": {
											"operational": "#15803d",
											"degraded": "#a16207",
											"outage": "#c00055"
										},
										"default": "#15803d"
									}
								}
							}
						},
						"children": [
							"{system} — {state}"
						]
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "10px",
						"color": "#6f6e77",
						"paddingLeft": "18px"
					}
				},
				"children": [
					"Updated {ago}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "8px",
						"paddingLeft": "10px"
					}
				},
				"children": [
					{
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"background": "transparent",
								"border": "none",
								"cursor": "pointer",
								"padding": "4px 8px",
								"borderRadius": "3px",
								"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
								"fontSize": "10px",
								"fontWeight": 600,
								"color": {
									"ttMap": {
										"arg": "state",
										"values": {
											"operational": "#15803d",
											"degraded": "#a16207",
											"outage": "#c00055"
										},
										"default": "#15803d"
									}
								}
							}
						},
						"children": [
							"Subscribe"
						]
					},
					{
						"tag": "a",
						"props": {
							"href": "#",
							"style": {
								"fontSize": "10px",
								"fontWeight": 600,
								"textDecoration": "underline",
								"color": "#6f6e77",
								"padding": "4px 0"
							}
						},
						"children": [
							"Details"
						]
					}
				]
			},
			{
				"ttIf": {
					"arg": "state",
					"equals": "operational",
					"then": "",
					"else": {
						"tag": "div",
						"props": {
							"style": {
								"height": "4px",
								"borderRadius": "999px",
								"background": "#ffffff",
								"overflow": "hidden",
								"marginTop": "2px"
							}
						},
						"children": [
							{
								"tag": "div",
								"props": {
									"style": {
										"height": "100%",
										"width": "45%",
										"borderRadius": "999px",
										"background": {
											"ttMap": {
												"arg": "state",
												"values": {
													"degraded": "#eab308",
													"outage": "#ff0072"
												},
												"default": "#eab308"
											}
										}
									}
								}
							}
						]
					}
				}
			}
		]
	},
	"version": 1,
	"familyKey": "support-help-status",
	"source": {
		"kind": "archetype",
		"archetype": "support-help",
		"variant": "status",
		"tranche": 2
	}
}
