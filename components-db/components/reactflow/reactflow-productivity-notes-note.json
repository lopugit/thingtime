{
	"slug": "reactflow-productivity-notes-note",
	"name": "Note Card",
	"library": "reactflow",
	"category": "productivity",
	"description": "Pinned note card in the React Flow style — title with edited caption, body preview lines, tag chips, a star pin toggle and a four-dot note-color picker.",
	"tags": [
		"note",
		"card",
		"productivity",
		"pin",
		"tags"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Meeting notes",
			"label": "Title",
			"maxLength": 40
		},
		{
			"name": "edited",
			"type": "string",
			"default": "Edited 2h ago",
			"label": "Edited caption",
			"maxLength": 32
		},
		{
			"name": "tag",
			"type": "string",
			"default": "work",
			"label": "First tag",
			"maxLength": 16
		},
		{
			"name": "pinned",
			"type": "boolean",
			"default": true,
			"label": "Pinned"
		},
		{
			"name": "noteColor",
			"type": "enum",
			"values": [
				"sun",
				"mint",
				"sky",
				"rose"
			],
			"default": "sun",
			"label": "Note color"
		}
