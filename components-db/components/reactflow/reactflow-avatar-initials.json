{
	"slug": "reactflow-avatar-initials",
	"name": "Initials Avatar",
	"library": "reactflow",
	"category": "data-display",
	"description": "Circular initials avatar in the React Flow style — tone-filled disc with library type, optional soft tint and a surface-offset ring.",
	"tags": [
		"avatar",
		"initials",
		"profile"
	],
	"args": [
		{
			"name": "initials",
			"type": "string",
			"default": "NF",
			"label": "Initials",
			"maxLength": 3
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "size",
			"type": "enum",
			"values": [
				"sm",
				"md",
				"lg"
			],
			"default": "md",
			"label": "Size"
		},
		{
			"name": "soft",
			"type": "boolean",
			"default": false,
			"label": "Soft tint"
		},
		{
			"name": "ring",
			"type": "boolean",
			"default": false,
			"label": "Ring"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"ttMerge": [
					{
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "center",
						"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
						"fontWeight": 600,
						"borderRadius": "999px",
						"flexShrink": 0,
						"userSelect": "none"
					},
					{
						"ttMap": {
							"arg": "size",
							"values": {
								"sm": {
									"width": "28px",
									"height": "28px",
									"fontSize": "10px"
								},
								"md": {
									"width": "40px",
									"height": "40px",
									"fontSize": "12px"
								},
								"lg": {
									"width": "56px",
									"height": "56px",
									"fontSize": "14px"
								}
							},
							"default": {
								"width": "40px",
								"height": "40px",
								"fontSize": "12px"
							}
						}
					},
					{
						"ttIf": {
							"arg": "soft",
							"then": {
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#f4f4f5",
											"success": "#f0fdf4",
											"warning": "#fefce8",
											"danger": "#ffe4f1",
											"info": "#f1ecfd",
											"neutral": "#f4f4f5"
										},
										"default": "#f4f4f5"
									}
								},
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#1a192b",
											"success": "#15803d",
											"warning": "#a16207",
											"danger": "#c00055",
											"info": "#5b21b6",
											"neutral": "#3f3e4a"
										},
										"default": "#1a192b"
									}
								},
								"border": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "1px solid #1a192b",
											"success": "1px solid #86efac",
											"warning": "1px solid #fde047",
											"danger": "1px solid #ff77b3",
											"info": "1px solid #c4b5fd",
											"neutral": "1px solid #b1b1b7"
										},
										"default": "1px solid #1a192b"
									}
								}
							},
							"else": {
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#1a192b",
											"success": "#22c55e",
											"warning": "#eab308",
											"danger": "#ff0072",
											"info": "#784be8",
											"neutral": "#6f6e77"
										},
										"default": "#1a192b"
									}
								},
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#ffffff",
											"success": "#ffffff",
											"warning": "#ffffff",
											"danger": "#ffffff",
											"info": "#ffffff",
											"neutral": "#ffffff"
										},
										"default": "#ffffff"
									}
								}
							}
						}
					},
					{
						"ttIf": {
							"arg": "ring",
							"then": {
								"boxShadow": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "0 0 0 2px #ffffff, 0 0 0 4px #1a192b",
											"success": "0 0 0 2px #ffffff, 0 0 0 4px #86efac",
											"warning": "0 0 0 2px #ffffff, 0 0 0 4px #fde047",
											"danger": "0 0 0 2px #ffffff, 0 0 0 4px #ff77b3",
											"info": "0 0 0 2px #ffffff, 0 0 0 4px #c4b5fd",
											"neutral": "0 0 0 2px #ffffff, 0 0 0 4px #b1b1b7"
										},
										"default": "0 0 0 2px #ffffff, 0 0 0 4px #1a192b"
									}
								}
							},
							"else": {}
						}
					}
				]
			}
		},
		"children": [
			"{initials}"
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "avatar",
		"variant": "initials",
		"tranche": 1
	}
}
