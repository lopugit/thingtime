{
	"slug": "reactflow-list-numbered",
	"name": "Numbered List",
	"library": "reactflow",
	"category": "data-display",
	"description": "Ordered list in the React Flow style — hand-styled number markers (square mono chips) on a tone tint beside each row.",
	"tags": [
		"list",
		"numbered",
		"ordered",
		"steps"
	],
	"args": [
		{
			"name": "item",
			"type": "string",
			"default": "Step",
			"label": "Item label",
			"maxLength": 40
		},
		{
			"name": "count",
			"type": "number",
			"default": 4,
			"label": "Rows",
			"min": 1,
			"max": 8
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "divided",
			"type": "boolean",
			"default": true,
			"label": "Dividers"
		}
	],
	"render": {
		"tag": "ol",
		"props": {
			"style": {
				"ttMerge": [
					{
						"listStyle": "none",
						"margin": 0,
						"padding": 0,
						"width": "280px",
						"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
						"color": "#1a192b",
						"background": "#ffffff",
						"borderRadius": "5px",
						"overflow": "hidden"
					},
					{
						"border": "1px solid #1a192b",
						"boxShadow": "0 1px 2px rgba(26, 25, 43, 0.08)"
					}
				]
			}
		},
		"children": [
			{
				"ttRepeat": {
					"arg": "count",
					"max": 8,
					"node": {
						"tag": "li",
						"props": {
							"style": {
								"ttMerge": [
									{
										"display": "flex",
										"alignItems": "center",
										"gap": "12px",
										"padding": "10px 14px",
										"fontSize": "12px"
									},
									{
										"ttIf": {
											"arg": "divided",
											"then": {
												"ttIf": {
													"arg": "n",
													"equals": 1,
													"then": {},
													"else": {
														"borderTop": "1px dashed #e2e2e5"
													}
												}
											},
											"else": {}
										}
									}
								]
							}
						},
						"children": [
							{
								"tag": "div",
								"props": {
									"style": {
										"width": "24px",
										"height": "24px",
										"borderRadius": "2px",
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#f4f4f5",
													"success": "#f0fdf4",
													"warning": "#fefce8",
													"danger": "#ffe4f1",
													"info": "#f1ecfd",
													"neutral": "#f4f4f5"
												},
												"default": "#f4f4f5"
											}
										},
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#1a192b",
													"success": "#15803d",
													"warning": "#a16207",
													"danger": "#c00055",
													"info": "#5b21b6",
													"neutral": "#3f3e4a"
												},
												"default": "#1a192b"
											}
										},
										"display": "flex",
										"alignItems": "center",
										"justifyContent": "center",
										"fontSize": "10px",
										"fontWeight": 700,
										"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
										"flexShrink": 0
									}
								},
								"children": [
									"{n}"
								]
							},
							"{item} {n}"
						]
					}
				}
			}
		]
	},
	"version": 1,
	"familyKey": "list-numbered",
	"source": {
		"kind": "archetype",
		"archetype": "list",
		"variant": "numbered",
		"tranche": 1
	}
}
