{
	"slug": "reactflow-news-reading-headline",
	"name": "Headline Stack",
	"library": "reactflow",
	"category": "content",
	"description": "Headline stack in the React Flow style — an uppercase section chip over a serif lead headline, two bulleted secondary stories with timestamps, and a pink-accent more-from-section link.",
	"tags": [
		"news",
		"headline",
		"section",
		"stories"
	],
	"args": [
		{
			"name": "section",
			"type": "string",
			"default": "Technology",
			"label": "Section",
			"maxLength": 24
		},
		{
			"name": "headline",
			"type": "text",
			"default": "Quantum chips leap from the lab to the laptop",
			"label": "Headline",
			"maxLength": 120
		},
		{
			"name": "sub1",
			"type": "string",
			"default": "Foundries race to package the first consumer wafers",
			"label": "Story 2",
			"maxLength": 80
		},
		{
			"name": "sub2",
			"type": "string",
			"default": "What the breakthrough means for battery life",
			"label": "Story 3",
			"maxLength": 80
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"width": "300px",
				"gap": "10px",
				"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
			}
		},
		"children": [
			{
				"tag": "span",
				"props": {
					"style": {
						"alignSelf": "flex-start",
						"padding": "3px 9px",
						"borderRadius": "3px",
						"background": "#ffe4f1",
						"color": "#ff0072",
						"fontSize": "10px",
						"fontWeight": 700,
						"textTransform": "uppercase",
						"letterSpacing": "0.07em"
					}
				},
				"children": [
					"{section}"
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontFamily": "Georgia, 'Times New Roman', serif",
						"fontSize": "16px",
						"fontWeight": 700,
						"lineHeight": 1.25,
						"color": "#1a192b"
					}
				},
				"children": [
					"{headline}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"gap": "7px",
						"paddingTop": "9px",
						"borderTopWidth": "1px",
						"borderTopStyle": "solid",
						"borderTopColor": "#e2e2e5"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"gap": "8px"
							}
						},
						"children": [
							{
								"tag": "span",
								"props": {
									"style": {
										"width": "5px",
										"height": "5px",
										"borderRadius": "999px",
										"background": "#ff0072",
										"flexShrink": 0
									}
								}
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"flex": 1,
										"minWidth": 0,
										"fontSize": "12px",
										"fontWeight": 600,
										"color": "#1a192b",
										"whiteSpace": "nowrap",
										"overflow": "hidden",
										"textOverflow": "ellipsis"
									}
								},
								"children": [
									"{sub1}"
								]
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "10px",
										"color": "#b1b1b7",
										"flexShrink": 0
									}
								},
								"children": [
									"2h ago"
								]
							}
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"gap": "8px"
							}
						},
						"children": [
							{
								"tag": "span",
								"props": {
									"style": {
										"width": "5px",
										"height": "5px",
										"borderRadius": "999px",
										"background": "#ff0072",
										"flexShrink": 0
									}
								}
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"flex": 1,
										"minWidth": 0,
										"fontSize": "12px",
										"fontWeight": 600,
										"color": "#1a192b",
										"whiteSpace": "nowrap",
										"overflow": "hidden",
										"textOverflow": "ellipsis"
									}
								},
								"children": [
									"{sub2}"
								]
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "10px",
										"color": "#b1b1b7",
										"flexShrink": 0
									}
								},
								"children": [
									"5h ago"
								]
							}
						]
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "12px",
						"fontWeight": 600,
						"color": "#ff0072"
					}
				},
				"children": [
					"More {section} →"
				]
			}
		]
	},
	"version": 1,
	"familyKey": "news-reading-headline",
	"source": {
		"kind": "archetype",
		"archetype": "news-reading",
		"variant": "headline",
		"tranche": 2
	}
}
