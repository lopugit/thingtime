			"name": "heading",
			"type": "string",
			"default": "Danger zone",
			"label": "Heading",
			"maxLength": 30
		},
		{
			"name": "warning",
			"type": "text",
			"default": "Deleting this workspace removes every project, member, and file. This cannot be undone.",
			"label": "Warning copy",
			"maxLength": 160
		},
		{
			"name": "phrase",
			"type": "string",
			"default": "acme/workspace",
			"label": "Confirm phrase",
			"maxLength": 40
		}
	],
	"render": {
