						"padding": "10px 14px",
						"background": "#ffe4f1"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "12px",
								"fontWeight": 600,
								"color": "#c00055"
							}
						},
						"children": [
							"{heading}"
						]
					}
				]
			},
			{
				"tag": "div",
