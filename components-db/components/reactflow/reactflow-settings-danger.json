				"borderStyle": "solid",
				"borderColor": "#ff77b3",
				"borderRadius": "5px",
				"boxShadow": "none",
				"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
				"overflow": "hidden"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
