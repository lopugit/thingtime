{
	"slug": "reactflow-settings-danger",
	"name": "Danger Zone",
	"library": "reactflow",
	"category": "settings",
	"description": "Danger-zone settings card in the React Flow style — danger-tinted border and header, warning copy, a confirm-phrase field mock, and an outline-danger delete button beside a ghost cancel.",
	"tags": [
		"settings",
		"danger",
		"delete",
		"confirm"
	],
	"args": [
