{
	"slug": "reactflow-empty-states-success",
	"name": "Success State",
	"library": "reactflow",
	"category": "feedback",
	"description": "Success / complete panel in the React Flow style — check circle in a soft tone bubble, congratulatory title and message, and an optional continue button.",
	"tags": [
		"success",
		"complete",
		"empty-state",
		"feedback"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "You’re all set",
			"label": "Title",
			"maxLength": 50
		},
		{
			"name": "message",
			"type": "text",
			"default": "Your workspace is ready. Invite your team or jump straight in.",
			"label": "Message"
		},
		{
			"name": "ctaLabel",
			"type": "string",
			"default": "Go to dashboard",
			"label": "CTA label",
			"maxLength": 32
		},
		{
			"name": "showCta",
			"type": "boolean",
			"default": true,
			"label": "Show CTA"
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"success",
				"primary",
				"info"
			],
			"default": "success",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"alignItems": "center",
				"justifyContent": "center",
				"textAlign": "center",
				"gap": "6px",
				"width": "340px",
				"padding": "36px 24px",
				"background": "#ffffff",
				"borderRadius": "8px",
				"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
				"color": "#1a192b",
				"border": "1px solid #1a192b",
				"boxShadow": "0 2px 6px rgba(26, 25, 43, 0.12)"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"width": "46px",
						"height": "46px",
						"borderRadius": "999px",
						"background": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#f4f4f5",
									"success": "#f0fdf4",
									"warning": "#fefce8",
									"danger": "#ffe4f1",
									"info": "#f1ecfd",
									"neutral": "#f4f4f5"
								},
								"default": "#f4f4f5"
							}
						},
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#1a192b",
									"success": "#22c55e",
									"warning": "#eab308",
									"danger": "#ff0072",
									"info": "#784be8",
									"neutral": "#6f6e77"
								},
								"default": "#1a192b"
							}
						},
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "center",
						"marginBottom": "4px"
					}
				},
				"children": [
					{
						"tag": "svg",
						"props": {
							"width": 22,
							"height": 22,
							"viewBox": "0 0 24 24",
							"fill": "none",
							"stroke": "currentColor",
							"strokeWidth": 2,
							"strokeLinecap": "round",
							"strokeLinejoin": "round",
							"xmlns": "http://www.w3.org/2000/svg"
						},
						"children": [
							{
								"tag": "polyline",
								"props": {
									"points": "20 6 9 17 4 12"
								}
							}
						]
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontWeight": 600,
						"fontSize": "14px"
					}
				},
				"children": [
					"{title}"
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "12px",
						"color": "#6f6e77",
						"lineHeight": 1.5,
						"maxWidth": "250px"
					}
				},
				"children": [
					"{message}"
				]
			},
			{
				"ttIf": {
					"arg": "showCta",
