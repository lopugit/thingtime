						"props": {
							"type": "button",
							"style": {
								"display": "inline-flex",
								"alignItems": "center",
								"justifyContent": "center",
								"height": "30px",
								"padding": "0 18px",
								"border": "none",
								"borderRadius": "3px",
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#1a192b",
											"success": "#22c55e",
											"warning": "#eab308",
											"danger": "#ff0072",
											"info": "#784be8",
											"neutral": "#6f6e77"
										},
										"default": "#1a192b"
									}
								},
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#ffffff",
											"success": "#ffffff",
											"warning": "#ffffff",
											"danger": "#ffffff",
											"info": "#ffffff",
											"neutral": "#ffffff"
										},
										"default": "#ffffff"
									}
								},
								"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
								"fontSize": "12px",
								"fontWeight": 500,
								"boxShadow": "0 1px 2px rgba(26, 25, 43, 0.08)",
								"cursor": "pointer",
								"marginTop": "10px"
							}
						},
						"children": [
							"{ctaLabel}"
						]
					}
				}
			}
		]
	},
	"previewBg": "#f8f8f8",
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "empty-states",
		"variant": "success",
		"tranche": 1
	}
}
