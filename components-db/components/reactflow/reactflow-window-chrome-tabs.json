{
	"slug": "reactflow-window-chrome-tabs",
	"name": "Editor Tabs",
	"library": "reactflow",
	"category": "mockups",
	"description": "Editor tab strip in the React Flow style — an active file tab with a tone topline and close x, two resting tabs, an optional plus tab, and a breadcrumb path row.",
	"tags": [
		"mockup",
		"tabs",
		"editor",
		"ide",
		"frame"
	],
	"args": [
		{
			"name": "file",
			"type": "string",
			"default": "App.tsx",
			"label": "Active file",
			"maxLength": 24
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "plusTab",
			"type": "boolean",
			"default": true,
			"label": "Show + tab"
		},
		{
			"name": "path",
			"type": "string",
			"default": "src / components",
			"label": "Breadcrumb path",
			"maxLength": 40
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"width": "340px",
				"maxWidth": "100%",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "#1a192b",
				"borderRadius": "8px",
				"background": "#ffffff",
				"overflow": "hidden",
				"boxShadow": "0 2px 6px rgba(26, 25, 43, 0.12)",
				"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "flex-end",
						"gap": "2px",
						"padding": "6px 8px 0",
						"background": "#f4f4f5",
						"borderBottomWidth": "1px",
						"borderBottomStyle": "solid",
						"borderBottomColor": "#1a192b"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"gap": "8px",
								"padding": "6px 10px",
								"background": "#ffffff",
								"borderTopLeftRadius": "2px",
								"borderTopRightRadius": "2px",
								"fontSize": "10px",
								"fontWeight": 600,
								"color": "#1a192b",
								"flexShrink": 0,
								"borderTopWidth": "2px",
								"borderTopStyle": "solid",
								"borderTopColor": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#1a192b",
											"success": "#22c55e",
											"warning": "#eab308",
											"danger": "#ff0072",
											"info": "#784be8",
											"neutral": "#6f6e77"
										},
										"default": "#1a192b"
									}
								}
							}
						},
						"children": [
							"{file}",
							{
								"tag": "svg",
								"props": {
									"width": 10,
									"height": 10,
									"viewBox": "0 0 24 24",
									"fill": "none",
									"stroke": "#6f6e77",
									"strokeWidth": 2,
									"strokeLinecap": "round",
									"strokeLinejoin": "round",
									"xmlns": "http://www.w3.org/2000/svg"
								},
								"children": [
									{
										"tag": "line",
										"props": {
											"x1": 18,
											"y1": 6,
											"x2": 6,
											"y2": 18
										}
									},
									{
										"tag": "line",
										"props": {
											"x1": 6,
											"y1": 6,
											"x2": 18,
											"y2": 18
										}
									}
								]
							}
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"gap": "6px",
								"padding": "6px 10px",
								"fontSize": "10px",
								"color": "#6f6e77",
								"flexShrink": 0
							}
						},
						"children": [
							"index.ts"
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"gap": "6px",
								"padding": "6px 10px",
								"fontSize": "10px",
								"color": "#6f6e77",
								"flexShrink": 0
							}
						},
						"children": [
							"styles.css"
						]
					},
					{
						"ttIf": {
							"arg": "plusTab",
							"then": {
								"tag": "div",
								"props": {
									"style": {
										"display": "flex",
										"alignItems": "center",
										"padding": "6px 8px",
										"flexShrink": 0
									}
								},
								"children": [
									{
										"tag": "svg",
										"props": {
											"width": 12,
											"height": 12,
											"viewBox": "0 0 24 24",
											"fill": "none",
											"stroke": "#6f6e77",
											"strokeWidth": 2,
											"strokeLinecap": "round",
											"strokeLinejoin": "round",
											"xmlns": "http://www.w3.org/2000/svg"
										},
										"children": [
											{
												"tag": "line",
												"props": {
													"x1": 12,
													"y1": 5,
													"x2": 12,
													"y2": 19
												}
											},
											{
												"tag": "line",
												"props": {
													"x1": 5,
													"y1": 12,
													"x2": 19,
													"y2": 12
												}
											}
										]
									}
								]
							}
						}
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "6px",
						"padding": "7px 10px",
						"fontSize": "10px",
						"color": "#6f6e77",
						"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
					}
				},
				"children": [
					"{path}",
					{
						"tag": "svg",
						"props": {
							"width": 10,
							"height": 10,
							"viewBox": "0 0 24 24",
							"fill": "none",
							"stroke": "#b1b1b7",
							"strokeWidth": 2,
							"strokeLinecap": "round",
							"strokeLinejoin": "round",
							"xmlns": "http://www.w3.org/2000/svg"
						},
						"children": [
							{
								"tag": "polyline",
								"props": {
									"points": "9 6 15 12 9 18"
								}
							}
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"color": "#1a192b",
								"fontWeight": 600
							}
						},
						"children": [
							"{file}"
						]
					}
				]
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "window-chrome",
		"variant": "tabs",
		"tranche": 2
	}
}
