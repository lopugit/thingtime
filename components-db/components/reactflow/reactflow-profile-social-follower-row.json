{
	"slug": "reactflow-profile-social-follower-row",
	"name": "Follower Row",
	"library": "reactflow",
	"category": "social",
	"description": "Follower list row in the React Flow style — initials avatar wearing a presence dot, name with a mutuals caption, and a small tone-tinted follow chip on the right.",
	"tags": [
		"profile",
		"list",
		"follower",
		"presence",
		"social"
	],
	"args": [
		{
			"name": "initials",
			"type": "string",
			"default": "SM",
			"label": "Initials",
			"maxLength": 3
		},
		{
			"name": "name",
			"type": "string",
			"default": "Sam Mercer",
			"label": "Name",
			"maxLength": 40
		},
		{
			"name": "mutuals",
			"type": "string",
			"default": "12 mutual friends",
			"label": "Mutuals",
			"maxLength": 40
		},
		{
			"name": "presence",
			"type": "enum",
			"values": [
				"online",
				"away",
				"offline"
			],
			"default": "online",
			"label": "Presence"
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"background": "#ffffff",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "#1a192b",
				"borderRadius": "5px",
				"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
				"boxShadow": "0 1px 2px rgba(26, 25, 43, 0.08)",
				"width": "300px",
				"display": "flex",
				"alignItems": "center",
				"gap": "12px",
				"padding": "10px 12px",
				"boxSizing": "border-box"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"position": "relative",
						"flexShrink": 0
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"width": 40,
								"height": 40,
								"borderRadius": "999px",
								"background": "#f4f4f5",
								"color": "#3f3e4a",
								"display": "flex",
								"alignItems": "center",
								"justifyContent": "center",
								"fontWeight": 600,
								"fontSize": "12px",
								"flexShrink": 0
							}
						},
						"children": [
							"{initials}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"position": "absolute",
								"right": "-1px",
								"bottom": "-1px",
								"width": "10px",
								"height": "10px",
								"borderRadius": "999px",
								"borderWidth": "2px",
								"borderStyle": "solid",
								"borderColor": "#ffffff",
								"background": {
									"ttMap": {
										"arg": "presence",
										"values": {
											"online": "#22c55e",
											"away": "#eab308",
											"offline": "#b1b1b7"
										},
										"default": "#22c55e"
									}
								}
							}
						}
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"flex": 1,
						"minWidth": 0
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "12px",
								"fontWeight": 600,
								"color": "#1a192b"
							}
						},
						"children": [
							"{name}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "10px",
								"color": "#6f6e77"
							}
						},
						"children": [
							"{mutuals}"
						]
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"padding": "4px 12px",
						"borderRadius": "3px",
						"background": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#f4f4f5",
									"success": "#f0fdf4",
									"warning": "#fefce8",
									"danger": "#ffe4f1",
									"info": "#f1ecfd",
									"neutral": "#f4f4f5"
								},
								"default": "#f4f4f5"
							}
						},
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#1a192b",
									"success": "#15803d",
									"warning": "#a16207",
									"danger": "#c00055",
									"info": "#5b21b6",
									"neutral": "#3f3e4a"
								},
								"default": "#1a192b"
							}
						},
						"fontSize": "10px",
						"fontWeight": 600,
						"flexShrink": 0
					}
				},
				"children": [
					"Follow"
				]
			}
		]
	},
	"version": 1,
	"familyKey": "profile-social-follower-row",
	"source": {
		"kind": "archetype",
		"archetype": "profile-social",
		"variant": "follower-row",
		"tranche": 2
	}
}
