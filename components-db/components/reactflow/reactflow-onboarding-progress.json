{
	"slug": "reactflow-onboarding-progress",
	"name": "Onboarding Progress Banner",
	"library": "reactflow",
	"category": "onboarding",
	"description": "Slim finish-setup banner in the React Flow style — label, inline tone progress bar with a mono percent readout, a resume button and a quiet dismiss cross.",
	"tags": [
		"onboarding",
		"progress",
		"banner",
		"resume"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Finish setting up",
			"label": "Label",
			"maxLength": 32
		},
		{
			"name": "percent",
			"type": "number",
			"default": 60,
			"label": "Percent",
			"min": 0,
			"max": 100
		},
		{
			"name": "resumeLabel",
			"type": "string",
			"default": "Resume",
			"label": "Button label",
			"maxLength": 20
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"alignItems": "center",
				"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
				"background": "#ffffff",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "#1a192b",
				"borderRadius": "5px",
				"boxShadow": "0 1px 2px rgba(26, 25, 43, 0.08)",
				"boxSizing": "border-box",
				"width": "360px",
				"gap": "10px",
				"padding": "10px 12px"
			}
		},
		"children": [
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "12px",
						"fontWeight": 600,
						"color": "#1a192b",
						"whiteSpace": "nowrap",
						"flexShrink": 0
					}
				},
				"children": [
					"{label}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"flex": 1,
						"minWidth": "40px",
						"height": "6px",
						"borderRadius": "999px",
						"background": "#e2e2e5",
						"overflow": "hidden"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"width": "{percent}%",
								"height": "100%",
								"borderRadius": "999px",
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#1a192b",
											"success": "#22c55e",
											"warning": "#eab308",
											"danger": "#ff0072",
											"info": "#784be8",
											"neutral": "#6f6e77"
										},
										"default": "#1a192b"
									}
								}
							}
						}
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
						"fontSize": "10px",
						"color": "#6f6e77",
						"flexShrink": 0
					}
				},
				"children": [
					"{percent}%"
				]
			},
			{
				"tag": "button",
				"props": {
					"type": "button",
					"style": {
						"display": "inline-flex",
						"alignItems": "center",
						"justifyContent": "center",
						"gap": "6px",
						"border": "none",
						"borderRadius": "5px",
						"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
						"fontWeight": 500,
						"cursor": "pointer",
						"height": "24px",
						"padding": "0 10px",
						"fontSize": "10px",
						"background": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#1a192b",
									"success": "#22c55e",
									"warning": "#eab308",
									"danger": "#ff0072",
									"info": "#784be8",
									"neutral": "#6f6e77"
								},
								"default": "#1a192b"
							}
						},
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#ffffff",
									"success": "#ffffff",
									"warning": "#ffffff",
									"danger": "#ffffff",
									"info": "#ffffff",
									"neutral": "#ffffff"
								},
								"default": "#ffffff"
							}
						},
						"flexShrink": 0
					}
				},
				"children": [
					"{resumeLabel}"
				]
			},
			{
				"tag": "button",
				"props": {
					"type": "button",
					"style": {
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "center",
						"width": "22px",
						"height": "22px",
						"padding": 0,
						"border": "none",
						"borderRadius": "2px",
						"background": "transparent",
						"color": "#6f6e77",
						"cursor": "pointer",
						"flexShrink": 0
					}
				},
				"children": [
					{
						"tag": "svg",
						"props": {
							"width": 14,
							"height": 14,
							"viewBox": "0 0 24 24",
							"fill": "none",
							"stroke": "currentColor",
							"strokeWidth": 2,
							"strokeLinecap": "round",
							"strokeLinejoin": "round",
							"xmlns": "http://www.w3.org/2000/svg"
						},
						"children": [
							{
								"tag": "line",
								"props": {
									"x1": 18,
									"y1": 6,
									"x2": 6,
									"y2": 18
								}
							},
							{
								"tag": "line",
								"props": {
									"x1": 6,
									"y1": 6,
									"x2": 18,
									"y2": 18
								}
							}
						]
					}
				]
			}
		]
	},
	"previewBg": "#f8f8f8",
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "onboarding",
		"variant": "progress",
		"tranche": 2
	}
}
