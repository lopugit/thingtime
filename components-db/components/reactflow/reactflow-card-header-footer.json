{
	"slug": "reactflow-card-header-footer",
	"name": "Header & Footer Card",
	"library": "reactflow",
	"category": "layout",
	"description": "Three-part card in the React Flow style — bordered header and footer bands around a padded body, with an optional tinted footer.",
	"tags": [
		"card",
		"header",
		"footer",
		"sections"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Weekly report",
			"label": "Title",
			"maxLength": 60
		},
		{
			"name": "body",
			"type": "text",
			"default": "Everything shipped this week, grouped by team and sorted by impact.",
			"label": "Body"
		},
		{
			"name": "footer",
			"type": "string",
			"default": "Updated 2 days ago",
			"label": "Footer",
			"maxLength": 60
		},
		{
			"name": "tintedFooter",
			"type": "boolean",
			"default": true,
			"label": "Tinted footer"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"width": "300px",
				"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
				"background": "#ffffff",
				"color": "#1a192b",
				"border": "1px solid #1a192b",
				"borderRadius": "5px",
				"boxShadow": "0 1px 2px rgba(26, 25, 43, 0.08)",
				"overflow": "hidden",
				"boxSizing": "border-box"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"padding": "12px 16px",
						"borderBottom": "1px solid #e2e2e5"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "14px",
								"fontWeight": 600,
								"color": "#1a192b"
							}
						},
						"children": [
							"{title}"
						]
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"padding": "16px"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "12px",
								"color": "#6f6e77",
								"lineHeight": 1.5
							}
						},
						"children": [
							"{body}"
						]
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"ttMerge": [
							{
								"padding": "10px 16px",
								"borderTop": "1px solid #e2e2e5",
								"fontSize": "10px",
								"color": "#6f6e77"
							},
							{
								"ttIf": {
									"arg": "tintedFooter",
									"then": {
										"background": "#f4f4f5"
									},
									"else": {}
								}
							}
						]
					}
				},
				"children": [
					"{footer}"
				]
			}
		]
	},
	"version": 1,
	"familyKey": "card-header-footer",
	"source": {
		"kind": "archetype",
		"archetype": "card",
		"variant": "header-footer",
		"tranche": 1
	}
}
