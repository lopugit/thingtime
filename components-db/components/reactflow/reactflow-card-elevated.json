{
	"slug": "reactflow-card-elevated",
	"name": "Elevated Card",
	"library": "reactflow",
	"category": "layout",
	"description": "Floating borderless card in the React Flow style — the library's deeper shadow tiers lift it off the page, led by a tone-tinted icon chip.",
	"tags": [
		"card",
		"elevated",
		"shadow",
		"floating"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Quick insight",
			"label": "Title",
			"maxLength": 60
		},
		{
			"name": "body",
			"type": "text",
			"default": "Elevation carries the hierarchy here — the card floats free of any border.",
			"label": "Body"
		},
		{
			"name": "elevation",
			"type": "enum",
			"values": [
				"raised",
				"floating"
			],
			"default": "floating",
			"label": "Elevation"
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"width": "300px",
				"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
				"background": "#ffffff",
				"color": "#1a192b",
				"border": "1px solid #1a192b",
				"borderRadius": "5px",
				"boxShadow": {
					"ttMap": {
						"arg": "elevation",
						"values": {
							"raised": "0 2px 6px rgba(26, 25, 43, 0.12)",
							"floating": "0 0 0 0.5px #1a192b, 0 3px 10px rgba(26, 25, 43, 0.15)"
						},
						"default": "0 0 0 0.5px #1a192b, 0 3px 10px rgba(26, 25, 43, 0.15)"
					}
				},
				"overflow": "hidden",
				"boxSizing": "border-box",
				"padding": "16px",
				"gap": "10px"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "10px"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"width": "32px",
								"height": "32px",
								"borderRadius": "3px",
								"display": "flex",
								"alignItems": "center",
								"justifyContent": "center",
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#f4f4f5",
											"success": "#f0fdf4",
											"warning": "#fefce8",
											"danger": "#ffe4f1",
											"info": "#f1ecfd",
											"neutral": "#f4f4f5"
										},
										"default": "#f4f4f5"
									}
								},
								"flexShrink": 0
							}
						},
						"children": [
							{
								"tag": "svg",
								"props": {
									"width": 16,
									"height": 16,
									"viewBox": "0 0 24 24",
									"fill": "none",
									"stroke": {
										"ttMap": {
											"arg": "tone",
											"values": {
												"primary": "#1a192b",
												"success": "#15803d",
												"warning": "#a16207",
												"danger": "#c00055",
												"info": "#5b21b6",
												"neutral": "#3f3e4a"
											},
											"default": "#1a192b"
										}
									},
									"strokeWidth": 2,
									"strokeLinecap": "round",
									"strokeLinejoin": "round",
									"xmlns": "http://www.w3.org/2000/svg"
								},
								"children": [
									{
										"tag": "polygon",
										"props": {
											"points": "13 2 3 14 12 14 11 22 21 10 12 10 13 2"
										}
									}
								]
							}
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "14px",
								"fontWeight": 600,
								"color": "#1a192b"
							}
						},
						"children": [
							"{title}"
						]
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "12px",
						"color": "#6f6e77",
						"lineHeight": 1.5
					}
				},
				"children": [
					"{body}"
				]
			}
		]
	},
	"version": 1,
	"familyKey": "card-elevated",
	"source": {
		"kind": "archetype",
		"archetype": "card",
		"variant": "elevated",
		"tranche": 1
	}
}
