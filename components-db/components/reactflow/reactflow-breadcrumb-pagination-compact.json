{
	"slug": "reactflow-breadcrumb-pagination-compact",
	"name": "Compact Pagination",
	"library": "reactflow",
	"category": "navigation",
	"description": "Compact prev/next pager in the React Flow style — outlined previous button, \"Page X of Y\" readout, and a tone-solid next button.",
	"tags": [
		"pagination",
		"navigation",
		"compact",
		"pager"
	],
	"args": [
		{
			"name": "page",
			"type": "number",
			"default": 2,
			"label": "Page",
			"min": 1
		},
		{
			"name": "pages",
			"type": "number",
			"default": 8,
			"label": "Total pages",
			"min": 1
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "labels",
			"type": "boolean",
			"default": true,
			"label": "Show labels"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"alignItems": "center",
				"gap": "12px",
				"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
			}
		},
		"children": [
			{
				"tag": "button",
				"props": {
					"type": "button",
					"style": {
						"display": "inline-flex",
						"alignItems": "center",
						"justifyContent": "center",
						"gap": "6px",
						"height": "24px",
						"padding": "0 12px",
						"borderRadius": "5px",
						"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
						"fontSize": "12px",
						"fontWeight": 500,
						"cursor": "pointer",
						"background": "#ffffff",
						"color": "#1a192b",
						"borderWidth": "1px",
						"borderStyle": "solid",
						"borderColor": "#1a192b"
					}
				},
				"children": [
					{
						"tag": "svg",
						"props": {
							"width": 14,
							"height": 14,
							"viewBox": "0 0 24 24",
							"fill": "none",
							"stroke": "currentColor",
							"strokeWidth": 2,
							"strokeLinecap": "round",
							"strokeLinejoin": "round",
							"xmlns": "http://www.w3.org/2000/svg"
						},
						"children": [
							{
								"tag": "polyline",
								"props": {
									"points": "15 6 9 12 15 18"
								}
							}
						]
					},
					{
						"ttIf": {
							"arg": "labels",
							"then": "Prev"
						}
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "12px",
						"color": "#6f6e77"
					}
				},
				"children": [
					"Page {page} of {pages}"
				]
			},
			{
				"tag": "button",
				"props": {
					"type": "button",
					"style": {
						"display": "inline-flex",
						"alignItems": "center",
						"justifyContent": "center",
						"gap": "6px",
						"height": "24px",
						"padding": "0 12px",
						"borderRadius": "5px",
						"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
						"fontSize": "12px",
						"fontWeight": 500,
						"cursor": "pointer",
						"border": "none",
						"background": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#1a192b",
									"success": "#22c55e",
									"warning": "#eab308",
									"danger": "#ff0072",
									"info": "#784be8",
									"neutral": "#6f6e77"
								},
								"default": "#1a192b"
							}
						},
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#ffffff",
									"success": "#ffffff",
									"warning": "#ffffff",
									"danger": "#ffffff",
