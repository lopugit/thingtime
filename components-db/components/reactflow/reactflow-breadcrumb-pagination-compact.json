					},
					{
						"tag": "svg",
						"props": {
							"width": 14,
							"height": 14,
							"viewBox": "0 0 24 24",
							"fill": "none",
							"stroke": "currentColor",
							"strokeWidth": 2,
							"strokeLinecap": "round",
							"strokeLinejoin": "round",
							"xmlns": "http://www.w3.org/2000/svg"
						},
						"children": [
							{
								"tag": "polyline",
								"props": {
									"points": "9 6 15 12 9 18"
								}
							}
						]
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "breadcrumb-pagination-compact",
	"source": {
