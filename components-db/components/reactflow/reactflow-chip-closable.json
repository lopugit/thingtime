{
	"slug": "reactflow-chip-closable",
	"name": "Closable Chip",
	"library": "reactflow",
	"category": "data-display",
	"description": "Removable tag chip in the React Flow style — a soft tone chip with a trailing x glyph, dimming when disabled.",
	"tags": [
		"chip",
		"tag",
		"closable",
		"removable"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Filter: recent",
			"label": "Label",
			"maxLength": 24
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "disabled",
			"type": "boolean",
			"default": false,
			"label": "Disabled"
		}
	],
	"render": {
		"tag": "span",
		"props": {
			"style": {
				"ttMerge": [
					{
						"display": "inline-flex",
						"alignItems": "center",
						"gap": "6px",
						"height": "24px",
						"padding": "0 12px",
						"borderRadius": "3px",
						"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
						"fontWeight": 500,
						"fontSize": "12px"
					},
					{
						"background": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#f4f4f5",
									"success": "#f0fdf4",
									"warning": "#fefce8",
									"danger": "#ffe4f1",
									"info": "#f1ecfd",
									"neutral": "#f4f4f5"
								},
								"default": "#f4f4f5"
							}
						},
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#1a192b",
									"success": "#15803d",
									"warning": "#a16207",
									"danger": "#c00055",
									"info": "#5b21b6",
									"neutral": "#3f3e4a"
								},
								"default": "#1a192b"
							}
						}
					},
					{
						"cursor": "pointer"
					},
					{
						"ttIf": {
							"arg": "disabled",
							"then": {
								"opacity": 0.5,
								"cursor": "not-allowed"
							},
							"else": {}
						}
					}
				]
			}
		},
		"children": [
			"{label}",
			{
				"tag": "svg",
				"props": {
					"width": 12,
					"height": 12,
					"viewBox": "0 0 24 24",
					"fill": "none",
					"stroke": "currentColor",
					"strokeWidth": 2,
					"strokeLinecap": "round",
					"strokeLinejoin": "round",
					"xmlns": "http://www.w3.org/2000/svg"
				},
				"children": [
					{
						"tag": "line",
						"props": {
							"x1": 18,
							"y1": 6,
							"x2": 6,
							"y2": 18
						}
					},
					{
						"tag": "line",
						"props": {
							"x1": 6,
							"y1": 6,
							"x2": 18,
							"y2": 18
						}
					}
				]
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "chip",
		"variant": "closable",
		"tranche": 1
	}
}
