{
	"slug": "reactflow-profile-social-header",
	"name": "Profile Header",
	"library": "reactflow",
	"category": "social",
	"description": "Profile header in the React Flow style — dotted-canvas cover band, overlapping initials avatar, name, handle and bio, with follow and message actions.",
	"tags": [
		"profile",
		"header",
		"avatar",
		"identity",
		"social"
	],
	"args": [
		{
			"name": "initials",
			"type": "string",
			"default": "JR",
			"label": "Initials",
			"maxLength": 3
		},
		{
			"name": "name",
			"type": "string",
			"default": "Jordan Reyes",
			"label": "Name",
			"maxLength": 40
		},
		{
			"name": "handle",
			"type": "string",
			"default": "jordanmakes",
			"label": "Handle",
			"maxLength": 24
		},
		{
			"name": "bio",
			"type": "text",
			"default": "Designing calm tools for busy teams. Coffee first.",
			"label": "Bio",
			"maxLength": 140
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"background": "#ffffff",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "#1a192b",
				"borderRadius": "8px",
				"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
				"boxShadow": "0 1px 2px rgba(26, 25, 43, 0.08)",
				"width": "320px",
				"overflow": "hidden"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"height": "64px",
						"backgroundColor": "#f4f4f5",
						"backgroundImage": "radial-gradient(#91919a 1px, transparent 1px)",
						"backgroundSize": "12px 12px"
					}
				}
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"padding": "0 16px 16px"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"width": 56,
								"height": 56,
								"borderRadius": "999px",
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#1a192b",
											"success": "#22c55e",
											"warning": "#eab308",
											"danger": "#ff0072",
											"info": "#784be8",
											"neutral": "#6f6e77"
										},
										"default": "#1a192b"
									}
								},
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#ffffff",
											"success": "#ffffff",
											"warning": "#ffffff",
											"danger": "#ffffff",
											"info": "#ffffff",
											"neutral": "#ffffff"
										},
										"default": "#ffffff"
									}
								},
								"display": "flex",
								"alignItems": "center",
								"justifyContent": "center",
								"fontWeight": 600,
								"fontSize": "14px",
								"flexShrink": 0,
								"marginTop": "-28px",
								"borderWidth": "3px",
								"borderStyle": "solid",
								"borderColor": "#ffffff"
							}
						},
						"children": [
							"{initials}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"marginTop": "10px",
								"fontSize": "14px",
								"fontWeight": 600,
								"color": "#1a192b"
							}
						},
						"children": [
							"{name}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"marginTop": "2px",
								"fontSize": "12px",
								"color": "#6f6e77"
							}
						},
						"children": [
							"@{handle}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"marginTop": "8px",
								"fontSize": "12px",
								"color": "#1a192b",
								"lineHeight": 1.5
							}
						},
						"children": [
							"{bio}"
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"marginTop": "14px",
								"gap": "8px"
							}
						},
						"children": [
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"display": "inline-flex",
										"alignItems": "center",
										"justifyContent": "center",
										"borderRadius": "3px",
										"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
										"fontSize": "12px",
										"fontWeight": 500,
										"cursor": "pointer",
										"height": "24px",
										"padding": "0 14px",
										"border": "none",
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#1a192b",
													"success": "#22c55e",
													"warning": "#eab308",
													"danger": "#ff0072",
													"info": "#784be8",
													"neutral": "#6f6e77"
												},
												"default": "#1a192b"
											}
										},
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#ffffff",
													"success": "#ffffff",
													"warning": "#ffffff",
													"danger": "#ffffff",
													"info": "#ffffff",
													"neutral": "#ffffff"
												},
												"default": "#ffffff"
											}
										}
									}
								},
								"children": [
									"Follow"
								]
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"display": "inline-flex",
										"alignItems": "center",
										"justifyContent": "center",
										"borderRadius": "3px",
										"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
										"fontSize": "12px",
										"fontWeight": 500,
										"cursor": "pointer",
										"height": "24px",
										"padding": "0 14px",
										"borderWidth": "1px",
										"borderStyle": "solid",
										"borderColor": "#1a192b",
										"background": "#ffffff",
										"color": "#1a192b"
									}
								},
								"children": [
									"Message"
								]
							}
						]
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "profile-social-header",
	"source": {
		"kind": "archetype",
		"archetype": "profile-social",
		"variant": "header",
		"tranche": 2
	}
}
