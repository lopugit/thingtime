{
	"slug": "bootstrap-toast-notification-top-banner",
	"name": "Top Banner",
	"library": "bootstrap",
	"category": "feedback",
	"description": "Full-width announcement banner in the Bootstrap style — solid tone strip with a bold message, inline link, and dismiss control.",
	"tags": [
		"banner",
		"announcement",
		"feedback",
		"dismiss"
	],
	"args": [
		{
			"name": "message",
			"type": "string",
			"default": "A new version is available.",
			"label": "Message",
			"maxLength": 80
		},
		{
			"name": "linkLabel",
			"type": "string",
			"default": "See what changed",
			"label": "Link label",
			"maxLength": 32
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "dismissible",
			"type": "boolean",
			"default": true,
			"label": "Dismissible"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"alignItems": "center",
				"width": "100%",
				"minWidth": "360px",
				"justifyContent": "space-between",
				"gap": "16px",
				"padding": "10px 16px",
				"background": {
					"ttMap": {
						"arg": "tone",
						"values": {
							"primary": "#0d6efd",
							"success": "#198754",
							"warning": "#ffc107",
							"danger": "#dc3545",
							"info": "#0dcaf0",
							"neutral": "#6c757d"
						},
						"default": "#0d6efd"
					}
				},
				"color": {
					"ttMap": {
						"arg": "tone",
						"values": {
							"primary": "#ffffff",
							"success": "#ffffff",
							"warning": "#000000",
							"danger": "#ffffff",
							"info": "#000000",
							"neutral": "#ffffff"
						},
						"default": "#ffffff"
					}
				},
				"fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
				"fontSize": "14px"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "10px",
						"flexWrap": "wrap"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontWeight": 600
							}
						},
						"children": [
							"{message}"
						]
					},
					{
						"ttIf": {
							"arg": "linkLabel",
							"then": {
								"tag": "span",
								"props": {
									"style": {
										"textDecoration": "underline",
										"fontWeight": 600,
										"cursor": "pointer",
										"opacity": 0.9
									}
								},
								"children": [
									"{linkLabel}"
								]
							}
						}
					}
				]
			},
			{
				"ttIf": {
					"arg": "dismissible",
					"then": {
						"tag": "span",
						"props": {
							"style": {
								"display": "inline-flex",
								"cursor": "pointer",
								"opacity": 0.8
							}
						},
						"children": [
							{
								"tag": "svg",
								"props": {
									"width": 14,
									"height": 14,
									"viewBox": "0 0 24 24",
									"fill": "none",
									"stroke": "currentColor",
									"strokeWidth": 2,
									"strokeLinecap": "round",
									"strokeLinejoin": "round",
									"xmlns": "http://www.w3.org/2000/svg"
								},
								"children": [
									{
										"tag": "line",
										"props": {
											"x1": 18,
											"y1": 6,
											"x2": 6,
											"y2": 18
										}
									},
									{
										"tag": "line",
										"props": {
											"x1": 6,
											"y1": 6,
											"x2": 18,
											"y2": 18
										}
									}
								]
							}
						]
					}
				}
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "toast-notification",
		"variant": "top-banner",
		"tranche": 1
	}
}
