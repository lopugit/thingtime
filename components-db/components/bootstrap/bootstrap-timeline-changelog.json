{
	"slug": "bootstrap-timeline-changelog",
	"name": "Changelog Timeline",
	"library": "bootstrap",
	"category": "data-display",
	"description": "Changelog timeline in the Bootstrap style — mono version chips on a tone tint head each entry, with a date mark and a muted release summary.",
	"tags": [
		"timeline",
		"changelog",
		"releases",
		"versions"
	],
	"args": [
		{
			"name": "version",
			"type": "string",
			"default": "2.4",
			"label": "Version",
			"maxLength": 12
		},
		{
			"name": "summary",
			"type": "string",
			"default": "Performance improvements and bug fixes",
			"label": "Summary",
			"maxLength": 80
		},
		{
			"name": "count",
			"type": "number",
			"default": 3,
			"label": "Entries",
			"min": 1,
			"max": 5
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "ul",
		"props": {
			"style": {
				"listStyle": "none",
				"margin": 0,
				"padding": 0,
				"width": "280px",
				"display": "flex",
				"flexDirection": "column",
				"fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
				"color": "#212529"
			}
		},
		"children": [
			{
				"ttRepeat": {
					"arg": "count",
					"max": 5,
					"node": {
						"tag": "li",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "stretch",
								"gap": "14px"
							}
						},
						"children": [
							{
								"tag": "div",
								"props": {
									"style": {
										"display": "flex",
										"flexDirection": "column",
										"alignItems": "center",
										"width": "12px",
										"flexShrink": 0
									}
								},
								"children": [
									{
										"tag": "div",
										"props": {
											"style": {
												"width": "12px",
												"height": "12px",
												"borderRadius": "50rem",
												"background": "#adb5bd",
												"marginTop": "5px",
												"flexShrink": 0
											}
										}
									},
									{
										"tag": "div",
										"props": {
											"style": {
												"width": "2px",
												"flexGrow": 1,
												"minHeight": "14px",
												"marginTop": "4px",
												"borderRadius": "50rem",
												"background": "#e9ecef"
											}
										}
									}
								]
							},
							{
								"tag": "div",
								"props": {
									"style": {
										"display": "flex",
										"flexDirection": "column",
										"gap": "2px",
										"paddingBottom": "18px",
										"minWidth": 0
									}
								},
								"children": [
									{
										"tag": "div",
										"props": {
											"style": {
												"display": "flex",
												"alignItems": "center",
												"gap": "8px"
											}
										},
										"children": [
											{
												"tag": "span",
												"props": {
													"style": {
														"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
														"fontSize": "12px",
														"fontWeight": 600,
														"padding": "2px 8px",
														"borderRadius": "50rem",
														"background": {
															"ttMap": {
																"arg": "tone",
																"values": {
																	"primary": "#cfe2ff",
																	"success": "#d1e7dd",
																	"warning": "#fff3cd",
																	"danger": "#f8d7da",
																	"info": "#cff4fc",
																	"neutral": "#e9ecef"
																},
																"default": "#cfe2ff"
															}
														},
														"color": {
															"ttMap": {
																"arg": "tone",
																"values": {
																	"primary": "#052c65",
																	"success": "#0a3622",
																	"warning": "#664d03",
																	"danger": "#58151c",
																	"info": "#055160",
																	"neutral": "#495057"
																},
																"default": "#052c65"
															}
														},
														"borderWidth": "1px",
														"borderStyle": "solid",
														"borderColor": {
															"ttMap": {
																"arg": "tone",
																"values": {
																	"primary": "#9ec5fe",
																	"success": "#a3cfbb",
																	"warning": "#ffe69c",
																	"danger": "#f1aeb5",
																	"info": "#9eeaf9",
																	"neutral": "#ced4da"
																},
																"default": "#9ec5fe"
															}
														}
													}
												},
												"children": [
													"v{version}.{n}"
												]
											},
											{
												"tag": "span",
												"props": {
													"style": {
														"color": "#adb5bd",
														"fontSize": "12px"
													}
												},
												"children": [
													"Aug {n}"
												]
											}
										]
									},
									{
										"tag": "span",
										"props": {
											"style": {
												"color": "#6c757d",
												"fontSize": "14px",
												"marginTop": "2px"
											}
										},
										"children": [
											"{summary}"
										]
									}
								]
							}
						]
					}
				}
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "timeline",
		"variant": "changelog",
		"tranche": 1
	}
}
