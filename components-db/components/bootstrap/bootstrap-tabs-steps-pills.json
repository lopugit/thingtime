{
	"slug": "bootstrap-tabs-steps-pills",
	"name": "Pill Tabs",
	"library": "bootstrap",
	"category": "navigation",
	"description": "Pill-shaped tab row in the Bootstrap style — the active tab fills with the tone color while inactive tabs stay quiet text.",
	"tags": [
		"tabs",
		"navigation",
		"pills"
	],
	"args": [
		{
			"name": "tab1",
			"type": "string",
			"default": "Overview",
			"label": "Tab 1",
			"maxLength": 24
		},
		{
			"name": "tab2",
			"type": "string",
			"default": "Activity",
			"label": "Tab 2",
			"maxLength": 24
		},
		{
			"name": "tab3",
			"type": "string",
			"default": "Settings",
			"label": "Tab 3",
			"maxLength": 24
		},
		{
			"name": "active",
			"type": "enum",
			"values": [
				"1",
				"2",
				"3"
			],
			"default": "1",
			"label": "Active tab"
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"alignItems": "center",
				"gap": "6px",
				"fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
			}
		},
		"children": [
			{
				"tag": "button",
				"props": {
					"type": "button",
					"style": {
						"border": "none",
						"background": {
							"ttIf": {
								"arg": "active",
								"equals": "1",
								"then": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#0d6efd",
											"success": "#198754",
											"warning": "#ffc107",
											"danger": "#dc3545",
											"info": "#0dcaf0",
											"neutral": "#6c757d"
										},
										"default": "#0d6efd"
									}
								},
								"else": "transparent"
							}
						},
						"cursor": "pointer",
						"padding": "0 14px",
						"margin": 0,
						"fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
						"fontWeight": 500,
						"display": "inline-flex",
						"alignItems": "center",
						"justifyContent": "center",
						"height": "31px",
						"fontSize": "14px",
						"borderRadius": "50rem",
						"color": {
							"ttIf": {
								"arg": "active",
								"equals": "1",
								"then": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#ffffff",
											"success": "#ffffff",
											"warning": "#000000",
											"danger": "#ffffff",
											"info": "#000000",
											"neutral": "#ffffff"
										},
										"default": "#ffffff"
									}
								},
								"else": "#6c757d"
							}
						},
						"boxShadow": {
							"ttIf": {
								"arg": "active",
								"equals": "1",
								"then": "0 .125rem .25rem rgba(0, 0, 0, .075)",
								"else": "none"
							}
						}
					}
				},
				"children": [
					"{tab1}"
				]
			},
			{
				"tag": "button",
				"props": {
					"type": "button",
					"style": {
						"border": "none",
