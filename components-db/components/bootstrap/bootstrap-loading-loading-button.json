{
	"slug": "bootstrap-loading-loading-button",
	"name": "Loading Button",
	"library": "bootstrap",
	"category": "feedback",
	"description": "Busy-state button in the Bootstrap style — an inline arc spinner beside the label, in solid or quiet tinted form.",
	"tags": [
		"loading",
		"button",
		"spinner",
		"busy"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Saving…",
			"label": "Label",
			"maxLength": 40
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "size",
			"type": "enum",
			"values": [
				"sm",
				"md",
				"lg"
			],
			"default": "md",
			"label": "Size"
		},
		{
			"name": "quiet",
			"type": "boolean",
			"default": false,
			"label": "Quiet (tinted)"
		}
	],
	"render": {
		"tag": "button",
		"props": {
			"type": "button",
			"style": {
				"ttMerge": [
					{
						"display": "inline-flex",
						"alignItems": "center",
						"justifyContent": "center",
						"gap": "8px",
						"border": "none",
						"borderRadius": "6px",
						"fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
						"fontWeight": 400,
						"cursor": "wait",
						"opacity": 0.9
					},
					{
						"ttMap": {
							"arg": "size",
							"values": {
								"sm": {
									"height": "31px",
									"padding": "0 12px",
									"fontSize": "14px"
								},
								"md": {
									"height": "38px",
									"padding": "0 16px",
									"fontSize": "16px"
								},
								"lg": {
									"height": "48px",
									"padding": "0 20px",
									"fontSize": "18px"
								}
							},
							"default": {
								"height": "38px",
								"padding": "0 16px",
								"fontSize": "16px"
							}
						}
					},
					{
						"background": {
							"ttIf": {
								"arg": "quiet",
								"then": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#cfe2ff",
											"success": "#d1e7dd",
											"warning": "#fff3cd",
											"danger": "#f8d7da",
											"info": "#cff4fc",
											"neutral": "#e9ecef"
										},
										"default": "#cfe2ff"
									}
								},
								"else": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#0d6efd",
											"success": "#198754",
											"warning": "#ffc107",
											"danger": "#dc3545",
											"info": "#0dcaf0",
											"neutral": "#6c757d"
										},
										"default": "#0d6efd"
									}
								}
							}
						},
						"color": {
							"ttIf": {
								"arg": "quiet",
								"then": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#052c65",
											"success": "#0a3622",
											"warning": "#664d03",
											"danger": "#58151c",
											"info": "#055160",
											"neutral": "#495057"
										},
										"default": "#052c65"
									}
								},
								"else": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#ffffff",
											"success": "#ffffff",
											"warning": "#000000",
											"danger": "#ffffff",
											"info": "#000000",
											"neutral": "#ffffff"
										},
										"default": "#ffffff"
									}
								}
							}
						},
						"boxShadow": "0 .125rem .25rem rgba(0, 0, 0, .075)"
					}
				]
			}
		},
		"children": [
			{
				"tag": "svg",
				"props": {
					"width": 16,
					"height": 16,
					"viewBox": "0 0 24 24",
					"fill": "none",
					"xmlns": "http://www.w3.org/2000/svg"
				},
				"children": [
					{
						"tag": "circle",
						"props": {
							"cx": 12,
							"cy": 12,
							"r": 10,
							"stroke": "currentColor",
							"strokeWidth": 3,
							"style": {
								"opacity": 0.3
							}
						}
					},
					{
						"tag": "path",
						"props": {
							"d": "M12 2a10 10 0 1 1-10 10",
							"stroke": "currentColor",
							"strokeWidth": 3,
							"strokeLinecap": "round"
						}
					}
				]
			},
			"{label}"
		]
	},
	"version": 1,
	"familyKey": "loading-loading-button",
	"source": {
		"kind": "archetype",
		"archetype": "loading",
		"variant": "loading-button",
		"tranche": 1
	}
}
