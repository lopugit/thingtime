{
	"slug": "bootstrap-avatar-initials",
	"name": "Initials Avatar",
	"library": "bootstrap",
	"category": "data-display",
	"description": "Circular initials avatar in the Bootstrap style — tone-filled disc with library type, optional soft tint and a surface-offset ring.",
	"tags": [
		"avatar",
		"initials",
		"profile"
	],
	"args": [
		{
			"name": "initials",
			"type": "string",
			"default": "NF",
			"label": "Initials",
			"maxLength": 3
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "size",
			"type": "enum",
			"values": [
				"sm",
				"md",
				"lg"
			],
			"default": "md",
			"label": "Size"
		},
		{
			"name": "soft",
			"type": "boolean",
			"default": false,
			"label": "Soft tint"
		},
		{
			"name": "ring",
			"type": "boolean",
			"default": false,
			"label": "Ring"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"ttMerge": [
					{
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "center",
						"fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
						"fontWeight": 500,
						"borderRadius": "50rem",
						"flexShrink": 0,
						"userSelect": "none"
					},
					{
						"ttMap": {
							"arg": "size",
							"values": {
								"sm": {
									"width": "28px",
									"height": "28px",
									"fontSize": "12px"
								},
								"md": {
									"width": "40px",
									"height": "40px",
									"fontSize": "14px"
								},
								"lg": {
									"width": "56px",
									"height": "56px",
									"fontSize": "18px"
								}
							},
							"default": {
								"width": "40px",
								"height": "40px",
								"fontSize": "14px"
							}
						}
					},
					{
						"ttIf": {
							"arg": "soft",
							"then": {
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#cfe2ff",
											"success": "#d1e7dd",
											"warning": "#fff3cd",
											"danger": "#f8d7da",
											"info": "#cff4fc",
											"neutral": "#e9ecef"
										},
										"default": "#cfe2ff"
									}
								},
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#052c65",
											"success": "#0a3622",
											"warning": "#664d03",
											"danger": "#58151c",
											"info": "#055160",
											"neutral": "#495057"
										},
										"default": "#052c65"
									}
								},
								"border": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "1px solid #9ec5fe",
											"success": "1px solid #a3cfbb",
											"warning": "1px solid #ffe69c",
											"danger": "1px solid #f1aeb5",
											"info": "1px solid #9eeaf9",
											"neutral": "1px solid #ced4da"
										},
										"default": "1px solid #9ec5fe"
									}
								}
							},
							"else": {
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#0d6efd",
											"success": "#198754",
											"warning": "#ffc107",
											"danger": "#dc3545",
											"info": "#0dcaf0",
											"neutral": "#6c757d"
										},
										"default": "#0d6efd"
									}
								},
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#ffffff",
											"success": "#ffffff",
											"warning": "#000000",
											"danger": "#ffffff",
											"info": "#000000",
											"neutral": "#ffffff"
										},
										"default": "#ffffff"
									}
								}
							}
						}
					},
					{
						"ttIf": {
							"arg": "ring",
							"then": {
								"boxShadow": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "0 0 0 2px #ffffff, 0 0 0 4px #9ec5fe",
											"success": "0 0 0 2px #ffffff, 0 0 0 4px #a3cfbb",
											"warning": "0 0 0 2px #ffffff, 0 0 0 4px #ffe69c",
											"danger": "0 0 0 2px #ffffff, 0 0 0 4px #f1aeb5",
											"info": "0 0 0 2px #ffffff, 0 0 0 4px #9eeaf9",
											"neutral": "0 0 0 2px #ffffff, 0 0 0 4px #ced4da"
										},
										"default": "0 0 0 2px #ffffff, 0 0 0 4px #9ec5fe"
									}
								}
							},
							"else": {}
						}
					}
				]
			}
		},
		"children": [
			"{initials}"
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "avatar",
		"variant": "initials",
		"tranche": 1
	}
}
