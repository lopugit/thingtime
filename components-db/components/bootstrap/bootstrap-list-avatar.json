{
	"slug": "bootstrap-list-avatar",
	"name": "Avatar List",
	"library": "bootstrap",
	"category": "data-display",
	"description": "Avatar-and-name list rows in the Bootstrap style — tone-tinted initials circles beside names, a faint recency mark trailing each row.",
	"tags": [
		"list",
		"avatar",
		"people",
		"data"
	],
	"args": [
		{
			"name": "name",
			"type": "string",
			"default": "Alex Rivers",
			"label": "Name",
			"maxLength": 40
		},
		{
			"name": "initials",
			"type": "string",
			"default": "AR",
			"label": "Initials",
			"maxLength": 3
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "count",
			"type": "number",
			"default": 3,
			"label": "Rows",
			"min": 1,
			"max": 6
		}
	],
	"render": {
		"tag": "ul",
		"props": {
			"style": {
				"ttMerge": [
					{
						"listStyle": "none",
						"margin": 0,
						"padding": 0,
						"width": "280px",
						"fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
						"color": "#212529",
						"background": "#ffffff",
						"borderRadius": "6px",
						"overflow": "hidden"
					},
					{
						"border": "1px solid #dee2e6",
						"boxShadow": "0 .125rem .25rem rgba(0, 0, 0, .075)"
					}
				]
			}
		},
		"children": [
			{
				"ttRepeat": {
					"arg": "count",
					"max": 6,
					"node": {
						"tag": "li",
						"props": {
							"style": {
								"ttMerge": [
									{
										"display": "flex",
										"alignItems": "center",
										"gap": "12px",
										"padding": "10px 14px",
										"fontSize": "16px"
									},
									{
										"ttIf": {
											"arg": "n",
											"equals": 1,
											"then": {},
											"else": {
												"borderTop": "1px solid #e9ecef"
											}
										}
									}
								]
							}
						},
						"children": [
							{
								"tag": "div",
								"props": {
									"style": {
										"width": "32px",
										"height": "32px",
										"borderRadius": "999px",
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#cfe2ff",
													"success": "#d1e7dd",
													"warning": "#fff3cd",
													"danger": "#f8d7da",
													"info": "#cff4fc",
													"neutral": "#e9ecef"
												},
												"default": "#cfe2ff"
											}
										},
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#052c65",
													"success": "#0a3622",
													"warning": "#664d03",
													"danger": "#58151c",
													"info": "#055160",
													"neutral": "#495057"
												},
												"default": "#052c65"
											}
										},
										"display": "flex",
										"alignItems": "center",
										"justifyContent": "center",
										"fontWeight": 600,
										"fontSize": "12px",
										"flexShrink": 0
									}
								},
								"children": [
									"{initials}"
								]
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"fontWeight": 500,
										"flexGrow": 1
									}
								},
								"children": [
									"{name}"
								]
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"color": "#adb5bd",
										"fontSize": "12px"
									}
								},
								"children": [
									"{n}h"
								]
							}
						]
					}
				}
			}
		]
	},
	"version": 1,
	"familyKey": "list-avatar",
	"source": {
		"kind": "archetype",
		"archetype": "list",
		"variant": "avatar",
		"tranche": 1
	}
}
