{
	"slug": "bootstrap-marketing-hero",
	"name": "Hero Section",
	"library": "bootstrap",
	"category": "marketing",
	"description": "Centered landing hero in the Bootstrap style — display heading, supporting subtext, and a solid + outline button pair on Bootstrap tone, radius, and type tokens.",
	"tags": [
		"marketing",
		"hero",
		"landing",
		"section"
	],
	"args": [
		{
			"name": "heading",
			"type": "string",
			"default": "Ship your ideas faster",
			"label": "Heading",
			"maxLength": 60
		},
		{
			"name": "subtext",
			"type": "text",
			"default": "Everything you need to design, build, and launch — in one calm workspace.",
			"label": "Subtext",
			"maxLength": 160
		},
		{
			"name": "primaryLabel",
			"type": "string",
			"default": "Get started",
			"label": "Primary button",
			"maxLength": 30
		},
		{
			"name": "secondaryLabel",
			"type": "string",
			"default": "View demo",
			"label": "Secondary button",
			"maxLength": 30
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "section",
		"props": {
			"style": {
				"fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
				"background": "#ffffff",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "#e9ecef",
				"borderRadius": "8px",
				"boxShadow": "0 .5rem 1rem rgba(0, 0, 0, .15)",
				"padding": "44px 36px",
				"display": "flex",
				"flexDirection": "column",
				"alignItems": "center",
				"textAlign": "center",
				"gap": "12px",
				"maxWidth": "560px",
				"boxSizing": "border-box"
			}
		},
		"children": [
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "30px",
						"fontWeight": 500,
						"color": "#212529",
						"lineHeight": 1.15,
						"letterSpacing": "-0.02em"
					}
				},
				"children": [
					"{heading}"
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "18px",
						"color": "#6c757d",
						"lineHeight": 1.55,
						"maxWidth": "420px"
					}
				},
				"children": [
					"{subtext}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "10px",
						"marginTop": "8px",
						"justifyContent": "center",
						"flexWrap": "wrap"
					}
				},
				"children": [
					{
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"display": "inline-flex",
								"alignItems": "center",
								"justifyContent": "center",
								"gap": "8px",
								"border": "none",
								"height": "38px",
								"padding": "0 18px",
								"borderRadius": "6px",
								"fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
								"fontWeight": 400,
								"fontSize": "16px",
								"cursor": "pointer",
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#0d6efd",
											"success": "#198754",
											"warning": "#ffc107",
											"danger": "#dc3545",
											"info": "#0dcaf0",
											"neutral": "#6c757d"
										},
										"default": "#0d6efd"
									}
								},
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#ffffff",
											"success": "#ffffff",
											"warning": "#000000",
											"danger": "#ffffff",
											"info": "#000000",
											"neutral": "#ffffff"
										},
										"default": "#ffffff"
									}
								},
								"boxShadow": "0 .125rem .25rem rgba(0, 0, 0, .075)"
							}
						},
						"children": [
							"{primaryLabel}"
						]
					},
					{
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"display": "inline-flex",
								"alignItems": "center",
								"justifyContent": "center",
								"gap": "8px",
								"border": "none",
								"height": "38px",
								"padding": "0 18px",
								"borderRadius": "6px",
								"fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
								"fontWeight": 400,
								"fontSize": "16px",
								"cursor": "pointer",
								"background": "transparent",
								"borderWidth": "1px",
								"borderStyle": "solid",
								"borderColor": "#dee2e6",
								"color": "#212529"
							}
						},
						"children": [
							"{secondaryLabel}"
						]
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "marketing-hero",
	"source": {
		"kind": "archetype",
		"archetype": "marketing",
		"variant": "hero",
		"tranche": 1
	}
}
