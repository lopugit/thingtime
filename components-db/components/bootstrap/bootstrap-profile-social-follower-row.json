			"default": "Sam Mercer",
			"label": "Name",
			"maxLength": 40
		},
		{
			"name": "mutuals",
			"type": "string",
			"default": "12 mutual friends",
			"label": "Mutuals",
			"maxLength": 40
		},
		{
			"name": "presence",
			"type": "enum",
			"values": [
				"online",
				"away",
				"offline"
