{
	"slug": "bootstrap-modal-drawer-sheet",
	"name": "Bottom Sheet",
	"library": "bootstrap",
	"category": "overlays",
	"description": "Bottom sheet rising over a dimmed backdrop in the Bootstrap style — a slim grab handle above the title, body copy, and a full-width tone action.",
	"tags": [
		"sheet",
		"mobile",
		"overlay",
		"bottom"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Share this page",
			"label": "Title",
			"maxLength": 40
		},
		{
			"name": "body",
			"type": "text",
			"default": "Send a link to your teammates or copy it to your clipboard.",
			"label": "Body",
			"maxLength": 200
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Copy link",
			"label": "Action label",
			"maxLength": 24
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"width": "340px",
				"minHeight": "280px",
				"boxSizing": "border-box",
				"background": "rgba(12, 12, 16, 0.45)",
				"borderRadius": "6px",
				"overflow": "hidden",
				"fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
				"flexDirection": "column",
				"justifyContent": "flex-end",
				"alignItems": "stretch"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"background": "#ffffff",
						"color": "#212529",
						"borderRadius": "8px 8px 0 0",
						"boxShadow": "0 1rem 3rem rgba(0, 0, 0, .175)",
						"display": "flex",
						"flexDirection": "column",
						"overflow": "hidden",
						"padding": "10px 20px 20px"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"width": "40px",
								"height": "4px",
								"borderRadius": "50rem",
								"background": "#dee2e6",
								"margin": "0 auto 14px",
								"flexShrink": 0
							}
						}
					},
					{
						"tag": "h3",
						"props": {
							"style": {
								"margin": "0 0 6px",
								"fontSize": "18px",
								"fontWeight": 500
							}
						},
						"children": [
							"{title}"
						]
					},
					{
						"tag": "p",
						"props": {
							"style": {
								"margin": "0 0 16px",
								"color": "#6c757d",
								"fontSize": "14px",
								"lineHeight": 1.6
							}
						},
						"children": [
							"{body}"
						]
					},
					{
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"display": "inline-flex",
								"alignItems": "center",
								"justifyContent": "center",
								"height": "38px",
								"padding": "0 14px",
								"borderRadius": "6px",
								"fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
								"fontSize": "14px",
								"fontWeight": 400,
								"cursor": "pointer",
								"border": "none",
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#0d6efd",
											"success": "#198754",
											"warning": "#ffc107",
											"danger": "#dc3545",
											"info": "#0dcaf0",
											"neutral": "#6c757d"
										},
										"default": "#0d6efd"
									}
								},
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#ffffff",
											"success": "#ffffff",
											"warning": "#000000",
											"danger": "#ffffff",
											"info": "#000000",
											"neutral": "#ffffff"
										},
										"default": "#ffffff"
									}
								},
								"boxShadow": "0 .125rem .25rem rgba(0, 0, 0, .075)",
								"width": "100%"
							}
						},
						"children": [
							"{actionLabel}"
						]
					}
				]
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "modal-drawer",
		"variant": "sheet",
		"tranche": 1
	}
}
