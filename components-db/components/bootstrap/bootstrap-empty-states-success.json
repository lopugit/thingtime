{
	"slug": "bootstrap-empty-states-success",
	"name": "Success State",
	"library": "bootstrap",
	"category": "feedback",
	"description": "Success / complete panel in the Bootstrap style — check circle in a soft tone bubble, congratulatory title and message, and an optional continue button.",
	"tags": [
		"success",
		"complete",
		"empty-state",
		"feedback"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "You’re all set",
			"label": "Title",
			"maxLength": 50
		},
		{
			"name": "message",
			"type": "text",
			"default": "Your workspace is ready. Invite your team or jump straight in.",
			"label": "Message"
		},
		{
			"name": "ctaLabel",
			"type": "string",
			"default": "Go to dashboard",
			"label": "CTA label",
			"maxLength": 32
		},
		{
			"name": "showCta",
			"type": "boolean",
			"default": true,
			"label": "Show CTA"
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"success",
				"primary",
				"info"
			],
			"default": "success",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"alignItems": "center",
				"justifyContent": "center",
				"textAlign": "center",
				"gap": "6px",
				"width": "340px",
				"padding": "36px 24px",
				"background": "#ffffff",
				"borderRadius": "8px",
				"fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
				"color": "#212529",
				"border": "1px solid #dee2e6",
				"boxShadow": "0 .5rem 1rem rgba(0, 0, 0, .15)"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"width": "46px",
						"height": "46px",
						"borderRadius": "999px",
						"background": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#cfe2ff",
									"success": "#d1e7dd",
									"warning": "#fff3cd",
									"danger": "#f8d7da",
									"info": "#cff4fc",
									"neutral": "#e9ecef"
								},
								"default": "#cfe2ff"
							}
						},
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#0d6efd",
									"success": "#198754",
									"warning": "#ffc107",
									"danger": "#dc3545",
									"info": "#0dcaf0",
									"neutral": "#6c757d"
								},
								"default": "#0d6efd"
							}
						},
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "center",
						"marginBottom": "4px"
					}
				},
				"children": [
					{
						"tag": "svg",
						"props": {
							"width": 22,
							"height": 22,
							"viewBox": "0 0 24 24",
							"fill": "none",
							"stroke": "currentColor",
							"strokeWidth": 2,
							"strokeLinecap": "round",
							"strokeLinejoin": "round",
							"xmlns": "http://www.w3.org/2000/svg"
						},
						"children": [
							{
								"tag": "polyline",
								"props": {
									"points": "20 6 9 17 4 12"
								}
							}
						]
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontWeight": 500,
						"fontSize": "18px"
					}
				},
				"children": [
					"{title}"
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "14px",
						"color": "#6c757d",
						"lineHeight": 1.5,
						"maxWidth": "250px"
					}
				},
				"children": [
					"{message}"
				]
			},
			{
				"ttIf": {
					"arg": "showCta",
					"then": {
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"display": "inline-flex",
								"alignItems": "center",
								"justifyContent": "center",
								"height": "38px",
								"padding": "0 18px",
								"border": "none",
								"borderRadius": "6px",
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#0d6efd",
											"success": "#198754",
											"warning": "#ffc107",
											"danger": "#dc3545",
											"info": "#0dcaf0",
											"neutral": "#6c757d"
										},
										"default": "#0d6efd"
									}
								},
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#ffffff",
											"success": "#ffffff",
											"warning": "#000000",
											"danger": "#ffffff",
											"info": "#000000",
											"neutral": "#ffffff"
										},
										"default": "#ffffff"
									}
								},
								"fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
								"fontSize": "14px",
								"fontWeight": 400,
								"boxShadow": "0 .125rem .25rem rgba(0, 0, 0, .075)",
								"cursor": "pointer",
								"marginTop": "10px"
							}
						},
						"children": [
							"{ctaLabel}"
						]
					}
				}
			}
		]
	},
	"previewBg": "#f8f9fa",
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "empty-states",
		"variant": "success",
		"tranche": 1
	}
}
