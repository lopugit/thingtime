{
	"slug": "bootstrap-breadcrumb-pagination-breadcrumb",
	"name": "Breadcrumb",
	"library": "bootstrap",
	"category": "navigation",
	"description": "Three-level breadcrumb trail in the Bootstrap style — muted ancestor crumbs, slash separators, and a tone-colored current page.",
	"tags": [
		"breadcrumb",
		"navigation",
		"trail",
		"path"
	],
	"args": [
		{
			"name": "root",
			"type": "string",
			"default": "Home",
			"label": "Root",
			"maxLength": 30
		},
		{
			"name": "section",
			"type": "string",
			"default": "Library",
			"label": "Section",
			"maxLength": 30
		},
		{
			"name": "page",
			"type": "string",
			"default": "Components",
			"label": "Current page",
			"maxLength": 30
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "nav",
		"props": {
			"style": {
				"display": "flex",
				"alignItems": "center",
				"fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
				"fontSize": "14px"
			}
		},
		"children": [
			{
				"tag": "span",
				"props": {
					"style": {
						"color": "#6c757d"
					}
				},
				"children": [
					"{root}"
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"color": "#adb5bd",
						"padding": "0 8px",
						"fontSize": "14px"
					}
				},
				"children": [
					"/"
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"color": "#6c757d"
					}
				},
				"children": [
					"{section}"
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"color": "#adb5bd",
						"padding": "0 8px",
						"fontSize": "14px"
					}
				},
				"children": [
					"/"
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#0d6efd",
									"success": "#198754",
									"warning": "#ffc107",
									"danger": "#dc3545",
									"info": "#0dcaf0",
									"neutral": "#6c757d"
								},
								"default": "#0d6efd"
							}
						},
						"fontWeight": 500
					}
				},
				"children": [
					"{page}"
				]
			}
		]
	},
	"version": 1,
	"familyKey": "breadcrumb-pagination-breadcrumb",
	"source": {
		"kind": "archetype",
		"archetype": "breadcrumb-pagination",
		"variant": "breadcrumb",
		"tranche": 1
	}
}
