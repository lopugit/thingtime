{
	"slug": "bootstrap-badge-solid",
	"name": "Solid Badge",
	"library": "bootstrap",
	"category": "data-display",
	"description": "Filled status badge in the Bootstrap style — solid tone background with contrast text on the library's native badge corners.",
	"tags": [
		"badge",
		"status",
		"solid"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Active",
			"label": "Label",
			"maxLength": 24
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "size",
			"type": "enum",
			"values": [
				"sm",
				"md"
			],
			"default": "sm",
			"label": "Size"
		}
	],
	"render": {
		"tag": "span",
		"props": {
			"style": {
				"ttMerge": [
					{
						"display": "inline-flex",
						"alignItems": "center",
						"gap": "6px",
						"fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
						"fontWeight": 600,
						"lineHeight": 1.4,
						"borderRadius": "50rem"
					},
					{
						"ttMap": {
							"arg": "size",
							"values": {
								"sm": {
									"fontSize": "12px",
									"padding": "2px 8px"
								},
								"md": {
									"fontSize": "14px",
									"padding": "4px 10px"
								}
							},
							"default": {
								"fontSize": "12px",
								"padding": "2px 8px"
							}
						}
					},
					{
						"background": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#0d6efd",
									"success": "#198754",
									"warning": "#ffc107",
									"danger": "#dc3545",
									"info": "#0dcaf0",
									"neutral": "#6c757d"
								},
								"default": "#0d6efd"
							}
						},
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#ffffff",
									"success": "#ffffff",
									"warning": "#000000",
									"danger": "#ffffff",
									"info": "#000000",
									"neutral": "#ffffff"
								},
								"default": "#ffffff"
							}
						}
					}
				]
			}
		},
		"children": [
			"{label}"
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "badge",
		"variant": "solid",
		"tranche": 1
	}
}
