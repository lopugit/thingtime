{
	"slug": "bootstrap-search-command-global-search",
	"name": "Global Search",
	"library": "bootstrap",
	"category": "forms",
	"description": "Global search in the Bootstrap style — a navbar strip pairing a tone-dotted brand mark with a compact search field that tucks a keyboard shortcut hint chip against its right edge.",
	"tags": [
		"search",
		"navbar",
		"shortcut",
		"kbd"
	],
	"args": [
		{
			"name": "brand",
			"type": "string",
			"default": "Acme",
			"label": "Brand",
			"maxLength": 20
		},
		{
			"name": "placeholder",
			"type": "string",
			"default": "Search…",
			"label": "Placeholder",
			"maxLength": 30
		},
		{
			"name": "shortcut",
			"type": "string",
			"default": "⌘K",
			"label": "Shortcut hint",
			"maxLength": 6
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"alignItems": "center",
				"justifyContent": "space-between",
				"gap": "16px",
				"minWidth": "300px",
				"padding": "8px 12px",
				"background": "#ffffff",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "#e9ecef",
				"borderRadius": "6px",
				"boxShadow": "none",
				"fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "8px"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"width": "10px",
								"height": "10px",
								"borderRadius": "999px",
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#0d6efd",
											"success": "#198754",
											"warning": "#ffc107",
											"danger": "#dc3545",
											"info": "#0dcaf0",
											"neutral": "#6c757d"
										},
										"default": "#0d6efd"
									}
								},
								"flexShrink": 0
							}
						}
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "16px",
								"fontWeight": 500,
								"color": "#212529"
							}
						},
						"children": [
							"{brand}"
						]
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "8px",
						"height": "31px",
						"padding": "0 6px 0 10px",
						"boxSizing": "border-box",
						"background": "#f8f9fa",
						"borderWidth": "1px",
						"borderStyle": "solid",
						"borderColor": "#e9ecef",
						"borderRadius": "6px",
						"width": "170px"
					}
				},
				"children": [
					{
						"tag": "svg",
						"props": {
							"width": 14,
							"height": 14,
							"viewBox": "0 0 24 24",
							"fill": "none",
							"stroke": "#adb5bd",
							"strokeWidth": 2,
							"strokeLinecap": "round",
							"strokeLinejoin": "round",
							"xmlns": "http://www.w3.org/2000/svg"
						},
						"children": [
							{
								"tag": "circle",
								"props": {
									"cx": 11,
									"cy": 11,
									"r": 7
								}
							},
							{
								"tag": "line",
								"props": {
									"x1": 21,
									"y1": 21,
									"x2": 16.65,
									"y2": 16.65
								}
							}
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"flexGrow": 1,
								"fontSize": "14px",
								"color": "#6c757d"
							}
						},
						"children": [
							"{placeholder}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
								"fontSize": "12px",
								"color": "#6c757d",
								"background": "#ffffff",
								"borderWidth": "1px",
								"borderStyle": "solid",
								"borderColor": "#dee2e6",
								"borderRadius": "4px",
								"padding": "1px 5px",
								"lineHeight": 1.4
							}
						},
						"children": [
							"{shortcut}"
						]
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "search-command-global-search",
	"source": {
		"kind": "archetype",
		"archetype": "search-command",
		"variant": "global-search",
		"tranche": 2
	}
}
