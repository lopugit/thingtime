{
	"slug": "bootstrap-window-chrome-window",
	"name": "App Window",
	"library": "bootstrap",
	"category": "mockups",
	"description": "Desktop app window in the Bootstrap style — traffic lights beside a centered title bar, a sidebar rail with one tone-highlighted row, and a skeleton content pane.",
	"tags": [
		"mockup",
		"window",
		"desktop",
		"app",
		"frame"
	],
	"args": [
