		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "navItems",
			"type": "number",
			"default": 4,
			"label": "Sidebar rows"
		},
		{
			"name": "lines",
