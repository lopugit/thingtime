{
	"slug": "bootstrap-button-soft",
	"name": "Soft Button",
	"library": "bootstrap",
	"category": "buttons",
	"description": "Tinted button in the Bootstrap style — soft tone wash background with the deeper tone for the label.",
	"tags": [
		"button",
		"action",
		"soft",
		"tinted"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Preview",
			"label": "Label",
			"maxLength": 40
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "size",
			"type": "enum",
			"values": [
				"sm",
				"md",
				"lg"
			],
			"default": "md",
			"label": "Size"
		},
		{
			"name": "disabled",
			"type": "boolean",
			"default": false,
			"label": "Disabled"
		}
	],
	"render": {
		"tag": "button",
		"props": {
			"type": "button",
			"style": {
				"ttMerge": [
					{
						"display": "inline-flex",
						"alignItems": "center",
						"justifyContent": "center",
						"gap": "8px",
						"border": "none",
						"borderRadius": "6px",
						"fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
						"fontWeight": 400,
						"cursor": "pointer"
					},
					{
						"ttMap": {
							"arg": "size",
							"values": {
								"sm": {
									"height": "31px",
									"padding": "0 12px",
									"fontSize": "14px"
								},
								"md": {
									"height": "38px",
									"padding": "0 16px",
									"fontSize": "16px"
								},
								"lg": {
									"height": "48px",
									"padding": "0 20px",
									"fontSize": "18px"
								}
							},
							"default": {
								"height": "38px",
								"padding": "0 16px",
								"fontSize": "16px"
							}
						}
					},
					{
						"background": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#cfe2ff",
									"success": "#d1e7dd",
									"warning": "#fff3cd",
									"danger": "#f8d7da",
									"info": "#cff4fc",
									"neutral": "#e9ecef"
								},
								"default": "#cfe2ff"
							}
						},
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#052c65",
									"success": "#0a3622",
									"warning": "#664d03",
									"danger": "#58151c",
									"info": "#055160",
									"neutral": "#495057"
								},
								"default": "#052c65"
							}
						}
					},
					{
						"ttIf": {
							"arg": "disabled",
							"then": {
								"opacity": 0.5,
								"cursor": "not-allowed"
							},
							"else": {}
						}
					}
				]
			}
		},
		"children": [
			"{label}"
		]
	},
	"version": 1,
	"familyKey": "button-soft",
	"source": {
		"kind": "archetype",
		"archetype": "button",
		"variant": "soft",
		"tranche": 1
	}
}
