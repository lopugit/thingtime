												"height": "6px",
												"borderRadius": "50rem",
												"background": {
													"ttMap": {
														"arg": "tone",
														"values": {
															"primary": "#0d6efd",
															"success": "#198754",
															"warning": "#ffc107",
															"danger": "#dc3545",
															"info": "#0dcaf0",
															"neutral": "#6c757d"
														},
														"default": "#0d6efd"
													}
												}
											}
										}
									}
								]
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "12px",
										"color": "#6c757d",
										"flexShrink": 0
