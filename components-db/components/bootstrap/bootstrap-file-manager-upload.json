{
	"slug": "bootstrap-file-manager-upload",
	"name": "Upload Dropzone",
	"library": "bootstrap",
	"category": "files",
	"description": "Drag-and-drop upload zone in the Bootstrap style — dashed border, tinted upload badge, and a browse link, with an optional in-flight file row driving a live percent progress bar.",
	"tags": [
		"upload",
		"dropzone",
		"files",
		"progress"
	],
	"args": [
		{
			"name": "uploading",
			"type": "boolean",
			"default": true,
			"label": "Uploading"
		},
		{
			"name": "fileName",
			"type": "string",
			"default": "photos.zip",
			"label": "File name",
			"maxLength": 30
		},
		{
			"name": "percent",
			"type": "number",
			"default": 64,
			"label": "Percent",
			"min": 0,
			"max": 100
		},
		{
			"name": "hint",
			"type": "string",
			"default": "PNG, JPG or ZIP up to 25 MB",
			"label": "Hint",
			"maxLength": 60
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
