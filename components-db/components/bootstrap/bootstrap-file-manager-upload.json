								}
							},
							{
								"tag": "polyline",
								"props": {
									"points": "17 8 12 3 7 8"
								}
							},
							{
								"tag": "line",
								"props": {
									"x1": 12,
									"y1": 3,
									"x2": 12,
									"y2": 15
								}
							}
						]
					}
				]
