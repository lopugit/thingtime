						"display": "flex",
						"alignItems": "center",
						"justifyContent": "center",
						"borderRadius": "50rem",
						"background": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#cfe2ff",
									"success": "#d1e7dd",
									"warning": "#fff3cd",
									"danger": "#f8d7da",
									"info": "#cff4fc",
									"neutral": "#e9ecef"
