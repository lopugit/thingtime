{
	"slug": "bootstrap-empty-states-onboarding",
	"name": "Onboarding CTA",
	"library": "bootstrap",
	"category": "feedback",
	"description": "Onboarding call-to-action panel in the Bootstrap style — welcome heading, numbered step dots hinting at the setup flow, and a solid tone start button.",
	"tags": [
		"onboarding",
		"empty-state",
		"steps",
		"cta"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Welcome to your workspace",
			"label": "Title",
			"maxLength": 50
		},
		{
			"name": "body",
			"type": "text",
			"default": "A few quick steps and you’re up and running.",
			"label": "Body"
		},
		{
			"name": "ctaLabel",
			"type": "string",
			"default": "Start setup",
			"label": "CTA label",
			"maxLength": 32
		},
		{
			"name": "steps",
			"type": "number",
			"default": 3,
			"label": "Steps",
			"min": 2,
			"max": 6
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"alignItems": "center",
				"justifyContent": "center",
				"textAlign": "center",
				"gap": "6px",
				"width": "360px",
				"padding": "40px 28px",
				"background": "#ffffff",
				"borderRadius": "8px",
				"fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
				"color": "#212529",
				"border": "1px solid #dee2e6",
				"boxShadow": "0 1rem 3rem rgba(0, 0, 0, .175)"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"width": "46px",
						"height": "46px",
						"borderRadius": "999px",
						"background": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#cfe2ff",
									"success": "#d1e7dd",
									"warning": "#fff3cd",
									"danger": "#f8d7da",
									"info": "#cff4fc",
									"neutral": "#e9ecef"
								},
								"default": "#cfe2ff"
							}
						},
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#052c65",
									"success": "#0a3622",
									"warning": "#664d03",
									"danger": "#58151c",
									"info": "#055160",
									"neutral": "#495057"
								},
								"default": "#052c65"
							}
						},
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "center",
						"marginBottom": "4px"
					}
				},
				"children": [
					{
						"tag": "svg",
						"props": {
							"width": 20,
							"height": 20,
							"viewBox": "0 0 24 24",
							"fill": "none",
							"stroke": "currentColor",
							"strokeWidth": 2,
							"strokeLinecap": "round",
							"strokeLinejoin": "round",
							"xmlns": "http://www.w3.org/2000/svg"
						},
						"children": [
							{
								"tag": "polygon",
								"props": {
									"points": "13 2 3 14 12 14 11 22 21 10 12 10 13 2"
								}
							}
						]
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontWeight": 500,
						"fontSize": "20px"
					}
				},
				"children": [
					"{title}"
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "14px",
						"color": "#6c757d",
						"lineHeight": 1.5,
						"maxWidth": "270px"
					}
				},
				"children": [
					"{body}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "8px",
						"marginTop": "10px",
						"justifyContent": "center"
					}
				},
				"children": [
					{
						"ttRepeat": {
							"arg": "steps",
							"max": 6,
							"node": {
								"tag": "div",
								"props": {
									"style": {
										"width": "24px",
										"height": "24px",
										"borderRadius": "999px",
										"display": "flex",
										"alignItems": "center",
										"justifyContent": "center",
										"fontSize": "12px",
										"fontWeight": 600,
										"background": {
											"ttIf": {
												"arg": "n",
												"equals": 1,
												"then": {
													"ttMap": {
														"arg": "tone",
														"values": {
															"primary": "#0d6efd",
															"success": "#198754",
															"warning": "#ffc107",
															"danger": "#dc3545",
															"info": "#0dcaf0",
															"neutral": "#6c757d"
														},
														"default": "#0d6efd"
													}
												},
												"else": "#f8f9fa"
											}
										},
										"color": {
											"ttIf": {
												"arg": "n",
												"equals": 1,
												"then": {
													"ttMap": {
														"arg": "tone",
														"values": {
															"primary": "#ffffff",
															"success": "#ffffff",
															"warning": "#000000",
															"danger": "#ffffff",
															"info": "#000000",
															"neutral": "#ffffff"
														},
														"default": "#ffffff"
													}
												},
												"else": "#6c757d"
											}
										}
									}
								},
								"children": [
									"{n}"
								]
							}
						}
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "12px",
						"color": "#adb5bd"
					}
				},
				"children": [
					"Step 1 of {steps}"
				]
			},
			{
				"tag": "button",
				"props": {
					"type": "button",
					"style": {
						"display": "inline-flex",
						"alignItems": "center",
						"justifyContent": "center",
						"height": "38px",
						"padding": "0 18px",
						"border": "none",
						"borderRadius": "6px",
						"background": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#0d6efd",
									"success": "#198754",
									"warning": "#ffc107",
									"danger": "#dc3545",
									"info": "#0dcaf0",
									"neutral": "#6c757d"
								},
								"default": "#0d6efd"
							}
						},
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#ffffff",
									"success": "#ffffff",
									"warning": "#000000",
									"danger": "#ffffff",
									"info": "#000000",
									"neutral": "#ffffff"
								},
								"default": "#ffffff"
							}
						},
						"fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
						"fontSize": "14px",
						"fontWeight": 400,
						"boxShadow": "0 .125rem .25rem rgba(0, 0, 0, .075)",
						"cursor": "pointer",
						"marginTop": "8px"
					}
				},
				"children": [
					"{ctaLabel}"
				]
			}
		]
	},
	"previewBg": "#f8f9fa",
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "empty-states",
		"variant": "onboarding",
		"tranche": 1
	}
}
