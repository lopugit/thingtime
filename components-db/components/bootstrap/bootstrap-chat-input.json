				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "send",
			"type": "boolean",
			"default": true,
			"label": "Ready to send"
