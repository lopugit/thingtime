{
	"slug": "bootstrap-chat-input",
	"name": "Message Composer",
	"library": "bootstrap",
	"category": "messaging",
	"description": "Chat composer bar in the Bootstrap style — attach button, rounded text field with placeholder, and a tone-solid action that flips between send and mic.",
	"tags": [
		"chat",
		"composer",
		"input",
		"send"
	],
