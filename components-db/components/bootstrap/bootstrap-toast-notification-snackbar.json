{
	"slug": "bootstrap-toast-notification-snackbar",
	"name": "Snackbar",
	"library": "bootstrap",
	"category": "feedback",
	"description": "Dark snackbar bar in the Bootstrap style — inverse ink surface with the message on the left and a tone-tinted action link on the right.",
	"tags": [
		"snackbar",
		"toast",
		"feedback",
		"action"
	],
	"args": [
		{
			"name": "message",
			"type": "string",
			"default": "Conversation archived",
			"label": "Message",
			"maxLength": 60
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Undo",
			"label": "Action label",
			"maxLength": 24
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "showClose",
			"type": "boolean",
			"default": false,
			"label": "Show close"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"alignItems": "center",
				"gap": "16px",
				"justifyContent": "space-between",
				"minWidth": "300px",
				"padding": "10px 16px",
				"background": "#212529",
				"color": "#ffffff",
				"borderRadius": "6px",
				"boxShadow": "0 1rem 3rem rgba(0, 0, 0, .175)",
				"fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
				"fontSize": "14px"
			}
		},
		"children": [
			{
				"tag": "span",
				"props": {
					"style": {
						"fontWeight": 400
					}
				},
				"children": [
					"{message}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "12px"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#9ec5fe",
											"success": "#a3cfbb",
											"warning": "#ffe69c",
											"danger": "#f1aeb5",
											"info": "#9eeaf9",
											"neutral": "#ced4da"
										},
										"default": "#9ec5fe"
									}
								},
								"fontWeight": 600,
								"cursor": "pointer"
							}
						},
						"children": [
							"{actionLabel}"
						]
					},
					{
						"ttIf": {
							"arg": "showClose",
							"then": {
								"tag": "span",
								"props": {
									"style": {
										"display": "inline-flex",
										"color": "#dee2e6",
										"cursor": "pointer"
									}
								},
								"children": [
									{
										"tag": "svg",
										"props": {
											"width": 14,
											"height": 14,
											"viewBox": "0 0 24 24",
											"fill": "none",
											"stroke": "currentColor",
											"strokeWidth": 2,
											"strokeLinecap": "round",
											"strokeLinejoin": "round",
											"xmlns": "http://www.w3.org/2000/svg"
										},
										"children": [
											{
												"tag": "line",
												"props": {
													"x1": 18,
													"y1": 6,
													"x2": 6,
													"y2": 18
												}
											},
											{
												"tag": "line",
												"props": {
													"x1": 6,
													"y1": 6,
													"x2": 18,
													"y2": 18
												}
											}
										]
									}
								]
							}
						}
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "toast-notification-snackbar",
	"source": {
		"kind": "archetype",
		"archetype": "toast-notification",
		"variant": "snackbar",
		"tranche": 1
	}
}
