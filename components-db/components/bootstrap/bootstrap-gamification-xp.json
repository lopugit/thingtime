{
	"slug": "bootstrap-gamification-xp",
	"name": "XP Progress",
	"library": "bootstrap",
	"category": "engagement",
	"description": "XP progress card in the Bootstrap style — a Level chip, a tone-colored bar with a marker dot riding the fill edge, and an XP-to-next-level caption.",
	"tags": [
		"gamification",
		"xp",
		"progress",
		"level"
	],
	"args": [
		{
			"name": "level",
			"type": "number",
			"default": 7,
			"label": "Level",
			"min": 1
		},
		{
			"name": "percent",
			"type": "number",
			"default": 68,
			"label": "Progress (0–100)",
			"min": 0,
			"max": 100
		},
		{
			"name": "xp",
			"type": "string",
			"default": "1,250",
			"label": "XP remaining",
			"maxLength": 10
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"width": "260px",
				"padding": "16px",
				"boxSizing": "border-box",
				"background": "#ffffff",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "#dee2e6",
				"borderRadius": "8px",
				"boxShadow": "0 .125rem .25rem rgba(0, 0, 0, .075)",
				"fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
				"gap": "12px"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "space-between",
						"gap": "12px"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"display": "inline-flex",
								"alignItems": "center",
								"padding": "2px 10px",
								"borderRadius": "50rem",
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#cfe2ff",
											"success": "#d1e7dd",
											"warning": "#fff3cd",
											"danger": "#f8d7da",
											"info": "#cff4fc",
											"neutral": "#e9ecef"
										},
										"default": "#cfe2ff"
									}
								},
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#052c65",
											"success": "#0a3622",
											"warning": "#664d03",
											"danger": "#58151c",
											"info": "#055160",
											"neutral": "#495057"
										},
										"default": "#052c65"
									}
								},
								"fontSize": "12px",
								"fontWeight": 700
							}
						},
						"children": [
							"Level {level}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "14px",
								"fontWeight": 600,
								"color": "#6c757d",
								"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
							}
						},
						"children": [
							"{percent}%"
						]
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"position": "relative",
						"height": "10px",
						"borderRadius": "50rem",
						"background": "#e9ecef"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"width": "{percent}%",
								"maxWidth": "100%",
								"height": "100%",
								"borderRadius": "50rem",
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#0d6efd",
											"success": "#198754",
											"warning": "#ffc107",
											"danger": "#dc3545",
											"info": "#0dcaf0",
											"neutral": "#6c757d"
										},
										"default": "#0d6efd"
									}
								}
							}
						}
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"position": "absolute",
								"top": "-3px",
								"left": "calc({percent}% - 8px)",
								"width": "16px",
								"height": "16px",
								"boxSizing": "border-box",
								"borderRadius": "50rem",
								"background": "#ffffff",
								"borderWidth": "2px",
								"borderStyle": "solid",
								"borderColor": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#0d6efd",
											"success": "#198754",
											"warning": "#ffc107",
											"danger": "#dc3545",
											"info": "#0dcaf0",
											"neutral": "#6c757d"
										},
										"default": "#0d6efd"
									}
								},
								"boxShadow": "0 .125rem .25rem rgba(0, 0, 0, .075)"
							}
						}
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "12px",
						"color": "#6c757d"
					}
				},
				"children": [
					"{xp} XP to next level"
				]
			}
		]
	},
	"version": 1,
	"familyKey": "gamification-xp",
	"source": {
		"kind": "archetype",
		"archetype": "gamification",
		"variant": "xp",
		"tranche": 2
	}
}
