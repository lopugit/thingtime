{
	"slug": "bootstrap-avatar-status",
	"name": "Status Avatar",
	"library": "bootstrap",
	"category": "data-display",
	"description": "Initials avatar with a presence dot in the Bootstrap style — online, away or busy indicator ringed by the surface color.",
	"tags": [
		"avatar",
		"status",
		"presence",
		"indicator"
	],
	"args": [
		{
			"name": "initials",
			"type": "string",
			"default": "JT",
			"label": "Initials",
			"maxLength": 3
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "status",
			"type": "enum",
			"values": [
				"online",
				"away",
				"busy"
			],
			"default": "online",
			"label": "Status"
		},
		{
			"name": "size",
			"type": "enum",
			"values": [
				"sm",
				"md",
				"lg"
			],
			"default": "md",
			"label": "Size"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"position": "relative",
				"display": "inline-flex"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"ttMerge": [
							{
								"display": "flex",
								"alignItems": "center",
								"justifyContent": "center",
								"fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
								"fontWeight": 500,
								"borderRadius": "50rem",
								"flexShrink": 0,
								"userSelect": "none"
							},
							{
								"ttMap": {
									"arg": "size",
									"values": {
										"sm": {
											"width": "28px",
											"height": "28px",
											"fontSize": "12px"
										},
										"md": {
											"width": "40px",
											"height": "40px",
											"fontSize": "14px"
										},
										"lg": {
											"width": "56px",
											"height": "56px",
											"fontSize": "18px"
										}
									},
									"default": {
										"width": "40px",
										"height": "40px",
										"fontSize": "14px"
									}
								}
							},
							{
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#0d6efd",
											"success": "#198754",
											"warning": "#ffc107",
											"danger": "#dc3545",
											"info": "#0dcaf0",
											"neutral": "#6c757d"
										},
										"default": "#0d6efd"
									}
								},
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#ffffff",
											"success": "#ffffff",
											"warning": "#000000",
											"danger": "#ffffff",
											"info": "#000000",
											"neutral": "#ffffff"
										},
										"default": "#ffffff"
									}
								}
							}
						]
					}
				},
				"children": [
					"{initials}"
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"ttMerge": [
							{
								"position": "absolute",
								"right": "0",
								"bottom": "0",
								"borderRadius": "999px",
								"border": "2px solid #ffffff",
								"background": {
									"ttMap": {
										"arg": "status",
										"values": {
											"online": "#198754",
											"away": "#ffc107",
											"busy": "#dc3545"
										},
										"default": "#198754"
									}
								}
							},
							{
								"ttMap": {
									"arg": "size",
									"values": {
										"sm": {
											"width": "9px",
											"height": "9px"
										},
										"md": {
											"width": "11px",
											"height": "11px"
										},
										"lg": {
											"width": "14px",
											"height": "14px"
										}
									},
									"default": {
										"width": "11px",
										"height": "11px"
									}
								}
							}
						]
					}
				}
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "avatar",
		"variant": "status",
		"tranche": 1
	}
}
