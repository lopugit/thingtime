{
	"slug": "bootstrap-choice-controls-checkbox",
	"name": "Checkbox",
	"library": "bootstrap",
	"category": "forms",
	"description": "Single checkbox with label in the Bootstrap style — checking fills the box with the tone color and draws the check glyph at the library's corner radius.",
	"tags": [
		"form",
		"checkbox",
		"choice",
		"toggle"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Email me product updates",
			"label": "Label",
			"maxLength": 50
		},
		{
			"name": "checked",
			"type": "boolean",
			"default": true,
			"label": "Checked"
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "disabled",
			"type": "boolean",
			"default": false,
			"label": "Disabled"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"alignItems": "center",
				"gap": "8px",
				"cursor": "pointer",
				"opacity": {
					"ttIf": {
						"arg": "disabled",
						"then": 0.5,
						"else": 1
					}
				}
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"ttMerge": [
							{
								"width": "18px",
								"height": "18px",
								"borderRadius": "4px",
								"borderWidth": "1px",
								"borderStyle": "solid",
								"display": "flex",
								"alignItems": "center",
								"justifyContent": "center",
								"flexShrink": 0,
								"boxSizing": "border-box"
							},
							{
								"ttIf": {
									"arg": "checked",
									"then": {
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#0d6efd",
													"success": "#198754",
													"warning": "#ffc107",
													"danger": "#dc3545",
													"info": "#0dcaf0",
													"neutral": "#6c757d"
												},
												"default": "#0d6efd"
											}
										},
										"borderColor": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#0d6efd",
													"success": "#198754",
													"warning": "#ffc107",
													"danger": "#dc3545",
													"info": "#0dcaf0",
													"neutral": "#6c757d"
												},
												"default": "#0d6efd"
											}
										}
									},
									"else": {
										"background": "#ffffff",
										"borderColor": "#dee2e6"
									}
								}
							}
						]
					}
				},
				"children": [
					{
						"ttIf": {
							"arg": "checked",
							"then": {
								"tag": "svg",
								"props": {
									"width": 12,
									"height": 12,
									"viewBox": "0 0 24 24",
									"fill": "none",
									"stroke": {
										"ttMap": {
											"arg": "tone",
											"values": {
												"primary": "#ffffff",
												"success": "#ffffff",
												"warning": "#000000",
												"danger": "#ffffff",
												"info": "#000000",
												"neutral": "#ffffff"
											},
											"default": "#ffffff"
										}
									},
									"strokeWidth": 2,
									"strokeLinecap": "round",
									"strokeLinejoin": "round",
									"xmlns": "http://www.w3.org/2000/svg"
								},
								"children": [
									{
										"tag": "polyline",
										"props": {
											"points": "20 6 9 17 4 12"
										}
									}
								]
							}
						}
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
						"fontSize": "16px",
						"color": "#212529"
					}
				},
				"children": [
					"{label}"
				]
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "choice-controls",
		"variant": "checkbox",
		"tranche": 1
	}
}
