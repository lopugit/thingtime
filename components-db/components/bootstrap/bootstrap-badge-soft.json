{
	"slug": "bootstrap-badge-soft",
	"name": "Soft Badge",
	"library": "bootstrap",
	"category": "data-display",
	"description": "Tinted status badge in the Bootstrap style — soft tone wash with the deeper tone for the label.",
	"tags": [
		"badge",
		"status",
		"soft",
		"tinted"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "In review",
			"label": "Label",
			"maxLength": 24
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "size",
			"type": "enum",
			"values": [
				"sm",
				"md"
			],
			"default": "sm",
			"label": "Size"
		}
	],
	"render": {
		"tag": "span",
		"props": {
			"style": {
				"ttMerge": [
					{
						"display": "inline-flex",
						"alignItems": "center",
						"gap": "6px",
						"fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
						"fontWeight": 600,
						"lineHeight": 1.4,
						"borderRadius": "50rem"
					},
					{
						"ttMap": {
							"arg": "size",
							"values": {
								"sm": {
									"fontSize": "12px",
									"padding": "2px 8px"
								},
								"md": {
									"fontSize": "14px",
									"padding": "4px 10px"
								}
							},
							"default": {
								"fontSize": "12px",
								"padding": "2px 8px"
							}
						}
					},
					{
						"background": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#cfe2ff",
									"success": "#d1e7dd",
									"warning": "#fff3cd",
									"danger": "#f8d7da",
									"info": "#cff4fc",
									"neutral": "#e9ecef"
								},
								"default": "#cfe2ff"
							}
						},
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#052c65",
									"success": "#0a3622",
									"warning": "#664d03",
									"danger": "#58151c",
									"info": "#055160",
									"neutral": "#495057"
								},
								"default": "#052c65"
							}
						}
					}
				]
			}
		},
		"children": [
			"{label}"
		]
	},
	"version": 1,
	"familyKey": "badge-soft",
	"source": {
		"kind": "archetype",
		"archetype": "badge",
		"variant": "soft",
		"tranche": 1
	}
}
