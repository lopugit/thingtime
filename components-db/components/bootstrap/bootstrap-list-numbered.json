{
	"slug": "bootstrap-list-numbered",
	"name": "Numbered List",
	"library": "bootstrap",
	"category": "data-display",
	"description": "Ordered list in the Bootstrap style — hand-styled number markers (pill chips) on a tone tint beside each row.",
	"tags": [
		"list",
		"numbered",
		"ordered",
		"steps"
	],
	"args": [
		{
			"name": "item",
			"type": "string",
			"default": "Step",
			"label": "Item label",
			"maxLength": 40
		},
		{
			"name": "count",
			"type": "number",
			"default": 4,
			"label": "Rows",
			"min": 1,
			"max": 8
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "divided",
			"type": "boolean",
			"default": true,
			"label": "Dividers"
		}
	],
	"render": {
		"tag": "ol",
		"props": {
			"style": {
				"ttMerge": [
					{
						"listStyle": "none",
						"margin": 0,
						"padding": 0,
						"width": "280px",
						"fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
						"color": "#212529",
						"background": "#ffffff",
						"borderRadius": "6px",
						"overflow": "hidden"
					},
					{
						"border": "1px solid #dee2e6",
						"boxShadow": "0 .125rem .25rem rgba(0, 0, 0, .075)"
					}
				]
			}
		},
		"children": [
			{
				"ttRepeat": {
					"arg": "count",
					"max": 8,
					"node": {
						"tag": "li",
						"props": {
							"style": {
								"ttMerge": [
									{
										"display": "flex",
										"alignItems": "center",
										"gap": "12px",
										"padding": "10px 14px",
										"fontSize": "16px"
									},
									{
										"ttIf": {
											"arg": "divided",
											"then": {
												"ttIf": {
													"arg": "n",
													"equals": 1,
													"then": {},
													"else": {
														"borderTop": "1px solid #e9ecef"
													}
												}
											},
											"else": {}
										}
									}
								]
							}
						},
						"children": [
							{
								"tag": "div",
								"props": {
									"style": {
										"width": "24px",
										"height": "24px",
										"borderRadius": "50rem",
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#cfe2ff",
													"success": "#d1e7dd",
													"warning": "#fff3cd",
													"danger": "#f8d7da",
													"info": "#cff4fc",
													"neutral": "#e9ecef"
												},
												"default": "#cfe2ff"
											}
										},
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#052c65",
													"success": "#0a3622",
													"warning": "#664d03",
													"danger": "#58151c",
													"info": "#055160",
													"neutral": "#495057"
												},
												"default": "#052c65"
											}
										},
										"display": "flex",
										"alignItems": "center",
										"justifyContent": "center",
										"fontSize": "12px",
										"fontWeight": 700,
										"fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
										"flexShrink": 0
									}
								},
								"children": [
									"{n}"
								]
							},
							"{item} {n}"
						]
					}
				}
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "list",
		"variant": "numbered",
		"tranche": 1
	}
}
