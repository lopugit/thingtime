{
	"slug": "bootstrap-card-media",
	"name": "Media Card",
	"library": "bootstrap",
	"category": "layout",
	"description": "Card with a media block in the Bootstrap style — a tone-gradient placeholder banner over a badge, title and body.",
	"tags": [
		"card",
		"media",
		"image",
		"banner"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Golden hour",
			"label": "Title",
			"maxLength": 60
		},
		{
			"name": "body",
			"type": "text",
			"default": "A placeholder media block stands in for imagery — no external assets needed.",
			"label": "Body"
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "mediaHeight",
			"type": "enum",
			"values": [
				"sm",
				"md",
				"lg"
			],
			"default": "md",
			"label": "Media height"
		},
		{
			"name": "badge",
			"type": "string",
			"default": "New",
			"label": "Badge",
			"maxLength": 20
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"width": "300px",
				"fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
				"background": "#ffffff",
				"color": "#212529",
				"border": "1px solid #dee2e6",
				"borderRadius": "6px",
				"boxShadow": "0 .125rem .25rem rgba(0, 0, 0, .075)",
				"overflow": "hidden",
				"boxSizing": "border-box"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"ttMerge": [
							{
								"display": "flex",
								"alignItems": "center",
								"justifyContent": "center",
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "linear-gradient(135deg, #cfe2ff 0%, #9ec5fe 60%, #0d6efd 140%)",
											"success": "linear-gradient(135deg, #d1e7dd 0%, #a3cfbb 60%, #198754 140%)",
											"warning": "linear-gradient(135deg, #fff3cd 0%, #ffe69c 60%, #ffc107 140%)",
											"danger": "linear-gradient(135deg, #f8d7da 0%, #f1aeb5 60%, #dc3545 140%)",
											"info": "linear-gradient(135deg, #cff4fc 0%, #9eeaf9 60%, #0dcaf0 140%)",
											"neutral": "linear-gradient(135deg, #e9ecef 0%, #ced4da 60%, #6c757d 140%)"
										},
										"default": "linear-gradient(135deg, #cfe2ff 0%, #9ec5fe 60%, #0d6efd 140%)"
									}
								}
							},
							{
								"ttMap": {
									"arg": "mediaHeight",
									"values": {
										"sm": {
											"height": "72px"
										},
										"md": {
											"height": "112px"
										},
										"lg": {
											"height": "152px"
										}
									},
									"default": {
										"height": "112px"
									}
								}
							}
						]
					}
				},
				"children": [
					{
						"tag": "svg",
						"props": {
							"width": 28,
							"height": 28,
							"viewBox": "0 0 24 24",
							"fill": "none",
							"stroke": {
								"ttMap": {
									"arg": "tone",
									"values": {
										"primary": "#052c65",
										"success": "#0a3622",
										"warning": "#664d03",
										"danger": "#58151c",
										"info": "#055160",
										"neutral": "#495057"
									},
									"default": "#052c65"
								}
							},
							"strokeWidth": 2,
							"strokeLinecap": "round",
							"strokeLinejoin": "round",
							"xmlns": "http://www.w3.org/2000/svg"
						},
						"children": [
							{
								"tag": "rect",
								"props": {
									"x": 3,
									"y": 3,
									"width": 18,
									"height": 18,
									"rx": 2
								}
							},
							{
								"tag": "circle",
								"props": {
									"cx": 8.5,
									"cy": 8.5,
									"r": 1.5
								}
							},
							{
								"tag": "polyline",
								"props": {
									"points": "21 15 16 10 5 21"
								}
							}
						]
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"padding": "16px",
						"gap": "8px"
					}
				},
				"children": [
					{
						"ttIf": {
							"arg": "badge",
							"then": {
								"tag": "span",
								"props": {
									"style": {
										"alignSelf": "flex-start",
										"padding": "2px 8px",
										"borderRadius": "50rem",
										"fontSize": "12px",
										"fontWeight": 600,
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#cfe2ff",
													"success": "#d1e7dd",
													"warning": "#fff3cd",
													"danger": "#f8d7da",
													"info": "#cff4fc",
													"neutral": "#e9ecef"
												},
												"default": "#cfe2ff"
											}
										},
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#052c65",
													"success": "#0a3622",
													"warning": "#664d03",
													"danger": "#58151c",
													"info": "#055160",
													"neutral": "#495057"
												},
												"default": "#052c65"
											}
										},
										"border": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "1px solid #9ec5fe",
													"success": "1px solid #a3cfbb",
													"warning": "1px solid #ffe69c",
													"danger": "1px solid #f1aeb5",
													"info": "1px solid #9eeaf9",
													"neutral": "1px solid #ced4da"
												},
												"default": "1px solid #9ec5fe"
											}
										}
									}
								},
								"children": [
									"{badge}"
								]
							}
						}
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "18px",
								"fontWeight": 500,
								"color": "#212529"
							}
						},
						"children": [
							"{title}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "14px",
								"color": "#6c757d",
								"lineHeight": 1.5
							}
						},
						"children": [
							"{body}"
						]
					}
				]
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "card",
		"variant": "media",
		"tranche": 1
	}
}
