{
	"slug": "bootstrap-tabs-steps-underline",
	"name": "Underline Tabs",
	"library": "bootstrap",
	"category": "navigation",
	"description": "Underline tab row in the Bootstrap style — quiet labels with a tone-colored indicator bar beneath the active tab.",
	"tags": [
		"tabs",
		"navigation",
		"underline"
	],
	"args": [
		{
			"name": "tab1",
			"type": "string",
			"default": "Overview",
			"label": "Tab 1",
			"maxLength": 24
		},
		{
			"name": "tab2",
			"type": "string",
			"default": "Activity",
			"label": "Tab 2",
			"maxLength": 24
		},
		{
			"name": "tab3",
			"type": "string",
			"default": "Settings",
			"label": "Tab 3",
			"maxLength": 24
		},
		{
			"name": "active",
			"type": "enum",
			"values": [
				"1",
				"2",
				"3"
			],
			"default": "1",
			"label": "Active tab"
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"alignItems": "flex-end",
				"gap": "22px",
				"borderBottom": "1px solid #dee2e6",
				"fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
			}
		},
		"children": [
			{
				"tag": "button",
				"props": {
					"type": "button",
					"style": {
						"border": "none",
						"background": "transparent",
						"cursor": "pointer",
						"padding": 0,
						"margin": 0,
						"fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
						"fontWeight": 500,
						"display": "inline-flex",
						"flexDirection": "column",
						"alignItems": "center",
						"fontSize": "16px",
						"marginBottom": "-1px",
						"color": {
							"ttIf": {
								"arg": "active",
								"equals": "1",
								"then": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#0d6efd",
											"success": "#198754",
											"warning": "#ffc107",
											"danger": "#dc3545",
											"info": "#0dcaf0",
											"neutral": "#6c757d"
										},
										"default": "#0d6efd"
									}
								},
								"else": "#6c757d"
							}
						}
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"padding": "9px 2px"
							}
						},
						"children": [
							"{tab1}"
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"height": "2px",
								"width": "100%",
								"borderRadius": "50rem",
								"background": {
									"ttIf": {
