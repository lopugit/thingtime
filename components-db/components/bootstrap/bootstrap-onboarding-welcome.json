{
	"slug": "bootstrap-onboarding-welcome",
	"name": "Welcome Card",
	"library": "bootstrap",
	"category": "onboarding",
	"description": "First-run welcome card in the Bootstrap style — a zap emblem in a tone circle over a personal greeting, supporting copy, primary CTA and a quiet skip link.",
	"tags": [
		"onboarding",
		"welcome",
		"first-run",
		"card"
	],
	"args": [
		{
			"name": "name",
			"type": "string",
			"default": "Alex",
			"label": "Name",
			"maxLength": 24
		},
		{
			"name": "subtext",
			"type": "text",
			"default": "Your workspace is ready. Take the two-minute tour to get the most out of it.",
			"label": "Subtext",
			"maxLength": 160
		},
		{
			"name": "ctaLabel",
			"type": "string",
			"default": "Get started",
			"label": "CTA label",
			"maxLength": 32
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
