				"borderColor": "#dee2e6",
				"borderRadius": "8px",
				"boxShadow": "0 .125rem .25rem rgba(0, 0, 0, .075)",
				"boxSizing": "border-box",
				"width": "280px",
				"alignItems": "center",
				"gap": "14px",
				"padding": "28px 24px",
				"textAlign": "center",
				"position": "relative",
				"overflow": "hidden"
			}
