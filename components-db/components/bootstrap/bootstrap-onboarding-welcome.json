		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"width": "48px",
						"height": "48px",
						"borderRadius": "999px",
						"background": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#cfe2ff",
									"success": "#d1e7dd",
									"warning": "#fff3cd",
									"danger": "#f8d7da",
									"info": "#cff4fc",
