{
	"slug": "bootstrap-stat-metric-card",
	"name": "Stat Card",
	"library": "bootstrap",
	"category": "data-display",
	"description": "Single-metric stat card in the Bootstrap style — quiet label, large tabular value, and a tinted delta pill on Bootstrap surface, border, and radius tokens.",
	"tags": [
		"stat",
		"metric",
		"card",
		"kpi"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Monthly revenue",
			"label": "Label",
			"maxLength": 40
		},
		{
			"name": "value",
			"type": "string",
			"default": "$48,210",
			"label": "Value",
			"maxLength": 20
		},
		{
			"name": "delta",
			"type": "string",
			"default": "+12.4%",
			"label": "Delta",
			"maxLength": 12
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "success",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "inline-flex",
				"flexDirection": "column",
				"fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
				"background": "#ffffff",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "#dee2e6",
				"borderRadius": "8px",
				"boxShadow": "0 .125rem .25rem rgba(0, 0, 0, .075)",
				"boxSizing": "border-box",
				"padding": "16px 20px",
				"gap": "6px",
				"minWidth": "200px"
			}
		},
		"children": [
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "12px",
						"fontWeight": 400,
						"color": "#6c757d"
					}
				},
				"children": [
					"{label}"
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "24px",
						"fontWeight": 500,
						"color": "#212529",
						"lineHeight": 1.15,
						"fontVariantNumeric": "tabular-nums"
					}
				},
				"children": [
					"{value}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "8px",
						"marginTop": "2px"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"display": "inline-flex",
								"alignItems": "center",
								"padding": "2px 8px",
								"borderRadius": "50rem",
								"fontSize": "12px",
								"fontWeight": 600,
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#cfe2ff",
											"success": "#d1e7dd",
											"warning": "#fff3cd",
											"danger": "#f8d7da",
											"info": "#cff4fc",
											"neutral": "#e9ecef"
										},
										"default": "#d1e7dd"
									}
								},
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#052c65",
											"success": "#0a3622",
											"warning": "#664d03",
											"danger": "#58151c",
											"info": "#055160",
											"neutral": "#495057"
										},
										"default": "#0a3622"
									}
								}
							}
						},
						"children": [
							"{delta}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "12px",
								"color": "#adb5bd"
							}
						},
						"children": [
							"vs last month"
						]
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "stat-metric-card",
	"source": {
		"kind": "archetype",
		"archetype": "stat-metric",
		"variant": "card",
		"tranche": 1
	}
}
