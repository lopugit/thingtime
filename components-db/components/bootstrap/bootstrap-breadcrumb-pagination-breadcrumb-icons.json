												"points": "9 22 9 12 15 12 15 22"
											}
										}
									]
								}
							]
						},
						{
							"tag": "span",
							"props": {
								"style": {
									"color": "#adb5bd",
									"padding": "0 8px",
									"fontSize": "14px"
