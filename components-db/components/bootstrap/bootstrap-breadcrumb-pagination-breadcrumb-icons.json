{
	"slug": "bootstrap-breadcrumb-pagination-breadcrumb-icons",
	"name": "Breadcrumb with Icons",
	"library": "bootstrap",
	"category": "navigation",
	"description": "Icon-led breadcrumb in the Bootstrap style — a tone-colored home glyph, a folder-labeled section crumb, and the current page in library type.",
	"tags": [
		"breadcrumb",
		"navigation",
		"icons",
		"home"
	],
	"args": [
		{
			"name": "section",
			"type": "string",
			"default": "Projects",
			"label": "Section",
			"maxLength": 30
		},
		{
			"name": "page",
			"type": "string",
			"default": "Roadmap",
			"label": "Current page",
			"maxLength": 30
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "showHome",
			"type": "boolean",
			"default": true,
			"label": "Show home icon"
		}
	],
	"render": {
