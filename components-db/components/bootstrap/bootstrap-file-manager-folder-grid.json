{
	"slug": "bootstrap-file-manager-folder-grid",
	"name": "Folder Grid",
	"library": "bootstrap",
	"category": "files",
	"description": "Folder tile grid in the Bootstrap style — tone-colored folder glyphs with name and item-count captions, the selected tile lifted by the library focus ring.",
	"tags": [
		"folder",
		"grid",
		"files",
		"tiles"
