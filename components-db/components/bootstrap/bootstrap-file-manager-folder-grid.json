			"type": "string",
			"default": "24",
			"label": "Item count",
			"maxLength": 6
		},
		{
			"name": "folders",
			"type": "number",
			"default": 3,
			"label": "More folders",
			"min": 1,
			"max": 5
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
