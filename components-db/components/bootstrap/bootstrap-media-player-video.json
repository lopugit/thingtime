				"background": "#212529",
				"borderRadius": "8px",
				"overflow": "hidden",
				"fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
				"boxShadow": "0 .5rem 1rem rgba(0, 0, 0, .15)"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"flex": 1,
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "center"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"width": "46px",
								"height": "46px",
								"borderRadius": "50rem",
								"background": "rgba(255, 255, 255, 0.22)",
								"display": "flex",
								"alignItems": "center",
								"justifyContent": "center"
							}
						},
						"children": [
							{
