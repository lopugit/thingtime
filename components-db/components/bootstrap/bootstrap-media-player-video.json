									"width": 18,
									"height": 18,
									"viewBox": "0 0 24 24",
									"fill": "#ffffff",
									"xmlns": "http://www.w3.org/2000/svg"
								},
								"children": [
									{
										"tag": "polygon",
										"props": {
											"points": "8 5 19 12 8 19"
										}
									}
								]
							}
						]
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "10px",
						"padding": "0 12px 10px"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"flex": 1,
								"position": "relative",
								"height": "4px",
								"borderRadius": "50rem",
								"background": "rgba(255, 255, 255, 0.18)"
							}
						},
						"children": [
							{
								"tag": "div",
								"props": {
									"style": {
										"position": "absolute",
										"left": 0,
										"top": 0,
										"height": "100%",
										"width": "{buffered}%",
										"borderRadius": "50rem",
										"background": "rgba(255, 255, 255, 0.35)"
									}
								}
							},
							{
								"tag": "div",
