{
	"slug": "bootstrap-media-player-video",
	"name": "Video Player",
	"library": "bootstrap",
	"category": "media",
	"description": "Dark 16:9 video frame in the Bootstrap style — centered translucent play button, bottom scrubber with faint buffered and tone-colored played layers, plus a monospaced time chip.",
	"tags": [
		"media",
		"video",
		"player",
		"scrubber"
	],
	"args": [
		{
			"name": "percent",
			"type": "number",
			"default": 38,
			"label": "Played %",
			"min": 0,
			"max": 100
		},
		{
			"name": "buffered",
			"type": "number",
			"default": 66,
			"label": "Buffered %",
			"min": 0,
			"max": 100
		},
		{
			"name": "time",
			"type": "string",
			"default": "2:41 / 7:02",
			"label": "Time",
			"maxLength": 16
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
