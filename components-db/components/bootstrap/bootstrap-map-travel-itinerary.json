{
	"slug": "bootstrap-map-travel-itinerary",
	"name": "Itinerary Card",
	"library": "bootstrap",
	"category": "travel",
	"description": "Trip summary card in the Bootstrap style — trip title with a date-range chip, numbered day rows down a dashed dot rail, and a totals footer caption.",
	"tags": [
		"travel",
		"itinerary",
		"trip",
		"planner",
		"card"
	],
	"args": [
		{
			"name": "trip",
			"type": "string",
			"default": "Tokyo long weekend",
			"label": "Trip",
			"maxLength": 40
		},
		{
			"name": "dates",
			"type": "string",
			"default": "Mar 4-9",
			"label": "Dates",
			"maxLength": 16
		},
		{
			"name": "days",
			"type": "number",
			"default": 3,
			"label": "Days (1-6)",
			"min": 1,
			"max": 6
		},
		{
			"name": "stops",
			"type": "string",
			"default": "Shibuya walk · 3 stops",
			"label": "Day caption",
			"maxLength": 40
		},
		{
			"name": "total",
			"type": "string",
			"default": "9 stops · 3 days",
			"label": "Total",
			"maxLength": 30
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
				"background": "#ffffff",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "#dee2e6",
				"borderRadius": "8px",
				"boxShadow": "0 .125rem .25rem rgba(0, 0, 0, .075)",
				"overflow": "hidden",
				"boxSizing": "border-box",
				"width": "250px"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"padding": "14px",
						"gap": "10px"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"justifyContent": "space-between",
								"gap": "8px"
							}
						},
						"children": [
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "18px",
										"fontWeight": 500,
										"color": "#212529"
									}
								},
								"children": [
									"{trip}"
								]
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"display": "inline-flex",
										"alignItems": "center",
										"padding": "2px 8px",
										"borderRadius": "50rem",
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#cfe2ff",
													"success": "#d1e7dd",
													"warning": "#fff3cd",
													"danger": "#f8d7da",
													"info": "#cff4fc",
													"neutral": "#e9ecef"
												},
												"default": "#cfe2ff"
											}
										},
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#052c65",
													"success": "#0a3622",
													"warning": "#664d03",
													"danger": "#58151c",
													"info": "#055160",
													"neutral": "#495057"
												},
												"default": "#052c65"
											}
										},
										"fontSize": "12px",
										"fontWeight": 600,
										"fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
										"whiteSpace": "nowrap"
									}
								},
								"children": [
									"{dates}"
								]
							}
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"flexDirection": "column",
								"gap": "0px"
							}
						},
						"children": [
							{
								"ttRepeat": {
									"arg": "days",
									"max": 6,
									"node": {
										"tag": "div",
										"props": {
											"style": {
												"display": "flex",
												"alignItems": "stretch",
												"gap": "10px"
											}
										},
										"children": [
											{
												"tag": "div",
												"props": {
													"style": {
														"display": "flex",
														"flexDirection": "column",
														"alignItems": "center",
														"width": "10px",
														"paddingTop": "4px"
													}
												},
												"children": [
													{
														"tag": "div",
														"props": {
															"style": {
																"width": "8px",
																"height": "8px",
																"borderRadius": "999px",
																"background": {
																	"ttMap": {
																		"arg": "tone",
																		"values": {
																			"primary": "#0d6efd",
																			"success": "#198754",
																			"warning": "#ffc107",
																			"danger": "#dc3545",
																			"info": "#0dcaf0",
																			"neutral": "#6c757d"
																		},
																		"default": "#0d6efd"
																	}
																},
																"flexShrink": 0
															}
														}
													},
													{
														"tag": "div",
														"props": {
															"style": {
																"flexGrow": 1,
																"width": "0px",
																"borderLeftWidth": "2px",
																"borderLeftStyle": "dashed",
																"borderLeftColor": "#adb5bd",
																"margin": "3px 0 1px"
															}
														}
													}
												]
											},
											{
												"tag": "div",
												"props": {
													"style": {
														"display": "flex",
														"flexDirection": "column",
														"gap": "1px",
														"paddingBottom": "12px",
														"flexGrow": 1
													}
												},
												"children": [
													{
														"tag": "span",
														"props": {
															"style": {
																"fontSize": "14px",
																"fontWeight": 600,
																"color": "#212529"
															}
														},
														"children": [
															"Day {n}"
														]
													},
													{
														"tag": "span",
														"props": {
															"style": {
																"fontSize": "12px",
																"color": "#6c757d"
															}
														},
														"children": [
															"{stops}"
														]
													}
												]
											}
										]
									}
								}
							}
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"borderTopWidth": "1px",
								"borderTopStyle": "solid",
								"borderTopColor": "#e9ecef",
								"paddingTop": "8px",
								"justifyContent": "space-between",
								"gap": "8px"
							}
						},
						"children": [
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "12px",
										"color": "#adb5bd",
										"fontWeight": 600
									}
								},
								"children": [
									"Total"
								]
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "12px",
										"color": "#6c757d",
										"fontWeight": 600
									}
								},
								"children": [
									"{total}"
								]
							}
						]
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "map-travel-itinerary",
	"source": {
		"kind": "archetype",
		"archetype": "map-travel",
		"variant": "itinerary",
		"tranche": 2
	}
}
