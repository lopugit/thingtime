{
	"slug": "thingtime-loading-dots",
	"name": "Loading Dots",
	"library": "thingtime",
	"category": "feedback",
	"description": "Row of pulsing loader dots in the Thingtime style — tone-colored circles fading toward the edges, with an adjustable dot count.",
	"tags": [
		"loading",
		"dots",
		"typing",
		"feedback"
	],
	"args": [
		{
			"name": "count",
			"type": "number",
			"default": 3,
			"label": "Dots",
			"min": 2,
			"max": 5
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "size",
			"type": "enum",
			"values": [
				"sm",
				"md",
				"lg"
			],
			"default": "md",
			"label": "Size"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"alignItems": "center",
				"gap": "6px",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
			}
		},
		"children": [
			{
				"ttRepeat": {
					"arg": "count",
					"max": 5,
					"node": {
						"tag": "span",
						"props": {
							"style": {
								"width": {
									"ttMap": {
										"arg": "size",
										"values": {
											"sm": "6px",
											"md": "8px",
											"lg": "12px"
										},
										"default": "8px"
									}
								},
								"height": {
									"ttMap": {
										"arg": "size",
										"values": {
											"sm": "6px",
											"md": "8px",
											"lg": "12px"
										},
										"default": "8px"
									}
								},
								"borderRadius": "999px",
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#16161a",
											"success": "#2f9e63",
											"warning": "#d99a1f",
											"danger": "#d5484f",
											"info": "#d53f8c",
											"neutral": "#9a9aa6"
										},
										"default": "#16161a"
									}
								},
								"opacity": {
									"ttMap": {
										"arg": "n",
										"values": {
											"1": 0.3,
											"2": 0.6,
											"3": 1,
											"4": 0.6,
											"5": 0.3
										},
										"default": 0.6
									}
								}
							}
						}
					}
				}
			}
		]
	},
	"version": 1,
	"familyKey": "loading-dots",
	"source": {
		"kind": "archetype",
		"archetype": "loading",
		"variant": "dots",
		"tranche": 1
	}
}
