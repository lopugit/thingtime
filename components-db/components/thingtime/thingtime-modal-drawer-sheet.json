{
	"slug": "thingtime-modal-drawer-sheet",
	"name": "Bottom Sheet",
	"library": "thingtime",
	"category": "overlays",
	"description": "Bottom sheet rising over a dimmed backdrop in the Thingtime style — a slim grab handle above the title, body copy, and a full-width tone action.",
	"tags": [
		"sheet",
		"mobile",
		"overlay",
		"bottom"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Share this page",
			"label": "Title",
			"maxLength": 40
		},
		{
			"name": "body",
			"type": "text",
			"default": "Send a link to your teammates or copy it to your clipboard.",
			"label": "Body",
			"maxLength": 200
		},
		{
			"name": "actionLabel",
			"type": "string",
			"default": "Copy link",
			"label": "Action label",
			"maxLength": 24
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"width": "340px",
				"minHeight": "280px",
				"boxSizing": "border-box",
				"background": "rgba(12, 12, 16, 0.45)",
				"borderRadius": "12px",
				"overflow": "hidden",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"flexDirection": "column",
				"justifyContent": "flex-end",
				"alignItems": "stretch"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"background": "#ffffff",
						"color": "#33333c",
						"borderRadius": "16px 16px 0 0",
						"boxShadow": "0 12px 32px rgba(22, 22, 26, 0.10)",
						"display": "flex",
						"flexDirection": "column",
						"overflow": "hidden",
						"padding": "10px 20px 20px"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"width": "40px",
								"height": "4px",
								"borderRadius": "999px",
								"background": "#ececef",
								"margin": "0 auto 14px",
								"flexShrink": 0
							}
						}
					},
					{
						"tag": "h3",
						"props": {
							"style": {
								"margin": "0 0 6px",
								"fontSize": "16px",
								"fontWeight": 700
							}
						},
						"children": [
							"{title}"
						]
					},
					{
						"tag": "p",
						"props": {
							"style": {
								"margin": "0 0 16px",
								"color": "#9a9aa6",
								"fontSize": "12px",
								"lineHeight": 1.6
							}
						},
						"children": [
							"{body}"
						]
					},
					{
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"display": "inline-flex",
								"alignItems": "center",
								"justifyContent": "center",
								"height": "36px",
								"padding": "0 14px",
								"borderRadius": "9px",
								"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
								"fontSize": "12px",
								"fontWeight": 600,
								"cursor": "pointer",
								"border": "none",
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#16161a",
											"success": "#2f9e63",
											"warning": "#d99a1f",
											"danger": "#d5484f",
											"info": "#d53f8c",
											"neutral": "#9a9aa6"
										},
										"default": "#16161a"
									}
								},
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#ffffff",
											"success": "#ffffff",
											"warning": "#ffffff",
											"danger": "#ffffff",
											"info": "#ffffff",
											"neutral": "#ffffff"
										},
										"default": "#ffffff"
									}
								},
								"boxShadow": "0 1px 2px rgba(22, 22, 26, 0.04)",
								"width": "100%"
							}
						},
						"children": [
							"{actionLabel}"
						]
					}
				]
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "modal-drawer",
		"variant": "sheet",
		"tranche": 1
	}
}
