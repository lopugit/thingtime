{
	"slug": "thingtime-forms-advanced-password",
	"name": "Password Strength Field",
	"library": "thingtime",
	"category": "forms",
	"description": "Password field in the Thingtime style — masked dot glyphs inside the field plus a four-segment strength meter sweeping from danger to the house rainbow with a matching caption.",
	"tags": [
		"form",
		"password",
		"strength",
		"security"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Password",
			"label": "Label",
			"maxLength": 30
		},
		{
			"name": "dots",
			"type": "number",
			"default": 8,
			"label": "Characters",
			"min": 1,
			"max": 12
		},
		{
			"name": "strength",
			"type": "enum",
			"values": [
				"weak",
				"fair",
				"good",
				"strong"
			],
			"default": "fair",
			"label": "Strength"
		},
		{
			"name": "focused",
			"type": "boolean",
			"default": false,
			"label": "Focused"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"gap": "6px",
				"width": "260px",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
			}
		},
		"children": [
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "12px",
						"fontWeight": 600,
						"color": "#33333c"
					}
				},
				"children": [
					"{label}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"boxSizing": "border-box",
						"height": "36px",
						"padding": "0 12px",
						"background": "#ffffff",
						"borderWidth": "1px",
						"borderStyle": "solid",
						"borderColor": {
							"ttIf": {
								"arg": "focused",
								"then": "#16161a",
								"else": "#ececef"
							}
						},
						"borderRadius": "9px",
						"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
						"fontSize": "14px",
						"color": "#33333c",
						"gap": "4px",
						"boxShadow": {
							"ttIf": {
								"arg": "focused",
								"then": "0 0 0 3px rgba(213, 63, 140, 0.15)",
								"else": "none"
							}
						}
					}
				},
				"children": [
					{
						"ttRepeat": {
							"arg": "dots",
							"max": 12,
							"node": {
								"tag": "span",
								"props": {
									"style": {
										"width": "6px",
										"height": "6px",
										"borderRadius": "999px",
										"background": "#33333c",
										"flexShrink": 0
									}
								}
							}
						}
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "4px"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"flex": 1,
								"height": "6px",
								"borderRadius": "999px",
								"background": {
									"ttMap": {
										"arg": "strength",
										"values": {
											"weak": "#d5484f",
											"fair": "#d99a1f",
											"good": "#d53f8c",
											"strong": "linear-gradient(90deg, #ff5f6d, #ffc371, #ffe66d, #7cf47c, #6ad6ff, #a78bfa, #f472b6)"
										},
										"default": "#f5f5f7"
									}
								}
							}
						}
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"flex": 1,
								"height": "6px",
								"borderRadius": "999px",
								"background": {
									"ttMap": {
										"arg": "strength",
										"values": {
											"weak": "#f5f5f7",
											"fair": "#d99a1f",
											"good": "#d53f8c",
											"strong": "linear-gradient(90deg, #ff5f6d, #ffc371, #ffe66d, #7cf47c, #6ad6ff, #a78bfa, #f472b6)"
										},
										"default": "#f5f5f7"
									}
								}
							}
						}
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"flex": 1,
								"height": "6px",
								"borderRadius": "999px",
								"background": {
									"ttMap": {
										"arg": "strength",
										"values": {
											"weak": "#f5f5f7",
											"fair": "#f5f5f7",
											"good": "#d53f8c",
											"strong": "linear-gradient(90deg, #ff5f6d, #ffc371, #ffe66d, #7cf47c, #6ad6ff, #a78bfa, #f472b6)"
										},
										"default": "#f5f5f7"
									}
								}
							}
						}
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"flex": 1,
								"height": "6px",
								"borderRadius": "999px",
								"background": {
									"ttMap": {
										"arg": "strength",
										"values": {
											"weak": "#f5f5f7",
											"fair": "#f5f5f7",
											"good": "#f5f5f7",
											"strong": "linear-gradient(90deg, #ff5f6d, #ffc371, #ffe66d, #7cf47c, #6ad6ff, #a78bfa, #f472b6)"
										},
										"default": "#f5f5f7"
									}
								}
							}
						}
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "11px",
						"fontWeight": 500,
						"color": {
							"ttMap": {
								"arg": "strength",
								"values": {
									"weak": "#a83238",
									"fair": "#9a6c12",
									"good": "#a32d6a",
									"strong": "#1f7a4a"
								},
								"default": "#9a9aa6"
							}
						}
					}
				},
				"children": [
					{
						"ttMap": {
							"arg": "strength",
							"values": {
								"weak": "Too weak",
								"fair": "Could be stronger",
								"good": "Good password",
								"strong": "Strong password"
