{
	"slug": "thingtime-support-help-ticket",
	"name": "Support Ticket Row",
	"library": "thingtime",
	"category": "support",
	"description": "Support ticket queue row in the Thingtime style — mono id chip, subject with requester caption, priority and status chips, and the assignee avatar on library-native corners.",
	"tags": [
		"support",
		"ticket",
		"queue",
		"row",
		"status"
	],
	"args": [
		{
			"name": "id",
			"type": "string",
			"default": "4821",
			"label": "Ticket #",
			"maxLength": 8
		},
		{
			"name": "subject",
			"type": "string",
			"default": "Cannot connect my calendar",
			"label": "Subject",
			"maxLength": 60
		},
		{
			"name": "requester",
			"type": "string",
			"default": "Dana P.",
			"label": "Requester",
			"maxLength": 24
		},
		{
			"name": "updated",
			"type": "string",
			"default": "2h ago",
			"label": "Updated",
			"maxLength": 16
		},
		{
			"name": "priority",
			"type": "enum",
			"values": [
				"low",
				"medium",
				"high",
				"urgent"
			],
			"default": "high",
			"label": "Priority"
		},
		{
			"name": "status",
			"type": "enum",
			"values": [
				"open",
				"waiting"
			],
			"default": "open",
			"label": "Status"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"ttMerge": [
					{
						"background": "#ffffff",
						"borderWidth": "1px",
						"borderStyle": "solid",
						"borderColor": "#ececef",
						"borderRadius": "16px",
						"boxShadow": "0 1px 2px rgba(22, 22, 26, 0.04)",
						"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
						"color": "#33333c",
						"boxSizing": "border-box"
					},
					{
						"display": "flex",
						"alignItems": "center",
						"gap": "12px",
						"width": "430px",
						"padding": "10px 14px",
						"borderRadius": "12px"
					}
				]
			}
		},
		"children": [
			{
				"tag": "span",
				"props": {
					"style": {
						"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
						"fontSize": "11px",
						"color": "#9a9aa6",
						"background": "#f5f5f7",
						"padding": "2px 6px",
						"borderRadius": "7px",
						"borderWidth": "1px",
						"borderStyle": "solid",
						"borderColor": "#f5f5f7",
						"flexShrink": 0
					}
				},
				"children": [
					"#{id}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"gap": "2px",
						"flex": "1 1 auto",
						"minWidth": 0
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "12px",
								"fontWeight": 600,
								"color": "#33333c",
								"whiteSpace": "nowrap",
								"overflow": "hidden",
								"textOverflow": "ellipsis"
							}
						},
						"children": [
							"{subject}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "11px",
								"color": "#9a9aa6"
							}
						},
						"children": [
							"{requester} · Updated {updated}"
						]
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"ttMerge": [
							{
								"display": "inline-flex",
								"alignItems": "center",
								"gap": "6px",
								"padding": "2px 8px",
								"fontSize": "11px",
								"fontWeight": 600,
								"lineHeight": 1.4,
								"borderRadius": "999px",
								"textTransform": "capitalize",
								"whiteSpace": "nowrap",
								"flexShrink": 0
							},
							{
								"background": {
									"ttMap": {
										"arg": "priority",
										"values": {
											"low": "#f5f5f7",
											"medium": "#fdeaf3",
											"high": "#fdf6e5",
											"urgent": "#fdeceb"
										},
										"default": "#f5f5f7"
									}
								},
								"color": {
									"ttMap": {
										"arg": "priority",
										"values": {
											"low": "#5a5a66",
											"medium": "#a32d6a",
											"high": "#9a6c12",
											"urgent": "#a83238"
										},
										"default": "#5a5a66"
									}
								}
							},
							{}
						]
					}
				},
				"children": [
					"{priority}"
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"ttMerge": [
							{
								"display": "inline-flex",
								"alignItems": "center",
								"gap": "6px",
								"padding": "2px 8px",
								"fontSize": "11px",
								"fontWeight": 600,
								"lineHeight": 1.4,
								"borderRadius": "999px",
								"textTransform": "capitalize",
								"whiteSpace": "nowrap",
								"flexShrink": 0
							},
							{
								"ttIf": {
									"arg": "status",
									"equals": "open",
									"then": {
										"background": "#fdeaf3",
										"color": "#a32d6a"
									},
									"else": {
										"background": "#f5f5f7",
										"color": "#9a9aa6"
									}
								}
							}
						]
					}
				},
				"children": [
					"{status}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"width": "26px",
						"height": "26px",
						"borderRadius": "999px",
						"background": "#d53f8c",
						"color": "#ffffff",
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "center",
						"fontWeight": 600,
						"fontSize": "11px",
						"flexShrink": 0
					}
				},
				"children": [
					"AK"
				]
			}
		]
	},
	"version": 1,
	"familyKey": "support-help-ticket",
	"source": {
		"kind": "archetype",
		"archetype": "support-help",
		"variant": "ticket",
		"tranche": 2
	}
}
