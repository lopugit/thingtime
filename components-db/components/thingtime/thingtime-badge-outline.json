{
	"slug": "thingtime-badge-outline",
	"name": "Outline Badge",
	"library": "thingtime",
	"category": "data-display",
	"description": "Bordered status badge in the Thingtime style — transparent body with a tone-colored border and matching label text.",
	"tags": [
		"badge",
		"status",
		"outline"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Beta",
			"label": "Label",
			"maxLength": 24
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "size",
			"type": "enum",
			"values": [
				"sm",
				"md"
			],
			"default": "sm",
			"label": "Size"
		}
	],
	"render": {
		"tag": "span",
		"props": {
			"style": {
				"ttMerge": [
					{
						"display": "inline-flex",
						"alignItems": "center",
						"gap": "6px",
						"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
						"fontWeight": 600,
						"lineHeight": 1.4,
						"borderRadius": "999px"
					},
					{
						"ttMap": {
							"arg": "size",
							"values": {
								"sm": {
									"fontSize": "11px",
									"padding": "2px 8px"
								},
								"md": {
									"fontSize": "12px",
									"padding": "4px 10px"
								}
							},
							"default": {
								"fontSize": "11px",
								"padding": "2px 8px"
							}
						}
					},
					{
						"background": "transparent",
						"borderWidth": "1px",
						"borderStyle": "solid",
						"borderColor": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#16161a",
									"success": "#2f9e63",
									"warning": "#d99a1f",
									"danger": "#d5484f",
									"info": "#d53f8c",
									"neutral": "#9a9aa6"
								},
								"default": "#16161a"
							}
						},
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#16161a",
									"success": "#2f9e63",
									"warning": "#d99a1f",
									"danger": "#d5484f",
									"info": "#d53f8c",
									"neutral": "#9a9aa6"
								},
								"default": "#16161a"
							}
						}
					}
				]
			}
		},
		"children": [
			"{label}"
		]
	},
	"version": 1,
	"familyKey": "badge-outline",
	"source": {
		"kind": "archetype",
		"archetype": "badge",
		"variant": "outline",
		"tranche": 1
	}
}
