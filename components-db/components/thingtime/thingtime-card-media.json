{
	"slug": "thingtime-card-media",
	"name": "Media Card",
	"library": "thingtime",
	"category": "layout",
	"description": "Card with a media block in the Thingtime style — a rainbow placeholder banner over a badge, title and body.",
	"tags": [
		"card",
		"media",
		"image",
		"banner"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Golden hour",
			"label": "Title",
			"maxLength": 60
		},
		{
			"name": "body",
			"type": "text",
			"default": "A placeholder media block stands in for imagery — no external assets needed.",
			"label": "Body"
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "mediaHeight",
			"type": "enum",
			"values": [
				"sm",
				"md",
				"lg"
			],
			"default": "md",
			"label": "Media height"
		},
		{
			"name": "badge",
			"type": "string",
			"default": "New",
			"label": "Badge",
			"maxLength": 20
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"width": "300px",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"background": "#ffffff",
				"color": "#33333c",
				"border": "1px solid #ececef",
				"borderRadius": "12px",
				"boxShadow": "0 1px 2px rgba(22, 22, 26, 0.04)",
				"overflow": "hidden",
				"boxSizing": "border-box"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"ttMerge": [
							{
								"display": "flex",
								"alignItems": "center",
								"justifyContent": "center",
								"background": "linear-gradient(90deg, #ff5f6d, #ffc371, #ffe66d, #7cf47c, #6ad6ff, #a78bfa, #f472b6)"
							},
							{
								"ttMap": {
									"arg": "mediaHeight",
									"values": {
										"sm": {
											"height": "72px"
										},
										"md": {
											"height": "112px"
										},
										"lg": {
											"height": "152px"
										}
									},
									"default": {
										"height": "112px"
									}
								}
							}
						]
					}
				},
				"children": [
					{
						"tag": "svg",
						"props": {
							"width": 28,
							"height": 28,
							"viewBox": "0 0 24 24",
							"fill": "none",
							"stroke": "rgba(255, 255, 255, 0.92)",
							"strokeWidth": 2,
							"strokeLinecap": "round",
							"strokeLinejoin": "round",
							"xmlns": "http://www.w3.org/2000/svg"
						},
						"children": [
							{
								"tag": "rect",
								"props": {
									"x": 3,
									"y": 3,
									"width": 18,
									"height": 18,
									"rx": 2
								}
							},
							{
								"tag": "circle",
								"props": {
									"cx": 8.5,
									"cy": 8.5,
									"r": 1.5
								}
							},
							{
								"tag": "polyline",
								"props": {
									"points": "21 15 16 10 5 21"
								}
							}
						]
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"padding": "16px",
						"gap": "8px"
					}
				},
				"children": [
					{
						"ttIf": {
							"arg": "badge",
							"then": {
								"tag": "span",
								"props": {
									"style": {
										"alignSelf": "flex-start",
										"padding": "2px 8px",
										"borderRadius": "999px",
										"fontSize": "11px",
										"fontWeight": 600,
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#f5f5f7",
													"success": "#eafaf1",
													"warning": "#fdf6e5",
													"danger": "#fdeceb",
													"info": "#fdeaf3",
													"neutral": "#f5f5f7"
												},
												"default": "#f5f5f7"
											}
										},
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#16161a",
													"success": "#1f7a4a",
													"warning": "#9a6c12",
													"danger": "#a83238",
													"info": "#a32d6a",
													"neutral": "#5a5a66"
												},
												"default": "#16161a"
											}
										},
										"border": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "1px solid #ececef",
													"success": "1px solid #bfe9d2",
													"warning": "1px solid #f2ddaa",
													"danger": "1px solid #f4c1c3",
													"info": "1px solid #f6bed9",
													"neutral": "1px solid #ececef"
												},
												"default": "1px solid #ececef"
											}
										}
									}
								},
								"children": [
									"{badge}"
								]
							}
						}
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "16px",
								"fontWeight": 700,
								"color": "#16161a"
							}
						},
						"children": [
							"{title}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "12px",
								"color": "#9a9aa6",
								"lineHeight": 1.5
							}
						},
						"children": [
							"{body}"
						]
					}
				]
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "card",
		"variant": "media",
		"tranche": 1
	}
}
