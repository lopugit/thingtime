{
	"slug": "thingtime-news-reading-newsletter",
	"name": "Newsletter Block",
	"library": "thingtime",
	"category": "content",
	"description": "Inline newsletter block in the Thingtime style — serif title with a cadence caption, an email field mock beside a tone Subscribe button that flips to a check and a you-are-in row once subscribed, over subscriber-count and no-spam captions.",
	"tags": [
		"news",
		"newsletter",
		"subscribe",
		"email"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "The Morning Brief",
			"label": "Title",
			"maxLength": 48
		},
		{
			"name": "cadence",
			"type": "string",
			"default": "Every weekday at 7am",
			"label": "Cadence",
			"maxLength": 48
		},
		{
			"name": "subscribers",
			"type": "string",
			"default": "84,000 readers",
			"label": "Subscriber count",
			"maxLength": 32
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "subscribed",
			"type": "boolean",
			"default": false,
			"label": "Subscribed"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"width": "320px",
				"padding": "16px",
				"gap": "10px",
				"background": "#ffffff",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "#f5f5f7",
				"borderRadius": "16px",
				"boxShadow": "none",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"boxSizing": "border-box"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"gap": "2px"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontFamily": "Georgia, 'Times New Roman', serif",
								"fontSize": "16px",
								"fontWeight": 700,
								"color": "#33333c"
							}
						},
						"children": [
							"{title}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "11px",
								"color": "#9a9aa6"
							}
						},
						"children": [
							"{cadence}"
						]
					}
				]
			},
			{
				"ttIf": {
					"arg": "subscribed",
					"then": {
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"gap": "10px",
								"padding": "9px 12px",
								"background": "#eafaf1",
								"borderRadius": "12px"
							}
						},
						"children": [
							{
								"tag": "div",
								"props": {
									"style": {
										"width": "22px",
										"height": "22px",
										"borderRadius": "999px",
										"background": "#2f9e63",
										"color": "#ffffff",
										"display": "flex",
										"alignItems": "center",
										"justifyContent": "center",
										"flexShrink": 0
									}
								},
								"children": [
									{
										"tag": "svg",
										"props": {
											"width": 12,
											"height": 12,
											"viewBox": "0 0 24 24",
											"fill": "none",
											"stroke": "currentColor",
											"strokeWidth": 2,
											"strokeLinecap": "round",
											"strokeLinejoin": "round",
											"xmlns": "http://www.w3.org/2000/svg"
										},
										"children": [
											{
												"tag": "polyline",
												"props": {
													"points": "20 6 9 17 4 12"
												}
											}
										]
									}
								]
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "12px",
										"fontWeight": 600,
										"color": "#1f7a4a"
									}
								},
								"children": [
									"You’re in — check your inbox."
								]
							}
						]
					},
					"else": {
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"gap": "8px"
							}
						},
						"children": [
							{
								"tag": "input",
								"props": {
									"type": "email",
									"placeholder": "you@example.com",
									"style": {
										"flex": 1,
										"minWidth": 0,
										"height": "36px",
										"boxSizing": "border-box",
										"padding": "0 12px",
										"background": "#ffffff",
										"color": "#33333c",
										"borderWidth": "1px",
										"borderStyle": "solid",
										"borderColor": "#ececef",
										"borderRadius": "12px",
										"fontSize": "12px",
										"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
										"outline": "none"
									}
								}
							},
							{
								"tag": "button",
								"props": {
									"type": "button",
									"style": {
										"height": "36px",
										"padding": "0 14px",
										"border": "none",
										"borderRadius": "12px",
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#16161a",
													"success": "#2f9e63",
													"warning": "#d99a1f",
													"danger": "#d5484f",
													"info": "#d53f8c",
													"neutral": "#9a9aa6"
												},
												"default": "#16161a"
											}
										},
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#ffffff",
													"success": "#ffffff",
													"warning": "#ffffff",
													"danger": "#ffffff",
													"info": "#ffffff",
													"neutral": "#ffffff"
												},
												"default": "#ffffff"
											}
										},
										"fontWeight": 600,
										"fontSize": "12px",
										"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
										"cursor": "pointer",
										"flexShrink": 0
									}
								},
								"children": [
									"Subscribe"
								]
							}
						]
					}
				}
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "6px"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "11px",
								"fontWeight": 600,
								"color": "#9a9aa6"
							}
						},
						"children": [
							"{subscribers}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "11px",
								"color": "#b6b6c0"
							}
						},
						"children": [
							"· No spam, unsubscribe anytime"
						]
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "news-reading-newsletter",
	"source": {
		"kind": "archetype",
		"archetype": "news-reading",
		"variant": "newsletter",
		"tranche": 2
	}
}
