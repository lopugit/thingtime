{
	"slug": "thingtime-list-avatar",
	"name": "Avatar List",
	"library": "thingtime",
	"category": "data-display",
	"description": "Avatar-and-name list rows in the Thingtime style — tone-tinted initials circles beside names, a faint recency mark trailing each row.",
	"tags": [
		"list",
		"avatar",
		"people",
		"data"
	],
	"args": [
		{
			"name": "name",
			"type": "string",
			"default": "Alex Rivers",
			"label": "Name",
			"maxLength": 40
		},
		{
			"name": "initials",
			"type": "string",
			"default": "AR",
			"label": "Initials",
			"maxLength": 3
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "count",
			"type": "number",
			"default": 3,
			"label": "Rows",
			"min": 1,
			"max": 6
		}
	],
	"render": {
		"tag": "ul",
		"props": {
			"style": {
				"ttMerge": [
					{
						"listStyle": "none",
						"margin": 0,
						"padding": 0,
						"width": "280px",
						"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
						"color": "#33333c",
						"background": "#ffffff",
						"borderRadius": "12px",
						"overflow": "hidden"
					},
					{
						"border": "1px solid #ececef",
						"boxShadow": "0 1px 2px rgba(22, 22, 26, 0.04)"
					}
				]
			}
		},
		"children": [
			{
				"ttRepeat": {
					"arg": "count",
					"max": 6,
					"node": {
						"tag": "li",
						"props": {
							"style": {
								"ttMerge": [
									{
										"display": "flex",
										"alignItems": "center",
										"gap": "12px",
										"padding": "10px 14px",
										"fontSize": "14px"
									},
									{
										"ttIf": {
											"arg": "n",
											"equals": 1,
											"then": {},
											"else": {
												"borderTop": "1px solid #f5f5f7"
											}
										}
									}
								]
							}
						},
						"children": [
							{
								"tag": "div",
								"props": {
									"style": {
										"width": "32px",
										"height": "32px",
										"borderRadius": "999px",
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#f5f5f7",
													"success": "#eafaf1",
													"warning": "#fdf6e5",
													"danger": "#fdeceb",
													"info": "#fdeaf3",
													"neutral": "#f5f5f7"
												},
												"default": "#f5f5f7"
											}
										},
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#16161a",
													"success": "#1f7a4a",
													"warning": "#9a6c12",
													"danger": "#a83238",
													"info": "#a32d6a",
													"neutral": "#5a5a66"
												},
												"default": "#16161a"
											}
										},
										"display": "flex",
										"alignItems": "center",
										"justifyContent": "center",
										"fontWeight": 600,
										"fontSize": "11px",
										"flexShrink": 0
									}
								},
								"children": [
									"{initials}"
								]
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"fontWeight": 500,
										"flexGrow": 1
									}
								},
								"children": [
									"{name}"
								]
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"color": "#b6b6c0",
										"fontSize": "11px"
									}
								},
								"children": [
									"{n}h"
								]
							}
						]
					}
				}
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "list",
		"variant": "avatar",
		"tranche": 1
	}
}
