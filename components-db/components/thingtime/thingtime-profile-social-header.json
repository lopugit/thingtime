{
	"slug": "thingtime-profile-social-header",
	"name": "Profile Header",
	"library": "thingtime",
	"category": "social",
	"description": "Profile header in the Thingtime style — rainbow cover band, overlapping initials avatar, name, handle and bio, with follow and message actions.",
	"tags": [
		"profile",
		"header",
		"avatar",
		"identity",
		"social"
