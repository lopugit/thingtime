{
	"slug": "thingtime-form-field-labeled",
	"name": "Labeled Field",
	"library": "thingtime",
	"category": "forms",
	"description": "Text input with its label stacked above in the Thingtime style — library-native field border, radius, and type scale across three control sizes.",
	"tags": [
		"form",
		"field",
		"input",
		"label"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Email address",
			"label": "Label",
			"maxLength": 40
		},
		{
			"name": "placeholder",
			"type": "string",
			"default": "you@example.com",
			"label": "Placeholder",
			"maxLength": 60
		},
		{
			"name": "size",
			"type": "enum",
			"values": [
				"sm",
				"md",
				"lg"
			],
			"default": "md",
			"label": "Size"
		},
		{
			"name": "disabled",
			"type": "boolean",
			"default": false,
			"label": "Disabled"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"gap": "6px",
				"width": "280px"
			}
		},
		"children": [
			{
				"tag": "span",
				"props": {
					"style": {
						"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
						"fontSize": "12px",
						"fontWeight": 700,
						"color": "#33333c"
					}
				},
				"children": [
					"{label}"
				]
			},
			{
				"tag": "input",
				"props": {
					"type": "text",
					"placeholder": "{placeholder}",
					"style": {
						"ttMerge": [
							{
								"height": "36px",
								"padding": "0 12px",
								"borderRadius": "9px",
								"borderWidth": "1px",
								"borderStyle": "solid",
								"borderColor": "#ececef",
								"background": "#ffffff",
								"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
								"fontSize": "14px",
								"color": "#33333c",
								"outline": "none",
								"width": "100%",
								"boxSizing": "border-box",
								"boxShadow": "none"
							},
							{
								"ttMap": {
									"arg": "size",
									"values": {
										"sm": {
											"height": "28px",
											"fontSize": "12px"
										},
										"md": {
											"height": "36px",
											"fontSize": "14px"
										},
										"lg": {
											"height": "44px",
											"fontSize": "16px"
										}
									},
									"default": {
										"height": "36px",
										"fontSize": "14px"
									}
								}
							},
							{
								"ttIf": {
									"arg": "disabled",
									"then": {
										"background": "#f5f5f7",
										"color": "#b6b6c0",
										"cursor": "not-allowed",
										"opacity": 0.75
									},
									"else": {}
								}
							}
						]
					}
				}
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "form-field",
		"variant": "labeled",
		"tranche": 1
	}
}
