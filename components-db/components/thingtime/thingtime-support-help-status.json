{
	"slug": "thingtime-support-help-status",
	"name": "Incident Status Banner",
	"library": "thingtime",
	"category": "support",
	"description": "Incident status banner in the Thingtime style — state dot and tint flip between operational, degraded, and outage, with subscribe and details actions plus a shimmer bar during incidents.",
	"tags": [
		"support",
		"status",
		"incident",
		"banner",
		"uptime"
	],
	"args": [
		{
			"name": "system",
			"type": "string",
			"default": "API",
			"label": "System",
			"maxLength": 24
		},
		{
			"name": "state",
			"type": "enum",
			"values": [
				"operational",
				"degraded",
				"outage"
			],
			"default": "degraded",
			"label": "State"
		},
		{
			"name": "ago",
			"type": "string",
			"default": "4 min ago",
			"label": "Updated",
			"maxLength": 16
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"gap": "6px",
				"width": "340px",
				"padding": "12px 14px",
				"boxSizing": "border-box",
				"background": {
					"ttMap": {
						"arg": "state",
						"values": {
							"operational": "#eafaf1",
							"degraded": "#fdf6e5",
							"outage": "#fdeceb"
						},
						"default": "#eafaf1"
					}
				},
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": {
					"ttMap": {
						"arg": "state",
						"values": {
							"operational": "#bfe9d2",
							"degraded": "#f2ddaa",
							"outage": "#f4c1c3"
						},
						"default": "#bfe9d2"
					}
				},
				"borderRadius": "12px",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "8px"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"width": "10px",
								"height": "10px",
								"borderRadius": "999px",
								"flexShrink": 0,
								"background": {
									"ttMap": {
										"arg": "state",
										"values": {
											"operational": "#2f9e63",
											"degraded": "#d99a1f",
											"outage": "#d5484f"
										},
										"default": "#2f9e63"
									}
								}
							}
						}
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "14px",
								"fontWeight": 700,
								"textTransform": "capitalize",
								"color": {
									"ttMap": {
										"arg": "state",
										"values": {
											"operational": "#1f7a4a",
											"degraded": "#9a6c12",
											"outage": "#a83238"
										},
										"default": "#1f7a4a"
									}
								}
							}
						},
						"children": [
							"{system} — {state}"
						]
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "11px",
						"color": "#9a9aa6",
						"paddingLeft": "18px"
					}
				},
				"children": [
					"Updated {ago}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "8px",
						"paddingLeft": "10px"
					}
				},
				"children": [
					{
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"background": "transparent",
								"border": "none",
								"cursor": "pointer",
								"padding": "4px 8px",
								"borderRadius": "9px",
								"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
								"fontSize": "11px",
								"fontWeight": 600,
								"color": {
									"ttMap": {
										"arg": "state",
										"values": {
											"operational": "#1f7a4a",
											"degraded": "#9a6c12",
											"outage": "#a83238"
										},
										"default": "#1f7a4a"
									}
								}
							}
						},
						"children": [
							"Subscribe"
						]
					},
					{
						"tag": "a",
						"props": {
							"href": "#",
							"style": {
								"fontSize": "11px",
								"fontWeight": 600,
								"textDecoration": "underline",
								"color": "#9a9aa6",
								"padding": "4px 0"
							}
						},
						"children": [
							"Details"
						]
					}
				]
			},
			{
				"ttIf": {
					"arg": "state",
					"equals": "operational",
					"then": "",
					"else": {
						"tag": "div",
						"props": {
							"style": {
								"height": "4px",
								"borderRadius": "999px",
								"background": "#ffffff",
								"overflow": "hidden",
								"marginTop": "2px"
							}
						},
						"children": [
							{
								"tag": "div",
								"props": {
									"style": {
										"height": "100%",
										"width": "45%",
										"borderRadius": "999px",
										"background": "linear-gradient(90deg, #ff5f6d, #ffc371, #ffe66d, #7cf47c, #6ad6ff, #a78bfa, #f472b6)"
									}
								}
							}
						]
					}
				}
			}
		]
	},
	"version": 1,
	"familyKey": "support-help-status",
	"source": {
		"kind": "archetype",
		"archetype": "support-help",
		"variant": "status",
		"tranche": 2
	}
}
