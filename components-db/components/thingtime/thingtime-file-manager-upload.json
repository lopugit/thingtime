{
	"slug": "thingtime-file-manager-upload",
	"name": "Upload Dropzone",
	"library": "thingtime",
	"category": "files",
	"description": "Drag-and-drop upload zone in the Thingtime style — dashed border, tinted upload badge, and a browse link, with an optional in-flight file row driving a live percent progress bar filled by the house rainbow.",
	"tags": [
		"upload",
		"dropzone",
		"files",
		"progress"
	],
	"args": [
		{
			"name": "uploading",
			"type": "boolean",
			"default": true,
			"label": "Uploading"
		},
		{
			"name": "fileName",
			"type": "string",
			"default": "photos.zip",
			"label": "File name",
			"maxLength": 30
		},
		{
			"name": "percent",
			"type": "number",
			"default": 64,
			"label": "Percent",
			"min": 0,
			"max": 100
		},
		{
			"name": "hint",
			"type": "string",
			"default": "PNG, JPG or ZIP up to 25 MB",
			"label": "Hint",
			"maxLength": 60
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"alignItems": "center",
				"gap": "8px",
				"width": "300px",
				"padding": "24px 16px",
				"boxSizing": "border-box",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"background": "#f5f5f7",
				"borderWidth": "1px",
				"borderStyle": "dashed",
				"borderColor": "#ececef",
				"borderRadius": "16px"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"width": "40px",
						"height": "40px",
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "center",
						"borderRadius": "999px",
						"background": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#f5f5f7",
									"success": "#eafaf1",
									"warning": "#fdf6e5",
									"danger": "#fdeceb",
									"info": "#fdeaf3",
									"neutral": "#f5f5f7"
								},
								"default": "#f5f5f7"
							}
						},
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#16161a",
									"success": "#1f7a4a",
									"warning": "#9a6c12",
									"danger": "#a83238",
									"info": "#a32d6a",
									"neutral": "#5a5a66"
								},
								"default": "#16161a"
							}
						}
					}
				},
				"children": [
					{
						"tag": "svg",
						"props": {
							"width": 18,
							"height": 18,
							"viewBox": "0 0 24 24",
							"fill": "none",
							"stroke": "currentColor",
							"strokeWidth": 2,
							"strokeLinecap": "round",
							"strokeLinejoin": "round",
							"xmlns": "http://www.w3.org/2000/svg"
						},
						"children": [
							{
								"tag": "path",
								"props": {
									"d": "M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"
								}
							},
							{
								"tag": "polyline",
								"props": {
									"points": "17 8 12 3 7 8"
								}
							},
							{
								"tag": "line",
								"props": {
									"x1": 12,
									"y1": 3,
									"x2": 12,
									"y2": 15
								}
							}
						]
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"gap": "4px",
						"fontSize": "12px",
						"fontWeight": 500,
						"color": "#33333c"
					}
				},
				"children": [
					"Drop files or",
					{
						"tag": "span",
						"props": {
							"style": {
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#16161a",
											"success": "#2f9e63",
											"warning": "#d99a1f",
											"danger": "#d5484f",
											"info": "#d53f8c",
											"neutral": "#9a9aa6"
										},
										"default": "#16161a"
									}
								},
								"fontWeight": 600,
								"textDecoration": "underline",
								"cursor": "pointer"
							}
						},
						"children": [
							"browse"
						]
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "11px",
						"color": "#9a9aa6",
						"lineHeight": 1.4
					}
				},
				"children": [
					"{hint}"
				]
			},
			{
				"ttIf": {
					"arg": "uploading",
					"then": {
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"gap": "8px",
								"width": "100%",
								"marginTop": "4px",
								"padding": "8px 10px",
								"boxSizing": "border-box",
								"background": "#ffffff",
								"borderWidth": "1px",
								"borderStyle": "solid",
								"borderColor": "#f5f5f7",
								"borderRadius": "12px"
							}
						},
						"children": [
							{
								"tag": "span",
								"props": {
									"style": {
										"display": "flex",
										"flexShrink": 0,
										"color": "#9a9aa6"
									}
								},
								"children": [
									{
										"tag": "svg",
										"props": {
											"width": 14,
											"height": 14,
											"viewBox": "0 0 24 24",
											"fill": "none",
											"stroke": "currentColor",
											"strokeWidth": 2,
											"strokeLinecap": "round",
											"strokeLinejoin": "round",
											"xmlns": "http://www.w3.org/2000/svg"
										},
										"children": [
											{
												"tag": "path",
												"props": {
													"d": "M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"
												}
											},
											{
												"tag": "polyline",
												"props": {
													"points": "13 2 13 9 20 9"
												}
											}
										]
									}
								]
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "11px",
										"fontWeight": 500,
										"color": "#33333c",
										"whiteSpace": "nowrap"
									}
								},
								"children": [
									"{fileName}"
								]
							},
							{
								"tag": "div",
								"props": {
									"style": {
										"flex": 1,
										"height": "6px",
										"borderRadius": "999px",
										"background": "#f5f5f7",
										"overflow": "hidden"
									}
								},
								"children": [
									{
										"tag": "div",
										"props": {
											"style": {
												"width": "{percent}%",
												"height": "6px",
												"borderRadius": "999px",
												"background": "linear-gradient(90deg, #ff5f6d, #ffc371, #ffe66d, #7cf47c, #6ad6ff, #a78bfa, #f472b6)"
											}
										}
									}
								]
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "11px",
										"color": "#9a9aa6",
										"flexShrink": 0
									}
								},
								"children": [
									"{percent}%"
								]
							}
						]
					}
				}
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "file-manager",
		"variant": "upload",
		"tranche": 2
	}
}
