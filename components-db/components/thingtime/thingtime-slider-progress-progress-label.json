{
	"slug": "thingtime-slider-progress-progress-label",
	"name": "Labeled Progress",
	"library": "thingtime",
	"category": "forms",
	"description": "Progress bar with a caption row in the Thingtime style — task label on the left, live percent readout on the right, tone-colored fill below.",
	"tags": [
		"progress",
		"label",
		"percent",
		"status"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Uploading assets",
			"label": "Label",
			"maxLength": 40
		},
		{
			"name": "percent",
			"type": "number",
			"default": 68,
			"label": "Percent",
			"min": 0,
			"max": 100
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "showPercent",
			"type": "boolean",
			"default": true,
			"label": "Show percent"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"gap": "6px",
				"width": "240px",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "space-between"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "12px",
								"fontWeight": 700,
								"color": "#33333c"
							}
						},
						"children": [
							"{label}"
						]
					},
					{
						"ttIf": {
							"arg": "showPercent",
							"then": {
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "12px",
										"color": "#9a9aa6"
									}
								},
								"children": [
									"{percent}%"
								]
							}
						}
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"height": "8px",
						"background": "#f5f5f7",
						"borderRadius": "999px",
						"overflow": "hidden"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"width": "{percent}%",
								"height": "100%",
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "linear-gradient(90deg, #ff5f6d, #ffc371, #ffe66d, #7cf47c, #6ad6ff, #a78bfa, #f472b6)",
											"success": "#2f9e63",
											"warning": "#d99a1f",
											"danger": "#d5484f",
											"info": "#d53f8c",
											"neutral": "#9a9aa6"
										},
										"default": "linear-gradient(90deg, #ff5f6d, #ffc371, #ffe66d, #7cf47c, #6ad6ff, #a78bfa, #f472b6)"
									}
								},
								"borderRadius": "999px"
							}
						}
					}
				]
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "slider-progress",
		"variant": "progress-label",
		"tranche": 1
	}
}
