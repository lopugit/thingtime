{
	"slug": "thingtime-slider-progress-range",
	"name": "Range Slider",
	"library": "thingtime",
	"category": "forms",
	"description": "Dual-thumb range slider in the Thingtime style — the tone-colored fill spans from the low to the high value, with optional end labels.",
	"tags": [
		"slider",
		"range",
		"input",
		"dual"
	],
	"args": [
		{
			"name": "low",
			"type": "number",
			"default": 25,
			"label": "Low",
			"min": 0,
			"max": 100
		},
		{
			"name": "high",
			"type": "number",
			"default": 75,
			"label": "High",
			"min": 0,
			"max": 100
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "showValues",
			"type": "boolean",
			"default": true,
			"label": "Show values"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"gap": "8px",
				"width": "240px",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"padding": "8px 0"
			}
		},
		"children": [
			{
				"ttIf": {
					"arg": "showValues",
					"then": {
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"justifyContent": "space-between"
							}
						},
						"children": [
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "11px",
										"color": "#9a9aa6"
									}
								},
								"children": [
									"{low}"
								]
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "11px",
										"color": "#9a9aa6"
									}
								},
								"children": [
									"{high}"
								]
							}
						]
					}
				}
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"position": "relative",
						"height": "6px",
						"background": "#f5f5f7",
						"borderRadius": "999px"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"position": "absolute",
								"left": "{low}%",
								"right": "calc(100% - {high}%)",
								"top": "0",
								"bottom": "0",
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "linear-gradient(90deg, #ff5f6d, #ffc371, #ffe66d, #7cf47c, #6ad6ff, #a78bfa, #f472b6)",
											"success": "#2f9e63",
											"warning": "#d99a1f",
											"danger": "#d5484f",
											"info": "#d53f8c",
											"neutral": "#9a9aa6"
										},
										"default": "linear-gradient(90deg, #ff5f6d, #ffc371, #ffe66d, #7cf47c, #6ad6ff, #a78bfa, #f472b6)"
									}
								},
								"borderRadius": "999px"
							}
						}
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"position": "absolute",
								"left": "{low}%",
								"top": "50%",
								"transform": "translate(-50%, -50%)",
								"width": "16px",
								"height": "16px",
								"borderRadius": "999px",
								"background": "#ffffff",
								"borderWidth": "2px",
								"borderStyle": "solid",
								"borderColor": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#16161a",
											"success": "#2f9e63",
											"warning": "#d99a1f",
											"danger": "#d5484f",
											"info": "#d53f8c",
											"neutral": "#9a9aa6"
										},
										"default": "#16161a"
									}
								},
								"boxShadow": "0 1px 2px rgba(22, 22, 26, 0.04)"
							}
						}
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"position": "absolute",
								"left": "{high}%",
								"top": "50%",
								"transform": "translate(-50%, -50%)",
								"width": "16px",
								"height": "16px",
								"borderRadius": "999px",
								"background": "#ffffff",
								"borderWidth": "2px",
								"borderStyle": "solid",
								"borderColor": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#16161a",
											"success": "#2f9e63",
											"warning": "#d99a1f",
											"danger": "#d5484f",
											"info": "#d53f8c",
											"neutral": "#9a9aa6"
										},
										"default": "#16161a"
									}
								},
								"boxShadow": "0 1px 2px rgba(22, 22, 26, 0.04)"
							}
						}
					}
				]
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "slider-progress",
		"variant": "range",
		"tranche": 1
	}
}
