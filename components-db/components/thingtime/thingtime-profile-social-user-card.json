{
	"slug": "thingtime-profile-social-user-card",
	"name": "User Card",
	"library": "thingtime",
	"category": "social",
	"description": "Compact vertical user card in the Thingtime style — initials avatar, name and role caption over follower mini-stats, with a tone follow button that flips to a 'Following' outline.",
	"tags": [
		"profile",
		"card",
		"avatar",
		"follow",
		"social"
	],
	"args": [
		{
			"name": "initials",
			"type": "string",
			"default": "AK",
			"label": "Initials",
			"maxLength": 3
		},
		{
			"name": "name",
			"type": "string",
			"default": "Avery Kim",
			"label": "Name",
			"maxLength": 40
		},
		{
			"name": "role",
			"type": "string",
			"default": "Product Designer",
			"label": "Role",
			"maxLength": 32
		},
		{
			"name": "followers",
			"type": "string",
			"default": "1,024",
			"label": "Followers",
			"maxLength": 10
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "isFollowing",
			"type": "boolean",
			"default": false,
			"label": "Following"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"background": "#ffffff",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "#ececef",
				"borderRadius": "16px",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"boxShadow": "0 1px 2px rgba(22, 22, 26, 0.04)",
				"width": "220px",
				"display": "flex",
				"flexDirection": "column",
				"alignItems": "center",
				"textAlign": "center",
				"padding": "20px 16px",
				"boxSizing": "border-box"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"width": 56,
						"height": 56,
						"borderRadius": "999px",
						"background": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#16161a",
									"success": "#2f9e63",
									"warning": "#d99a1f",
									"danger": "#d5484f",
									"info": "#d53f8c",
									"neutral": "#9a9aa6"
								},
								"default": "#16161a"
							}
						},
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#ffffff",
									"success": "#ffffff",
									"warning": "#ffffff",
									"danger": "#ffffff",
									"info": "#ffffff",
									"neutral": "#ffffff"
								},
								"default": "#ffffff"
							}
						},
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "center",
						"fontWeight": 600,
						"fontSize": "16px",
						"flexShrink": 0
					}
				},
				"children": [
					"{initials}"
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"marginTop": "10px",
						"fontSize": "14px",
						"fontWeight": 700,
						"color": "#33333c"
					}
				},
				"children": [
					"{name}"
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"marginTop": "2px",
						"fontSize": "11px",
						"color": "#9a9aa6"
					}
				},
				"children": [
					"{role}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"marginTop": "12px",
						"gap": "18px",
						"justifyContent": "center"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"flexDirection": "column",
								"alignItems": "center"
							}
						},
						"children": [
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "12px",
										"fontWeight": 700,
										"color": "#33333c"
									}
								},
								"children": [
									"{followers}"
								]
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "11px",
										"color": "#9a9aa6"
									}
								},
								"children": [
									"Followers"
								]
							}
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"flexDirection": "column",
								"alignItems": "center"
							}
						},
						"children": [
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "12px",
										"fontWeight": 700,
										"color": "#33333c"
									}
								},
								"children": [
									"412"
								]
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "11px",
										"color": "#9a9aa6"
									}
								},
								"children": [
									"Following"
								]
							}
						]
					}
				]
			},
			{
				"tag": "button",
				"props": {
					"type": "button",
					"style": {
						"ttMerge": [
							{
								"display": "inline-flex",
								"alignItems": "center",
								"justifyContent": "center",
								"borderRadius": "9px",
								"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
								"fontSize": "12px",
								"fontWeight": 600,
								"cursor": "pointer"
							},
							{
								"marginTop": "14px",
								"width": "100%",
								"height": "28px",
								"padding": "0 12px",
								"borderWidth": "1px",
								"borderStyle": "solid",
								"boxSizing": "border-box"
							},
							{
								"ttIf": {
									"arg": "isFollowing",
									"then": {
										"background": "transparent",
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#16161a",
													"success": "#2f9e63",
													"warning": "#d99a1f",
													"danger": "#d5484f",
													"info": "#d53f8c",
													"neutral": "#9a9aa6"
												},
												"default": "#16161a"
											}
										},
										"borderColor": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#16161a",
													"success": "#2f9e63",
													"warning": "#d99a1f",
													"danger": "#d5484f",
													"info": "#d53f8c",
													"neutral": "#9a9aa6"
												},
												"default": "#16161a"
											}
										}
									},
									"else": {
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#16161a",
													"success": "#2f9e63",
													"warning": "#d99a1f",
													"danger": "#d5484f",
													"info": "#d53f8c",
													"neutral": "#9a9aa6"
												},
												"default": "#16161a"
											}
										},
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#ffffff",
													"success": "#ffffff",
													"warning": "#ffffff",
													"danger": "#ffffff",
													"info": "#ffffff",
													"neutral": "#ffffff"
												},
												"default": "#ffffff"
											}
										},
										"borderColor": "transparent"
									}
								}
							}
						]
					}
				},
				"children": [
					{
						"ttIf": {
							"arg": "isFollowing",
							"then": "Following",
							"else": "Follow"
						}
					}
				]
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "profile-social",
		"variant": "user-card",
		"tranche": 2
	}
}
