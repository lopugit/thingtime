{
	"slug": "thingtime-tooltip-popover-tooltip",
	"name": "Tooltip",
	"library": "thingtime",
	"category": "overlays",
	"description": "Dark tooltip bubble in the Thingtime style — inverse ink pill anchored above or below its trigger, with a CSS-triangle arrow pointing at the control.",
	"tags": [
		"tooltip",
		"overlay",
		"hint",
		"arrow"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Copied to clipboard",
			"label": "Tooltip text",
			"maxLength": 60
		},
		{
			"name": "triggerLabel",
			"type": "string",
			"default": "Hover me",
			"label": "Trigger label",
			"maxLength": 24
		},
		{
			"name": "placement",
			"type": "enum",
			"values": [
				"top",
				"bottom"
			],
			"default": "top",
			"label": "Placement"
		},
		{
			"name": "showArrow",
			"type": "boolean",
			"default": true,
			"label": "Show arrow"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "inline-flex",
				"flexDirection": "column",
				"alignItems": "center",
				"gap": "4px",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
			}
		},
		"children": [
			{
				"ttIf": {
					"arg": "placement",
					"equals": "top",
					"then": {
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"flexDirection": "column",
								"alignItems": "center"
							}
						},
						"children": [
							{
								"tag": "div",
								"props": {
									"style": {
										"background": "#16161a",
										"color": "#ffffff",
										"padding": "5px 10px",
										"borderRadius": "9px",
										"fontSize": "11px",
										"maxWidth": "220px",
										"textAlign": "center",
										"boxShadow": "0 4px 12px rgba(22, 22, 26, 0.06)"
									}
								},
								"children": [
									"{label}"
								]
							},
							{
								"ttIf": {
									"arg": "showArrow",
									"then": {
										"tag": "div",
										"props": {
											"style": {
												"width": 0,
												"height": 0,
												"borderLeft": "6px solid transparent",
												"borderRight": "6px solid transparent",
												"borderTop": "6px solid #16161a"
											}
										}
									}
								}
							}
						]
					}
				}
			},
			{
				"tag": "button",
				"props": {
					"type": "button",
					"style": {
						"display": "inline-flex",
						"alignItems": "center",
						"justifyContent": "center",
						"gap": "6px",
						"height": "36px",
						"padding": "0 14px",
						"background": "#ffffff",
						"color": "#33333c",
						"border": "1px solid #ececef",
						"borderRadius": "12px",
						"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
						"fontSize": "12px",
						"fontWeight": 600,
						"boxShadow": "0 1px 2px rgba(22, 22, 26, 0.04)",
						"cursor": "pointer"
					}
				},
				"children": [
					"{triggerLabel}"
				]
			},
			{
				"ttIf": {
					"arg": "placement",
					"equals": "bottom",
					"then": {
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"flexDirection": "column",
								"alignItems": "center"
							}
						},
						"children": [
							{
								"ttIf": {
									"arg": "showArrow",
									"then": {
										"tag": "div",
										"props": {
											"style": {
												"width": 0,
												"height": 0,
												"borderLeft": "6px solid transparent",
												"borderRight": "6px solid transparent",
												"borderBottom": "6px solid #16161a"
											}
										}
									}
								}
							},
							{
								"tag": "div",
								"props": {
									"style": {
										"background": "#16161a",
										"color": "#ffffff",
										"padding": "5px 10px",
										"borderRadius": "9px",
										"fontSize": "11px",
										"maxWidth": "220px",
										"textAlign": "center",
										"boxShadow": "0 4px 12px rgba(22, 22, 26, 0.06)"
									}
								},
								"children": [
									"{label}"
								]
							}
						]
					}
				}
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "tooltip-popover",
		"variant": "tooltip",
		"tranche": 1
	}
}
