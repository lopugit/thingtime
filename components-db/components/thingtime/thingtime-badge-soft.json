{
	"slug": "thingtime-badge-soft",
	"name": "Soft Badge",
	"library": "thingtime",
	"category": "data-display",
	"description": "Tinted status badge in the Thingtime style — soft tone wash with the deeper tone for the label.",
	"tags": [
		"badge",
		"status",
		"soft",
		"tinted"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "In review",
			"label": "Label",
			"maxLength": 24
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "size",
			"type": "enum",
			"values": [
				"sm",
				"md"
			],
			"default": "sm",
			"label": "Size"
		}
	],
	"render": {
		"tag": "span",
		"props": {
			"style": {
				"ttMerge": [
					{
						"display": "inline-flex",
						"alignItems": "center",
						"gap": "6px",
						"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
						"fontWeight": 600,
						"lineHeight": 1.4,
						"borderRadius": "999px"
					},
					{
						"ttMap": {
							"arg": "size",
							"values": {
								"sm": {
									"fontSize": "11px",
									"padding": "2px 8px"
								},
								"md": {
									"fontSize": "12px",
									"padding": "4px 10px"
								}
							},
							"default": {
								"fontSize": "11px",
								"padding": "2px 8px"
							}
						}
					},
					{
						"background": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#f5f5f7",
									"success": "#eafaf1",
									"warning": "#fdf6e5",
									"danger": "#fdeceb",
									"info": "#fdeaf3",
									"neutral": "#f5f5f7"
								},
								"default": "#f5f5f7"
							}
						},
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#16161a",
									"success": "#1f7a4a",
									"warning": "#9a6c12",
									"danger": "#a83238",
									"info": "#a32d6a",
									"neutral": "#5a5a66"
								},
								"default": "#16161a"
							}
						}
					}
				]
			}
		},
		"children": [
			"{label}"
		]
	},
	"version": 1,
	"familyKey": "badge-soft",
	"source": {
		"kind": "archetype",
		"archetype": "badge",
		"variant": "soft",
		"tranche": 1
	}
}
