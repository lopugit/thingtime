{
	"slug": "thingtime-card-elevated",
	"name": "Elevated Card",
	"library": "thingtime",
	"category": "layout",
	"description": "Floating borderless card in the Thingtime style — the library's deeper shadow tiers lift it off the page, led by a tone-tinted icon chip.",
	"tags": [
		"card",
		"elevated",
		"shadow",
		"floating"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Quick insight",
			"label": "Title",
			"maxLength": 60
		},
		{
			"name": "body",
			"type": "text",
			"default": "Elevation carries the hierarchy here — the card floats free of any border.",
			"label": "Body"
		},
		{
			"name": "elevation",
			"type": "enum",
			"values": [
				"raised",
				"floating"
			],
			"default": "floating",
			"label": "Elevation"
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"width": "300px",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"background": "#ffffff",
				"color": "#33333c",
				"border": "none",
				"borderRadius": "12px",
				"boxShadow": {
					"ttMap": {
						"arg": "elevation",
						"values": {
							"raised": "0 4px 12px rgba(22, 22, 26, 0.06)",
							"floating": "0 12px 32px rgba(22, 22, 26, 0.10)"
						},
						"default": "0 12px 32px rgba(22, 22, 26, 0.10)"
					}
				},
				"overflow": "hidden",
				"boxSizing": "border-box",
				"padding": "16px",
				"gap": "10px"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "10px"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"width": "32px",
								"height": "32px",
								"borderRadius": "9px",
								"display": "flex",
								"alignItems": "center",
								"justifyContent": "center",
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#f5f5f7",
											"success": "#eafaf1",
											"warning": "#fdf6e5",
											"danger": "#fdeceb",
											"info": "#fdeaf3",
											"neutral": "#f5f5f7"
										},
										"default": "#f5f5f7"
									}
								},
								"flexShrink": 0
							}
						},
						"children": [
							{
								"tag": "svg",
								"props": {
									"width": 16,
									"height": 16,
									"viewBox": "0 0 24 24",
									"fill": "none",
									"stroke": {
										"ttMap": {
											"arg": "tone",
											"values": {
												"primary": "#16161a",
												"success": "#1f7a4a",
												"warning": "#9a6c12",
												"danger": "#a83238",
												"info": "#a32d6a",
												"neutral": "#5a5a66"
											},
											"default": "#16161a"
										}
									},
									"strokeWidth": 2,
									"strokeLinecap": "round",
									"strokeLinejoin": "round",
									"xmlns": "http://www.w3.org/2000/svg"
								},
								"children": [
									{
										"tag": "polygon",
										"props": {
											"points": "13 2 3 14 12 14 11 22 21 10 12 10 13 2"
										}
									}
								]
							}
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "16px",
								"fontWeight": 700,
								"color": "#16161a"
							}
						},
						"children": [
							"{title}"
						]
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "12px",
						"color": "#9a9aa6",
						"lineHeight": 1.5
					}
				},
				"children": [
					"{body}"
				]
			}
		]
	},
	"version": 1,
	"familyKey": "card-elevated",
	"source": {
		"kind": "archetype",
		"archetype": "card",
		"variant": "elevated",
		"tranche": 1
	}
}
