								"borderColor": "#ececef",
								"background": "#ffffff",
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#16161a",
											"success": "#2f9e63",
											"warning": "#d99a1f",
											"danger": "#d5484f",
											"info": "#d53f8c",
											"neutral": "#9a9aa6"
										},
										"default": "#16161a"
									}
								},
								"cursor": "pointer"
							}
						},
						"children": [
							{
								"tag": "svg",
								"props": {
									"width": 16,
									"height": 16,
									"viewBox": "0 0 24 24",
									"fill": "none",
									"stroke": "currentColor",
									"strokeWidth": 2,
									"strokeLinecap": "round",
									"strokeLinejoin": "round",
									"xmlns": "http://www.w3.org/2000/svg"
								},
								"children": [
									{
										"tag": "polyline",
										"props": {
											"points": "9 6 15 12 9 18"
										}
									}
								]
							}
						]
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "breadcrumb-pagination-summary",
	"source": {
		"kind": "archetype",
		"archetype": "breadcrumb-pagination",
		"variant": "summary",
		"tranche": 1
	}
}
