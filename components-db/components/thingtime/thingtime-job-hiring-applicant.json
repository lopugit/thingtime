{
	"slug": "thingtime-job-hiring-applicant",
	"name": "Applicant Row",
	"library": "thingtime",
	"category": "hiring",
	"description": "Applicant pipeline row in the Thingtime style — initials avatar, name with applied caption, stage chip tinted per pipeline stage, a stepped match-score ring, and a shortlist star toggle.",
	"tags": [
		"hiring",
		"applicant",
		"candidate",
		"pipeline"
	],
	"args": [
		{
			"name": "name",
			"type": "string",
			"default": "Maya Chen",
			"label": "Name",
			"maxLength": 32
		},
		{
			"name": "initials",
			"type": "string",
			"default": "MC",
			"label": "Initials",
			"maxLength": 3
		},
		{
			"name": "role",
			"type": "string",
			"default": "Product Designer",
			"label": "Role",
			"maxLength": 40
		},
		{
			"name": "stage",
			"type": "enum",
			"values": [
				"screening",
				"interview",
				"offer",
				"hired"
			],
			"default": "interview",
			"label": "Stage"
		},
		{
			"name": "score",
			"type": "enum",
			"values": [
				"40",
				"55",
				"70",
				"85",
				"95"
			],
			"default": "85",
			"label": "Match score"
		},
		{
			"name": "shortlisted",
			"type": "boolean",
			"default": false,
			"label": "Shortlisted"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"alignItems": "center",
				"width": "420px",
				"boxSizing": "border-box",
				"padding": "12px 14px",
				"gap": "12px",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"color": "#33333c",
				"background": "#ffffff",
				"borderRadius": "12px",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "#ececef",
				"boxShadow": "0 1px 2px rgba(22, 22, 26, 0.04)"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"width": "36px",
						"height": "36px",
						"borderRadius": "999px",
						"background": "#f5f5f7",
						"color": "#5a5a66",
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "center",
						"fontWeight": 600,
						"fontSize": "11px",
						"flexShrink": 0
					}
				},
				"children": [
					"{initials}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"gap": "2px",
						"flex": "1",
						"minWidth": 0
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "12px",
								"fontWeight": 700
							}
						},
						"children": [
							"{name}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "11px",
								"color": "#9a9aa6"
							}
						},
						"children": [
							"{role} · applied 2d ago"
						]
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"ttMerge": [
							{
								"display": "inline-flex",
								"alignItems": "center",
								"gap": "4px",
								"padding": "2px 8px",
								"borderRadius": "999px",
								"fontSize": "11px",
								"fontWeight": 600,
								"lineHeight": 1.6,
								"textTransform": "capitalize",
								"flexShrink": 0
							},
							{
								"ttMap": {
									"arg": "stage",
									"values": {
										"screening": {
											"background": "#fdeaf3",
											"color": "#a32d6a"
										},
										"interview": {
											"background": "#fdf6e5",
											"color": "#9a6c12"
										},
										"offer": {
											"background": "#f5f5f7",
											"color": "#16161a"
										},
										"hired": {
											"background": "#eafaf1",
											"color": "#1f7a4a"
										}
									}
								}
							}
						]
					}
				},
				"children": [
					"{stage}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "5px",
						"flexShrink": 0
					}
				},
				"children": [
					{
						"tag": "svg",
						"props": {
							"width": 32,
							"height": 32,
							"viewBox": "0 0 36 36",
							"fill": "none",
							"xmlns": "http://www.w3.org/2000/svg"
						},
						"children": [
							{
								"tag": "circle",
								"props": {
									"cx": 18,
									"cy": 18,
									"r": 15.9,
									"stroke": "#f5f5f7",
									"strokeWidth": 3.5
								}
							},
							{
								"tag": "circle",
								"props": {
									"cx": 18,
									"cy": 18,
									"r": 15.9,
									"stroke": "#d53f8c",
									"strokeWidth": 3.5,
									"strokeLinecap": "round",
									"style": {
										"strokeDasharray": {
											"ttMap": {
												"arg": "score",
												"values": {
													"40": "40 100",
													"55": "55 100",
													"70": "70 100",
													"85": "85 100",
													"95": "95 100"
												},
												"default": "70 100"
											}
										},
										"transform": "rotate(-90deg)",
										"transformOrigin": "50% 50%"
									}
								}
							}
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "12px",
								"fontWeight": 700
							}
						},
						"children": [
							"{score}%"
						]
					}
				]
			},
			{
				"tag": "button",
				"props": {
					"type": "button",
					"style": {
						"display": "inline-flex",
						"alignItems": "center",
						"justifyContent": "center",
						"width": "28px",
						"height": "28px",
						"padding": "0",
						"border": "none",
						"borderRadius": "9px",
						"background": "transparent",
						"cursor": "pointer",
						"flexShrink": 0
					}
				},
				"children": [
					{
						"ttIf": {
							"arg": "shortlisted",
							"then": {
								"tag": "svg",
								"props": {
									"width": 16,
									"height": 16,
									"viewBox": "0 0 24 24",
									"fill": "#d99a1f",
									"stroke": "#d99a1f",
									"strokeWidth": 2,
									"strokeLinejoin": "round",
									"xmlns": "http://www.w3.org/2000/svg"
								},
								"children": [
									{
										"tag": "polygon",
										"props": {
											"points": "12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26"
										}
									}
								]
							},
							"else": {
								"tag": "svg",
								"props": {
									"width": 16,
									"height": 16,
									"viewBox": "0 0 24 24",
									"fill": "none",
									"stroke": "#b6b6c0",
									"strokeWidth": 2,
									"strokeLinejoin": "round",
									"xmlns": "http://www.w3.org/2000/svg"
								},
								"children": [
									{
										"tag": "polygon",
										"props": {
											"points": "12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26"
										}
									}
								]
							}
						}
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "job-hiring-applicant",
	"source": {
		"kind": "archetype",
		"archetype": "job-hiring",
		"variant": "applicant",
		"tranche": 2
	}
}
