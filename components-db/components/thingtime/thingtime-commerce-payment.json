{
	"slug": "thingtime-commerce-payment",
	"name": "Payment Method",
	"library": "thingtime",
	"category": "commerce",
	"description": "Saved payment method row in the Thingtime style — tinted card-brand chip, masked card number, expiry caption, selectable radio ring and an optional default badge.",
	"tags": [
		"commerce",
		"payment",
		"card",
		"saved-method"
	],
	"args": [
		{
			"name": "brand",
			"type": "enum",
			"values": [
				"visa",
				"mastercard",
				"amex"
			],
			"default": "visa",
			"label": "Brand"
		},
		{
			"name": "last4",
			"type": "string",
			"default": "4242",
			"label": "Last 4",
			"maxLength": 4
		},
		{
			"name": "expiry",
			"type": "string",
			"default": "12/27",
			"label": "Expiry",
			"maxLength": 7
		},
		{
			"name": "selected",
			"type": "boolean",
			"default": true,
			"label": "Selected"
		},
		{
			"name": "isDefault",
			"type": "boolean",
			"default": true,
			"label": "Default badge"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"alignItems": "center",
				"gap": "12px",
				"width": "340px",
				"padding": "12px 14px",
				"background": "#ffffff",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": {
					"ttIf": {
						"arg": "selected",
						"then": "#16161a",
						"else": "#ececef"
					}
				},
				"borderRadius": "12px",
				"boxShadow": {
					"ttIf": {
						"arg": "selected",
						"then": "0 0 0 3px rgba(213, 63, 140, 0.15)",
						"else": "0 1px 2px rgba(22, 22, 26, 0.04)"
					}
				},
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"boxSizing": "border-box"
			}
		},
		"children": [
			{
				"tag": "span",
				"props": {
					"style": {
						"width": "16px",
						"height": "16px",
						"borderRadius": "999px",
						"borderWidth": "2px",
						"borderStyle": "solid",
						"borderColor": {
							"ttIf": {
								"arg": "selected",
								"then": "#16161a",
								"else": "#b6b6c0"
							}
						},
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "center",
						"boxSizing": "border-box",
						"flexShrink": 0
					}
				},
				"children": [
					{
						"ttIf": {
							"arg": "selected",
							"then": {
								"tag": "span",
								"props": {
									"style": {
										"width": "7px",
										"height": "7px",
										"borderRadius": "999px",
										"background": "#16161a"
									}
								}
							}
						}
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"padding": "3px 8px",
						"borderRadius": "9px",
						"background": {
							"ttMap": {
								"arg": "brand",
								"values": {
									"visa": "#fdeaf3",
									"mastercard": "#fdeceb",
									"amex": "#eafaf1"
								}
							}
						},
						"color": {
							"ttMap": {
								"arg": "brand",
								"values": {
									"visa": "#a32d6a",
									"mastercard": "#a83238",
									"amex": "#1f7a4a"
								}
							}
						},
						"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
						"fontSize": "11px",
						"fontWeight": 700,
						"letterSpacing": "0.04em",
						"flexShrink": 0
					}
				},
				"children": [
					{
						"ttMap": {
							"arg": "brand",
							"values": {
								"visa": "VISA",
								"mastercard": "MC",
								"amex": "AMEX"
							}
						}
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"gap": "2px",
						"flex": "1 1 auto",
						"minWidth": 0
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"gap": "6px"
							}
						},
						"children": [
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "12px",
										"fontWeight": 600,
										"color": "#33333c"
									}
								},
								"children": [
									"•••• {last4}"
								]
							},
							{
								"ttIf": {
									"arg": "isDefault",
									"then": {
										"tag": "span",
										"props": {
											"style": {
												"padding": "1px 8px",
												"borderRadius": "999px",
												"background": "#f5f5f7",
												"color": "#5a5a66",
												"fontSize": "11px",
												"fontWeight": 600
											}
										},
										"children": [
											"Default"
										]
									}
								}
							}
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "11px",
								"color": "#9a9aa6"
							}
						},
						"children": [
							"Expires {expiry}"
						]
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "commerce-payment",
	"source": {
		"kind": "archetype",
		"archetype": "commerce",
		"variant": "payment",
		"tranche": 2
	}
}
