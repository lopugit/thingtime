{
	"slug": "thingtime-profile-social-follower-row",
	"name": "Follower Row",
	"library": "thingtime",
	"category": "social",
	"description": "Follower list row in the Thingtime style — initials avatar wearing a presence dot, name with a mutuals caption, and a small tone-tinted follow chip on the right.",
	"tags": [
		"profile",
		"list",
		"follower",
		"presence",
		"social"
	],
	"args": [
		{
			"name": "initials",
			"type": "string",
			"default": "SM",
			"label": "Initials",
			"maxLength": 3
		},
		{
			"name": "name",
			"type": "string",
			"default": "Sam Mercer",
			"label": "Name",
			"maxLength": 40
		},
		{
			"name": "mutuals",
			"type": "string",
			"default": "12 mutual friends",
			"label": "Mutuals",
			"maxLength": 40
		},
		{
			"name": "presence",
			"type": "enum",
			"values": [
				"online",
				"away",
				"offline"
			],
			"default": "online",
			"label": "Presence"
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
