{
	"slug": "thingtime-marketing-hero",
	"name": "Hero Section",
	"library": "thingtime",
	"category": "marketing",
	"description": "Centered landing hero in the Thingtime style — display heading, supporting subtext, and a solid + outline button pair on Thingtime tone, radius, and type tokens.",
	"tags": [
		"marketing",
		"hero",
		"landing",
		"section"
	],
	"args": [
		{
			"name": "heading",
			"type": "string",
			"default": "Ship your ideas faster",
			"label": "Heading",
			"maxLength": 60
		},
		{
			"name": "subtext",
			"type": "text",
			"default": "Everything you need to design, build, and launch — in one calm workspace.",
			"label": "Subtext",
			"maxLength": 160
		},
		{
			"name": "primaryLabel",
			"type": "string",
			"default": "Get started",
			"label": "Primary button",
			"maxLength": 30
		},
		{
			"name": "secondaryLabel",
			"type": "string",
			"default": "View demo",
			"label": "Secondary button",
			"maxLength": 30
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "section",
		"props": {
			"style": {
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"background": "#ffffff",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "#f5f5f7",
				"borderRadius": "16px",
				"boxShadow": "0 4px 12px rgba(22, 22, 26, 0.06)",
				"padding": "44px 36px",
				"display": "flex",
				"flexDirection": "column",
				"alignItems": "center",
				"textAlign": "center",
				"gap": "12px",
				"maxWidth": "560px",
				"boxSizing": "border-box"
			}
		},
		"children": [
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "30px",
						"fontWeight": 700,
						"color": "#33333c",
						"lineHeight": 1.15,
						"letterSpacing": "-0.02em"
					}
				},
				"children": [
					"{heading}"
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "16px",
						"color": "#9a9aa6",
						"lineHeight": 1.55,
						"maxWidth": "420px"
					}
				},
				"children": [
					"{subtext}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "10px",
						"marginTop": "8px",
						"justifyContent": "center",
						"flexWrap": "wrap"
					}
				},
				"children": [
					{
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"display": "inline-flex",
								"alignItems": "center",
								"justifyContent": "center",
								"gap": "8px",
								"border": "none",
								"height": "36px",
								"padding": "0 18px",
								"borderRadius": "12px",
								"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
								"fontWeight": 600,
								"fontSize": "14px",
								"cursor": "pointer",
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#16161a",
											"success": "#2f9e63",
											"warning": "#d99a1f",
											"danger": "#d5484f",
											"info": "#d53f8c",
											"neutral": "#9a9aa6"
										},
										"default": "#16161a"
									}
								},
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#ffffff",
											"success": "#ffffff",
											"warning": "#ffffff",
											"danger": "#ffffff",
											"info": "#ffffff",
											"neutral": "#ffffff"
										},
										"default": "#ffffff"
									}
								},
								"boxShadow": "0 1px 2px rgba(22, 22, 26, 0.04)"
							}
						},
						"children": [
							"{primaryLabel}"
						]
					},
					{
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"display": "inline-flex",
								"alignItems": "center",
								"justifyContent": "center",
								"gap": "8px",
								"border": "none",
								"height": "36px",
								"padding": "0 18px",
								"borderRadius": "12px",
								"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
								"fontWeight": 600,
								"fontSize": "14px",
								"cursor": "pointer",
								"background": "transparent",
								"borderWidth": "1px",
								"borderStyle": "solid",
								"borderColor": "#ececef",
								"color": "#33333c"
							}
						},
						"children": [
							"{secondaryLabel}"
						]
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "marketing-hero",
	"source": {
		"kind": "archetype",
		"archetype": "marketing",
		"variant": "hero",
		"tranche": 1
	}
}
