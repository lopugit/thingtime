{
	"slug": "thingtime-list-two-line",
	"name": "Two-line List",
	"library": "thingtime",
	"category": "data-display",
	"description": "Two-line list rows in the Thingtime style — a weighted title over a muted subtitle, with optional trailing chevrons for navigation.",
	"tags": [
		"list",
		"two-line",
		"subtitle",
		"data"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Design review",
			"label": "Title",
			"maxLength": 40
		},
		{
			"name": "subtitle",
			"type": "string",
			"default": "Last updated",
			"label": "Subtitle",
			"maxLength": 60
		},
		{
			"name": "count",
			"type": "number",
			"default": 3,
			"label": "Rows",
			"min": 1,
			"max": 6
		},
		{
			"name": "chevrons",
			"type": "boolean",
			"default": true,
			"label": "Chevrons"
		}
	],
	"render": {
		"tag": "ul",
		"props": {
			"style": {
				"ttMerge": [
					{
						"listStyle": "none",
						"margin": 0,
						"padding": 0,
						"width": "280px",
						"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
						"color": "#33333c",
						"background": "#ffffff",
						"borderRadius": "12px",
						"overflow": "hidden"
					},
					{
						"border": "1px solid #ececef",
						"boxShadow": "0 1px 2px rgba(22, 22, 26, 0.04)"
					}
				]
			}
		},
		"children": [
			{
				"ttRepeat": {
					"arg": "count",
					"max": 6,
					"node": {
						"tag": "li",
						"props": {
							"style": {
								"ttMerge": [
									{
										"display": "flex",
										"alignItems": "center",
										"gap": "12px",
										"padding": "10px 14px",
										"fontSize": "14px"
									},
									{
										"ttIf": {
											"arg": "n",
											"equals": 1,
											"then": {},
											"else": {
												"borderTop": "1px solid #f5f5f7"
											}
										}
									}
								]
							}
						},
						"children": [
							{
								"tag": "div",
								"props": {
									"style": {
										"display": "flex",
										"flexDirection": "column",
										"gap": "2px",
										"flexGrow": 1,
										"minWidth": 0
									}
								},
								"children": [
									{
										"tag": "span",
										"props": {
											"style": {
												"fontWeight": 700,
												"fontSize": "14px"
											}
										},
										"children": [
											"{title}"
										]
									},
									{
										"tag": "span",
										"props": {
											"style": {
												"color": "#9a9aa6",
												"fontSize": "12px"
											}
										},
										"children": [
											"{subtitle} · {n}h ago"
										]
									}
								]
							},
							{
								"ttIf": {
									"arg": "chevrons",
									"then": {
										"tag": "svg",
										"props": {
											"width": 16,
											"height": 16,
											"viewBox": "0 0 24 24",
											"fill": "none",
											"stroke": "#b6b6c0",
											"strokeWidth": 2,
											"strokeLinecap": "round",
											"strokeLinejoin": "round",
											"xmlns": "http://www.w3.org/2000/svg"
										},
										"children": [
											{
												"tag": "polyline",
												"props": {
													"points": "9 6 15 12 9 18"
												}
											}
										]
									}
								}
							}
						]
					}
				}
			}
		]
	},
	"version": 1,
	"familyKey": "list-two-line",
	"source": {
		"kind": "archetype",
		"archetype": "list",
		"variant": "two-line",
		"tranche": 1
	}
}
