{
	"slug": "thingtime-stat-metric-comparison",
	"name": "Comparison Stat",
	"library": "thingtime",
	"category": "data-display",
	"description": "Two-value comparison card in the Thingtime style — current figure in the tone color beside the previous figure, split by a vertical divider with the house rainbow wink.",
	"tags": [
		"stat",
		"comparison",
		"versus",
		"card"
	],
	"args": [
		{
			"name": "leftLabel",
			"type": "string",
			"default": "This week",
			"label": "Left label",
			"maxLength": 24
		},
		{
			"name": "leftValue",
			"type": "string",
			"default": "1,284",
			"label": "Left value",
			"maxLength": 16
		},
		{
			"name": "rightLabel",
			"type": "string",
			"default": "Last week",
			"label": "Right label",
			"maxLength": 24
		},
		{
			"name": "rightValue",
			"type": "string",
			"default": "1,102",
			"label": "Right value",
			"maxLength": 16
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "inline-flex",
				"alignItems": "stretch",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"background": "#ffffff",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "#ececef",
				"borderRadius": "16px",
				"boxShadow": "0 1px 2px rgba(22, 22, 26, 0.04)",
				"boxSizing": "border-box",
				"padding": "16px 20px",
				"gap": "18px"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"gap": "4px",
						"flex": "1 1 0",
						"minWidth": "90px"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "11px",
								"fontWeight": 400,
								"color": "#9a9aa6"
							}
						},
						"children": [
							"{leftLabel}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "18px",
								"fontWeight": 700,
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#16161a",
											"success": "#2f9e63",
											"warning": "#d99a1f",
											"danger": "#d5484f",
											"info": "#d53f8c",
											"neutral": "#9a9aa6"
										},
										"default": "#16161a"
									}
								},
								"lineHeight": 1.15,
								"fontVariantNumeric": "tabular-nums"
							}
						},
						"children": [
							"{leftValue}"
						]
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"width": "2px",
						"alignSelf": "stretch",
						"borderRadius": "999px",
						"background": "linear-gradient(90deg, #ff5f6d, #ffc371, #ffe66d, #7cf47c, #6ad6ff, #a78bfa, #f472b6)",
						"flexShrink": 0
					}
				}
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"gap": "4px",
						"flex": "1 1 0",
						"minWidth": "90px"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "11px",
								"fontWeight": 400,
								"color": "#9a9aa6"
							}
						},
						"children": [
							"{rightLabel}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "18px",
								"fontWeight": 700,
								"color": "#33333c",
								"lineHeight": 1.15,
								"fontVariantNumeric": "tabular-nums"
							}
						},
						"children": [
							"{rightValue}"
						]
					}
				]
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "stat-metric",
		"variant": "comparison",
		"tranche": 1
	}
}
