{
	"slug": "thingtime-form-field-required",
	"name": "Required Field",
	"library": "thingtime",
	"category": "forms",
	"description": "Labeled input in the Thingtime style whose required toggle swaps a danger-tone asterisk for a muted \"(optional)\" hint, with fine print below.",
	"tags": [
		"form",
		"field",
		"required",
		"optional"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Email",
			"label": "Label",
			"maxLength": 40
		},
		{
			"name": "placeholder",
			"type": "string",
			"default": "you@example.com",
			"label": "Placeholder",
			"maxLength": 60
		},
		{
			"name": "required",
			"type": "boolean",
			"default": true,
			"label": "Required"
		},
		{
			"name": "hint",
			"type": "string",
			"default": "We only use this to sign you in.",
			"label": "Hint",
			"maxLength": 80
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"gap": "6px",
				"width": "280px"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "4px"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
								"fontSize": "12px",
								"fontWeight": 700,
								"color": "#33333c"
							}
						},
						"children": [
							"{label}"
						]
					},
					{
						"ttIf": {
							"arg": "required",
							"then": {
								"tag": "span",
								"props": {
									"style": {
										"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
										"fontSize": "12px",
										"fontWeight": 600,
										"color": "#d5484f"
									}
								},
								"children": [
									"*"
								]
							},
							"else": {
								"tag": "span",
								"props": {
									"style": {
										"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
										"fontSize": "11px",
										"color": "#b6b6c0"
									}
								},
								"children": [
									"(optional)"
								]
							}
						}
					}
				]
			},
			{
				"tag": "input",
				"props": {
					"type": "text",
					"placeholder": "{placeholder}",
					"style": {
						"ttMerge": [
							{
								"height": "36px",
								"padding": "0 12px",
								"borderRadius": "9px",
								"borderWidth": "1px",
								"borderStyle": "solid",
								"borderColor": "#ececef",
								"background": "#ffffff",
								"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
								"fontSize": "14px",
								"color": "#33333c",
								"outline": "none",
								"width": "100%",
								"boxSizing": "border-box",
								"boxShadow": "none"
							},
							{}
						]
					}
				}
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
						"fontSize": "11px",
						"color": "#9a9aa6"
					}
				},
				"children": [
					"{hint}"
				]
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "form-field",
		"variant": "required",
		"tranche": 1
	}
}
