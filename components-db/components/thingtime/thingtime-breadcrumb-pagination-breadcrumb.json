{
	"slug": "thingtime-breadcrumb-pagination-breadcrumb",
	"name": "Breadcrumb",
	"library": "thingtime",
	"category": "navigation",
	"description": "Three-level breadcrumb trail in the Thingtime style — muted ancestor crumbs, slash separators, and a tone-colored current page.",
	"tags": [
		"breadcrumb",
		"navigation",
		"trail",
		"path"
	],
	"args": [
		{
			"name": "root",
			"type": "string",
			"default": "Home",
			"label": "Root",
			"maxLength": 30
		},
		{
			"name": "section",
			"type": "string",
			"default": "Library",
			"label": "Section",
			"maxLength": 30
		},
		{
			"name": "page",
			"type": "string",
			"default": "Components",
			"label": "Current page",
			"maxLength": 30
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "nav",
		"props": {
			"style": {
				"display": "flex",
				"alignItems": "center",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"fontSize": "12px"
			}
		},
		"children": [
			{
				"tag": "span",
				"props": {
					"style": {
						"color": "#9a9aa6"
					}
				},
				"children": [
					"{root}"
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"color": "#b6b6c0",
						"padding": "0 8px",
						"fontSize": "12px"
					}
				},
				"children": [
					"/"
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"color": "#9a9aa6"
					}
				},
				"children": [
					"{section}"
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"color": "#b6b6c0",
						"padding": "0 8px",
						"fontSize": "12px"
					}
				},
				"children": [
					"/"
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#16161a",
									"success": "#2f9e63",
									"warning": "#d99a1f",
									"danger": "#d5484f",
									"info": "#d53f8c",
									"neutral": "#9a9aa6"
								},
								"default": "#16161a"
							}
						},
						"fontWeight": 700
					}
				},
				"children": [
					"{page}"
				]
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "breadcrumb-pagination",
		"variant": "breadcrumb",
		"tranche": 1
	}
}
