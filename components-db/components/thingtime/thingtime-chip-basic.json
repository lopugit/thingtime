{
	"slug": "thingtime-chip-basic",
	"name": "Basic Chip",
	"library": "thingtime",
	"category": "data-display",
	"description": "Plain tag chip in the Thingtime style — a soft tone wash by default with a filled toggle, on the library's native chip corners.",
	"tags": [
		"chip",
		"tag",
		"label"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Design",
			"label": "Label",
			"maxLength": 24
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "filled",
			"type": "boolean",
			"default": false,
			"label": "Filled"
		}
	],
	"render": {
		"tag": "span",
		"props": {
			"style": {
				"ttMerge": [
					{
						"display": "inline-flex",
						"alignItems": "center",
						"gap": "6px",
						"height": "28px",
						"padding": "0 12px",
						"borderRadius": "999px",
						"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
						"fontWeight": 500,
						"fontSize": "12px"
					},
					{
						"ttIf": {
							"arg": "filled",
							"then": {
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#16161a",
											"success": "#2f9e63",
											"warning": "#d99a1f",
											"danger": "#d5484f",
											"info": "#d53f8c",
											"neutral": "#9a9aa6"
										},
										"default": "#16161a"
									}
								},
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#ffffff",
											"success": "#ffffff",
											"warning": "#ffffff",
											"danger": "#ffffff",
											"info": "#ffffff",
											"neutral": "#ffffff"
										},
										"default": "#ffffff"
									}
								}
							},
							"else": {
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#f5f5f7",
											"success": "#eafaf1",
											"warning": "#fdf6e5",
											"danger": "#fdeceb",
											"info": "#fdeaf3",
											"neutral": "#f5f5f7"
										},
										"default": "#f5f5f7"
									}
								},
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#16161a",
											"success": "#1f7a4a",
											"warning": "#9a6c12",
											"danger": "#a83238",
											"info": "#a32d6a",
											"neutral": "#5a5a66"
										},
										"default": "#16161a"
									}
								}
							}
						}
					}
				]
			}
		},
		"children": [
			"{label}"
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "chip",
		"variant": "basic",
		"tranche": 1
	}
}
