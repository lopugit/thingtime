{
	"slug": "thingtime-avatar-initials",
	"name": "Initials Avatar",
	"library": "thingtime",
	"category": "data-display",
	"description": "Circular initials avatar in the Thingtime style — tone-filled disc with library type, optional soft tint and a surface-offset ring.",
	"tags": [
		"avatar",
		"initials",
		"profile"
	],
	"args": [
		{
			"name": "initials",
			"type": "string",
			"default": "NF",
			"label": "Initials",
			"maxLength": 3
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "size",
			"type": "enum",
			"values": [
				"sm",
				"md",
				"lg"
			],
			"default": "md",
			"label": "Size"
		},
		{
			"name": "soft",
			"type": "boolean",
			"default": false,
			"label": "Soft tint"
		},
		{
			"name": "ring",
			"type": "boolean",
			"default": false,
			"label": "Ring"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"ttMerge": [
					{
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "center",
						"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
						"fontWeight": 700,
						"borderRadius": "999px",
						"flexShrink": 0,
						"userSelect": "none"
					},
					{
						"ttMap": {
							"arg": "size",
							"values": {
								"sm": {
									"width": "28px",
									"height": "28px",
									"fontSize": "11px"
								},
								"md": {
									"width": "40px",
									"height": "40px",
									"fontSize": "12px"
								},
								"lg": {
									"width": "56px",
									"height": "56px",
									"fontSize": "16px"
								}
							},
							"default": {
								"width": "40px",
								"height": "40px",
								"fontSize": "12px"
							}
						}
					},
					{
						"ttIf": {
							"arg": "soft",
							"then": {
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#f5f5f7",
											"success": "#eafaf1",
											"warning": "#fdf6e5",
											"danger": "#fdeceb",
											"info": "#fdeaf3",
											"neutral": "#f5f5f7"
										},
										"default": "#f5f5f7"
									}
								},
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#16161a",
											"success": "#1f7a4a",
											"warning": "#9a6c12",
											"danger": "#a83238",
											"info": "#a32d6a",
											"neutral": "#5a5a66"
										},
										"default": "#16161a"
									}
								},
								"border": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "1px solid #ececef",
											"success": "1px solid #bfe9d2",
											"warning": "1px solid #f2ddaa",
											"danger": "1px solid #f4c1c3",
											"info": "1px solid #f6bed9",
											"neutral": "1px solid #ececef"
										},
										"default": "1px solid #ececef"
									}
								}
							},
							"else": {
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#16161a",
											"success": "#2f9e63",
											"warning": "#d99a1f",
											"danger": "#d5484f",
											"info": "#d53f8c",
											"neutral": "#9a9aa6"
										},
										"default": "#16161a"
									}
								},
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#ffffff",
											"success": "#ffffff",
											"warning": "#ffffff",
											"danger": "#ffffff",
											"info": "#ffffff",
											"neutral": "#ffffff"
										},
										"default": "#ffffff"
									}
								}
							}
						}
					},
					{
						"ttIf": {
							"arg": "ring",
							"then": {
								"boxShadow": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "0 0 0 2px #ffffff, 0 0 0 4px #ececef",
											"success": "0 0 0 2px #ffffff, 0 0 0 4px #bfe9d2",
											"warning": "0 0 0 2px #ffffff, 0 0 0 4px #f2ddaa",
											"danger": "0 0 0 2px #ffffff, 0 0 0 4px #f4c1c3",
											"info": "0 0 0 2px #ffffff, 0 0 0 4px #f6bed9",
											"neutral": "0 0 0 2px #ffffff, 0 0 0 4px #ececef"
										},
										"default": "0 0 0 2px #ffffff, 0 0 0 4px #ececef"
									}
								}
							},
							"else": {}
						}
					}
				]
			}
		},
		"children": [
			"{initials}"
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "avatar",
		"variant": "initials",
		"tranche": 1
	}
}
