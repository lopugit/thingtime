{
	"slug": "thingtime-profile-social-achievement",
	"name": "Achievement Tile",
	"library": "thingtime",
	"category": "social",
	"description": "Achievement badge tile in the Thingtime style — a star or zap emblem in a tone-soft circle with a tone border, title, and a progress bar with percent and 'x of y' captions.",
	"tags": [
		"profile",
		"achievement",
		"progress",
		"gamification",
		"social"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Streak Master",
			"label": "Title",
			"maxLength": 32
		},
		{
			"name": "icon",
			"type": "enum",
			"values": [
				"star",
				"zap"
			],
			"default": "star",
			"label": "Icon"
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "percent",
			"type": "number",
			"default": 60,
			"label": "Progress %",
			"min": 0,
			"max": 100
		},
		{
			"name": "done",
			"type": "number",
			"default": 3,
			"label": "Done",
			"min": 0
		},
		{
			"name": "total",
			"type": "number",
			"default": 5,
			"label": "Total",
			"min": 1
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"background": "#ffffff",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "#ececef",
				"borderRadius": "16px",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"boxShadow": "0 1px 2px rgba(22, 22, 26, 0.04)",
				"width": "216px",
				"display": "flex",
				"flexDirection": "column",
				"alignItems": "center",
				"textAlign": "center",
				"padding": "18px 16px",
				"boxSizing": "border-box"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"width": "48px",
						"height": "48px",
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "center",
						"borderRadius": "999px",
						"background": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#f5f5f7",
									"success": "#eafaf1",
									"warning": "#fdf6e5",
									"danger": "#fdeceb",
									"info": "#fdeaf3",
									"neutral": "#f5f5f7"
								},
								"default": "#f5f5f7"
							}
						},
						"borderWidth": "1px",
						"borderStyle": "solid",
						"borderColor": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#ececef",
									"success": "#bfe9d2",
									"warning": "#f2ddaa",
									"danger": "#f4c1c3",
									"info": "#f6bed9",
									"neutral": "#ececef"
								},
								"default": "#ececef"
							}
						},
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#16161a",
									"success": "#1f7a4a",
									"warning": "#9a6c12",
									"danger": "#a83238",
									"info": "#a32d6a",
									"neutral": "#5a5a66"
								},
								"default": "#16161a"
							}
						}
					}
				},
				"children": [
					{
						"ttIf": {
							"arg": "icon",
							"equals": "zap",
							"then": {
								"tag": "svg",
								"props": {
									"width": 22,
									"height": 22,
									"viewBox": "0 0 24 24",
									"fill": "none",
									"stroke": "currentColor",
									"strokeWidth": 2,
									"strokeLinecap": "round",
									"strokeLinejoin": "round",
									"xmlns": "http://www.w3.org/2000/svg"
								},
								"children": [
									{
										"tag": "polygon",
										"props": {
											"points": "13 2 3 14 12 14 11 22 21 10 12 10 13 2"
										}
									}
								]
							},
							"else": {
								"tag": "svg",
								"props": {
									"width": 22,
									"height": 22,
									"viewBox": "0 0 24 24",
									"fill": "none",
									"stroke": "currentColor",
									"strokeWidth": 2,
									"strokeLinejoin": "round",
									"xmlns": "http://www.w3.org/2000/svg"
								},
								"children": [
									{
										"tag": "polygon",
										"props": {
											"points": "12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26"
										}
									}
								]
							}
						}
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"marginTop": "10px",
						"fontSize": "14px",
						"fontWeight": 700,
						"color": "#33333c"
					}
				},
				"children": [
					"{title}"
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"marginTop": "12px",
						"width": "100%",
						"height": "6px",
						"borderRadius": "999px",
						"background": "#f5f5f7",
						"overflow": "hidden"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"width": "{percent}%",
								"height": "100%",
								"borderRadius": "999px",
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#16161a",
											"success": "#2f9e63",
											"warning": "#d99a1f",
											"danger": "#d5484f",
											"info": "#d53f8c",
											"neutral": "#9a9aa6"
										},
										"default": "#16161a"
									}
								}
							}
						}
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"marginTop": "8px",
						"width": "100%",
						"justifyContent": "space-between"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "11px",
								"color": "#9a9aa6"
							}
						},
						"children": [
							"{done} of {total}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "11px",
								"fontWeight": 600,
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#16161a",
											"success": "#1f7a4a",
											"warning": "#9a6c12",
											"danger": "#a83238",
											"info": "#a32d6a",
											"neutral": "#5a5a66"
										},
										"default": "#16161a"
									}
								}
							}
						},
						"children": [
							"{percent}%"
						]
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "profile-social-achievement",
	"source": {
		"kind": "archetype",
		"archetype": "profile-social",
		"variant": "achievement",
		"tranche": 2
	}
}
