{
	"slug": "thingtime-slider-progress-slider",
	"name": "Slider",
	"library": "thingtime",
	"category": "forms",
	"description": "Single-thumb slider in the Thingtime style — filled track up to the percent value, a surface thumb with a tone-colored border, optional value bubble.",
	"tags": [
		"slider",
		"input",
		"range",
		"percent"
	],
	"args": [
		{
			"name": "percent",
			"type": "number",
			"default": 40,
			"label": "Value",
			"min": 0,
			"max": 100
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "showValue",
			"type": "boolean",
			"default": true,
			"label": "Show value bubble"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"ttMerge": [
					{
						"width": "240px",
						"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
						"paddingBottom": "8px"
					},
					{
						"ttIf": {
							"arg": "showValue",
							"then": {
								"paddingTop": "36px"
							},
							"else": {
								"paddingTop": "8px"
							}
						}
					}
				]
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"position": "relative",
						"height": "6px",
						"background": "#f5f5f7",
						"borderRadius": "999px"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"width": "{percent}%",
								"height": "100%",
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "linear-gradient(90deg, #ff5f6d, #ffc371, #ffe66d, #7cf47c, #6ad6ff, #a78bfa, #f472b6)",
											"success": "#2f9e63",
											"warning": "#d99a1f",
											"danger": "#d5484f",
											"info": "#d53f8c",
											"neutral": "#9a9aa6"
										},
										"default": "linear-gradient(90deg, #ff5f6d, #ffc371, #ffe66d, #7cf47c, #6ad6ff, #a78bfa, #f472b6)"
									}
								},
								"borderRadius": "999px"
							}
						}
					},
					{
						"ttIf": {
							"arg": "showValue",
							"then": {
								"tag": "div",
								"props": {
									"style": {
										"position": "absolute",
										"left": "{percent}%",
										"top": "-32px",
										"transform": "translateX(-50%)",
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#16161a",
													"success": "#2f9e63",
													"warning": "#d99a1f",
													"danger": "#d5484f",
													"info": "#d53f8c",
													"neutral": "#9a9aa6"
												},
												"default": "#16161a"
											}
										},
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#ffffff",
													"success": "#ffffff",
													"warning": "#ffffff",
													"danger": "#ffffff",
													"info": "#ffffff",
													"neutral": "#ffffff"
												},
												"default": "#ffffff"
											}
										},
										"padding": "2px 8px",
										"borderRadius": "9px",
										"fontSize": "11px",
										"fontWeight": 700
									}
								},
								"children": [
									"{percent}"
								]
							}
						}
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"position": "absolute",
								"left": "{percent}%",
								"top": "50%",
								"transform": "translate(-50%, -50%)",
								"width": "16px",
								"height": "16px",
								"borderRadius": "999px",
								"background": "#ffffff",
								"borderWidth": "2px",
								"borderStyle": "solid",
								"borderColor": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#16161a",
											"success": "#2f9e63",
											"warning": "#d99a1f",
											"danger": "#d5484f",
											"info": "#d53f8c",
											"neutral": "#9a9aa6"
										},
										"default": "#16161a"
									}
								},
								"boxShadow": "0 1px 2px rgba(22, 22, 26, 0.04)"
							}
						}
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "slider-progress-slider",
	"source": {
		"kind": "archetype",
		"archetype": "slider-progress",
		"variant": "slider",
		"tranche": 1
	}
}
