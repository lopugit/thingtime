{
	"slug": "thingtime-timeline-changelog",
	"name": "Changelog Timeline",
	"library": "thingtime",
	"category": "data-display",
	"description": "Changelog timeline in the Thingtime style — mono version chips on a tone tint head each entry, with a date mark and a muted release summary.",
	"tags": [
		"timeline",
		"changelog",
		"releases",
		"versions"
	],
	"args": [
		{
			"name": "version",
			"type": "string",
			"default": "2.4",
			"label": "Version",
			"maxLength": 12
		},
		{
			"name": "summary",
			"type": "string",
			"default": "Performance improvements and bug fixes",
			"label": "Summary",
			"maxLength": 80
		},
		{
			"name": "count",
			"type": "number",
			"default": 3,
			"label": "Entries",
			"min": 1,
			"max": 5
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "ul",
		"props": {
			"style": {
				"listStyle": "none",
				"margin": 0,
				"padding": 0,
				"width": "280px",
				"display": "flex",
				"flexDirection": "column",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"color": "#33333c"
			}
		},
		"children": [
			{
				"ttRepeat": {
					"arg": "count",
					"max": 5,
					"node": {
						"tag": "li",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "stretch",
								"gap": "14px"
							}
						},
						"children": [
							{
								"tag": "div",
								"props": {
									"style": {
										"display": "flex",
										"flexDirection": "column",
										"alignItems": "center",
										"width": "12px",
										"flexShrink": 0
									}
								},
								"children": [
									{
										"tag": "div",
										"props": {
											"style": {
												"width": "12px",
												"height": "12px",
												"borderRadius": "999px",
												"background": "#b6b6c0",
												"marginTop": "5px",
												"flexShrink": 0
											}
										}
									},
									{
										"tag": "div",
										"props": {
											"style": {
												"width": "2px",
												"flexGrow": 1,
												"minHeight": "14px",
												"marginTop": "4px",
												"borderRadius": "999px",
												"background": "#f5f5f7"
											}
										}
									}
								]
							},
							{
								"tag": "div",
								"props": {
									"style": {
										"display": "flex",
										"flexDirection": "column",
										"gap": "2px",
										"paddingBottom": "18px",
										"minWidth": 0
									}
								},
								"children": [
									{
										"tag": "div",
										"props": {
											"style": {
												"display": "flex",
												"alignItems": "center",
												"gap": "8px"
											}
										},
										"children": [
											{
												"tag": "span",
												"props": {
													"style": {
														"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
														"fontSize": "11px",
														"fontWeight": 600,
														"padding": "2px 8px",
														"borderRadius": "999px",
														"background": {
															"ttMap": {
																"arg": "tone",
																"values": {
																	"primary": "#f5f5f7",
																	"success": "#eafaf1",
																	"warning": "#fdf6e5",
																	"danger": "#fdeceb",
																	"info": "#fdeaf3",
																	"neutral": "#f5f5f7"
																},
																"default": "#f5f5f7"
															}
														},
														"color": {
															"ttMap": {
																"arg": "tone",
																"values": {
																	"primary": "#16161a",
																	"success": "#1f7a4a",
																	"warning": "#9a6c12",
																	"danger": "#a83238",
																	"info": "#a32d6a",
																	"neutral": "#5a5a66"
																},
																"default": "#16161a"
															}
														},
														"borderWidth": "1px",
														"borderStyle": "solid",
														"borderColor": {
															"ttMap": {
																"arg": "tone",
																"values": {
																	"primary": "#ececef",
																	"success": "#bfe9d2",
																	"warning": "#f2ddaa",
																	"danger": "#f4c1c3",
																	"info": "#f6bed9",
																	"neutral": "#ececef"
																},
																"default": "#ececef"
															}
														}
													}
												},
												"children": [
													"v{version}.{n}"
												]
											},
											{
												"tag": "span",
												"props": {
													"style": {
														"color": "#b6b6c0",
														"fontSize": "11px"
													}
												},
												"children": [
													"Aug {n}"
												]
											}
										]
									},
									{
										"tag": "span",
										"props": {
											"style": {
												"color": "#9a9aa6",
												"fontSize": "12px",
												"marginTop": "2px"
											}
										},
										"children": [
											"{summary}"
										]
									}
								]
							}
						]
					}
				}
			}
		]
	},
	"version": 1,
	"familyKey": "timeline-changelog",
	"source": {
		"kind": "archetype",
		"archetype": "timeline",
		"variant": "changelog",
		"tranche": 1
	}
}
