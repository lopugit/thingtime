{
	"slug": "thingtime-flow-node",
	"name": "Flow Node",
	"library": "thingtime",
	"category": "flow",
	"description": "Graph node card in the Thingtime style — title, mono sublabel, tone status dot, and top/bottom connection handles with an accent ring when selected.",
	"tags": [
		"flow",
		"node",
		"graph",
		"handle"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Transform",
			"label": "Label",
			"maxLength": 30
		},
		{
			"name": "sublabel",
			"type": "string",
			"default": "normalize()",
			"label": "Sublabel",
			"maxLength": 30
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "success",
			"label": "Tone"
		},
		{
			"name": "selected",
			"type": "boolean",
			"default": false,
			"label": "Selected"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"padding": "10px 4px",
				"display": "inline-block"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"ttMerge": [
							{
								"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
								"background": "#ffffff",
								"borderWidth": "1px",
								"borderStyle": "solid",
								"borderColor": "#ececef",
								"borderRadius": "12px",
								"boxShadow": "0 1px 2px rgba(22, 22, 26, 0.04)",
								"boxSizing": "border-box",
								"position": "relative",
								"width": "180px",
								"padding": "10px 12px"
							},
							{
								"ttIf": {
									"arg": "selected",
									"then": {
										"borderColor": "#16161a",
										"boxShadow": "0 0 0 1px #16161a"
									},
									"else": {}
								}
							}
						]
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"position": "absolute",
								"width": "10px",
								"height": "10px",
								"borderRadius": "999px",
								"background": "#16161a",
								"borderWidth": "2px",
								"borderStyle": "solid",
								"borderColor": "#ffffff",
								"boxSizing": "border-box",
								"top": "-6px",
								"left": "50%",
								"marginLeft": "-5px"
							}
						}
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"alignItems": "center",
								"gap": "8px"
							}
						},
						"children": [
							{
								"tag": "span",
								"props": {
									"style": {
										"width": "8px",
										"height": "8px",
										"borderRadius": "999px",
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#16161a",
													"success": "#2f9e63",
													"warning": "#d99a1f",
													"danger": "#d5484f",
													"info": "#d53f8c",
													"neutral": "#9a9aa6"
												},
												"default": "#2f9e63"
											}
										},
										"flexShrink": 0
									}
								}
							},
							{
								"tag": "div",
								"props": {
									"style": {
										"display": "flex",
										"flexDirection": "column",
										"gap": "2px",
										"minWidth": "0"
									}
								},
								"children": [
									{
										"tag": "span",
										"props": {
											"style": {
												"fontSize": "12px",
												"fontWeight": 700,
												"color": "#33333c"
											}
										},
										"children": [
											"{label}"
										]
									},
									{
										"tag": "span",
										"props": {
											"style": {
												"fontSize": "11px",
												"color": "#9a9aa6",
												"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
											}
										},
										"children": [
											"{sublabel}"
										]
									}
								]
							}
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"position": "absolute",
								"width": "10px",
								"height": "10px",
								"borderRadius": "999px",
								"background": "#16161a",
								"borderWidth": "2px",
								"borderStyle": "solid",
								"borderColor": "#ffffff",
								"boxSizing": "border-box",
								"bottom": "-6px",
								"left": "50%",
								"marginLeft": "-5px"
							}
						}
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "flow-node",
	"source": {
		"kind": "archetype",
		"archetype": "flow",
		"variant": "node",
		"tranche": 1
	}
}
