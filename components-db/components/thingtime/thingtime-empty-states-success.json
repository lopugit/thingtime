{
	"slug": "thingtime-empty-states-success",
	"name": "Success State",
	"library": "thingtime",
	"category": "feedback",
	"description": "Success / complete panel in the Thingtime style — check circle in a soft tone bubble, congratulatory title and message, and an optional continue button.",
	"tags": [
		"success",
		"complete",
		"empty-state",
		"feedback"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "You’re all set",
			"label": "Title",
			"maxLength": 50
		},
		{
			"name": "message",
			"type": "text",
			"default": "Your workspace is ready. Invite your team or jump straight in.",
			"label": "Message"
		},
		{
			"name": "ctaLabel",
			"type": "string",
			"default": "Go to dashboard",
			"label": "CTA label",
			"maxLength": 32
		},
		{
			"name": "showCta",
			"type": "boolean",
			"default": true,
			"label": "Show CTA"
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"success",
				"primary",
				"info"
			],
			"default": "success",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"alignItems": "center",
				"justifyContent": "center",
				"textAlign": "center",
				"gap": "6px",
				"width": "340px",
				"padding": "36px 24px",
				"background": "#ffffff",
				"borderRadius": "16px",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"color": "#33333c",
				"border": "1px solid #ececef",
				"boxShadow": "0 4px 12px rgba(22, 22, 26, 0.06)"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"width": "46px",
						"height": "46px",
						"borderRadius": "999px",
						"background": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#f5f5f7",
									"success": "#eafaf1",
									"warning": "#fdf6e5",
									"danger": "#fdeceb",
									"info": "#fdeaf3",
									"neutral": "#f5f5f7"
								},
								"default": "#f5f5f7"
							}
						},
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#16161a",
									"success": "#2f9e63",
									"warning": "#d99a1f",
									"danger": "#d5484f",
									"info": "#d53f8c",
									"neutral": "#9a9aa6"
								},
								"default": "#16161a"
							}
						},
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "center",
						"marginBottom": "4px"
					}
				},
				"children": [
					{
						"tag": "svg",
						"props": {
							"width": 22,
							"height": 22,
							"viewBox": "0 0 24 24",
							"fill": "none",
							"stroke": "currentColor",
							"strokeWidth": 2,
							"strokeLinecap": "round",
							"strokeLinejoin": "round",
							"xmlns": "http://www.w3.org/2000/svg"
						},
						"children": [
							{
								"tag": "polyline",
								"props": {
									"points": "20 6 9 17 4 12"
								}
							}
						]
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontWeight": 700,
						"fontSize": "16px"
					}
				},
				"children": [
					"{title}"
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "12px",
						"color": "#9a9aa6",
						"lineHeight": 1.5,
						"maxWidth": "250px"
					}
				},
				"children": [
					"{message}"
				]
			},
			{
				"ttIf": {
					"arg": "showCta",
					"then": {
						"tag": "button",
						"props": {
							"type": "button",
							"style": {
								"display": "inline-flex",
								"alignItems": "center",
								"justifyContent": "center",
								"height": "36px",
								"padding": "0 18px",
								"border": "none",
								"borderRadius": "9px",
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#16161a",
											"success": "#2f9e63",
											"warning": "#d99a1f",
											"danger": "#d5484f",
											"info": "#d53f8c",
											"neutral": "#9a9aa6"
										},
										"default": "#16161a"
									}
								},
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#ffffff",
											"success": "#ffffff",
											"warning": "#ffffff",
											"danger": "#ffffff",
											"info": "#ffffff",
											"neutral": "#ffffff"
										},
										"default": "#ffffff"
									}
								},
								"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
								"fontSize": "12px",
								"fontWeight": 600,
								"boxShadow": "0 1px 2px rgba(22, 22, 26, 0.04)",
								"cursor": "pointer",
								"marginTop": "10px"
							}
						},
						"children": [
							"{ctaLabel}"
						]
					}
				}
			}
		]
	},
	"previewBg": "#fafafb",
	"version": 1,
	"familyKey": "empty-states-success",
	"source": {
		"kind": "archetype",
		"archetype": "empty-states",
		"variant": "success",
		"tranche": 1
	}
}
