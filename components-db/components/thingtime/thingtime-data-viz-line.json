{
	"slug": "thingtime-data-viz-line",
	"name": "Line Chart",
	"library": "thingtime",
	"category": "data-display",
	"description": "Mini line chart in the Thingtime style — a tone-colored svg trend polyline with an optional translucent area fill, end-point dot, and min/max captions under the plot.",
	"tags": [
		"chart",
		"line",
		"trend",
		"area"
	],
	"args": [
		{
			"name": "title",
			"type": "string",
			"default": "Active users",
			"label": "Title",
			"maxLength": 32
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "area",
			"type": "boolean",
			"default": true,
			"label": "Area fill"
		},
		{
			"name": "min",
			"type": "string",
			"default": "Low 14",
			"label": "Min caption",
			"maxLength": 16
		},
		{
			"name": "max",
			"type": "string",
			"default": "High 86",
			"label": "Max caption",
			"maxLength": 16
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"width": "232px",
				"boxSizing": "border-box",
				"padding": "14px 16px",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"background": "#ffffff",
				"border": "1px solid #ececef",
				"borderRadius": "12px",
				"boxShadow": "0 1px 2px rgba(22, 22, 26, 0.04)"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"marginBottom": "10px"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "12px",
								"fontWeight": 700,
								"color": "#33333c"
							}
						},
						"children": [
							"{title}"
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"height": "3px",
								"width": "32px",
								"marginTop": "4px",
								"borderRadius": "999px",
								"background": "linear-gradient(90deg, #ff5f6d, #ffc371, #ffe66d, #7cf47c, #6ad6ff, #a78bfa, #f472b6)"
							}
						}
					}
				]
			},
			{
				"tag": "svg",
				"props": {
					"width": 200,
					"height": 80,
					"viewBox": "0 0 160 64",
					"xmlns": "http://www.w3.org/2000/svg"
				},
				"children": [
					{
						"ttIf": {
							"arg": "area",
							"then": {
								"tag": "polygon",
								"props": {
									"points": "4,48 28,36 52,42 76,26 100,32 124,14 152,20 152,60 4,60",
									"fill": {
										"ttMap": {
											"arg": "tone",
											"values": {
												"primary": "rgba(22, 22, 26, 0.18)",
												"success": "rgba(47, 158, 99, 0.18)",
												"warning": "rgba(217, 154, 31, 0.18)",
												"danger": "rgba(213, 72, 79, 0.18)",
												"info": "rgba(213, 63, 140, 0.18)",
												"neutral": "rgba(154, 154, 166, 0.18)"
											},
											"default": "rgba(22, 22, 26, 0.18)"
										}
									}
								}
							}
						}
					},
					{
						"tag": "line",
						"props": {
							"x1": 4,
							"y1": 60,
							"x2": 156,
							"y2": 60,
							"stroke": "#f5f5f7",
							"strokeWidth": 1
						}
					},
					{
						"tag": "polyline",
						"props": {
							"points": "4,48 28,36 52,42 76,26 100,32 124,14 152,20",
							"fill": "none",
							"stroke": {
								"ttMap": {
									"arg": "tone",
									"values": {
										"primary": "#16161a",
										"success": "#2f9e63",
										"warning": "#d99a1f",
										"danger": "#d5484f",
										"info": "#d53f8c",
										"neutral": "#9a9aa6"
									},
									"default": "#16161a"
								}
							},
							"strokeWidth": 2.5,
							"strokeLinecap": "round",
							"strokeLinejoin": "round"
						}
					},
					{
						"tag": "circle",
						"props": {
							"cx": 152,
							"cy": 20,
							"r": 3.5,
							"fill": {
								"ttMap": {
									"arg": "tone",
									"values": {
										"primary": "#16161a",
										"success": "#2f9e63",
										"warning": "#d99a1f",
										"danger": "#d5484f",
										"info": "#d53f8c",
										"neutral": "#9a9aa6"
									},
									"default": "#16161a"
								}
							},
							"stroke": "#ffffff",
							"strokeWidth": 1.5
						}
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"justifyContent": "space-between",
						"marginTop": "4px",
						"fontSize": "11px",
						"color": "#9a9aa6"
					}
				},
				"children": [
					{
						"tag": "span",
						"children": [
							"{min}"
						]
					},
					{
						"tag": "span",
						"children": [
							"{max}"
						]
					}
				]
			}
		]
	},
	"version": 1,
	"familyKey": "data-viz-line",
	"source": {
		"kind": "archetype",
		"archetype": "data-viz",
		"variant": "line",
		"tranche": 2
	}
}
