{
	"slug": "thingtime-marketing-cta",
	"name": "CTA Band",
	"library": "thingtime",
	"category": "marketing",
	"description": "Call-to-action band in the Thingtime style — gradient or solid tone background with heading, subtext, and an inverted surface button; gradient mode uses the house rainbow.",
	"tags": [
		"marketing",
		"cta",
		"banner",
		"conversion"
	],
	"args": [
		{
			"name": "heading",
			"type": "string",
			"default": "Ready to dive in?",
			"label": "Heading",
			"maxLength": 60
		},
		{
			"name": "subtext",
			"type": "text",
			"default": "Free 14-day trial — no credit card required.",
			"label": "Subtext",
			"maxLength": 120
		},
		{
			"name": "buttonLabel",
			"type": "string",
			"default": "Create your account",
			"label": "Button label",
			"maxLength": 30
		},
		{
			"name": "gradient",
			"type": "boolean",
			"default": true,
			"label": "Gradient"
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"alignItems": "center",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"padding": "24px 28px",
				"borderRadius": "16px",
				"background": {
					"ttIf": {
						"arg": "gradient",
						"then": "linear-gradient(90deg, #ff5f6d, #ffc371, #ffe66d, #7cf47c, #6ad6ff, #a78bfa, #f472b6)",
						"else": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#16161a",
									"success": "#2f9e63",
									"warning": "#d99a1f",
									"danger": "#d5484f",
									"info": "#d53f8c",
									"neutral": "#9a9aa6"
								},
								"default": "#16161a"
							}
						}
					}
				},
				"color": {
					"ttIf": {
						"arg": "gradient",
						"then": "#16161a",
						"else": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#ffffff",
									"success": "#ffffff",
									"warning": "#ffffff",
									"danger": "#ffffff",
									"info": "#ffffff",
									"neutral": "#ffffff"
								},
								"default": "#ffffff"
							}
						}
					}
				},
				"gap": "18px",
				"justifyContent": "space-between",
				"flexWrap": "wrap",
				"maxWidth": "560px",
				"boxShadow": "0 4px 12px rgba(22, 22, 26, 0.06)",
				"boxSizing": "border-box"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"flexDirection": "column",
						"gap": "4px",
						"flex": "1 1 220px",
						"minWidth": "200px"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "18px",
								"fontWeight": 700
							}
						},
						"children": [
							"{heading}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "12px",
								"opacity": 0.85
							}
						},
						"children": [
							"{subtext}"
						]
					}
				]
			},
			{
				"tag": "button",
				"props": {
					"type": "button",
					"style": {
						"display": "inline-flex",
						"alignItems": "center",
						"justifyContent": "center",
						"gap": "8px",
						"border": "none",
						"height": "36px",
						"padding": "0 18px",
						"borderRadius": "12px",
						"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
						"fontWeight": 600,
						"fontSize": "14px",
						"cursor": "pointer",
						"background": "#ffffff",
						"color": "#33333c",
						"boxShadow": "0 1px 2px rgba(22, 22, 26, 0.04)",
						"flexShrink": 0
					}
				},
				"children": [
					"{buttonLabel}"
				]
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "marketing",
		"variant": "cta",
		"tranche": 1
	}
}
