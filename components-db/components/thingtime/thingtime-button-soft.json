{
	"slug": "thingtime-button-soft",
	"name": "Soft Button",
	"library": "thingtime",
	"category": "buttons",
	"description": "Tinted button in the Thingtime style — soft tone wash background with the deeper tone for the label.",
	"tags": [
		"button",
		"action",
		"soft",
		"tinted"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Preview",
			"label": "Label",
			"maxLength": 40
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "size",
			"type": "enum",
			"values": [
				"sm",
				"md",
				"lg"
			],
			"default": "md",
			"label": "Size"
		},
		{
			"name": "disabled",
			"type": "boolean",
			"default": false,
			"label": "Disabled"
		}
	],
	"render": {
		"tag": "button",
		"props": {
			"type": "button",
			"style": {
				"ttMerge": [
					{
						"display": "inline-flex",
						"alignItems": "center",
						"justifyContent": "center",
						"gap": "8px",
						"border": "none",
						"borderRadius": "12px",
						"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
						"fontWeight": 600,
						"cursor": "pointer"
					},
					{
						"ttMap": {
							"arg": "size",
							"values": {
								"sm": {
									"height": "28px",
									"padding": "0 12px",
									"fontSize": "12px"
								},
								"md": {
									"height": "36px",
									"padding": "0 16px",
									"fontSize": "14px"
								},
								"lg": {
									"height": "44px",
									"padding": "0 20px",
									"fontSize": "16px"
								}
							},
							"default": {
								"height": "36px",
								"padding": "0 16px",
								"fontSize": "14px"
							}
						}
					},
					{
						"background": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#f5f5f7",
									"success": "#eafaf1",
									"warning": "#fdf6e5",
									"danger": "#fdeceb",
									"info": "#fdeaf3",
									"neutral": "#f5f5f7"
								},
								"default": "#f5f5f7"
							}
						},
						"color": {
							"ttMap": {
								"arg": "tone",
								"values": {
									"primary": "#16161a",
									"success": "#1f7a4a",
									"warning": "#9a6c12",
									"danger": "#a83238",
									"info": "#a32d6a",
									"neutral": "#5a5a66"
								},
								"default": "#16161a"
							}
						}
					},
					{
						"ttIf": {
							"arg": "disabled",
							"then": {
								"opacity": 0.5,
								"cursor": "not-allowed"
							},
							"else": {}
						}
					}
				]
			}
		},
		"children": [
			"{label}"
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "button",
		"variant": "soft",
		"tranche": 1
	}
}
