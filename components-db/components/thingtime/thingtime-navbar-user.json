{
	"slug": "thingtime-navbar-user",
	"name": "Account Navbar",
	"library": "thingtime",
	"category": "navigation",
	"description": "Account navigation bar in the Thingtime style — brand on the left and an avatar with name, role, and a disclosure chevron on the right.",
	"tags": [
		"navbar",
		"account",
		"avatar",
		"header"
	],
	"args": [
		{
			"name": "brand",
			"type": "string",
			"default": "Acme",
			"label": "Brand",
			"maxLength": 24
		},
		{
			"name": "name",
			"type": "string",
			"default": "Jamie Chen",
			"label": "Name",
			"maxLength": 30
		},
		{
			"name": "initials",
			"type": "string",
			"default": "JC",
			"label": "Initials",
			"maxLength": 3
		},
		{
			"name": "role",
			"type": "string",
			"default": "Product lead",
			"label": "Role",
			"maxLength": 30
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "nav",
		"props": {
			"style": {
				"display": "flex",
				"alignItems": "center",
				"justifyContent": "space-between",
				"gap": "24px",
				"width": "100%",
				"boxSizing": "border-box",
				"height": "56px",
				"padding": "0 18px",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"background": "#ffffff",
				"borderBottom": "1px solid #ececef",
				"boxShadow": "0 1px 2px rgba(22, 22, 26, 0.04)"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "9px"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"width": "26px",
								"height": "26px",
								"borderRadius": "9px",
								"display": "flex",
								"alignItems": "center",
								"justifyContent": "center",
								"flexShrink": 0,
								"background": "linear-gradient(90deg, #ff5f6d, #ffc371, #ffe66d, #7cf47c, #6ad6ff, #a78bfa, #f472b6)",
								"color": "#ffffff"
							}
						},
						"children": [
							{
								"tag": "svg",
								"props": {
									"width": 14,
									"height": 14,
									"viewBox": "0 0 24 24",
									"fill": "none",
									"stroke": "currentColor",
									"strokeWidth": 2,
									"strokeLinecap": "round",
									"strokeLinejoin": "round",
									"xmlns": "http://www.w3.org/2000/svg"
								},
								"children": [
									{
										"tag": "polygon",
										"props": {
											"points": "13 2 3 14 12 14 11 22 21 10 12 10 13 2"
										}
									}
								]
							}
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
								"fontWeight": 700,
								"fontSize": "16px",
								"color": "#33333c"
							}
						},
						"children": [
							"{brand}"
						]
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"gap": "10px"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"width": 30,
								"height": 30,
								"borderRadius": "999px",
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#16161a",
											"success": "#2f9e63",
											"warning": "#d99a1f",
											"danger": "#d5484f",
											"info": "#d53f8c",
											"neutral": "#9a9aa6"
										},
										"default": "#16161a"
									}
								},
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#ffffff",
											"success": "#ffffff",
											"warning": "#ffffff",
											"danger": "#ffffff",
											"info": "#ffffff",
											"neutral": "#ffffff"
										},
										"default": "#ffffff"
									}
								},
								"display": "flex",
								"alignItems": "center",
								"justifyContent": "center",
								"fontWeight": 600,
								"fontSize": "11px",
								"flexShrink": 0
							}
						},
						"children": [
							"{initials}"
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"flexDirection": "column",
								"gap": "1px"
							}
						},
						"children": [
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "12px",
										"fontWeight": 600,
										"color": "#33333c"
									}
								},
								"children": [
									"{name}"
								]
							},
							{
								"tag": "span",
								"props": {
									"style": {
										"fontSize": "11px",
										"color": "#9a9aa6"
									}
								},
								"children": [
									"{role}"
								]
							}
						]
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"display": "flex",
								"color": "#9a9aa6"
							}
						},
						"children": [
							{
								"tag": "svg",
								"props": {
									"width": 18,
									"height": 18,
									"viewBox": "0 0 24 24",
									"fill": "none",
									"stroke": "currentColor",
									"strokeWidth": 2,
									"strokeLinecap": "round",
									"strokeLinejoin": "round",
									"xmlns": "http://www.w3.org/2000/svg"
								},
								"children": [
									{
										"tag": "polyline",
										"props": {
											"points": "6 9 12 15 18 9"
										}
									}
								]
							}
						]
					}
				]
			}
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "navbar",
		"variant": "user",
		"tranche": 1
	}
}
