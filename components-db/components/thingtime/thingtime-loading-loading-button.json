{
	"slug": "thingtime-loading-loading-button",
	"name": "Loading Button",
	"library": "thingtime",
	"category": "feedback",
	"description": "Busy-state button in the Thingtime style — an inline arc spinner beside the label, in solid or quiet tinted form.",
	"tags": [
		"loading",
		"button",
		"spinner",
		"busy"
	],
	"args": [
		{
			"name": "label",
			"type": "string",
			"default": "Saving…",
			"label": "Label",
			"maxLength": 40
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "size",
			"type": "enum",
			"values": [
				"sm",
				"md",
				"lg"
			],
			"default": "md",
			"label": "Size"
		},
		{
			"name": "quiet",
			"type": "boolean",
			"default": false,
			"label": "Quiet (tinted)"
		}
	],
	"render": {
		"tag": "button",
		"props": {
			"type": "button",
			"style": {
				"ttMerge": [
					{
						"display": "inline-flex",
						"alignItems": "center",
						"justifyContent": "center",
						"gap": "8px",
						"border": "none",
						"borderRadius": "12px",
						"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
						"fontWeight": 600,
						"cursor": "wait",
						"opacity": 0.9
					},
					{
						"ttMap": {
							"arg": "size",
							"values": {
								"sm": {
									"height": "28px",
									"padding": "0 12px",
									"fontSize": "12px"
								},
								"md": {
									"height": "36px",
									"padding": "0 16px",
									"fontSize": "14px"
								},
								"lg": {
									"height": "44px",
									"padding": "0 20px",
									"fontSize": "16px"
								}
							},
							"default": {
								"height": "36px",
								"padding": "0 16px",
								"fontSize": "14px"
							}
						}
					},
					{
						"background": {
							"ttIf": {
								"arg": "quiet",
								"then": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#f5f5f7",
											"success": "#eafaf1",
											"warning": "#fdf6e5",
											"danger": "#fdeceb",
											"info": "#fdeaf3",
											"neutral": "#f5f5f7"
										},
										"default": "#f5f5f7"
									}
								},
								"else": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#16161a",
											"success": "#2f9e63",
											"warning": "#d99a1f",
											"danger": "#d5484f",
											"info": "#d53f8c",
											"neutral": "#9a9aa6"
										},
										"default": "#16161a"
									}
								}
							}
						},
						"color": {
							"ttIf": {
								"arg": "quiet",
								"then": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#16161a",
											"success": "#1f7a4a",
											"warning": "#9a6c12",
											"danger": "#a83238",
											"info": "#a32d6a",
											"neutral": "#5a5a66"
										},
										"default": "#16161a"
									}
								},
								"else": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#ffffff",
											"success": "#ffffff",
											"warning": "#ffffff",
											"danger": "#ffffff",
											"info": "#ffffff",
											"neutral": "#ffffff"
										},
										"default": "#ffffff"
									}
								}
							}
						},
						"boxShadow": "0 1px 2px rgba(22, 22, 26, 0.04)"
					}
				]
			}
		},
		"children": [
			{
				"tag": "svg",
				"props": {
					"width": 16,
					"height": 16,
					"viewBox": "0 0 24 24",
					"fill": "none",
					"xmlns": "http://www.w3.org/2000/svg"
				},
				"children": [
					{
						"tag": "circle",
						"props": {
							"cx": 12,
							"cy": 12,
							"r": 10,
							"stroke": "currentColor",
							"strokeWidth": 3,
							"style": {
								"opacity": 0.3
							}
						}
					},
					{
						"tag": "path",
						"props": {
							"d": "M12 2a10 10 0 1 1-10 10",
							"stroke": "currentColor",
							"strokeWidth": 3,
							"strokeLinecap": "round"
						}
					}
				]
			},
			"{label}"
		]
	},
	"version": 1,
	"source": {
		"kind": "archetype",
		"archetype": "loading",
		"variant": "loading-button",
		"tranche": 1
	}
}
