{
	"slug": "thingtime-gamification-xp",
	"name": "XP Progress",
	"library": "thingtime",
	"category": "engagement",
	"description": "XP progress card in the Thingtime style — a Level chip, a tone-colored bar washed in the house rainbow with a marker dot riding the fill edge, and an XP-to-next-level caption.",
	"tags": [
		"gamification",
		"xp",
		"progress",
		"level"
	],
	"args": [
		{
			"name": "level",
			"type": "number",
			"default": 7,
			"label": "Level",
			"min": 1
		},
		{
			"name": "percent",
			"type": "number",
			"default": 68,
			"label": "Progress (0–100)",
			"min": 0,
			"max": 100
		},
		{
			"name": "xp",
			"type": "string",
			"default": "1,250",
			"label": "XP remaining",
			"maxLength": 10
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		}
	],
	"render": {
		"tag": "div",
		"props": {
			"style": {
				"display": "flex",
				"flexDirection": "column",
				"width": "260px",
				"padding": "16px",
				"boxSizing": "border-box",
				"background": "#ffffff",
				"borderWidth": "1px",
				"borderStyle": "solid",
				"borderColor": "#ececef",
				"borderRadius": "16px",
				"boxShadow": "0 1px 2px rgba(22, 22, 26, 0.04)",
				"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
				"gap": "12px"
			}
		},
		"children": [
			{
				"tag": "div",
				"props": {
					"style": {
						"display": "flex",
						"alignItems": "center",
						"justifyContent": "space-between",
						"gap": "12px"
					}
				},
				"children": [
					{
						"tag": "span",
						"props": {
							"style": {
								"display": "inline-flex",
								"alignItems": "center",
								"padding": "2px 10px",
								"borderRadius": "999px",
								"background": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#f5f5f7",
											"success": "#eafaf1",
											"warning": "#fdf6e5",
											"danger": "#fdeceb",
											"info": "#fdeaf3",
											"neutral": "#f5f5f7"
										},
										"default": "#f5f5f7"
									}
								},
								"color": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#16161a",
											"success": "#1f7a4a",
											"warning": "#9a6c12",
											"danger": "#a83238",
											"info": "#a32d6a",
											"neutral": "#5a5a66"
										},
										"default": "#16161a"
									}
								},
								"fontSize": "11px",
								"fontWeight": 700
							}
						},
						"children": [
							"Level {level}"
						]
					},
					{
						"tag": "span",
						"props": {
							"style": {
								"fontSize": "12px",
								"fontWeight": 600,
								"color": "#9a9aa6",
								"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
							}
						},
						"children": [
							"{percent}%"
						]
					}
				]
			},
			{
				"tag": "div",
				"props": {
					"style": {
						"position": "relative",
						"height": "10px",
						"borderRadius": "999px",
						"background": "#f5f5f7"
					}
				},
				"children": [
					{
						"tag": "div",
						"props": {
							"style": {
								"width": "{percent}%",
								"maxWidth": "100%",
								"height": "100%",
								"borderRadius": "999px",
								"background": "linear-gradient(90deg, #ff5f6d, #ffc371, #ffe66d, #7cf47c, #6ad6ff, #a78bfa, #f472b6)"
							}
						}
					},
					{
						"tag": "div",
						"props": {
							"style": {
								"position": "absolute",
								"top": "-3px",
								"left": "calc({percent}% - 8px)",
								"width": "16px",
								"height": "16px",
								"boxSizing": "border-box",
								"borderRadius": "999px",
								"background": "#ffffff",
								"borderWidth": "2px",
								"borderStyle": "solid",
								"borderColor": {
									"ttMap": {
										"arg": "tone",
										"values": {
											"primary": "#16161a",
											"success": "#2f9e63",
											"warning": "#d99a1f",
											"danger": "#d5484f",
											"info": "#d53f8c",
											"neutral": "#9a9aa6"
										},
										"default": "#16161a"
									}
								},
								"boxShadow": "0 1px 2px rgba(22, 22, 26, 0.04)"
							}
						}
					}
				]
			},
			{
				"tag": "span",
				"props": {
					"style": {
						"fontSize": "11px",
						"color": "#9a9aa6"
					}
				},
				"children": [
					"{xp} XP to next level"
				]
			}
		]
	},
	"version": 1,
	"familyKey": "gamification-xp",
	"source": {
		"kind": "archetype",
		"archetype": "gamification",
		"variant": "xp",
		"tranche": 2
	}
}
