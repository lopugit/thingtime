{
	"slug": "thingtime-list-numbered",
	"name": "Numbered List",
	"library": "thingtime",
	"category": "data-display",
	"description": "Ordered list in the Thingtime style — hand-styled number markers (pill chips) on a tone tint beside each row.",
	"tags": [
		"list",
		"numbered",
		"ordered",
		"steps"
	],
	"args": [
		{
			"name": "item",
			"type": "string",
			"default": "Step",
			"label": "Item label",
			"maxLength": 40
		},
		{
			"name": "count",
			"type": "number",
			"default": 4,
			"label": "Rows",
			"min": 1,
			"max": 8
		},
		{
			"name": "tone",
			"type": "enum",
			"values": [
				"primary",
				"success",
				"warning",
				"danger",
				"info",
				"neutral"
			],
			"default": "primary",
			"label": "Tone"
		},
		{
			"name": "divided",
			"type": "boolean",
			"default": true,
			"label": "Dividers"
		}
	],
	"render": {
		"tag": "ol",
		"props": {
			"style": {
				"ttMerge": [
					{
						"listStyle": "none",
						"margin": 0,
						"padding": 0,
						"width": "280px",
						"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
						"color": "#33333c",
						"background": "#ffffff",
						"borderRadius": "12px",
						"overflow": "hidden"
					},
					{
						"border": "1px solid #ececef",
						"boxShadow": "0 1px 2px rgba(22, 22, 26, 0.04)"
					}
				]
			}
		},
		"children": [
			{
				"ttRepeat": {
					"arg": "count",
					"max": 8,
					"node": {
						"tag": "li",
						"props": {
							"style": {
								"ttMerge": [
									{
										"display": "flex",
										"alignItems": "center",
										"gap": "12px",
										"padding": "10px 14px",
										"fontSize": "14px"
									},
									{
										"ttIf": {
											"arg": "divided",
											"then": {
												"ttIf": {
													"arg": "n",
													"equals": 1,
													"then": {},
													"else": {
														"borderTop": "1px solid #f5f5f7"
													}
												}
											},
											"else": {}
										}
									}
								]
							}
						},
						"children": [
							{
								"tag": "div",
								"props": {
									"style": {
										"width": "24px",
										"height": "24px",
										"borderRadius": "999px",
										"background": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#f5f5f7",
													"success": "#eafaf1",
													"warning": "#fdf6e5",
													"danger": "#fdeceb",
													"info": "#fdeaf3",
													"neutral": "#f5f5f7"
												},
												"default": "#f5f5f7"
											}
										},
										"color": {
											"ttMap": {
												"arg": "tone",
												"values": {
													"primary": "#16161a",
													"success": "#1f7a4a",
													"warning": "#9a6c12",
													"danger": "#a83238",
													"info": "#a32d6a",
													"neutral": "#5a5a66"
												},
												"default": "#16161a"
											}
										},
										"display": "flex",
										"alignItems": "center",
										"justifyContent": "center",
										"fontSize": "11px",
										"fontWeight": 700,
										"fontFamily": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
										"flexShrink": 0
									}
								},
								"children": [
									"{n}"
								]
							},
							"{item} {n}"
						]
					}
				}
			}
		]
	},
	"version": 1,
	"familyKey": "list-numbered",
	"source": {
		"kind": "archetype",
		"archetype": "list",
		"variant": "numbered",
		"tranche": 1
	}
}
