	<string>$(THINGTIME_PASSWORD_KEYCHAIN_GROUP)</string>
	<key>ThingtimePasswordNotificationName</key>
	<string>$(THINGTIME_PASSWORD_HOST_BUNDLE_ID).destination-changed</string>
	<key>ThingtimePasswordDevelopmentHost</key>
	<string>$(THINGTIME_PASSWORD_DEVELOPMENT_HOST)</string>
	<key>ThingtimeWebURL</key>
	<string>$(THINGTIME_WEB_URL)</string>
