		<key>CFBundleURLName</key><string>$(THINGTIME_PASSWORD_HOST_BUNDLE_ID).authenticator</string>
		<key>CFBundleURLSchemes</key><array><string>$(THINGTIME_PASSWORD_URL_SCHEME)</string></array>
	</dict></array>
	<key>LSUIElement</key>
	<true/>
